						US customs compliant
					</div>
				</div>
				<div class="snake-card p-4 text-center">
					<div class="text-2xl mb-2">🇦🇺</div>
					<div class="text-white font-semibold 
								text-sm mb-1">Australia</div>
					<div class="text-gray-500 text-xs">
						AU standards compliant
					</div>
				</div>
				<div class="snake-card p-4 text-center 
							col-span-2 sm:col-span-1">
					<div class="text-2xl mb-2">🌍</div>
					<div class="text-white font-semibold 
								text-sm mb-1">Worldwide</div>
					<div class="text-gray-500 text-xs">
						FOB global delivery
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Social Proof Section -->
	<section class="py-12 px-4 bg-gray-950">
		<div class="container mx-auto max-w-6xl">
			<div class="grid md:grid-cols-3 gap-6">
				<div class="snake-card p-6">
					<div class="text-red-500 mb-3 text-lg 
								tracking-widest">★★★★★</div>
					<p class="text-gray-300 text-sm 
							  leading-relaxed mb-4">
