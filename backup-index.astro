	</script>

	<!-- Hero Section - Optimized for Performance -->
	<section class="relative h-screen flex items-center justify-center overflow-hidden" style="width: 100%; height: 100vh; min-height: 100vh; overflow: hidden;">
		<!-- Optimized Responsive Image -->
		<picture class="absolute inset-0 w-full h-full" style="width: 100%; height: 100%; display: block;">
