			<source 
				media="(max-width: 640px)" 
				srcset="/sdf.webp" 
				type="image/webp"
				width="640"
				height="853"
			>
			<!-- Tablet: Medium screens -->
			<source 
				media="(max-width: 1024px)" 
				srcset="/sdf.webp" 
				type="image/webp"
				width="1024"
				height="683"
			>
			<!-- Desktop: Large screens -->
			<source 
				media="(min-width: 1025px)" 
				srcset="/sdf.webp" 
				type="image/webp"
				width="1920"
				height="1080"
			>
			<!-- Fallback for older browsers -->
			<img 
				src="/sdf.webp" 
				alt="SDF Clothing manufacturing facility in Bangladesh with modern production lines"
				class="w-full h-full object-cover"
				style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;"
				loading="eager"
				decoding="async"
				fetchpriority="high"
				width="1920"
				height="1080"
			>
		</picture>
		
		<!-- Dark Overlay -->
		<div class="absolute inset-0 bg-black/40"></div>
		
		<!-- Hero Content -->
		<div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
			<h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
				Leading Clothing Manufacturers in Bangladesh
			</h1>
			<p class="text-xl md:text-2xl text-gray-300 mb-8">
				Supplying fashion brands across EU, UK, US and
