	<!-- Simple Footer JavaScript -->
	<script is:inline>
		function toggleFooterSection(sectionName) {
			console.log('Toggling section:', sectionName);
			
			// Find the section
			const section = document.querySelector(`[data-section="${sectionName}"]`);
			if (!section) return;
			
			// Find content and arrow
			const content = section.querySelector('.footer-content');
			const arrow = section.querySelector('.footer-arrow');
			
			if (!content || !arrow) return;
			
			// Check if already expanded
			const isExpanded = content.style.maxHeight && content.style.maxHeight !== '0px';
			
			// Close all other sections first
			document.querySelectorAll('.footer-section').forEach(otherSection => {
				if (otherSection !== section) {
					const otherContent = otherSection.querySelector('.footer-content');
					const otherArrow = otherSection.querySelector('.footer-arrow');
					if (otherContent) {
						otherContent.style.maxHeight = '0px';
						otherContent.style.overflow = 'hidden';
					}
					if (otherArrow) {
						otherArrow.style.transform = 'rotate(0deg)';
					}
				}
			});
			
			// Toggle current section
			if (isExpanded) {
				// Collapse
				content.style.maxHeight = '0px';
				content.style.overflow = 'hidden';
				arrow.style.transform = 'rotate(0deg)';
				console.log('Section collapsed:', sectionName);
			} else {
				// Expand
				content.style.display = 'block';
				content.style.overflow = 'hidden';
				const height = content.scrollHeight;
				content.style.maxHeight = height + 'px';
				
				setTimeout(() => {
					content.style.overflow = 'visible';
				}, 300);
				
				arrow.style.transform = 'rotate(180deg)';
				console.log('Section expanded:', sectionName);
			}
		}
		
		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
			console.log('Footer script loaded');
		});
	</script>

	<!-- Live Counter Script -->
	<script>
		// Live Counter - Founded date: August 22, 1998
		const foundedDate = new Date(1998, 7, 22); // Month is 0-indexed (7 = August)
		
		function updateLiveCounter() {
			try {
				const now = new Date();
				
				// Validate dates
				if (isNaN(foundedDate.getTime()) || isNaN(now.getTime())) {
					throw new Error('Invalid date');
				}
				
				const diff = now - foundedDate;
				
				// Calculate time components
				const days = Math.floor(diff / (1000 * 60 * 60 * 24));
				const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
				const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
				const seconds = Math.floor((diff % (1000 * 60)) / 1000);
				
				// Premium format display
				let counterText = 'Empowering global fashion brands for ';
				
				// Add days with proper pluralization
				if (days === 1) {
					counterText += `${days} day`;
				} else {
					counterText += `${days.toLocaleString()} days`;
				}
				
				// Add time with elegant formatting
				counterText += ` • ${hours.toString().padStart(2, '0')}:`;
				counterText += `${minutes.toString().padStart(2, '0')}:`;
				counterText += `${seconds.toString().padStart(2, '0')}`;
				
				// Update display
				const counterElement = document.getElementById('live-counter');
				if (counterElement) {
					counterElement.textContent = counterText;
				}
			} catch (error) {
				console.error('Live counter error:', error);
				// Fallback display
				const counterElement = document.getElementById('live-counter');
				if (counterElement) {
					counterElement.textContent = 'Empowering global fashion brands since 1998';
				}
			}
		}
		
		// Start the counter immediately
		updateLiveCounter();
		setInterval(updateLiveCounter, 1000);
	</script>
	
