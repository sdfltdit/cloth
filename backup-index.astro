				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">{yearsExp}+</div>
					<div class="text-gray-300">Years Experience</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">300</div>
					<div class="text-gray-300">Pieces MOQ</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">50,000</div>
					<div class="text-gray-300">Pieces / 45 Days</div>
