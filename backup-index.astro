				</div>
				<div>
					<h3 class="text-xl font-bold text-white mb-6">Our Certifications</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div class="snake-card p-4">
							<div class="text-lg font-semibold text-red-500 mb-2">GOTS</div>
							<div class="text-gray-400 text-sm">Global Organic Textile Standard - Certified organic fiber processing</div>
						</div>
						<div class="snake-card p-4">
							<div class="text-lg font-semibold text-red-500 mb-2">OEKO-TEX</div>
							<div class="text-gray-400 text-sm">Standard 100 - Harmful substance testing certification</div>
						</div>
						<div class="snake-card p-4">
							<div class="text-lg font-semibold text-red-500 mb-2">ISO 9001</div>
							<div class="text-gray-400 text-sm">Quality Management System certification</div>
						</div>
						<div class="snake-card p-4">
							<div class="text-lg font-semibold text-red-500 mb-2">BSCI</div>
							<div class="text-gray-400 text-sm">Business Social Compliance Initiative</div>
						</div>
						<div class="snake-card p-4">
							<div class="text-lg font-semibold text-red-500 mb-2">SEDEX</div>
