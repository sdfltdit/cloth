				"email": "info@sdfclothing.com",
				"telephone": "+8801234567890",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "House 125, Road 01, Baridhara DOHS",
					"addressLocality": "Dhaka",
					"postalCode": "1212",
					"addressCountry": "BD"
				},
