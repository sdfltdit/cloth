						Hoodies, jackets, sweatshirts, coats
					</div>
				</a>

				<a href="/sportswear-manufacturer" class="snake-card p-6 text-center group 
				   hover:border-red-500 transition-all duration-300 block">
					<div class="text-3xl mb-3">🏃</div>
					<div class="text-white font-semibold mb-1 
					            group-hover:text-red-400 transition-colors">
						Sportswear Manufacturer
					</div>
					<div class="text-gray-400 text-sm">
						Gym wear, yoga, athletic apparel
					</div>
				</a>

				<a href="/womenswear-manufacturer" class="snake-card p-6 text-center group 
				   hover:border-red-500 transition-all duration-300 block">
					<div class="text-3xl mb-3">👗</div>
					<div class="text-white font-semibold mb-1 
					            group-hover:text-red-400 transition-colors">
						Women's Wear
