// CAMERA
function startCamera(){
  navigator.mediaDevices.getUserMedia({video:{facingMode:'user'}}).then(function(stream){
    cameraStream=stream;
    var v=document.getElementById('cameraFeed'); v.srcObject=stream; v.style.display='block';
    document.getElementById('cameraActions').style.display='none';
    document.getElementById('cameraReady').style.display='block';
    document.getElementById('cameraStatus').textContent='';
  }).catch(function(){
    document.getElementById('cameraStatus').textContent='Camera access denied. Please allow camera and try again.';
  });
}
function capturePhoto(){
  var v=document.getElementById('cameraFeed'); var c=document.getElementById('cameraCanvas');
  c.width=v.videoWidth; c.height=v.videoHeight; c.getContext('2d').drawImage(v,0,0);
  capturedFaceData=c.toDataURL('image/jpeg',0.8).split(',')[1];
  var img=document.getElementById('capturedPhoto'); img.src=c.toDataURL('image/jpeg',0.8); img.style.display='block';
  v.style.display='none';
  document.getElementById('cameraStatus').textContent='Photo captured.';
  document.getElementById('cameraStatus').style.color='#5a9e5a';
  if(cameraStream) cameraStream.getTracks().forEach(function(t){t.stop();});
  updateJobBtn();
}
function retakePhoto(){
  capturedFaceData=null;
  document.getElementById('capturedPhoto').style.display='none';
  document.getElementById('cameraFeed').style.display='block';
  document.getElementById('cameraStatus').textContent='';
  document.getElementById('cameraStatus').style.color='#cc0000';
  startCamera(); updateJobBtn();
}

// AI DETECTION
function startFieldTimer(){if(!fieldFocusTime) fieldFocusTime=Date.now();}
function trackKeystrokes(e){keystrokeCount++;if(e.key==='Backspace'||e.key==='Delete') backspaceCount++;}
function handlePaste(e){
  e.preventDefault(); pasteDetected=true;
  var w=document.getElementById('aiWarning');
  w.style.display='inline'; w.textContent='Warning: Paste detected — please type your response.';
}
function checkWordCount(ta){
  var words=ta.value.trim().split(/\s+/).filter(function(w){return w.length>0;}).length;
  var d=document.getElementById('wordCountDisplay');
  if(words<300){d.textContent=words+' / 300 words minimum'; d.style.color=words>250?'#f5a623':'rgba(255,255,255,0.35)';}
  else{d.textContent=words+' words \u2713'; d.style.color='#5a9e5a';}
  updateJobBtn();
  if(fieldFocusTime&&keystrokeCount>10){
    var mins=(Date.now()-fieldFocusTime)/60000; avgWpm=mins>0?Math.round(words/mins):0;
    if(avgWpm>130&&!pasteDetected){var w2=document.getElementById('aiWarning');w2.style.display='inline';w2.textContent='Warning: Unusually fast typing detected.';}
  }
}
function getAIScore(){
  var text=(document.getElementById('j-whysdf').value||'').trim(); var score=0;
  if(pasteDetected) score+=40;
  if(avgWpm>130) score+=25;
  if(backspaceCount<3&&text.length>500) score+=20;
  var t=fieldFocusTime?Math.round((Date.now()-fieldFocusTime)/1000):999;
  if(t<30&&text.length>200) score+=15;
  return Math.min(score,100);
}
function updateJobBtn(){
  var btn=document.getElementById('jobSubmitBtn');
  var words=(document.getElementById('j-whysdf').value||'').trim().split(/\s+/).filter(function(w){return w.length>0;}).length;
  if(btn) btn.disabled=(words<300||!capturedFaceData);
}

// SUBMIT BUYER (Web3Forms)
function submitBuyer(e){
  e.preventDefault();
  if(!document.getElementById('b-gdpr').checked){alert('Please agree to the Privacy Policy to proceed.');return;}
  var name=document.getElementById('b-name').value.trim();
  var email=document.getElementById('b-email').value.trim();
  if(!name||!email){alert('Please fill in your name and email.');return;}
  var fd=new FormData();
  fd.append('access_key','028983eb-bca7-4bbc-be4f-7db2873903aa');
  fd.append('subject','New Buyer Inquiry — SDF Clothing');
  fd.append('from_name','SDF Clothing Contact Form');
  fd.append('botcheck','');
  fd.append('name',name);
  fd.append('email',email);
  fd.append('company',document.getElementById('b-company').value);
  fd.append('phone',document.getElementById('b-phone').value);
  fd.append('country',document.getElementById('b-country').value);
  fd.append('category',document.getElementById('b-category').value);
  fd.append('quantity',document.getElementById('b-qty').value);
  fd.append('target_price',document.getElementById('b-price').value);
  fd.append('file_link',document.getElementById('b-filelink').value);
  fd.append('message',document.getElementById('b-msg').value);
  fetch('https://api.web3forms.com/submit',{method:'POST',body:fd})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.success){
        showThankYou('Inquiry received.','Thank you for reaching out to SDF Clothing.','SDF-BYR-'+Date.now().toString(36).toUpperCase().slice(-6));
      } else {
        console.error('Web3Forms error:',JSON.stringify(d));
        alert('Submission failed: '+( d.message||'unknown error')+'. Please email contact@sdfltd.com directly.');
      }
    }).catch(function(err){
      console.error('Fetch error:',err);
      alert('Network error. Please email contact@sdfltd.com directly.');
    });
}

