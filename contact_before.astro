---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Contact Garment Factory Bangladesh | Free FOB Quote — SDF Clothing";
const pageDescription = "Get a free FOB quote from SDF Clothing — ethical garment manufacturer in Bangladesh since 1998. MOQ 300 pieces, FOB/CIF/DDP shipping.";
const canonicalUrl = "https://sdfltd.com/contact";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<meta name="robots" content="index, follow" />
<meta property="og:title" content="Contact Garment Factory Bangladesh | Free FOB Quote — SDF Clothing" />
<meta property="og:description" content="Get a free FOB quote from SDF Clothing. Bangladesh garment manufacturer since 1998. MOQ 300 pieces." />
<meta property="og:url" content="https://sdfltd.com/contact" />
<meta property="og:type" content="website" />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Contact Garment Factory Bangladesh | Free FOB Quote",
  "description": "Contact SDF Clothing — ethical garment manufacturer in Bangladesh since 1998.",
  "url": "https://sdfltd.com/contact",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://sdfltd.com/contact" }
    ]
  }
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #cc0000;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Bangladesh Garment Manufacturer · Est. 1998</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Let's build something<br>together.</h1>
    <p style="color:rgba(255,255,255,0.7);max-width:500px;line-height:1.8;font-size:0.92rem;">FOB quotes within 48 hours. MOQ 300 pieces. OEM, private label and CMT manufacturing from Dhaka. Select your role below to get started.</p>
  </div>
</section>

<!-- CAPABILITY STRIP -->
<section style="border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);border-left:1px solid #1a1a1a;">
      <div style="padding:1.5rem 1.25rem;border-right:1px solid #1a1a1a;text-align:center;">
        <p style="font-size:1.8rem;font-weight:200;color:#fff;line-height:1;margin-bottom:0.3rem;">12<span style="font-size:0.8rem;color:#cc0000;font-weight:600;">M+</span></p>
        <p style="font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.4);">Pcs / year capacity</p>
      </div>
      <div style="padding:1.5rem 1.25rem;border-right:1px solid #1a1a1a;text-align:center;">
        <p style="font-size:1.8rem;font-weight:200;color:#fff;line-height:1;margin-bottom:0.3rem;">26<span style="font-size:0.8rem;color:#cc0000;font-weight:600;">+</span></p>
        <p style="font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.4);">Years in operation</p>
      </div>
      <div style="padding:1.5rem 1.25rem;border-right:1px solid #1a1a1a;text-align:center;">
        <p style="font-size:1.8rem;font-weight:200;color:#fff;line-height:1;margin-bottom:0.3rem;">300<span style="font-size:0.8rem;color:#cc0000;font-weight:600;">pcs</span></p>
        <p style="font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.4);">Minimum order qty</p>
      </div>
      <div style="padding:1.5rem 1.25rem;text-align:center;">
        <p style="font-size:1.8rem;font-weight:200;color:#fff;line-height:1;margin-bottom:0.3rem;">FOB<span style="font-size:0.8rem;color:#cc0000;font-weight:600;">/CIF/DDP</span></p>
        <p style="font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.4);">Incoterms supported</p>
      </div>
    </div>
  </div>
</section>

<!-- CERT STRIP -->
<section style="border-bottom:1px solid #1a1a1a;">
  <div class="container" style="padding:0.75rem 1.5rem;">
    <div style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
      <span style="font-size:0.58rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.25);white-space:nowrap;">Certifications</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">GOTS</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">OEKO-TEX 100</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">BSCI</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">ISO 9001</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">SA8000</span>
      <span style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.18rem 0.55rem;border:1px solid #1e1e1e;color:rgba(255,255,255,0.4);">Sedex</span>
    </div>
  </div>
</section>

<!-- ROLE SELECTOR -->
<section style="padding:3rem 0 0;" id="roleSection">
  <div class="container">
    <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Who are you?</p>
    <p style="font-size:0.85rem;font-weight:300;color:#fff;margin-bottom:1.25rem;">Select your role — you'll only see what's relevant to you.</p>
    <div class="role-grid" id="roleGrid">
      <div class="role-card" onclick="selectRole('buyer',this)">
        <div class="rc-icon" style="color:#cc0000;">🛍</div>
        <div class="rc-body">
          <p class="rc-title">Buyer / Brand</p>
          <p class="rc-sub">Source garments, request FOB quote, OEM or private label</p>
          <span class="rc-tag" style="border-color:#cc0000;color:#cc0000;">Quote within 48 hrs</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('factory',this)">
        <div class="rc-icon" style="color:#7abf3a;">🏭</div>
        <div class="rc-body">
          <p class="rc-title">Factory / CMT</p>
          <p class="rc-sub">Sub-contract, overflow orders or CMT partnership</p>
          <span class="rc-tag" style="border-color:#2a4a00;color:#7abf3a;">Bangladesh only</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('supplier',this)">
        <div class="rc-icon" style="color:#888;">📦</div>
        <div class="rc-body">
          <p class="rc-title">Supplier / Vendor</p>
          <p class="rc-sub">Offer fabric, trims, packaging or raw materials</p>
          <span class="rc-tag" style="border-color:#333;color:#666;">Procurement reviews</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('shipping',this)">
        <div class="rc-icon" style="color:#4a8abf;">🚢</div>
        <div class="rc-body">
          <p class="rc-title">Shipping Agent / C&amp;F</p>
          <p class="rc-sub">Freight forwarding, customs clearance, C&amp;F services</p>
          <span class="rc-tag" style="border-color:#1a3a5c;color:#4a8abf;">Logistics partnership</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('job',this)" style="grid-column:span 2;">
        <div class="rc-icon" style="color:#5a9e5a;">📋</div>
        <div class="rc-body">
          <p class="rc-title">Job Candidate</p>
          <p class="rc-sub">Apply for a position at SDF Clothing Ltd, Dhaka Bangladesh</p>
          <span class="rc-tag" style="border-color:#1e4d1e;color:#5a9e5a;">HR reviews all applications</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAIN SECTION -->
<section style="padding:2rem 0 4rem;" id="mainSection" style="display:none;">
  <div class="container">
    <div id="mainLayout" class="main-layout">

      <!-- LEFT: FORM -->
      <div id="formCol">
        <div style="display:flex;align-items:center;gap:0.75rem;padding:0.8rem 1rem;background:#0f0f0f;border:1px solid #1a1a1a;margin-bottom:1.25rem;">
          <div id="formBadge" class="f-badge f-badge-buyer">Buyer / Brand</div>
          <div>
            <p id="formTitle" style="font-size:0.82rem;font-weight:500;color:#fff;">FOB Quote Request</p>
            <p id="formSub" style="font-size:0.67rem;color:rgba(255,255,255,0.5);">Sales team reviews all inquiries</p>
          </div>
          <button onclick="goBack()" style="margin-left:auto;background:none;border:1px solid #222;color:rgba(255,255,255,0.4);padding:0.3rem 0.7rem;font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;font-family:inherit;">&#8592; Back</button>
        </div>

        <div id="prefillBar" style="display:none;background:#080000;border-left:2px solid #cc0000;padding:0.5rem 0.75rem;margin-bottom:1rem;">
          <p style="font-size:0.68rem;color:#cc0000;">&#10003; Planning tool results pre-filled below.</p>
        </div>

        <div id="factoryBlocked" style="display:none;background:#080000;border:1px solid #cc0000;padding:1.5rem;text-align:center;margin-bottom:1rem;">
          <p style="color:#cc0000;font-size:0.85rem;font-weight:500;margin-bottom:0.5rem;">Access Restricted</p>
          <p style="color:rgba(255,255,255,0.5);font-size:0.75rem;line-height:1.7;" id="factoryBlockMsg">This form is restricted to Bangladesh-based manufacturing partners.</p>
        </div>

        <!-- BUYER FORM -->
        <div id="f-buyer" class="role-form">
          <div class="frow">
            <div class="fl"><label>Full name *</label><input type="text" id="b-name" placeholder="John Smith"/></div>
            <div class="fl"><label>Company / brand</label><input type="text" id="b-company" placeholder="Your Brand Ltd"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Email *</label><input type="email" id="b-email" placeholder="you@brand.com"/></div>
            <div class="fl"><label>WhatsApp / phone *</label><input type="tel" id="b-phone" placeholder="+1 234 567 890"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Country</label><select id="b-country"><option value="">Select country</option></select></div>
            <div class="fl"><label>Product category</label>
              <select id="b-category">
                <option value="">Select</option>
                <option>T-Shirts / Polos</option><option>Hoodies / Sweatshirts</option>
                <option>Activewear</option><option>Denim</option><option>Womenswear</option>
                <option>Kidswear</option><option>Uniforms</option><option>Other</option>
              </select>
            </div>
          </div>
          <div class="frow">
            <div class="fl"><label>Est. quantity (pcs)</label><input type="number" id="b-qty" placeholder="e.g. 5000"/></div>
            <div class="fl"><label>Target FOB price (USD)</label><input type="text" id="b-price" placeholder="e.g. $4.50 / piece"/></div>
          </div>
          <div class="frow full">
            <div class="fl"><label>Tech pack / reference files</label>
              <div class="upload-zone" onclick="document.getElementById('b-files').click()">
                <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin-bottom:0.25rem;">&#8593; Drop files here or click to upload</p>
                <span style="font-size:0.62rem;color:rgba(255,255,255,0.25);">PDF, AI, PNG, JPG · Max 20MB</span>
              </div>
              <input type="file" id="b-files" multiple accept=".pdf,.ai,.png,.jpg,.jpeg" style="display:none;" onchange="showFileNames('b-files','b-filenames')"/>
              <div id="b-filenames" style="font-size:0.68rem;color:rgba(255,255,255,0.4);margin-top:0.3rem;"></div>
              <div style="display:flex;align-items:center;gap:0.5rem;margin:0.5rem 0;">
                <div style="flex:1;height:1px;background:#1a1a1a;"></div>
                <span style="font-size:0.6rem;color:rgba(255,255,255,0.25);text-transform:uppercase;letter-spacing:0.08em;">or share a link</span>
                <div style="flex:1;height:1px;background:#1a1a1a;"></div>
              </div>
              <input type="url" id="b-filelink" placeholder="Google Drive / Dropbox / WeTransfer link" class="fl-input"/>
            </div>
          </div>
          <div class="frow full">
            <div class="fl"><label>Message / requirements</label><textarea id="b-msg" placeholder="Fabric, timeline, certifications needed, sample requirements..."></textarea></div>
          </div>
          <div class="frow full">
            <div class="fl">
              <label class="gdpr-label">
                <input type="checkbox" id="b-gdpr" style="accent-color:#cc0000;flex-shrink:0;"/>
                <span>I agree to SDF Clothing's <a href="/privacy" style="color:#cc0000;">Privacy Policy</a> and consent to my data being processed for business communication purposes.</span>
              </label>
            </div>
          </div>
          <button onclick="submitBuyer(event)" class="sbtn buyer-btn">Send inquiry &#8594;</button>
          <p class="form-note">Data never shared with third parties</p>
        </div>

        <!-- SUPPLIER FORM -->
        <div id="f-supplier" class="role-form" style="display:none;">
          <div class="frow">
            <div class="fl"><label>Contact name *</label><input type="text" id="s-name" placeholder="Your name"/></div>
            <div class="fl"><label>Company name *</label><input type="text" id="s-company" placeholder="Supplier Co. Ltd"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Email *</label><input type="email" id="s-email" placeholder="you@supplier.com"/></div>
            <div class="fl"><label>Phone / WhatsApp *</label><input type="tel" id="s-phone" placeholder="+880 ..."/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Country *</label><select id="s-country" onchange="toggleBDAgent()"><option value="">Select</option></select></div>
            <div class="fl"><label>Company type</label>
              <select id="s-companytype">
                <option value="">Select</option>
                <option>Manufacturer</option><option>Trading Company</option>
                <option>Buying House</option><option>Indenting Agent</option>
              </select>
            </div>
          </div>
          <div class="frow full">
            <div class="fl"><label>Supply category *</label>
              <select id="s-category" onchange="showSupplierFields()">
                <option value="">Select category</option>
                <option value="fabric">Fabric / Yarn</option>
                <option value="trims">Trims &amp; Accessories</option>
                <option value="packaging">Packaging</option>
                <option value="dyeing">Dyeing &amp; Washing</option>
                <option value="printing">Printing &amp; Embroidery</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <!-- FABRIC -->
          <div id="sf-fabric" class="cat-fields" style="display:none;">
            <div class="frow">
              <div class="fl"><label>Fabric type</label>
                <select id="s-fabrictype"><option>Knit</option><option>Woven</option><option>Both</option></select>
              </div>
              <div class="fl"><label>Fiber composition</label><input type="text" id="s-fiber" placeholder="e.g. 100% Cotton, 65/35 CVC"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Yarn count range</label><input type="text" id="s-yarn" placeholder="e.g. 20s – 40s"/></div>
              <div class="fl"><label>GSM range</label><input type="text" id="s-gsm" placeholder="e.g. 140 – 280 gsm"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Lab dip development (days)</label><input type="number" id="s-labdip" placeholder="e.g. 7"/></div>
              <div class="fl"><label>Strike off turnaround (days)</label><input type="number" id="s-strikeoff" placeholder="e.g. 5"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Shade band / tolerance std.</label><input type="text" id="s-shade" placeholder="e.g. ΔE ≤ 1.0 CMC"/></div>
              <div class="fl"><label>Monthly capacity</label><input type="text" id="s-capacity" placeholder="e.g. 50,000 meters / 20,000 kg"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>MOQ per colour</label><input type="text" id="s-moq" placeholder="e.g. 500 kg"/></div>
              <div class="fl"><label>In-house testing lab</label>
                <select id="s-lab"><option value="yes">Yes</option><option value="no">No</option></select>
              </div>
            </div>
            <div class="frow">
              <div class="fl"><label>Shrinkage &amp; pilling test</label>
                <select id="s-test"><option value="yes">Yes</option><option value="no">No</option></select>
              </div>
              <div class="fl"><label>Certifications</label>
                <select id="s-cert"><option value="">None</option><option>GOTS</option><option>OEKO-TEX 100</option><option>BCI</option><option>bluesign</option><option>Recycled Claim Standard</option></select>
              </div>
            </div>
            <div class="frow">
              <div class="fl"><label>Sample dev. charge</label>
                <select id="s-samplecharge" onchange="toggleAmt('s-samplecharge','s-sampleamt')">
                  <option value="no">No charge</option><option value="yes">Yes, charged</option>
                </select>
              </div>
              <div class="fl" id="s-sampleamt" style="display:none;"><label>Charge amount (USD)</label><input type="text" id="s-sampleamtval" placeholder="e.g. $50 per colour"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Sample shipping charge</label>
                <select id="s-shipcharge" onchange="toggleAmt('s-shipcharge','s-shipamt')">
                  <option value="no">No charge</option><option value="yes">Yes, charged</option>
                </select>
              </div>
              <div class="fl" id="s-shipamt" style="display:none;"><label>Shipping charge amount</label><input type="text" id="s-shipamtval" placeholder="e.g. $30 courier"/></div>
            </div>
            <div class="frow full">
              <div class="fl"><label>Nominated by which buyers?</label><input type="text" id="s-buyers" placeholder="e.g. H&M, Zara, Next"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Payment terms</label>
                <select id="s-payment"><option>LC</option><option>TT</option><option>DP</option><option>DA</option></select>
              </div>
              <div class="fl"><label>Payment details</label><input type="text" id="s-paydetail" placeholder="e.g. 30 days after B/L"/></div>
            </div>
          </div>

          <!-- TRIMS -->
          <div id="sf-trims" class="cat-fields" style="display:none;">
            <div class="frow full">
              <div class="fl"><label>Trim types offered</label>
                <div class="check-grid">
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Button (plastic/metal/snap/shank/toggle)"/>Button (plastic/metal/snap/shank/toggle)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Zipper (YKK/coil/invisible/metal/plastic)"/>Zipper (YKK/coil/invisible/metal/plastic)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Label (woven/printed/heat transfer/hang tag/barcode)"/>Label (woven/printed/heat transfer/hang tag)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Thread (spun polyester/cotton/nylon/core spun)"/>Thread (spun polyester/cotton/nylon)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Elastic (woven/knitted/braided/waistband)"/>Elastic (woven/knitted/braided/waistband)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Interlining (woven/non-woven/fusible/sew-in)"/>Interlining (woven/non-woven/fusible)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Velcro / Hook & Loop"/>Velcro / Hook &amp; Loop</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Drawstring / Cord / Eyelet"/>Drawstring / Cord / Eyelet</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Rivet / Jean button / Tack button"/>Rivet / Jean button / Tack button</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Patch (leather/PU/rubber/woven)"/>Patch (leather/PU/rubber/woven)</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Reflective tape / Piping / Binding tape"/>Reflective tape / Piping / Binding</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Shoulder pad / Bra cup / Boning"/>Shoulder pad / Bra cup / Boning</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Care label / Compliance label"/>Care label / Compliance label</label>
                  <label class="check-item"><input type="checkbox" name="s-trims" value="Packaging accessories (tissue/silica/cardboard/clip)"/>Packaging accessories</label>
                </div>
              </div>
            </div>
            <div class="frow">
              <div class="fl"><label>MOQ</label><input type="text" id="s-t-moq" placeholder="e.g. 1000 pcs per design"/></div>
              <div class="fl"><label>Lead time</label><input type="text" id="s-t-lead" placeholder="e.g. 21 days"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Sample dev. charge</label>
                <select id="s-t-sc" onchange="toggleAmt('s-t-sc','s-t-scamt')">
                  <option value="no">No charge</option><option value="yes">Yes</option>
                </select>
              </div>
              <div class="fl" id="s-t-scamt" style="display:none;"><label>Amount (USD)</label><input type="text" placeholder="e.g. $20 per design"/></div>
            </div>
            <div class="frow full">
              <div class="fl"><label>Nominated by which buyers?</label><input type="text" id="s-t-buyers" placeholder="e.g. H&M, Primark"/></div>
            </div>
            <div class="frow">
              <div class="fl"><label>Payment terms</label>
                <select><option>LC</option><option>TT</option><option>DP</option><option>DA</option></select>
              </div>
              <div class="fl"><label>Certifications</label><input type="text" placeholder="OEKO-TEX, REACH, etc."/></div>
            </div>
          </div>

          <!-- PACKAGING -->
          <div id="sf-packaging" class="cat-fields" style="display:none;">
            <div class="frow full">
              <div class="fl"><label>Packaging types offered</label>
                <div class="check-grid">
                  <label class="check-item"><input type="checkbox" name="s-pkg" value="Polybag (plain/printed/biodegradable/zip lock/self-seal)"/>Polybag (plain/printed/biodegradable)</label>
                  <label class="check-item"><input type="checkbox" name="s-pkg" value="Carton (master/inner/display/FSC certified)"/>Carton (master/inner/display/FSC)</label>
