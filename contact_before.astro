<!-- FAQ -->
<section style="padding:4rem 0;border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width:900px;">
    <p style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Frequently Asked Questions</p>
    <h2 style="font-size:clamp(1.5rem,3vw,2rem);font-weight:300;color:#fff;margin-bottom:2rem;">Common questions about working with us</h2>
    <div style="display:flex;flex-direction:column;gap:0;">
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">What is the minimum order quantity (MOQ)?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">Our minimum order quantity is 300 pieces per style. We accept a maximum of 2 styles per order, with up to 4 colour variations per style.</p></div>
      </details>
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">How long does production take from Bangladesh?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">Standard lead time is 60 to 120 days from pre-production sample approval and receipt of advance payment. Use our Shipment Timeline Calculator above for a personalised breakdown.</p></div>
      </details>
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">What payment methods do you accept?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">We accept Letter of Credit (LC) for orders above USD 30,000, Telegraphic Transfer (TT) for USD 5,000–30,000, and Wise / WorldRemit for orders below USD 5,000.</p></div>
      </details>
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">Which Incoterms do you support?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">We support all Incoterms 2020: EXW, FCA, FOB, CFR, CIF, DAP, and DDP. FOB Chittagong is our standard term.</p></div>
      </details>
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">Do you manufacture sustainable garments?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">Yes. We manufacture using GOTS-certified organic cotton, recycled polyester (rPET), Tencel, and Modal. Use our Sustainability Score Calculator to profile your order.</p></div>
      </details>
      <details style="border-bottom:1px solid #1a1a1a;">
        <summary style="padding:1rem 0;font-size:0.95rem;color:#fff;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;">Is sample development free?<span style="color:#cc0000;font-size:1.2rem;">+</span></summary>
        <div style="padding:0 0 1rem;"><p style="color:rgba(255,255,255,0.65);font-size:0.9rem;line-height:1.8;margin:0;">Sample development requires a 30% advance deposit based on estimated bulk order value. This deposit is fully credited toward your confirmed production order.</p></div>
      </details>
    </div>
  </div>
</section>

