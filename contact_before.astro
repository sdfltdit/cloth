    payload.message=document.getElementById('sh-msg').value;
    payload.courierRates=!!(document.getElementById('sh-courierfile').files.length);
    payload.seaRates=!!(document.getElementById('sh-seafile').files.length);
  }
  fetch('https://sdfltd.com/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.ok){
        var msgs={supplier:'Your supplier profile has been received.',factory:'Your factory profile has been received.',shipping:'Your logistics profile has been received.'};
        showThankYou('Submitted successfully.',msgs[role]||'Received.',d.referenceId);
      }else if(d.blocked){
        document.getElementById('factoryBlocked').style.display='block';
        document.getElementById('factoryBlockMsg').textContent=d.reason;
      }else{alert(d.reason||'Something went wrong. Please try again.');}
    }).catch(function(){alert('Something went wrong. Please try again or contact us directly.');});
}

// SUBMIT JOB
function submitJob(e){
  e.preventDefault();
  if(!document.getElementById('j-gdpr').checked){alert('Please agree to the Privacy Policy.');return;}
  if(!capturedFaceData){alert('Please complete the live photo verification.');return;}
  var words=(document.getElementById('j-whysdf').value||'').trim().split(/\s+/).filter(function(w){return w.length>0;}).length;
  if(words<300){alert('Please complete the "Why SDF Clothing?" section (minimum 300 words).');return;}
  var aiScore=getAIScore();
  if(aiScore>=50||pasteDetected){document.getElementById('passagePopup').style.display='flex';return;}
  doJobSubmit(aiScore);
}
function confirmPassage(){
  var typed=(document.getElementById('passageInput').value||'').trim();
  var expected='I understand that SDF Clothing values genuine effort and original thinking. I confirm that everything I have written in this application reflects my own words and experience.';
  if(typed!==expected){document.getElementById('passageError').style.display='block';return;}
  document.getElementById('passagePopup').style.display='none';
  doJobSubmit(getAIScore());
}
function doJobSubmit(aiScore){
  var g=function(id){var el=document.getElementById(id);return el?el.value:'';};
  var payload={
    role:'job',name:g('j-name'),email:g('j-email'),phone:g('j-phone'),dob:g('j-dob'),
    nid:g('j-nid'),area:g('j-area'),position:g('j-position'),experience:g('j-experience'),
    employmentStatus:g('j-status'),availableFrom:g('j-joindate'),noticePeriod:g('j-notice'),
    expectedSalary:g('j-salary'),englishLevel:g('j-english'),computerSkills:g('j-computer'),
    linkedin:g('j-linkedin'),criminalRecord:g('j-criminal'),factoryFit:g('j-fit'),
    qualification:g('j-qualification'),institution:g('j-institution'),passingYear:g('j-passingyear'),
    whySDF:g('j-whysdf'),faceCapture:true,cvAttached:!!(document.getElementById('j-cv').files.length),
    nidAttached:!!(document.getElementById('j-nidscan').files.length),workHistory:true,references:true,
    pasteDetected:pasteDetected,avgWpm:avgWpm,backspaceCount:backspaceCount,
    timeInField:fieldFocusTime?Math.round((Date.now()-fieldFocusTime)/1000):null,aiScore:aiScore,
    work1company:g('j-w1company'),work1role:g('j-w1role'),work1duration:g('j-w1duration'),
    work1reason:g('j-w1reason'),work1supervisor:g('j-w1supervisor'),work1supervisorPhone:g('j-w1supphone'),
    work2company:g('j-w2company'),work2role:g('j-w2role'),work2duration:g('j-w2duration'),
    work2reason:g('j-w2reason'),work2supervisor:g('j-w2supervisor'),work2supervisorPhone:g('j-w2supphone'),
    work3company:g('j-w3company'),work3role:g('j-w3role'),work3duration:g('j-w3duration'),
    work3reason:g('j-w3reason'),work3supervisor:g('j-w3supervisor'),work3supervisorPhone:g('j-w3supphone'),
    ref1name:g('j-r1name'),ref1company:g('j-r1company'),ref1designation:g('j-r1designation'),ref1phone:g('j-r1phone'),
    ref2name:g('j-r2name'),ref2company:g('j-r2company'),ref2designation:g('j-r2designation'),ref2phone:g('j-r2phone'),
  };
  if(!payload.name||!payload.email){alert('Please fill in required fields.');return;}
  fetch('https://sdfltd.com/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.ok) showThankYou('Application submitted.','Your application has been received.',d.referenceId);
      else alert(d.reason||'Something went wrong. Please try again.');
    }).catch(function(){alert('Something went wrong. Please try again.');});
}

// TOOLS
var cm={tshirt:{mn:.85,mx:1.4},hoodie:{mn:1.8,mx:2.8},woven:{mn:1.2,mx:2.0},trousers:{mn:1.4,mx:2.2},jacket:{mn:3.5,mx:6.0},activewear:{mn:1.6,mx:2.6}};
var fc={cotton:{mn:1.2,mx:2.2},cpoly:{mn:.9,mx:1.8},poly:{mn:.7,mx:1.4},fleece:{mn:1.8,mx:3.2},organic:{mn:2.5,mx:4.5}};
var da={none:0,screen:.35,emb:.55,aop:1.8};var ia={fob:0,cif:.55,ddp:2.2};
function calcFOB(){
  var p=document.getElementById('fob-product').value,f=document.getElementById('fob-fabric').value;
  var q=parseInt(document.getElementById('fob-qty').value)||0,d=document.getElementById('fob-dec').value;
  var i=document.getElementById('fob-inc').value;
  if(!q){alert('Enter order quantity');return;}
  var qf=q<500?1.18:q<1000?1.1:q<3000?1.04:q<5000?1.0:q<10000?.96:.92;
  var mn=((fc[f].mn+cm[p].mn+da[d])*qf*1.15+ia[i]).toFixed(2);
  var mx=((fc[f].mx+cm[p].mx+da[d])*qf*1.15+ia[i]).toFixed(2);
  var tMn=Math.round(mn*q),tMx=Math.round(mx*q);
  var pay=tMn<5000?'Wise / WorldRemit':tMn<30000?'TT (bank transfer)':'Letter of Credit (LC)';
  document.getElementById('fob-price-out').textContent='$'+mn+' \u2013 $'+mx+' per piece';
  document.getElementById('fob-total-out').textContent='Order value: $'+tMn.toLocaleString()+' \u2013 $'+tMx.toLocaleString();
  document.getElementById('fob-pay-out').textContent='Suggested payment: '+pay;
  document.getElementById('fob-result').style.display='block';
  toolData.price='$'+mn+' \u2013 $'+mx; toolData.qty=q;
}
function calcShip(){
  var ds=document.getElementById('ship-date').value; if(!ds){alert('Select a delivery date');return;}
  var pd={tshirt:35,hoodie:45,woven:40,jacket:60,activewear:40};
  var prod=document.getElementById('ship-product').value,qty=parseInt(document.getElementById('ship-qty').value)||0;
  var smpl=document.getElementById('ship-sample').value==='y';
  var fab=document.getElementById('ship-fabric').value==='client';
  var days=(pd[prod]||35)+(qty>=10000?15:qty>=5000?10:qty>=1000?5:0);
  var del=new Date(ds),etd=new Date(del),exf=new Date(),ps=new Date(),fd=new Date(),oc=new Date();
  etd.setDate(del.getDate()-28); exf.setDate(etd.getDate()-5); ps.setDate(exf.getDate()-days);
  fd.setDate(ps.getDate()-(fab?14:10)); oc.setDate(fd.getDate()-(smpl?26:5));
  var fmt=function(dt){return dt.toLocaleDateString('en-GB',{day:'numeric',month:'short'});};
  var now=new Date();
  var items=[{l:'Order confirmation',d:oc},smpl?{l:'Sample approval',d:new Date(oc.getTime()+21*864e5)}:null,{l:'Fabric ready',d:fd},{l:'Production start',d:ps},{l:'Ex-factory',d:exf},{l:'ETD Chittagong',d:etd},{l:'ETA destination',d:del}].filter(Boolean);
  document.getElementById('ship-timeline').innerHTML=items.map(function(it){
    var w=it.d<now,c=w?'#cc4444':'rgba(255,255,255,.75)';
    return '<div style="display:flex;align-items:center;gap:.5rem;padding:.28rem 0;border-bottom:1px solid #1a1a1a"><span style="color:'+c+';font-size:.65rem;flex-shrink:0">'+(w?'\u25b2':'\u25cf')+'</span><span style="font-size:.7rem;color:'+c+';flex:1">'+it.l+'</span><span style="font-size:.7rem;color:#fff;white-space:nowrap">'+fmt(it.d)+'</span></div>';
  }).join('');
  document.getElementById('ship-result').style.display='block';
  toolData.timeline='ETA: '+fmt(del)+' \u00b7 Ex-factory: '+fmt(exf);
}
var fscore={cc:22,oc:38,rp:35,cp:14,bm:36},ssc={sea:24,air:8,exp:3},psc={pb:6,rc:18,fs:19};
function calcSus(){
  var f=document.getElementById('sus-fab').value,s=document.getElementById('sus-ship').value;
  var pk=document.getElementById('sus-pack').value,q=parseInt(document.getElementById('sus-qty').value)||0;
  if(!q){alert('Enter quantity');return;}
  var qb=q>=10000?15:q>=5000?12:q>=2000?9:q>=1000?6:q>=500?4:2;
  var sc=(fscore[f]||22)+(ssc[s]||8)+(psc[pk]||6)+qb;
  var lbl=sc<40?'Needs improvement':sc<60?'Developing':sc<75?'Good':sc<90?'Strong \u2014 EU ready':'Excellent \u2014 CSRD ready';
  var col=sc<60?'#cc4444':sc<75?'#f5a623':'#4caf50';
  document.getElementById('sus-val').textContent=sc;
  document.getElementById('sus-ring').style.borderColor=col;
  document.getElementById('sus-label').textContent=lbl;
  var tips=[];
  if(f==='cp') tips.push('Switch to rPET: +21 points');
  if(f==='cc') tips.push('Organic cotton (GOTS): +16 points');
  if(s==='air'||s==='exp') tips.push('Sea freight cuts carbon by up to 95% vs air');
  if(pk==='pb') tips.push('Recycled packaging: +12 points');
  document.getElementById('sus-tips').innerHTML=tips.map(function(t){
    return '<p style="font-size:.65rem;color:rgba(255,255,255,.6);padding:.2rem .45rem;border-left:2px solid #cc0000;margin-bottom:.2rem">'+t+'</p>';
  }).join('');
  document.getElementById('sus-result').style.display='block';
  toolData.sus=sc+'/100 \u2013 '+lbl;
}
function useInForm(tool){
  if(tool==='fob'){
    if(toolData.price) document.getElementById('b-price').value=toolData.price;
    if(toolData.qty) document.getElementById('b-qty').value=toolData.qty;
  }
  if(tool==='ship'&&toolData.timeline){var m=document.getElementById('b-msg');m.value=(m.value?m.value+'\n\n':'')+'Timeline: '+toolData.timeline;}
  if(tool==='sus'&&toolData.sus){var m=document.getElementById('b-msg');m.value=(m.value?m.value+'\n\n':'')+'Sustainability score: '+toolData.sus;}
  document.getElementById('prefillBar').style.display='block';
}
function showThankYou(title,msg,ref){
  document.getElementById('tyTitle').textContent=title;
  document.getElementById('tyMsg').textContent=msg;
  document.getElementById('tyRef').textContent=ref||'';
  document.getElementById('thankYouOverlay').style.display='flex';
}
</script>

