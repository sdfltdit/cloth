---
---

<section class="matrix-section" id="production-matrix">
  <div class="matrix-container-wrapper">
    <header class="matrix-header">
      <span class="matrix-badge">Technical Utility</span>
      <h2 class="matrix-title">B2B Production Lead-Time & GSM Estimator</h2>
      <p class="matrix-subtitle">Engineered for global fashion procurement teams to forecast technical specifications and factory-exit timelines.</p>
    </header>

    <div class="matrix-ui-box">
      <div class="matrix-input-group">
        <div class="matrix-control">
          <label for="matrix-fabric" class="matrix-label">Fabric Category</label>
          <div class="select-wrapper">
            <select id="matrix-fabric" class="matrix-select">
              <option value="jersey" data-gsm="140-220">Single Jersey (Organic/Pima)</option>
              <option value="terry" data-gsm="240-450">French Terry / Fleece</option>
              <option value="pique" data-gsm="180-240">Pique (Polo Specification)</option>
              <option value="interlock" data-gsm="200-300">Interlock / Rib Knit</option>
              <option value="performance" data-gsm="120-180">Performance Synthetics (Recycled)</option>
            </select>
          </div>
        </div>
        <div class="matrix-control">
          <label for="matrix-qty" class="matrix-label">Production Volume</label>
          <div class="select-wrapper">
            <select id="matrix-qty" class="matrix-select">
              <option value="300" data-days="14-20">Low MOQ (300 - 1,000)</option>
              <option value="5000" data-days="25-35">Mid Volume (1,001 - 10,000)</option>
              <option value="50000" data-days="45-60">Enterprise Bulk (10,000+)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="matrix-display-grid">
        <div class="matrix-data-card">
          <span class="data-label">Optimal GSM Range</span>
          <div id="result-gsm" class="data-value">140 - 220 GSM</div>
          <p class="data-context">Matched to global market durability standards.</p>
        </div>
        <div class="matrix-data-card">
          <span class="data-label">Est. Factory Exit</span>
          <div id="result-lead" class="data-value">14 - 20 Days</div>
          <p class="data-context">Post-sample approval to port handover.</p>
        </div>
        <div class="matrix-data-card">
          <span class="data-label">Logistics Hub (USA/EU)</span>
          <div id="result-shipping" class="data-value">22 - 28 Days (Sea)</div>
          <p class="data-context">Direct export from Chittagong Terminal.</p>
        </div>
      </div>

      <footer class="matrix-footer">
        <p class="matrix-disclaimer">Specifications include AQL 2.5 inspection. GOTS/GRS certification adds 3-5 days for TC issuance.</p>
        <a href="/contact" class="matrix-cta">Access Full Technical Matrix</a>
      </footer>
    </div>
  </div>
</section>

<style>
  .matrix-section {
    padding: 6rem 0;
    background: #000;
    border-top: 1px solid #111;
  }

  .matrix-container-wrapper {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .matrix-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .matrix-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #888;
    margin-bottom: 1rem;
    border: 1px solid #333;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  .matrix-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .matrix-subtitle {
    font-size: 1.1rem;
    color: #888;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .matrix-ui-box {
    background: #050505;
    border: 1px solid #222;
    border-radius: 1px; /* Minimalist sharp corners */
    padding: 4rem;
  }

  .matrix-input-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .matrix-control {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .matrix-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
  }

  .select-wrapper {
    position: relative;
  }

  .matrix-select {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid #333;
    color: #fff;
    padding: 0.75rem 0;
    font-size: 1.1rem;
    cursor: pointer;
    border-radius: 0;
    transition: border-color 0.3s;
    appearance: none;
  }

  .matrix-select:focus {
    outline: none;
    border-bottom-color: #fff;
  }

  .matrix-display-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .matrix-data-card {
    padding: 2rem;
    border: 1px solid #111;
    background: #080808;
    transition: border-color 0.3s;
  }

  .matrix-data-card:hover {
    border-color: #333;
  }

  .data-label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin-bottom: 1rem;
  }

  .data-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .data-context {
    font-size: 0.8rem;
    color: #555;
    line-height: 1.4;
  }

  .matrix-footer {
    text-align: center;
    border-top: 1px solid #111;
    padding-top: 3rem;
  }

  .matrix-disclaimer {
    font-size: 0.75rem;
    color: #444;
    font-style: italic;
    margin-bottom: 2rem;
  }

  .matrix-cta {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.3s;
  }

  .matrix-cta:hover {
    background: #ccc;
  }

  @media (max-width: 768px) {
    .matrix-input-group, .matrix-display-grid {
      grid-template-columns: 1fr;
    }
    .matrix-ui-box {
      padding: 2rem;
    }
    .matrix-title {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  function updateMatrix() {
    const fabricSelect = document.getElementById('matrix-fabric') as HTMLSelectElement;
    const qtySelect = document.getElementById('matrix-qty') as HTMLSelectElement;

    const gsmResult = document.getElementById('result-gsm');
    const leadResult = document.getElementById('result-lead');

    if (fabricSelect && qtySelect && gsmResult && leadResult) {
      const selectedFabric = fabricSelect.options[fabricSelect.selectedIndex];
      const selectedQty = qtySelect.options[qtySelect.selectedIndex];

      gsmResult.textContent = (selectedFabric.getAttribute('data-gsm') || '') + ' GSM';
      leadResult.textContent = (selectedQty.getAttribute('data-days') || '') + ' Days';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const fabricSelect = document.getElementById('matrix-fabric');
    const qtySelect = document.getElementById('matrix-qty');

    fabricSelect?.addEventListener('change', updateMatrix);
    qtySelect?.addEventListener('change', updateMatrix);
  });
</script>
