---
// WhyChooseSection.astro
import { getCompanyAgeString } from '../utils/companyAge';

const companyAge = getCompanyAgeString();

const features = [
  {
    title: `${companyAge} Experience`,
    desc: "Trusted clothing manufacturer since 1998 with proven expertise in OEM and private label production.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><circle cx="20" cy="20" r="16"/><path d="M20 10 L20 20 L26 24"/></svg>`,
  },
  {
    title: "Low MOQ 300 Pieces",
    desc: "Flexible minimum order quantities for startups and established brands seeking quality manufacturing.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><rect x="6" y="6" width="28" height="28" rx="1"/><path d="M6 14 L34 14"/><path d="M14 14 L14 34"/></svg>`,
  },
  {
    title: "Certifications",
    desc: "GOTS, OEKO-TEX, ISO 9001, BSCI, SEDEX certified sustainable manufacturer.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><path d="M20 4 L26 16 L38 18 L30 28 L32 38 L20 32 L8 38 L10 28 L2 18 L14 16 Z"/></svg>`,
  },
  {
    title: "Full Package Production",
    desc: "End-to-end solutions from fabric sourcing to final delivery with complete supply chain management.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><path d="M6 12 L20 4 L34 12 L34 28 L20 36 L6 28 Z"/><path d="M20 4 L20 36"/><path d="M6 12 L34 12"/></svg>`,
  },
  {
    title: "Tech Pack Support",
    desc: "Expert design team helps develop detailed tech packs for accurate production specifications.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><rect x="8" y="6" width="24" height="28" rx="1"/><path d="M14 14 L26 14"/><path d="M14 20 L26 20"/><path d="M14 26 L22 26"/></svg>`,
  },
  {
    title: "FOB Chittagong",
    desc: "Competitive shipping rates and reliable logistics from Bangladesh to global markets worldwide.",
    icon: `<svg width="52" height="52" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="1.5" aria-hidden="true" class="hover-icon"><path d="M6 24 L14 24 L14 34 L6 34 Z"/><path d="M14 28 L26 18 L34 24"/><path d="M4 34 L36 34"/><path d="M28 10 L36 10 L36 26"/></svg>`,
  },
];
---

<section id="why" aria-labelledby="why-heading">
  <div class="container">

    <div class="why-header section-header">
      <div class="why-header-icon">
        <svg width="48" height="48" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="2" aria-hidden="true">
          <path d="M20 4 L24 14 L35 14 L26 21 L30 31 L20 24 L10 31 L14 21 L5 14 L16 14 Z"/>
        </svg>
      </div>
      <span class="section-label">Why Choose</span>
      <span class="accent-line"></span>
      <h2 id="why-heading">Sustainable Low MOQ Clothing Manufacturer</h2>
    </div>

    <div class="why-grid">
      {features.map((f) => (
        <div class="why-card">
          <div class="why-icon" set:html={f.icon} />
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .why-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }
  .why-header-icon {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 0 8px rgba(204,0,0,0.2));
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #000000;
    border: 1px solid #1a1a1a;
  }
  .why-card {
    background: #000;
    padding: 1.5rem 1.25rem;
  }
  .why-card:hover { background: #0a0a0a; }
  .why-icon {
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 6px rgba(204,0,0,0.3));
  }
  .why-card h3 {
    font-size: 0.88rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .why-card p {
    font-size: 0.8rem;
    color: #fff;
    line-height: 1.8;
  }
  .hover-icon {
    transition: stroke 0.2s ease;
  }
  .why-card:hover .hover-icon {
    stroke: #666;
    filter: drop-shadow(0 0 8px rgba(100,100,100,0.5));
  }
  @media (max-width: 900px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
