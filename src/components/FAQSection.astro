---
// FAQSection.astro

const faqs = [
  {
    q: "What is your minimum order quantity (MOQ)?",
    a: "Our standard MOQ is 300 pieces per style and colour for most garment categories. For complex items like jackets and outerwear, MOQ starts at 100 pieces. We designed our low MOQ specifically to support startups and boutique brands launching new collections.",
  },
  {
    q: "How long does production take?",
    a: "Sample production takes 7-14 days. Bulk production is 30-45 days depending on the garment type, quantity, and complexity. Jackets and heavily constructed pieces may take up to 60 days for bulk.",
  },
  {
    q: "Do you offer private label and OEM manufacturing?",
    a: "Yes. We offer full private label services including custom branding, labels, hang tags, and packaging. We also offer OEM manufacturing where you supply the design and we handle production. Both services include tech pack support.",
  },
  {
    q: "What types of garments do you manufacture?",
    a: "We manufacture knitwear (t-shirts, hoodies, polo shirts), woven apparel (shirts, trousers, jackets), activewear and sportswear, women's wear, kids wear, uniforms, and sleepwear  30+ categories in total.",
  },
  {
    q: "What certifications do you hold?",
    a: "We hold 13 certifications including GOTS (organic textiles), OEKO-TEX Standard 100, ISO 9001 (quality), ISO 14001 (environmental), SA8000 (social compliance), BSCI, SEDEX, WRAP, GRS (recycled), and C-TPAT.",
  },
  {
    q: "What is your quality control process?",
    a: "We implement AQL 2.5 inspection at every stage  fabric inspection on arrival, inline quality checks during cutting and sewing, and a final audit before shipment. Every bulk order receives a full inspection report.",
  },
  {
    q: "Do you ship internationally?",
    a: "Yes. We ship FOB from Chittagong and Dhaka ports to the USA, UK, EU, Australia, Canada, and 40+ countries worldwide. We manage full export documentation including certificates of origin and compliance documents.",
  },
  {
    q: "What payment terms do you accept?",
    a: "Standard terms are 30% advance with order confirmation and 70% before shipment via bank transfer (T/T). We can discuss letter of credit (L/C) arrangements for established clients with large orders.",
  },
  {
    q: "Can you help with tech pack development?",
    a: "Yes. Our in-house design team helps develop complete tech packs from your sketches or concepts. This includes technical drawings, measurement specs, BOM (bill of materials), and construction details.",
  },
  {
    q: "Do you offer sustainable and organic garment production?",
    a: "Absolutely. We are GOTS certified for organic textile production and GRS certified for recycled content garments. We also offer OEKO-TEX certified production using chemical-safe materials throughout.",
  },
];
---

<section id="faq" aria-labelledby="faq-heading" class="faq-section">
  <div class="container">

    <div class="section-header faq-header">
      <div class="faq-header-icon" style="margin-bottom:1rem; display:flex; justify-content:center;">
        <svg width="48" height="48" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="2" aria-hidden="true">
          <circle cx="20" cy="20" r="16"/>
          <path d="M18 24 L20 24 L22 24"/>
          <path d="M20 20 L20 20"/>
          <path d="M18 14 C18 12 20 12 22 14 C22 16 20 17 20 18"/>
        </svg>
      </div>
      <span class="section-label">FAQ</span>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <p>Everything you need to know about working with SDF Clothing.</p>
    </div>

    <div class="faq-grid">

      <!-- FAQ List -->
      <div class="faq-list" aria-label="Frequently asked questions">
        {faqs.map((f, i) => (
          <details class="faq-item">
            <summary class="faq-q" aria-expanded="false">
              <span>{f.q}</span>
              <svg class="faq-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#666" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M2 5 L7 9 L12 5"/>
              </svg>
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Side Panel -->
      <div class="faq-side">
        <div class="faq-side-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.5" stroke-linecap="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>

        <h3 class="faq-side-title">Still have questions?</h3>
        <p class="faq-side-desc">Our production experts respond within 48 hours. Get a free consultation about your garment requirements.</p>

        <div class="faq-stats-grid" aria-label="Key statistics">
          <div class="faq-stat">
            <div class="faq-stat-val">24h</div>
            <div class="faq-stat-label">Response Time</div>
          </div>
          <div class="faq-stat">
            <div class="faq-stat-val">Free</div>
            <div class="faq-stat-label">Consultation</div>
          </div>
          <div class="faq-stat">
            <div class="faq-stat-val">7d</div>
            <div class="faq-stat-label">Sample Start</div>
          </div>
          <div class="faq-stat">
            <div class="faq-stat-val">300</div>
            <div class="faq-stat-label">Min. Order</div>
          </div>
        </div>

        <a href="https://wa.me/8801819172080?text=Hi%20SDF%20Clothing,%20I%20have%20a%20question" target="_blank" rel="noopener noreferrer" class="faq-cta-btn">Contact Us</a>
        <a href="/contact/" class="faq-email-btn email-protected">
          Get In Touch →
        </a>
        <p class="faq-certs">GOTS · OEKO-TEX · ISO 9001 · BSCI CERTIFIED</p>
      </div>

    </div>
  </div>
</section>

<style>
  .faq-header .accent-line {
    display: none;
  }
  .faq-section { padding-top: 1.5rem; }
  .faq-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 3rem;
    align-items: start;
  }
  .faq-list {
    border: 1px solid #1a1a1a;
  }
  .faq-item {
    border-bottom: 1px solid #1a1a1a;
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    width: 100%;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    text-align: left;
    font-size: 0.88rem;
    color: #FFFFFF;
    font-family: inherit;
    letter-spacing: 0.03em;
    transition: color 0.2s, background 0.2s;
    list-style: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { color: #fff; background: #0a0a0a; }
  .faq-item[open] > .faq-q { color: #fff; background: #0a0a0a; }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }
  .faq-chevron { flex-shrink: 0; transition: transform 0.25s ease; }
  .faq-a {
    padding: 0 1.5rem 1.5rem;
    background: #0a0a0a;
  }
  .faq-a p {
    font-size: 0.85rem;
    color: #bbb;
    line-height: 1.9;
  }

  /* Side panel */
  .faq-side {
    border: 1px solid #1a1a1a;
    background: #050505;
    padding: 2rem;
    position: sticky;
    top: 80px;
  }
  .faq-side-icon {
    width: 48px;
    height: 48px;
    border: 1px solid #e00;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .faq-side-title {
    font-size: 1.1rem;
    font-weight: 300;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .faq-side-desc {
    font-size: 0.85rem;
    color: #aaa;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .faq-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #000000;
    margin-bottom: 1.5rem;
  }
  .faq-stat {
    background: #000;
    padding: 1rem;
    text-align: center;
  }
  .faq-stat-val {
    font-size: 1.4rem;
    font-weight: 200;
    color: #fff;
    line-height: 1;
  }
  .faq-stat-label {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e00;
    margin-top: 0.3rem;
  }
  .faq-cta-btn {
    display: block;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: #e00;
    color: #fff;
    padding: 0.9rem 1.5rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
    transition: background 0.25s;
  }
  .faq-cta-btn:hover { background: #aa0000; color: #fff; }
  .faq-email-btn {
    display: block;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    padding: 0.75rem;
    border: 1px solid #1a1a1a;
    text-decoration: none;
    transition: border-color 0.25s;
    margin-bottom: 1rem;
  }
  .faq-email-btn:hover { border-color: #e00; color: #fff; }
  .faq-certs {
    font-size: 0.62rem;
    color: #FFFFFF;
    text-align: center;
    letter-spacing: 0.1em;
    margin: 0;
  }

  @media (max-width: 768px) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .faq-side { position: static; }
  }
</style>
