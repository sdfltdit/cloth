---
export interface Props {
	faqs?: Array<{
		question: string;
		answer: string;
	}>;
}

const { faqs = [] } = Astro.props;
---

<section id="faq" class="py-16 bg-primary-900">
	<div class="container mx-auto px-4">
		<div class="text-center mb-12">
			<span class="text-accent-500 font-medium uppercase tracking-wider">FAQ</span>
			<h2 class="text-4xl font-medium text-white mb-4">Frequently Asked Questions</h2>
			<p class="text-primary-300 max-w-2xl mx-auto">Common questions about our garments manufacturing services</p>
		</div>
		
		<div class="max-w-3xl mx-auto">
			{faqs.length > 0 ? (
				<div class="space-y-4">
					{faqs.map((faq, index) => (
						<div class="bg-primary-800 overflow-hidden">
							<button 
								class="w-full px-6 py-4 text-left flex items-center justify-between text-white hover:bg-primary-700 transition-colors"
								onClick={`toggleFAQ(${index})`}
							>
								<span class="font-medium">{faq.question}</span>
								<svg class="w-5 h-5 transform transition-transform" id={`faq-icon-${index}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
								</svg>
							</button>
							<div class="hidden px-6 py-4 text-primary-300 border-t border-primary-700" id={`faq-answer-${index}`}>
								<p>{faq.answer}</p>
							</div>
						</div>
					))}
				</div>
			) : (
				<div class="text-center text-primary-300 py-8">
					<p>No FAQs available at the moment.</p>
				</div>
			)}
		</div>
	</div>
</section>

<script>
function toggleFAQ(index) {
	const answer = document.getElementById(`faq-answer-${index}`);
	const icon = document.getElementById(`faq-icon-${index}`);
	
	if (answer.classList.contains('hidden')) {
		answer.classList.remove('hidden');
		icon.classList.add('rotate-180');
	} else {
		answer.classList.add('hidden');
		icon.classList.remove('rotate-180');
	}
}
</script>
