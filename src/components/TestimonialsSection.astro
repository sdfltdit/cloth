---
// TestimonialsSection.astro - Track Record & Case Studies

// Dynamic bulk orders calculator
// Base date: January 1, 1998 (founding year)
// Starting orders: 10,000,000 (10 Million+ orders completed since 1998)
// Growth: +7 orders every 2 months
const baseDate = new Date('1998-01-01');
const currentDate = new Date();
const startingOrders = 10000000; // 10 Million orders
const ordersGrowthPerPeriod = 7; // +7 orders every 2 months

// Calculate months passed
const monthsPassed = (currentDate.getFullYear() - baseDate.getFullYear()) * 12 + 
                    (currentDate.getMonth() - baseDate.getMonth());

// Calculate how many 2-month periods have passed
const periodsPassed = Math.floor(monthsPassed / 2);

// Calculate current orders
const currentOrders = startingOrders + (periodsPassed * ordersGrowthPerPeriod);

// Format for display - show in millions
const formatOrders = (orders) => {
  const millions = (orders / 1000000).toFixed(1);
  return `${millions} M+`;
};

// Get current factory production status - realistic algorithm based on real factory factors
const getProductionStatus = () => {
  const currentDate = new Date();
  const currentMonth = currentDate.getMonth();
  const currentYear = currentDate.getFullYear();
  const currentDay = currentDate.getDate();
  
  // Base production capacity (realistic factory size)
  const baseCapacity = 6;
  
  // Seasonal factors (real garment manufacturing patterns)
  const seasonalFactors = {
    // Peak seasons: Spring (Mar-May) and Fall (Sep-Nov)
    2: 1.3, 3: 1.4, 4: 1.3,  // Spring peak
    9: 1.2, 10: 1.3, 11: 1.2, // Fall peak
    // Slow seasons: Summer (Jun-Aug) and Winter (Dec-Feb)
    6: 0.7, 7: 0.6, 8: 0.8,  // Summer slow
    12: 0.8, 1: 0.9, 0: 0.9,  // Winter slow
  };
  
  // Day of month factor (production ramps up/down during month)
  const dayFactor = currentDay <= 10 ? 0.9 : currentDay <= 20 ? 1.0 : 1.1;
  
  // Year-based growth (factory expansion over time)
  const yearsSince2020 = currentYear - 2020;
  const growthFactor = 1 + (yearsSince2020 * 0.05); // 5% growth per year
  
  // Calculate realistic production
  const seasonalMultiplier = seasonalFactors[currentMonth] || 1.0;
  let productionCount = Math.round(baseCapacity * seasonalMultiplier * dayFactor * growthFactor);
  
  // Add some realistic variation (±1 production line)
  const variation = Math.sin(currentDate.getTime() / 10000000) > 0 ? 1 : -1;
  productionCount += variation;
  
  // Ensure realistic bounds (3-8 productions for a medium factory)
  productionCount = Math.max(3, Math.min(8, productionCount));
  
  return `${productionCount} productions running now`;
};
---

<section id="testimonials" aria-labelledby="testi-heading">
  <div class="container">

    <div style="margin-bottom:2.5rem;text-align:center;max-width:700px;margin:0 auto;" class="section-header">
      <div class="section-icon-wrapper" style="margin-bottom:1rem; display:flex; justify-content:center;">
        <svg width="48" height="48" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="2" aria-hidden="true">
          <path d="M8 8 L32 8 L32 24 L20 24 L14 30 L14 24 L8 24 Z"/>
          <circle cx="16" cy="16" r="2" fill="#e00"/>
          <circle cx="24" cy="16" r="2" fill="#e00"/>
        </svg>
      </div>
      <span class="section-label" style="display:block;margin-bottom:0.5rem;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0s;">Track Record</span>
      <span class="accent-line" style="display:block;width:40px;height:1px;background:#e00;margin:0 auto 1.5rem auto;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.1s;"></span>
      <h2 id="testi-heading" style="font-size:clamp(1.6rem,3vw,2.2rem);font-weight:200;color:#fff;margin-bottom:0.5rem;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.2s;">Proven Results for Global Fashion Brands</h2>
    </div>

    <!-- Stats row -->
    <div class="track-stats">
      <div class="track-stat">
        <div class="track-num">{formatOrders(currentOrders)} <span style="font-size:0.9rem; color:#fff;">Bulk orders completed</span></div>
        <div class="track-label" style="color:#FFFFFF; display:flex; align-items:center; gap:0.3rem;">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="#666" stroke-width="1" aria-hidden="true">
            <circle cx="6" cy="6" r="5"/>
            <path d="M6 3 L6 6 L8 8"/>
          </svg>
          {getProductionStatus()}
        </div>
      </div>
      <div class="track-stat">
        <div class="track-num">38</div>
        <div class="track-label">Average days to delivery</div>
      </div>
      <div class="track-stat">
        <div class="track-num">94%</div>
        <div class="track-label">Client reorder rate</div>
      </div>
      <div class="track-stat">
        <div class="track-num">53+</div>
        <div class="track-label">Countries supplied</div>
      </div>
    </div>

    <!-- Case studies -->
    <div class="case-grid">
      <div class="case-card">
        <div class="case-tag">Activewear · Netherlands</div>
        <p class="case-desc">3,000 units GOTS-certified organic cotton hoodies. Delivered FOB Rotterdam in 38 days. AQL 2.5 inspection passed. Client reordered 6,000 units the following season.</p>
        <div class="case-meta">
          <span>6,000 pcs reorder</span>
          <span class="case-dot"></span>
          <span>GOTS certified</span>
          <span class="case-dot"></span>
          <span>38 days</span>
        </div>
      </div>
      <div class="case-card">
        <div class="case-tag">Private Label · United Kingdom</div>
        <p class="case-desc">Full tech pack development for a 12-style women's knitwear range. 300 pcs MOQ per style. Screen print and woven label finishing. Passed UK Modern Slavery Act compliance audit.</p>
        <div class="case-meta">
          <span>12 styles</span>
          <span class="case-dot"></span>
          <span>300 pcs MOQ</span>
          <span class="case-dot"></span>
          <span>UK compliant</span>
        </div>
      </div>
      <div class="case-card">
        <div class="case-tag">OEM · United States</div>
        <p class="case-desc">15,000 units performance activewear with moisture-wicking fabric and sublimation print. FOB Chittagong to Los Angeles. US customs documentation handled end-to-end.</p>
        <div class="case-meta">
          <span>15,000 pcs</span>
          <span class="case-dot"></span>
          <span>Sublimation print</span>
          <span class="case-dot"></span>
          <span>FOB LA</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .track-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #000000;
    border: 1px solid #1a1a1a;
    margin-bottom: 1px;
  }
  .track-stat {
    background: #000;
    padding: 1.5rem;
    transition: background 0.2s;
  }
  .track-stat:hover { background: #0a0a0a; }
  .track-num {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 300;
    color: #fff;
    letter-spacing: 0.02em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .track-label {
    font-size: 0.72rem;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #000000;
    border: 1px solid #1a1a1a;
  }
  .case-card {
    background: #000;
    padding: 1.5rem;
    transition: background 0.2s;
  }
  .case-card:hover { background: #0a0a0a; }
  .case-tag {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 0.85rem;
    font-weight: 500;
  }
  .case-desc {
    font-size: 0.8rem;
    color: #fff;
    line-height: 1.85;
    margin-bottom: 1rem;
  }
  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.65rem;
    color: #fff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .case-dot {
    width: 3px;
    height: 3px;
    background: #000000;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .track-stats { grid-template-columns: repeat(2, 1fr); }
    .case-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .track-stats { grid-template-columns: 1fr; }
    .track-stat { padding: 1rem; }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes drawChart {
    from { 
      opacity: 0;
      stroke-dashoffset: 100;
    }
    to { 
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  .section-icon {
    display: inline-block;
  }
</style>