---
// CertificationsSection.astro

const certs = [
  {
    code: "GOTS",
    title: "Global Organic Textile Standard",
    desc: "Certified organic clothing manufacturer ensuring sustainable textile production from harvest to finished garment.",
    featured: true,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  },
  {
    code: "OEKO-TEX",
    title: "Standard 100 Certification",
    desc: "Textile safety certification ensuring our garments are free from harmful substances and safe for consumers.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  },
  {
    code: "ISO 9001",
    title: "Quality Management System",
    desc: "International standard for quality management in clothing manufacturing and apparel production processes.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 20v2M12 2v2"/></svg>`,
  },
  {
    code: "ISO 14001",
    title: "Environmental Management",
    desc: "Environmental management certification demonstrating our commitment to reducing manufacturing impact.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0-20"/><path d="M2 12h20"/></svg>`,
  },
  {
    code: "SA8000",
    title: "Social Accountability",
    desc: "Social compliance certification ensuring fair wages, safe working conditions, and no child labour.",
    featured: true,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    code: "BSCI",
    title: "Business Social Compliance",
    desc: "Audited for labour rights, health and safety, and management systems across our production facility.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
  },
  {
    code: "SEDEX",
    title: "Ethical Trade Platform",
    desc: "SEDEX member sharing ethical trade data with brands to ensure full supply chain transparency.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
  },
  {
    code: "WRAP",
    title: "Worldwide Responsible Accredited Production",
    desc: "Independently certified for lawful, humane and ethical manufacturing practices.",
    featured: false,
    icon: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>`,
  },
  {
    code: "GRS",
    title: "Global Recycled Standard",
    desc: "Certified to produce garments from verified recycled content with full chain-of-custody tracking.",
