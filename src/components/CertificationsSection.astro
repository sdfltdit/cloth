---

<section id="certifications" aria-labelledby="cert-heading">
  <div class="container">

    <div style="margin-bottom:3rem;text-align:center;max-width:700px;margin:0 auto;" class="section-header">
      <div class="cert-header-icon" style="margin-bottom:1rem; display:flex; justify-content:center;">
        <svg width="48" height="48" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="2" aria-hidden="true">
          <path d="M20 4 L30 8 L30 20 C30 28 20 34 20 34 C20 34 10 28 10 20 L10 8 Z"/>
          <path d="M16 20 L19 23 L25 17"/>
        </svg>
      </div>
      <span class="section-label cert-fade" style="display:block;margin-bottom:0.5rem;">Certifications</span>
      <span class="accent-line cert-fade" style="display:block;width:40px;height:1px;background:#e00;margin:0 auto 1.5rem auto;"></span>
      <h2 id="cert-heading" class="cert-fade" style="font-size:clamp(1.6rem,3vw,2.2rem);font-weight:200;color:#fff;margin-bottom:0.5rem;">Certified Clothing Manufacturer Bangladesh</h2>
      <p class="cert-fade" style="margin-top:1rem;font-size:0.9rem;color:#FFFFFF;">
        Our sustainable manufacturing facility maintains the highest international standards 
        quality, environmental responsibility, and social compliance.
      </p>
    </div>

    <div class="cert-grid-main">
      {certs.map((c) => (
        <div class={`cert-card${c.featured ? " cert-featured" : ""}`}>
          <div set:html={c.icon} style="margin-bottom:0.75rem;"></div>
          <div class="cert-code">{c.code}</div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .cert-header-icon {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    filter: drop-shadow(0 0 8px rgba(204,0,0,0.2));
  }
  .cert-grid-main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #000000;
    border: 1px solid #1a1a1a;
  }
  .cert-card {
    background: #000;
    padding: 1.25rem 1rem;
    transition: background 0.2s;
  }
  .cert-card:hover { background: #0a0a0a; }
  .cert-featured { background: #050505; }
  .cert-featured .cert-code { color: #FFFFFF; border-color: #FFFFFF; }

  .cert-code {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    border: 1px solid #1a1a1a;
    padding: 0.3rem 0.6rem;
    margin-bottom: 1rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .cert-card:hover .cert-code { color: #FFFFFF; border-color: #FFFFFF; }

  .cert-card h3 {
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.04em;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }
  .cert-fade {
    opacity: 0;
    animation: fadeInUp 0.7s ease forwards;
  }
  .cert-card p {
    font-size: 0.85rem;
    color: #aaa;
    line-height: 1.8;
  }

  .cert-card:hover svg {
    animation: fadeIn 0.8s ease forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 900px) {
    .cert-grid-main { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .cert-grid-main { grid-template-columns: 1fr; }
  }
</style>