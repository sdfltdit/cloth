---
// ProcessSection.astro

const steps = [
  { num: "01", title: "Design Consultation", desc: "Review tech pack and requirements. Our team analyses your specs for feasibility and cost optimisation." },
  { num: "02", title: "Fabric Sourcing", desc: "Select sustainable, certified materials from our trusted supplier network. GOTS and OEKO-TEX options available." },
  { num: "03", title: "Pattern Making", desc: "Create precise patterns with our in house technical team ensuring accurate fit and construction." },
  { num: "04", title: "Sample Production", desc: "Develop prototype samples within 7–14 days for your review and approval before bulk production." },
  { num: "05", title: "Bulk Manufacturing", desc: "Cut and sew production with strict quality monitoring at every stage. Up to 50,000 units per month." },
  { num: "06", title: "Quality Control", desc: "AQL 2.5 inspection on every bulk order. Final audit before shipping ensures zero compromise on standards." },
];
---

<section id="process" aria-labelledby="process-heading">
  <div class="container">

    <div style="margin-bottom:3.5rem;text-align:center;max-width:700px;margin:0 auto;" class="section-header">
      <div class="process-header-icon" style="margin-bottom:1.5rem;display:flex;justify-content:center;filter: drop-shadow(0 0 8px rgba(204,0,0,0.2));opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0s;">
        <svg width="48" height="48" viewBox="0 0 40 40" fill="none" stroke="#e00" stroke-width="2" aria-hidden="true">
          <path d="M20 8 L28 12 L28 20 L24 24 L20 28 L16 24 L12 20 L12 12 Z"/>
          <path d="M20 8 L20 16"/>
          <path d="M28 12 L24 16"/>
          <path d="M28 20 L24 16"/>
          <path d="M20 28 L20 20"/>
          <path d="M12 20 L16 16"/>
          <path d="M12 12 L16 16"/>
        </svg>
      </div>
      <span class="section-label" style="display:block;margin-bottom:0.5rem;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.1s;">Our Process</span>
      <span class="accent-line" style="display:block;width:40px;height:1px;background:#e00;margin:0 auto 1.5rem auto;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.2s;"></span>
      <h2 id="process-heading" style="font-size:clamp(1.6rem,3vw,2.2rem);font-weight:200;color:#fff;margin-bottom:0.5rem;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.3s;">From Design to Delivery</h2>
      <p style="margin-top:1rem;font-size:0.9rem;color:#fff;opacity:0;animation: fadeInUp 0.7s ease forwards;animation-delay:0.5s;">
        Streamlined manufacturing process ensuring quality and timely delivery  sample in 7–14 days, bulk in 30–45 days.
      </p>
    </div>

    <div class="process-grid">
      {steps.map((s) => (
        <div class="process-step">
          <div class="step-num">{s.num}</div>
          <div class="step-content">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #000000;
    border: 1px solid #1a1a1a;
  }
  .process-step {
    background: #000;
    padding: 1.5rem 1.25rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    transition: background 0.2s;
  }
  .process-step:hover { background: #0a0a0a; }
  .step-num {
    font-size: 32px;
    letter-spacing: 0.2em;
    color: #FFFFFF;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 3px;
    margin-right: 0.5rem;
  }
  .step-content h3 {
    font-size: 0.88rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
  }
  .step-content p {
    font-size: 0.8rem;
    color: #fff;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 500px) {
    .process-grid { grid-template-columns: 1fr; }
  }
</style>