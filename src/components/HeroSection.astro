---
const { yearsExp } = Astro.props;
---

<section id="hero" class="hero-section">

  <div class="hero-left">
    <span style="font-size:0.65rem;letter-spacing:0.25em;text-transform:uppercase;color:#ccc;display:block;margin-bottom:1.5rem;">Bangladesh · Est. 1998</span>
    <h1>
      Clothing Manufacturers Bangladesh
    </h1>
    <p style="font-size:clamp(1.2rem,2.5vw,1.8rem);font-weight:400;color:#ccc;line-height:1.15;letter-spacing:0.02em;margin-bottom:1rem;">
      We Manufacture<br>
      <span id="hero-typewriter" style="color:#ccc;font-weight:400;"></span><span class="hero-cursor" aria-hidden="true">|</span>
    </p>
    <p style="font-size:0.95rem;color:#fff;line-height:1.9;margin-bottom:2.5rem;max-width:480px;">
      Full-service garment production from Bangladesh. MOQ 300 pieces. GOTS &amp; OEKO-TEX certified. Supplying USA, UK, EU, Australia since 1998.
    </p>
    <div class="hero-cta-row">
      <a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing,%20I%20need%20a%20quote%20for%20clothing%20manufacturing" target="_blank" rel="noopener noreferrer" style="display:inline-block;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;background:#666;color:#fff;padding:0.9rem 2rem;font-weight:500;">Request a Quote</a>
      <a href="/products/" style="display:inline-block;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:#fff;border:0.6px solid #fff;padding:0.9rem 2rem;">View Capabilities</a>
    </div>
    <div class="hero-badges">
      <span>{yearsExp} Yrs Experience</span><span style="color:#ccc;margin:0 0.75rem;">·</span>
      <span>MOQ 300 Pieces</span><span style="color:#ccc;margin:0 0.75rem;">·</span>
      <span>50K+ Monthly Capacity</span><span style="color:#ccc;margin:0 0.75rem;">·</span>
      <span>13 Certifications</span>
    </div>
  </div>

  <div class="hero-right">
    <p style="font-size:0.85rem;letter-spacing:0.3em;text-transform:uppercase;color:#ffffff;margin-bottom:2.5rem;text-align:center;">Active Export Markets</p>

    <div class="hero-markets-grid">
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇺🇸</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">United States</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">US Customs Compliant</div>
        </div>
      </div>
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇬🇧</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">United Kingdom</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">UK GSP Trade Terms</div>
        </div>
      </div>
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇩🇪</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">Germany</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">EU Regulations Compliant</div>
        </div>
      </div>
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇦🇺</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">Australia</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">AU Standards Compliant</div>
        </div>
      </div>
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇨🇦</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">Canada</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">North American Reach</div>
        </div>
      </div>
      <div class="hero-market-item">
        <span style="font-size:1.8rem;">🇸🇪</span>
        <div>
          <div style="font-size:0.9rem;color:#fff;font-weight:500;line-height:1.2;">Sweden</div>
          <div style="font-size:0.72rem;color:#fff;letter-spacing:0.06em;text-transform:uppercase;opacity:0.7;">Nordic Market Leader</div>
        </div>
      </div>
    </div>

    <div class="hero-stats-row">
      <div style="text-align:center;">
        <div style="font-size:2.8rem;font-weight:200;color:#fff;line-height:1;" id="market-counter">40</div>
        <div style="font-size:0.78rem;letter-spacing:0.15em;text-transform:uppercase;color:#ffffff;margin-top:0.3rem;">Countries</div>
      </div>
      <div style="width:1px;background:#1a1a1a;"></div>
      <div style="text-align:center;">
        <div style="font-size:2.8rem;font-weight:200;color:#fff;line-height:1;">98%</div>
        <div style="font-size:0.78rem;letter-spacing:0.15em;text-transform:uppercase;color:#ffffff;margin-top:0.3rem;">On-Time</div>
      </div>
      <div style="width:1px;background:#1a1a1a;"></div>
      <div style="text-align:center;">
        <div style="font-size:2.8rem;font-weight:200;color:#fff;line-height:1;">72h</div>
        <div style="font-size:0.78rem;letter-spacing:0.15em;text-transform:uppercase;color:#ffffff;margin-top:0.3rem;">Sample</div>
      </div>
    </div>

    <p style="font-size:0.75rem;letter-spacing:0.2em;text-transform:uppercase;color:#aaa;margin-top:1.5rem;text-align:center;">FOB Chittagong · Since 1998</p>
  </div>

</section>

<style>
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .hero-cursor {
    color:#ccc;
    animation:blink 1s infinite;
    display:inline-block;
    width:2px;
  }

  .hero-section {
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 0;
    border-bottom: 1px solid #1a1a1a;
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-left {
    padding: 60px 40px 40px 40px;
    max-width: 600px;
  }

  .hero-right {
    height: 100%;
    min-height: 90vh;
    background: #050505;
    border-left: 1px solid #1a1a1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
    overflow: hidden;
  }

  .hero-markets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #1a1a1a;
    width: 100%;
    max-width: 480px;
    border: 1px solid #1a1a1a;
  }

  .hero-market-item {
    background: #0a0a0a;
    padding: 1.1rem 1.3rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-stats-row {
    display: flex;
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #1a1a1a;
    width: 100%;
    max-width: 420px;
    justify-content: center;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    gap: 0;
  }

  @media (max-width: 768px) {
    .hero-section {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
    }
    .hero-left {
      padding: 48px 1.5rem 32px !important;
      max-width: 100%;
    }
    .hero-right {
      min-height: auto !important;
      padding: 32px 1.5rem !important;
      border-left: none !important;
      border-top: 1px solid #1a1a1a;
    }
    .hero-markets-grid {
      max-width: 100%;
    }
    .hero-stats-row {
      max-width: 100%;
      gap: 1rem;
    }
  }
</style>

<script defer>
(function(){
  var words=["Premium Knitwear","Woven Apparel","Activewear","Private Label","Your Brand"];
  var wi=0,ci=0,del=false;
  var el=document.getElementById('hero-typewriter');
  function tick(){
    if(!el)return;
    var w=words[wi];
    if(!del){el.textContent=w.slice(0,++ci);if(ci===w.length){del=true;setTimeout(tick,1800);return;}}
    else{el.textContent=w.slice(0,--ci);if(ci===0){del=false;wi=(wi+1)%words.length;}}
    setTimeout(tick,del?55:85);
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',tick);}else{tick();}
})();
</script>