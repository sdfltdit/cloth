---
<div class="step-content hidden" id="step6">
  <h2 class="text-2xl font-bold text-white mb-6">Review & Submit</h2>
  
  <div class="space-y-6">
    <div id="vpn-warning" class="hidden bg-red-900/30 border border-red-500/50 rounded-lg p-4">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <p class="text-red-400 font-semibold">VPN/Proxy Detected</p>
          <p class="text-sm text-gray-300">This has been recorded for security purposes. You may still submit your NDA.</p>
        </div>
      </div>
    </div>

    <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Company Information</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500">Company Name:</span>
          <p id="review-company-name" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Registration Number:</span>
          <p id="review-registration-number" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Country:</span>
          <p id="review-country" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Business Type:</span>
          <p id="review-business-type" class="text-white"></p>
        </div>
        <div class="md:col-span-2">
          <span class="text-gray-500">Business Address:</span>
          <p id="review-address" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">VAT/Tax ID:</span>
          <p id="review-vat" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Trade License:</span>
          <p id="review-trade-license" class="text-white"></p>
        </div>
      </div>
    </div>

    <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Contact Person</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500">Full Name:</span>
          <p id="review-contact-name" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Designation:</span>
          <p id="review-designation" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Email:</span>
          <p id="review-email" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Phone:</span>
          <p id="review-phone" class="text-white"></p>
        </div>
      </div>
    </div>

    <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Order Intent</h3>
      <div class="grid grid-cols-1 gap-4 text-sm">
        <div>
          <span class="text-gray-500">Product Categories:</span>
          <p id="review-products" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Estimated Order Volume:</span>
          <p id="review-volume" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Target Markets:</span>
          <p id="review-markets" class="text-white"></p>
        </div>
      </div>
    </div>

    <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Security Information</h3>
      <p class="text-xs text-gray-500 mb-3">This information is collected for security purposes and transparency.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-gray-500">IP Address:</span>
          <p id="review-ip" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Country:</span>
          <p id="review-ip-country" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Device:</span>
          <p id="review-device" class="text-white"></p>
        </div>
        <div>
          <span class="text-gray-500">Screen Resolution:</span>
          <p id="review-resolution" class="text-white"></p>
        </div>
      </div>
    </div>

    <div class="bg-gray-900 border border-gray-700 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Signature</h3>
      <div class="text-sm">
        <span class="text-gray-500">Signature Date:</span>
        <p id="review-signature-date" class="text-white"></p>
      </div>
      <div class="mt-4">
        <span class="text-gray-500 text-sm">Your Signature:</span>
        <div class="mt-2 bg-white rounded-lg p-2 inline-block">
          <img id="review-signature-image" src="" alt="Signature" class="max-h-24" />
        </div>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="final-confirm"
        class="w-5 h-5 mt-0.5 text-black bg-gray-800 border-gray-600 rounded focus:ring-white focus:ring-2"
      />
      <label for="final-confirm" class="text-sm text-gray-300">
        I confirm that all information above is accurate and I wish to submit this NDA for review by SDF Ltd.
      </label>
    </div>

    <button
      type="submit"
      id="submit-button"
      disabled
      class="w-full py-4 bg-white border border-gray-700 text-black font-bold rounded-lg hover:bg-gray-200 transition-all disabled:opacity-50 disabled:cursor-not-allowed min-h-[56px] flex items-center justify-center gap-2"
    >
      <span id="submit-text">Submit NDA Agreement</span>
      <svg id="submit-spinner" class="hidden animate-spin h-5 w-5 text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>

    <p id="submit-error" class="text-sm text-white text-center hidden"></p>
  </div>
</div>
