interface Props {
  currentStep: number;
  totalSteps: number;
}

const { currentStep, totalSteps } = Astro.props;

const steps = Array.from({ length: totalSteps }, (_, i) => i + 1);
---
<div class="step-indicator mb-8">
  <div class="flex items-center justify-between max-w-4xl mx-auto">
    {steps.map((step) => (
      <div class="flex items-center" class:list={step < totalSteps}>
        <div
          class={`step-number w-10 h-10 rounded-full flex items-center justify-center font-semibold text-sm transition-all duration-300 ${
            step === currentStep
              ? 'bg-white text-black scale-110'
              : step < currentStep
              ? 'bg-white text-black'
              : 'bg-gray-900 text-gray-500'
          }`}
        >
          {step < currentStep ? '✓' : step}
        </div>
        {step < totalSteps && (
          <div
            class={`flex-1 h-1 mx-2 transition-all duration-300 ${
              step < currentStep ? 'bg-white' : 'bg-gray-900'
            }`}
          ></div>
        )}
      </div>
    ))}
  </div>
  <div class="flex justify-between max-w-4xl mx-auto mt-2 px-2">
    {steps.map((step) => (
      <span
        class={`text-xs font-medium transition-colors duration-300 ${
          step === currentStep ? 'text-white' : step < currentStep ? 'text-white' : 'text-gray-500'
        }`}
      >
        {step === 1 && 'Company'}
        {step === 2 && 'Contact'}
        {step === 3 && 'Order Intent'}
        {step === 4 && 'Preview'}
        {step === 5 && 'Signature'}
        {step === 6 && 'Submit'}
      </span>
    ))}
  </div>
</div>

<style>
  .step-indicator {
    position: relative;
  }
  
  .step-number {
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }
  
  .step-number:hover {
    transform: scale(1.05);
  }
</style>
