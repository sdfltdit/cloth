---
<div class="step-content hidden" id="step2">
  <h2 class="text-2xl font-bold text-white mb-6">Contact Person Details</h2>
  
  <div class="space-y-6">
    <div class="bg-gray-900 border border-gray-700 rounded-lg p-4">
      <p class="text-sm text-white flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        Please use your official business email address. Personal email addresses (Gmail, Yahoo, Hotmail, Outlook.com) will be rejected.
      </p>
    </div>

    <div>
      <label for="contact_full_name" class="block text-sm font-medium text-gray-300 mb-2">
        Full Name <span class="text-white">*</span>
      </label>
      <input
        type="text"
        id="contact_full_name"
        name="contact_full_name"
        required
        minlength="2"
        autocomplete="name"
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
        placeholder="Enter your full legal name"
      />
    </div>

    <div>
      <label for="contact_designation" class="block text-sm font-medium text-gray-300 mb-2">
        Designation / Job Title <span class="text-white">*</span>
      </label>
      <input
        type="text"
        id="contact_designation"
        name="contact_designation"
        required
        minlength="2"
        autocomplete="organization-title"
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
        placeholder="e.g., CEO, Purchasing Manager, Director"
      />
    </div>

    <div>
      <label for="contact_email" class="block text-sm font-medium text-gray-300 mb-2">
        Official Email Address <span class="text-white">*</span>
      </label>
      <input
        type="email"
        id="contact_email"
        name="contact_email"
        required
        autocomplete="email"
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
        placeholder="your@company.com"
      />
      <p class="mt-1 text-xs text-gray-500">Must be a business domain (e.g., @yourcompany.com)</p>
      <p id="email-error" class="mt-1 text-xs text-white hidden">Personal email addresses are not allowed. Please use your business email.</p>
    </div>

    <div>
      <label for="contact_phone" class="block text-sm font-medium text-gray-300 mb-2">
        Phone Number <span class="text-white">*</span>
      </label>
      <input
        type="tel"
        id="contact_phone"
        name="contact_phone"
        required
        minlength="7"
        maxlength="15"
        autocomplete="tel"
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
        placeholder="+1 234 567 8900"
      />
      <p class="mt-1 text-xs text-gray-500">Include country code (e.g., +1, +44, +880)</p>
    </div>

    <div>
      <label for="contact_whatsapp" class="block text-sm font-medium text-gray-300 mb-2">
        WhatsApp Number <span class="text-gray-500">(Optional)</span>
      </label>
      <input
        type="tel"
        id="contact_whatsapp"
        name="contact_whatsapp"
        autocomplete="tel"
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
        placeholder="+1 234 567 8900"
      />
    </div>
  </div>
</div>
