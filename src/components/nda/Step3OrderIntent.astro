---
const productCategories = [
  "T-Shirts", "Polo Shirts", "Formal Shirts", "Jackets", "Trousers", "Jeans",
  "Hoodies", "Sweaters", "Sportswear", "Workwear", "Other"
];

const orderVolumes = [
  "Under 1,000 pcs",
  "1,000–5,000 pcs",
  "5,000–20,000 pcs",
  "20,000–50,000 pcs",
  "50,000+ pcs"
];

const targetMarkets = [
  "USA", "UK", "Europe", "Canada", "Australia", "Middle East", "Asia", "Other"
];
---
<div class="step-content hidden" id="step3">
  <h2 class="text-2xl font-bold text-white mb-6">Order Intent</h2>
  
  <div class="space-y-6">
    <div>
      <label class="block text-sm font-medium text-gray-300 mb-3">
        Product Categories <span class="text-white">*</span>
      </label>
      <p class="text-xs text-gray-500 mb-3">Select all that apply (minimum 1 required)</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {productCategories.map((category) => (
          <label class="flex items-center space-x-3 p-3 bg-gray-900 border border-gray-700 rounded-lg cursor-pointer hover:border-white transition-all">
            <input
              type="checkbox"
              name="product_categories"
              value={category}
              class="w-4 h-4 text-black bg-gray-800 border-gray-600 rounded focus:ring-white focus:ring-2"
            />
            <span class="text-sm text-white">{category}</span>
          </label>
        ))}
      </div>
      <p id="product-error" class="mt-2 text-xs text-white hidden">Please select at least one product category.</p>
    </div>

    <div>
      <label for="estimated_order_volume" class="block text-sm font-medium text-gray-300 mb-2">
        Estimated Annual Order Volume <span class="text-white">*</span>
      </label>
      <select
        id="estimated_order_volume"
        name="estimated_order_volume"
        required
        class="w-full px-4 py-3 bg-gray-900 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-white focus:ring-1 focus:ring-white transition-all"
      >
        <option value="">Select estimated volume</option>
        {orderVolumes.map((volume) => (
          <option value={volume}>{volume}</option>
        ))}
      </select>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-300 mb-3">
        Target Markets / Countries <span class="text-white">*</span>
      </label>
      <p class="text-xs text-gray-500 mb-3">Select all target markets (minimum 1 required)</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {targetMarkets.map((market) => (
          <label class="flex items-center space-x-3 p-3 bg-gray-900 border border-gray-700 rounded-lg cursor-pointer hover:border-white transition-all">
            <input
              type="checkbox"
              name="target_markets"
              value={market}
              class="w-4 h-4 text-black bg-gray-800 border-gray-600 rounded focus:ring-white focus:ring-2"
            />
            <span class="text-sm text-white">{market}</span>
          </label>
        ))}
      </div>
      <p id="market-error" class="mt-2 text-xs text-white hidden">Please select at least one target market.</p>
    </div>
  </div>
</div>
