  <div class="cb">
    <div style="display:flex;align-items:center;gap:8px;margin:0 0 4px">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
<p class="ct" style="margin:0">Sample policy</p>
</div>
    <p class="cs">Our samples are free. Most manufacturers charge $50 to $200 per sample.</p>
    <label class="cl" for="c2g">Garment type</label>
    <select id="c2g" class="ci" aria-label="Select garment type">
      <option value="">Select garment</option>
      <option value="basic">T-Shirt, Polo, Shorts, Leggings</option>
      <option value="mid">Hoodie, Sweatshirt, Jogger, Activewear</option>
      <option value="woven">Dress Shirt, Dress</option>
      <option value="jacket">Jacket</option>
    </select>
    <button class="cb2" id="btn-sample">See Sample Timeline</button>
    <div id="c2r" class="cr"></div>
  </div>

  <div class="cb">
    <div style="display:flex;align-items:center;gap:8px;margin:0 0 4px">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
<p class="ct" style="margin:0">MOQ checker</p>
</div>
    <p class="cs">Check if your order meets our 300 piece minimum</p>
    <label class="cl" for="c3s">Number of styles</label>
    <input type="number" id="c3s" class="ci" placeholder="e.g. 3" min="1" aria-label="Number of styles">
    <label class="cl" for="c3p">Pieces per style</label>
    <input type="number" id="c3p" class="ci" placeholder="e.g. 300" min="1" aria-label="Pieces per style">
    <button class="cb2" id="btn-moq">Check My Order</button>
    <div id="c3r" class="cr"></div>
  </div>

  <div class="cb">
    <div style="display:flex;align-items:center;gap:8px;margin:0 0 4px">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.55" y2="4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
<p class="ct" style="margin:0">Shipping estimator</p>
</div>
    <p class="cs">Approximate freight from Bangladesh to your port</p>
    <label class="cl" for="c4d">Destination</label>
    <select id="c4d" class="ci" aria-label="Select destination">
      <option value="">Select destination</option>
      <option value="eu">European Union</option>
      <option value="uk">United Kingdom</option>
      <option value="usa">United States</option>
      <option value="au">Australia</option>
      <option value="ca">Canada</option>
      <option value="jp">Japan</option>
      <option value="other">Other</option>
    </select>
    <label class="cl" for="c4s">Order size</label>
    <select id="c4s" class="ci" aria-label="Select order size">
      <option value="">Select order size</option>
      <option value="s1">300 to 1000 pieces</option>
      <option value="s2">1000 to 5000 pieces</option>
      <option value="s3">5000 to 20000 pieces</option>
      <option value="s4">20000 plus pieces</option>
    </select>
    <button class="cb2" id="btn-shipping">Estimate Freight</button>
    <div id="c4r" class="cr"></div>
  </div>

  <div class="cb">
    <div style="display:flex;align-items:center;gap:8px;margin:0 0 4px">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>
<p class="ct" style="margin:0">Total landed cost</p>
</div>
    <p class="cs">Your complete estimated cost from factory to warehouse</p>
    <label class="cl" for="c5g">Garment type</label>
    <select id="c5g" class="ci" aria-label="Select garment">
      <option value="">Select garment</option>
      <option value="tshirt">T-Shirt</option>
      <option value="polo">Polo Shirt</option>
      <option value="hoodie">Hoodie</option>
      <option value="sweatshirt">Sweatshirt</option>
      <option value="jogger">Jogger</option>
      <option value="shorts">Shorts</option>
      <option value="dressshirt">Dress Shirt</option>
      <option value="jacket">Jacket</option>
      <option value="dress">Dress</option>
      <option value="leggings">Leggings</option>
      <option value="activewear">Activewear</option>
    </select>
    <label class="cl" for="c5q">Order quantity</label>
    <input type="number" id="c5q" class="ci" placeholder="e.g. 500" min="300" aria-label="Order quantity">
    <label class="cl" for="c5d">Destination</label>
    <select id="c5d" class="ci" aria-label="Select destination">
      <option value="">Select destination</option>
      <option value="eu">European Union</option>
      <option value="uk">United Kingdom</option>
      <option value="usa">United States</option>
      <option value="au">Australia</option>
      <option value="ca">Canada</option>
      <option value="jp">Japan</option>
    </select>
    <button class="cb3" id="btn-cost">Calculate Total Cost</button>
    <div id="c5r" class="cr"></div>
  </div>

</div>

<style>
.cw{display:flex;flex-direction:column;gap:1rem}
.cb{background:#000;border:1px solid #e00;border-left:1px solid #e00;border-radius:8px;padding:1.25rem}
.cb:hover{border-color:#e00}
.ct{color:#ffffff;font-size:13px;font-weight:600;margin:0 0 4px}
.cs{color:#ffffff;font-size:11px;margin:0 0 0.75rem;line-height:1.4}
.cl{display:block;color:#ffffff;font-size:11px;margin:0.75rem 0 4px}
.ci{width:100%;height:38px;background:#000;border:1px solid #e00;color:#ffffff;border-radius:4px;padding:0 0.75rem;font-size:13px;box-sizing:border-box;appearance:none;-webkit-appearance:none;display:block;margin-bottom:0}
.ci:focus{outline:2px solid #e00;outline-offset:2px;border-color:#e00}
.cb2{width:100%;height:40px;margin-top:0.75rem;background:#000;border:1px solid #e00;color:#ffffff;border-radius:4px;font-size:13px;font-weight:600;cursor:pointer;display:block}
.cb2:hover{background:#e00;color:#ffffff}
.cb3{width:100%;height:40px;margin-top:0.75rem;background:#e00;border:none;color:#ffffff;border-radius:4px;font-size:13px;font-weight:600;cursor:pointer;display:block}
.cb3:hover{background:#b91c1c}
.cr{margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid #e00;font-size:13px;display:none}
.crow{display:flex;justify-content:space-between;margin-bottom:0.4rem}
.crl{color:#ffffff;font-size:12px}
.crv{color:#ffffff;font-size:12px;font-weight:600}
.cn{font-size:11px;color:#FFFFFF;font-style:italic;margin-top:0.5rem;line-height:1.5}
.clk{color:#ffffff;font-size:12px;text-decoration:underline;display:inline-block;margin-top:0.5rem}
.clk:hover{text-decoration:none}
</style>

<script>
var PR={tshirt:{q1:[4,7],q2:[3.5,6],q3:[3,5],q4:[2.5,4.5],q5:[2,4]},polo:{q1:[6,10],q2:[5.5,9],q3:[5,8],q4:[4.5,7],q5:[4,6.5]},hoodie:{q1:[14,22],q2:[13,20],q3:[12,18],q4:[11,16],q5:[10,15]},sweatshirt:{q1:[10,16],q2:[9,15],q3:[8,13],q4:[7.5,12],q5:[7,11]},jogger:{q1:[9,14],q2:[8,13],q3:[7.5,12],q4:[7,11],q5:[6.5,10]},shorts:{q1:[7,12],q2:[6.5,11],q3:[6,10],q4:[5.5,9],q5:[5,8]},dressshirt:{q1:[12,20],q2:[11,18],q3:[10,16],q4:[9,14],q5:[8,13]},jacket:{q1:[28,45],q2:[25,40],q3:[22,36],q4:[20,32],q5:[18,28]},dress:{q1:[14,24],q2:[13,22],q3:[12,20],q4:[11,18],q5:[10,16]},leggings:{q1:[8,14],q2:[7.5,13],q3:[7,12],q4:[6.5,11],q5:[6,10]},activewear:{q1:[10,18],q2:[9,16],q3:[8,14],q4:[7.5,13],q5:[7,12]}};
var QM={q1:400,q2:750,q3:2000,q4:4000,q5:7500};
var TL={basic:{s:'7 to 10',b:'14 to 20'},mid:{s:'10 to 14',b:'18 to 25'},woven:{s:'12 to 16',b:'20 to 28'},jacket:{s:'14 to 21',b:'25 to 35'}};
var FR={eu:{s1:[180,320],s2:[280,480],s3:[450,750],s4:[700,1200],a1:[420,680],a2:[750,1200],a3:[1400,2200],a4:[2500,4000]},uk:{s1:[160,300],s2:[260,440],s3:[420,700],s4:[650,1100],a1:[400,650],a2:[720,1150],a3:[1300,2100],a4:[2400,3800]},usa:{s1:[220,380],s2:[350,580],s3:[560,920],s4:[850,1400],a1:[520,840],a2:[920,1480],a3:[1800,2800],a4:[3200,5000]},au:{s1:[250,420],s2:[400,660],s3:[640,1050],s4:[980,1600],a1:[580,940],a2:[1050,1680],a3:[2000,3200],a4:[3600,5800]},ca:{s1:[240,400],s2:[380,630],s3:[610,1000],s4:[940,1550],a1:[560,900],a2:[1000,1600],a3:[1950,3100],a4:[3500,5600]},jp:{s1:[190,340],s2:[300,510],s3:[480,800],s4:[740,1220],a1:[450,730],a2:[810,1300],a3:[1550,2450],a4:[2800,4500]}};
var DT={eu:0.12,uk:0.096,usa:0.165,au:0.10,ca:0.18,jp:0.109};
var DN={eu:'GSP duty-free may apply. Verify with your customs broker.',uk:'UK GSP may reduce this rate. Verify with HMRC.',usa:'Standard US MFN rate. No preferential rate applies.',au:'AANZFTA rate may apply. Verify with ABF.',ca:'CPTPP may reduce this rate. Verify with CBSA.',jp:'Standard MFN rate. Verify HS code classification.'};

function show(id,html){var r=document.getElementById(id);r.style.display='block';r.innerHTML=html}
function row(l,v){return '<div class="crow"><span class="crl">'+l+'</span><span class="crv">'+v+'</span></div>'}
function err(id,msg){show(id,'<span style="color:#e00">'+msg+'</span>')}

function p1(){
  var g=document.getElementById('c1g').value;
  var q=document.getElementById('c1q').value;
  if(!g||!q){err('c1r','Please select garment type and quantity.');return}
  var p=PR[g][q];var m=QM[q];
  var lo=Math.round(p[0]*m);var hi=Math.round(p[1]*m);
  show('c1r',row('Price per piece (FOB)','$'+p[0].toFixed(2)+' to $'+p[1].toFixed(2))+row('Est. order value','$'+lo.toLocaleString()+' to $'+hi.toLocaleString())+'<p class="cn">FOB Chittagong. Excludes shipping and import duty. Final price depends on exact fabric, construction, and finishing.</p><a href="/contact" class="clk">Request formal quote</a>')
}

function p2(){
  var g=document.getElementById('c2g').value;
  if(!g){err('c2r','Please select a garment type.');return}
  var t=TL[g];
  show('c2r',row('Sample ready in',t.s+' days')+row('Free remakes','Up to 10 times')+row('Bulk starts after','Your approval only')+row('Bulk production time',t.b+' days')+'<p class="cn">Timelines are estimates. Exact dates confirmed at order placement.</p><a href="/contact" class="clk">Start your sample</a>')
}

function p3(){
  var s=parseInt(document.getElementById('c3s').value);
  var p=parseInt(document.getElementById('c3p').value);
  if(!s||!p||s<1||p<1){err('c3r','Please enter number of styles and pieces per style.');return}
  var total=s*p;
  if(p>=300){show('c3r',row('Status','<span style="color:#4ade80;font-weight:700">Your order qualifies</span>')+row('Total pieces',total.toLocaleString()+' pieces across '+s+' styles')+'<p class="cn">Multiple colorways within one style count toward your MOQ.</p><a href="/contact" class="clk">Get your quote now</a>')}
  else if(p>=100){show('c3r',row('Status','<span style="color:#fff;font-weight:700">May qualify</span>')+'<p class="cn">Orders below 300 pieces per style are considered case by case. Contact us with your full brief.</p><a href="/contact" class="clk">Discuss your order</a>')}
  else{show('c3r',row('Status','<span style="color:#e00;font-weight:700">Below our standard MOQ</span>')+'<p class="cn">Our minimum is 300 pieces per style. Consider combining styles or colorways.</p><a href="/contact" class="clk">Talk to us anyway</a>')}
}

function p4(){
  var d=document.getElementById('c4d').value;
  var s=document.getElementById('c4s').value;
  if(!d||!s){err('c4r','Please select destination and order size.');return}
  if(d==='other'){show('c4r','<p class="cn">Freight to your destination requires a custom quote.</p><a href="/contact" class="clk">Contact us for freight estimate</a>');return}
  var f=FR[d];var ak=s.replace('s','a');
  show('c4r',row('Sea freight (est.)','$'+f[s][0]+' to $'+f[s][1])+row('Air freight (est.)','$'+f[ak][0]+' to $'+f[ak][1])+'<p class="cn">Estimates based on current Chittagong port rates. Actual costs depend on cargo weight, volume, and market conditions.</p><a href="/contact" class="clk">Request freight quote</a>')
}

function p5(){
  var g=document.getElementById('c5g').value;
  var q=parseInt(document.getElementById('c5q').value);
  var d=document.getElementById('c5d').value;
  if(!g||!q||!d||q<1){err('c5r','Please fill in all fields.');return}
  var qk=q<=500?'q1':q<=1000?'q2':q<=3000?'q3':q<=5000?'q4':'q5';
  var sk=q<=1000?'s1':q<=5000?'s2':q<=20000?'s3':'s4';
  var ak=sk.replace('s','a');
  var p=PR[g][qk];
  var plo=Math.round(p[0]*q);var phi=Math.round(p[1]*q);
  var f=FR[d];var dt=DT[d];
  var dlo=Math.round(plo*dt);var dhi=Math.round(phi*dt);
  var tlo=plo+f[sk][0]+dlo;var thi=phi+f[sk][1]+dhi;
  var dp=Math.round(dt*100);
  show('c5r',row('Production cost (FOB)','$'+plo.toLocaleString()+' to $'+phi.toLocaleString())+row('Est. sea freight','$'+f[sk][0]+' to $'+f[sk][1])+row('Est. import duty ('+dp+'%)','$'+dlo.toLocaleString()+' to $'+dhi.toLocaleString())+'<div style="border-top:1px solid #1a1a1a;margin:0.5rem 0;padding-top:0.5rem">'+row('<span style="color:#fff;font-weight:700">Total landed cost</span>','<span style="font-size:14px;font-weight:700">$'+tlo.toLocaleString()+' to $'+thi.toLocaleString()+'</span>')+'</div><p class="cn">'+DN[d]+'</p><p class="cn">This estimate is for planning only. Always verify with your supplier, freight forwarder, and customs broker.</p><a href="/contact" class="clk">Get a formal quote</a>')
}

document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('btn-price').addEventListener('click', p1);
  document.getElementById('btn-sample').addEventListener('click', p2);
  document.getElementById('btn-moq').addEventListener('click', p3);
  document.getElementById('btn-shipping').addEventListener('click', p4);
  document.getElementById('btn-cost').addEventListener('click', p5);
});
</script>
