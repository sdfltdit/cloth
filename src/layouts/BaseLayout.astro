          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <line x1="2" y1="6" x2="20" y2="6"/>
            <line x1="2" y1="11" x2="20" y2="11"/>
            <line x1="2" y1="16" x2="20" y2="16"/>
          </svg>
        </button>
      </div>
    </nav>

