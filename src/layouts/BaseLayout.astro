            <address itemscope itemtype="https://schema.org/LocalBusiness"
              style="font-style:normal;font-size:0.78rem;color:rgba(255,255,255,0.65);line-height:1.9;">
              <span itemprop="name" style="color:rgba(255,255,255,0.7);font-weight:500;">SDF Clothing</span><br/>
