    <!-- Cookie Consent Popup -->
    <div id="cookie-consent" style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #000000; border-top: 1px solid #1a1a1a; z-index: 1000; padding: 1rem 1.5rem;">
