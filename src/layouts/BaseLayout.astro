---
import BaseHead from '../components/BaseHead.astro';
import globalCssUrl from '../styles/global.css?url';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  datePublished?: string;
  dateModified?: string;
  schema?: object | object[];
  hreflangRegion?: string;
  noindex?: boolean;
  includeContactHints?: boolean;
}

const { title, description, ogImage, ogType, canonicalUrl, datePublished, dateModified, schema, hreflangRegion, noindex, includeContactHints } = Astro.props;
const canonical = canonicalUrl
  ? new URL(canonicalUrl, Astro.site).toString()
  : new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).toString();
const hreflangFallback = new URL('/clothing-manufacturers/', Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      canonicalUrl={canonicalUrl}
      datePublished={datePublished}
      dateModified={dateModified}
      schema={schema}
      noindex={noindex}
      includeContactHints={includeContactHints}
    />

    <!-- Hreflang -->
    {hreflangRegion ? (
      <Fragment>
        <link rel="alternate" hreflang="x-default" href={hreflangFallback} />
        <link rel="alternate" hreflang="en" href={hreflangFallback} />
        <link rel="alternate" hreflang={`en-${hreflangRegion}`} href={canonical} />
      </Fragment>
    ) : (
      <Fragment>
        <link rel="alternate" hreflang="x-default" href={canonical} />
        <link rel="alternate" hreflang="en" href={canonical} />
        <link rel="alternate" hreflang="en-US" href={canonical} />
        <link rel="alternate" hreflang="en-GB" href={canonical} />
        <link rel="alternate" hreflang="en-AU" href={canonical} />
        <link rel="alternate" hreflang="en-CA" href={canonical} />
      </Fragment>
    )}

    <link rel="alternate" type="text/plain" title="SDF Clothing AI Reference" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="SDF Clothing AI Reference Full" href="/llms-full.txt" />

    <!-- Self-Hosted Fonts with font-display: swap -->
    <style is:inline>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300;
        font-display: swap;
        src: url('/fonts/inter-v13-latin-300.woff2') format('woff2');
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 107%;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/inter-v13-latin-regular.woff2') format('woff2');
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 107%;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/inter-v13-latin-500.woff2') format('woff2');
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 107%;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/inter-v13-latin-600.woff2') format('woff2');
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 107%;
      }
    </style>

    <!-- Critical CSS - Minimal Above-the-Fold Only -->
    <style is:inline>*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{background:#000;color:#fff;font-family:'Inter','Inter Fallback',-apple-system,BlinkMacSystemFont,sans-serif;font-size:17px;line-height:1.7;letter-spacing:0.01em;min-height:100vh;-webkit-font-smoothing:antialiased;overflow-x:hidden;max-width:100vw}.skip-link{position:absolute;top:-100%;left:0;background:#000;color:#fff;padding:8px 16px;z-index:9999;font-size:14px;text-decoration:none}.skip-link:focus{top:0}#main-nav{position:sticky;top:0;z-index:100;background:rgba(0,0,0,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:0.6px solid #000000}.nav-inner{display:flex;align-items:center;justify-content:space-between;height:56px;max-width:1200px;margin:0 auto;padding:0 1.5rem;gap:1rem;position:static}.nav-logo{display:flex;align-items:center;gap:8px;text-decoration:none}.nav-logo-text{font-size:1.1rem;font-weight:600;letter-spacing:0.08em;color:#fff}.nav-links{display:flex;align-items:center;gap:0;list-style:none;flex-wrap:nowrap;white-space:nowrap}.nav-links a{font-size:0.72rem;letter-spacing:0.08em;color:#fff;text-transform:uppercase;padding:0 0.75rem;white-space:nowrap;text-decoration:none}#mobile-menu-toggle{display:none;background:none;border:none;cursor:pointer;padding:4px;align-items:center;justify-content:center;min-width:44px;min-height:44px}@media (max-width:768px){#mobile-menu-toggle{display:flex}.nav-links{display:none !important}}.hero-section{min-height:90vh;display:grid;grid-template-columns:1fr 1fr;align-items:center}@media (max-width:768px){.hero-section{grid-template-columns:1fr;min-height:auto}}.hero-left{padding:60px 40px 40px;max-width:600px}@media (max-width:768px){.hero-left{padding:48px 1.5rem 32px;max-width:100%}}.hero-left h1{font-size:clamp(2.5rem,4.5vw,4.2rem);font-weight:200;color:#fff;line-height:1.15;letter-spacing:0.02em;margin-bottom:1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif}.container{width:100%;max-width:1200px;margin:0 auto;padding:0 1.5rem}h1,h2,h3,h4{font-family:'Inter',sans-serif;font-weight:500;letter-spacing:0.05em;line-height:1.2;color:#fff}a{color:inherit;text-decoration:none}body:not(.loaded) .particles,body:not(.loaded)::before,body:not(.loaded)::after{animation-play-state:paused !important}@media (prefers-reduced-motion:reduce){*{animation-duration:0.01ms !important;transition-duration:0.01ms !important}}@media (max-width:768px){button,a,input[type="submit"],input[type="button"],[role="button"]{min-height:44px;min-width:44px}}.index__hero{min-height:90vh;display:grid;align-items:center;justify-content:center;text-align:center;padding:3rem 1.5rem}.index__hero-title{font-size:clamp(2rem,5vw,4rem);font-weight:300;color:#fff;line-height:1.15;margin-bottom:1.5rem;opacity:1;animation:none}.index__hero-subtitle{font-size:clamp(1rem,2vw,1.25rem);color:#fff;max-width:700px;margin:0 auto 2rem;line-height:1.8;opacity:1;animation:none}.index__btn-group{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center}.index__btn{display:inline-flex;align-items:center;justify-content:center;padding:1rem 2rem;font-size:.85rem;font-weight:500;letter-spacing:.05em;text-decoration:none;border:1px solid #e00;color:#fff;min-height:44px}.index__btn--primary{background-color:#e00;border-color:#e00}.index__hero-trust{margin-top:2rem;font-size:.8rem;color:#fff}</style>

    <!-- Cloudflare Rocket Loader Disable -->
    <meta name="cf-2fa-verify" content="off" />

    <!-- Global stylesheet (Tailwind utilities + site CSS) — loaded non-blocking
         using the standard preload-and-swap pattern. Critical above-the-fold
         CSS is already inline above (hero title/subtitle sizing, layout), so
         this file can finish loading after first paint without affecting the
         LCP element. Fonts are preloaded separately above and take priority. -->
    <link rel="preload" as="style" href={globalCssUrl} />
    <link rel="stylesheet" href={globalCssUrl} media="print" onload="this.media='all'; this.onload=null;" />
    <noscript><link rel="stylesheet" href={globalCssUrl} /></noscript>

    <!-- Non-critical scripts: defer, no type=module (avoids extra parse microtask) -->
    <script src="/scripts/app.js" defer data-cfasync="false"></script>
    <script src="/scripts/mobile-menu.js" defer data-cfasync="false"></script>
    <!-- FIX: contact-form.js handles the contact page's form submission
         (Web3Forms + thank-you overlay). It was missing this script tag,
         which meant nothing ever attached a submit listener to the form,
         so the browser fell back to a native HTML GET submit — visible as
         the form fields appearing in the URL bar and no email ever
         arriving. Loaded sitewide (same pattern as app.js / mobile-menu.js)
         since BaseLayout is shared across all pages; the script itself
         only attaches to forms matching #contactForm / [data-contact], so
         it's a safe no-op on pages without a contact form. -->
    <script src="/scripts/contact-form.js" defer data-cfasync="false"></script>

    <!-- Mobile Menu Styles -->
    <style>
    #mobile-menu {
      display: none;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.97);
      z-index: 99999;
      padding: 70px 1.5rem 2rem !important;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      overflow-y: auto;
    }
    #mobile-menu a {
      display: block !important;
      padding: 0.875rem 0 !important;
      color: rgba(255,255,255,0.85) !important;
      text-decoration: none !important;
      font-size: 0.85rem !important;
      font-weight: 400 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      border-bottom: 1px solid #1a1a1a !important;
      visibility: visible !important;
      opacity: 1 !important;
    }
    #mobile-menu a:last-child {
      border-bottom: none;
    }
    #mobile-menu a:hover {
      color: #fff;
    }
    #mobile-menu a.mobile-cta {
      color: #cc0000 !important;
      font-weight: 600 !important;
      margin-top: 0.5rem !important;
      border-bottom: none !important;
      font-size: 0.85rem !important;
    }

    /* Footer Accordion Styles */
    .footer-links-list {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, opacity 0.3s ease;
    }
    .footer-links-list.expanded {
      max-height: 500px;
      opacity: 1;
    }
    .footer-arrow {
      transition: transform 0.3s ease;
    }
    .footer-arrow.rotated {
      transform: translateY(-50%) rotate(180deg);
    }
    @media (min-width: 769px) {
      .footer-links-list {
        max-height: none !important;
        opacity: 1 !important;
      }
      .footer-arrow {
        display: none;
      }
      [data-section] button {
        cursor: default !important;
      }
    }
    @media (max-width: 768px) {
      .footer-links-list {
        max-height: 0;
        opacity: 0;
      }
      .footer-arrow {
        display: block;
      }
    }

    /* Footer Bottom Bar Styles */
    .footer-bottom-inner {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .footer-legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }
    .footer-legal-links a {
      font-size: 0.7rem;
      color: #fff;
      text-decoration: underline;
    }
    .footer-bottom-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .footer-copyright {
      font-size: 0.72rem;
      color: #fff;
      margin: 0;
    }
    .footer-social-links {
      display: flex;
      gap: 0.75rem;
    }
    .footer-social-links a {
      font-size: 0.72rem;
      color: #fff;
      text-decoration: none;
    }
    @media (max-width: 480px) {
      .footer-bottom-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }
    </style>
    <!-- Optional per-page head slot (e.g. non-blocking page-specific CSS). No-op if unused. -->
    <slot name="head" />
  </head>

  <body>
