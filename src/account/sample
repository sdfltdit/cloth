<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDF Clothing — Invoice Generator</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#C0272D;--red-dk:#8B1A1E;--red-lt:#fdf0f0;
  --ink:#1a1a1a;--ink2:#555;--muted:#888;
  --line:#e0ddd8;--bg:#f0ede7;--paper:#fffffe;--field:#f7f5f2;
  --green:#27500A;--amber:#856404;--blue:#0C447C;
}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);font-size:13px;min-height:100vh}

/* TAB BAR */
.tabbar{display:flex;gap:0;background:var(--ink);padding:0;position:sticky;top:0;z-index:100}
.tab{padding:12px 22px;font-size:12px;font-weight:500;letter-spacing:.04em;color:#aaa;cursor:pointer;border-bottom:3px solid transparent;transition:all .15s;background:none;border-top:none;border-left:none;border-right:none;font-family:'DM Sans',sans-serif}
.tab.active{color:white;border-bottom-color:var(--red)}
.tab:hover:not(.active){color:#ddd}

/* LAYOUT */
.page{display:none}.page.active{display:grid;grid-template-columns:400px 1fr;min-height:calc(100vh - 44px)}

/* SIDEBAR */
.sidebar{background:var(--paper);border-right:1px solid var(--line);display:flex;flex-direction:column;max-height:calc(100vh - 44px);overflow:hidden}
.sb-head{padding:16px 20px 14px;border-bottom:1px solid var(--line);flex-shrink:0}
.sb-logo{display:flex;align-items:center;gap:10px}
.sb-logo img{width:36px;height:36px;object-fit:contain}
.sb-brand{font-family:'EB Garamond',serif;font-size:15px;font-weight:600;color:var(--ink);line-height:1.2}
.sb-brand span{display:block;font-family:'DM Sans',sans-serif;font-size:10px;font-weight:400;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;margin-top:1px}
.sb-scroll{flex:1;overflow-y:auto;padding:14px 20px 22px}

.sl{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin:14px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--red-lt)}
.sl:first-child{margin-top:0}

.f{margin-bottom:7px}
.f label{display:block;font-size:11px;font-weight:500;color:var(--ink2);margin-bottom:3px}
.f input,.f select,.f textarea{width:100%;background:var(--field);border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:12px;font-family:'DM Sans',sans-serif;color:var(--ink);outline:none;transition:border-color .15s}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--red);background:var(--paper)}
.f textarea{resize:vertical;min-height:50px;line-height:1.5}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.f3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}

.ot-btn{border:1.5px solid var(--line);border-radius:6px;padding:7px 5px;font-size:11px;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;text-align:center;background:var(--field);color:var(--ink2);transition:all .15s;line-height:1.3;width:100%}
.ot-btn.active{border-color:var(--red);background:var(--red-lt);color:var(--red-dk)}

/* items table */
.itbl{width:100%;border-collapse:collapse;margin-bottom:5px}
.itbl th{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);padding:2px 3px 6px;text-align:left;border-bottom:1px solid var(--line)}
.itbl td{padding:2px 3px;vertical-align:middle}
.itbl input{width:100%;border:1px solid transparent;border-radius:4px;padding:4px 5px;font-size:11px;font-family:'DM Sans',sans-serif;background:var(--field);color:var(--ink);outline:none}
.itbl input:focus{border-color:var(--red);background:var(--paper)}
.cd{width:32%}.cc{width:20%}.cq{width:10%}.cr{width:13%}.ca{width:12%;font-size:11px;color:var(--ink2);text-align:right;padding-top:6px!important}.cx{width:4%}
.del-btn{background:none;border:none;cursor:pointer;color:#bbb;font-size:14px;padding:1px;transition:color .15s}
.del-btn:hover{color:var(--red)}
.add-btn{background:none;border:1px dashed var(--line);border-radius:6px;color:var(--muted);font-size:11px;font-family:'DM Sans',sans-serif;cursor:pointer;padding:5px 10px;width:100%;text-align:left;transition:all .15s;margin-bottom:5px}
.add-btn:hover{border-color:var(--red);color:var(--red)}

.notice{border-radius:6px;padding:7px 10px;font-size:11px;line-height:1.5;margin:5px 0}
.n-any{background:#FFF3CD;border:0.5px solid #ffc107;color:#856404}
.n-tt{background:#FEF3E2;border:0.5px solid #F59E0B;color:#92400E}

.print-btn{width:100%;background:var(--red);color:white;border:none;border-radius:8px;padding:10px;font-size:13px;font-family:'DM Sans',sans-serif;font-weight:500;cursor:pointer;margin-top:16px;letter-spacing:.02em;transition:background .15s}
.print-btn:hover{background:var(--red-dk)}

/* PREVIEW */
.preview{padding:24px 20px;overflow-y:auto;max-height:calc(100vh - 44px);background:var(--bg);display:flex;flex-direction:column;align-items:center}
.inv{width:720px;background:var(--paper);box-shadow:0 4px 40px rgba(0,0,0,.10);padding:44px 50px;font-family:'DM Sans',sans-serif;font-size:12.5px;color:var(--ink)}

/* invoice elements */
.ih{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}
.ilw{display:flex;align-items:center;gap:12px}
.ilw img{width:72px;height:72px;object-fit:contain}
.icn{font-family:'EB Garamond',serif;font-size:19px;font-weight:600;line-height:1.2;margin-bottom:2px}
.ica{font-size:11px;color:var(--muted);line-height:1.7}
.itb{text-align:right}
.ititle{font-family:'EB Garamond',serif;font-size:36px;font-weight:400;color:var(--red);line-height:1}
.ipi{font-size:11.5px;color:var(--muted);margin-top:3px}
.ibadge{display:inline-block;margin-top:7px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:500;letter-spacing:.06em}
.b-pending{background:#FFF3CD;color:#856404;border:.5px solid #ffc107}
.b-partial{background:#E6F1FB;color:var(--blue);border:.5px solid #BDC8DC}
.b-confirmed{background:#EAF3DE;color:var(--green);border:.5px solid #9DC888}

.ibar{height:2.5px;background:linear-gradient(90deg,var(--red),var(--red-dk));border-radius:2px;margin-bottom:20px}

.imeta{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-bottom:20px}
.iml{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:5px}
.iclient{font-size:14px;font-weight:600;margin-bottom:2px}
.icinfo{font-size:11.5px;color:var(--ink2);line-height:1.7}
.idt{width:100%;font-size:11.5px;border-collapse:collapse}
.idt td{padding:2.5px 0;vertical-align:top}
.idt .dl{color:var(--muted);text-align:right;padding-right:10px;width:50%}
.idt .dv{font-weight:500}
.ibal{background:var(--red);color:white;border-radius:7px;padding:9px 12px;margin-top:9px;display:flex;justify-content:space-between;align-items:center}
.ibl{font-size:10px;font-weight:500;letter-spacing:.06em;text-transform:uppercase}
.iba{font-family:'EB Garamond',serif;font-size:20px;font-weight:600}

.iitems{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:18px}
.iih{display:grid;background:var(--ink);color:white;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;gap:7px}
.iih span:not(:first-child){text-align:right}
.irow{display:grid;padding:10px 13px;gap:7px;align-items:start;border-bottom:.5px solid var(--line)}
.irow:last-child{border-bottom:none}
.irow>span{text-align:right;font-size:12.5px;padding-top:2px}
.irow>span:last-child{font-weight:500}
.icode{display:inline-block;font-size:9.5px;font-weight:500;padding:2px 7px;border-radius:4px;letter-spacing:.04em;margin-bottom:3px}
.c1{background:#E1F5EE;color:#085041}.c2{background:var(--red-lt);color:var(--red-dk)}.c3{background:#E6F1FB;color:var(--blue)}.c4{background:#FAEEDA;color:#633806}.c5{background:#FBEAF0;color:#72243E}
.idname{font-weight:500;font-size:12.5px;margin-bottom:1px}
.idspec{font-size:10.5px;color:var(--muted);line-height:1.55}

/* payment breakdown box */
.ipay-stages{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:16px}
.ips-head{background:var(--ink);color:white;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.ips-row{display:grid;grid-template-columns:1fr auto auto;gap:12px;padding:9px 13px;border-bottom:.5px solid var(--line);font-size:12px;align-items:center}
.ips-row:last-child{border-bottom:none}
.ips-row.due{background:var(--red-lt)}
.ips-label{color:var(--ink2)}
.ips-pct{font-size:10px;color:var(--muted);text-align:right}
.ips-amt{font-weight:600;min-width:80px;text-align:right}
.ips-row.due .ips-amt{color:var(--red-dk)}
.ips-row.paid .ips-amt{color:var(--green)}
.ips-badge{font-size:9px;padding:1px 7px;border-radius:10px;font-weight:500}
.b-paid{background:#EAF3DE;color:var(--green)}
.b-due{background:var(--red-lt);color:var(--red-dk)}
.b-upcoming{background:#f5f5f5;color:var(--muted)}

.itotals{display:flex;justify-content:flex-end;margin-bottom:16px}
.itbox{width:280px}
.itr{display:flex;justify-content:space-between;padding:5px 0;font-size:12px;border-bottom:.5px solid var(--line)}
.itr:last-child{border-bottom:none}
.itr .tl{color:var(--muted)}.itr .tv{font-weight:500}
.itr.grand{font-size:13.5px;font-weight:600;padding:7px 0 3px;border-top:1.5px solid var(--ink);border-bottom:none;margin-top:3px}

.idel{border-left:3px solid var(--red);padding:8px 13px;background:#FBF8F8;border-radius:0 6px 6px 0;margin-bottom:13px;font-size:11.5px;color:var(--ink2);line-height:1.7}
.idel strong{color:var(--ink)}

/* shipping section for bulk */
.iship{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px}
.iship-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.iship-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px}
.iship-item{font-size:11.5px}
.iship-item .sk{color:var(--muted);font-size:10.5px;margin-bottom:1px}
.iship-item .sv{font-weight:500}

/* shipping mark box */
.imark{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px;background:var(--field)}
.imark-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.imark-box{border:1.5px solid var(--ink);border-radius:4px;padding:10px 14px;font-size:11px;line-height:2;font-family:monospace;color:var(--ink);display:inline-block;min-width:200px}

.ipayinfo{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px}
.ipt{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:9px}
.ipinner{background:var(--field);border-radius:7px;padding:12px 14px;margin-bottom:9px}
.ipname{font-weight:500;font-size:12.5px;margin-bottom:7px}
.ipdt{width:100%;font-size:11.5px;border-collapse:collapse}
.ipdt td{padding:2.5px 0;vertical-align:top}
.ipdt .bl{color:var(--muted);width:44%}.ipdt .bv{font-weight:500}
.ipdiv{border:none;border-top:.5px solid var(--line);margin:5px 0}
.ipemails{font-size:11.5px;color:var(--ink2);line-height:1.8}
.ipemails strong{color:var(--ink)}
.ipnote{margin-top:9px;background:#FFF3CD;border-radius:5px;padding:8px 11px;font-size:10.5px;color:#856404;line-height:1.6;border:.5px solid #ffc107}

/* correction specific */
.icorr-track{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:13px}
.icorr-head{background:var(--ink);color:white;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.icorr-row{display:grid;grid-template-columns:60px 100px 1fr auto;gap:10px;padding:9px 13px;border-bottom:.5px solid var(--line);font-size:11.5px;align-items:center}
.icorr-row:last-child{border-bottom:none}
.icorr-row.current{background:var(--red-lt)}
.icorr-rnd{font-weight:600;color:var(--red-dk)}
.icorr-date{color:var(--ink2)}
.icorr-remarks{color:var(--ink2);font-size:10.5px}

.iterms{margin-bottom:16px}
.iterm-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.iterms ol{padding-left:15px}
.iterms ol li{font-size:10.5px;color:var(--ink2);line-height:1.8;margin-bottom:1px}
.iterms ol li strong{color:var(--ink)}

.ifooter{border-top:.5px solid var(--line);padding-top:12px;display:flex;justify-content:space-between;align-items:flex-end}
.ifl{font-size:10.5px;color:var(--muted);line-height:1.7}
.ifl strong{color:var(--ink)}
.ifr{font-size:10.5px;color:var(--muted);text-align:right;max-width:250px;line-height:1.6}

@media print{
  .tabbar{display:none}
  .page{display:grid!important}
  .page:not(.active){display:none!important}
  .sidebar{display:none}
  .preview{padding:0;overflow:visible;max-height:none;background:white}
  .inv{box-shadow:none;width:100%;padding:30px 34px}
  @page{margin:0;size:A4}
}
</style>
</head>
<body>

<div class="tabbar">
  <button class="tab active" onclick="switchTab('sample')">Sample Invoice</button>
  <button class="tab" onclick="switchTab('correction')">Correction Sample</button>
  <button class="tab" onclick="switchTab('bulk')">Bulk Production</button>
</div>

<!-- ════════════════ SAMPLE ════════════════ -->
<div class="page active" id="page-sample">
<div class="sidebar">
  <div class="sb-head">
    <div class="sb-logo">
      <img src="data:image/jpeg;base64," alt="SDF Clothing">
      <div class="sb-brand">SDF Clothing<span>Sample Invoice</span></div>
    </div>
  </div>
  <div class="sb-scroll">
    <div class="sl">Invoice details</div>
    <div class="f2">
      <div class="f"><label>PI Number</label><input id="s-pi" value="SDF001/06/KW" oninput="renderSample()"></div>
      <div class="f"><label>PO Number</label><input id="s-po" placeholder="Buyer ref" oninput="renderSample()"></div>
    </div>
    <div class="f2">
      <div class="f"><label>Invoice date</label><input type="date" id="s-date" oninput="renderSample()"></div>
      <div class="f"><label>Due date</label><input type="date" id="s-due" oninput="renderSample()"></div>
    </div>
    <div class="sl">Client</div>
    <div class="f"><label>Full name / Company</label><input id="s-cn" placeholder="Dr. Maram Alibrahim" oninput="renderSample()"></div>
    <div class="f"><label>Address</label><textarea id="s-ca" placeholder="Block 12, Street 8, House 69, Salwa R/A" oninput="renderSample()"></textarea></div>
    <div class="f2">
      <div class="f"><label>Country</label><input id="s-cc" placeholder="Kuwait" oninput="renderSample()"></div>
      <div class="f"><label>Phone</label><input id="s-cp" placeholder="+965 55626666" oninput="renderSample()"></div>
    </div>
    <div class="f"><label>Email</label><input type="email" id="s-ce" placeholder="client@email.com" oninput="renderSample()"></div>
    <div class="sl">Advance payment date</div>
    <div class="f"><label>Date advance received (auto-calculates delivery)</label><input type="date" id="s-adv" oninput="renderSample()"></div>
    <div class="sl">Line items</div>
    <table class="itbl">
      <thead><tr>
        <th class="cd">Description</th><th class="cc">Item code</th>
        <th class="cq">Qty</th><th class="cr">Rate ($)</th>
        <th class="ca">Amt</th><th class="cx"></th>
      </tr></thead>
      <tbody id="s-items"></tbody>
    </table>
    <button class="add-btn" onclick="addSItem()">+ Add item</button>
    <div id="s-notice"></div>
    <button class="print-btn" onclick="window.print()">Download / Print PDF</button>
  </div>
</div>
<div class="preview"><div class="inv" id="s-inv"></div></div>
</div>

<!-- ════════════════ CORRECTION ════════════════ -->
<div class="page" id="page-correction">
<div class="sidebar">
  <div class="sb-head">
    <div class="sb-logo">
      <img src="data:image/jpeg;base64," alt="SDF Clothing">
      <div class="sb-brand">SDF Clothing<span>Correction Sample</span></div>
    </div>
  </div>
  <div class="sb-scroll">
    <div class="sl">Invoice details</div>
    <div class="f2">
      <div class="f"><label>PI Number</label><input id="c-pi" value="SDF001/06/KW-C2" oninput="renderCorr()"></div>
      <div class="f"><label>Original PI Ref</label><input id="c-orig" placeholder="SDF001/06/KW" oninput="renderCorr()"></div>
    </div>
    <div class="f2">
      <div class="f"><label>Invoice date</label><input type="date" id="c-date" oninput="renderCorr()"></div>
      <div class="f"><label>Correction round</label>
        <select id="c-round" onchange="renderCorr()">
          <option value="1">Round 1</option>
          <option value="2">Round 2</option>
          <option value="3">Round 3</option>
          <option value="4">Round 4+</option>
        </select>
      </div>
    </div>
    <div class="sl">Client</div>
    <div class="f"><label>Full name / Company</label><input id="c-cn" placeholder="Dr. Maram Alibrahim" oninput="renderCorr()"></div>
    <div class="f2">
      <div class="f"><label>Country</label><input id="c-cc" placeholder="Kuwait" oninput="renderCorr()"></div>
      <div class="f"><label>Phone</label><input id="c-cp" placeholder="+965 55626666" oninput="renderCorr()"></div>
    </div>
    <div class="f"><label>Email</label><input type="email" id="c-ce" placeholder="client@email.com" oninput="renderCorr()"></div>
    <div class="sl">Correction history</div>
    <div id="c-hist-wrap"></div>
    <button class="add-btn" onclick="addCorrRound()">+ Add previous round</button>
    <div class="sl">This correction — items</div>
    <table class="itbl">
      <thead><tr>
        <th class="cd">Description</th><th class="cc">Item code</th>
        <th class="cq">Qty</th><th class="cr">Rate ($)</th>
        <th class="ca">Amt</th><th class="cx"></th>
      </tr></thead>
      <tbody id="c-items"></tbody>
    </table>
    <button class="add-btn" onclick="addCItem()">+ Add item</button>
    <div class="sl">Correction remarks</div>
    <div class="f"><label>What needs to be corrected</label><textarea id="c-remarks" placeholder="e.g. Collar width to be reduced by 2cm, sleeve length adjusted..." rows="3" oninput="renderCorr()"></textarea></div>
    <div class="sl">Extra charge (if any)</div>
    <div class="f2">
      <div class="f"><label>Extra charge ($)</label><input type="number" id="c-extra" value="0" min="0" step="0.01" oninput="renderCorr()"></div>
      <div class="f"><label>Reason</label><input id="c-extrareason" placeholder="Additional round fee" oninput="renderCorr()"></div>
    </div>
    <div class="sl">Advance payment date</div>
    <div class="f"><label>Date advance received</label><input type="date" id="c-adv" oninput="renderCorr()"></div>
    <div id="c-notice" class="notice n-any" style="margin-top:6px">Round 1 — no extra charge (included in sample invoice)</div>
    <button class="print-btn" onclick="window.print()">Download / Print PDF</button>
  </div>
</div>
<div class="preview"><div class="inv" id="c-inv"></div></div>
</div>

<!-- ════════════════ BULK ════════════════ -->
<div class="page" id="page-bulk">
<div class="sidebar">
  <div class="sb-head">
    <div class="sb-logo">
      <img src="data:image/jpeg;base64," alt="SDF Clothing">
      <div class="sb-brand">SDF Clothing<span>Bulk Production</span></div>
    </div>
  </div>
  <div class="sb-scroll">
    <div class="sl">Invoice details</div>
    <div class="f2">
      <div class="f"><label>PI Number</label><input id="b-pi" value="SDF001/06/KW-B" oninput="renderBulk()"></div>
      <div class="f"><label>PO Number</label><input id="b-po" placeholder="Buyer PO ref" oninput="renderBulk()"></div>
    </div>
    <div class="f2">
      <div class="f"><label>Invoice date</label><input type="date" id="b-date" oninput="renderBulk()"></div>
      <div class="f"><label>Due date</label><input type="date" id="b-due" oninput="renderBulk()"></div>
    </div>
    <div class="f"><label>Payment stage</label>
      <select id="b-stage" onchange="renderBulk()">
        <option value="1">Stage 1 — 30% Deposit (production start)</option>
        <option value="2">Stage 2 — 40% Mid-production</option>
        <option value="3">Stage 3 — 40% Ready to ship</option>
      </select>
    </div>
    <div class="sl">Client</div>
    <div class="f"><label>Full name / Company</label><input id="b-cn" placeholder="Dr. Maram Alibrahim" oninput="renderBulk()"></div>
    <div class="f"><label>Address</label><textarea id="b-ca" placeholder="Block 12, Street 8, House 69, Salwa R/A" oninput="renderBulk()"></textarea></div>
    <div class="f2">
      <div class="f"><label>Country</label><input id="b-cc" placeholder="Kuwait" oninput="renderBulk()"></div>
