---
// ============================================================
// SDF CLOTHING — INDUSTRY GLOSSARY
// src/components/Glossary.astro
// ============================================================
---

<section id="glossary" aria-labelledby="glossary-title">
  <div class="tool-header">
    <span class="tool-label">Reference</span>
    <h2 id="glossary-title">Industry Glossary</h2>
    <p>20 essential garment industry terms — from factory floor metrics to trade regulations. Search or filter by topic.</p>
  </div>

  <div class="glossary-controls">
    <div class="glossary-search-wrap">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        id="glossary-search"
        placeholder="Search terms… (e.g. FOB, AQL, GOTS)"
        aria-label="Search glossary terms"
      />
    </div>
    <div class="glossary-filters" id="glossary-filters">
      <button class="gfilter active" data-sector="all">All</button>
      <button class="gfilter" data-sector="manufacturing">Manufacturing</button>
      <button class="gfilter" data-sector="sourcing">Sourcing</button>
      <button class="gfilter" data-sector="compliance">Compliance</button>
      <button class="gfilter" data-sector="sustainability">Sustainability</button>
      <button class="gfilter" data-sector="market">Market</button>
    </div>
  </div>

  <div class="glossary-count" id="glossary-count" aria-live="polite">Showing all 20 terms</div>

  <div class="glossary-grid" id="glossary-grid">
    <!-- populated by JS -->
  </div>

  <div class="glossary-empty" id="glossary-empty" style="display:none;" aria-live="polite">
    <p>No terms match "<span id="glossary-empty-term"></span>". Try a different search or <a href="/contact/" style="color:#e00;">ask us directly</a>.</p>
  </div>
</section>

<script>
  const terms = [
    { term: "AQL", full: "Acceptable Quality Level", definition: "Statistical sampling standard (ANSI/ASQ Z1.4) used to determine the acceptable number of defective units in a production batch. AQL 1.5 is standard for critical defects; AQL 2.5 for major defects. Use our AQL Calculator above to calculate sample sizes.", sector: "manufacturing" },
    { term: "SAM", full: "Standard Allowed Minute", definition: "The time a trained operator needs to complete one garment operation under standard conditions. SAM determines factory capacity, efficiency, and is directly used in CM (cut & make) pricing calculations.", sector: "manufacturing" },
    { term: "GSD", full: "General Sewing Data", definition: "A method-time measurement (MTM) system developed specifically for garment manufacturing. More accurate than SAM for complex operations. Used by Tier 1 factories and major brands for precise capacity planning.", sector: "manufacturing" },
    { term: "FOB", full: "Free On Board", definition: "Incoterms pricing where the seller delivers goods to the named port of shipment. The buyer takes risk and cost from that point onward. Most common pricing basis in Bangladesh apparel exports. Use our FOB Calculator above to estimate your price.", sector: "sourcing" },
    { term: "CMT", full: "Cut, Make & Trim", definition: "Manufacturing agreement where the buyer supplies fabric and trims, and the factory charges only for cutting, sewing, and finishing labor. Lower unit cost but buyer carries all material procurement risk and responsibility.", sector: "sourcing" },
    { term: "LDP", full: "Landed Duty Paid", definition: "Total cost including FOB price, ocean freight, insurance, import duties, and destination charges. The true landed cost used for retail margin calculations. Always calculate LDP before setting retail prices.", sector: "sourcing" },
    { term: "DPP", full: "Digital Product Passport", definition: "EU regulatory requirement under ESPR mandating a scannable data carrier (QR code) on all textile products containing supply chain, material, and sustainability data. Mandatory for textiles from 2027. Manufacturers must begin data collection now.", sector: "compliance" },
    { term: "ESPR", full: "Ecodesign for Sustainable Products Regulation", definition: "EU regulation replacing the Ecodesign Directive, extending sustainable product requirements to textiles. Includes Digital Product Passport, durability standards, recycled content requirements, and end-of-life provisions.", sector: "compliance" },
    { term: "EPR", full: "Extended Producer Responsibility", definition: "Policy framework making brands financially responsible for end-of-life management of their products. Several EU member states have active EPR schemes for textiles. Brands pay into national collection and recycling funds.", sector: "compliance" },
    { term: "UFLPA", full: "Uyghur Forced Labor Prevention Act", definition: "US law creating a rebuttable presumption that goods made with inputs from China's Xinjiang region were produced with forced labor. Requires complete supply chain documentation for cotton, polyester, viscose, and other inputs with Xinjiang origin risk.", sector: "compliance" },
    { term: "GOTS", full: "Global Organic Textile Standard", definition: "Leading certification for organic textiles covering the entire supply chain from fiber to finished product. Requires ≥70% certified organic fibers and prohibits harmful processing chemicals. Carries strong consumer recognition in Europe.", sector: "sustainability" },
    { term: "GRS", full: "Global Recycled Standard", definition: "Certification verifying recycled content in products and responsible social, environmental, and chemical practices throughout the supply chain. Covers recycled polyester, nylon, cotton, and blended materials.", sector: "sustainability" },
    { term: "OEKO-TEX", full: "OEKO-TEX Standard 100", definition: "Tests every component of a finished product — thread, fabric, buttons, labels — for harmful substances. Certifies the article is safe for human health. Does not certify sustainability of production processes.", sector: "sustainability" },
    { term: "Scope 3", full: "Scope 3 Emissions", definition: "Indirect greenhouse gas emissions in a company's value chain — including raw material production, manufacturing, transportation, and product end-of-life. Fashion brands' Scope 3 emissions typically represent 95%+ of their total carbon footprint.", sector: "sustainability" },
    { term: "RFQ", full: "Request for Quotation", definition: "Formal document sent to manufacturers requesting pricing for a specific product. Should include tech pack, fabric specifications, color count, quantities by size, target FOB price, delivery requirements, and compliance standards required.", sector: "sourcing" },
    { term: "T&A", full: "Time and Action Calendar", definition: "Master timeline document tracking every milestone from order confirmation to shipment — fabric booking, approval stages, counter sample, PP sample, production start, inline inspection, final inspection, and export documentation.", sector: "manufacturing" },
    { term: "PP Sample", full: "Pre-Production Sample", definition: "Final sample made from actual production fabrics and trims on production line machines, before bulk cutting begins. PP sample approval by the buyer is required before production can proceed. Non-approval at this stage causes significant delays.", sector: "manufacturing" },
    { term: "LDC", full: "Least Developed Country", definition: "UN classification providing preferential market access including the EU's Everything But Arms (EBA) duty-free access. Bangladesh graduates from LDC status in November 2026, triggering a 3-year transition period with significant tariff implications.", sector: "market" },
    { term: "EBA", full: "Everything But Arms", definition: "EU's unilateral trade preference giving LDC countries duty-free, quota-free access for all products except arms. Bangladesh currently benefits from EBA on apparel exports to EU. This preference expires post-LDC graduation in 2026.", sector: "market" },
    { term: "GSP+", full: "Generalised Scheme of Preferences Plus", definition: "EU trade preference program for developing (non-LDC) countries, offering reduced (not zero) tariffs in exchange for ratification and implementation of 27 international conventions on human rights, labour standards, and environment.", sector: "market" },
  ];

  const sectorColors: Record<string, string> = {
    manufacturing: '#e00',
    sourcing: '#e00',
    compliance: '#e00',
    sustainability: '#e00',
    market: '#e00',
  };

  const sectorLabels: Record<string, string> = {
    manufacturing: 'Manufacturing',
    sourcing: 'Sourcing',
    compliance: 'Compliance',
    sustainability: 'Sustainability',
    market: 'Market',
  };

  let activeSector = 'all';
  let searchQuery = '';

  function render() {
    const grid = document.getElementById('glossary-grid') as HTMLElement;
    const empty = document.getElementById('glossary-empty') as HTMLElement;
    const count = document.getElementById('glossary-count') as HTMLElement;

    const filtered = terms.filter(t => {
      const matchSector = activeSector === 'all' || t.sector === activeSector;
      const q = searchQuery.toLowerCase();
      const matchSearch = !q || t.term.toLowerCase().includes(q) || t.full.toLowerCase().includes(q) || t.definition.toLowerCase().includes(q);
      return matchSector && matchSearch;
    });

    if (filtered.length === 0) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      (document.getElementById('glossary-empty-term') as HTMLElement).textContent = searchQuery;
      count.textContent = 'No results found';
      return;
    }

    empty.style.display = 'none';
    count.textContent = `Showing ${filtered.length} of ${terms.length} terms`;

    grid.innerHTML = filtered.map(t => `
      <div class="gterm-card" data-sector="${t.sector}">
        <div class="gterm-header">
          <div>
            <span class="gterm-abbr">${t.term}</span>
            <span class="gterm-full">${t.full}</span>
          </div>
          <span class="gterm-badge">${sectorLabels[t.sector] || t.sector}</span>
        </div>
        <p class="gterm-def">${t.definition}</p>
      </div>
    `).join('');
  }

  // Filter buttons
  document.getElementById('glossary-filters')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.gfilter') as HTMLButtonElement;
    if (!btn) return;
    activeSector = btn.dataset.sector || 'all';
    document.querySelectorAll('.gfilter').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    render();
  });

  // Search
  document.getElementById('glossary-search')?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    render();
  });

  render();
</script>

<style>
  #glossary {
    padding: 3rem 0;
    border-top: 1px solid #e00;
  }
  .tool-header { margin-bottom: 2rem; }
  .tool-label { font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 0.5rem; }
  .tool-header h2 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 600; color: #fff; margin-bottom: 0.5rem; letter-spacing: 0.02em; }
  .tool-header p { font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.6; }

  .glossary-controls { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }

  .glossary-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #000;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 0 1rem;
    transition: border-color 0.2s;
  }
  .glossary-search-wrap:focus-within { border-color: #e00; }
  .glossary-search-wrap svg { color: rgba(255,255,255,0.4); flex-shrink: 0; }
  #glossary-search {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
    padding: 0.75rem 0;
    width: 100%;
    outline: none;
    min-height: 44px;
  }
  #glossary-search::placeholder { color: rgba(255,255,255,0.35); }

  .glossary-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gfilter {
    background: transparent;
    color: rgba(255,255,255,0.6);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.35rem 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: all 0.2s;
    min-height: 36px;
  }
  .gfilter:hover { border-color: #e00; color: #e00; }
  .gfilter.active { background: #e00; color: #fff; border-color: #e00; }

  .glossary-count { font-size: 0.72rem; color: rgba(255,255,255,0.4); letter-spacing: 0.05em; margin-bottom: 1.5rem; }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: rgba(255,255,255,0.08);
  }

  .gterm-card {
    background: #000;
    padding: 1.25rem 1.5rem;
    transition: background 0.2s;
  }
  .gterm-card:hover { background: rgba(255,255,255,0.03); }

  .gterm-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .gterm-abbr {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.05em;
    display: block;
    line-height: 1.2;
  }
  .gterm-full {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    display: block;
    margin-top: 0.15rem;
  }
  .gterm-badge {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e00;
    border: 1px solid #e00;
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .gterm-def { font-size: 0.82rem; color: rgba(255,255,255,0.65); line-height: 1.7; }

  .glossary-empty { padding: 3rem 0; text-align: center; }
  .glossary-empty p { font-size: 0.9rem; color: rgba(255,255,255,0.5); line-height: 1.6; }
</style>
