---
// ============================================================
// SDF CLOTHING — AQL SAMPLE SIZE CALCULATOR
// src/components/AqlTool.astro
// Based on ANSI/ASQ Z1.4 (ISO 2859-1) standard
// ============================================================
---

<section id="aql-tool" aria-labelledby="aql-title">
  <div class="tool-header">
    <span class="tool-label">Interactive Tool</span>
    <h2 id="aql-title">AQL Inspection Calculator</h2>
    <p>Calculate required sample sizes and acceptance numbers based on ANSI/ASQ Z1.4 (ISO 2859-1) — the international standard for apparel quality inspection.</p>
  </div>

  <div class="aql-grid">
    <div class="aql-inputs">

      <div class="input-group">
        <label for="aql-lot-size">Lot Size (total pcs in shipment)</label>
        <input type="number" id="aql-lot-size" min="2" max="500000" step="1" value="3000" placeholder="3000" />
      </div>

      <div class="input-group">
        <label for="aql-inspection-level">General Inspection Level</label>
        <select id="aql-inspection-level">
          <option value="I">Level I — Reduced (less stringent)</option>
          <option value="II" selected>Level II — Normal (standard)</option>
          <option value="III">Level III — Tightened (more stringent)</option>
        </select>
        <span class="input-hint">Level II is the industry default. Use Level III for new suppliers or after failures.</span>
      </div>

      <div class="aql-levels-group">
        <div class="aql-levels-label">Set AQL Levels by Defect Class</div>
        <div class="aql-three-col">
          <div class="input-group">
            <label for="aql-critical">Critical Defects</label>
            <select id="aql-critical">
              <option value="0">0 — Zero Tolerance</option>
              <option value="0.065">0.065</option>
              <option value="0.1">0.1</option>
              <option value="0.15">0.15</option>
              <option value="0.25">0.25</option>
              <option value="0.4">0.4</option>
              <option value="0.65" selected>0.65</option>
              <option value="1.0">1.0</option>
            </select>
            <span class="input-hint">Safety hazards, label errors</span>
          </div>
          <div class="input-group">
            <label for="aql-major">Major Defects</label>
            <select id="aql-major">
              <option value="0">0 — Zero Tolerance</option>
              <option value="0.65">0.65</option>
              <option value="1.0">1.0</option>
              <option value="1.5">1.5</option>
              <option value="2.5" selected>2.5</option>
              <option value="4.0">4.0</option>
            </select>
            <span class="input-hint">Defects affecting function/appearance</span>
          </div>
          <div class="input-group">
            <label for="aql-minor">Minor Defects</label>
            <select id="aql-minor">
              <option value="1.5">1.5</option>
              <option value="2.5">2.5</option>
              <option value="4.0" selected>4.0</option>
              <option value="6.5">6.5</option>
            </select>
            <span class="input-hint">Workmanship, aesthetic issues</span>
          </div>
        </div>
      </div>

      <button id="aql-calculate-btn" class="calculate-btn" type="button">
        Calculate Sample Size →
      </button>
    </div>

    <div class="aql-result" id="aql-result" aria-live="polite">
      <div class="result-placeholder" id="aql-placeholder">
        <div class="result-placeholder-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <p>Enter lot size and AQL requirements to calculate your inspection sample size.</p>
      </div>

      <div id="aql-result-content" style="display:none;">
        <div class="result-header">
          <span class="result-label">Sample Size Required</span>
          <div class="result-price" id="aql-sample-size">0</div>
          <div class="result-range" id="aql-code-letter">Code Letter: —</div>
        </div>

        <div class="result-breakdown">
          <div class="breakdown-title">Acceptance / Rejection Numbers</div>

          <div class="breakdown-row">
            <span>Critical Defects (AQL <span id="aql-d-critical-level">—</span>)</span>
            <span id="aql-d-critical">Ac: — / Re: —</span>
          </div>
          <div class="breakdown-row">
            <span>Major Defects (AQL <span id="aql-d-major-level">—</span>)</span>
            <span id="aql-d-major">Ac: — / Re: —</span>
          </div>
          <div class="breakdown-row">
            <span>Minor Defects (AQL <span id="aql-d-minor-level">—</span>)</span>
            <span id="aql-d-minor">Ac: — / Re: —</span>
          </div>
        </div>

        <div class="aql-verdict" id="aql-verdict-guide">
          <div class="verdict-title">How to Use These Numbers</div>
          <p id="aql-verdict-text"></p>
        </div>

        <div class="result-disclaimer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Based on ANSI/ASQ Z1.4 Normal Inspection, Single Sampling. For tightened/reduced switching rules, consult the full standard.
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Reference Table -->
  <div class="aql-reference">
    <div class="ref-title">Quick Reference — Common AQL Settings by Brand Tier</div>
    <div class="ref-table-wrap">
      <table class="ref-table">
        <thead>
          <tr>
            <th>Brand Tier</th>
            <th>Critical</th>
            <th>Major</th>
            <th>Minor</th>
            <th>Inspection Level</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Mass Market / Fast Fashion</td>
            <td>0.65</td>
            <td>2.5</td>
            <td>4.0</td>
            <td>Level II</td>
          </tr>
          <tr>
            <td>Mid-Market Brands</td>
            <td>0.4</td>
            <td>1.5</td>
            <td>4.0</td>
            <td>Level II</td>
          </tr>
          <tr>
            <td>Premium / Contemporary</td>
            <td>0.1</td>
            <td>1.0</td>
            <td>2.5</td>
            <td>Level II–III</td>
          </tr>
          <tr>
            <td>Luxury / Heritage</td>
            <td>0</td>
            <td>0.65</td>
            <td>1.5</td>
            <td>Level III</td>
          </tr>
          <tr>
            <td>Children's / Safety-Critical</td>
            <td>0</td>
            <td>0.65</td>
            <td>2.5</td>
            <td>Level II–III</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  #aql-tool {
    padding: 3rem 0;
    border-top: 1px solid #e00;
  }
  .aql-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 768px) { .aql-grid { grid-template-columns: 1fr; } }
  .aql-inputs { display: flex; flex-direction: column; gap: 1rem; }
  .aql-levels-group { border: 1px solid rgba(255,255,255,0.12); padding: 1rem; }
  .aql-levels-label { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.75rem; }
  .aql-three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 500px) { .aql-three-col { grid-template-columns: 1fr; } }

  .aql-result {
    background: #000;
    border: 1px solid rgba(255,255,255,0.15);
    padding: 1.75rem;
    position: sticky;
    top: 80px;
  }

  .aql-verdict {
    background: rgba(255,255,255,0.04);
    border-left: 2px solid #e00;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
  }
  .verdict-title { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.4rem; }
  .aql-verdict p { font-size: 0.82rem; color: rgba(255,255,255,0.7); line-height: 1.6; }

  /* Reference table */
  .aql-reference { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; }
  .ref-title { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 1rem; }
  .ref-table-wrap { overflow-x: auto; }
  .ref-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .ref-table th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    border-bottom: 1px solid rgba(255,255,255,0.15);
    white-space: nowrap;
  }
  .ref-table td {
    padding: 0.7rem 0.75rem;
    color: rgba(255,255,255,0.8);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    white-space: nowrap;
  }
  .ref-table tr:hover td { color: #fff; }

  /* Shared styles copied from FobCalculator */
  .tool-header { margin-bottom: 2rem; }
  .tool-label { font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 0.5rem; }
  .tool-header h2 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 600; color: #fff; margin-bottom: 0.5rem; letter-spacing: 0.02em; }
  .tool-header p { font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.6; }
  .input-group { display: flex; flex-direction: column; gap: 0.3rem; }
  .input-group label { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
  .input-group input, .input-group select { background: #000; color: #fff; border: 1px solid rgba(255,255,255,0.2); padding: 0.6rem 0.85rem; font-size: 0.9rem; font-family: 'Inter', sans-serif; transition: border-color 0.2s; min-height: 44px; width: 100%; }
  .input-group input:focus, .input-group select:focus { border-color: #e00; outline: none; }
  .input-hint { font-size: 0.7rem; color: rgba(255,255,255,0.4); line-height: 1.4; }
  .calculate-btn { background: #e00; color: #fff; border: 1px solid #e00; padding: 0.85rem 1.5rem; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; margin-top: 0.5rem; min-height: 44px; font-family: 'Inter', sans-serif; }
  .calculate-btn:hover { background: #aa0000; }
  .result-placeholder { text-align: center; padding: 2rem 0; }
  .result-placeholder-icon { margin-bottom: 1rem; color: rgba(255,255,255,0.3); }
  .result-placeholder p { font-size: 0.85rem; color: rgba(255,255,255,0.4); line-height: 1.6; }
  .result-header { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .result-label { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 0.5rem; }
  .result-price { font-size: 2.5rem; font-weight: 600; color: #fff; letter-spacing: -0.02em; line-height: 1; }
  .result-range { font-size: 0.78rem; color: rgba(255,255,255,0.5); margin-top: 0.35rem; }
  .breakdown-title { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.75rem; }
  .breakdown-row { display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0; font-size: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.8); }
  .result-disclaimer { font-size: 0.72rem; color: rgba(255,255,255,0.4); line-height: 1.6; margin-top: 1rem; display: flex; gap: 0.5rem; align-items: flex-start; }
  .result-disclaimer svg { flex-shrink: 0; margin-top: 2px; }
</style>

<script>
  // ANSI/ASQ Z1.4 — Code Letters by lot size and inspection level
  const codeLetter: Record<string, Record<string, string>> = {
    I: {
      '2-8': 'A', '9-15': 'A', '16-25': 'B', '26-50': 'C', '51-90': 'C',
      '91-150': 'D', '151-280': 'E', '281-500': 'F', '501-1200': 'G',
      '1201-3200': 'H', '3201-10000': 'J', '10001-35000': 'K',
      '35001-150000': 'L', '150001-500000': 'M', '500001+': 'N'
    },
    II: {
      '2-8': 'A', '9-15': 'B', '16-25': 'C', '26-50': 'D', '51-90': 'E',
      '91-150': 'F', '151-280': 'G', '281-500': 'H', '501-1200': 'J',
      '1201-3200': 'K', '3201-10000': 'L', '10001-35000': 'M',
      '35001-150000': 'N', '150001-500000': 'P', '500001+': 'Q'
    },
    III: {
      '2-8': 'B', '9-15': 'C', '16-25': 'D', '26-50': 'E', '51-90': 'F',
      '91-150': 'G', '151-280': 'H', '281-500': 'J', '501-1200': 'K',
      '1201-3200': 'L', '3201-10000': 'M', '10001-35000': 'N',
      '35001-150000': 'P', '150001-500000': 'Q', '500001+': 'R'
    }
  };

  // Sample sizes by code letter
  const sampleSizes: Record<string, number> = {
    A:2, B:3, C:5, D:8, E:13, F:20, G:32, H:50, J:80, K:125, L:200, M:315, N:500, P:800, Q:1250, R:2000
  };

  // Ac/Re table [aqlValue -> {codeLetter -> [ac, re]}]
  // Simplified for most common code letters and AQL values
  const acReTable: Record<string, Record<string, [number, number]>> = {
    '0': { A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[0,1],L:[0,1],M:[0,1],N:[0,1],P:[0,1],Q:[0,1] },
    '0.065': { F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[0,1],L:[0,1],M:[0,1],N:[1,2],P:[1,2],Q:[2,3] },
    '0.1': { E:[0,1],F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[0,1],L:[0,1],M:[0,1],N:[1,2],P:[1,2],Q:[2,3] },
    '0.15': { D:[0,1],E:[0,1],F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[0,1],L:[0,1],M:[1,2],N:[1,2],P:[2,3],Q:[3,4] },
    '0.25': { C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[0,1],L:[1,2],M:[1,2],N:[2,3],P:[3,4],Q:[5,6] },
    '0.4': { B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[0,1],H:[0,1],J:[0,1],K:[1,2],L:[1,2],M:[2,3],N:[3,4],P:[5,6] },
    '0.65': { A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[0,1],H:[1,2],J:[1,2],K:[2,3],L:[3,4],M:[5,6],N:[7,8],P:[10,11] },
    '1.0': { A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[0,1],G:[1,2],H:[1,2],J:[2,3],K:[3,4],L:[5,6],M:[7,8],N:[10,11],P:[14,15] },
    '1.5': { A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[0,1],F:[1,2],G:[1,2],H:[2,3],J:[3,4],K:[5,6],L:[7,8],M:[10,11],N:[14,15],P:[21,22] },
    '2.5': { A:[0,1],B:[0,1],C:[0,1],D:[0,1],E:[1,2],F:[1,2],G:[2,3],H:[3,4],J:[5,6],K:[7,8],L:[10,11],M:[14,15],N:[21,22],P:[21,22] },
    '4.0': { A:[0,1],B:[0,1],C:[0,1],D:[1,2],E:[1,2],F:[2,3],G:[3,4],H:[5,6],J:[7,8],K:[10,11],L:[14,15],M:[21,22],N:[21,22],P:[21,22] },
    '6.5': { A:[0,1],B:[0,1],C:[1,2],D:[1,2],E:[2,3],F:[3,4],G:[5,6],H:[7,8],J:[10,11],K:[14,15],L:[21,22],M:[21,22] },
  };

  function getLotRange(size: number): string {
    if (size <= 8) return '2-8';
    if (size <= 15) return '9-15';
    if (size <= 25) return '16-25';
    if (size <= 50) return '26-50';
    if (size <= 90) return '51-90';
    if (size <= 150) return '91-150';
    if (size <= 280) return '151-280';
    if (size <= 500) return '281-500';
    if (size <= 1200) return '501-1200';
    if (size <= 3200) return '1201-3200';
    if (size <= 10000) return '3201-10000';
    if (size <= 35000) return '10001-35000';
    if (size <= 150000) return '35001-150000';
    if (size <= 500000) return '150001-500000';
    return '500001+';
  }

  function getAcRe(aqlVal: string, letter: string): string {
    const table = acReTable[aqlVal];
    if (!table) return 'N/A';
    const val = table[letter];
    if (!val) {
      // Use arrow rules for very small samples with tight AQL
      return aqlVal === '0' ? 'Ac:0 / Re:1' : '↑ (use next larger sample)';
    }
    return `Ac:${val[0]} / Re:${val[1]}`;
  }

  document.getElementById('aql-calculate-btn')?.addEventListener('click', () => {
    const lotSize = parseInt((document.getElementById('aql-lot-size') as HTMLInputElement).value) || 3000;
    const level = (document.getElementById('aql-inspection-level') as HTMLSelectElement).value;
    const critical = (document.getElementById('aql-critical') as HTMLSelectElement).value;
    const major = (document.getElementById('aql-major') as HTMLSelectElement).value;
    const minor = (document.getElementById('aql-minor') as HTMLSelectElement).value;

    const range = getLotRange(lotSize);
    const letter = codeLetter[level][range] || 'J';
    const sampleSize = sampleSizes[letter] || 80;

    (document.getElementById('aql-sample-size') as HTMLElement).textContent = String(sampleSize);
    (document.getElementById('aql-code-letter') as HTMLElement).textContent = `Code Letter: ${letter} | Lot: ${lotSize.toLocaleString()} pcs`;

    (document.getElementById('aql-d-critical-level') as HTMLElement).textContent = critical;
    (document.getElementById('aql-d-major-level') as HTMLElement).textContent = major;
    (document.getElementById('aql-d-minor-level') as HTMLElement).textContent = minor;

    (document.getElementById('aql-d-critical') as HTMLElement).textContent = getAcRe(critical, letter);
    (document.getElementById('aql-d-major') as HTMLElement).textContent = getAcRe(major, letter);
    (document.getElementById('aql-d-minor') as HTMLElement).textContent = getAcRe(minor, letter);

    const verdictEl = document.getElementById('aql-verdict-text');
    if (verdictEl) {
      verdictEl.textContent = `Inspect ${sampleSize} randomly selected pieces from the shipment of ${lotSize.toLocaleString()} pcs. Record all defects found in each category. If defects in any category reach or exceed the Re (Rejection) number, reject the shipment. If all categories are at or below Ac (Acceptance), the lot passes.`;
    }

    (document.getElementById('aql-placeholder') as HTMLElement).style.display = 'none';
    (document.getElementById('aql-result-content') as HTMLElement).style.display = 'block';
  });
</script>
