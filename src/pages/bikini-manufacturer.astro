const pageDescription = "Bikini manufacturer in Bangladesh. Custom swimwear, bikinis from 300 pieces. Nylon/spandex, recycled fabrics. OEKO-TEX certified. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
