          "name": "Submit Design Requirements",
          "text": "Send your bikini design, fabric preferences (nylon/spandex, recycled), style type, size chart, and target quantity via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your bikini order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review bikini samples for fit, fabric quality, construction, and stretch recovery within 15-20 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 35-45 day turnaround for standard bikini styles"
        },
