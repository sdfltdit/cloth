---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Sweatshirt Manufacturer — Custom Crewnecks | SDF Clothing";
const pageDescription = "Custom sweatshirt manufacturer in Bangladesh. Crewneck sweatshirts and sweat sets from 300 pieces. All weights and fabrics. Private label. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": PHONE,
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Sweatshirt Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between sweatshirt and hoodie?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sweatshirts have crewneck neckbands without hoods. Hoodies have attached hoods with drawstrings. Sweatshirts are simpler in construction, making them ideal for screen printing and embroidery. They offer a clean neckline suitable for layering under jackets."
          }
        },
        {
          "@type": "Question",
          "name": "What sweatshirt styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture crewneck sweatshirts (standard, oversized, fitted), half-zip sweatshirts with chest zippers, quarter-zip sweatshirts with collar necklines, and raglan sweatshirts with contrast sleeve panels. All styles available from 300 pieces minimum."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric weights do you offer for sweatshirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 240 GSM lightweight sweatshirts for spring/summer, 280 GSM midweight for standard year-round wear, 320 GSM heavyweight for winter and premium positioning, and 380 GSM extra-heavyweight for maximum warmth and premium streetwear."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for sweatshirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our sweatshirt minimum is 300 pieces per style. This applies to crewneck, half-zip, quarter-zip, and raglan styles. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce sweat sets with matching sweatpants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We produce matching sweat sets with crewneck sweatshirts and sweatpants in the same fabric and color. Sweat sets are popular for loungewear, athleisure, and brand collections. Minimum 300 pieces per set style (tops and bottoms combined)."
          }
        },
        {
          "@type": "Question",
          "name": "What customization options do you offer for sweatshirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Customization includes screen printing, DTG printing, embroidery, custom neckband colors, ribbed cuffs in contrast colors, custom labels and hang tags, and packaging. The clean crewneck area provides excellent space for chest branding."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics do you use for sweatshirt production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use cotton fleece, French terry, poly-cotton blends for durability and shrinkage resistance, organic cotton fleece for sustainable options, and recycled polyester blends. All fabrics pre-shrunk to minimize garment shrinkage."
          }
        },
        {
          "@type": "Question",
          "name": "How long does sweatshirt production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic sweatshirts. 35-50 days for custom fabric development or heavyweight options. 7-14 days for sampling before bulk. Rush production available at 20-30% premium."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Sweatshirt Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Sweatshirt Manufacturer | Since 1998 | Crewneck Specialists</div>
        <h1 class="hero__title">Sweatshirt Manufacturer | Custom Crewneck Sweatshirts and Sweat Sets from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a custom sweatshirt manufacturer in Bangladesh specializing in crewneck sweatshirts without hoods. We produce crewneck, half-zip, quarter-zip, and raglan sweatshirts from 300 pieces minimum. All fabric weights from 240-380 GSM, private label ready, with full customization options for screen printing and embroidery. Explore our <a href="/clothing-manufacturers/" style="color:#e00;text-decoration:none;">clothing manufacturers</a> and <a href="/clothing-manufacturer-bangladesh/" style="color:#e00;text-decoration:none;">Bangladesh clothing manufacturer</a>.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20sweatshirt-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">240-380</span>
          <span class="hero__stat-label">GSM Range</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Sweatshirt vs Hoodie</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sweatshirt vs Hoodie | The Crewneck Advantage</h2>
      </div>
      <div class="section__text">
        <p>Sweatshirts differ from hoodies in their fundamental construction: sweatshirts feature crewneck neckbands without attached hoods, while hoodies include hoods with drawstrings. This distinction makes sweatshirts simpler in construction and more suitable for certain applications. The absence of a hood reduces production complexity and cost, while the clean crewneck area provides excellent space for screen printing, embroidery, and branding without hood interference.</p>
        
        <p>Sweatshirts offer a clean neckline ideal for layering under jackets, coats, and blazers. The crewneck design works seamlessly with outerwear, avoiding the bulk that hoods create when layered. This makes sweatshirts preferred for transitional weather wear, office-casual environments, and fashion-forward layering combinations. The ribbed neckband provides structure and maintains shape through wear, ensuring the neckline stays clean and professional.</p>
        
        <p>From a manufacturing perspective, sweatshirts allow for faster production times and lower minimums compared to hoodies. The simplified construction reduces sewing operations, quality checkpoints, and potential defect points. This efficiency translates to competitive pricing for brands while maintaining the same fabric quality and construction standards as our hoodie production. Sweatshirts are particularly well-suited for brands focusing on screen printing, as the flat chest area provides optimal surface area for large format prints without hood drawstring interference.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Sweatshirt Styles</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sweatshirt Styles We Manufacture</h2>
      </div>
      <div class="section__text">
        <p>We manufacture four primary sweatshirt styles, each serving different market segments and design aesthetics. Crewneck sweatshirts form the foundation of our production, offering the classic clean neckline that defines the category. Half-zip and quarter-zip variations add functionality with chest zippers and collar necklines, while raglan sweatshirts provide contrast sleeve panel options for visual interest. All styles maintain the same quality standards and are available from 300 pieces minimum.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Style</th>
              <th>Neckline</th>
              <th>Key Features</th>
              <th>Best For</th>
              <th>Price Tier</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Crewneck</td>
              <td>Ribbed crewneck band</td>
              <td>Clean neckline, no hood, ribbed cuffs and hem</td>
              <td>Screen printing, layering, basic wear</td>
              <td>$</td>
            </tr>
            <tr>
              <td>Half-Zip</td>
              <td>Standing collar with chest zipper</td>
              <td>Ventilation, adjustable neck, sport aesthetic</td>
              <td>Athleisure, golf, outdoor brands</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Quarter-Zip</td>
              <td>Mock collar with partial zipper</td>
              <td>Subtle zipper, collar structure, modern look</td>
              <td>Fashion brands, casual wear</td>
              <td>$$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Raglan</td>
              <td>Crewneck with raglan sleeves</td>
              <td>Contrast sleeve panels, athletic silhouette</td>
              <td>Sports teams, vintage aesthetics</td>
              <td>$$</td>
            </tr>
          </tbody>
          <caption>All styles available from 300 pieces minimum. Custom combinations possible with higher minimums.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Weight Guide</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sweatshirt Fabric Weight Guide | Choosing the Right GSM</h2>
      </div>
      <div class="section__text">
        <p>Fabric weight determines sweatshirt warmth, drape, and positioning in the market. GSM (grams per square meter) is the standard measurement for fabric weight, with higher numbers indicating heavier, warmer fabrics. We offer sweatshirts across four weight categories to serve different seasons, price points, and brand positioning requirements.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Weight</th>
              <th>GSM</th>
              <th>Season</th>
              <th>Characteristics</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Lightweight</td>
              <td>240 GSM</td>
              <td>Spring/Summer</td>
              <td>Breathable, light drape, quick drying</td>
              <td>Lightweight basics, layering pieces</td>
            </tr>
            <tr>
              <td>Midweight</td>
              <td>280 GSM</td>
              <td>Year-round</td>
              <td>Balanced warmth and weight, standard feel</td>
              <td>Everyday wear, retail standard</td>
            </tr>
            <tr>
              <td>Heavyweight</td>
              <td>320 GSM</td>
              <td>Winter/Fall</td>
              <td>Warm, substantial, premium feel</td>
              <td>Premium positioning, winter wear</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Extra-Heavyweight</td>
              <td>380 GSM</td>
              <td>Extreme Cold</td>
              <td>Maximum warmth, substantial weight</td>
              <td>Premium streetwear, heavy duty</td>
            </tr>
          </tbody>
          <caption>Weight tolerance guaranteed within ?5%. Pre-shrunk fabrics minimize garment shrinkage.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Customization by MOQ</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sweatshirt Customization Options by MOQ Tier</h2>
      </div>
      <div class="section__text">
        <p>Customization options vary by order quantity, with higher volumes enabling more complex customization. Our tiered approach ensures brands at all stages can access customization appropriate to their scale. Standard customization is available from 300 pieces, while advanced options require higher minimums due to setup costs and production efficiency requirements.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>MOQ Tier</th>
              <th>Quantity</th>
              <th>Screen Printing</th>
              <th>Embroidery</th>
              <th>Custom Details</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Standard</td>
              <td>300+ pieces</td>
              <td>Up to 4 colors, standard placement</td>
              <td>Basic logo embroidery</td>
              <td>Standard neckband, ribbed cuffs</td>
            </tr>
            <tr>
              <td>Intermediate</td>
              <td>500+ pieces</td>
              <td>Up to 8 colors, all-over print</td>
              <td>3D puff, multi-location</td>
              <td>Contrast neckband, custom labels</td>
            </tr>
            <tr>
              <td>Advanced</td>
              <td>1000+ pieces</td>
              <td>Unlimited colors, specialty inks</td>
              <td>Complex designs, large scale</td>
              <td>Custom neckband, special finishes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Premium</td>
              <td>2000+ pieces</td>
              <td>Custom development, proprietary</td>
              <td>Full custom development</td>
              <td>Fully custom construction</td>
            </tr>
          </tbody>
          <caption>MOQ applies per style and colorway. Customization costs additional to base garment price.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Size Chart</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sweatshirt Size Chart | Measurements for Fit Consistency</h2>
      </div>
      <div class="section__text">
        <p>Our size chart provides measurements for consistent fit across production runs. All measurements are taken from finished garments after washing and drying. We recommend ordering samples to verify fit before bulk production, as fit preferences vary by brand and target market.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (in)</th>
              <th>Length (in)</th>
              <th>Sleeve Length (in)</th>
              <th>Shoulder Width (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>XS</td>
              <td>34-36</td>
              <td>26-27</td>
              <td>32-33</td>
              <td>16-17</td>
            </tr>
            <tr>
              <td>S</td>
