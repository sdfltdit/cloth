---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ─── helpers ────────────────────────────────────────────────────────────────
function hexToRgb(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return `${r},${g},${b}`;
}

// ─── page meta ──────────────────────────────────────────────────────────────
const pageTitle = "Textile Industry News & Manufacturing Insights — SDF Clothing Journal";
const pageDesc  = "Bangladesh garment manufacturer SDF Clothing documents textile industry news, RMG sector developments, GOTS and BSCI certification updates, EU regulatory changes, and supply chain insights from our Dhaka production facility.";
const canonical = "https://sdfltd.com/journal/";

// ─── inline SVG icon map ─────────────────────────────────────────────────────
const ICONS: Record<string, string> = {
  certification: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  expansion:     `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  people:        `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  innovation:    `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
  financial:     `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  award:         `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  partnership:   `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  event:         `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
};

// Arrow icon reused in cards
const ARROW = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;

// ─── post data ───────────────────────────────────────────────────────────────
const rawPosts = [
  {
    id: "gots-7-recertification-2026",
    dateDisplay: "May 2026", dateISO: "2026-05-01",
    title: "SDF Clothing Achieves GOTS 7.0 Recertification for 2026 Production",
    excerpt: "Our third consecutive GOTS recertification covers all primary production lines — from fabric preparation through final finishing. The 7.0 standard introduced stricter chemical input controls and traceability documentation requirements that reshaped wet processing procedures across the Dhaka facility.",
    category: "Certification", catColor: "#00c46a", catSlug: "certification",
    tags: ["GOTS 7.0", "organic textiles", "chemical compliance"],
    readTime: "4 min", featured: true, isNew: true, year: 2026,
    href: "/journal/gots-7-recertification-2026/",
  },
  {
    id: "capacity-expansion-2026",
    dateDisplay: "Apr 2026", dateISO: "2026-04-01",
    title: "SDF Clothing Adds 15% Capacity at Dhaka Facility",
    excerpt: "Sixteen new sewing lines and updated finishing equipment at our Kafrul facility extend monthly output. The investment directly answers confirmed purchase orders from three European fashion brands placing Spring/Summer 2027 collections.",
    category: "Expansion", catColor: "#0088ff", catSlug: "expansion",
    tags: ["manufacturing capacity", "EU sourcing", "Bangladesh garment"],
    readTime: "3 min", featured: false, isNew: false, year: 2026,
    href: "/clothing-manufacturer-bangladesh/",
  },
  {
    id: "sustainability-director-2026",
    dateDisplay: "Mar 2026", dateISO: "2026-03-01",
    title: "SDF Clothing Welcomes New Sustainability Director",
    excerpt: "Seventeen years across sourcing, compliance, and lifecycle assessment bring grounded expertise to our ESPR preparation roadmap. Focus areas: DPP integration, REACH chemical compliance, and end-of-life traceability for EU market clients.",
    category: "People", catColor: "#a855f7", catSlug: "people",
    tags: ["ESPR 2027", "DPP compliance", "circular economy"],
    readTime: "3 min", featured: false, isNew: false, year: 2026,
    href: "/insights/index/",
  },
  {
    id: "digital-product-passport-2026",
    dateDisplay: "Feb 2026", dateISO: "2026-02-01",
    title: "SDF Clothing Launches Digital Product Passport Pilot Program",
    excerpt: "We enrolled twelve SKUs from two client collections in an early DPP pilot, testing serialised QR codes against three proposed EU registry frameworks. Results directly inform how we structure passport data architecture ahead of the 2027 mandate.",
    category: "Innovation", catColor: "#8b5cf6", catSlug: "innovation",
    tags: ["digital product passport", "EU textile regulations", "supply chain traceability"],
    readTime: "5 min", featured: false, isNew: false, year: 2026,
    href: "/insights/index/",
  },
  {
    id: "annual-growth-2025",
    dateDisplay: "Jan 2026", dateISO: "2026-01-10",
    title: "SDF Clothing Reports 28% Year-Over-Year Growth in 2025",
    excerpt: "Full-year 2025 revenue reached the highest point in company history, driven by eight new brand relationships and increased repeat volumes from North America. EBITDA margin held steady despite raw material cost increases across Q3.",
    category: "Financial", catColor: "#f59e0b", catSlug: "financial",
    tags: ["Bangladesh apparel exports", "RMG growth", "2025 results"],
    readTime: "4 min", featured: false, isNew: false, year: 2026,
    href: "/journal/annual-growth-2025/",
  },
  {
    id: "bsci-excellence-2025",
    dateDisplay: "Dec 2025", dateISO: "2025-12-01",
    title: "SDF Clothing Receives BSCI Compliance Excellence Recognition",
    excerpt: "The annual BSCI audit assessed wages, working hours, health and safety systems, and freedom of association. Receiving the highest rating across all six assessment areas reflects consistent process work — not pre-audit preparation.",
    category: "Award", catColor: "#f97316", catSlug: "award",
    tags: ["BSCI", "social compliance", "ethical manufacturing"],
    readTime: "4 min", featured: false, isNew: false, year: 2025,
    href: "/certifications/",
  },
  {
    id: "european-mill-partnership-2025",
    dateDisplay: "Nov 2025", dateISO: "2025-11-01",
    title: "SDF Clothing Partners with European Textile Mill Network",
    excerpt: "New supply agreements with three certified mills in Portugal and one in northern Italy give our clients direct access to GOTS-certified and GRS-verified fabrics with documented chain of custody — reducing sourcing complexity at a critical tier.",
    category: "Partnership", catColor: "#06b6d4", catSlug: "partnership",
    tags: ["sustainable fabric sourcing", "GRS certification", "Portugal textile"],
    readTime: "3 min", featured: false, isNew: false, year: 2025,
    href: "/journal/european-mill-partnership-2025/",
  },
  {
    id: "sourcing-summit-2025",
    dateDisplay: "Oct 2025", dateISO: "2025-10-01",
    title: "SDF Clothing Hosts Industry Sourcing Summit in Dhaka",
    excerpt: "Over sixty attendees — brand sustainability leads, sourcing managers, and Bangladesh factory representatives — worked through 2026 priorities: DPP readiness, LDC graduation implications, and nearshoring pressure on South Asian suppliers.",
    category: "Event", catColor: "#6366f1", catSlug: "event",
    tags: ["Bangladesh sourcing", "LDC graduation", "Dhaka industry event"],
    readTime: "5 min", featured: false, isNew: false, year: 2025,
    href: "/journal/sourcing-summit-2025/",
  },
];

// Enrich with computed RGB string
const posts = rawPosts.map(p => ({ ...p, catRgb: hexToRgb(p.catColor) }));

const featured   = posts.find(p => p.featured)!;
const posts2026  = posts.filter(p => !p.featured && p.year === 2026);
const posts2025  = posts.filter(p => p.year === 2025);
const categories = ["All", ...new Set(posts.map(p => p.category))];

// ─── semantic topic coverage areas ──────────────────────────────────────────
const coverageAreas = [
  { icon: "🏅", title: "Sustainability Certifications", color: "#00c46a", rgb: "0,196,106",
    body: "GOTS, OEKO-TEX, GRS, BSCI — what each standard covers, what changes between versions, and how recertification cycles affect production scheduling.",
    tags: ["GOTS", "OEKO-TEX", "GRS", "BSCI"] },
  { icon: "🌐", title: "EU Textile Regulations", color: "#0088ff", rgb: "0,136,255",
    body: "The ESPR framework, Digital Product Passport timelines, Extended Producer Responsibility, and how Bangladesh manufacturers prepare for 2027 compliance.",
    tags: ["ESPR", "DPP", "EPR", "EU 2027"] },
  { icon: "📦", title: "Bangladesh RMG Industry", color: "#ee0000", rgb: "238,0,0",
    body: "Export performance, LDC graduation implications, BGMEA policy developments, and structural shifts across the world's second-largest garment-exporting country.",
    tags: ["RMG sector", "LDC graduation", "apparel exports"] },
  { icon: "🔗", title: "Supply Chain Transparency", color: "#06b6d4", rgb: "6,182,212",
    body: "Traceability requirements, chain-of-custody documentation, raw material sourcing, and what brands increasingly ask of tier-two and tier-three suppliers.",
    tags: ["traceability", "chain of custody", "responsible sourcing"] },
  { icon: "🏭", title: "Manufacturing & Capacity", color: "#f59e0b", rgb: "245,158,11",
    body: "Facility updates, technology adoption, production line efficiency, and the operational decisions that shape output at a mid-scale Bangladesh garment factory.",
    tags: ["factory capacity", "sewing lines", "Bangladesh manufacturing"] },
  { icon: "🤝", title: "Partnerships & Events", color: "#6366f1", rgb: "99,102,241",
    body: "Mill relationships, buyer partnerships, industry sourcing summits, and team appointments from the Bangladesh factory floor and beyond.",
    tags: ["sourcing events", "mill partnerships", "industry news"] },
];

// ─── JSON-LD structured data ─────────────────────────────────────────────────
const jsonLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#organization",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Bangladesh-based garment manufacturer producing sustainable, certified clothing for European and North American brands.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kafrul",
        "addressLocality": "Dhaka",
        "addressCountry": "BD"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://sdfltd.com/#website",
      "url": "https://sdfltd.com",
      "name": "SDF Clothing",
      "publisher": { "@id": "https://sdfltd.com/#organization" }
    },
    {
      "@type": "CollectionPage",
      "@id": "https://sdfltd.com/journal/#webpage",
      "url": canonical,
      "name": pageTitle,
      "description": pageDesc,
      "isPartOf": { "@id": "https://sdfltd.com/#website" },
      "about": { "@id": "https://sdfltd.com/#organization" },
      "breadcrumb": { "@id": "https://sdfltd.com/journal/#breadcrumb" },
      "inLanguage": "en",
      "dateModified": "2026-05-01"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://sdfltd.com/journal/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",    "item": "https://sdfltd.com" },
        { "@type": "ListItem", "position": 2, "name": "Journal", "item": canonical }
      ]
    },
    {
      "@type": "Blog",
      "@id": "https://sdfltd.com/journal/#blog",
      "name": "SDF Clothing Industry Journal",
      "url": canonical,
      "description": "Textile industry news, Bangladesh RMG sector updates, sustainability certifications, EU compliance preparation, and supply chain transparency insights from SDF Clothing.",
      "publisher": { "@id": "https://sdfltd.com/#organization" },
      "blogPost": posts.map(p => ({
        "@type": "BlogPosting",
        "@id": `https://sdfltd.com/journal/${p.id}/`,
        "url": `https://sdfltd.com/journal/${p.id}/`,
        "headline": p.title,
        "description": p.excerpt,
        "datePublished": p.dateISO,
        "dateModified": p.dateISO,
        "keywords": p.tags.join(", "),
        "articleSection": p.category,
        "author":    { "@id": "https://sdfltd.com/#organization" },
        "publisher": { "@id": "https://sdfltd.com/#organization" },
        "mainEntityOfPage": { "@id": "https://sdfltd.com/journal/#webpage" }
      }))
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDesc}>

  <!-- ── head injections ─────────────────────────────────────────────── -->
  <link rel="canonical"  href={canonical} />
  <link rel="alternate"  hreflang="en" href={canonical} />
  <meta name="robots"    content="index, follow, max-snippet:-1, max-image-preview:large" />

  <!-- Open Graph -->
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url"         content={canonical} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="SDF Clothing" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />

  <!-- ── styles ──────────────────────────────────────────────────────── -->
  <style>
    /* ── tokens ─────────────────────────────────────── */
    .jw {
      --red:        #ee0000;
      --red-dim:    rgba(238,0,0,0.09);
      --red-border: rgba(238,0,0,0.35);
      --card-bg:    #111111;
      --card-hover: #161616;
      --border:     rgba(255,255,255,0.08);
      --border-md:  rgba(255,255,255,0.14);
      --white:      #ffffff;
      --muted:      rgba(255,255,255,0.48);
      --muted-md:   rgba(255,255,255,0.68);
      --ink:        #000000;
      --font:       'Inter', system-ui, sans-serif;
      --mono:       'Inter', ui-monospace, monospace;

      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.5rem 7rem;
      background: var(--ink);
      min-height: 100vh;
    }

    /* ── breadcrumb ──────────────────────────────────── */
    .bc {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 1.75rem 0 0;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      list-style: none;
    }
    .bc a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.15s;
    }
    .bc a:hover { color: var(--red); }
    .bc-sep { color: var(--muted); font-size: 0.8rem; }
    .bc-current { color: var(--red); font-weight: 600; }

    /* ── page header ─────────────────────────────────── */
    .ph {
      padding: 2.75rem 0 2.5rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 2.25rem;
    }
    .ph-eye {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--red);
      font-weight: 700;
      margin-bottom: 1.1rem;
    }
    .ph-eye-line {
      display: block;
      width: 2.25rem;
      height: 2px;
      background: var(--red);
      flex-shrink: 0;
    }
    .ph-title {
      font-family: var(--font);
      font-size: clamp(2rem, 5vw, 3.25rem);
      font-weight: 800;
      color: var(--white);
      line-height: 1.08;
      letter-spacing: -0.03em;
      margin-bottom: 1.1rem;
    }
    .ph-title em {
      font-style: normal;
      color: var(--red);
    }
    .ph-intro {
      font-family: var(--font);
      font-size: 1.02rem;
      line-height: 1.72;
      color: var(--muted-md);
      max-width: 660px;
    }
    .ph-updated {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 1.1rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.07em;
      color: var(--muted);
    }
    .ph-updated-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      background: var(--red);
      border-radius: 50%;
    }

    /* ── stats infographic bar ───────────────────────── */
    .stats {
      display: flex;
      background: var(--card-bg);
      border: 1px solid var(--border);
      margin-bottom: 1.75rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .stats::-webkit-scrollbar { display: none; }
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.25rem 1.75rem;
      flex: 1;
      min-width: 110px;
      gap: 0.2rem;
      position: relative;
    }
    .stat-item + .stat-item::before {
      content: '';
      position: absolute;
      left: 0;
      top: 22%;
      bottom: 22%;
      width: 1px;
      background: var(--border);
    }
    .stat-icon { font-size: 1.15rem; line-height: 1; }
    .stat-val {
      font-family: var(--mono);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--white);
      letter-spacing: -0.02em;
    }
    .stat-lbl {
      font-family: var(--mono);
      font-size: 0.6rem;
      color: var(--muted);
      text-align: center;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    /* ── category filter ─────────────────────────────── */
    .filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-bottom: 2.5rem;
    }
    .filter-btn {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
      padding: 0.45rem 0.95rem;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
      line-height: 1;
    }
    .filter-btn:hover {
      border-color: var(--border-md);
      color: var(--white);
    }
    .filter-btn.is-active {
      background: var(--red);
      border-color: var(--red);
      color: var(--white);
    }

    /* ── featured card ───────────────────────────────── */
    .feat {
      position: relative;
      padding: 2.25rem 2.25rem 2rem;
      border: 1px solid var(--border);
      margin-bottom: 2.5rem;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .feat:hover { border-color: var(--border-md); }

    /* stitch — the signature textile element */
    .feat::before {
      content: '';
      position: absolute;
      left: 0; top: 14px; bottom: 14px;
      width: 3px;
      background: repeating-linear-gradient(
        to bottom,
        var(--stitch) 0px, var(--stitch) 10px,
        transparent   10px, transparent  19px
      );
    }
    .feat::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba(var(--cat-rgb), 0.055) 0%,
        transparent 55%
      );
      pointer-events: none;
    }
    .feat-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }
    .feat-right {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .feat-title {
      font-family: var(--font);
      font-size: clamp(1.3rem, 3vw, 1.75rem);
      font-weight: 700;
      color: var(--white);
      line-height: 1.25;
      letter-spacing: -0.025em;
      margin-bottom: 0.875rem;
    }
    .feat-title a {
      color: inherit;
      text-decoration: none;
      transition: color 0.15s;
    }
    .feat-title a:hover { color: rgba(255,255,255,0.8); }
    .feat-excerpt {
      font-family: var(--font);
      font-size: 0.97rem;
      line-height: 1.68;
      color: var(--muted-md);
      margin-bottom: 1.4rem;
      max-width: 720px;
    }

    /* ── shared card elements ────────────────────────── */
    .cat-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 0.3rem 0.65rem;
      border: 1px solid;
      line-height: 1;
    }
    .post-date {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.04em;
    }
    .new-badge {
      font-family: var(--mono);
      font-size: 0.58rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 3px 8px;
      background: var(--red);
      color: var(--white);
    }
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .tag {
      font-family: var(--mono);
      font-size: 0.6rem;
