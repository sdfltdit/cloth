<!-- ── category filter JS ────────────────────────────────────────────────── -->
<script is:inline>
(function () {
  var btns    = document.querySelectorAll('.filter-btn');
  var cards   = document.querySelectorAll('[data-cat]');
  var groups  = document.querySelectorAll('.year-group');
  var sep     = document.getElementById('ysep');

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      // update button states
      btns.forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');

      var filter = btn.getAttribute('data-filter');

      // show / hide post cards
      cards.forEach(function (card) {
        var match = filter === 'all' || card.getAttribute('data-cat') === filter;
        if (match) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });

      // show / hide year sections
      var allVisible = [];
      groups.forEach(function (group) {
        var visible = group.querySelectorAll('[data-cat]:not(.is-hidden)');
        if (visible.length === 0) {
          group.classList.add('is-hidden');
          allVisible.push(false);
        } else {
          group.classList.remove('is-hidden');
          allVisible.push(true);
        }
      });

      // show sep only when both year groups are visible
      if (sep) {
        var bothVisible = allVisible.length === 2 && allVisible[0] && allVisible[1];
        if (bothVisible) {
          sep.classList.remove('is-hidden');
        } else {
          sep.classList.add('is-hidden');
        }
      }
    });
  });
})();
</script>
