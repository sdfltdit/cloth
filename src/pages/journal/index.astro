---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Journal | SDF Clothing - Garments Industry Insights";
const pageDescription = "SDF Clothing journal - insights on Bangladesh garments industry, manufacturing guides, EU regulations, and sustainable fashion for global buyers.";
const siteUrl = "https://sdfltd.com";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	
	<div class="container">
		<!-- Breadcrumb -->
		<nav aria-label="Breadcrumb" style="margin: 2rem 0;">
			<p style="font-size: 0.8rem; color: #aaa;">
				<a href="/" style="color: #e00;">Home</a> &gt; Journal
			</p>
		</nav>
		
		<!-- Main Content -->
		<article>
			<h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 2rem; color: #fff;">
				Journal
			</h1>
			
			<p style="font-size: 1.1rem; color: #aaa; line-height: 1.8; margin-bottom: 3rem;">
				Welcome to the SDF Clothing journal - your resource for insights into the Bangladesh garments industry, manufacturing best practices, regulatory updates, and sustainable fashion trends. Our articles are designed to help fashion brands navigate the complexities of global apparel production and make informed decisions about their manufacturing partnerships.
			</p>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Latest from SDF Clothing
			</h2>
			
			<!-- Article Cards Grid -->
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<!-- Article 1 -->
				<article style="background: #0a0a0a; border-radius: 8px; overflow: hidden; border: 1px solid #1a1a1a; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='#e00';" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#1a1a1a';">
					<div style="padding: 2rem;">
						<div style="margin-bottom: 1rem;">
							<span style="color: #e00; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em;">Manufacturing Guide</span>
						</div>
						<h3 style="font-size: 1.3rem; font-weight: 400; margin-bottom: 1rem; color: #fff; line-height: 1.3;">
							How to Choose a Clothing Manufacturer in Bangladesh
						</h3>
						<p style="color: #aaa; line-height: 1.6; margin-bottom: 1.5rem; font-size: 0.95rem;">
							A comprehensive guide for fashion brands on selecting the right manufacturing partner in Bangladesh. Learn about certifications, MOQ requirements, quality standards, and red flags to avoid when sourcing clothing manufacturers.
						</p>
						<div style="display: flex; justify-content: space-between; align-items: center;">
							<span style="color: #666; font-size: 0.8rem;">8 min read</span>
							<a href="/journal/how-to-choose-clothing-manufacturer" style="color: #e00; text-decoration: none; font-weight: 500; font-size: 0.9rem;">
								Read More &rarr;
							</a>
						</div>
					</div>
				</article>
				
				<!-- Article 2 -->
				<article style="background: #0a0a0a; border-radius: 8px; overflow: hidden; border: 1px solid #1a1a1a; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.borderColor='#e00';" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#1a1a1a';">
					<div style="padding: 2rem;">
						<div style="margin-bottom: 1rem;">
							<span style="color: #e00; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em;">Regulatory Update</span>
						</div>
						<h3 style="font-size: 1.3rem; font-weight: 400; margin-bottom: 1rem; color: #fff; line-height: 1.3;">
							EU EPR Explained for Fashion Brands 2026
						</h3>
						<p style="color: #aaa; line-height: 1.6; margin-bottom: 1.5rem; font-size: 0.95rem;">
							Understanding the EU Extended Producer Responsibility (EPR) requirements and how they impact your fashion brand in 2026. Learn compliance strategies and ensure your Bangladesh manufacturing partner is ready for the new regulations.
						</p>
						<div style="display: flex; justify-content: space-between; align-items: center;">
							<span style="color: #666; font-size: 0.8rem;">6 min read</span>
							<a href="/journal/eu-epr-explained" style="color: #e00; text-decoration: none; font-weight: 500; font-size: 0.9rem;">
								Read More &rarr;
							</a>
						</div>
					</div>
				</article>
				
			</div>
			
			<!-- More Articles Section -->
			<div style="margin: 4rem 0; padding: 3rem 0; border-top: 1px solid #1a1a1a;">
				<h3 style="font-size: 1.4rem; font-weight: 400; margin-bottom: 2rem; color: #fff;">
					Coming Soon
				</h3>
				
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
					<div style="background: #050505; padding: 1.5rem; border-radius: 8px; border: 1px solid #1a1a1a;">
						<h4 style="color: #aaa; font-size: 1.1rem; margin-bottom: 0.5rem;">Sustainable Materials Guide</h4>
						<p style="color: #666; font-size: 0.9rem; line-height: 1.5;">Understanding GOTS, GRS, and emerging sustainable fabric technologies</p>
					</div>
					<div style="background: #050505; padding: 1.5rem; border-radius: 8px; border: 1px solid #1a1a1a;">
						<h4 style="color: #aaa; font-size: 1.1rem; margin-bottom: 0.5rem;">Quality Control Best Practices</h4>
						<p style="color: #666; font-size: 0.9rem; line-height: 1.5;">AQL standards and inspection processes for garment manufacturing</p>
					</div>
					<div style="background: #050505; padding: 1.5rem; border-radius: 8px; border: 1px solid #1a1a1a;">
						<h4 style="color: #aaa; font-size: 1.1rem; margin-bottom: 0.5rem;">Lead Time Optimization</h4>
						<p style="color: #666; font-size: 0.9rem; line-height: 1.5;">Strategies to reduce production time without compromising quality</p>
					</div>
					<div style="background: #050505; padding: 1.5rem; border-radius: 8px; border: 1px solid #1a1a1a;">
						<h4 style="color: #aaa; font-size: 1.1rem; margin-bottom: 0.5rem;">Private Label Success Stories</h4>
						<p style="color: #666; font-size: 0.9rem; line-height: 1.5;">Case studies from brands that scaled with Bangladesh manufacturing</p>
					</div>
				</div>
			</div>
			
			<!-- Newsletter Signup -->
			<div style="background: #0a0a0a; padding: 2.5rem; border-radius: 8px; margin: 3rem 0; text-align: center; border: 1px solid #1a1a1a;">
				<h3 style="color: #fff; font-size: 1.4rem; font-weight: 400; margin-bottom: 1rem;">
					Stay Updated
				</h3>
				<p style="color: #aaa; margin-bottom: 2rem; line-height: 1.6;">
					Get the latest insights on Bangladesh garment manufacturing, regulatory updates, and industry trends delivered to your inbox.
				</p>
				<a href="/contact" style="display: inline-block; background: #e00; color: #000; padding: 0.8rem 2rem; text-decoration: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; border-radius: 4px;">
					Subscribe to Updates
				</a>
			</div>
			
		</article>
		
		<!-- Footer Link -->
		<div style="text-align: center; margin: 4rem 0 2rem; padding-top: 2rem; border-top: 1px solid #1a1a1a;">
			<p style="color: #aaa; font-size: 0.9rem;">
				<a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing,%20I%20need%20custom%20manufacturing%20guidance" target="_blank" rel="noopener noreferrer" style="color: #e00;">Contact Us</a> for custom manufacturing guidance
			</p>
		</div>
	</div>
	
</BaseLayout>

<style>
/* Responsive adjustments */
@media (max-width: 768px) {
	article > div[style*="grid"] {
		grid-template-columns: 1fr !important;
		gap: 1.5rem !important;
	}
}
</style>
