---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Press Releases | SDF Clothing News & Announcements";
const description = "Latest news from SDF Clothing — manufacturing updates, certifications, partnerships, and industry insights from Bangladesh garment producer.";
const canonical = "https://sdfltd.com/journal/";
---

<BaseLayout title={title} description={canonical}>
  <link rel="canonical" href={canonical} />
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <style>
    .journal-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 4rem 1.5rem 6rem;
      background: #000000;
      min-height: 100vh;
    }

    .hero-section {
      padding-bottom: 2rem;
      border-bottom: 2px solid #e00;
      margin-bottom: 3rem;
    }

    .hero-label {
      font-family: 'Inter', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #e00;
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .hero-title {
      font-family: 'Inter', sans-serif;
      font-size: 2.5rem;
      font-weight: 700;
      color: #FFFFFF;
      line-height: 1.2;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }

    @media (max-width: 768px) {
      .hero-title {
        font-size: 1.75rem;
      }
    }

    .hero-subtitle {
      font-family: 'Inter', sans-serif;
      font-size: 1.1rem;
      font-style: italic;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    .hero-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-date {
      font-family: 'Inter', monospace;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.6);
      letter-spacing: 0.05em;
    }

    .new-badge {
      background: #e00;
      color: #FFFFFF;
      font-family: 'Inter', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 4px 10px;
      font-weight: 600;
    }

    .year-label {
      font-family: 'Inter', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 0.75rem;
      font-weight: 600;
    }

    .year-line {
      height: 1px;
      background: #e00;
      margin-bottom: 2rem;
    }

    .press-item {
      display: grid;
      grid-template-columns: 80px 1fr auto;
      gap: 1.5rem;
      padding: 1.5rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      align-items: flex-start;
    }

    @media (max-width: 768px) {
      .press-item {
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }
    }

    .item-date {
      font-family: 'Inter', monospace;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.6);
      letter-spacing: 0.05em;
    }

    .item-content {
      min-width: 0;
    }

    .item-title {
      font-family: 'Inter', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: #FFFFFF;
      margin-bottom: 0.5rem;
      line-height: 1.4;
      letter-spacing: -0.01em;
    }

    .item-subtitle {
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      font-style: italic;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.5;
    }

    .item-tag {
      font-family: 'Inter', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #e00;
      border: 1px solid #e00;
      padding: 3px 8px;
      font-weight: 600;
      white-space: nowrap;
    }

    .year-separator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin: 3rem 0;
    }

    .separator-line {
      flex: 1;
      height: 1px;
      background: #e00;
    }

    .separator-diamond {
      color: #e00;
      font-size: 1.25rem;
    }
  </style>

  <div class="journal-container">
    <!-- Hero Section - Latest Release -->
    <section class="hero-section">
      <div class="hero-label">Latest Release</div>
      <h1 class="hero-title">SDF Clothing Achieves GOTS 7.0 Recertification for 2026 Production</h1>
      <p class="hero-subtitle">Continued commitment to organic textile standards across all production lines. See our <a href="/certifications" style="color: #e00; text-decoration: none;">full certification portfolio</a>.</p>
      <div class="hero-meta">
        <span class="hero-date">May 2026</span>
        <span class="new-badge">New</span>
      </div>
    </section>

    <!-- Year 2026 -->
    <div class="year-label">2026</div>
    <div class="year-line"></div>

    <article class="press-item">
      <div class="item-date">Apr 2026</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Adds 15% Capacity Expansion in Dhaka Facility</h2>
        <p class="item-subtitle">New sewing lines and finishing equipment support growing European demand. Learn about our <a href="/clothing-manufacturer-bangladesh" style="color: #e00; text-decoration: none;">Bangladesh operations</a>.</p>
      </div>
      <span class="item-tag">Expansion</span>
    </article>

    <article class="press-item">
      <div class="item-date">Mar 2026</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Welcomes New Sustainability Director</h2>
        <p class="item-subtitle">Industry veteran joins to lead 2027 ESPR compliance preparation. See our <a href="/insights/index" style="color: #e00; text-decoration: none;">industry insights</a> on compliance.</p>
      </div>
      <span class="item-tag">People</span>
    </article>

    <article class="press-item">
      <div class="item-date">Feb 2026</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Launches Digital Product Passport Pilot Program</h2>
        <p class="item-subtitle">Early adoption initiative prepares clients for 2027 EU regulations</p>
      </div>
      <span class="item-tag">Innovation</span>
    </article>

    <article class="press-item">
      <div class="item-date">Jan 2026</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Reports 28% Year-Over-Year Growth in 2025</h2>
        <p class="item-subtitle">Strong demand from European and North American brands drives expansion</p>
      </div>
      <span class="item-tag">Financial</span>
    </article>

    <!-- Year Separator -->
    <div class="year-separator">
      <div class="separator-line"></div>
      <span class="separator-diamond">◆</span>
      <div class="separator-line"></div>
    </div>

    <!-- Year 2025 -->
    <div class="year-label">2025</div>
    <div class="year-line"></div>

    <article class="press-item">
      <div class="item-date">Dec 2025</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Receives BSCI Compliance Excellence Recognition</h2>
        <p class="item-subtitle">Annual social compliance audit results in highest rating tier</p>
      </div>
      <span class="item-tag">Award</span>
    </article>

    <article class="press-item">
      <div class="item-date">Nov 2025</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Partners with European Textile Mill Network</h2>
        <p class="item-subtitle">New partnerships expand sustainable fabric sourcing options</p>
      </div>
      <span class="item-tag">Partnership</span>
    </article>

    <article class="press-item" style="border-bottom: none;">
      <div class="item-date">Oct 2025</div>
      <div class="item-content">
        <h2 class="item-title">SDF Clothing Hosts Industry Sourcing Summit in Dhaka</h2>
        <p class="item-subtitle">Brand owners and manufacturers discuss 2026 supply chain priorities</p>
      </div>
      <span class="item-tag">Event</span>
    </article>
  </div>
</BaseLayout>
