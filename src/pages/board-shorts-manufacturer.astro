---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Board Shorts Manufacturer | Custom Swimwear SDF";
const pageDescription = "Board shorts manufacturer in Bangladesh. Custom boardshorts, quick-dry swimwear from 300 pieces. Recycled polyester, nylon, UPF 50+ protection. Free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Board Shorts Manufacturer"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What fabrics do you use for board shorts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use recycled polyester for sustainability, nylon for durability, quick-dry microfiber for fast water release, and stretch woven fabrics for comfort. All fabrics available in 150-220 GSM range with UPF 50+ protection options for sun safety."
          }
        },
        {
          "@type": "Question",
          "name": "What features do you offer on board shorts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer side pockets with drain holes, mesh lining for support, velcro fly closures, adjustable waistbands with drawstrings, UPF 50+ sun protection, and reinforced stitching for durability. All features customizable per brand requirements."
          }
        },
        {
          "@type": "Question",
          "name": "What inseam lengths do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 16-inch inseam for above-knee fit, 18-inch inseam for standard board short length, and 20-inch inseam for longer coverage. Custom lengths available with pattern development. All lengths maintain consistent fit and proportion."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for board shorts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our board shorts minimum is 300 pieces per style. This applies to all fabric types, length options, and feature combinations. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer custom prints and sublimation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer full sublimation printing for all-over designs, custom prints for branding, and color blocking options. Sublimation printing provides vibrant, long-lasting colors that don't crack or fade. Custom artwork development available with design team support."
          }
        },
        {
          "@type": "Question",
          "name": "What is the UPF 50+ protection rating?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "UPF 50+ is the highest sun protection rating for fabrics, blocking 98% of UV radiation. Our UPF 50+ board shorts provide excellent sun protection for water sports and beach activities. UPF rating tested and certified for all sun protection fabrics."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Board Shorts Manufacturing Service",
      "description": "Custom board shorts manufacturing from 300 pieces including quick-dry swimwear, beach shorts with recycled polyester, nylon, microfiber fabrics and UPF 50+ protection",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Board Shorts Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Board Shorts Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "7",
              "maxPrice": "18"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Board Shorts from SDF Clothing",
      "description": "Step-by-step process for ordering custom board shorts from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your board shorts design, fabric specifications (recycled polyester, nylon, microfiber), size chart, target quantity, inseam length, and feature requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, sublimation printing, production, customization, and shipping for your board shorts order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review board shorts samples for fabric quick-dry performance, fit, UPF protection, and construction quality within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for board shorts including sublimation printing if required"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check including quick-dry testing and UPF verification before shipment with tracking documentation for your board shorts order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Board Shorts Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Board Shorts Manufacturer • Since 1998 • Swimwear Specialists</div>
        <h1 class="hero__title">Board Shorts Manufacturer • Custom Boardshorts and Quick-Dry Swimwear from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a board shorts manufacturer and full-service clothing manufacturer in Bangladesh producing custom boardshorts, beach shorts, and quick-dry swimwear from 300 pieces minimum. Recycled polyester, nylon, quick-dry microfiber, stretch woven fabrics with side pockets, mesh lining, velcro fly, adjustable waistband, and UPF 50+ protection available.
        </p>
        <div class="hero__ctas">
          <a href="/contact/" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20board-shorts-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">UPF</span>
          <span class="hero__stat-label">50+ Protection</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">🛡️</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">♻️</span>
          <span>GRS Recycled</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">⭐</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">🤝</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Board Shorts Fabric Selection</h2>
      </div>
      <div class="section__text">
        <p>Fabric selection determines board shorts performance, comfort, and durability in water environments. We offer multiple fabric options optimized for water sports and beach activities. All fabrics feature quick-dry properties and are available in 150-220 GSM range to suit different performance requirements and price points.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>GSM Range</th>
              <th>Quick-Dry</th>
              <th>Durability</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Recycled Polyester</td>
              <td>150-180 GSM</td>
              <td>Excellent</td>
              <td>High</td>
              <td>Sustainable brands, eco-conscious</td>
            </tr>
            <tr>
              <td>Nylon</td>
              <td>180-220 GSM</td>
              <td>Good</td>
              <td>Very High</td>
              <td>Performance, heavy use</td>
            </tr>
            <tr>
              <td>Quick-Dry Microfiber</td>
              <td>150-180 GSM</td>
              <td>Excellent</td>
              <td>Good</td>
              <td>Beach wear, casual swim</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Stretch Woven</td>
              <td>160-200 GSM</td>
              <td>Good</td>
              <td>Good</td>
              <td>Active movement, comfort</td>
            </tr>
          </tbody>
          <caption>All fabrics tested for chlorine and saltwater resistance. UPF 50+ protection available on all options.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Product Features</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Board Shorts Features and Construction</h2>
      </div>
      <div class="section__text">
        <p>Construction features define board shorts functionality and user experience in water environments. We offer multiple feature options to enhance performance, comfort, and durability. All construction methods follow industry best practices for swimwear manufacturing.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Description</th>
              <th>Benefit</th>
              <th>Best For</th>
              <th>Cost Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Side Pockets with Drain</td>
              <td>Pockets with mesh drain holes</td>
              <td>Water drainage, storage</td>
              <td>All board shorts</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Mesh Lining</td>
              <td>Internal mesh support</td>
              <td>Comfort, support</td>
              <td>Traditional board shorts</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Velcro Fly</td>
              <td>Hook and loop closure</td>
              <td>Secure fastening</td>
              <td>Performance board shorts</td>
              <td>Standard</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Adjustable Waistband</td>
              <td>Elastic with drawstring</td>
              <td>Custom fit</td>
              <td>All board shorts</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>UPF 50+ Protection</td>
              <td>Sun protection fabric</td>
              <td>UV blocking</td>
              <td>Beach and water sports</td>
              <td>+</td>
            </tr>
          </tbody>
          <caption>Features can be combined for enhanced functionality. Custom feature development available.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Inseam Lengths</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Board Shorts Length Options</h2>
      </div>
      <div class="section__text">
        <p>Inseam length significantly affects styling, comfort, and performance for different water activities. We offer three primary length options with custom specifications available. All lengths maintain consistent fit and proportional grading across size ranges.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Inseam</th>
              <th>Length</th>
              <th>Fit Style</th>
              <th>Target Activity</th>
              <th>Trend</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>16-inch</td>
              <td>Above knee</td>
              <td>Modern, athletic</td>
              <td>Swimming, active sports</td>
              <td>Current trend</td>
            </tr>
            <tr>
              <td>18-inch</td>
              <td>Standard</td>
              <td>Classic, versatile</td>
              <td>Surfing, general beach</td>
              <td>Classic</td>
            </tr>
            <tr>
              <td>20-inch</td>
              <td>Below knee</td>
              <td>Longer coverage</td>
              <td>Board sports, modesty</td>
              <td>Niche market</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Custom Length</td>
              <td>Any specification</td>
              <td>Brand-specific</td>
              <td>Brand-defined</td>
              <td>Custom</td>
            </tr>
          </tbody>
          <caption>Lengths measured from crotch to hem. Custom lengths available with pattern development.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Sun Protection</span>
        <div class="accent-line"></div>
        <h2 class="section__title">UPF 50+ Sun Protection</h2>
      </div>
      <div class="section__text">
        <p>UPF 50+ is the highest sun protection rating available for fabrics, blocking 98% of harmful UV radiation. Our board shorts with UPF 50+ protection provide excellent sun safety for extended water activities and beach exposure. Unlike sunscreen which requires reapplication, UPF protection is built into the fabric and remains effective throughout wear.</p>
        
        <p>UPF rating measures fabric's ability to block UV radiation from reaching the skin. A UPF 50+ rating means that less than 2% of UV rays penetrate the fabric, providing excellent protection against both UVA and UVB rays. This protection is particularly important for water sports where water reflection increases UV exposure and sunscreen may wash off. Our UPF 50+ board shorts are tested and certified to international standards for sun protection.</p>
        
        <p>Our UPF 50+ fabrics achieve sun protection through tightly woven construction and specialized fiber treatments. The fabric construction itself blocks UV rays, while additional treatments enhance protection without compromising breathability or quick-dry performance. UPF 50+ protection is available on all our fabric options including recycled polyester, nylon, and microfiber, allowing brands to offer sun protection across their entire board shorts range.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Price Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Board Shorts Price Range by Fabric</h2>
      </div>
      <div class="section__text">
        <p>Pricing varies by fabric type, construction complexity, printing requirements, and order quantity. FOB Bangladesh pricing for standard production runs. Custom sublimation printing, specialized features, and premium finishes are additional. Volume discounts available for orders exceeding 1,000 pieces.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>300-500 pcs</th>
              <th>500-1000 pcs</th>
              <th>1000-2000 pcs</th>
              <th>2000+ pcs</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Quick-Dry Microfiber</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-8</td>
              <td>$4-7</td>
            </tr>
            <tr>
              <td>Recycled Polyester</td>
              <td>$9-14</td>
              <td>$8-12</td>
              <td>$7-10</td>
              <td>$6-9</td>
            </tr>
            <tr>
              <td>Stretch Woven</td>
              <td>$10-16</td>
              <td>$9-14</td>
              <td>$8-12</td>
              <td>$7-11</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Nylon Performance</td>
              <td>$12-18</td>
              <td>$11-16</td>
              <td>$10-14</td>
              <td>$9-13</td>
            </tr>
          </tbody>
          <caption>FOB Bangladesh pricing. Includes fabric, cut, sew, basic branding. Sublimation printing additional $2-4/piece.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Sustainability</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Sustainable Board Shorts Manufacturing</h2>
      </div>
      <div class="section__text">
        <p>Sustainability is increasingly important in swimwear manufacturing due to the environmental impact of synthetic fabrics. Our recycled polyester board shorts are made from post-consumer plastic bottles, reducing waste and demand for virgin polyester. The recycled polyester maintains the same performance characteristics as virgin polyester while significantly reducing environmental footprint. GRS certification ensures the recycled content is verified throughout the supply chain.</p>
        
        <p>Beyond fabric selection, our sustainable manufacturing practices include water-efficient dyeing processes, reduced chemical usage through OEKO-TEX certification, and waste minimization in cutting and sewing operations. We work with suppliers who share our commitment to environmental responsibility, ensuring that sustainability extends throughout the entire production chain from raw materials to finished garments.</p>
        
        <p>Our bluesign-certified fabrics represent the highest standard in sustainable textile production, covering the entire supply chain from raw materials to finished garments. This certification ensures that all chemical processes meet strict environmental standards, reducing water consumption, minimizing emissions, and eliminating harmful substances from the production chain. Brands targeting environmentally conscious consumers can leverage our sustainable options to meet growing demand for eco-friendly swimwear.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Board Shorts Manufacturer FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What fabrics do you use for board shorts?</h3>
          <p class="faq__answer">We use recycled polyester for sustainability, nylon for durability, quick-dry microfiber for fast water release, and stretch woven fabrics for comfort. All fabrics available in 150-220 GSM range with UPF 50+ protection options for sun safety.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What features do you offer on board shorts?</h3>
          <p class="faq__answer">We offer side pockets with drain holes, mesh lining for support, velcro fly closures, adjustable waistbands with drawstrings, UPF 50+ sun protection, and reinforced stitching for durability. All features customizable per brand requirements.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What inseam lengths do you offer?</h3>
          <p class="faq__answer">We offer 16-inch inseam for above-knee fit, 18-inch inseam for standard board short length, and 20-inch inseam for longer coverage. Custom lengths available with pattern development. All lengths maintain consistent fit and proportion.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your minimum order for board shorts?</h3>
          <p class="faq__answer">Our board shorts minimum is 300 pieces per style. This applies to all fabric types, length options, and feature combinations. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you offer custom prints and sublimation?</h3>
          <p class="faq__answer">Yes. We offer full sublimation printing for all-over designs, custom prints for branding, and color blocking options. Sublimation printing provides vibrant, long-lasting colors that don't crack or fade. Custom artwork development available with design team support.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is the UPF 50+ protection rating?</h3>
          <p class="faq__answer">UPF 50+ is the highest sun protection rating for fabrics, blocking 98% of UV radiation. Our UPF 50+ board shorts provide excellent sun protection for water sports and beach activities. UPF rating tested and certified for all sun protection fabrics.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Order Custom Board Shorts?</h2>
      <p class="section__text">
        Contact SDF Clothing for custom board shorts manufacturing. We provide detailed quotes, production timelines, and sample development. Board shorts, beach shorts, and quick-dry swimwear available from 300 pieces minimum. Recycled polyester, nylon, quick-dry microfiber, stretch woven fabrics with UPF 50+ protection.
      </p>
      <div class="section__ctas">
        <a href="/contact/" class="section__cta section__cta--primary">Get Free Quote</a>
        <a href="/sampling-service" class="section__cta section__cta--secondary">Request Sample</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/swimwear-manufacturer" style="color: var(--color-primary);">swimwear manufacturer</a>, <a href="/bikini-manufacturer/" style="color: var(--color-primary);">bikini manufacturer</a>, <a href="/activewear-manufacturer" style="color: var(--color-primary);">activewear manufacturer</a>, <a href="/fabric-sourcing" style="color: var(--color-primary);">fabric sourcing</a>, <a href="/sampling-service" style="color: var(--color-primary);">sampling service</a>, <a href="/tools/price-calculator/" style="color: var(--color-primary);">price calculator</a>, <a href="/clothing-manufacturer-bangladesh" style="color: var(--color-primary);">clothing manufacturer Bangladesh</a>, <a href="/sustainable-clothing-manufacturer/" style="color: var(--color-primary);">sustainable clothing manufacturer</a>, <a href="/certifications" style="color: var(--color-primary);">certifications</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin: 0 var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__item a {
