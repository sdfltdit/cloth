---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Corporate Uniform Manufacturer | Workwear SDF";
const pageDescription = "Corporate uniform manufacturer in Bangladesh. Custom workwear, shirts, polos from 300 pieces. Embroidery, branding options. Free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
          "@id": "https://sdfltd.com/#website",
          "url": "https://sdfltd.com/",
          "name": "SDF Clothing",
          "publisher": {
