---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Fashion Manufacturers | SDF Clothing Complete Catalog";
const pageDescription = "Leading fashion manufacturers provide knit items, woven items, trims, and accessories. 300-piece MOQ, custom garment production since 1998. Get your quote today.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const companyAge = getCompanyAgeString();
