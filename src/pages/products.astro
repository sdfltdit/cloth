	<meta name="robots" content="index, follow" />
	
	<!-- Open Graph Tags -->
	<meta property="og:title" content="Fashion Manufacturers | SDF Clothing Complete Catalog" />
	<meta property="og:description" content="Leading fashion manufacturers provide knit items, woven items, trims, and accessories. 300-piece MOQ, custom garment production since 1998." />
	<meta property="og:image" content="https://sdfclothing.com/og-products.jpg" />
	<meta property="og:url" content="https://sdfclothing.com/products" />
	<meta property="og:type" content="website" />
	
	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="Fashion Manufacturers | SDF Clothing Complete Catalog" />
	<meta name="twitter:description" content="Leading fashion manufacturers provide knit items, woven items, trims, and accessories. 300-piece MOQ, custom garment production since 1998." />
