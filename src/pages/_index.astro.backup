---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';

export const prerender = true;

const foundedYear = 1998;
const yearsExp = new Date().getFullYear() - foundedYear;

const pageTitle = "Clothing Manufacturers in Bangladesh | SDF Clothing Since 1998";
const pageDescription = "SDF Clothing — certified clothing manufacturers in Bangladesh since 1998. Low MOQ 300 pcs, GOTS certified, OEM & private label apparel for EU, UK, USA, Australia brands. Get a free quote.";

const faqs = [
  {
    q: "What is your minimum order quantity for clothing manufacturing?",
    a: "Our MOQ is 300 pieces per style with flexible size and colour combinations — ideal for startup brands and boutique labels sourcing from Bangladesh clothing manufacturers."
  },
  {
    q: "How long does bulk clothing production take?",
    a: "Standard lead time is 30–45 days for bulk orders up to 50,000 pieces. Sample development takes 7–14 days. Use our free Lead Time Calculator for an exact estimate."
  },
  {
    q: "Do you offer private label and OEM clothing manufacturing?",
    a: "Yes. We offer full OEM, ODM, and private label clothing manufacturing — custom woven labels, hang tags, branded packaging, and poly bags included at no extra charge."
  },
  {
    q: "What garment types do you manufacture?",
    a: "We manufacture woven (denim, twill, poplin, oxford) and knitwear (jersey, fleece, rib, interlock). Custom GSM matched to your tech pack. Sustainable options include GOTS organic cotton and GRS recycled polyester."
  },
  {
    q: "What printing and embroidery options are available?",
    a: "In-house embroidery up to 15 colours, screen print, DTF, heat transfer, and sublimation. Trim options include woven labels, hang tags, branded zippers, and custom buttons — all done in-house."
  },
  {
    q: "How does FOB pricing work with your garments factory?",
    a: "All quotes are FOB Chittagong or Dhaka — covering fabric, dyeing, finishing, cut & sew, AQL 2.5 inspection, and port delivery. No hidden charges. Use our Price Calculator for an instant estimate."
  },
  {
    q: "Do you supply clothing manufacturers for EU, UK, USA and Australia?",
    a: "Yes. SDF supplies fashion brands across the EU, UK, USA, Australia, and Canada. EU exports benefit from GSP duty-free terms. We meet UK Modern Slavery Act, US customs, and EU EPR requirements."
  },
  {
    q: "What are your payment terms?",
    a: "We accept T/T, L/C, and bank transfers. 30% deposit to start production, 70% before shipment. Free samples available for confirmed bulk orders."
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>

<!-- ===== SCHEMA ===== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization","LocalBusiness"],
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "alternateName": ["SDF Clothing Ltd", "SDF Garments"],
      "url": "https://sdfltd.com",
      "logo": "https://sdfltd.com/logo.webp",
      "image": "https://sdfltd.com/factory.webp",
      "foundingDate": "1998",
      "description": "Certified clothing manufacturers in Bangladesh since 1998. OEM, private label and custom apparel manufacturing for global fashion brands. Low MOQ 300 pieces.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House 125, Road 01, Baridhara DOHS",
        "addressLocality": "Dhaka",
        "postalCode": "1212",
        "addressCountry": "BD"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "23.8103",
        "longitude": "90.4125"
      },
      "sameAs": [
        "https://share.google/x3iXFv3LzlsUj8jYR",
        "https://share.google/mCmuWaJDOKUtSV9rp",
        "https://maps.app.goo.gl/8NjQzUU1HeFWjLWu7",
        "https://linkedin.com/company/sdfclothing",
        "https://twitter.com/sdfclothing"
      ],
      "openingHours": "Mo-Fr 09:00-18:00",
      "priceRange": "$$",
      "paymentAccepted": ["Bank Transfer", "L/C", "T/T"],
      "currenciesAccepted": "USD",
      "areaServed": ["EU","UK","US","AU","CA","Worldwide"],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": "200",
        "bestRating": "5"
      }
    },
    {
      "@type": "Service",
      "name": "Clothing Manufacturing Bangladesh",
      "provider": { "@id": "https://sdfltd.com/#org" },
      "serviceType": "Apparel Manufacturing",
      "areaServed": ["EU","UK","US","AU","CA"],
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "USD",
        "description": "FOB clothing manufacturing from 300 pieces MOQ"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What is your minimum order quantity for clothing manufacturing?","acceptedAnswer":{"@type":"Answer","text":"Our MOQ is 300 pieces per style with flexible size and colour combinations — ideal for startup brands and boutique labels."}},
        {"@type":"Question","name":"How long does bulk clothing production take?","acceptedAnswer":{"@type":"Answer","text":"Standard lead time is 30–45 days for bulk orders up to 50,000 pieces. Sample development takes 7–14 days."}},
        {"@type":"Question","name":"Do you offer private label and OEM clothing manufacturing?","acceptedAnswer":{"@type":"Answer","text":"Yes. Full OEM, ODM, and private label clothing manufacturing with custom labels, hang tags, and branded packaging."}},
        {"@type":"Question","name":"Do you supply clothing manufacturers for EU, UK, USA and Australia?","acceptedAnswer":{"@type":"Answer","text":"Yes. SDF supplies fashion brands across the EU, UK, USA, Australia, and Canada. EU exports benefit from GSP duty-free terms."}}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Home","item":"https://sdfltd.com/"}
      ]
    }
  ]
}
</script>

<!-- ===== HERO ===== -->
<HeroSection yearsExp={yearsExp} />

<!-- ===== MARKETS ===== -->
<section style="padding:2.5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <p style="font-size:0.62rem;letter-spacing:0.3em;text-transform:uppercase;color:#888;text-align:center;margin-bottom:1.5rem;">Supplying certified clothing manufacturers to</p>
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:#1a1a1a;">
      <a href="/clothing-manufacturer-europe" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">EU</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">European Union</div>
        <div style="font-size:0.65rem;color:#666;">GSP duty-free</div>
      </a>
      <a href="/clothing-manufacturer-uk" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">UK</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">United Kingdom</div>
        <div style="font-size:0.65rem;color:#666;">UK GSP terms</div>
      </a>
      <a href="/clothing-manufacturer-usa" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">USA</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">United States</div>
        <div style="font-size:0.65rem;color:#666;">US customs ready</div>
      </a>
      <a href="/clothing-manufacturer-australia" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">AU</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">Australia</div>
        <div style="font-size:0.65rem;color:#666;">AANZFTA duty</div>
      </a>
      <a href="/clothing-manufacturer-canada" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">CA</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">Canada</div>
        <div style="font-size:0.65rem;color:#666;">MFN rates</div>
      </a>
      <a href="/clothing-manufacturers" style="background:#000;padding:1.5rem;text-align:center;text-decoration:none;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:1.5rem;margin-bottom:0.4rem;">+</div>
        <div style="font-size:0.72rem;color:#fff;font-weight:500;margin-bottom:0.2rem;">32+ Countries</div>
        <div style="font-size:0.65rem;color:#666;">FOB global</div>
      </a>
    </div>
  </div>
</section>

<!-- ===== ABOUT ===== -->
<section id="about" style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Trusted Since 1998</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Why Global Brands Choose SDF<br>as Their Apparel Manufacturer</h2>
      <p style="color:#ccc;max-width:560px;line-height:1.8;font-size:0.95rem;">From tech pack to FOB delivery — complete clothing manufacturing under one roof in Dhaka.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#1a1a1a;">
      <div style="background:#000;padding:2.5rem;">
        <p style="color:#ccc;line-height:1.9;font-size:0.92rem;margin-bottom:1rem;">SDF Clothing manufactures premium apparel for fashion brands, retailers, and startups across the EU, UK, USA, and Australia. Our <a href="/garments-factory" style="color:#fff;border-bottom:1px solid #cc0000;text-decoration:none;">garments factory</a> in Baridhara DOHS, Dhaka has operated since 1998 with a focus on quality and ethical standards.</p>
        <p style="color:#ccc;line-height:1.9;font-size:0.92rem;margin-bottom:1rem;">As full-package <a href="/clothing-manufacturers" style="color:#fff;border-bottom:1px solid #cc0000;text-decoration:none;">clothing manufacturers</a>, we handle the complete supply chain: fabric sourcing, dyeing, finishing, cut &amp; sew, embroidery, screen printing, AQL inspection, and FOB delivery.</p>
        <p style="color:#ccc;line-height:1.9;font-size:0.92rem;">We hold 13 international certifications including GOTS and OEKO-TEX. Our <a href="/certifications" style="color:#fff;border-bottom:1px solid #cc0000;text-decoration:none;">full certification list</a> is available online.</p>
      </div>
      <div style="background:#000;padding:2.5rem;display:grid;grid-template-columns:1fr 1fr;gap:1px;background-color:#1a1a1a;">
        <div style="background:#000;padding:1.5rem;text-align:center;">
          <div style="font-size:2rem;font-weight:200;color:#cc0000;margin-bottom:0.25rem;">{yearsExp}+</div>
          <div style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;">Years Exporting</div>
        </div>
        <div style="background:#000;padding:1.5rem;text-align:center;">
          <div style="font-size:2rem;font-weight:200;color:#cc0000;margin-bottom:0.25rem;">300</div>
          <div style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;">Pieces MOQ</div>
        </div>
        <div style="background:#000;padding:1.5rem;text-align:center;">
          <div style="font-size:2rem;font-weight:200;color:#cc0000;margin-bottom:0.25rem;">50K</div>
          <div style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;">Pcs / 45 Days</div>
        </div>
        <div style="background:#000;padding:1.5rem;text-align:center;">
          <div style="font-size:2rem;font-weight:200;color:#cc0000;margin-bottom:0.25rem;">13</div>
          <div style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;">Certifications</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== INDUSTRY STATS ===== -->
<section style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Bangladesh Garment Industry</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Why Source from Bangladesh</h2>
      <p style="color:#ccc;max-width:560px;line-height:1.8;font-size:0.95rem;">The world's second-largest garment exporter with established infrastructure and competitive advantages.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1a1a1a;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">$47B</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Annual Exports</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">500+</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Factories</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">4M</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Workers</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">30-40%</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Cost Advantage</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== TRUST SIGNALS ===== -->
<section style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Proven Track Record</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Trusted by 200+ Global Brands</h2>
      <p style="color:#ccc;max-width:560px;line-height:1.8;font-size:0.95rem;">Quantified trust through consistent performance and quality.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#1a1a1a;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">200+</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Global Brands Served</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">98%</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">On-Time Delivery</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2.2rem;font-weight:200;color:#cc0000;margin-bottom:0.5rem;">AQL 2.5</div>
        <div style="font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;">Inspection Standard</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== PRODUCTS ===== -->
<section id="products" style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">What We Manufacture</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Clothing Manufacturing Categories</h2>
      <p style="color:#ccc;max-width:560px;line-height:1.8;font-size:0.95rem;">Knit, woven, denim, outerwear, accessories — all from one certified Bangladesh garments factory.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1a1a1a;margin-bottom:1px;">
      <a href="/t-shirt-manufacturer" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Knitwear</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">T-Shirt Manufacturer</div>
        <div style="font-size:0.78rem;color:#888;">Jersey, piqué, interlock</div>
      </a>
      <a href="/hoodie-manufacturer" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Fleecewear</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Hoodie Manufacturer</div>
        <div style="font-size:0.78rem;color:#888;">Fleece, French terry</div>
      </a>
      <a href="/apparel-manufacturers" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Woven</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Apparel Manufacturers</div>
        <div style="font-size:0.78rem;color:#888;">Shirts, trousers, jackets</div>
      </a>
      <a href="/fashion-manufacturers" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Fashion</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Fashion Manufacturers</div>
        <div style="font-size:0.78rem;color:#888;">Dresses, co-ords, sets</div>
      </a>
      <a href="/textile-manufacturers" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Textile</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Textile Manufacturers</div>
        <div style="font-size:0.78rem;color:#888;">Fabric & raw materials</div>
      </a>
      <a href="/garments-manufacturers" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Garments</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Garments Manufacturers</div>
        <div style="font-size:0.78rem;color:#888;">Full CMT & package</div>
      </a>
      <a href="/clothing-manufacturers" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Private Label</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">Clothing Manufacturers</div>
        <div style="font-size:0.78rem;color:#888;">OEM & ODM</div>
      </a>
      <a href="/products" class="snake-card" style="padding:2rem;display:block;text-decoration:none;text-align:center;border:1px solid #cc0000!important;">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">All Categories</div>
        <div style="font-size:0.92rem;color:#fff;font-weight:500;margin-bottom:0.4rem;">View All 30+</div>
        <div style="font-size:0.78rem;color:#888;">Full product range →</div>
      </a>
    </div>
  </div>
</section>

<!-- ===== TESTIMONIALS ===== -->
<section id="testimonials" style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Verified Reviews</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">What Brands Say About Our Clothing Manufacturing</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#1a1a1a;">
      <div style="background:#000;padding:2rem;">
        <div style="color:#cc0000;font-size:0.75rem;letter-spacing:0.2em;margin-bottom:1rem;">★★★★★</div>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.8;margin-bottom:1.25rem;">"SDF delivered 3,000 units of our organic cotton hoodie line on time, within budget, with perfect AQL inspection. Our EU compliance audit passed first time."</p>
        <div style="font-size:0.75rem;color:#fff;letter-spacing:0.08em;">Activewear Brand — Netherlands</div>
      </div>
      <div style="background:#000;padding:2rem;">
        <div style="color:#cc0000;font-size:0.75rem;letter-spacing:0.2em;margin-bottom:1rem;">★★★★★</div>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.8;margin-bottom:1.25rem;">"Tech pack to final shipment in 38 days. Fabric and finishing quality exceeded what our previous garments manufacturer delivered at 40% higher cost."</p>
        <div style="font-size:0.75rem;color:#fff;letter-spacing:0.08em;">Private Label Brand — United Kingdom</div>
      </div>
      <div style="background:#000;padding:2rem;">
        <div style="color:#cc0000;font-size:0.75rem;letter-spacing:0.2em;margin-bottom:1rem;">★★★★★</div>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.8;margin-bottom:1.25rem;">"MOQ of 300 pieces worked perfectly for our startup. Knitwear quality was excellent. Embroidery and screen print matched our brand guidelines exactly."</p>
        <div style="font-size:0.75rem;color:#fff;letter-spacing:0.08em;">Streetwear Label — United States</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== PROCESS ===== -->
<section id="process" style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">How It Works</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Our Clothing Manufacturing Process</h2>
    </div>
