<!-- ===== FAQ ===== -->
<section id="faq" style="padding:5rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;">

      <!-- FAQ Left -->
      <div>
        <div class="section-header" style="margin-bottom:2.5rem;">
          <span class="section-label">Common Questions</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Clothing Manufacturing FAQs</h2>
        </div>
        <div id="faq-list">
          {faqs.map((faq, i) => (
            <div class="faq-item" style="border-bottom:1px solid #1a1a1a;">
              <button
                id={`faq-question-${i}`}
                aria-expanded="false"
                aria-controls={`faq-answer-${i}`}
                class="faq-question"
                style="width:100%;background:none;border:none;color:#fff;text-align:left;cursor:pointer;padding:1.25rem 0;display:flex;justify-content:space-between;align-items:center;font-size:0.9rem;font-weight:500;transition:color 0.2s;min-height:44px;gap:1rem;font-family:inherit;"
              >
                <span>{faq.q}</span>
                <span id={`faq-icon-${i}`} style="flex-shrink:0;font-size:1.2rem;line-height:1;transition:transform 0.3s;color:#cc0000;">+</span>
              </button>
              <div
                id={`faq-answer-${i}`}
                role="region"
                aria-labelledby={`faq-question-${i}`}
                style="display:none;padding-bottom:1.25rem;"
              >
                <p style="color:#ccc;font-size:0.87rem;line-height:1.8;">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ Right — Fabric Weight / GSM Tool -->
      <div style="position:sticky;top:80px;">
        <div style="border:1px solid #1a1a1a;padding:2rem;">
          <p style="font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Free Tool</p>
          <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.5rem;">Fabric GSM Calculator</h3>
          <p style="font-size:0.8rem;color:#888;line-height:1.6;margin-bottom:1.5rem;">Convert fabric weight, calculate GSM for your garment, or check if your spec is correct.</p>

          <div style="margin-bottom:1rem;">
            <label style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Fabric Type</label>
            <select id="gsm-type" style="background:#000;color:#fff;border:1px solid #1a1a1a;padding:0.6rem 0.75rem;font-size:0.85rem;width:100%;font-family:inherit;">
              <option value="">Select fabric type</option>
              <option value="jersey">Jersey (T-shirt)</option>
              <option value="fleece">Fleece (Hoodie)</option>
              <option value="denim">Denim (Jeans)</option>
              <option value="poplin">Poplin (Shirt)</option>
              <option value="twill">Twill (Trouser)</option>
              <option value="oxford">Oxford (Shirt)</option>
              <option value="rib">Rib (Collar/Cuff)</option>
              <option value="interlock">Interlock (Polo)</option>
            </select>
          </div>

          <div style="margin-bottom:1rem;">
            <label style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">GSM Value</label>
            <input id="gsm-value" type="number" placeholder="e.g. 180" min="60" max="600" style="background:#000;color:#fff;border:1px solid #1a1a1a;padding:0.6rem 0.75rem;font-size:0.85rem;width:100%;" />
          </div>

          <button id="gsm-calc-btn" style="background:#cc0000;color:#fff;border:none;padding:0.7rem 1.5rem;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;transition:background 0.2s;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#cc0000'">
            Check GSM
          </button>

          <div id="gsm-result" style="margin-top:1.25rem;display:none;">
            <div style="border-top:1px solid #1a1a1a;padding-top:1.25rem;">
              <div id="gsm-output" style="font-size:0.85rem;color:#fff;line-height:1.9;"></div>
            </div>
          </div>

          <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid #1a1a1a;text-align:center;">
            <a href="https://wa.me/16465356343?text=Hi%20SDF%20Clothing%2C%20I%20need%20help%20with%20fabric%20GSM%20for%20my%20order" target="_blank" rel="noopener noreferrer" style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#cc0000;text-decoration:none;border-bottom:1px solid #cc0000;padding-bottom:2px;">Ask Our Technical Team on WhatsApp →</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

