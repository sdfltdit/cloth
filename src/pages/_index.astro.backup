<!-- ===== FAQ ACCORDION SCRIPT ===== -->
<script>
document.querySelectorAll('.faq-question').forEach(button => {
  button.addEventListener('click', () => {
    const answerId = button.getAttribute('aria-controls');
    const answer = document.getElementById(answerId);
    const icon = document.getElementById(button.id.replace('question', 'icon'));
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    
    button.setAttribute('aria-expanded', !isExpanded);
    answer.style.display = isExpanded ? 'none' : 'block';
    icon.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(45deg)';
  });
});
</script>

<!-- ===== GSM CALCULATOR SCRIPT ===== -->
<script>
const gsmData = {
  jersey:    { min:120, max:220, typical:160, use:"T-shirts, basic tops, polos", note:"Below 140gsm = lightweight summer. 160–180gsm = standard. 200g+ = heavyweight premium." },
  fleece:    { min:200, max:450, typical:320, use:"Hoodies, sweatshirts, joggers", note:"280gsm = mid-weight pullover. 320–380gsm = premium hoodie. 400g+ = heavy winter." },
  denim:     { min:180, max:420, typical:300, use:"Jeans, jackets, shorts", note:"7oz (230g) = summer denim. 10oz (330g) = standard. 12oz+ = rigid heavyweight denim." },
  poplin:    { min:90,  max:140, typical:110, use:"Dress shirts, blouses", note:"100–110gsm = standard shirt. Lightweight, smooth finish, breathable." },
  twill:     { min:150, max:280, typical:200, use:"Chinos, trousers, work pants", note:"180–220gsm = standard trouser weight. Good drape and durability." },
  oxford:    { min:120, max:200, typical:150, use:"Oxford shirts, casual tops", note:"140–160gsm = standard oxford weave. Slightly heavier than poplin." },
  rib:       { min:150, max:280, typical:200, use:"Collar bands, cuffs, waistbands", note:"Used as trim component. 180–220gsm standard for neckband/cuff." },
  interlock: { min:160, max:260, typical:200, use:"Polo shirts, baby wear, activewear", note:"Double-knit structure. 180–220gsm = standard polo. Smooth on both sides." },
};

document.getElementById('gsm-calc-btn').addEventListener('click', function() {
  const type = document.getElementById('gsm-type').value;
  const val  = parseInt(document.getElementById('gsm-value').value);
  const res  = document.getElementById('gsm-result');
  const out  = document.getElementById('gsm-output');

  if (!type) { alert('Please select a fabric type.'); return; }
  if (!val || val < 60 || val > 600) { alert('Please enter a valid GSM between 60 and 600.'); return; }

  const d = gsmData[type];
  let rating = '';
  if (val < d.min) rating = '<span style="color:#cc0000;">Below typical range — may be too sheer/weak for bulk production.</span>';
  else if (val > d.max) rating = '<span style="color:#cc0000;">Above typical range — fabric will be heavy/stiff for this category.</span>';
  else if (Math.abs(val - d.typical) <= 20) rating = '<span style="color:#fff;">Within ideal range for ' + type + ' production.</span>';
  else rating = '<span style="color:#ccc;">Acceptable range — workable for this fabric type.</span>';

  out.innerHTML = `
    <p style="margin-bottom:0.5rem;"><strong style="color:#fff;">Your GSM: ${val}</strong> — ${rating}</p>
    <p style="color:#888;font-size:0.8rem;margin-bottom:0.4rem;">Typical range: <span style="color:#fff;">${d.min}–${d.max}gsm</span> (standard: ${d.typical}gsm)</p>
    <p style="color:#888;font-size:0.8rem;margin-bottom:0.4rem;">Used for: <span style="color:#fff;">${d.use}</span></p>
    <p style="color:#888;font-size:0.78rem;line-height:1.6;">${d.note}</p>
  `;
  res.style.display = 'block';
});
</script>

