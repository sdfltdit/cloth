---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Dye House Service Bangladesh | Fabric & Yarn Dyeing Facility";
const pageDescription = "Professional dye house service from Bangladesh. Fabric dyeing, yarn dyeing, garment dyeing facility. Reactive, disperse, vat dyeing. GOTS certified. Free quote.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Dye House Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/dye-house-service/"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://sdfltd.com/dye-house-service/",
    "name": "Dye House Service",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Dye House Service"
        }
      ]
    }
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="dye house service Bangladesh, dyeing facility Bangladesh, commercial dye house, contract dye house, fabric dyeing facility, yarn dyeing facility" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Dye House Service
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Dye House Service | Since 1998 | GOTS & OEKO-TEX Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Dye House Service for Fabric, Yarn, and Garment Dyeing
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Commercial-scale dye house operations for fabric mills, wholesalers, and garment manufacturers. Our dyeing facility processes 50,000-80,000 kg of fabric daily with reactive, disperse, vat, and sulphur dyeing capabilities. Contract dyeing, bulk dyeing, and specialty dyeing for B2B buyers who need professional dyeing as a standalone service.
