---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Knitting Service Bangladesh | Knit Fabric Production for ...";
const pageDescription = "Professional knitting service from Bangladesh — circular knit, flat knit, jersey, fleece, terry, pique and rib, from 100kg minimum. OEKO-TEX certified.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Knitting Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/knitting-service/"
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="knitting service Bangladesh, knitting factory Bangladesh, circular knitting service, flat knitting service, jersey knitting, fleece knitting, terry knitting, pique knitting, rib knitting, GOTS knit fabric, OEKO-TEX knit fabric, custom knit fabric" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Knitting Service
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Knitting Service | Since 1998 | GOTS & OEKO-TEX Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Knitting Service for Fashion Brands and Fabric Mills
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Knitting is how soft, stretchy fabric is made from yarn. T-shirts, hoodies, joggers, polos, and activewear are all knit fabrics. SDF Clothing, a full-service clothing manufacturer, produces a complete range of knit fabrics from your yarn or our sourced yarn | delivered directly to your garment factory or ready for our own production line.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20knitting-service`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">100kg</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Minimum Order</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">GOTS</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Organic Certified</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">OEKO-TEX</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Chemical Safe</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">CMT</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Yarn Accepted</div>
      </div>
    </div>
  </div>
</section>

<!-- What Is Knitting Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Process Overview</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">What Is Knitting in Garment Manufacturing?</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Knitting is the process of forming fabric by interlocking loops of yarn. This is different from weaving, which interlaces yarns at right angles. Knit fabrics stretch in multiple directions, drape softly, and are comfortable against skin | perfect for casualwear and activewear.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      There are two main types of knitting in industrial production: circular knitting and flat knitting. Each produces different fabric types suited to different garments.
    </p>
  </div>
</section>

<!-- Knit Fabric Types Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Fabric Categories</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Knit Fabric Types We Produce</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Circular Knit Fabrics</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Most casual wear and activewear fabrics are circular knit:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Single jersey 140-220 GSM for t-shirts and basics
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        French terry 240-380 GSM for hoodies and sweatshirts
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fleece 300-400 GSM for warm winter garments
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pique 180-240 GSM for polo shirts
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Interlock 180-220 GSM for premium tees
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Mesh and eyelet 100-160 GSM for activewear
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pointelle and openwork patterns for fashion tops
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Flat Knit Fabrics</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Used for sweaters, cardigans, and structured knit garments:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Plain knit (single jersey flat) for basic sweaters
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Rib knit 1x1, 2x2, 2x1 for cuffs, collars, and ribbed sweaters
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cable knit for traditional sweater patterns
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fully fashioned panels with shaped edges
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Specialty Knit Fabrics</h3>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Performance knits with spandex (4-12% blend)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Brushed back fleece for soft inside handle
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Loop terry for towelling and beach wear
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Compression fabrics for athletic wear
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Anti-bacterial knits for activewear
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        UV-protective knits for outdoor apparel
      </li>
    </ul>
  </div>
</section>

<!-- Knit Fabric Specifications Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Technical Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Knit Fabric Specifications We Handle</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">GSM (Grams per Square Meter)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      GSM measures fabric weight. Lighter GSM means thinner, more drapey fabric. Higher GSM means heavier, warmer fabric.
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        100-140 GSM: very lightweight, summer tees
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        140-180 GSM: standard tee weight
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        180-220 GSM: premium tee weight
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        220-280 GSM: lightweight sweatshirts
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        280-380 GSM: standard hoodies and joggers
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        380-450 GSM: heavy hoodies and winter sweaters
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Yarn Count and Composition</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      We knit fabric from any yarn count and composition. Most common combinations:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        30s combed cotton single jersey for premium tees
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        24s carded cotton for budget tees
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        30s cotton with 5% spandex for stretch tees
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        30s cotton french terry for hoodies
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Polyester or recycled polyester blends for activewear
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Fabric Width</h3>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Open width: typically 60-72 inches (152-183 cm)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Tubular width: typically 30-40 inches (76-102 cm) doubled when laid flat
      </li>
    </ul>
  </div>
</section>

<!-- Knitting Process Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">How It Works</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Our Knitting Process</h2>
    </div>
    
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 1</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Specifications</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You tell us GSM, yarn count, composition, fabric type, color, and quantity. We confirm specifications and quote pricing.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 2</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Yarn input</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You can supply your own yarn (CMT-style knitting) or we source yarn for you through our yarn sourcing service. Either way, yarn is first checked for quality and color match before knitting.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 3</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Knitting production</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Yarn is loaded onto circular or flat knitting machines. Single jersey takes 4-6 hours per batch on circular machines. Heavier fabrics like french terry or fleece take longer.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 4</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Greige fabric inspection</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Before dyeing, we inspect the greige (undyed) fabric for knitting defects, GSM accuracy, and width consistency.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 5</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Dyeing and finishing</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">After approval, fabric goes to our dyeing service for color application and finishing. Or you can take greige fabric to your own dyeing facility.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 6</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Final inspection and delivery</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Finished fabric is inspected for color match, GSM, shrinkage, and visual defects before delivery to your garment factory.</p>
      </div>
    </div>
  </div>
</section>

<!-- Knitting MOQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Order Requirements</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Knitting MOQ | Minimum Order Quantities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our knitting service has flexible minimums.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Stock fabric construction with standard yarn: 100 kg minimum per construction.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Custom GSM or yarn count: 200-500 kg minimum.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Custom-developed fabric construction: 500-1,000 kg minimum. Includes development time of 10-15 days.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      For very small orders below 100 kg, we can sometimes consolidate with other production runs of the same construction. Contact us with your specific needs.
    </p>
  </div>
</section>

<!-- Knitting Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Knitting Pricing in Bangladesh</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Knitting service is priced per kilogram of yarn processed. Pricing depends on fabric construction, GSM, and finishing requirements.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Typical FOB Bangladesh knitting service prices per kilogram (yarn supplied by buyer):
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Single jersey simple constructions: $0.40-0.70 per kg knitting cost
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
