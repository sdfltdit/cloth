---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "404 — Production Line Unavailable | SDF Clothing";
const pageDescription = "The production line you're looking for is currently unavailable. Our manufacturing facility is operating at full capacity for existing buyers.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "404 — Production Line Unavailable",
		"description": "The production line you're looking for is currently unavailable. Our manufacturing facility is operating at full capacity for existing buyers.",
		"url": "https://sdfclothing.com/404",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://sdfclothing.com/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "404 - Production Line Unavailable"
				}
			]
		}
	}
	</script>

	<!-- Main 404 Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl text-center">
			<h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
				This Line Is Currently Unavailable
			</h1>
			<div class="text-2xl md:text-3xl font-bold text-[#e00] mb-8">
				Error 404
			</div>
			<p class="text-lg text-white/80 leading-relaxed mb-12 max-w-2xl mx-auto">
				The order you're trying to place can't be processed here — our machinery at this station is undergoing maintenance. 
				However, our production lines are running at full capacity for existing buyers. We apologize for the inconvenience.
			</p>
			
			<!-- Action Buttons -->
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
				<a 
					href="/" 
					class="bg-[#e00] text-white px-8 py-4  text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
				>
					Return to Homepage
				</a>
				<a 
					href="/contact" 
					class="border border-[#e00] text-[#e00] px-8 py-4  text-lg font-semibold hover:bg-[#e00] hover:text-white transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
				>
					Contact Us Directly
				</a>
			</div>
		</div>
	</section>

	<!-- While You're Here Section -->
	<section class="py-20 px-4 bg-black">
		<div class="container mx-auto max-w-6xl">
			<h2 class="text-3xl md:text-4xl font-bold text-white mb-12 text-center">While You're Here</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<!-- Card 1: Manufacturing Capabilities -->
				<div class="p-8 bg-black border border-neutral-900  hover:border-[#e00] transition-colors duration-300 text-center">
					<div class="text-4xl mb-4">🏭</div>
					<h3 class="text-xl font-semibold text-white mb-4">Our Manufacturing Capabilities</h3>
					<p class="text-white/80 mb-6">
						Explore 30+ clothing categories we produce with precision and quality standards.
					</p>
					<a 
						href="/products" 
						class="inline-block text-[#e00] font-semibold hover:text-[#e00] transition-colors"
					>
						View All Categories →
					</a>
				</div>

				<!-- Card 2: Journal Entry -->
				<div class="p-8 bg-black border border-neutral-900  hover:border-[#e00] transition-colors duration-300 text-center">
					<div class="text-4xl mb-4">📖</div>
					<h3 class="text-xl font-semibold text-white mb-4">Journal Entry</h3>
					<p class="text-white/80 mb-6">
						Industry insights and manufacturing guides from our expert team.
					</p>
					<a 
						href="/" 
						class="inline-block text-[#e00] font-semibold hover:text-[#e00] transition-colors"
					>
						Read Latest Insights →
					</a>
				</div>

				<!-- Card 3: EU Compliance 2026 -->
				<div class="p-8 bg-black border border-neutral-900  hover:border-[#e00] transition-colors duration-300 text-center">
					<div class="text-4xl mb-4">✅</div>
					<h3 class="text-xl font-semibold text-white mb-4">EU Compliance 2026</h3>
					<p class="text-white/80 mb-6">
						Is your supply chain ready for EU regulations? We're fully compliant.
					</p>
					<a 
						href="/tools/eu-readiness-checker" 
						class="inline-block text-[#e00] font-semibold hover:text-[#e00] transition-colors"
					>
						Learn About Compliance →
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Additional Help Section -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl text-center">
			<div class="p-8 border border-neutral-900 ">
				<h3 class="text-2xl font-bold text-white mb-4">Need Assistance?</h3>
				<p class="text-white/80 mb-6">
					Our team is here to help you find exactly what you're looking for. 
					Reach out to us directly for personalized assistance with your manufacturing needs.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a 
						href="/contact" 
						class="border border-neutral-800 text-white px-6 py-3  font-semibold hover:border-[#e00] hover:text-[#e00] transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
					>
						Contact Us
					</a>
					<a 
						href="tel:+8801911733226" 
						class="border border-neutral-800 text-white px-6 py-3  font-semibold hover:border-[#e00] hover:text-[#e00] transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center"
					>
						+880 1911733226
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
