---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "404 — Production Line Unavailable | SDF Clothing";
const pageDescription = "The production line you're looking for is currently unavailable. Our manufacturing facility is operating at full capacity for existing buyers.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "404 — Production Line Unavailable",
		"description": "The production line you're looking for is currently unavailable. Our manufacturing facility is operating at full capacity for existing buyers.",
		"url": "https://sdfclothing.com/404",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://sdfclothing.com/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "404 - Production Line Unavailable"
				}
			]
		}
	}
	</script>

	<!-- Textile Background Animations -->
	<div class="textile-bg" aria-hidden="true">
		<div class="stitch s1"></div>
		<div class="stitch s2"></div>
		<div class="stitch s3"></div>
		<div class="stitch s4"></div>
		<div class="warp w1"></div>
		<div class="warp w2"></div>
		<div class="warp w3"></div>
		<div class="warp w4"></div>
		<div class="warp w5"></div>
		<div class="thread t1"></div>
		<div class="thread t2"></div>
		<div class="thread t3"></div>
		<svg class="bobbin" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
			<circle cx="26" cy="26" r="24" stroke="#00c96b" stroke-width="1.5"/>
			<circle cx="26" cy="26" r="14" stroke="#00c96b" stroke-width="1"/>
			<circle cx="26" cy="26" r="4" stroke="#00c96b" stroke-width="1"/>
			<line x1="26" y1="2" x2="26" y2="12" stroke="#00c96b" stroke-width="1"/>
			<line x1="26" y1="40" x2="26" y2="50" stroke="#00c96b" stroke-width="1"/>
			<line x1="2" y1="26" x2="12" y2="26" stroke="#00c96b" stroke-width="1"/>
			<line x1="40" y1="26" x2="50" y2="26" stroke="#00c96b" stroke-width="1"/>
		</svg>
		<div class="weave-dot" style="top:22%;left:8%;animation-delay:0s;animation-duration:4s"></div>
		<div class="weave-dot" style="top:22%;left:16%;animation-delay:.8s;animation-duration:5s"></div>
		<div class="weave-dot" style="top:22%;left:24%;animation-delay:.4s;animation-duration:4.5s"></div>
		<div class="weave-dot" style="top:40%;left:8%;animation-delay:1.2s;animation-duration:5s"></div>
		<div class="weave-dot" style="top:40%;left:16%;animation-delay:.2s;animation-duration:4s"></div>
		<div class="weave-dot" style="top:40%;left:24%;animation-delay:1s;animation-duration:6s"></div>
		<div class="weave-dot" style="top:22%;right:8%;animation-delay:.6s;animation-duration:5s"></div>
		<div class="weave-dot" style="top:22%;right:16%;animation-delay:1.4s;animation-duration:4s"></div>
		<div class="weave-dot" style="top:40%;right:8%;animation-delay:.3s;animation-duration:4.5s"></div>
		<div class="weave-dot" style="top:40%;right:16%;animation-delay:.9s;animation-duration:6s"></div>
	</div>

	<!-- Hero Section -->
	<section class="hero-section">
		<div class="scanline" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="status-badge">
				<span class="status-dot"></span>
				LINE STOPPED — ERROR 404
			</div>
			<div class="four-oh-four" aria-hidden="true">
				<span>4</span><span class="zero">0</span><span>4</span>
				<div class="caution-tape">
					<div class="tape-inner">
						PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp;
					</div>
				</div>
			</div>
			<h1 class="hero-heading">This Line Is Currently Unavailable</h1>
			<p class="hero-body">
				The order you're looking for can't be processed here — our machinery at this station is undergoing maintenance. Production lines remain at full capacity for existing buyers.
			</p>
			<div class="btn-group">
				<a href="/" class="btn-primary">Return to Homepage</a>
				<a href="/contact" class="btn-ghost">Contact Us Directly</a>
			</div>
		</div>
	</section>

	<!-- Section Divider -->
	<div class="section-divider">
		<span>WHILE YOU'RE HERE</span>
	</div>

	<!-- Cards Section -->
	<section class="cards-section">
		<div class="cards-grid">

			<!-- Card 1: Manufacturing Capabilities -->
			<a href="/products" class="card">
				<p class="card-num">01</p>
				<svg class="ico ico-bars" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<rect class="bar bar1" x="4" y="24" width="8" height="12"/>
					<rect class="bar bar2" x="16" y="16" width="8" height="20"/>
					<rect class="bar bar3" x="28" y="8" width="8" height="28"/>
					<line x1="2" y1="36" x2="38" y2="36" stroke="rgba(255,255,255,.15)" stroke-width="1.2"/>
				</svg>
				<p class="card-label">Manufacturing</p>
				<h3 class="card-title">Our Production Capabilities</h3>
				<p class="card-body">30+ clothing categories produced with precision and quality standards since 1998.</p>
				<span class="card-link">View All Categories →</span>
			</a>

			<!-- Card 2: Journal Entry -->
			<a href="/journal" class="card">
				<p class="card-num">02</p>
				<svg class="ico ico-doc" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<path d="M8 6h24v28H8z" stroke="rgba(255,255,255,.18)" stroke-width="1.5"/>
					<line class="dline dline1" x1="13" y1="13" x2="27" y2="13"/>
					<line class="dline dline2" x1="13" y1="19" x2="27" y2="19"/>
					<line class="dline dline3" x1="13" y1="25" x2="21" y2="25"/>
				</svg>
				<p class="card-label">Insights</p>
				<h3 class="card-title">Journal Entry</h3>
				<p class="card-body">Industry insights and manufacturing guides authored by our expert production team.</p>
				<span class="card-link">Read Latest Insights →</span>
			</a>

			<!-- Card 3: EU Compliance -->
			<a href="/tools/eu-readiness-checker" class="card">
				<p class="card-num">03</p>
				<svg class="ico ico-check" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<circle class="ring" cx="20" cy="20" r="14"/>
					<path class="chk" d="M14 20l4 4 8-8"/>
				</svg>
				<p class="card-label">Compliance</p>
				<h3 class="card-title">EU Compliance 2026</h3>
				<p class="card-body">Is your supply chain ready for EU regulations? We are fully compliant and ready to assist.</p>
				<span class="card-link">Learn About Compliance →</span>
			</a>

		</div>
	</section>

	<!-- Help Strip -->
	<section class="help-strip">
		<div class="help-inner">
			<div class="help-text">
				<p class="help-eyebrow">Need Assistance?</p>
				<p class="help-body">Our team is ready to help with your manufacturing needs.</p>
			</div>
			<div class="help-actions">
				<a href="/contact" class="btn-strip">Contact Us</a>
				<a href="tel:+8801819172080" class="btn-strip">+880 1819 172080</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* ── Tokens ─────────────────────────────── */
	:root {
		--red:    #e00;
		--red-dk: #c00;
		--bg:     #060606;
		--bg-2:   #0d0d0d;
		--bg-3:   #111;
		--border: #1c1c1c;
		--muted:  rgba(255,255,255,0.5);
		--green:  #00c96b;
		--green-a: rgba(0,180,80,0.07);
	}

	/* ── Textile Background ──────────────────── */
	.textile-bg {
		position: fixed;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		z-index: 0;
	}

	/* Stitch lines — sewing machine stitches sliding across */
	.stitch {
		position: absolute;
		left: -100%;
		width: 300%;
		height: 1px;
		border-top: 1.5px dashed rgba(0,180,80,0.09);
		animation: stitch-move linear infinite;
	}
	.s1 { top: 18%; animation-duration: 18s; }
	.s2 { top: 36%; animation-duration: 24s; animation-delay: -7s;  border-top-color: rgba(0,180,80,0.06); }
	.s3 { top: 62%; animation-duration: 20s; animation-delay: -3s;  border-top-color: rgba(0,180,80,0.05); }
	.s4 { top: 80%; animation-duration: 26s; animation-delay: -11s; border-top-color: rgba(0,180,80,0.07); }
	@keyframes stitch-move {
		from { transform: translateX(0); }
		to   { transform: translateX(33.33%); }
	}

	/* Warp threads — vertical loom threads breathing */
	.warp {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: linear-gradient(
			180deg,
			transparent,
			rgba(0,180,80,0.05) 30%,
			rgba(0,180,80,0.08) 50%,
			rgba(0,180,80,0.05) 70%,
			transparent
		);
		animation: warp-breathe ease-in-out infinite;
	}
	.w1 { left: 12%; animation-duration: 7s; }
	.w2 { left: 28%; animation-duration: 9s;   animation-delay: -3s; }
	.w3 { left: 55%; animation-duration: 8s;   animation-delay: -1s; }
	.w4 { left: 72%; animation-duration: 11s;  animation-delay: -5s; }
	.w5 { left: 88%; animation-duration: 6.5s; animation-delay: -2s; }
	@keyframes warp-breathe {
		0%,100% { opacity: 0.4; transform: scaleY(0.95); }
		50%      { opacity: 1;   transform: scaleY(1); }
	}

	/* Floating thread lines drifting downward */
	.thread {
		position: absolute;
		pointer-events: none;
		animation: thread-drift linear infinite;
	}
	.t1 {
		top: -10%; left: 5%; width: 1px; height: 45%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.1), transparent);
		animation-duration: 22s;
	}
	.t2 {
		top: 20%; right: 15%; width: 1px; height: 35%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.07), transparent);
		animation-duration: 28s; animation-delay: -9s;
	}
	.t3 {
		top: 50%; left: 42%; width: 1px; height: 30%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.06), transparent);
		animation-duration: 19s; animation-delay: -4s;
	}
	@keyframes thread-drift {
		0%   { opacity: 0; transform: translateY(-20px); }
		10%  { opacity: 1; }
		90%  { opacity: 1; }
		100% { opacity: 0; transform: translateY(40px); }
	}

	/* Bobbin — spinning thread reel in corner */
	.bobbin {
		position: absolute;
		bottom: 8%;
		right: 4%;
		width: 52px;
		height: 52px;
		opacity: 0.08;
		animation: bobbin-spin 20s linear infinite;
	}
	@keyframes bobbin-spin {
		from { transform: rotate(0deg); }
		to   { transform: rotate(360deg); }
	}

	/* Weave dots — fabric intersection grid */
	.weave-dot {
		position: absolute;
		width: 2px;
		height: 2px;
		border-radius: 50%;
		background: var(--green);
		animation: weave-pulse ease-in-out infinite;
	}
	@keyframes weave-pulse {
		0%,100% { opacity: 0.04; }
		50%      { opacity: 0.12; }
	}

	/* ── Hero ────────────────────────────────── */
	.hero-section {
		position: relative;
		z-index: 2;
		padding: 60px 1.5rem 52px;
		text-align: center;
		background: transparent;
	}
	.hero-section::after {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--red), transparent);
		opacity: 0.4;
	}

	.scanline {
		position: absolute;
		left: 0; right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgba(0,201,107,0.12), transparent);
		animation: scan 7s ease-in-out infinite;
		pointer-events: none;
		z-index: 3;
	}
	@keyframes scan {
		0%   { top: -2px; opacity: 0; }
		8%   { opacity: 1; }
		92%  { opacity: 0.7; }
		100% { top: 100%; opacity: 0; }
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 800px;
		margin: 0 auto;
	}

	/* Status badge */
	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: var(--red);
		border: 1px solid rgba(220,0,0,0.3);
		padding: 5px 13px;
		margin-bottom: 28px;
		background: rgba(220,0,0,0.04);
	}
	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--red);
		animation: blink 1.1s ease-in-out infinite;
		flex-shrink: 0;
	}
	@keyframes blink {
		0%,100% { opacity: 1; }
		50%      { opacity: 0.1; }
	}

	/* 404 numeral */
	.four-oh-four {
		position: relative;
		font-size: clamp(88px, 18vw, 160px);
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px #252525;
		overflow: hidden;
		margin-bottom: 4px;
		user-select: none;
	}
	.four-oh-four .zero {
		color: rgba(220,0,0,0.1);
		-webkit-text-stroke: 1px var(--red);
	}

	/* Caution tape */
	.caution-tape {
		position: absolute;
		left: -4%; right: -4%;
		top: 50%;
		transform: translateY(-50%) rotate(-1.5deg);
		height: 33px;
		overflow: hidden;
		display: flex;
		align-items: center;
		background: var(--red);
		z-index: 4;
	}
	.tape-inner {
		white-space: nowrap;
		font-size: 9px;
		font-weight: 900;
		letter-spacing: 0.22em;
		color: rgba(0,0,0,0.5);
		animation: marquee 10s linear infinite;
	}
	@keyframes marquee {
		from { transform: translateX(0); }
		to   { transform: translateX(-50%); }
	}

	/* Hero text */
	.hero-heading {
		font-size: clamp(20px, 3.5vw, 30px);
		font-weight: 700;
		color: #fff;
		margin-top: 20px;
		margin-bottom: 12px;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.hero-body {
		font-size: 13.5px;
		color: var(--muted);
		line-height: 1.8;
		max-width: 480px;
		margin: 0 auto 36px;
	}

	/* Buttons */
	.btn-group {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}
	.btn-primary {
		background: var(--red);
		color: #fff;
		padding: 11px 26px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		transition: background 0.2s;
	}
	.btn-primary::after { content: '→'; }
	.btn-primary:hover  { background: var(--red-dk); }

	.btn-ghost {
		border: 1px solid rgba(255,255,255,0.12);
		color: rgba(255,255,255,0.7);
		padding: 11px 26px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		background: transparent;
		min-height: 44px;
		transition: border-color 0.2s, color 0.2s;
	}
	.btn-ghost:hover {
		border-color: rgba(220,0,0,0.5);
		color: var(--red);
	}

	/* ── Section Divider ─────────────────────── */
	.section-divider {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 0 1.5rem;
		max-width: 900px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}
	.section-divider::before,
	.section-divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border);
	}
	.section-divider span {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: rgba(255,255,255,0.18);
		white-space: nowrap;
	}

	/* ── Cards ───────────────────────────────── */
	.cards-section {
		padding: 28px 1.5rem 52px;
		position: relative;
		z-index: 2;
		background: transparent;
	}
	.cards-grid {
		max-width: 900px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
	}
	@media (max-width: 640px) {
		.cards-grid { grid-template-columns: 1fr; }
	}

	.card {
		background: var(--bg-2);
		padding: 30px 22px;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		position: relative;
		overflow: hidden;
		transition: background 0.25s;
	}
	.card::before {
		content: '';
		position: absolute;
		left: 0; top: 0; bottom: 0;
		width: 2px;
		background: var(--red);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 0.25s ease;
	}
	.card:hover                { background: var(--bg-3); }
	.card:hover::before        { transform: scaleY(1); }
	.card:hover .card-link     { color: var(--green); }

	/* ── SVG Icon Animations ─────────────────── */
	.ico { width: 38px; height: 38px; margin-bottom: 16px; }

	/* Icon 1: bars pulse white → green sequentially */
	.bar {
		fill: none;
		stroke: rgba(255,255,255,0.2);
		stroke-width: 8;
		animation: bar-fill 3s ease-in-out infinite;
	}
	.bar1 { animation-delay: 0s; }
	.bar2 { animation-delay: 0.3s; }
	.bar3 { animation-delay: 0.6s; }
	@keyframes bar-fill {
		0%,100% { stroke: rgba(255,255,255,0.18); }
		50%     { stroke: var(--green); }
	}

	/* Icon 2: document lines draw in green then fade */
	.dline {
		stroke: rgba(255,255,255,0.2);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-dasharray: 14;
		stroke-dashoffset: 14;
		animation: draw-line 2.5s ease-in-out infinite;
	}
	.dline1 { animation-delay: 0s; }
	.dline2 { animation-delay: 0.4s; }
	.dline3 { animation-delay: 0.8s; }
	@keyframes draw-line {
		0%   { stroke-dashoffset: 14; stroke: rgba(255,255,255,0.15); }
		40%  { stroke-dashoffset: 0;  stroke: var(--green); }
		80%  { stroke-dashoffset: 0;  stroke: rgba(255,255,255,0.3); }
		100% { stroke-dashoffset: 14; stroke: rgba(255,255,255,0.15); }
	}

	/* Icon 3: circle rotates, checkmark draws in green */
	.ring {
		fill: none;
		stroke: rgba(255,255,255,0.18);
		stroke-width: 1.5;
		stroke-dasharray: 88;
		stroke-dashoffset: 0;
		animation: ring-spin 3s ease-in-out infinite;
	}
	.chk {
		fill: none;
		stroke: rgba(255,255,255,0.2);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 22;
		stroke-dashoffset: 22;
		animation: draw-check 3s ease-in-out infinite;
	}
	@keyframes ring-spin {
		0%,100% { stroke: rgba(255,255,255,0.15); stroke-dashoffset: 0; }
		50%     { stroke: var(--green);            stroke-dashoffset: -20; }
	}
	@keyframes draw-check {
		0%,20% { stroke-dashoffset: 22; stroke: rgba(255,255,255,0.1); }
		55%    { stroke-dashoffset: 0;  stroke: var(--green); }
		80%    { stroke-dashoffset: 0;  stroke: rgba(255,255,255,0.4); }
		100%   { stroke-dashoffset: 22; stroke: rgba(255,255,255,0.1); }
	}

	.card-num {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255,255,255,0.1);
		margin-bottom: 14px;
	}
	.card-label {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--red);
		margin-bottom: 6px;
		opacity: 0.8;
	}
	.card-title {
		font-size: 14px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 8px;
		line-height: 1.3;
	}
	.card-body {
		font-size: 12px;
		color: var(--muted);
		line-height: 1.7;
		flex: 1;
		margin-bottom: 16px;
	}
	.card-link {
		font-size: 11.5px;
		font-weight: 600;
		color: rgba(255,255,255,0.22);
		transition: color 0.2s;
		letter-spacing: 0.02em;
	}

	/* ── Help Strip ──────────────────────────── */
	.help-strip {
		background: var(--bg-2);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
