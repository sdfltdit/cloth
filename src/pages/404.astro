---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "404 — Production Line Unavailable | SDF Clothing";
const pageDescription = "The production line you're looking for is currently unavailable. Our manufacturing facility is operating at full capacity for existing buyers.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "404 — Production Line Unavailable",
		"description": "The production line you're looking for is currently unavailable.",
		"url": "https://sdfltd.com/404"
	}
	</script>

	<div class="page-404">

		<!-- Textile Background -->
		<div class="textile-bg" aria-hidden="true">
			<div class="stitch s1"></div>
			<div class="stitch s2"></div>
			<div class="stitch s3"></div>
			<div class="stitch s4"></div>
			<div class="warp w1"></div>
			<div class="warp w2"></div>
			<div class="warp w3"></div>
			<div class="warp w4"></div>
			<div class="warp w5"></div>
			<div class="thread t1"></div>
			<div class="thread t2"></div>
			<div class="thread t3"></div>
			<svg class="bobbin" viewBox="0 0 52 52" fill="none">
				<circle cx="26" cy="26" r="24" stroke="#00c96b" stroke-width="1.5"/>
				<circle cx="26" cy="26" r="14" stroke="#00c96b" stroke-width="1"/>
				<circle cx="26" cy="26" r="4"  stroke="#00c96b" stroke-width="1"/>
				<line x1="26" y1="2"  x2="26" y2="12" stroke="#00c96b" stroke-width="1"/>
				<line x1="26" y1="40" x2="26" y2="50" stroke="#00c96b" stroke-width="1"/>
				<line x1="2"  y1="26" x2="12" y2="26" stroke="#00c96b" stroke-width="1"/>
				<line x1="40" y1="26" x2="50" y2="26" stroke="#00c96b" stroke-width="1"/>
			</svg>
			<span class="wd" style="top:22%;left:8%;animation-delay:0s;animation-duration:4s"></span>
			<span class="wd" style="top:22%;left:16%;animation-delay:.8s;animation-duration:5s"></span>
			<span class="wd" style="top:22%;left:24%;animation-delay:.4s;animation-duration:4.5s"></span>
			<span class="wd" style="top:40%;left:8%;animation-delay:1.2s;animation-duration:5s"></span>
			<span class="wd" style="top:40%;left:16%;animation-delay:.2s;animation-duration:4s"></span>
			<span class="wd" style="top:40%;left:24%;animation-delay:1s;animation-duration:6s"></span>
			<span class="wd" style="top:22%;right:8%;animation-delay:.6s;animation-duration:5s"></span>
			<span class="wd" style="top:22%;right:16%;animation-delay:1.4s;animation-duration:4s"></span>
			<span class="wd" style="top:40%;right:8%;animation-delay:.3s;animation-duration:4.5s"></span>
			<span class="wd" style="top:40%;right:16%;animation-delay:.9s;animation-duration:6s"></span>
		</div>

		<!-- Hero -->
		<section class="hero">
			<div class="scanline" aria-hidden="true"></div>
			<div class="hero-inner">
				<div class="badge">
					<span class="badge-dot"></span>
					LINE STOPPED — ERROR 404
				</div>

				<div class="num404" aria-hidden="true">
					<span>4</span><span class="zero">0</span><span>4</span>
					<div class="tape">
						<div class="tape-scroll">
							PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp; PRODUCTION HALTED &nbsp;·&nbsp;
						</div>
					</div>
				</div>

				<h1 class="heading">This Line Is Currently Unavailable</h1>
				<p class="subtext">
					The order you're looking for can't be processed here — our machinery at this station
					is undergoing maintenance. Production lines remain at full capacity for existing buyers.
				</p>

				<div class="btn-row">
					<a href="/" class="btn-red">Return to Homepage</a>
					<a href="/contact/" class="btn-outline">Contact Us Directly</a>
				</div>
			</div>
		</section>

		<!-- Divider -->
		<div class="divider"><span>WHILE YOU'RE HERE</span></div>

		<!-- Cards -->
		<section class="cards-section">
			<div class="cards-grid">

				<a href="/products" class="card">
					<p class="card-num">01</p>
					<svg class="ico" viewBox="0 0 40 40" fill="none" aria-hidden="true">
						<rect class="bar b1" x="4"  y="24" width="8" height="12"/>
						<rect class="bar b2" x="16" y="16" width="8" height="20"/>
						<rect class="bar b3" x="28" y="8"  width="8" height="28"/>
						<line x1="2" y1="36" x2="38" y2="36" stroke="rgba(255,255,255,.12)" stroke-width="1.2"/>
					</svg>
					<p class="card-lbl">Manufacturing</p>
					<h3 class="card-title">Our Production Capabilities</h3>
					<p class="card-body">30+ clothing categories produced with precision and quality standards since 1998.</p>
					<span class="card-link">View All Categories →</span>
				</a>

				<a href="/products/" class="card">
					<p class="card-num">02</p>
					<svg class="ico" viewBox="0 0 40 40" fill="none" aria-hidden="true">
						<path d="M8 6h24v28H8z" stroke="rgba(255,255,255,.18)" stroke-width="1.5"/>
						<line class="dl d1" x1="13" y1="13" x2="27" y2="13"/>
						<line class="dl d2" x1="13" y1="19" x2="27" y2="19"/>
						<line class="dl d3" x1="13" y1="25" x2="21" y2="25"/>
					</svg>
					<p class="card-lbl">Insights</p>
					<h3 class="card-title">Journal Entry</h3>
					<p class="card-body">Industry insights and manufacturing guides authored by our expert production team.</p>
					<span class="card-link">Read Latest Insights →</span>
				</a>

				<a href="/tools/eu-readiness-checker" class="card">
					<p class="card-num">03</p>
					<svg class="ico" viewBox="0 0 40 40" fill="none" aria-hidden="true">
						<circle class="ring" cx="20" cy="20" r="14"/>
						<path class="chk" d="M14 20l4 4 8-8" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					<p class="card-lbl">Compliance</p>
					<h3 class="card-title">EU Compliance 2026</h3>
					<p class="card-body">Is your supply chain ready for EU regulations? We are fully compliant and ready to assist.</p>
					<span class="card-link">Learn About Compliance →</span>
				</a>

			</div>
		</section>

		<!-- Help Strip -->
		<section class="help-strip">
			<div class="help-inner">
				<div>
					<p class="help-eyebrow">Need Assistance?</p>
					<p class="help-body">Our team is ready to help with your manufacturing needs.</p>
				</div>
				<div class="help-btns">
					<a href="/contact/" class="btn-sm">Contact Us</a>
					<a
						href="https://wa.me/8801819172080"
						target="_blank"
						rel="noopener noreferrer"
						class="btn-sm btn-wa"
						aria-label="Chat with us on WhatsApp"
					>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
							<path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.554 4.103 1.523 5.828L.057 23.804a.5.5 0 00.638.637l5.98-1.466A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.374l-.36-.214-3.724.913.932-3.617-.235-.372A9.818 9.818 0 1112 21.818z"/>
						</svg>
						WhatsApp Us
					</a>
				</div>
			</div>
		</section>

	</div><!-- /page-404 -->
</BaseLayout>

<style>
	/* ── Reset & Tokens ─────────────────────────────────── */
	:root {
		--red:    #e00;
		--red-dk: #c00;
		--bg:     #060606;
		--bg2:    #0d0d0d;
		--bg3:    #111111;
		--border: #1c1c1c;
		--muted:  rgba(255,255,255,0.5);
		--green:  #00c96b;
		--wa:     #25d366;
	}

	/* Page wrapper — contains everything, fixes alignment */
	.page-404 {
		position: relative;
		overflow: hidden;
		background: var(--bg);
		width: 100%;
	}

	/* ── Textile Background ─────────────────────────────── */
	.textile-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}

	/* Horizontal stitch lines */
	.stitch {
		position: absolute;
		left: -100%;
		width: 300%;
		height: 1px;
		border-top: 1.5px dashed rgba(0,180,80,0.08);
		will-change: transform;
		animation: stitch-move linear infinite;
	}
	.s1 { top: 15%; animation-duration: 18s; }
	.s2 { top: 33%; animation-duration: 24s; animation-delay: -7s;  border-top-color: rgba(0,180,80,0.055); }
	.s3 { top: 58%; animation-duration: 21s; animation-delay: -3s;  border-top-color: rgba(0,180,80,0.045); }
	.s4 { top: 78%; animation-duration: 27s; animation-delay: -11s; border-top-color: rgba(0,180,80,0.065); }
	@keyframes stitch-move {
		from { transform: translateX(0); }
		to   { transform: translateX(33.333%); }
	}

	/* Vertical warp threads */
	.warp {
		position: absolute;
		top: 0; bottom: 0;
		width: 1px;
		background: linear-gradient(
			180deg,
			transparent 0%,
			rgba(0,180,80,0.04) 25%,
			rgba(0,180,80,0.07) 50%,
			rgba(0,180,80,0.04) 75%,
			transparent 100%
		);
		will-change: opacity, transform;
		animation: warp-breathe ease-in-out infinite;
	}
	.w1 { left: 10%; animation-duration: 7s; }
	.w2 { left: 26%; animation-duration: 9s;   animation-delay: -3s; }
	.w3 { left: 50%; animation-duration: 8s;   animation-delay: -1s; }
	.w4 { left: 74%; animation-duration: 11s;  animation-delay: -5s; }
	.w5 { left: 90%; animation-duration: 6.5s; animation-delay: -2s; }
	@keyframes warp-breathe {
		0%,100% { opacity: 0.35; transform: scaleY(0.94); }
		50%      { opacity: 1;    transform: scaleY(1); }
	}

	/* Floating thread lines */
	.thread {
		position: absolute;
		width: 1px;
		will-change: opacity, transform;
		animation: thread-drift linear infinite;
	}
	.t1 {
		top: -10%; left: 6%; height: 42%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.09), transparent);
		animation-duration: 22s;
	}
	.t2 {
		top: 15%; right: 12%; height: 32%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.065), transparent);
		animation-duration: 29s; animation-delay: -9s;
	}
	.t3 {
		top: 48%; left: 44%; height: 28%;
		background: linear-gradient(180deg, transparent, rgba(0,201,107,0.055), transparent);
		animation-duration: 19s; animation-delay: -4s;
	}
	@keyframes thread-drift {
		0%   { opacity: 0; transform: translateY(-20px); }
		10%  { opacity: 1; }
		90%  { opacity: 1; }
		100% { opacity: 0; transform: translateY(40px); }
	}

	/* Bobbin */
	.bobbin {
		position: absolute;
		bottom: 6%; right: 3%;
		width: 54px; height: 54px;
		opacity: 0.07;
		will-change: transform;
		animation: bobbin-spin 22s linear infinite;
	}
	@keyframes bobbin-spin {
		from { transform: rotate(0deg); }
		to   { transform: rotate(360deg); }
	}

	/* Weave dots */
	.wd {
		position: absolute;
		display: block;
		width: 2px; height: 2px;
		border-radius: 50%;
		background: var(--green);
		will-change: opacity;
		animation: wd-pulse ease-in-out infinite;
	}
	@keyframes wd-pulse {
		0%,100% { opacity: 0.04; }
		50%      { opacity: 0.13; }
	}

	/* ── Hero ───────────────────────────────────────────── */
	.hero {
		position: relative;
		z-index: 2;
		padding: 72px 24px 60px;
		text-align: center;
	}
	.hero::after {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0; height: 1px;
		background: linear-gradient(90deg, transparent, var(--red), transparent);
		opacity: 0.4;
	}

	.scanline {
		position: absolute;
		left: 0; right: 0; height: 2px;
		background: linear-gradient(90deg, transparent, rgba(0,201,107,0.1), transparent);
		will-change: transform, opacity;
		animation: scan 8s ease-in-out infinite;
		pointer-events: none; z-index: 3;
	}
	@keyframes scan {
		0%   { top: -2px; opacity: 0; }
		8%   { opacity: 1; }
		92%  { opacity: 0.6; }
		100% { top: 100%; opacity: 0; }
	}

	.hero-inner {
		position: relative;
		z-index: 2;
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* Badge */
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: var(--red);
		border: 1px solid rgba(220,0,0,0.3);
		padding: 5px 14px;
		margin-bottom: 32px;
		background: rgba(220,0,0,0.04);
	}
	.badge-dot {
		width: 6px; height: 6px;
		border-radius: 50%;
		background: var(--red);
		flex-shrink: 0;
		will-change: opacity;
		animation: blink 1.1s ease-in-out infinite;
	}
	@keyframes blink {
		0%,100% { opacity: 1; }
		50%      { opacity: 0.1; }
	}

	/* 404 */
	.num404 {
		position: relative;
		font-size: clamp(96px, 19vw, 168px);
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 1px #282828;
		overflow: hidden;
		margin-bottom: 8px;
		user-select: none;
		width: 100%;
		text-align: center;
	}
	.num404 .zero {
		color: rgba(220,0,0,0.08);
		-webkit-text-stroke: 1px var(--red);
	}

	/* Caution tape */
	.tape {
		position: absolute;
		left: -5%; right: -5%;
		top: 48%;
		transform: translateY(-50%) rotate(-1.5deg);
		height: 34px;
		overflow: hidden;
		display: flex;
		align-items: center;
		background: var(--red);
		z-index: 4;
	}
	.tape-scroll {
		white-space: nowrap;
		font-size: 9px;
		font-weight: 900;
		letter-spacing: 0.22em;
		color: rgba(0,0,0,0.45);
		will-change: transform;
		animation: marquee 10s linear infinite;
	}
	@keyframes marquee {
		from { transform: translateX(0); }
		to   { transform: translateX(-50%); }
	}

	/* Heading & subtext */
	.heading {
		font-size: clamp(22px, 3.8vw, 34px);
		font-weight: 700;
		color: #fff;
		margin-top: 24px;
		margin-bottom: 14px;
		line-height: 1.22;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.subtext {
		font-size: 14px;
		color: var(--muted);
		line-height: 1.8;
		max-width: 500px;
		text-align: center;
		margin-bottom: 40px;
	}

	/* Buttons */
	.btn-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
	}
	.btn-red {
		background: var(--red);
		color: #fff;
		padding: 12px 28px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		transition: background 0.2s;
		text-transform: uppercase;
	}
	.btn-red::after { content: '→'; font-size: 15px; }
	.btn-red:hover  { background: var(--red-dk); }

	.btn-outline {
		border: 1px solid rgba(255,255,255,0.14);
		color: rgba(255,255,255,0.72);
		padding: 12px 28px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		min-height: 46px;
		background: transparent;
		transition: border-color 0.2s, color 0.2s;
	}
	.btn-outline:hover {
		border-color: rgba(220,0,0,0.45);
		color: var(--red);
	}

	/* ── Section Divider ────────────────────────────────── */
	.divider {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 0 24px;
		max-width: 920px;
		margin: 0 auto;
	}
	.divider::before,
	.divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border);
	}
	.divider span {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: rgba(255,255,255,0.16);
		white-space: nowrap;
	}

	/* ── Cards ──────────────────────────────────────────── */
	.cards-section {
		position: relative;
		z-index: 2;
		padding: 32px 24px 56px;
	}
	.cards-grid {
		max-width: 920px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
	}

	.card {
		background: var(--bg2);
		padding: 32px 24px;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		position: relative;
		overflow: hidden;
		transition: background 0.25s;
	}
	.card::before {
		content: '';
		position: absolute;
		left: 0; top: 0; bottom: 0;
		width: 2px;
		background: var(--red);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 0.28s ease;
	}
	.card:hover               { background: var(--bg3); }
	.card:hover::before       { transform: scaleY(1); }
	.card:hover .card-link    { color: var(--green); }

	/* Card icon animations */
	.ico { width: 36px; height: 36px; margin-bottom: 18px; }

	/* Icon 1: bars pulse green */
	.bar {
		fill: none;
		stroke-width: 8;
		stroke: rgba(255,255,255,0.18);
		will-change: stroke;
		animation: bar-fill 3s ease-in-out infinite;
	}
	.b1 { animation-delay: 0s; }
	.b2 { animation-delay: 0.32s; }
	.b3 { animation-delay: 0.64s; }
	@keyframes bar-fill {
		0%,100% { stroke: rgba(255,255,255,0.16); }
		50%     { stroke: var(--green); }
	}

	/* Icon 2: lines draw in */
	.dl {
		stroke: rgba(255,255,255,0.18);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-dasharray: 15;
		stroke-dashoffset: 15;
		animation: draw-line 2.8s ease-in-out infinite;
	}
	.d1 { animation-delay: 0s; }
	.d2 { animation-delay: 0.4s; }
	.d3 { animation-delay: 0.8s; }
	@keyframes draw-line {
		0%   { stroke-dashoffset: 15; stroke: rgba(255,255,255,0.14); }
		40%  { stroke-dashoffset: 0;  stroke: var(--green); }
		80%  { stroke-dashoffset: 0;  stroke: rgba(255,255,255,0.28); }
		100% { stroke-dashoffset: 15; stroke: rgba(255,255,255,0.14); }
	}

	/* Icon 3: circle + checkmark animate */
	.ring {
		fill: none;
		stroke: rgba(255,255,255,0.16);
		stroke-width: 1.5;
		stroke-dasharray: 88;
		animation: ring-spin 3.2s ease-in-out infinite;
	}
	.chk {
		fill: none;
		stroke: rgba(255,255,255,0.18);
		stroke-width: 1.5;
		stroke-dasharray: 22;
		stroke-dashoffset: 22;
		animation: draw-chk 3.2s ease-in-out infinite;
	}
	@keyframes ring-spin {
		0%,100% { stroke: rgba(255,255,255,0.14); stroke-dashoffset: 0; }
		50%     { stroke: var(--green);            stroke-dashoffset: -18; }
	}
	@keyframes draw-chk {
		0%,18% { stroke-dashoffset: 22; stroke: rgba(255,255,255,0.1); }
		52%    { stroke-dashoffset: 0;  stroke: var(--green); }
		82%    { stroke-dashoffset: 0;  stroke: rgba(255,255,255,0.38); }
		100%   { stroke-dashoffset: 22; stroke: rgba(255,255,255,0.1); }
	}

	.card-num {
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255,255,255,0.1);
		margin-bottom: 14px;
	}
	.card-lbl {
