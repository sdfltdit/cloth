---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Sustainability & Environmental Commitment | SDF Clothing";
const pageDescription = "SDF Clothing's commitment to sustainable garment manufacturing — tree plantation initiatives, green hosting, ethical production, and environmental responsibility in Bangladesh.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Sustainability & Environmental Commitment",
		"description": "SDF Clothing Ltd sustainability policy — tree plantation, green digital infrastructure, ethical manufacturing, and environmental responsibility.",
		"url": "https://sdfltd.com/sustainability",
		"dateModified": "2026-05-07",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
				{ "@type": "ListItem", "position": 2, "name": "Sustainability", "item": "https://sdfltd.com/sustainability" }
			]
		}
	}
	</script>

	<!-- Main Sustainability & Environmental Commitment Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Sustainability & Environmental Commitment</h1>
				<p class="text-white/70 mb-2">Last updated: May 7, 2026</p>
			</div>

			<!-- Opening Statement Box -->
			<div style="border-left: 3px solid #fff; padding-left: 1.5rem; margin-bottom: 2rem;">
				<p style="margin: 0; color: #fff; font-size: 0.95rem; line-height: 1.7;">
					At SDF Clothing Ltd, sustainability is not a marketing claim. It is a practiced commitment — embedded in our operations, our supply chain, and the way we run our business. From our factory floor in Bangladesh to our digital infrastructure, we work continuously to reduce our environmental impact and contribute positively to the world around us.
				</p>
			</div>

			<div class="prose prose-invert max-w-none" style="font-size: 0.95rem; line-height: 1.9; color: #fff;">
				
				<!-- SECTION 1 — WHY SUSTAINABILITY MATTERS TO US -->
				<h2 id="why-sustainability" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 1 — WHY SUSTAINABILITY MATTERS TO US
				</h2>
				<p style="margin-bottom: 2rem;">
					The global garment and textile industry is one of the world's most resource-intensive sectors. As a Bangladesh-based manufacturer supplying international brands and retailers, we recognise that our operations — however efficient — carry an environmental footprint. We also recognise that we have the ability, and the responsibility, to reduce that footprint wherever we can.
				</p>
				<p style="margin-bottom: 2rem;">
					Our commitment to sustainability is not driven by compliance alone. It is driven by a genuine belief that responsible manufacturing and environmental stewardship are inseparable from long-term business integrity. The clients we work with — brands in the USA, UK, Canada, Australia, and Europe — increasingly share this belief and expect their supply chain partners to demonstrate it in practice, not just in policy.
				</p>

				<!-- SECTION 2 — TREE PLANTATION INITIATIVE -->
				<h2 id="tree-plantation" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 2 — TREE PLANTATION INITIATIVE
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd actively participates in tree plantation initiatives as a direct expression of our environmental responsibility. We believe that offsetting our operational footprint through reforestation is one of the most tangible and meaningful contributions a manufacturing business can make.
				</p>
				<p style="margin-bottom: 2rem;">
					Our tree plantation activities include:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Regular organised tree planting in and around our operational areas in Bangladesh</li>
					<li style="margin-bottom: 0.75rem;">Participation in national and community-level greening initiatives</li>
					<li style="margin-bottom: 0.75rem;">Encouraging our supply chain partners and employees to participate in plantation activities</li>
					<li style="margin-bottom: 0.75rem;">Tracking and documenting our plantation efforts as part of our annual environmental review</li>
				</ul>
				<p style="margin-bottom: 2rem;">
					We view tree plantation not as a one-time activity but as an ongoing commitment — one that grows alongside our business.
				</p>

				<!-- SECTION 3 — GREEN DIGITAL INFRASTRUCTURE -->
				<h2 id="green-digital" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 3 — GREEN DIGITAL INFRASTRUCTURE
				</h2>
				<p style="margin-bottom: 2rem;">
					Our environmental commitment extends beyond the factory floor to every aspect of how we operate — including our digital presence.
				</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.1 Green Web Hosting</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">SDF Clothing's website (sdfltd.com) is hosted exclusively on Cloudflare Pages, which is officially certified as a green host by the Green Web Foundation — an independent non-profit organisation dedicated to building a fossil-fuel-free internet.</p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Cloudflare Pages operates on 100% renewable energy and has committed to:</p>
				<ul style="margin-bottom: 2rem; padding-left: 2.5rem;">
					<li style="margin-bottom: 0.75rem;">Powering its global network entirely with renewable energy</li>
					<li style="margin-bottom: 0.75rem;">Removing all historical carbon emissions from its network since 2010</li>
					<li style="margin-bottom: 0.75rem;">Continuous improvement of energy efficiency across its infrastructure</li>
				</ul>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">This means that every time someone visits sdfltd.com — whether a prospective client in New York, a buyer in London, or a partner in Sydney — that interaction is powered by renewable energy.</p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">You can verify our green hosting status independently at: <a href="https://www.thegreenwebfoundation.org/" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://www.thegreenwebfoundation.org/</a></p>

				<p style="margin-bottom: 1.5rem;"><strong>3.2 Reforestation Partnership Alignment</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Cloudflare, our hosting provider, also maintains its own reforestation commitments as part of its sustainability programme. This aligns directly with SDF Clothing's own tree plantation initiatives — creating a consistent environmental ethos across both our physical operations and our digital presence.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.3 Efficient Digital Operations</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We design our website for maximum performance efficiency — fast-loading pages, optimised assets, and minimal server requests. This reduces energy consumption per page visit and contributes to a lower carbon footprint for our digital operations.</p>

				<!-- SECTION 4 — ETHICAL MANUFACTURING PRACTICES -->
				<h2 id="ethical-manufacturing" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 4 — ETHICAL MANUFACTURING PRACTICES
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>4.1 Worker Welfare</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Sustainable business means sustainable people. SDF Clothing Ltd is committed to the welfare of every worker in our supply chain:</p>
				<ul style="margin-bottom: 2rem; padding-left: 2.5rem;">
					<li style="margin-bottom: 0.75rem;">Fair wages meeting or exceeding Bangladesh statutory minimums</li>
					<li style="margin-bottom: 0.75rem;">Safe and healthy working conditions compliant with Bangladesh Labour Law 2006</li>
					<li style="margin-bottom: 0.75rem;">Regular health and safety training for all production staff</li>
					<li style="margin-bottom: 0.75rem;">Zero tolerance for child labour, forced labour, or any form of coercion</li>
					<li style="margin-bottom: 0.75rem;">Respectful and non-discriminatory workplace culture</li>
				</ul>

				<p style="margin-bottom: 1.5rem;"><strong>4.2 Supply Chain Standards</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We work only with suppliers and sub-contractors who share our commitment to ethical production. We conduct periodic reviews of our supply chain partners to ensure ongoing compliance with our ethical manufacturing standards.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.3 Compliance Framework</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Our manufacturing processes operate in accordance with internationally recognised ethical production standards. We do not publicly list specific certification details to prevent misuse, but full compliance documentation is available to verified business partners upon written request following client qualification.</p>

				<!-- SECTION 5 — RESOURCE EFFICIENCY IN PRODUCTION -->
				<h2 id="resource-efficiency" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 5 — RESOURCE EFFICIENCY IN PRODUCTION
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>5.1 Fabric Waste Reduction</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We implement fabric utilisation planning at the cutting stage to minimise fabric wastage. Production patterns are optimised for maximum material efficiency. Fabric offcuts and trimmings are sorted and directed toward recycling or responsible disposal wherever possible.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.2 Water Consumption</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We work with washing and dyeing partners who maintain water treatment and recycling systems. We actively seek to reduce water consumption across wet processing stages and prioritise partners with documented water management practices.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.3 Energy Use</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We continuously seek to improve energy efficiency across our production facility — from machinery maintenance to lighting and climate control. We support the transition toward cleaner energy sources within our operational environment and encourage our supply chain partners to do the same.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.4 Packaging</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">We offer clients the option of recycled or sustainably sourced packaging materials for their orders. We are working toward phasing out single-use plastic polybags from our standard packaging across all product categories.</p>

				<!-- SECTION 6 — OUR SUSTAINABILITY GOALS -->
				<h2 id="sustainability-goals" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 6 — OUR SUSTAINABILITY GOALS
				</h2>
				<p style="margin-bottom: 2rem;">
					We are committed to continuous improvement. Our current sustainability goals include:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Increasing annual tree plantation numbers year-on-year</li>
					<li style="margin-bottom: 0.75rem;">Achieving full digital carbon neutrality through our green hosting infrastructure (already achieved via Cloudflare Pages)</li>
					<li style="margin-bottom: 0.75rem;">Reducing fabric waste per unit of production by an ongoing improvement target reviewed annually</li>
					<li style="margin-bottom: 0.75rem;">Expanding our supplier code of conduct and compliance review programme</li>
					<li style="margin-bottom: 0.75rem;">Providing clients with carbon footprint data for their orders upon request as our reporting capabilities develop</li>
					<li style="margin-bottom: 0.75rem;">Aligning our reporting with internationally recognised sustainability frameworks as our scale supports it</li>
				</ul>

				<!-- SECTION 7 — SUSTAINABILITY IN OUR CLIENT PARTNERSHIPS -->
				<h2 id="client-partnerships" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 7 — SUSTAINABILITY IN OUR CLIENT PARTNERSHIPS
				</h2>
				<p style="margin-bottom: 2rem;">
					We recognise that our clients — particularly those in the EU, UK, and USA — are under increasing pressure from their own customers, investors, and regulators to demonstrate supply chain sustainability. We are committed to being a manufacturing partner that helps our clients meet those obligations, not one that creates risk for them.
				</p>
				<p style="margin-bottom: 2rem;">
					We are able to:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Provide factory compliance documentation to verified clients upon request</li>
					<li style="margin-bottom: 0.75rem;">Support third-party social and environmental audits at our facility</li>
					<li style="margin-bottom: 0.75rem;">Provide production transparency information appropriate to the client's due diligence requirements</li>
					<li style="margin-bottom: 0.75rem;">Work collaboratively with clients on sustainability improvement initiatives specific to their product categories</li>
				</ul>

				<!-- SECTION 8 — CONTINUOUS IMPROVEMENT -->
				<h2 id="continuous-improvement" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 8 — CONTINUOUS IMPROVEMENT
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd acknowledges that sustainability is a journey, not a destination. We do not claim to have achieved perfection. We commit to honest, ongoing assessment of our environmental and social performance, transparent communication with our clients and partners about our progress, active pursuit of improvements in every area where we have influence, and learning from industry best practice and evolving international standards.
				</p>

				<!-- SECTION 9 — CONTACT & FEEDBACK -->
				<h2 id="contact" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 9 — CONTACT & FEEDBACK
				</h2>
				<p style="margin-bottom: 2rem;">
					We welcome enquiries and feedback related to our sustainability practices. If you are a prospective client with specific sustainability requirements, an existing client with questions about our environmental practices, or a researcher or journalist seeking information about our sustainability programme, please use our <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a> at /contact.
				</p>
				<p style="margin-bottom: 2rem;">
					We take all sustainability enquiries seriously and respond within 3 business days.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
