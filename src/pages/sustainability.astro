---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Sustainability & Certifications | SDF Clothing Bangladesh";
const pageDescription = "GOTS certified sustainable clothing manufacturer in Bangladesh — OEKO-TEX 100, GRS recycled, BSCI, SEDEX, EU EPR 2026 ready. Ethical factory since 1998.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://sdfltd.com/sustainability/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Sustainability" }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://sdfltd.com/sustainability/#service",
      "name": "Sustainable Clothing Manufacturing Bangladesh",
      "alternateName": [
        "GOTS Certified Clothing Manufacturer Bangladesh",
        "Ethical Garment Factory Bangladesh",
        "Organic Clothing Manufacturer Bangladesh",
        "Eco Friendly Apparel Manufacturer Bangladesh",
        "Sustainable Garment Manufacturer",
        "OEKO-TEX Certified Bangladesh Factory"
      ],
      "description": "SDF Clothing is a GOTS certified sustainable clothing manufacturer in Dhaka, Bangladesh. OEKO-TEX Standard 100, GRS recycled, BSCI, SEDEX SMETA, ISO 9001, EU EPR 2026 compliant, Digital Product Passport ready. Ethical factory operating since 1998. MOQ 300 pieces.",
      "provider": {
        "@type": "Organization",
        "@id": "https://sdfltd.com/#org",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "foundingDate": "1998",
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "name": "GOTS — Global Organic Textile Standard", "credentialCategory": "Sustainability Certification" },
          { "@type": "EducationalOccupationalCredential", "name": "OEKO-TEX Standard 100", "credentialCategory": "Chemical Safety Certification" },
          { "@type": "EducationalOccupationalCredential", "name": "GRS — Global Recycled Standard", "credentialCategory": "Recycled Content Certification" },
          { "@type": "EducationalOccupationalCredential", "name": "BSCI Social Compliance", "credentialCategory": "Social Audit" },
          { "@type": "EducationalOccupationalCredential", "name": "SEDEX SMETA 4-Pillar Audit", "credentialCategory": "Ethical Trade Audit" },
          { "@type": "EducationalOccupationalCredential", "name": "ISO 9001 Quality Management", "credentialCategory": "Quality Certification" },
          { "@type": "EducationalOccupationalCredential", "name": "REACH Compliance", "credentialCategory": "EU Chemical Regulation" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://sdfltd.com/sustainability/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is SDF Clothing GOTS certified?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. SDF Clothing holds GOTS (Global Organic Textile Standard) certification covering the full production chain — from raw organic cotton sourcing through spinning, dyeing, cutting, sewing, and finishing. GOTS certificates are provided with every organic order and available for download on our certifications page." }
        },
        {
          "@type": "Question",
          "name": "What sustainable certifications does SDF Clothing hold?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing holds: GOTS (Global Organic Textile Standard), OEKO-TEX Standard 100, GRS (Global Recycled Standard), BSCI Social Compliance, SEDEX SMETA 4-Pillar Ethical Trade Audit, ISO 9001 Quality Management, and REACH EU chemical compliance. Full certificate copies are provided with every shipment." }
        },
        {
          "@type": "Question",
          "name": "Does SDF Clothing produce organic cotton garments?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our GOTS certification covers the complete chain from raw organic cotton sourcing through finished garment. Brands can legally label products as organic when produced through our GOTS certified supply chain. We source from certified organic cotton mills and document the full chain of custody from fibre to finished product." }
        },
        {
          "@type": "Question",
          "name": "Is SDF Clothing EU EPR 2026 and Digital Product Passport compliant?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We generate Digital Product Passport data files (JSON/XML) for every order, including material composition declarations, REACH chemical compliance certificates, and full supply chain traceability documentation. Our production process meets EU ESPR 2026 requirements for textile traceability." }
        },
        {
          "@type": "Question",
          "name": "What is the BSCI audit result for SDF Clothing?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing holds a current BSCI Social Compliance audit covering labour standards, working hours, wages, health and safety, and prohibition of child and forced labour. The BSCI audit report is available to verified business partners upon request and provided as standard with shipments to EU buyers requiring CSDDD supply chain documentation." }
        },
        {
          "@type": "Question",
          "name": "Does SDF Clothing produce recycled fabric garments?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We hold GRS (Global Recycled Standard) certification and produce garments from recycled polyester, recycled nylon, and recycled cotton blends. GRS certificates confirm the recycled content claim from raw material through finished garment — required for brands making recycled material claims in the EU, UK, and USA markets." }
        },
        {
          "@type": "Question",
          "name": "Is SDF Clothing's website carbon neutral?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. sdfltd.com is hosted on Cloudflare, certified as a green host by the Green Web Foundation. Cloudflare's global network runs on 100% renewable energy. Every visit to our website — from London, New York, or Sydney — is powered by renewable energy." }
        }
      ]
    }
  ]
}
</script>

<style>
  .sus { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; color: #d0d0dc; background: #080c0a; }
  .c { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
  .cn { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; }

  /* Colour tokens — green-forward palette */
  :root {
    --g1: #1a9c52;   /* primary green */
    --g2: #12703a;   /* dark green */
    --g3: rgba(26,156,82,0.12);
    --b1: #0a1410;   /* deep background */
    --b2: #0e1a12;   /* card bg */
    --b3: #152018;   /* border bg */
    --line: #1a2a1e;
    --text: #9aaa9e;
    --light: #c8d8cc;
    --white: #f0f5f2;
  }

  .eyebrow { font-size: 0.6rem; letter-spacing: 0.38em; text-transform: uppercase; color: var(--g1); font-weight: 700; margin-bottom: 0.7rem; display: block; }
  .h1 { font-size: clamp(1.85rem, 4.5vw, 3rem); font-weight: 200; color: var(--white); line-height: 1.15; margin-bottom: 1rem; }
  .h1 em { font-style: normal; color: var(--g1); font-weight: 700; }
  .h2 { font-size: clamp(1.25rem, 2.6vw, 1.8rem); font-weight: 300; color: var(--white); line-height: 1.22; margin-bottom: 0.5rem; }
  .h3 { font-size: 0.96rem; font-weight: 600; color: var(--white); margin-bottom: 0.4rem; }
  .lead { font-size: 0.98rem; color: var(--light); line-height: 1.8; margin-bottom: 1.5rem; max-width: 700px; }
  .body { font-size: 0.9rem; color: var(--text); line-height: 1.76; margin-bottom: 0.9rem; }
  .body a { color: #5acc88; text-decoration: none; border-bottom: 1px solid rgba(90,204,136,0.3); }
  .body a:hover { color: #7ddda0; }
  .small { font-size: 0.76rem; color: #445548; }

  /* Breadcrumb */
  .bc { padding: 0.8rem 0; font-size: 0.76rem; color: #445548; border-bottom: 1px solid var(--line); }
  .bc a { color: #556655; text-decoration: none; } .bc a:hover { color: var(--g1); }
  .bc span { margin: 0 0.4rem; }

  /* Hero */
  .hero { padding: 4.5rem 0 3.5rem; background: linear-gradient(155deg, #050e07 0%, #080c0a 55%, #060a0e 100%); border-bottom: 2px solid var(--g1); position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; left: -80px; bottom: -100px; width: 480px; height: 480px; background: radial-gradient(ellipse, rgba(26,156,82,0.07) 0%, transparent 65%); pointer-events: none; }

  .badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.4rem 0 2rem; }
  .badge { font-size: 0.66rem; letter-spacing: 0.07em; padding: 0.27rem 0.62rem; border: 1px solid rgba(26,156,82,0.4); color: #70a880; border-radius: 2px; white-space: nowrap; }
  .badge.w { border-color: rgba(255,255,255,0.15); color: #778877; }

  .ctarow { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .btn-g { display: inline-block; background: var(--g1); color: #fff; padding: 0.72rem 1.55rem; font-size: 0.83rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 2px; transition: background 0.18s; }
  .btn-g:hover { background: var(--g2); }
  .btn-o { display: inline-block; border: 1px solid rgba(255,255,255,0.18); color: #aabbaa; padding: 0.72rem 1.35rem; font-size: 0.83rem; text-decoration: none; border-radius: 2px; transition: border-color 0.18s, color 0.18s; }
  .btn-o:hover { border-color: var(--g1); color: var(--white); }

  /* Section */
  .sec { padding: 3.75rem 0; border-bottom: 1px solid var(--line); }

  /* Cards */
  .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.3rem; }
  .g4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 1.1rem; }
  .card { background: var(--b2); border: 1px solid var(--line); border-radius: 3px; padding: 1.4rem; }
  .card.hl { border-color: rgba(26,156,82,0.35); }
  .icon { font-size: 1.5rem; margin-bottom: 0.6rem; line-height: 1; }
  .num { font-size: 2.2rem; font-weight: 800; color: var(--g1); line-height: 1; margin-bottom: 0.15rem; }
  .numlabel { font-size: 0.8rem; font-weight: 600; color: var(--white); margin-bottom: 0.15rem; }
  .numsub { font-size: 0.73rem; color: #556655; }

  /* Cert table */
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.84rem; margin-top: 1rem; }
  .tbl th { text-align: left; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: #445548; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--line); }
  .tbl td { padding: 0.7rem 0.75rem; border-bottom: 1px solid #0e160f; color: var(--text); vertical-align: top; line-height: 1.55; }
  .tbl tr:last-child td { border-bottom: none; }
  .tbl td:first-child { color: var(--light); font-weight: 500; }
  .tbl tr:hover td { background: rgba(26,156,82,0.03); }
  .yes { color: var(--g1); font-weight: 700; }

  /* Checklist */
  .cl { list-style: none; padding: 0; margin: 0.8rem 0; }
  .cl li { font-size: 0.87rem; color: var(--text); padding: 0.38rem 0; border-bottom: 1px solid #0d150f; display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.5; }
  .cl li:last-child { border-bottom: none; }
  .cl li::before { content: "✓"; color: var(--g1); font-weight: 700; flex-shrink: 0; margin-top: 0.05rem; }

  /* Cert badge display */
  .cert-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 1.5rem; }
  .cert-card { background: var(--b2); border: 1px solid var(--line); border-radius: 3px; padding: 1.2rem 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .cert-name { font-size: 0.82rem; font-weight: 700; color: var(--white); }
  .cert-full { font-size: 0.73rem; color: #667766; line-height: 1.4; }
  .cert-scope { font-size: 0.72rem; color: var(--g1); margin-top: 0.2rem; }
  .cert-dot { width: 0.55rem; height: 0.55rem; background: var(--g1); border-radius: 50%; flex-shrink: 0; margin-top: 0.3rem; }

  /* Infographic: supply chain */
  .chain-visual { background: var(--b2); border: 1px solid var(--line); border-radius: 3px; padding: 1.75rem; overflow-x: auto; margin: 1.5rem 0; }

  /* Quote */
  .quote { border-left: 3px solid var(--g1); padding: 1.2rem 1.5rem; background: #0b150d; margin: 1.75rem 0; border-radius: 0 3px 3px 0; }
  .quote p { font-size: 0.94rem; color: var(--light); font-style: italic; line-height: 1.72; margin-bottom: 0.5rem; }
  .quote span { font-size: 0.7rem; color: #445548; }

  /* FAQ */
  .faq-item { border-bottom: 1px solid #0e160f; padding: 1.2rem 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-q { font-size: 0.94rem; font-weight: 600; color: var(--white); margin-bottom: 0.4rem; }
  .faq-a { font-size: 0.86rem; color: var(--text); line-height: 1.72; }
  .faq-a strong { color: var(--light); }

  /* Green hosting badge */
  .green-host { background: linear-gradient(135deg, #0a1a0d, #0e2015); border: 1px solid rgba(26,156,82,0.35); border-radius: 3px; padding: 1.4rem 1.6rem; display: flex; gap: 1.2rem; align-items: center; margin: 1.5rem 0; }
  .green-host-icon { font-size: 2.2rem; flex-shrink: 0; }
  .green-host-label { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--g1); margin-bottom: 0.25rem; }
  .green-host-text { font-size: 0.86rem; color: var(--light); line-height: 1.6; }

  /* Author bar */
  .author { background: var(--b2); border: 1px solid var(--line); border-radius: 3px; padding: 1rem 1.35rem; display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
  .author-dot { width: 2.25rem; height: 2.25rem; background: var(--g1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 800; color: #fff; flex-shrink: 0; }
  .author-name { font-size: 0.82rem; font-weight: 600; color: var(--white); }
  .author-sub { font-size: 0.72rem; color: #556655; margin-top: 0.1rem; }

  /* Internal links */
  .lc { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; }
  .lc a { font-size: 0.76rem; padding: 0.27rem 0.62rem; border: 1px solid #1a2a1e; color: #556655; text-decoration: none; border-radius: 2px; transition: border-color 0.14s, color 0.14s; }
  .lc a:hover { border-color: var(--g1); color: var(--white); }

  /* CTA footer */
  .cta-sec { padding: 4.5rem 0; background: linear-gradient(150deg, #050e07 0%, #080c0a 100%); border-top: 2px solid var(--g1); text-align: center; }

  @media (max-width: 768px) {
    .g2, .g3, .g4, .cert-grid { grid-template-columns: 1fr !important; }
    .green-host { flex-direction: column; text-align: center; }
    .author { flex-direction: column; text-align: center; }
  }
  @media (max-width: 520px) {
    .h1 { font-size: 1.7rem; }
    .ctarow { flex-direction: column; }
    .btn-g, .btn-o { text-align: center; }
  }
</style>

<div class="sus">

  <!-- BREADCRUMB -->
  <nav class="bc" aria-label="Breadcrumb">
    <div class="c">
      <a href="/">Home</a><span aria-hidden="true">›</span>
      <span aria-current="page">Sustainability</span>
    </div>
  </nav>

  <!-- ====================================================
    HERO
  ==================================================== -->
  <section class="hero" aria-labelledby="sus-h1">
    <div class="c">
      <span class="eyebrow">Sustainable Clothing Manufacturer · Bangladesh · Since 1998</span>
      <h1 class="h1" id="sus-h1">
        <em>Sustainable</em> Clothing<br>
        Manufacturer Bangladesh
      </h1>
      <p class="lead" style="margin-bottom:0;">
        SDF Clothing is a <a href="/certifications/" style="color:#5acc88;text-decoration:none;border-bottom:1px solid rgba(90,204,136,0.3);">GOTS certified</a> sustainable clothing manufacturer in Dhaka, Bangladesh. Every garment we produce — from organic cotton knitwear to recycled polyester activewear — is backed by the certifications your buyers require and the supply chain documentation your compliance team needs. We have been doing this since 1998. Sustainability is not a new initiative for us — it is how we built the factory.
      </p>
      <div class="badges">
        <span class="badge">🌿 GOTS Certified — Full Chain</span>
        <span class="badge">🧪 OEKO-TEX Standard 100</span>
        <span class="badge">♻️ GRS Recycled Standard</span>
        <span class="badge">👷 BSCI Social Compliance</span>
        <span class="badge">🤝 SEDEX SMETA 4-Pillar</span>
        <span class="badge w">EU EPR 2026 Ready</span>
        <span class="badge w">DPP Compliant</span>
        <span class="badge w">ISO 9001 Certified</span>
        <span class="badge w">Green Web Hosted</span>
      </div>
      <div class="ctarow">
        <a href="/contact/" class="btn-g">Request Sustainability Documentation</a>
        <a href="/certifications" class="btn-o">View All Certifications</a>
      </div>
    </div>
  </section>

  <!-- AUTHOR BAR -->
  <div style="padding:1.2rem 0;border-bottom:1px solid var(--line);">
    <div class="c">
      <div class="author">
        <div class="author-dot" aria-hidden="true">CR</div>
        <div>
          <div class="author-name">Written by Chowdhury Remon — Founder &amp; CEO, SDF Clothing</div>
          <div class="author-sub">Garment manufacturing expert since 1998 · Specialist in sustainable apparel production, EU market compliance, and GOTS/OEKO-TEX certified supply chains · Updated June 2026</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ====================================================
    SECTION 1 — KEY NUMBERS
  ==================================================== -->
  <section class="sec" aria-labelledby="nums-h2">
    <div class="c">
      <span class="eyebrow">Sustainability at a Glance</span>
      <h2 class="h2" id="nums-h2">The Numbers Behind Our Sustainability Commitment</h2>
      <p class="lead">Before the detail — here is what our sustainability programme looks like in numbers that matter to brands, buyers, and compliance auditors.</p>
      <div class="g4">
        <div class="card hl" style="text-align:center;">
          <div class="num">13</div>
          <div class="numlabel">Active Certifications</div>
          <div class="numsub">GOTS, OEKO-TEX, GRS, BSCI, SEDEX, ISO 9001, REACH — all current</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="num">28</div>
          <div class="numlabel">Years Operating</div>
          <div class="numsub">Since 1998 — sustainability built in from day one, not retrofitted</div>
        </div>
        <div class="card hl" style="text-align:center;">
          <div class="num">100%</div>
          <div class="numlabel">Renewable Web Hosting</div>
          <div class="numsub">Cloudflare and Google Cloud Green Web Foundation certified, 0 fossil fuels</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="num">0</div>
          <div class="numlabel">Outsourcing</div>
          <div class="numsub">Everything in-house — full supply chain visibility, no hidden tiers</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="num">200+</div>
          <div class="numlabel">Brand Clients</div>
          <div class="numsub">EU, UK, USA, Australia — all receive certified, documented sustainable production</div>
        </div>
        <div class="card hl" style="text-align:center;">
          <div class="num">✓</div>
          <div class="numlabel" style="font-size:0.85rem;">EU EPR 2026 Ready</div>
          <div class="numsub">DPP data files, REACH declarations, traceability documentation — standard</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="num">2.5</div>
          <div class="numlabel">AQL Standard</div>
          <div class="numsub">Final inspection every order — quality documented before shipment</div>
        </div>
        <div class="card hl" style="text-align:center;">
          <div class="num">0%</div>
          <div class="numlabel">Child / Forced Labour</div>
          <div class="numsub">Zero tolerance — BSCI and SEDEX audited, verified independently</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
    SECTION 2 — CERTIFICATIONS (THE MOST IMPORTANT SECTION)
  ==================================================== -->
  <section class="sec" aria-labelledby="cert-h2">
    <div class="c">
      <span class="eyebrow">The Certification Stack</span>
      <h2 class="h2" id="cert-h2">Our Full Sustainability Certifications — What Each One Means for Your Brand</h2>
      <p class="lead">
        Every certification we hold exists because a buyer asked for it, a regulation required it, or a retailer mandated it. We do not hold certificates that have no market value. Below is the sustainability-relevant subset — for the complete list of all 13 certifications with market-by-market legal requirements and audit cycles, see our <a href="/certifications">full certifications breakdown</a>.
      </p>

      <div class="cert-grid">
        <div class="cert-card">
          <div style="display:flex;gap:0.5rem;align-items:flex-start;">
            <div class="cert-dot" style="margin-top:0.35rem;"></div>
            <div>
              <div class="cert-name">GOTS</div>
              <div class="cert-full">Global Organic Textile Standard</div>
              <div class="cert-scope">Full production chain — fibre to finished garment</div>
            </div>
          </div>
          <p class="body" style="font-size:0.8rem;margin-top:0.65rem;margin-bottom:0;">The world's leading organic textile standard, required to legally market garments as "organic" in the EU, UK, and USA. Full breakdown of our GOTS scope below.</p>
        </div>

        <div class="cert-card">
          <div style="display:flex;gap:0.5rem;align-items:flex-start;">
            <div class="cert-dot"></div>
            <div>
              <div class="cert-name">OEKO-TEX® Standard 100</div>
              <div class="cert-full">Harmful Substance Testing — All Components</div>
              <div class="cert-scope">Every component: fabric, thread, buttons, zips, labels</div>
            </div>
          </div>
          <p class="body" style="font-size:0.8rem;margin-top:0.65rem;margin-bottom:0;">Every component lab-tested for 100+ harmful substances. Mandatory for children's clothing sold in the EU and standard supplier qualification for most EU/UK retailers.</p>
        </div>

        <div class="cert-card">
          <div style="display:flex;gap:0.5rem;align-items:flex-start;">
            <div class="cert-dot"></div>
            <div>
              <div class="cert-name">GRS</div>
              <div class="cert-full">Global Recycled Standard</div>
              <div class="cert-scope">Recycled polyester, nylon, cotton, blends</div>
            </div>
          </div>
          <p class="body" style="font-size:0.8rem;margin-top:0.65rem;margin-bottom:0;">Certifies recycled content claims from raw material to finished garment — required to legally market products as "recycled" in the EU, UK, and USA.</p>
        </div>

        <div class="cert-card">
          <div style="display:flex;gap:0.5rem;align-items:flex-start;">
            <div class="cert-dot"></div>
            <div>
              <div class="cert-name">BSCI</div>
              <div class="cert-full">Business Social Compliance Initiative</div>
              <div class="cert-scope">Labour rights, wages, working hours, safety</div>
            </div>
          </div>
          <p class="body" style="font-size:0.8rem;margin-top:0.65rem;margin-bottom:0;">Independently audits wages, working hours, and factory safety. Required by EU retailers for supply chain due diligence under the CSDDD.</p>
        </div>

        <div class="cert-card">
          <div style="display:flex;gap:0.5rem;align-items:flex-start;">
            <div class="cert-dot"></div>
            <div>
              <div class="cert-name">SEDEX SMETA</div>
              <div class="cert-full">Supplier Ethical Data Exchange — 4-Pillar Audit</div>
              <div class="cert-scope">Labour · Health &amp; Safety · Environment · Business Ethics</div>
            </div>
          </div>
