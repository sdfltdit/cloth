---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Kids Clothing Manufacturer Bangladesh | 300 Piece MOQ | SDF";
const pageDescription = "Leading kids clothing manufacturer in Bangladesh. 300 piece MOQ, OEKO-TEX certified, 13 certifications. Baby, toddler, children. Get free quote for kids wear.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Kids clothing manufacturer from Bangladesh providing baby clothes, toddler wear, and children's fashion with OEKO-TEX certification for child safety to fashion brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for kids clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "Are your kids clothes OEKO-TEX certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We are OEKO-TEX Standard 100 certified for children's clothing. Our garments are tested for harmful substances and meet Class I standards for under 3 years and Class II for older children."
          }
        },
        {
          "@type": "Question",
          "name": "What kids categories do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture newborn (0-3 months), baby (3-24 months) including bodysuits, rompers, and sleep sets, toddler (2-4 years), boys and girls (4-12 years), and tweens (12-14 years)."
          }
        },
        {
          "@type": "Question",
          "name": "Do you follow kids-specific construction standards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We follow OEKO-TEX Class I for under 3 years, no metal eyelets near skin, soft elastics and seams, hidden seam construction, snap closures and easy dressing, and no drawstrings for CPSIA compliance."
          }
        },
        {
          "@type": "Question",
          "name": "What safety certifications do you have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold OEKO-TEX Standard 100 Class I for under 3 years and Class II for older children. We are CPSIA compliant for USA markets and REACH compliant for EU markets. We also offer GOTS for organic kids ranges."
          }
        },
        {
          "@type": "Question",
          "name": "How long does kids clothing production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic kids clothing. 35-50 days for custom fabric development or organic options. 7-14 days for sampling before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "What age ranges do you manufacture for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture for all age groups: newborn (0-3 months), baby (3-12 months), toddler (1-3 years), little kids (4-6 years), big kids (7-12 years), and teens (13-16 years). Each age group has appropriate sizing, safety features, and design considerations."
          }
        },
        {
          "@type": "Question",
          "name": "Can you manufacture organic kids clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer GOTS-certified organic cotton kids clothing with full traceability from farm to finished garment. Organic options include baby onesies, toddler t-shirts, children's pajamas, and school uniforms. GOTS certification covers both organic materials and social compliance standards."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Kids Clothing Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Kids Clothing Manufacturing Service",
      "description": "Custom kids clothing manufacturing from 300 pieces with OEKO-TEX certification and child safety compliance",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Kids Clothing Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Kids Clothing Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "8",
              "maxPrice": "20"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Kids Clothing from SDF Clothing",
      "description": "Step-by-step process for ordering custom kids clothing from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your kids clothing design, safety certification requirements, fabric specifications, size chart, target quantity, and CPSIA/REACH compliance needs via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, certification, and shipping for your kids clothing order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review kids clothing samples for safety compliance, fabric softness, construction quality, and easy-dressing features within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with OEKO-TEX certified materials and 30-40 day turnaround for standard kids items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with certification documentation and tracking for your kids clothing order"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="kids clothing manufacturer, children's clothing manufacturer, baby clothing manufacturer, toddler clothing manufacturer, kids apparel manufacturer, organic kids clothing, OEKO-TEX kids clothing" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Kids Clothing Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Kids Clothing Manufacturer | Since 1998 | OEKO-TEX Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Kids Clothing Manufacturer for Fashion Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Kids clothing requires specialized construction for safety and comfort. Soft fabrics, hidden seams, and easy-dressing features are essential for children's apparel. SDF Clothing manufactures kids clothing in Bangladesh with OEKO-TEX certification for child safety. From 300 pieces per style with CPSIA and REACH compliance. Explore our <a href="/clothing-manufacturers/" style="color:#e00;text-decoration:none;">clothing manufacturers</a> and <a href="/baby-clothing-manufacturer/" style="color:#e00;text-decoration:none;">baby clothing manufacturer</a>.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20kids-clothing-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Class</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">I & II Certified</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">30-40</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">CPSIA</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Compliant</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Kids Clothing Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our kids clothing manufacturing covers the full production cycle from fabric sourcing to finished garment. We source OEKO-TEX certified fabrics from approved mills, cut, sew with specialized construction for child safety, apply branding, and package for shipment.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Production capacity: 40,000-60,000 kids clothing pieces per month across multiple production lines. We handle basic kids clothing for wholesale, premium organic kids clothing for boutique brands, and specialized safety-compliant garments for children's markets.
    </p>
  </div>
</section>

<!-- Categories Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Kids Categories We Manufacture</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Newborn (0-3 Months)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Newborn clothing with soft fabrics and gentle construction. Bodysuits, onesies, sleep sets, and blankets. OEKO-TEX Class I certified for newborn safety. Snap closures for easy dressing.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Baby (3-24 Months) | Bodysuits, Rompers, Sleep Sets</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Baby clothing for 3-24 months. Bodysuits, rompers, sleep sets, onesies, and playwear. Soft fabrics and comfortable fits. Easy-dressing features with snap and zipper closures.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Toddler (2-4 Years)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Toddler clothing for 2-4 years. T-shirts, dresses, shorts, trousers, and playwear. Durable fabrics for active toddlers. Easy-dressing features for independence.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Boys and Girls (4-12 Years)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Boys and girls clothing for 4-12 years. T-shirts, dresses, skirts, trousers, jackets, and school wear. Fashion-forward designs with child-appropriate styling.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Tweens (12-14 Years)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Tween clothing for 12-14 years. Fashion-forward designs reflecting teen trends. T-shirts, dresses, jeans, hoodies, and activewear. Size-appropriate styling for pre-teens.
    </p>
  </div>
</section>

<!-- Construction Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Construction</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Kids-Specific Construction Standards</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        OEKO-TEX Class I (under 3 years) and Class II (older children)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        No metal eyelets near skin (soft alternatives used)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Soft elastics and seams (comfortable against skin)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Hidden seam construction (no irritation points)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Snap closures and easy dressing (child-friendly fasteners)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        No drawstrings (CPSIA compliance for USA markets)
      </li>
    </ul>
  </div>
</section>

<!-- Safety Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Certifications</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Safety Certifications</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        OEKO-TEX Standard 100 Class I (under 3 years)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        CPSIA compliance (USA children's safety standards)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        REACH compliance (EU chemical safety standards)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        GOTS for organic kids ranges (organic certification)
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Baby bodysuit/romper: $3-6 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Toddler t-shirt/dress: $4-8 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Kids jacket/hoodie: $8-15 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. OEKO-TEX certification documentation, custom printing, embroidery, and premium packaging are additional.
    </p>

    <table style="width:100%;max-width:800px;margin-top:2rem;border-collapse:collapse;background:#0a0a0a;">
      <thead>
        <tr style="background:#e00;">
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Age Group</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Products</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">MOQ</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Price (500 pcs)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Newborn (0-3m)</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Bodysuits, rompers, sleep sets</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$5-10 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Baby (3-24m)</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Onesies, pajamas, dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$6-12 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Toddler (2-4y)</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">T-shirts, pants, playsuits</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$7-14 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Kids (4-12y)</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Tops, bottoms, dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$8-16 per piece</td>
        </tr>
        <tr>
