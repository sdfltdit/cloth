---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Inclusive Sizing Guide | XS-5XL Grading SDF";
const pageDescription = "Inclusive sizing clothing manufacturing guide. XS-5XL grading, pattern making for extended sizes, plus size manufacturing, and fit testing. Free consultation.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl.href,
      "url": canonicalUrl.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Inclusive Sizing Guide",
            "item": canonicalUrl.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is inclusive sizing in clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Inclusive sizing means producing clothing across an extended size range, typically XS-5XL, to accommodate diverse body types. It requires specialized pattern grading, fit testing across sizes, and construction adjustments to ensure consistent quality and fit throughout the size spectrum."
          }
        },
        {
          "@type": "Question",
          "name": "How does pattern grading work for extended sizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pattern grading for extended sizes uses mathematical grade rules to scale base patterns up and down. Standard grading increments 1-2 inches between sizes for most measurements. Extended sizing requires adjusted grade rules for larger sizes to maintain proportions, with careful attention to armholes, necklines, and waist positions."
          }
        },
        {
          "@type": "Question",
          "name": "What size range does SDF offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF offers inclusive sizing from XS to 5XL for most garment categories. We can customize size ranges per brand requirements, including petite, tall, and plus size specific ranges. Our pattern grading system maintains design integrity across all sizes with proportional scaling."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure fit consistency across sizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We ensure fit consistency through comprehensive fit testing using fit models across the size range, size set sampling before bulk production, and quality control measurements at each size. Fit testing evaluates garment proportions, comfort, and movement to verify that the design intent translates correctly to all sizes."
          }
        },
        {
          "@type": "Question",
          "name": "What construction adjustments are needed for plus sizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plus size construction requires wider waistbands for even pressure distribution, reinforced seams at stress points, adjusted armhole depths for comfort, and strategic panel placement. These adjustments ensure that larger sizes maintain the same quality and comfort as standard sizes without compromising design aesthetics."
          }
        },
        {
          "@type": "Question",
          "name": "What is the minimum order for inclusive sizing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our minimum is 300 pieces total per style, which can be distributed across the inclusive size range. For example, 300 pieces could be split across XS-5XL according to brand requirements. We recommend size runs that reflect target market demographics for optimal inventory management."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Implement Inclusive Sizing with SDF Clothing",
      "description": "Step-by-step process for developing inclusive sizing clothing with our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Define Size Range Requirements",
          "text": "Specify your target size range (XS-5XL or custom), size distribution ratios, and target market demographics for your inclusive sizing collection"
        },
        {
          "@type": "HowToStep",
          "name": "Develop Grading Rules",
          "text": "Our pattern team develops custom grading rules based on your base pattern and size requirements, ensuring proportional scaling across all sizes"
        },
        {
          "@type": "HowToStep",
          "name": "Fit Testing Across Sizes",
          "text": "We produce size set samples across the full range for fit testing, evaluating proportions, comfort, and movement on diverse fit models"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Size Set",
          "text": "Review and approve size set samples to verify fit consistency and design integrity across the entire size range before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins with size set approval, maintaining consistent quality control measurements at each size throughout production"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalUrl={canonicalUrl.href}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
