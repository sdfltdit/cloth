<script>
  const calculator = {
    section301Tariff: 0.25,
    mfnDuties: {
      tshirt: 0.165,
      hoodie: 0.165,
      dress: 0.162,
      pants: 0.165,
      jacket: 0.145
    },

    calculate() {
      const category = document.getElementById('product-category').value;
      const quantity = parseInt(document.getElementById('order-quantity').value) || 0;
      const unitCost = parseFloat(document.getElementById('unit-cost').value) || 0;
      
      if (quantity <= 0 || unitCost <= 0) {
        alert('Please enter valid quantity and unit cost');
        return;
      }

      const mfnDuty = this.mfnDuties[category];
      const fobCost = quantity * unitCost;
      
      const chinaMfnDuty = fobCost * mfnDuty;
      const china301Tariff = fobCost * this.section301Tariff;
      const chinaTotal = fobCost + chinaMfnDuty + china301Tariff;
      
      const bangladeshMfnDuty = fobCost * mfnDuty;
      const bangladeshTotal = fobCost + bangladeshMfnDuty;
      
      const savings = chinaTotal - bangladeshTotal;
      const savingsPercent = ((savings / chinaTotal) * 100).toFixed(1);
      
      document.getElementById('china-total').textContent = `$${chinaTotal.toFixed(2)}`;
      document.getElementById('bangladesh-total').textContent = `$${bangladeshTotal.toFixed(2)}`;
      document.getElementById('savings').textContent = `$${savings.toFixed(2)}`;
      document.getElementById('savings-percent').textContent = `${savingsPercent}%`;
      
      document.getElementById('china-fob').textContent = `$${fobCost.toFixed(2)}`;
      document.getElementById('china-mfn').textContent = `$${chinaMfnDuty.toFixed(2)}`;
      document.getElementById('china-301').textContent = `$${china301Tariff.toFixed(2)}`;
      document.getElementById('china-total-table').textContent = `$${chinaTotal.toFixed(2)}`;
      
      document.getElementById('bangladesh-fob').textContent = `$${fobCost.toFixed(2)}`;
      document.getElementById('bangladesh-mfn').textContent = `$${bangladeshMfnDuty.toFixed(2)}`;
      document.getElementById('bangladesh-total-table').textContent = `$${bangladeshTotal.toFixed(2)}`;
      
      document.getElementById('calculator-results').style.display = 'block';
    }
  };

  document.getElementById('calculate-btn').addEventListener('click', () => calculator.calculate());
</script>

</BaseLayout>
