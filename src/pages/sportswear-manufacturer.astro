---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Sportswear Manufacturer | Custom & Team | SDF Clothing";
const pageDescription = "Custom sportswear manufacturer in Bangladesh. Performance jerseys, training kits and activewear from 300 pieces. GOTS certified factory. Get a free quote today.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Custom sportswear manufacturer from Bangladesh providing professional athletic wear, team uniforms, and performance fabrics to sports brands worldwide since 1998."
    },
    {
      "@type": "Service",
      "serviceType": "Custom Sportswear Manufacturing",
      "provider": { "@id": "https://sdfltd.com/#org" },
      "areaServed": ["US", "GB", "AU", "CA", "DE"],
      "description": "Custom sportswear manufacturer in Bangladesh. Performance jerseys, training kits and activewear from 300 pieces. GOTS certified factory. Get a free quote today."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Sportswear from SDF Clothing",
      "step": [
        { "@type": "HowToStep", "name": "Submit Design Brief", "text": "Share your sportswear design, team colors, and technical requirements" },
        { "@type": "HowToStep", "name": "Receive Tech Pack and Quote", "text": "Our team prepares tech pack and factory quote within 48 hours" },
        { "@type": "HowToStep", "name": "Approve Pre-Production Sample", "text": "Review physical sample before bulk production begins" },
        { "@type": "HowToStep", "name": "Bulk Production and Inspection", "text": "Factory produces order with inline quality checks" },
        { "@type": "HowToStep", "name": "Shipment to Your Door", "text": "Order shipped FOB Dhaka or CIF your destination port" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for custom sportswear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What sportswear products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture football jerseys, basketball uniforms, soccer kits, rugby shirts, tennis apparel, cricket whites, athletic shorts, tracksuits, training gear, warm-up suits, and custom team uniforms for all sports."
          }
        },
        {
          "@type": "Question",
          "name": "Can you customize sportswear with team logos and numbers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer sublimation printing, screen printing, embroidery, heat transfer, and vinyl numbering for team customization. Custom logos, player names, numbers, and sponsor branding available."
          }
        },
        {
          "@type": "Question",
          "name": "What performance fabrics do you use for sportswear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use moisture-wicking polyester, breathable mesh, 4-way stretch fabrics, anti-odor treatments, UV protection fabrics, and quick-dry materials. All fabrics designed for athletic performance and durability."
          }
        },
        {
          "@type": "Question",
          "name": "How long does custom sportswear production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic sportswear. 35-50 days for custom fabric development or specialized performance fabrics. 7-14 days for sampling before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer sublimation printing for jerseys?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Full sublimation printing for unlimited colors and complex designs. Sublimation is permanent, breathable, and doesn't crack or peel. Ideal for team jerseys with intricate patterns and gradients."
          }
        },
        {
          "@type": "Question",
          "name": "Can you manufacture custom compression sportswear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We manufacture compression shirts, leggings, shorts, and base layers using high-stretch performance fabrics. Compression garments improve blood circulation and muscle recovery during athletic activity."
          }
        },
        {
          "@type": "Question",
          "name": "What size ranges do you offer for team sportswear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer full size ranges from youth XS to adult 5XL. Custom sizing charts available for specific team requirements. Size run flexibility within MOQ enables balanced inventory distribution."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Sportswear Manufacturer",
          "item": Astro.url.href
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="sportswear manufacturer, custom sportswear, athletic wear manufacturer, team uniforms manufacturer, football jersey manufacturer, basketball uniform manufacturer, sports apparel manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Sportswear Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Custom Sportswear Manufacturer | Since 1998 | Performance Fabrics</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Sportswear Manufacturer for Teams and Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Custom sportswear requires performance fabrics that wick moisture, stretch for mobility, and withstand intense athletic activity. SDF Clothing, a full-service clothing manufacturer in Bangladesh, produces custom sportswear with professional-grade construction and team customization options. From 300 pieces per style with sublimation printing, embroidery, and numbering.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20sportswear-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Full</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Sublimation</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">30-40</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Team</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Customization</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sportswear Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our custom sportswear manufacturing covers the full production cycle from fabric sourcing to finished team uniforms. We source performance fabrics from certified mills, cut, sew with athletic construction techniques, apply team customization, and package for shipment.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Production capacity: 40,000-60,000 sportswear pieces per month across multiple production lines. We handle basic training gear for clubs, professional team uniforms for leagues, and custom sportswear for retail brands.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Performance Fabric Options</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Moisture-Wicking Polyester</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Standard performance fabric for sportswear. Pulls sweat away from skin for faster evaporation. Lightweight, breathable, and quick-drying. Ideal for jerseys, shorts, and training gear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Breathable Mesh</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Mesh panels for ventilation in high-heat areas. Used in underarms, back panels, and side panels for improved airflow during intense activity.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">4-Way Stretch Fabric</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Stretch fabrics that move with the athlete. Provides maximum mobility for running, jumping, and dynamic movements. Essential for basketball, soccer, and training apparel.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Anti-Odor Treatment</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Fabric treatments that inhibit odor-causing bacteria. Popular for sportswear worn during intense workouts and extended use. Keeps uniforms fresh longer.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">UV Protection Fabric</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      UPF-rated fabrics that block harmful UV rays. Essential for outdoor sports like tennis, cricket, and running. Provides sun protection during extended outdoor activity.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Quick-Dry Materials</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Engineered fabrics that dry rapidly after washing or exposure to moisture. Reduces downtime between games and training sessions.
    </p>
  </div>
</section>

<!-- Products Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sportswear Products We Manufacture</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Football jerseys and soccer kits (home, away, goalkeeper)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Custom team uniforms for all sports | see our <a href="/uniform-manufacturer" style="color:#e00;text-decoration:underline;">uniform manufacturer</a> services
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Rugby shirts and shorts
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Tennis apparel (shirts, skirts, shorts)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cricket whites and colored kits
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Athletic shorts and compression shorts
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Tracksuits and warm-up suits
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Training gear and practice uniforms
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Basketball uniforms (jerseys and shorts)
      </li>
    </ul>
  </div>
</section>

<!-- Customization Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Customization</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Team Customization Options</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Full sublimation printing (unlimited colors, complex designs)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Screen printing (logos, sponsor branding) | see <a href="/printing-service" style="color:#e00;text-decoration:underline;">printing service</a>
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Embroidery (team crests, premium logos)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Heat transfer (numbers, names)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Vinyl numbering (player numbers)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Custom labels and tags
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range. We are among the <a href="/low-moq-clothing-manufacturers" style="color:#e00;text-decoration:underline;">low MOQ clothing manufacturers</a> serving startup and emerging brands.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic jersey (polyester, sublimation): $8-15 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Premium jersey (mesh panels, advanced features): $12-20 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Complete kit (jersey + shorts): $15-28 per set
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic customization, and standard packaging. Advanced customization options are additional. All products come with GOTS and OEKO-TEX <a href="/certifications" style="color:#e00;text-decoration:underline;">certifications</a> ensuring sustainable and safe production.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Sample development costs are credited against bulk orders. We provide competitive pricing on prototype samples, with these costs deducted from the final production invoice when the order is placed. This approach encourages thorough sampling without financial penalty for brands committed to production.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Rush production options are available for urgent deadlines. Accelerated production schedules with compressed lead times incur 20-30% premium pricing but enable brands to meet critical launch dates or seasonal requirements. We provide clear timelines and cost estimates for rush orders before commitment.
    </p>
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sportswear Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard sportswear production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fabric sourcing: 5-10 days (if not in stock)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sampling: 7-14 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bulk production: 30-40 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quality inspection: 2-3 days
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Packing and shipping: 3-5 days
      </li>
    </ul>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Total timeline: 50-75 days from order to delivery. Custom fabric development and specialized performance fabrics add 5-10 days. Rush production available at 20-30% premium.
    </p>
  </div>
</section>

<!-- Production Capacity Section -->
