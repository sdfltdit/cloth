  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .wp-steps__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wp-timeline__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .wp-timeline__item + .wp-timeline__item {
      border-left: none;
    }
    .wp-timeline__item:nth-child(4) {
      border-left: 1px solid #e00;
    }
    .wp-timeline__item:nth-child(3) {
      border-right: 1px solid #e00;
    }
    .wp-timeline__item:nth-child(4),
    .wp-timeline__item:nth-child(5),
    .wp-timeline__item:nth-child(6) {
      border-top: none;
    }
  }

  @media (max-width: 768px) {
