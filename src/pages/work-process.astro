---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Clothing Manufacturers Private Label Guide | SDF Clothing";
const pageDescription = "Simple 6-step process to order custom clothing. From inquiry to delivery, transparent, fast, NDA-protected manufacturing for UK private label fashion brands.";
const ogImage = "https://sdfltd.com/factory.jpg";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": Astro.url.href,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Work Process",
          "item": Astro.url.href
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Order Custom Private Label Clothing from SDF Clothing",
    "description": "Simple 6-step process to order custom clothing from inquiry to delivery.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Send Inquiry",
        "text": "Contact us via WhatsApp, email or our inquiry form with your product requirements. We respond within 48 hours."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "NDA & Consultation",
        "text": "Before sharing any designs, we sign a mutual NDA to protect your intellectual property."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Sampling",
        "text": "Our sample room develops your prototype in 7-14 days with free revisions until approval."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Price & Order Confirmation",
        "text": "Once sample approved, we provide final costing including MOQ confirmation and delivery date."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Bulk Production",
        "text": "Production begins with inline quality checks at every stage: cutting, sewing, finishing."
      },
      {
        "@type": "HowToStep",
        "position": 6,
        "name": "QC & Shipment",
        "text": "Final AQL inspection before packing with custom labels, hang tags, and packaging as per specifications."
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I find a clothing manufacturer in the UK?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Start by researching UK manufacturing directories like Make It British, attending industry trade shows in London and Manchester, and joining UK fashion associations. Look for manufacturers specialising in your garment type with appropriate certifications and capacity for your order volume."
        }
      },
      {
        "@type": "Question",
        "name": "What is the minimum order quantity for private label clothing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "MOQs vary significantly between manufacturers. UK-based manufacturers typically require 50-300 pieces per style for bespoke production, whilst overseas factories may require 500-1000 pieces. Some UK manufacturers offer no minimums for sampling or small batch production."
        }
      },
      {
        "@type": "Question",
        "name": "How long does private label clothing manufacturing take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The complete process from initial inquiry to delivery typically takes 12-20 weeks. Tech pack development takes 1-2 weeks, sampling 2-6 weeks, pre-production 1-4 weeks, bulk production 4-10 weeks, and shipping 2-6 weeks."
        }
      },
      {
        "@type": "Question",
        "name": "What do I need to start working with a clothing manufacturer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You need a detailed tech pack including technical flat drawings, measurements, fabric specifications, colourways, and construction details. Manufacturers also need your target quantity per style, size breakdown, and delivery timeline."
        }
      },
      {
        "@type": "Question",
        "name": "How much does private label clothing manufacturing cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "UK manufacturing typically costs £15-£50 per unit for small runs, whilst overseas production ranges from £5-£20 per unit. Factors affecting cost include fabric sourcing, printing and embroidery, labelling, and packaging."
        }
      },
      {
        "@type": "Question",
        "name": "What UK compliance requirements should I consider?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "UK brands must ensure Modern Slavery Act compliance throughout their supply chain. For imports, understand UK GSP trade benefits and customs procedures. UK-specific regulations include labelling requirements, safety standards for children's clothing, and environmental regulations."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://sdfltd.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Work Process",
        "item": Astro.url.href
      }
    ]
  }
];

const steps = [
  {
    number: "1",
    icon: "📧",
    title: "Send Inquiry",
    description: "Contact us via WhatsApp, email or our inquiry form with your product requirements. We respond within 48 hours. When learning how to work with <a href='/clothing-manufacturers' class='wp-inline-link'>clothing manufacturers</a> and <a href='/garments-manufacturers' class='wp-inline-link'>garments manufacturers</a> for private label fashion brands, include technical flat drawings, fabric specifications, target quantities in GBP, and delivery timeline for UK fashion hubs like London and Manchester. Explore our <a href='/products' class='wp-inline-link'>product catalog</a> for inspiration.",
    listTitle: "What to send:",
    listItems: [
      "Product category",
      "Estimated quantity",
      "Target price in GBP",
      "Delivery timeline for UK"
    ]
  },
  {
    number: "2",
    icon: "🔒",
    title: "NDA & Consultation",
    description: "Before sharing any designs, we sign a mutual NDA to protect your intellectual property. Our merchandising team discusses your requirements in detail, covering tech pack development, fabric sourcing, and timeline planning. As <a href='/apparel-manufacturers' class='wp-inline-link'>apparel manufacturers</a>, we ensure Modern Slavery Act compliance throughout the supply chain for UK fashion brands, ensuring ethical trading practices and transparent manufacturing processes. View our <a href='/certifications' class='wp-inline-link'>certifications</a> and <a href='/csr' class='wp-inline-link'>CSR initiatives</a>.",
    listTitle: "Includes:",
    listItems: [
      "NDA signing",
      "Tech pack review",
      "Fabric discussion",
      "Timeline planning for UK delivery"
    ]
  },
  {
    number: "3",
    icon: "✂️",
    title: "Sampling",
    description: "Our sample room develops your prototype in 7-14 days. We produce proto samples, fit samples, and pre-production samples until you approve. Sampling costs vary based on fabric complexity and graphic applications typically £50-£200 per style. UK manufacturers often offer free pre-production samples with bulk commitment, reducing risk for private label fashion brands testing designs.",
    listTitle: "Turnaround:",
    listItems: [
      "7-14 days for basic styles",
      "14-21 days for complex designs",
      "Free revisions until approval"
    ]
  },
  {
    number: "4",
    icon: "✅",
    title: "Price & Order Confirmation",
    description: "Once sample approved, we provide final costing. UK manufacturing typically costs £15-£50 per unit for small runs of 50-300 pieces, compared to overseas production at £5-£20 per unit with higher MOQs of 500-1000 pieces. Order confirmation includes MOQ confirmation, delivery date, payment terms, and production schedule. UK GSP trade benefits may reduce import duties for qualifying products. As <a href='/fashion-manufacturers' class='wp-inline-link'>fashion manufacturers</a>, we offer competitive pricing for all order volumes.",
    listTitle: "Confirmation includes:",
    listItems: [
      "MOQ confirmation",
      "Final pricing in GBP",
      "Delivery date to UK",
      "Payment terms"
    ]
  },
  {
    number: "5",
    icon: "🏭",
    title: "Bulk Production",
    description: "Production begins with inline quality checks at every stage: cutting, sewing, finishing. Our UK manufacturing facilities implement four-stage quality control processes with AQL standards of 1.5-2.5, exceeding industry average. We send production updates and photos upon request. UK production offers faster turnaround (4-8 weeks) versus overseas (12-20 weeks), with better communication and lower shipping costs to UK fashion hubs.",
    listTitle: "Capacity:",
    listItems: [
      "Bulk production capabilities",
      "Real-time production updates",
      "Quality checks at every stage"
    ]
  },
  {
    number: "6",
    icon: "🚢",
    title: "QC & Shipment",
    description: "Final AQL inspection before packing using industry-standard sampling methods. Custom labels, hang tags, and packaging as per your specifications. Global shipping via sea or air freight to UK fashion hubs like London, Manchester, Birmingham, and Leicester. UK manufacturing eliminates import duties and customs delays, ensuring faster market access for private label fashion brands.",
    listTitle: "Final stage:",
    listItems: [
      "AQL inspection",
      "Custom branding & packaging",
      "UK shipping options",
      "Tracking & documentation"
    ]
  }
];

const timeline = [
  { days: "1-2", label: "Days", title: "Inquiry Response" },
  { days: "1-2", label: "Days", title: "NDA & Consultation" },
  { days: "7-21", label: "Days", title: "Sample Development" },
  { days: "1-2", label: "Days", title: "Order Confirmation" },
  { days: "30-45", label: "Days", title: "Bulk Production" },
  { days: "5-10", label: "Days", title: "QC & Shipping" }
];

const faqs = [
  {
    question: "How do I find a clothing manufacturer in the UK?",
    answer: "Start by researching UK manufacturing directories like Make It British, attending industry trade shows in London and Manchester, and joining UK fashion associations. Look for manufacturers specialising in your garment type with appropriate certifications and capacity for your order volume."
  },
  {
    question: "What is the minimum order quantity for private label clothing?",
    answer: "MOQs vary significantly between manufacturers. UK-based manufacturers typically require 50-300 pieces per style for bespoke production, whilst overseas factories may require 500-1000 pieces. Some UK manufacturers offer no minimums for sampling or small batch production, ideal for startup brands testing designs."
  },
  {
    question: "How long does private label clothing manufacturing take?",
    answer: "The complete process from initial inquiry to delivery typically takes 12-20 weeks. Tech pack development takes 1-2 weeks, sampling 2-6 weeks, pre-production 1-4 weeks, bulk production 4-10 weeks depending on quantity, and shipping 2-6 weeks. UK manufacturing generally offers faster turnaround at 4-8 weeks."
  },
  {
    question: "What do I need to start working with a clothing manufacturer?",
    answer: "You need a detailed tech pack including technical flat drawings, measurements, fabric specifications, colourways, and construction details. If you don't have a tech pack, provide reference images, fabric samples, and detailed descriptions. Manufacturers also need your target quantity per style, size breakdown, and delivery timeline."
  },
  {
    question: "How much does private label clothing manufacturing cost?",
    answer: "Costs vary based on garment complexity, fabric choice, order quantity, and manufacturing location. UK manufacturing typically costs £15-£50 per unit for small runs, whilst overseas production ranges from £5-£20 per unit. Factors affecting cost include fabric sourcing, printing and embroidery, labelling, and packaging. Always request detailed quotations including all components."
  },
  {
    question: "What UK compliance requirements should I consider?",
    answer: `UK brands must ensure <a href="https://www.gov.uk/guidance/the-modern-slavery-act" target="_blank" rel="noopener noreferrer" class="wp-inline-link">Modern Slavery Act compliance</a> throughout their supply chain. For imports, understand UK GSP trade benefits and customs procedures. UK-specific regulations include labelling requirements, safety standards for children's clothing, and environmental regulations. Working with UK manufacturers simplifies compliance with these requirements.`
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}

  ogImage={ogImage}
  schema={schema}
>

  <nav aria-label="Breadcrumb" class="wp-breadcrumb">
    <div class="container">
      <ol class="wp-breadcrumb__list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="wp-breadcrumb__sep" aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name">Work Process</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <main id="main-content">

    <section class="wp-hero" aria-labelledby="wp-hero-heading">
      <div class="container">
        <div class="wp-hero__inner">
          <div class="section-header wp-hero__header">
            <span class="section-label">Manufacturing Process</span>
            <div class="accent-line"></div>
            <h1 id="wp-hero-heading">Clothing Manufacturers Guide for Private Label Fashion Brands</h1>
            <p>
              Simple 6-step process to order custom clothing. From inquiry to delivery, transparent, fast, NDA-protected manufacturing. UK fashion brands trust our expertise as <a href="/clothing-manufacturers" class="wp-inline-link">clothing manufacturers</a> and <a href="/fashion-manufacturers" class="wp-inline-link">fashion manufacturers</a> for private label clothing production.
            </p>
            <div class="wp-hero__cta">
              <a href="/contact" class="btn-primary">Request a Free UK Quote</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wp-steps" aria-labelledby="wp-steps-heading">
      <div class="container">
        <h2 id="wp-steps-heading" class="sr-only">Our 6-Step Manufacturing Process</h2>
        <div class="wp-steps__grid">
          {steps.map((step, index) => (
            <article class="wp-step snake-card" aria-label={`Step ${step.number}: ${step.title}`}>
              <div class="wp-step__top">
                <div class="wp-step__meta">
                  <span class="wp-step__number" aria-hidden="true">{step.number}</span>
                  <span class="wp-step__icon" aria-hidden="true">{step.icon}</span>
                </div>
                <h3 class="wp-step__title">{step.title}</h3>
                <p class="wp-step__desc" set:html={step.description}></p>
              </div>
              <div class="wp-step__list-block">
                <h4 class="wp-step__list-title">{step.listTitle}</h4>
                <ul class="wp-step__list">
                  {step.listItems.map((item) => (
                    <li class="wp-step__list-item">
                      <span class="wp-step__bullet" aria-hidden="true">•</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="wp-timeline" aria-labelledby="wp-timeline-heading">
      <div class="container">
        <div class="section-header wp-timeline__header">
          <span class="section-label">Estimated Duration</span>
          <div class="accent-line"></div>
          <h2 id="wp-timeline-heading">Complete Production Timeline</h2>
        </div>
        <div class="wp-timeline__grid" role="list">
          {timeline.map((item, index) => (
            <div class="wp-timeline__item" role="listitem">
              <div class="wp-timeline__days">{item.days}</div>
              <div class="wp-timeline__label">{item.label}</div>
              <div class="wp-timeline__title">{item.title}</div>
              {index < timeline.length - 1 && (
                <span class="wp-timeline__connector" aria-hidden="true"></span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wp-faq" aria-labelledby="wp-faq-heading">
      <div class="container">
        <div class="section-header wp-faq__header">
          <span class="section-label">Common Questions</span>
          <div class="accent-line"></div>
          <h2 id="wp-faq-heading">Frequently Asked Questions</h2>
        </div>
        <div class="wp-faq__list">
          {faqs.map((faq, index) => (
            <div class="faq-item wp-faq__item" id={`faq-${index}`}>
              <button
                class="faq-question wp-faq__question"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
              >
                <h3 class="wp-faq__question-text">{faq.question}</h3>
                <span class="faq-icon wp-faq__icon" aria-hidden="true">+</span>
              </button>
              <div
                class="faq-answer wp-faq__answer"
                id={`faq-answer-${index}`}
                role="region"
                aria-labelledby={`faq-${index}`}
              >
                <p set:html={faq.answer}></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="wp-cta-section" aria-labelledby="wp-cta-heading">
      <div class="container">
        <div class="wp-cta-block section-header">
          <span class="section-label">Get Started</span>
          <div class="accent-line"></div>
          <h2 id="wp-cta-heading">Ready to Begin Your Private Label Journey?</h2>
          <p>
            Contact our team to learn how to work with clothing manufacturers for private label fashion brands. We guide UK fashion brands through every step of the manufacturing process.
          </p>
          <div class="wp-cta-block__buttons">
            <a href="/contact" class="btn-primary">Request a Free UK Quote</a>
            <a href="/about" class="btn-secondary">Learn More About Us</a>
          </div>
          <p class="wp-cta-block__sub">
            Explore our <a href="/products" class="wp-inline-link">product catalogue</a> to see what we can manufacture for your brand. Visit our <a href="/faq" class="wp-inline-link">FAQ page</a> for more information. Learn more about UK <a href="https://www.britishfashioncouncil.co.uk/" target="_blank" rel="noopener noreferrer" class="wp-inline-link">fashion industry support</a> and explore our <a href="/all-services" class="wp-inline-link">all services</a>.
          </p>
        </div>
      </div>
    </section>

  </main>

</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .wp-inline-link {
    color: #e00;
    text-decoration: none;
    transition: color 0.2s;
  }
  .wp-inline-link:hover {
    color: #aa0000;
    text-decoration: underline;
  }

  /* ── Breadcrumb ── */
  .wp-breadcrumb {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .wp-breadcrumb__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.55);
  }
  .wp-breadcrumb__list a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
  }
  .wp-breadcrumb__list a:hover {
    color: #e00;
  }
  .wp-breadcrumb__sep {
    color: rgba(255, 255, 255, 0.25);
  }

  /* ── Hero ── */
  .wp-hero {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3.5rem);
  }
  .wp-hero__inner {
    max-width: 760px;
  }
  .wp-hero__header h1 {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: 0.03em;
    margin-bottom: 1.25rem;
  }
  .wp-hero__header p {
    font-size: 0.93rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.8;
    margin-bottom: 0;
  }
  .wp-hero__cta {
    margin-top: 2rem;
  }

  /* ── Steps Grid ── */
  .wp-steps {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
  }
  .wp-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .wp-step {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .wp-step__top {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wp-step__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .wp-step__number {
    font-size: 2rem;
    font-weight: 200;
    color: #e00;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .wp-step__icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .wp-step__title {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #fff;
    line-height: 1.3;
  }
  .wp-step__desc {
    font-size: 0.83rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.8;
  }
  .wp-step__list-block {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
  }
  .wp-step__list-title {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #e00;
    margin-bottom: 0.6rem;
    font-weight: 500;
  }
  .wp-step__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .wp-step__list-item {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1.5;
  }
  .wp-step__bullet {
    color: #e00;
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  /* ── Timeline ── */
  .wp-timeline {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .wp-timeline__header {
    margin-bottom: 2.5rem;
  }
  .wp-timeline__header h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .wp-timeline__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    position: relative;
  }
  .wp-timeline__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem 0.75rem;
    border: 1px solid #e00;
    position: relative;
    background: #000;
  }
  .wp-timeline__item + .wp-timeline__item {
    border-left: none;
  }
  .wp-timeline__days {
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: 200;
    color: #e00;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .wp-timeline__label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
  }
  .wp-timeline__title {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #fff;
    line-height: 1.4;
  }

  /* ── FAQ ── */
  .wp-faq {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .wp-faq__header {
    margin-bottom: 2rem;
  }
  .wp-faq__header h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .wp-faq__list {
    max-width: 820px;
  }
  .wp-faq__item {
    border-bottom: 1px solid #e00;
  }
  .wp-faq__question {
    width: 100%;
    background: none;
    border: none;
    color: #fff;
    text-align: left;
    cursor: pointer;
    padding: 1.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    transition: color 0.2s;
  }
  .wp-faq__question:hover {
    color: #e00;
  }
  .wp-faq__question-text {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: inherit;
  }
  .wp-faq__icon {
    font-size: 1.2rem;
    font-weight: 300;
    color: #e00;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    line-height: 1;
  }
  .wp-faq__question[aria-expanded="true"] .wp-faq__icon {
    transform: rotate(45deg);
  }
  .wp-faq__answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease, padding-bottom 0.35s ease;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.85;
  }
  .wp-faq__answer.open {
    max-height: 600px;
    padding-bottom: 1.25rem;
  }

  /* ── CTA Section ── */
  .wp-cta-section {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .wp-cta-block {
    max-width: 680px;
  }
  .wp-cta-block h2 {
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }
  .wp-cta-block > p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.8;
    margin-bottom: 0;
  }
  .wp-cta-block__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    margin-bottom: 1.5rem;
  }
  .wp-cta-block__sub {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.9;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .wp-steps__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wp-timeline__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .wp-timeline__item + .wp-timeline__item {
      border-left: none;
    }
    .wp-timeline__item:nth-child(4) {
      border-left: 1px solid #e00;
    }
    .wp-timeline__item:nth-child(3) {
      border-right: 1px solid #e00;
    }
    .wp-timeline__item:nth-child(4),
    .wp-timeline__item:nth-child(5),
    .wp-timeline__item:nth-child(6) {
      border-top: none;
    }
  }

  @media (max-width: 768px) {
    .wp-steps__grid {
      grid-template-columns: 1fr;
    }
    .wp-timeline__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wp-timeline__item:nth-child(2n+1) {
      border-left: 1px solid #e00;
    }
    .wp-timeline__item:nth-child(n+3) {
      border-top: none;
    }
    .wp-timeline__item:nth-child(4) {
      border-left: none;
