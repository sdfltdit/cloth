---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Garment Trims Sourcing Bangladesh | Labels, Tags, Buttons...";
const pageDescription = "Complete trims sourcing from Bangladesh. Custom labels, hang tags, buttons, zippers, drawcords, elastics and packaging for fashion brands. OEKO-TEX certified.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl.href}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl.href,
      "url": canonicalUrl.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Garment trims sourcing service from Bangladesh providing labels, tags, buttons, zippers, and packaging to fashion brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I order trims without ordering garments from SDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our trims sourcing is a standalone service. You can order labels, tags, buttons, or any other trim component for delivery to your own factory or warehouse anywhere in the world."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to develop custom-branded trims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stock trims ship in 5-10 days. Custom-printed trims take 10-20 days. Custom-woven labels and custom-molded buttons take 20-35 days for first production including mold setup. Repeat orders of approved trims take 10-20 days."
          }
        },
        {
          "@type": "Question",
          "name": "Do trims need to match my garment fabric for sustainability claims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For GOTS organic certification, trims must also be GOTS certified. For GRS recycled claims, trim recycled content matters. For OEKO-TEX chemical safety, all trims and fabric should be OEKO-TEX certified for the cleanest claim."
          }
        },
        {
          "@type": "Question",
          "name": "What is the cost of custom-printed labels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Custom-printed satin or cotton labels typically cost $0.05-0.15 per label in bulk quantities of 1,000+ pieces. Custom-woven labels cost $0.10-0.30 per label. Costs include mold or screen setup amortized over first order."
          }
        },
        {
          "@type": "Question",
          "name": "Can you source YKK zippers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We source genuine YKK zippers in any length, color, weight, and configuration. YKK is the global premium zipper standard for fashion brands."
          }
        },
        {
          "@type": "Question",
          "name": "Do you handle care label content for different markets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We produce care labels with content appropriate for each market | bilingual EN/FR for Canada, multi-language for EU markets, single language for UK and USA. We can also add country of origin and fiber content per local labeling requirements."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Garment Trims Sourcing",
          "item": canonicalUrl.href
        }
      ]
    }
  ]
}
</script>

<meta name="keywords" content="garment trims sourcing, garment trims supplier Bangladesh, custom labels manufacturer, hang tag supplier, custom button manufacturer, zipper supplier Bangladesh, drawcord supplier, elastic supplier Bangladesh, garment packaging supplier, OEKO-TEX certified trims, woven label supplier, care label manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Garment Trims Sourcing
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Trims Sourcing | Since 1998 | OEKO-TEX Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
