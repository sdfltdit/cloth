              <th scope="col" style="padding: 1rem; text-align: left; font-weight: 600; color: var(--color-text);">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 1rem; color: var(--color-text-muted);">Week 1-2</td>
              <td style="padding: 1rem; color: var(--color-text-muted);">Set up landing page + email capture</td>
              <td style="padding: 1rem; color: var(--color-text-muted);"> | </td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 1rem; color: var(--color-text-muted);">Week 1-2</td>
              <td style="padding: 1rem; color: var(--color-text-muted);">Create social media profiles</td>
              <td style="padding: 1rem; color: var(--color-text-muted);"> | </td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 1rem; color: var(--color-text-muted);">Week 3-4</td>
              <td style="padding: 1rem; color: var(--color-text-muted);">Seed product to micro-influencers</td>
              <td style="padding: 1rem; color: var(--color-text-muted);"> | </td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
