        <table class="comparison">
          <thead>
            <tr>
              <th>Wash Type</th>
              <th>Effect</th>
              <th>Color Impact</th>
              <th>Hand Feel</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Raw Denim</td>
              <td>Authentic, rigid, develops unique fades</td>
              <td>Deep indigo, dark</td>
              <td>Rigid, stiff initially</td>
              <td>Premium positioning, denim enthusiasts</td>
            </tr>
            <tr>
              <td>Stone Wash</td>
              <td>Softened fabric, vintage appearance</td>
              <td>Muted blue, faded tones</td>
