---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Denim Jacket Manufacturer — Custom & Private | SDF";
const pageDescription = "Custom denim jacket manufacturer in Bangladesh. Trucker, oversized and fashion denim jackets from 300 pieces. Stone wash, acid wash. Private label. Free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": PHONE,
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Denim Jacket Manufacturer"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What denim weights do you use for denim jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use 10 oz denim for lightweight spring/fall jackets, 12 oz denim for standard trucker jackets, and 14 oz denim for heavyweight winter and workwear jackets. Heavier weights provide more durability and structure but increase garment weight. Weight selection depends on season and positioning."
          }
        },
        {
          "@type": "Question",
          "name": "What wash treatments do you offer for denim jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wash treatments include raw denim for authentic fade development, stone wash for vintage softness, acid wash for high-contrast mottled effects, enzyme wash for subtle color reduction, and bleach wash for dramatic lightening. Each treatment creates distinct aesthetics for different market segments."
          }
        },
        {
          "@type": "Question",
          "name": "What denim jacket styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture classic trucker jackets, oversized denim jackets for streetwear, cropped denim jackets for contemporary styling, and fashion denim jackets with unique design elements. All styles available from 300 pieces minimum with custom wash treatments and hardware."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for denim jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our denim jacket minimum is 300 pieces per style. This applies to trucker, oversized, cropped, and fashion denim jackets. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer private label denim jacket production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Private label denim jacket production is our specialty. We produce custom denim jackets with your brand labels, hang tags, and packaging. Full private label service including design consultation, sample production, bulk manufacturing, and export to destination markets. High commercial intent for private label denim jackets."
          }
        },
        {
          "@type": "Question",
          "name": "What hardware options do you offer for denim jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hardware options include metal buttons in brass, nickel, and black nickel finishes, metal rivets for authentic construction, YKK zippers in various colors, and custom zipper pulls with branding. Hardware selection impacts both authenticity and aesthetic positioning of the final garment."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce oversized denim jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We produce oversized denim jackets with drop shoulders, extended lengths, and relaxed silhouettes for streetwear positioning. Oversized construction requires pattern grading for the intended fit while maintaining structural integrity. Popular for contemporary streetwear brands seeking relaxed aesthetics."
          }
        },
        {
          "@type": "Question",
          "name": "How long does denim jacket production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 35-45 days from fabric receipt for basic denim jackets. 45-60 days for custom washes and treatments. 10-14 days for sampling before bulk. Wash development adds 5-10 days. Rush production available at 20-30% premium for urgent deadlines."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
