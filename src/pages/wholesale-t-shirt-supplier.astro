---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Wholesale T-Shirt Supplier | Bulk Tees | SDF Clothing";
const pageDescription = "Wholesale t-shirt supplier in Bangladesh. Bulk custom t-shirts for retailers and distributors. All weights and fabrics. FOB pricing from 500 pieces.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Wholesale T-Shirt Supplier",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What GSM consistency do you guarantee for wholesale t-shirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We guarantee GSM consistency within  | 5% of specified weight across all wholesale orders. Production samples are retained for each order to match future production. Fabric testing reports provided with every shipment documenting actual GSM measurements."
          }
        },
        {
          "@type": "Question",
          "name": "What are your shrinkage rates for wholesale t-shirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our shrinkage rates are controlled to maximum 5% lengthwise and 3% widthwise after washing, compliant with major retailer standards. Pre-shrunk fabric options available for tighter shrinkage control. Shrinkage testing reports provided with every shipment."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure color fastness batch-to-batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Color fastness is maintained through standardized dye houses, retained color lab dips for every order, and spectrophotometer color matching. We test for wash fastness, rub fastness, and light fastness. Color fastness reports provided with every shipment."
          }
        },
        {
          "@type": "Question",
          "name": "What is the minimum order for wholesale t-shirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wholesale minimum is 500 pieces per style, per colorway. This applies across all fabric weights and types. For established buyers with annual commitments, we can negotiate lower minimums based on total volume."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric weights are available for wholesale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 140-220 GSM cotton t-shirts in carded open end, combed ring spun, and heavyweight options. Polyester blends, tri-blends, organic cotton (GOTS), and recycled polyester (GRS) also available. All weights available at wholesale minimums."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide decoration services for wholesale t-shirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Screen printing from 500 pieces, embroidery from 500 pieces, digital printing available. Decoration pricing included in wholesale quotes. We maintain decoration quality consistency through standardized processes and retained print samples."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle re-orders for wholesale t-shirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "Text": "Re-orders processed with retained production samples ensuring GSM, color, and construction consistency. Lead time reduced to 20-25 days for re-orders. We maintain fabric stock for established buyers to accelerate re-order processing."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for t-shirt production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold GOTS for organic cotton, OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, and OCS for organic content. Full certification documentation provided with every shipment."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Wholesale T-Shirt Supplier</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Wholesale Supply | Since 1998 | Bangladesh Export</div>
        <h1 class="hero__title">Wholesale T-Shirt Supplier | Bulk Custom T-Shirts for Retailers and Brand Distributors</h1>
        <p class="hero__description">
          SDF Clothing is a wholesale t-shirt supplier in Bangladesh providing bulk custom t-shirts for retailers, distributors, and buying houses in USA, UK, Australia, Canada, and EU markets. FOB Dhaka pricing from 500 pieces minimum with guaranteed GSM consistency, controlled shrinkage rates, and batch-to-batch color fastness. All fabric weights available: 140-220 GSM cotton, polyester blends, organic cotton, and recycled materials. Explore our <a href="/clothing-manufacturers/" style="color:#e00;text-decoration:none;">clothing manufacturers</a> and <a href="/wholesale-clothing-manufacturer/" style="color:#e00;text-decoration:none;">wholesale clothing manufacturer</a>.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Request Wholesale Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20wholesale%20t-shirt%20quote`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">500</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value"> | 5%</span>
          <span class="hero__stat-label">GSM Tolerance</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Export</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">98%</span>
          <span class="hero__stat-label">On-Time Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Quality Consistency</span>
        <div class="accent-line"></div>
        <h2 class="section__title">GSM Consistency | Wholesale T-Shirt Fabric Weight Standards</h2>
      </div>
      <div class="section__text">
        <p>GSM (grams per square meter) consistency is critical for wholesale t-shirt buyers because fabric weight directly impacts perceived quality, hand feel, and customer satisfaction. Retail customers expect consistent weight across all t-shirts in a product line | variation between batches causes customer complaints and returns. SDF guarantees GSM consistency within  | 5% of specified weight across all wholesale orders. This tolerance is tighter than many suppliers who allow  | 10% variation, and our actual performance typically exceeds this guarantee with variation under  | 3%.</p>
        
        <p>We achieve GSM consistency through standardized fabric sourcing from the same mills for each fabric specification, retained fabric samples for every order to match future production, and in-house GSM testing before cutting. Every wholesale shipment includes a fabric testing report documenting actual GSM measurements from multiple points across the fabric roll. If GSM falls outside tolerance, the fabric is rejected before production begins. This strict quality control prevents weight variation from reaching retail shelves.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric Type</th>
              <th>Target GSM</th>
              <th>Tolerance</th>
              <th>Testing Method</th>
              <th>Documentation</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Lightweight Cotton</td>
              <td>140-160 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report</td>
            </tr>
            <tr>
              <td>Midweight Cotton</td>
              <td>160-180 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report</td>
            </tr>
            <tr>
              <td>Heavyweight Cotton</td>
              <td>200-220 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Polyester Blend</td>
              <td>150-180 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report</td>
            </tr>
            <tr>
              <td>Tri-Blend</td>
              <td>140-160 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report</td>
            </tr>
            <tr>
              <td>Organic Cotton (GOTS)</td>
              <td>160-180 GSM</td>
              <td> | 5%</td>
              <td>ASTM D3776</td>
              <td>Fabric test report + GOTS cert</td>
            </tr>
          </tbody>
          <caption>GSM tolerance guaranteed within  | 5% of target. Testing performed on fabric rolls before cutting. Reports included with every shipment.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Shrinkage Control</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Shrinkage Rates | Dimensional Stability Standards</h2>
      </div>
      <div class="section__text">
        <p>Shrinkage control is essential for wholesale t-shirts because dimensional stability affects fit and sizing consistency after customer washing. Excessive shrinkage causes t-shirts to become too small, leading to returns and negative reviews. SDF controls shrinkage through pre-shrunk fabric options, optimized cotton sourcing, and controlled washing during production. Our shrinkage rates are maximum 5% lengthwise and 3% widthwise after washing, compliant with major retailer standards including Walmart, Target, and Amazon requirements.</p>
        
        <p>We test shrinkage according to AATCC 135 standards (dimensional changes after laundering) and include shrinkage test reports with every wholesale shipment. For buyers requiring tighter shrinkage control, we offer pre-shrunk fabric options that undergo additional compacting during fabric production, reducing shrinkage to maximum 3% lengthwise and 2% widthwise. Pre-shrunk fabric adds approximately 3-5% to fabric cost but significantly reduces customer returns due to sizing issues.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric Type</th>
              <th>Lengthwise Shrinkage</th>
              <th>Widthwise Shrinkage</th>
              <th>Test Standard</th>
              <th>Pre-Shrunk Option</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Standard Cotton</td>
              <td>Maximum 5%</td>
              <td>Maximum 3%</td>
              <td>AATCC 135</td>
              <td>Available (+3-5% cost)</td>
            </tr>
            <tr>
              <td>Combed Ring Spun</td>
              <td>Maximum 4%</td>
              <td>Maximum 3%</td>
              <td>AATCC 135</td>
              <td>Available (+3-5% cost)</td>
            </tr>
            <tr>
              <td>Heavyweight Cotton</td>
              <td>Maximum 5%</td>
              <td>Maximum 3%</td>
              <td>AATCC 135</td>
              <td>Available (+3-5% cost)</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Polyester Blend</td>
              <td>Maximum 3%</td>
              <td>Maximum 2%</td>
              <td>AATCC 135</td>
              <td>Standard (no extra cost)</td>
            </tr>
            <tr>
              <td>Tri-Blend</td>
              <td>Maximum 4%</td>
              <td>Maximum 3%</td>
              <td>AATCC 135</td>
              <td>Available (+3-5% cost)</td>
            </tr>
            <tr>
              <td>Organic Cotton</td>
              <td>Maximum 5%</td>
              <td>Maximum 3%</td>
              <td>AATCC 135</td>
              <td>Available (+3-5% cost)</td>
            </tr>
          </tbody>
          <caption>Shrinkage tested according to AATCC 135. Reports included with every shipment. Pre-shrunk options available for tighter control.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Color Consistency</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Color Fastness | Batch-to-Batch Color Consistency</h2>
      </div>
      <div class="section__text">
        <p>Color fastness and batch-to-batch color consistency are critical for wholesale t-shirt buyers because color variation between orders damages brand perception and causes customer returns. SDF maintains color consistency through standardized dye houses with long-term partnerships, retained color lab dips for every order to match future production, and spectrophotometer color measurement for objective color matching. We test for wash fastness (AATCC 61), rub fastness (AATCC 8), and light fastness (AATCC 16) on every production batch.</p>
        
        <p>Color lab dips are physical fabric samples showing the exact color achieved in dyeing. We retain lab dips for every wholesale order and use them as reference when re-dyeing fabric for re-orders. This ensures that color on re-orders matches color on initial orders within acceptable tolerances. For buyers requiring precise color matching, we offer spectrophotometer color measurement with ?E values reported, enabling objective color evaluation and acceptance criteria. Color fastness reports are included with every shipment, documenting test results against industry standards.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Wholesale Pricing</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale T-Shirt Pricing | Volume Tiers</h2>
      </div>
      <div class="section__text">
        <p>Wholesale t-shirt pricing follows volume-based tier structures with FOB Bangladesh pricing. Unit costs decrease as order volume increases due to fabric sourcing efficiency, production setup optimization, and decoration economies of scale. Pricing below reflects basic cotton t-shirts (160-180 GSM) with single-color screen print. Pricing varies by fabric weight, decoration complexity, and order volume. We provide detailed quotes with itemized pricing for all wholesale inquiries.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Volume</th>
              <th>Price/Unit</th>
              <th>Total FOB (1000 pcs)</th>
              <th>Discount vs Standard</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>500-999 pieces</td>
              <td>$3.50 - $4.50</td>
              <td>-</td>
              <td>Standard pricing</td>
              <td>New wholesale buyers, test orders</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>1,000-4,999 pieces</td>
              <td>$2.80 - $3.80</td>
              <td>$2,800 - $3,800</td>
              <td>5-8% discount</td>
              <td>Growing retailers, seasonal orders</td>
            </tr>
            <tr>
              <td>5,000-9,999 pieces</td>
              <td>$2.30 - $3.30</td>
              <td>$11,500 - $16,500</td>
              <td>10-12% discount</td>
              <td>Established retailers, distribution</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>10,000+ pieces</td>
              <td>$2.00 - $3.00</td>
              <td>$20,000+</td>
              <td>15%+ discount</td>
              <td>Large chains, private label brands</td>
            </tr>
          </tbody>
          <caption>Prices are FOB Bangladesh for basic cotton t-shirts (160-180 GSM) with single-color screen print. Actual pricing depends on fabric, decoration, and order specifications.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale T-Shirt FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What GSM consistency do you guarantee for wholesale t-shirts?</h3>
          <p class="faq__answer">We guarantee GSM consistency within  | 5% of specified weight across all wholesale orders. Production samples are retained for each order to match future production. Fabric testing reports provided with every shipment documenting actual GSM measurements. Actual performance typically exceeds this guarantee with variation under  | 3%.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What are your shrinkage rates for wholesale t-shirts?</h3>
          <p class="faq__answer">Our shrinkage rates are controlled to maximum 5% lengthwise and 3% widthwise after washing, compliant with major retailer standards. Pre-shrunk fabric options available for tighter shrinkage control (maximum 3% lengthwise, 2% widthwise). Shrinkage testing reports provided with every shipment.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do you ensure color fastness batch-to-batch?</h3>
          <p class="faq__answer">Color fastness maintained through standardized dye houses, retained color lab dips for every order, and spectrophotometer color matching. We test for wash fastness, rub fastness, and light fastness. Color lab dips retained for re-order matching. Color fastness reports provided with every shipment.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is the minimum order for wholesale t-shirts?</h3>
          <p class="faq__answer">Wholesale minimum is 500 pieces per style, per colorway. This applies across all fabric weights and types. For established buyers with annual commitments, we can negotiate lower minimums based on total volume. Minimum can be split across sizes within a single colorway.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabric weights are available for wholesale?</h3>
          <p class="faq__answer">We offer 140-220 GSM cotton t-shirts in carded open end, combed ring spun, and heavyweight options. Polyester blends (65/35), tri-blends (50/25/25), organic cotton (GOTS certified), and recycled polyester (GRS certified) also available. All weights available at wholesale minimums.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you provide decoration services for wholesale t-shirts?</h3>
          <p class="faq__answer">Yes. Screen printing from 500 pieces with up to 6 colors, embroidery from 500 pieces, digital printing available for complex designs. Decoration pricing included in wholesale quotes. We maintain decoration quality consistency through standardized processes and retained print samples for re-order matching.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do you handle re-orders for wholesale t-shirts?</h3>
          <p class="faq__answer">Re-orders processed with retained production samples ensuring GSM, color, and construction consistency. Lead time reduced to 20-25 days for re-orders (vs 25-30 days for new orders). We maintain fabric stock for established buyers to accelerate re-order processing and ensure consistent fabric sourcing.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What certifications do you hold for t-shirt production?</h3>
          <p class="faq__answer">For wholesale t-shirt orders, we maintain GOTS for organic cotton, OEKO-TEX Standard 100 for chemical safety on fabric and prints, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled-cotton and recycled-polyester blends, and OCS for organic content claims — all backed by certificate copies included with every t-shirt shipment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Establish Wholesale T-Shirt Supply Partnership?</h2>
      <p class="section__text">
        Contact SDF Clothing for wholesale t-shirt pricing, fabric samples, and reference checks. We provide detailed quotes with itemized pricing, GSM specifications, shrinkage data, and sample arrangements. No commitment required for initial consultation.
      </p>
      <div class="section__ctas">
        <a href="/contact" class="section__cta section__cta--primary">Request Wholesale Quote</a>
        <a href="/contact" class="section__cta section__cta--secondary">Request Sample</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/t-shirt-manufacturer" style="color: var(--color-primary);">t-shirt manufacturer</a>, <a href="/wholesale-clothing-supplier" style="color: var(--color-primary);">wholesale clothing supplier</a>, <a href="/bulk-clothing-manufacturer" style="color: var(--color-primary);">bulk clothing manufacturer</a>, <a href="/low-moq-clothing-manufacturers" style="color: var(--color-primary);">low MOQ clothing manufacturers</a>, <a href="/quality-inspection-service" style="color: var(--color-primary);">quality inspection service</a>, <a href="/organic-cotton-clothing-manufacturer" style="color: var(--color-primary);">organic cotton clothing manufacturer</a>, <a href="/private-label-clothing-manufacturer" style="color: var(--color-primary);">private label manufacturer</a>, <a href="/clothing-manufacturer-bangladesh" style="color: var(--color-primary);">clothing manufacturer Bangladesh</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
