---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Wholesale Hoodie Supplier | Bulk Hoodies | SDF Clothing";
const pageDescription = "Wholesale hoodie supplier in Bangladesh. Bulk custom hoodies for retailers and gyms. Fleece and French terry options. FOB pricing from 500 pieces.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Wholesale Hoodie Supplier",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our wholesale minimum is 500 pieces per style, per colorway. This applies to both pullover and zip hoodies. For established buyers with annual commitments, we can negotiate lower minimums based on total volume across hoodie and other categories."
          }
        },
        {
          "@type": "Question",
          "name": "What fleece weights are available for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 200 GSM lightweight fleece, 280 GSM midweight fleece, and 350 GSM heavyweight fleece. French terry options also available in 260-300 GSM. All weights available at wholesale minimums with consistent quality across orders."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix pullover and zip hoodies in wholesale orders?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can order 500 pieces split between pullover and zip styles. Each style counts toward the minimum. Mix styles to offer variety in your retail assortment while maintaining wholesale volume. Pricing adjusts based on style mix."
          }
        },
        {
          "@type": "Question",
          "name": "What construction standards do you maintain for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We maintain reinforced stitching at stress points, ribbed cuffs and waistbands, lined hoods, and double-needle construction. Quality standards consistent across all orders. Construction samples retained for re-order matching."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide decoration services for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Embroidery from 500 pieces, screen printing from 500 pieces, woven labels, and hang tags included in wholesale pricing. Decoration quality consistency maintained through standardized processes and retained samples."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle re-orders for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Re-orders processed with retained production samples ensuring fabric weight, construction, and decoration consistency. Lead time reduced to 25-30 days for re-orders. We maintain fabric stock for established buyers to accelerate processing."
          }
        },
        {
          "@type": "Question",
          "name": "What is your production capacity for wholesale hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our production capacity is 50,000 hoodies per month across multiple production lines. We allocate capacity for established wholesale buyers and can scale during peak seasons with advance planning. Capacity allocation requires 3-month notice for large volume increases."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for hoodie production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold GOTS for organic cotton, OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, and additional certifications. Full documentation provided with every shipment."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Wholesale Hoodie Supplier</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Wholesale Supply | Since 1998 | Bangladesh Export</div>
        <h1 class="hero__title">Wholesale Hoodie Supplier | Bulk Custom Hoodies for Retailers and Brand Distributors</h1>
        <p class="hero__description">
          SDF Clothing is a wholesale hoodie supplier in Bangladesh providing bulk custom hoodies for retailers, distributors, gyms, and buying houses in USA, UK, Australia, Canada, and EU markets. FOB Dhaka pricing from 500 pieces minimum with fleece and French terry options, consistent construction quality, and reliable delivery. Pullover and zip hoodies available with embroidery and screen printing decoration services included. As a <a href="/wholesale-clothing-manufacturer/" style="color:#e00;text-decoration:none;">wholesale clothing manufacturer</a>, we offer competitive pricing and reliable delivery.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Request Wholesale Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20wholesale%20hoodie%20quote`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">500</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">50K</span>
          <span class="hero__stat-label">Monthly Capacity</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Export</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">98%</span>
          <span class="hero__stat-label">On-Time Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Wholesale Quality</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale Hoodie Construction Standards</h2>
      </div>
      <div class="section__text">
        <p>Wholesale hoodie buyers require consistent construction quality because hoodies are higher-ticket items where construction defects are immediately noticeable to customers. SDF maintains rigorous construction standards across all wholesale hoodie orders: reinforced stitching at stress points (shoulder seams, armholes, cuff attachments), ribbed cuffs and waistbands with proper elastic recovery, lined hoods with consistent drawstring construction, and double-needle topstitching for durability. These standards apply equally to 500-piece orders and 10,000-piece orders.</p>
        
        <p>We achieve construction consistency through standardized production processes, retained construction samples for every order to match future production, and inline quality checks at critical production stages. Every wholesale hoodie shipment includes a construction quality report documenting seam strength, cuff elasticity, and drawstring durability. Construction samples are retained in our sample library for {companyAge}+ years, enabling exact matching for re-orders. This consistency is why many retail buyers have sourced hoodies from SDF for over a decade without quality complaints.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Fleece and French Terry Options for Wholesale</h2>
      </div>
      <div class="section__text">
        <p>Fabric selection impacts hoodie positioning, seasonal suitability, and perceived quality. SDF offers comprehensive fleece and French terry options at wholesale minimums, enabling retailers to select appropriate materials for their target market and price point. Fleece weight determines warmth and perceived heft | lightweight fleece for spring/season pieces, midweight for all-season, heavyweight for winter. French terry offers lighter weight with loop-back texture for athleisure positioning. All fabrics tested for pilling resistance, colorfastness, and shrinkage control.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric Type</th>
              <th>GSM Range</th>
              <th>Season</th>
              <th>Best For</th>
              <th>Wholesale Available</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Lightweight Fleece</td>
              <td>180-220 GSM</td>
              <td>Spring/Summer</td>
              <td>Light hoodies, layering</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Midweight Fleece</td>
              <td>260-300 GSM</td>
              <td>All-Season</td>
              <td>Standard hoodies, retail</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Heavyweight Fleece</td>
              <td>320-380 GSM</td>
              <td>Fall/Winter</td>
              <td>Premium hoodies, winter</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>French Terry</td>
              <td>260-300 GSM</td>
              <td>All-Season</td>
              <td>Athleisure, gym wear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Organic Cotton Fleece</td>
              <td>280-320 GSM</td>
              <td>All-Season</td>
              <td>Sustainable brands</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Recycled Polyester Fleece</td>
              <td>280-320 GSM</td>
              <td>All-Season</td>
              <td>Eco-friendly performance</td>
              <td>Yes</td>
            </tr>
          </tbody>
          <caption>All fabrics available at 500-piece minimum. Fabric sourcing included in wholesale pricing. GSM consistency guaranteed within  | 5%.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Style Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pullover vs Zip Hoodies for Wholesale Buyers</h2>
      </div>
      <div class="section__text">
        <p>Wholesale buyers can choose between pullover hoodies and zip hoodies, or mix both styles in orders. Pullover hoodies have lower production costs due to simpler construction (no zipper, no additional front panels), while zip hoodies offer versatility and layering options that many retail customers prefer. Many retailers stock both styles | pullovers as core collection items and zip hoodies as seasonal additions. At SDF, you can order 500 pieces split between styles, or focus on one style based on your brand positioning and customer preferences.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Style</th>
              <th>Construction</th>
              <th>Cost Difference</th>
              <th>Customer Preference</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Pullover Hoodie</td>
              <td>Simpler, no zipper</td>
              <td>Base price</td>
              <td>Core collection staple</td>
              <td>Brand basics, everyday wear</td>
            </tr>
            <tr>
              <td>Zip Hoodie</td>
              <td>Zipper, front panels</td>
              <td>+$1.50-2.50 per piece</td>
              <td>Layering versatility</td>
              <td>Seasonal, transitional weather</td>
            </tr>
            <tr>
              <td>Mixed Styles</td>
              <td>Both styles</td>
              <td>Average of both</td>
              <td>Assortment variety</td>
              <td>Full collection offering</td>
            </tr>
          </tbody>
          <caption>Cost differences are approximate and depend on fabric weight and zipper quality. Mix styles within 500-piece minimum for assortment variety.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Wholesale Pricing</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale Hoodie Pricing | Volume Tiers</h2>
      </div>
      <div class="section__text">
        <p>Wholesale hoodie pricing follows volume-based tier structures with FOB Bangladesh pricing. Unit costs decrease as order volume increases due to fabric sourcing efficiency, production setup optimization, and decoration economies of scale. Pricing below reflects midweight cotton fleece hoodies (280 GSM) with basic embroidery. Pricing varies by fabric weight, style (pullover vs zip), decoration complexity, and order volume. We provide detailed quotes with itemized pricing for all wholesale inquiries.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Volume</th>
              <th>Pullover Price/Unit</th>
              <th>Zip Price/Unit</th>
              <th>Total FOB (1000 pcs)</th>
              <th>Discount vs Standard</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>500-999 pieces</td>
              <td>$8.50 - $10.50</td>
              <td>$10.00 - $12.00</td>
              <td>-</td>
              <td>Standard pricing</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>1,000-4,999 pieces</td>
              <td>$7.00 - $9.00</td>
              <td>$8.50 - $10.50</td>
              <td>$7,000 - $9,000</td>
              <td>5-8% discount</td>
            </tr>
            <tr>
              <td>5,000-9,999 pieces</td>
              <td>$6.00 - $8.00</td>
              <td>$7.50 - $9.50</td>
              <td>$30,000 - $40,000</td>
              <td>10-12% discount</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>10,000+ pieces</td>
              <td>$5.00 - $7.00</td>
              <td>$6.50 - $8.50</td>
              <td>$50,000+</td>
              <td>15%+ discount</td>
            </tr>
          </tbody>
          <caption>Prices are FOB Bangladesh for midweight cotton fleece hoodies (280 GSM) with basic embroidery. Actual pricing depends on fabric, style, decoration, and order specifications.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale Hoodie FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What is the minimum order quantity for wholesale hoodies?</h3>
          <p class="faq__answer">Our wholesale minimum is 500 pieces per style, per colorway. This applies to both pullover and zip hoodies. For established buyers with annual commitments, we can negotiate lower minimums based on total volume across hoodie and other apparel categories.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fleece weights are available for wholesale hoodies?</h3>
          <p class="faq__answer">We offer 200 GSM lightweight fleece, 280 GSM midweight fleece, and 350 GSM heavyweight fleece. French terry options also available in 260-300 GSM. All weights available at wholesale minimums with consistent quality and GSM tolerance within  | 5%.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Can I mix pullover and zip hoodies in wholesale orders?</h3>
          <p class="faq__answer">Yes. You can order 500 pieces split between pullover and zip styles. Each style counts toward the minimum. Mix styles to offer variety in your retail assortment while maintaining wholesale volume. Pricing adjusts based on style mix with zip hoodies costing approximately $1.50-2.50 more per piece.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What construction standards do you maintain for wholesale hoodies?</h3>
          <p class="faq__answer">We maintain reinforced stitching at stress points, ribbed cuffs and waistbands with proper elastic recovery, lined hoods with consistent drawstring construction, and double-needle topstitching. Quality standards consistent across all orders. Construction samples retained for re-order matching.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you provide decoration services for wholesale hoodies?</h3>
          <p class="faq__answer">Yes. Embroidery from 500 pieces, screen printing from 500 pieces, woven labels, and hang tags included in wholesale pricing. Decoration quality consistency maintained through standardized processes and retained samples for re-order matching. Decoration samples retained for every order.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do you handle re-orders for wholesale hoodies?</h3>
          <p class="faq__answer">Re-orders processed with retained production samples ensuring fabric weight, construction, and decoration consistency. Lead time reduced to 25-30 days for re-orders (vs 30-35 days for new orders). We maintain fabric stock for established buyers to accelerate re-order processing.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your production capacity for wholesale hoodies?</h3>
          <p class="faq__answer">Our production capacity is 50,000 hoodies per month across multiple production lines. We allocate capacity for established wholesale buyers and can scale during peak seasons with advance planning. Capacity allocation requires 3-month notice for large volume increases to ensure timely delivery.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What certifications do you hold for hoodie production?</h3>
          <p class="faq__answer">We hold GOTS for organic cotton, OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, OCS for organic content, and additional certifications. Full certification documentation provided with every shipment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Establish Wholesale Hoodie Supply Partnership?</h2>
      <p class="section__text">
        Contact SDF Clothing for wholesale hoodie pricing, fabric samples, and reference checks. We provide detailed quotes with itemized pricing, fabric specifications, and sample arrangements. No commitment required for initial consultation.
      </p>
      <div class="section__ctas">
        <a href="/contact" class="section__cta section__cta--primary">Request Wholesale Quote</a>
        <a href="/tools/sample-request" class="section__cta section__cta--secondary">Request Sample</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/hoodie-manufacturer" style="color: var(--color-primary);">hoodie manufacturer</a>, <a href="/wholesale-clothing-supplier" style="color: var(--color-primary);">wholesale clothing supplier</a>, <a href="/bulk-clothing-manufacturer" style="color: var(--color-primary);">bulk clothing manufacturer</a>, <a href="/wholesale-t-shirt-supplier" style="color: var(--color-primary);">wholesale t-shirt supplier</a>, <a href="/quality-inspection-service" style="color: var(--color-primary);">quality inspection service</a>, <a href="/private-label-manufacturer" style="color: var(--color-primary);">private label manufacturer</a>, <a href="/clothing-manufacturer-bangladesh" style="color: var(--color-primary);">clothing manufacturer Bangladesh</a>.
      </p>
    </div>
  </section>

<section style="padding:2rem 0;border-top:1px solid var(--color-border);margin-top:2rem"><div style="max-width:900px;margin:0 auto;padding:0 1.5rem"><h2 style="font-size:1.1rem;font-weight:600;color:var(--color-text);margin-bottom:1rem">Related Services</h2><nav aria-label="Related pages"><ul style="display:flex;flex-wrap:wrap;gap:0.75rem;list-style:none;padding:0"><li><a href="/low-moq-clothing-manufacturers" style="color:var(--color-primary)">Low MOQ Manufacturers</a></li><li><a href="/private-label-manufacturer" style="color:var(--color-primary)">Private Label</a></li><li><a href="/clothing-manufacturers-for-startups" style="color:var(--color-primary)">Startup Manufacturers</a></li><li><a href="/oem-clothing-manufacturer" style="color:var(--color-primary)">OEM Manufacturing</a></li><li><a href="/sustainable-clothing-manufacturers" style="color:var(--color-primary)">Sustainable Manufacturing</a></li><li><a href="/certifications" style="color:var(--color-primary)">Certifications</a></li><li><a href="/quality-inspection-service" style="color:var(--color-primary)">Quality Inspection</a></li><li><a href="/tech-pack-service" style="color:var(--color-primary)">Tech Pack Service</a></li><li><a href="/sampling-service" style="color:var(--color-primary)">Sampling Service</a></li><li><a href="/full-package-production" style="color:var(--color-primary)">Full Package Production</a></li><li><a href="/tools/price-calculator" style="color:var(--color-primary)">Price Calculator</a></li><li><a href="/contact" style="color:var(--color-primary)">Get a Quote</a></li></ul></nav></div></section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin: 0 var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__item a {
