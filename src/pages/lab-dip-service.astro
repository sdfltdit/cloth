---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Lab Dip Service | Color Matching Production";
const pageDescription = "Manufacture lab dip services with SDF's color matching production. We specialize in custom color manufacturing for global fashion brands.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Lab Dip Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/lab-dip-service/"
  }
];

const companyAge = getCompanyAgeString();
---

