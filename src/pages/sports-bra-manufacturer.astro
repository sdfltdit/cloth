const pageDescription = "Custom sports bra manufacturer in Bangladesh. Low, medium, high impact support from 300 pieces. Removable cups, racerback styles. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
