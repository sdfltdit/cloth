      "@type": "HowTo",
      "name": "How to Order Custom Sports Bras from SDF Clothing",
      "description": "Step-by-step process for ordering custom sports bras from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your sports bra design, support level requirements (low/medium/high impact), fabric preferences, size chart, and target quantity via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your sports bra order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review sports bra samples for fit, support level, strap construction, and cup fit within 15-20 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard sports bra items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your sports bra order"
        }
      ]
