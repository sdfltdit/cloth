---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Clothing Manufacturer for Small Business | Low MOQ 300 pcs";
const pageDescription = "Find clothing manufacturers for small business with low MOQ from 300 pieces. Full package production, sampling, and full support for startup brands today.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Clothing Manufacturer for Small Business"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for small business clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Minimum order quantities for small business clothing manufacturing typically range from 300 to 500 pieces per style. SDF Clothing offers 300-piece MOQ for most garment categories, enabling startups and small brands to test designs without large inventory commitments. Some manufacturers may offer 100-200 piece MOQs for simple products but at significantly higher per-unit costs."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find a clothing manufacturer for my small business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Find clothing manufacturers through industry directories, trade shows like MAGIC or Sourcing at MAGIC, online platforms like Alibaba or Maker's Row, and referrals from other brands. Look for manufacturers specializing in your product category with appropriate MOQ. Request samples, verify certifications, and check references before committing. Prioritize communication quality and responsiveness alongside pricing."
          }
        },
        {
          "@type": "Question",
          "name": "What should I prepare before contacting a clothing manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prepare a detailed tech pack with measurements, fabric specifications, and construction details. Define your target quantity per size and color. Have a realistic budget understanding based on market research. Prepare questions about MOQ, lead time, payment terms, and sampling process. Professional preparation signals serious intent and helps manufacturers provide accurate quotes."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to manufacture clothing for a small business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clothing manufacturing costs for small businesses range from $3-15 per piece FOB depending on product complexity, fabric quality, and order quantity. Basic t-shirts cost $3-8 at 300-piece MOQ. Hoodies cost $8-15. Jackets cost $12-25. Add 25-35% for landed cost including freight, duty, and other import charges. Sample costs add $300-800 per style before bulk production."
          }
        },
        {
          "@type": "Question",
          "name": "Can I negotiate MOQ with manufacturers as a small business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some manufacturers may negotiate MOQ for promising designs or long-term partnership potential. Offer to pay higher per-unit pricing for smaller quantities. Propose starting with one colorway at lower MOQ, expanding colors after initial success. Combine multiple styles into one order to meet volume thresholds. However, expect higher costs and limited negotiation power as a new customer."
          }
        },
        {
          "@type": "Question",
          "name": "What are the risks of working with overseas manufacturers for small businesses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Risks include communication challenges due to time zones and language barriers, longer lead times affecting cash flow, quality control difficulties from distance, intellectual property concerns in some regions, and payment security issues. Mitigate these risks through clear contracts, third-party quality inspections, secure payment methods, and starting with smaller test orders before scaling."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take for small business clothing orders?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Production timeline for small business clothing orders typically 45-60 days from fabric receipt. Sampling adds 7-14 days before bulk. Ocean freight to US/Europe adds 25-35 days. Total order-to-delivery timeline 75-100 days for ocean freight. Air freight reduces shipping to 5-7 days but costs 3-4x more. Plan production 4-5 months ahead of sales season to ensure timely delivery."
          }
        },
