---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Frequently Asked Questions — Clothing Manufacturer FAQ";
const pageDescription = "Complete FAQ for fashion brands sourcing from Bangladesh. MOQ, payment, lead time, certifications, quality, shipping and more. 28 detailed answers covered.";

const allFaqs = [
  {
    category: "Pricing and Minimum Orders",
    questions: [
      {
        question: "What is your minimum order quantity for apparel manufacturing?",
        answer: "Our MOQ is 300 pieces per style with flexible size and colour combinations. This low minimum makes us ideal for startup brands and boutique labels sourcing from Dhaka garment factories."
      },
      {
        question: "How do you price your apparel manufacturing services?",
        answer: "All quotes are FOB Chittagong or Dhaka covering fabric, dyeing, finishing, cut and sew, AQL 2.5 inspection, and port delivery. We provide transparent pricing with no hidden charges."
      },
      {
        question: "What are your payment terms for bulk orders?",
        answer: "We accept T/T, L/C, and bank transfers. Standard terms are 30% deposit to start production and 70% before shipment. Free samples are available for confirmed bulk orders."
      },
      {
        question: "Do you charge extra for labels, hang tags, and packaging?",
        answer: "No. Personalized woven labels, hang tags, branded packaging, and poly bags are included at no extra charge when you order with us. This is part of our full-package manufacturing service."
      }
    ]
  },
  {
    category: "Production and Timeline",
    questions: [
      {
        question: "How long does bulk garment production take?",
        answer: "Standard lead time is 40 days for bulk orders. Sample development takes 7-14 days. Our streamlined process ensures on-time delivery for your fashion production needs."
      },
      {
        question: "Can I mix sizes and colours within the 300 piece MOQ?",
        answer: "Yes. Our 300 piece MOQ allows flexible size and colour combinations. You can distribute the 300 pieces across multiple sizes and colours within the same style."
      },
      {
        question: "What is your maximum production capacity per order?",
        answer: "We can handle orders up to 50,000 pieces per style with a 40-day lead time. For larger orders, we can discuss staggered delivery schedules to meet your timeline."
      },
      {
        question: "Do you offer rush production for urgent orders?",
        answer: "Yes. We offer expedited production for urgent orders with reduced lead times. Additional rush fees may apply. Contact us directly with your timeline requirements."
      }
    ]
  },
  {
    category: "Quality and Certifications",
    questions: [
      {
        question: "What quality standards do you follow?",
        answer: "We follow AQL 2.5 inspection standards for all orders. Our quality control team checks fabric, stitching, measurements, and finishing at multiple production stages."
      },
      {
        question: "What certifications do you hold?",
        answer: "We hold international certifications including GOTS, OEKO-TEX, ISO 9001, BSCI, SEDEX, GRS, C-TPAT, WRAP, SA8000, ISO 14001, and BCI."
      },
      {
        question: "What does GOTS certification mean for my brand?",
        answer: "GOTS certification ensures your garments are made with organic cotton and meet strict environmental and social criteria. This is essential for brands targeting eco-conscious consumers."
      },
      {
        question: "How do you ensure consistent quality across orders?",
        answer: "We maintain detailed quality records for each client, use approved fabric suppliers, and follow standardized production processes. This ensures consistency whether you order 300 or 30,000 pieces."
      },
      {
        question: "What is your defect and rejection rate?",
        answer: "We follow AQL 2.5 inspection standards on every order. Our actual rejection rate runs below 0.8% — well within international garment industry norms. Every order goes through in-line quality checks during production and a final inspection before packing. Third-party inspection by SGS, Bureau Veritas, or Intertek is available on request."
      },
      {
        question: "Are you a vertically integrated clothing manufacturer?",
        answer: "Yes. SDF Clothing is a vertically integrated clothing manufacturer — meaning we handle everything in-house from fabric and yarn sourcing through cutting, sewing, finishing, and packaging. We are also a wholesale clothing manufacturer for bulk buyers and a private label clothing manufacturer for fashion brands building their own labels. This vertical integration gives you faster turnaround, consistent quality, and direct accountability — no middlemen, no outsourcing surprises."
      }
    ]
  },
  {
    category: "Shipping and Logistics",
    questions: [
      {
        question: "What shipping options do you offer?",
        answer: "We offer FOB delivery from Chittagong or Dhaka ports. We can arrange sea freight or air freight based on your timeline and budget requirements."
      },
      {
        question: "Do you handle customs documentation?",
        answer: "Yes. We provide all necessary export documentation including commercial invoices, packing lists, certificates of origin, and any required compliance certificates for your destination market."
      },
      {
        question: "What is your on-time delivery rate?",
        answer: "Our on-time delivery rate is 98%. We track production schedules closely and communicate proactively if any delays are anticipated, giving you time to adjust your plans."
      },
      {
        question: "Can you ship directly to my warehouse?",
        answer: "Yes. We can arrange door-to-door delivery to your warehouse or fulfillment center. We work with reliable freight forwarders to ensure smooth customs clearance and delivery."
      }
    ]
  },
  {
    category: "Sustainability and Ethics",
    questions: [
      {
        question: "What sustainable materials do you offer?",
        answer: "We offer GOTS organic cotton, GRS recycled polyester, and BCI Better Cotton. We can source other sustainable materials based on your requirements."
      },
      {
        question: "How do you minimize environmental impact?",
        answer: "Our ISO 14001 certified facilities follow strict environmental management practices. We use eco-friendly dyes, reduce water consumption, and properly treat wastewater before discharge."
      },
      {
        question: "Are your factories ethically compliant?",
        answer: "Yes. Our BSCI, SEDEX, WRAP, and SA8000 certifications ensure fair labor practices, safe working conditions, and compliance with international labor standards."
      }
    ]
  },
  {
    category: "Getting Started",
    questions: [
      {
        question: "What makes SDF Clothing the right Low MOQ clothing manufacturer for startup fashion brands?",
        answer: "With 300 pieces MOQ, GOTS certification since 1998, and global shipping to EU, UK, USA, Canada, and Australia, we provide full-package manufacturing from fabric sourcing to finished garments specifically designed for first-time fashion brand owners."
      },
      {
        question: "How do I get a quote for my fashion line?",
        answer: "Fill out our quote form with your garment type, quantity, and requirements. You can also contact us via WhatsApp for faster response. We provide quotes within 48 hours."
      },
      {
        question: "Do I need a tech pack to get started?",
        answer: "A tech pack is helpful but not required initially. If you have reference images or detailed descriptions, we can work with those. Our design team can also help create tech packs."
      },
      {
        question: "How long does sample development take?",
        answer: "Sample development typically takes 7-14 days depending on complexity. We provide proto samples for fit approval, then pre-production samples before bulk manufacturing."
      },
      {
        question: "What information do you need to provide a quote?",
        answer: "We need garment type, fabric preference, quantity per style, size breakdown, desired delivery date, and any special requirements like printing or embroidery."
      },
      {
        question: "What is the difference between OEM and ODM manufacturing?",
        answer: "OEM means we make garments using your designs and tech pack. ODM means we design the garment for you and you put your brand on it. Both start from 300 pieces. OEM is better if you have a finished design. ODM is better if you need help creating the design from scratch. We offer both services from our factory in Dhaka."
      },
      {
        question: "Do you accept wholesale and bulk garment orders?",
        answer: "Yes. We handle wholesale clothing orders and bulk garment production from 300 pieces to 50,000 pieces per style. Wholesale buyers, boutique retailers, and fashion distributors all order from us. FOB pricing is available for all bulk orders. Contact us for a wholesale price list."
      }
    ]
  }
];
const faqPageUrl = "https://sdfltd.com/faq/";
const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": faqPageUrl,
      "url": faqPageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": { "@id": "https://sdfltd.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "FAQ" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": allFaqs.flatMap(category => category.questions.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      })))
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div style="max-width:1200px;margin:0 auto;padding:0 2rem;">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">›</span>
        FAQ
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Since 1998 · 28 Questions Answered</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Frequently Asked Questions — Clothing and Garment Manufacturing
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Looking for answers about clothing and garment manufacturing with SDF Clothing? This complete FAQ covers everything fashion brands need to know — from minimum order quantities and payment terms to certifications, quality standards, lead times, and shipping. If you have a question not answered here, contact our team directly.
    </p>
  </div>
</section>

<!-- FAQ Content -->
<section style="padding:5rem 0;">
  <div style="max-width:1000px;margin:0 auto;padding:0 2rem;">
    {allFaqs.map(category => (
      <div style="margin-bottom:4rem;">
        <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:2rem;">
          {category.category}
        </h2>
        <div style="background:#000;border:1px solid rgba(255,255,255,0.1);">
          {category.questions.map((faq, index) => (
            <details style="border-bottom:1px solid rgba(255,255,255,0.1);" open={index === 0}>
              <summary style="padding:1.5rem;cursor:pointer;color:#fff;font-size:0.95rem;font-weight:500;display:flex;justify-content:space-between;align-items:center;list-style:none;">
                {faq.question}
                <span style="font-size:1.5rem;color:#e00;">+</span>
              </summary>
              <div style="padding:0 1.5rem 1.5rem;">
                <p style="color:#FFFFFF;line-height:1.8;font-size:0.9rem;margin:0;">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CTA Section -->
<section style="padding:5rem 0;border-top:1px solid rgba(255,255,255,0.1);">
  <div style="max-width:800px;margin:0 auto;padding:0 2rem;text-align:center;">
    <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1.5rem;">
      Still Have Questions?
    </h2>
    <p style="color:#FFFFFF;max-width:600px;margin:0 auto 2rem;line-height:1.8;font-size:0.95rem;">
      Our team responds to most inquiries within 24 hours. Send us your specific questions about fabric, production, certifications, or shipping — we will give you a clear answer with relevant documentation.
    </p>
    <a href="/contact/" style="display:inline-block; padding:0.85rem 2rem; background:#e00; color:#fff; text-decoration:none; font-size:0.78rem; letter-spacing:0.12em; text-transform:uppercase; font-weight:600; transition:all 0.3s ease;">
      Contact Our Team ?
    </a>
  </div>
</section>


    </BaseLayout>







