---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "White Label Clothing Manufacturing | Private Label Apparel Production";
const pageDescription = "White label clothing manufacturing for your brand. We produce high-quality garments with your branding. 300-piece MOQ, fast turnaround. Start your clothing line today.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "White Label",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/white-label/"
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
	<!-- Robots Meta -->
	<meta name="robots" content="index, follow" />
	
	<!-- Open Graph Tags -->





	
	<!-- Twitter Card -->





	<!-- Breadcrumb Navigation -->
	<nav aria-label="Breadcrumb" class="py-4 px-4 bg-black/50">
		<div class="container mx-auto max-w-7xl">
			<ol class="flex items-center space-x-2 text-sm">
				<li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
				<li class="text-white/40">/</li>
				<li><span class="text-white">White Label</span></li>
			</ol>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="py-16 px-4 bg-gradient-to-b from-black to-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h1 class="text-3xl md:text-5xl font-bold text-white mb-6">
				White Label Clothing Manufacturing: Your Brand, Our Production
			</h1>
			<p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8">
				We manufacture high-quality clothing and put your brand on it. You get ready-to-sell products without the hassle of production. Perfect for startups, retailers, and businesses.
			</p>
			<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
			 Start Your White Label Line
			</a>
		</div>
	</section>

	<!-- What is White Label -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				What is White Label Clothing?
			</h2>
			<p class="text-white/80 leading-relaxed mb-6">
				White label means we manufacture clothing products and you sell them under your own brand name. Think of it like this: we make the clothes, add your labels and branding, and you sell them as if you made them yourself.
			</p>
			<p class="text-white/80 leading-relaxed mb-6">
				This is different from private label where you design everything from scratch. With white label, we have proven designs and quality products ready to go. You choose the styles, add your brand identity, and start selling faster.
			</p>
			<p class="text-white/80 leading-relaxed">
				It's the fastest way to launch a clothing line because you skip the design and development phase. You get professional, tested products that customers love.
			</p>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				How White Label Manufacturing Works
			</h2>
			<p class="text-white/80 leading-relaxed mb-12 text-center">
				The process is simple and straightforward:
			</p>

			<div class="space-y-8">
				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 1: Choose Your Products</h3>
					<p class="text-white/70 leading-relaxed">
						Browse our catalog of ready-made designs. We offer t-shirts, hoodies, polo shirts, dresses, and many other styles. Select the products that fit your brand and target market.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 2: Customize Your Branding</h3>
					<p class="text-white/70 leading-relaxed">
						Send us your logo, brand colors, and label design. We'll add your woven labels, hang tags, and packaging to the products. If you need help with branding, we can assist with that too.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 3: Select Colors & Sizes</h3>
					<p class="text-white/70 leading-relaxed">
						Choose the colors and size breakdown you need. We offer flexible sizing from XS to 3XL. You can mix sizes within your order to meet your customers' needs.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 4: Place Your Order</h3>
					<p class="text-white/70 leading-relaxed">
						Minimum order is just 300 pieces per style. Tell us your quantity and we'll provide a quote. Our pricing is transparent with no hidden fees.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 5: Production & Delivery</h3>
					<p class="text-white/70 leading-relaxed">
						We manufacture your order, apply your branding, and ship it to you. Standard production time is 40 days. We handle quality control before shipping.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Products Available -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				White Label Products We Offer
			</h2>
			<p class="text-white/80 leading-relaxed mb-12 text-center">
				We have a wide range of ready-made designs for white label production:
			</p>

			<div class="grid md:grid-cols-3 gap-6">
				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">T-Shirts</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Basic, premium, and fashion t-shirts in various styles
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">Hoodies & Sweatshirts</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Pull-over, zip-up, and crewneck styles
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">Polo Shirts</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Classic and modern polo designs
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">Dresses</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Casual, formal, and party dresses
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">Pants & Shorts</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Jeans, chinos, joggers, and casual shorts
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800 text-center">
					<h3 class="text-lg font-bold text-white mb-2">Activewear</h3>
					<p class="text-white/70 leading-relaxed text-sm">
						Leggings, sports bras, and workout tops
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Why Choose White Label Manufacturing?
			</h2>

			<div class="grid md:grid-cols-2 gap-6 mt-8">
				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Fast Launch</h3>
					<p class="text-white/70 leading-relaxed">
						Skip design and development. Start selling in weeks, not months. Perfect for quick market entry.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Low Risk</h3>
					<p class="text-white/70 leading-relaxed">
						Products are already tested and proven. Lower risk of poor quality or design failures.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Low Minimum Order</h3>
					<p class="text-white/70 leading-relaxed">
						Start with just 300 pieces. Test the market with small orders before scaling up.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Professional Quality</h3>
					<p class="text-white/70 leading-relaxed">
						Our products are made with premium materials and expert craftsmanship. Your customers will love them.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Full Branding Control</h3>
					<p class="text-white/70 leading-relaxed">
						Your brand is front and center. Labels, tags, and packaging all carry your identity.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Scalable</h3>
					<p class="text-white/70 leading-relaxed">
						Start small and grow. We can handle orders from 300 to 50,000 pieces as your business expands.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Who Is This For -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Who Is White Label For?
			</h2>
			
			<div class="space-y-6 mt-8">
				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Fashion Startups</h3>
						<p class="text-white/70 leading-relaxed">
							New brands who want to launch quickly without spending months on design and development.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Retailers</h3>
						<p class="text-white/70 leading-relaxed">
							Shops wanting to create their own branded clothing line without manufacturing expertise.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">E-commerce Sellers</h3>
						<p class="text-white/70 leading-relaxed">
							Online businesses looking to expand into private label apparel with minimal investment.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Influencers & Creators</h3>
						<p class="text-white/70 leading-relaxed">
							Social media personalities wanting to launch merchandise with professional quality.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Corporate Clients</h3>
						<p class="text-white/70 leading-relaxed">
							Companies needing branded uniforms or promotional clothing for employees and events.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Pricing & Minimum Order
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				White label production starts at <strong class="text-white">300 pieces per style</strong>. This low minimum lets you test products without big upfront investment.
			</p>
			<p class="text-white/80 leading-relaxed mb-8">
				Pricing depends on the product type, fabric, quantity, and customization level. We offer competitive wholesale pricing that gives you healthy profit margins.
			</p>
			<p class="text-white/80 leading-relaxed mb-8">
				Your branded labels, hang tags, and basic packaging are included at no extra cost when you order with us.
			</p>
			<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				Get Pricing
			</a>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Ready to Start Your White Label Line?
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				Launch your clothing brand quickly with our proven, high-quality products. Get in touch today for a free quote.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				 Get Free Quote
				</a>
				<a href="/full-package-production" class="bg-transparent border border-white text-white px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					Compare with Full Package
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
