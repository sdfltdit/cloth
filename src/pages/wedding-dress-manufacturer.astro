---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Wedding Dress Manufacturer Bangladesh | Custom Bridal Pro...";
const pageDescription = "Professional wedding dress manufacturer from Bangladesh. Custom wedding gowns and bridesmaid dresses with beadwork, lace and premium fabrics. From 300 pieces.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Wedding dress manufacturer from Bangladesh providing custom wedding gowns and bridesmaid dresses with beadwork, lace work, premium fabrics, and intricate construction to bridal brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for wedding dresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What bridal products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture wedding gowns, bridesmaid dresses, mother of the bride dresses, flower girl dresses, and bridal accessories. All products feature premium fabrics and intricate construction."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer beadwork and embellishments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer beadwork, sequin work, crystal embellishments, lace appliques, embroidery, and other decorative elements. All embellishment work is done by skilled artisans with attention to detail."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics do you use for wedding dresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use premium fabrics including satin, chiffon, tulle, organza, lace, silk blends, and crepe. All fabrics are sourced from quality mills and selected for their drape, appearance, and suitability for bridal wear."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce custom wedding gown designs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We can produce custom wedding gown designs from your sketches or technical specifications. Our pattern makers and sample team can bring your vision to life with premium construction and attention to detail."
          }
        },
        {
          "@type": "Question",
          "name": "How long does wedding dress production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 40-50 days from fabric receipt for basic wedding dresses. 50-70 days for custom designs with extensive beadwork or lace work. 14-21 days for sampling before bulk."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Wedding Dress Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="wedding dress manufacturer, bridal gown manufacturer, bridesmaid dress manufacturer, custom wedding dress production, bridal wear manufacturer Bangladesh" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Wedding Dress Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Wedding Dress Manufacturer | Since 1998 | Premium Bridal</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Wedding Dress Manufacturer for Bridal Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Wedding dresses demand premium fabrics, intricate beadwork, lace work, and exceptional construction. Every detail matters for the most important day. SDF Clothing, a full-service clothing manufacturer in Bangladesh, produces wedding dresses with skilled artisans and premium materials. From 300 pieces per style.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20wedding-dress-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Premium</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Fabrics</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">40-50</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Beadwork</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Specialist</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Wedding Dress Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our wedding dress manufacturing covers the full production cycle from fabric sourcing to finished garment. We source premium bridal fabrics, cut, sew with intricate construction techniques, apply beadwork and embellishments, and package with care.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Production capacity: 20,000-30,000 wedding dresses and bridal pieces per month across specialized production lines. We handle simple wedding dresses for wholesale, intricate gowns for boutique brands, and custom bridal collections.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Premium Fabric Options</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Satin</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic bridal satin with smooth surface and lustrous finish. Available in various weights from lightweight charmeuse to heavy duchess satin. Ideal for structured gowns and formal bridal wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Chiffon and Tulle</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Lightweight chiffon and tulle for ethereal, romantic styles. Sheer and flowing for skirts, overlays, and sleeves. Available in various qualities including silk chiffon for premium bridal wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Lace</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Premium lace options including Chantilly lace, Alen - on lace, Guipure lace, and corded lace. Intricate patterns and delicate details for romantic bridal designs. Available in various widths and qualities.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Organza and Crepe</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Crisp organza for structured elements and crepe for elegant drape. Both fabrics offer premium appearance and are suitable for modern bridal styles.
    </p>
  </div>
</section>

<!-- Products Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Bridal Products We Manufacture</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Wedding gowns (ball gown, A-line, mermaid, sheath)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bridesmaid dresses (various styles and colors)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Mother of the bride dresses
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Flower girl dresses
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bridal accessories (veils, sashes, jackets)
      </li>
    </ul>
  </div>
</section>

<!-- Embellishments Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Embellishments</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Beadwork and Embellishment Techniques</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Beadwork (seed beads, crystals, pearls)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sequin work for sparkle and glamour
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Lace appliques and overlays
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Embroidery for decorative details
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Crystal embellishments and rhinestone work
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Simple wedding dress (satin): $80-150 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Wedding dress with lace: $120-220 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Intricate gown with beadwork: $200-400 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes premium fabric, cut, sew, basic construction, and standard packaging. Extensive beadwork, custom lace work, and premium packaging are additional.
    </p>
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Wedding Dress Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard wedding dress production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fabric sourcing: 7-14 days (premium bridal fabrics)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sampling: 14-21 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bulk production: 40-50 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quality inspection: 3-5 days
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Packing and shipping: 5-7 days
      </li>
    </ul>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Total timeline: 70-100 days from order to delivery. Custom designs and extensive beadwork add 10-20 days. Rush production available at 30-40% premium.
    </p>
  </div>
</section>

<!-- FAQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Common Questions</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Frequently Asked Questions</h2>
    </div>
    
    <div style="max-width:800px;">
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What is the minimum order for wedding dresses?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What bridal products do you manufacture?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We manufacture wedding gowns, bridesmaid dresses, mother of the bride dresses, flower girl dresses, and bridal accessories. All products feature premium fabrics and intricate construction.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">Do you offer beadwork and embellishments?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Yes. We offer beadwork, sequin work, crystal embellishments, lace appliques, embroidery, and other decorative elements. All embellishment work is done by skilled artisans with attention to detail.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What fabrics do you use for wedding dresses?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We use premium fabrics including satin, chiffon, tulle, organza, lace, silk blends, and crepe. All fabrics are sourced from quality mills and selected for their drape, appearance, and suitability for bridal wear.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">Can you produce custom wedding gown designs?</h3>
