---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Philanthropy | SDF Clothing";
const pageDescription = "SDF Clothing's philanthropy initiatives - tree plantation program, water recycling technology, and community development projects in Bangladesh.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="container">
		<!-- Breadcrumb -->
		<nav aria-label="Breadcrumb" style="margin: 2rem 0;">
			<p style="font-size: 0.8rem; color: #aaa;">
				<a href="/" style="color: #ffffff;">Home</a> &gt; Philanthropy
			</p>
		</nav>
		
		<!-- Main Content -->
		<article>
			<h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 2rem; color: #fff;">
				SDF Clothing Philanthropy
			</h1>
			
			<p style="font-size: 1.1rem; color: #aaa; line-height: 1.8; margin-bottom: 3rem;">
				At SDF Clothing, we believe in giving back to our community and environment. As Bangladesh's leading clothing manufacturer since 1998, we've implemented several initiatives to create sustainable impact beyond our manufacturing operations.
			</p>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Tree Plantation Program
			</h2>
			
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Environmental Commitment
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						For every order placed, we plant trees in collaboration with local environmental organizations. Our tree plantation program has resulted in over 10,000 trees planted since 2020, contributing to Bangladesh's reforestation efforts.
					</p>
				</div>
				
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Water Recycling Initiative
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						We've invested in advanced water recycling technology at our manufacturing facility, reducing water consumption by 40% and implementing closed-loop water systems for sustainable garment production.
					</p>
				</div>
			</div>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Community Development
			</h2>
			
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Education Support
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						We support local schools and vocational training programs in Dhaka, focusing on textile education and skills development for the next generation of garment industry professionals.
					</p>
				</div>
				
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Healthcare Initiatives
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						Annual health check-ups and medical support programs for our employees and their families in the local community around our manufacturing facility.
					</p>
				</div>
			</div>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Get Involved
			</h2>
			
			<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem; text-align: center;">
				<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.5rem;">
					To learn more about our philanthropy initiatives or to partner with us on community projects, please contact our CSR team.
				</p>
				<div style="margin-top: 1.5rem;">
					<a href="/contact" style="display: inline-block; background: #cc0000; color: #000; padding: 0.8rem 2rem; text-decoration: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; border-radius: 4px;">
						Contact CSR Team
					</a>
				</div>
			</div>
		</article>
		
		<!-- Footer Link -->
		<div style="text-align: center; margin: 4rem 0 2rem; padding-top: 2rem; border-top: 1px solid #1a1a1a;">
			<p style="color: #aaa; font-size: 0.9rem;">
				Together, we're building a more sustainable future for <a href="/" style="color: #ffffff;">Bangladesh's garment industry</a> and our global community.
			</p>
		</div>
	</div>
	
</BaseLayout>