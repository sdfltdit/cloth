---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Wholesale Activewear Supplier | Bulk Gym | SDF Clothing";
const pageDescription = "Wholesale activewear supplier in Bangladesh. Bulk leggings, sports bras and sets for retailers and gyms. Technical fabrics. FOB from 500 pieces. Request a quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Wholesale Activewear Supplier",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What size run consistency do you guarantee for wholesale activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We guarantee size run consistency within  | 2% tolerance across all wholesale orders. Grading retained for each style to match future production. Size measurement reports provided with every shipment documenting actual measurements across size range."
          }
        },
        {
          "@type": "Question",
          "name": "What is your pilling resistance standard for wholesale activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our pilling resistance meets Martindale test standard of 20,000 cycles minimum for wholesale activewear. This exceeds industry average of 15,000 cycles. Pilling test reports provided with every shipment. Anti-pilling treatments available for enhanced performance."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure seam strength for wholesale activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Seam strength tested according to ASTM D1683 with minimum 80N force requirement for wholesale activewear. Reinforced stitching at stress points, four-thread overlock for durability. Seam strength reports included with every shipment."
          }
        },
        {
          "@type": "Question",
          "name": "What is the minimum order for wholesale activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wholesale minimum is 500 pieces per style, per colorway. This applies to leggings, sports bras, and sets. For established buyers with annual commitments, we can negotiate lower minimums based on total volume."
          }
        },
        {
          "@type": "Question",
          "name": "What technical fabrics are available for wholesale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 4-way stretch polyester, moisture-wicking blends, compression fabrics, bamboo blends, recycled polyester (GRS certified), and organic cotton blends. All fabrics tested for stretch recovery, moisture management, and durability at wholesale volumes."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide plus size activewear for wholesale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Plus size activewear available from 500 pieces minimum. Extended size ranges up to 5XL with specialized grading for activewear fit. Same quality standards and construction techniques across all sizes. Inclusive sizing from wholesale launch."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle re-orders for wholesale activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Re-orders processed with retained production samples ensuring size run, fabric performance, and construction consistency. Lead time reduced to 25-30 days for re-orders. We maintain fabric stock for established buyers to accelerate processing."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for activewear production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, OCS for organic content, and additional certifications. Full certification documentation provided with every shipment."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Wholesale Activewear Supplier</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Wholesale Supply | Since 1998 | Bangladesh Export</div>
        <h1 class="hero__title">Wholesale Activewear Supplier | Bulk Gym Wear and Leggings for Retailers and Fitness Distributors</h1>
        <p class="hero__description">
          SDF Clothing is a wholesale activewear supplier in Bangladesh providing bulk leggings, sports bras, and sets for retailers, gyms, fitness distributors, and buying houses in USA, UK, Australia, Canada, and EU markets. FOB Dhaka pricing from 500 pieces minimum with technical fabrics, guaranteed size run consistency, pilling resistance, and seam strength standards. Plus size activewear available with inclusive sizing options. As a <a href="/wholesale-clothing-manufacturer/" style="color:#e00;text-decoration:none;">wholesale clothing manufacturer</a>, we ensure quality and consistency.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Request Wholesale Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20wholesale%20activewear%20quote`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">500</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">20K</span>
          <span class="hero__stat-label">Pilling Cycles</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Export</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">98%</span>
          <span class="hero__stat-label">On-Time Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Quality Standards</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Size Run Consistency for Wholesale Activewear</h2>
      </div>
      <div class="section__text">
        <p>Size run consistency is critical for wholesale activewear buyers because fitness customers expect precise fit across the size range. Variation between sizes causes customer returns and negative reviews, particularly for form-fitting activewear like leggings and sports bras. SDF guarantees size run consistency within  | 2% tolerance across all wholesale orders. This tolerance is tighter than many suppliers who allow  | 5% variation, and our actual performance typically exceeds this guarantee with variation under  | 1.5%.</p>
        
        <p>We achieve size consistency through retained grading patterns for every style, standardized measurement protocols during production, and inline quality checks at the cutting and sewing stages. Every wholesale activewear shipment includes a size measurement report documenting actual measurements for each size in the range. If measurements fall outside tolerance, the production lot is rejected before shipment. This strict quality control prevents size variation from reaching retail shelves, which is particularly important for activewear where fit is a primary purchase factor.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Durability Standards</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pilling Resistance and Seam Strength</h2>
      </div>
      <div class="section__text">
        <p>Wholesale activewear buyers, particularly gyms and sports retailers, require durable products that withstand repeated washing and intense physical activity. Pilling (fabric balling) and seam failure are the two most common activewear quality issues that cause customer returns. SDF addresses both through strict testing standards: pilling resistance tested to Martindale 20,000 cycles minimum (exceeding industry 15,000 cycle average), and seam strength tested to ASTM D1683 minimum 80N force requirement.</p>
        
        <p>We achieve these durability standards through fabric selection (high-tenacity yarns for pilling resistance), reinforced stitching at stress points (four-thread overlock for activewear seams), and pre-production testing on all fabrics and construction methods. Pilling and seam strength test reports are included with every wholesale shipment, documenting actual test results against our standards. For buyers requiring enhanced durability, we offer anti-pilling fabric treatments and reinforced seam options at additional cost.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Quality Metric</th>
              <th>SDF Standard</th>
              <th>Industry Average</th>
              <th>Test Method</th>
              <th>Documentation</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Pilling Resistance</td>
              <td>20,000 cycles minimum</td>
              <td>15,000 cycles</td>
              <td>Martindale</td>
              <td>Test report</td>
            </tr>
            <tr>
              <td>Seam Strength</td>
              <td>80N minimum</td>
              <td>60N</td>
              <td>ASTM D1683</td>
              <td>Test report</td>
            </tr>
            <tr>
              <td>Stretch Recovery</td>
              <td>95% recovery</td>
              <td>90% recovery</td>
              <td>ASTM D2594</td>
              <td>Test report</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Color Fastness (Wash)</td>
              <td>Grade 4-5</td>
              <td>Grade 3-4</td>
              <td>AATCC 61</td>
              <td>Test report</td>
            </tr>
            <tr>
              <td>Moisture Wicking</td>
              <td>90% wicking</td>
              <td>80% wicking</td>
              <td>AATCC 79</td>
              <td>Test report</td>
            </tr>
          </tbody>
          <caption>SDF standards exceed industry averages across all key activewear quality metrics. Test reports included with every shipment.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Technical Fabrics</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Fabric Options for Wholesale</h2>
      </div>
      <div class="section__text">
        <p>Technical fabric selection determines activewear performance characteristics including moisture management, stretch recovery, compression, and durability. SDF offers comprehensive technical fabric options at wholesale minimums, enabling retailers to select appropriate materials for their target market and price point. All fabrics are tested for performance metrics before bulk production, with test reports included in wholesale shipments. Fabric sourcing is included in pricing, and we maintain fabric stock for established buyers to accelerate re-order processing.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric Type</th>
              <th>Composition</th>
              <th>Key Features</th>
              <th>Best For</th>
              <th>Wholesale Available</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>4-Way Stretch Polyester</td>
              <td>88% Polyester, 12% Spandex</td>
              <td>4-way stretch, moisture-wicking</td>
              <td>Leggings, performance wear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Compression Fabric</td>
              <td>80% Nylon, 20% Spandex</td>
              <td>High compression, muscle support</td>
              <td>Sports bras, compression wear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Moisture-Wicking Blend</td>
              <td>85% Polyester, 15% Spandex</td>
              <td>Quick-dry, breathable</td>
              <td>Gym wear, training gear</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Bamboo Blend</td>
              <td>70% Bamboo, 30% Cotton</td>
              <td>Soft, antimicrobial, sustainable</td>
              <td>Yoga wear, wellness brands</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Recycled Polyester (GRS)</td>
              <td>85% Recycled Polyester, 15% Spandex</td>
              <td>Sustainable, performance</td>
              <td>Eco-friendly activewear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Organic Cotton Blend</td>
              <td>90% Organic Cotton, 10% Spandex</td>
              <td>Natural feel, light stretch</td>
              <td>Yoga, low-impact activities</td>
              <td>Yes</td>
            </tr>
          </tbody>
          <caption>All fabrics available at 500-piece minimum. Performance testing included. Fabric sourcing included in wholesale pricing.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Wholesale Pricing</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale Activewear Pricing | Volume Tiers</h2>
      </div>
      <div class="section__text">
        <p>Wholesale activewear pricing follows volume-based tier structures with FOB Bangladesh pricing. Unit costs decrease as order volume increases due to fabric sourcing efficiency, production setup optimization, and decoration economies of scale. Pricing below reflects technical polyester activewear with standard construction. Pricing varies by fabric type, style complexity, decoration, and order volume. We provide detailed quotes with itemized pricing for all wholesale inquiries.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Volume</th>
              <th>Leggings Price/Unit</th>
              <th>Sports Bra Price/Unit</th>
              <th>Set Price/Unit</th>
              <th>Discount vs Standard</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>500-999 pieces</td>
              <td>$6.50 - $8.50</td>
              <td>$5.50 - $7.50</td>
              <td>$10.50 - $13.50</td>
              <td>Standard pricing</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>1,000-4,999 pieces</td>
              <td>$5.50 - $7.50</td>
              <td>$4.50 - $6.50</td>
              <td>$9.00 - $12.00</td>
              <td>5-8% discount</td>
            </tr>
            <tr>
              <td>5,000-9,999 pieces</td>
              <td>$4.50 - $6.50</td>
              <td>$4.00 - $6.00</td>
              <td>$7.50 - $10.50</td>
              <td>10-12% discount</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>10,000+ pieces</td>
              <td>$4.00 - $6.00</td>
              <td>$3.50 - $5.50</td>
              <td>$6.50 - $9.50</td>
              <td>15%+ discount</td>
            </tr>
          </tbody>
          <caption>Prices are FOB Bangladesh for technical polyester activewear with standard construction. Actual pricing depends on fabric, style, decoration, and order specifications.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Wholesale Activewear FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What size run consistency do you guarantee for wholesale activewear?</h3>
          <p class="faq__answer">We guarantee size run consistency within  | 2% tolerance across all wholesale orders. Grading retained for each style to match future production. Size measurement reports provided with every shipment documenting actual measurements across size range. Actual performance typically exceeds this guarantee with variation under  | 1.5%.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your pilling resistance standard for wholesale activewear?</h3>
          <p class="faq__answer">Our pilling resistance meets Martindale test standard of 20,000 cycles minimum for wholesale activewear. This exceeds industry average of 15,000 cycles. Pilling test reports provided with every shipment. Anti-pilling treatments available for enhanced performance at additional cost.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do you ensure seam strength for wholesale activewear?</h3>
          <p class="faq__answer">Seam strength tested according to ASTM D1683 with minimum 80N force requirement for wholesale activewear. Reinforced stitching at stress points, four-thread overlock for durability. Seam strength reports included with every shipment. This exceeds industry 60N average.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is the minimum order for wholesale activewear?</h3>
          <p class="faq__answer">Wholesale minimum is 500 pieces per style, per colorway. This applies to leggings, sports bras, and sets. For established buyers with annual commitments, we can negotiate lower minimums based on total volume across activewear and other categories.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What technical fabrics are available for wholesale?</h3>
          <p class="faq__answer">We offer 4-way stretch polyester, moisture-wicking blends, compression fabrics, bamboo blends, recycled polyester (GRS certified), and organic cotton blends. All fabrics tested for stretch recovery, moisture management, and durability at wholesale volumes. Fabric sourcing included.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you provide plus size activewear for wholesale?</h3>
          <p class="faq__answer">Yes. Plus size activewear available from 500 pieces minimum. Extended size ranges up to 5XL with specialized grading for activewear fit. Same quality standards and construction techniques across all sizes. Inclusive sizing from wholesale launch.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do you handle re-orders for wholesale activewear?</h3>
          <p class="faq__answer">Re-orders processed with retained production samples ensuring size run, fabric performance, and construction consistency. Lead time reduced to 25-30 days for re-orders (vs 30-35 days for new orders). We maintain fabric stock for established buyers to accelerate processing.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What certifications do you hold for activewear production?</h3>
          <p class="faq__answer">We hold OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, OCS for organic content, and additional certifications. Full certification documentation provided with every shipment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Establish Wholesale Activewear Supply Partnership?</h2>
      <p class="section__text">
        Contact SDF Clothing for wholesale activewear pricing, fabric samples, and reference checks. We provide detailed quotes with itemized pricing, fabric specifications, and sample arrangements. No commitment required for initial consultation.
      </p>
      <div class="section__ctas">
        <a href="/contact" class="section__cta section__cta--primary">Request Wholesale Quote</a>
        <a href="/tools/sample-request" class="section__cta section__cta--secondary">Request Sample</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/activewear-manufacturer" style="color: var(--color-primary);">activewear manufacturer</a>, <a href="/wholesale-clothing-supplier" style="color: var(--color-primary);">wholesale clothing supplier</a>, <a href="/wholesale-t-shirt-supplier" style="color: var(--color-primary);">wholesale t-shirt supplier</a>, <a href="/sportswear-manufacturer" style="color: var(--color-primary);">sportswear manufacturer</a>, <a href="/quality-inspection-service" style="color: var(--color-primary);">quality inspection service</a>, <a href="/certifications" style="color: var(--color-primary);">certifications</a>, <a href="/yoga-wear-manufacturer" style="color: var(--color-primary);">yoga wear manufacturer</a>, <a href="/private-label-manufacturer" style="color: var(--color-primary);">private label manufacturer</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin: 0 var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
