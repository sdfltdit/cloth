---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Garment Sampling Service Bangladesh | Sample Development ...";
const pageDescription = "Professional garment sampling service from Bangladesh — proto, fit and pre-production samples in 14 days, with tech pack support. Free for bulk orders.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Sampling Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/sampling-service/"
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="garment sampling service Bangladesh, fashion sample maker, proto sample service, fit sample service, pre-production sample, sample development service, garment sample factory, low MOQ sampling, sample maker Dhaka" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Sampling Service
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Sampling Service | Since 1998 | 14-Day Turnaround</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Garment Sampling Service for Fashion Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Sampling is where your design becomes physical reality. Before any bulk production, you need samples to verify fit, fabric, construction, and overall garment quality. SDF Clothing, a full-service clothing manufacturer, produces accurate, professional samples in 14 days | from your tech pack, sketches, or reference garments.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20sampling-service`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">14</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Turnaround</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Free</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">For Bulk 500+</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">2-3</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Iterations Typical</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">DHL</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Courier Shipping</div>
      </div>
    </div>
  </div>
</section>

<!-- Why Sampling Matters Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Quality Overview</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Why Sampling Matters</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Sampling is the most important quality control stage in garment manufacturing. Every detail of your bulk production will match the approved sample. If the sample has problems, those problems multiply across hundreds or thousands of pieces in bulk.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      A good sampling service catches issues early | fabric weight, construction techniques, fit across sizes, label placement, and finishing details. Catching one problem at sample stage saves thousands of dollars compared to discovering it after bulk production.
    </p>
  </div>
</section>

<!-- Types of Samples Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Sample Categories</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Types of Samples We Produce</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Proto Sample (Prototype)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      The first physical version of your design. Used to verify the design works as a garment | proportions, basic fit, fabric handle, construction approach. Usually made in available substitute fabric if your final fabric is not yet sourced.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Proto samples take 7-10 days. Their purpose is design validation, not perfect fit. Multiple revisions are common.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;margin-top:2.5rem;">Fit Sample</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Made to your final specifications using your approved or sourced fabric. Used to verify fit across your full size range. Fit samples are typically made in size M (or your base size) and tested with fit models or measurement standards.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Fit samples take 10-14 days after proto approval. Multiple iterations may be needed.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;margin-top:2.5rem;">Pre-Production Sample (PP Sample)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      The final approved sample that becomes your bulk production reference. Made with your final fabric, final trims, final labels, and final packaging. Every detail of bulk production must match this sample.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Pre-production samples take 5-7 days after fit sample approval. You sign off on this sample before bulk begins.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;margin-top:2.5rem;">Size Set Samples</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      A set of samples covering your full size range (XS to XL or similar). Used to verify size grading is correct across all sizes. Most useful for new designs where size grading has not been previously tested.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;margin-top:2.5rem;">Salesman Samples</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Made for sales presentations to retailers and buyers. Typically 3-10 pieces per style in selected colorways. Used at trade shows, buyer meetings, and lookbook photography.
    </p>
  </div>
</section>

<!-- Sampling Process Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">How It Works</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Our Sampling Process</h2>
    </div>
    
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 1</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Brief and tech pack review</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You send a tech pack, sketches, photographs, or a reference garment. Our team reviews and asks questions to clarify any unclear details before pattern making begins.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 2</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Pattern development</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Our patternmakers create a pattern for your design. For complex designs we may produce 2-3 pattern variations for you to choose from before sample sewing begins.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 3</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Fabric and trim sourcing for sample</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">We source the fabric and trims for your sample. If you have specified fabric, we order small quantities. If fabric is being developed, we use closest available substitute for proto and your final fabric for fit and PP samples.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 4</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Sample cutting</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Pattern is cut from your sample fabric. For accurate sampling we cut by hand | no automated cutting at sample stage.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 5</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Sample sewing</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Experienced sample sewers construct your garment using full quality finishing techniques. This typically takes 2-4 hours per garment for basic styles, longer for complex constructions.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 6</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Internal quality check</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Sample is checked internally for construction quality, measurements, and finish before being sent to you.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 7</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Courier to your address</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">Sample is shipped to you by DHL, FedEx, or UPS. Typical delivery time is 3-5 days for international destinations.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 8</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Your review and revisions</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You review the sample and provide feedback. We make requested changes | fabric weight adjustment, fit modifications, construction refinements, label updates, etc.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 9</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Iteration until approval</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">The sampling process iterates until you approve the sample for bulk production. Most styles require 2-3 sample iterations.</p>
      </div>
    </div>
  </div>
</section>

<!-- Lead Times Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sampling Lead Times</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard sampling timeline:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Proto sample: 7-10 days from brief
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fit sample: 10-14 days from proto approval
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pre-production sample: 5-7 days from fit approval
      </li>
    </ul>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Total time from initial brief to PP sample approval: typically 25-45 days depending on complexity and number of revisions.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      For urgent timelines we can compress sampling by skipping proto stage and going directly to fit sample. This works only when designs are very clearly specified in the tech pack and you accept slight risk of fit issues.
    </p>
  </div>
</section>

<!-- Sample Cost Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sample Cost and Free Sampling</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Sample cost depends on garment complexity and the type of sample.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Standard sample cost (per sample):
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic t-shirt: $25-45
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Polo shirt: $35-55
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Hoodie: $50-80
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Dress shirt: $50-80
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Trousers: $60-100
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Jacket: $80-150
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Complex outerwear: $120-300
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      For confirmed bulk orders of 500+ pieces, we provide initial samples free of charge. Sample cost is deducted from your bulk order invoice. Multiple revisions and additional sample iterations beyond initial samples are billed at standard sample rates.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      This sample-free policy reduces upfront cost for serious buyers while protecting our investment if sampling is requested without intent to place a bulk order.
    </p>
  </div>
</section>

<!-- FAQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Common Questions</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Frequently Asked Questions</h2>
    </div>
    
    <div style="max-width:800px;">
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">Do I need a tech pack to start sampling?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">A tech pack speeds up sampling and improves accuracy, but it is not required. We can also sample from sketches, photographs, or reference garments. For first-time brands without tech packs, we provide tech pack development as part of full-package services.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How fast can I get a sample?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Standard proto sample timeline is 7-10 days from brief. Rush sampling in 5-7 days is possible for additional cost. Same-day or next-day sampling is not realistic for quality production samples.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">Are samples free?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">For confirmed bulk orders of 500+ pieces, yes | initial samples are free. Sample cost is deducted from your final bulk invoice. Standalone samples without bulk order intent are charged at standard rates.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How many sample iterations are typical?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">2-3 iterations is normal | proto, fit, then pre-production sample. Some designs need only 1-2 iterations. Complex or unique designs may need 4-5. We do not start bulk production until you approve a sample.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">Can you sample using my own fabric?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Yes. You can supply fabric for sampling. This is common for established brands with specific fabric suppliers. Fabric MOQ from mills means you usually need to order at least small quantities for sampling.</p>
      </div>
      <div style="padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What happens if I am not happy with the final sample?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We continue sample iterations until you are satisfied or you decide not to proceed with bulk. There is no obligation to place bulk orders if samples do not meet your standards.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Ready to sample your fashion designs with a professional team? <a href="/contact" style="color:#e00;text-decoration:underline;">Contact SDF Clothing here</a> with your tech pack, sketches, or reference photos. We will quote sampling cost and lead time within 48 hours. Free samples for confirmed bulk orders of 500+ pieces.
    </p>
  </div>
</section>

<!-- Internal Link Section -->
