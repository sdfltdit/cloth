---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Technical Outerwear Manufacturer | Waterproof SDF";
const pageDescription = "Technical outerwear manufacturer in Bangladesh. Waterproof jackets, hardshell, softshell from 300 pieces. Gore-Tex alternatives, DWR coating. Free quote.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Technical Outerwear Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What types of technical outerwear do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture hardshell jackets with waterproof membranes, softshell jackets with stretch performance, windbreakers with windproof construction, insulated jackets with synthetic down alternatives, and rain jackets with waterproof ratings. All products available from 300 pieces minimum with bluesign and OEKO-TEX certifications."
          }
        },
        {
          "@type": "Question",
          "name": "What waterproof technologies do you use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use Gore-Tex alternative membranes including ePTFE and polyurethane laminates, 3-layer laminate construction for durability, DWR coatings for water repellency, and windproof membranes for weather protection. All fabrics tested to 10,000-20,000mm waterproof ratings with breathability ratings of 5,000-15,000g/m²/24h."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric GSM options do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer technical outerwear fabrics from 150-300 GSM. Lightweight options at 150-180 GSM for packable rain jackets, midweight at 180-220 GSM for all-season performance, and heavyweight at 220-300 GSM for extreme weather protection. All options maintain waterproof and breathability performance."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for technical outerwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our technical outerwear minimum is 300 pieces per style. This applies to hardshell jackets, softshell jackets, windbreakers, insulated jackets, and rain jackets. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer custom waterproof ratings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We can customize waterproof ratings from 5,000mm to 20,000mm depending on membrane selection and lamination specifications. Breathability ratings can be adjusted from 5,000g/m²/24h to 15,000g/m²/24h. Custom specifications require fabric development with 45-60 day lead time and higher minimum orders of 500 pieces."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for technical outerwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold bluesign certification for sustainable textile production, OEKO-TEX Standard 100 for chemical safety in outerwear fabrics, and ISO 9001 for quality management. All technical outerwear produced to international performance standards for waterproof and breathable applications."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Technical Outerwear Manufacturing Service",
      "description": "Custom technical outerwear manufacturing from 300 pieces including waterproof jackets, hardshell, softshell with Gore-Tex alternatives and 3-layer laminate construction",
      "provider": {
        "@id": "https://sdfltd.com/#organization"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Technical Outerwear Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Waterproof Jacket Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "15",
              "maxPrice": "45"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Technical Outerwear from SDF Clothing",
      "description": "Step-by-step process for ordering custom technical outerwear from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your technical outerwear design, waterproof specifications (membrane type, waterproof rating), fabric requirements (GSM, 3-layer laminate), size chart, target quantity, and performance requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including membrane costs, fabric, lamination, DWR coating, production, customization, and shipping for your technical outerwear order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review technical outerwear samples for waterproof performance, breathability, seam sealing, DWR effectiveness, and construction quality within 14-21 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 40-50 day turnaround for technical outerwear items due to specialized lamination processes"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check including waterproof testing and seam inspection before shipment with tracking documentation for your technical outerwear order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalUrl={canonicalUrl.href}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Technical Outerwear Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Technical Outerwear Manufacturer • Since 1998 • Performance Specialists</div>
        <h1 class="hero__title">Technical Outerwear Manufacturer • Custom Waterproof Jackets and Performance Gear from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a technical outerwear manufacturer in Bangladesh producing waterproof jackets, hardshell jackets, softshell jackets, windbreakers, insulated jackets, and rain jackets from 300 pieces minimum. Gore-Tex alternatives, 3-layer laminate construction, DWR coating, windproof membranes, bluesign and OEKO-TEX certified.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20technical-outerwear-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">3-Layer</span>
          <span class="hero__stat-label">Laminate Tech</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">40-50</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>bluesign Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Outerwear Types</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Types We Manufacture</h2>
      </div>
      <div class="section__text">
        <p>We manufacture five primary technical outerwear categories, each designed for specific weather conditions and performance requirements. Hardshell jackets provide maximum waterproof protection with breathable membranes for extreme weather conditions. Softshell jackets offer stretch and breathability for active pursuits with moderate weather protection. Windbreakers deliver lightweight wind resistance with packable convenience. Insulated jackets combine thermal insulation with weather protection for cold conditions. Rain jackets focus on waterproof performance with lightweight construction for wet weather. All types maintain our quality standards and are available from 300 pieces minimum.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Type</th>
              <th>Primary Use</th>
              <th>Key Features</th>
              <th>Waterproof Rating</th>
              <th>Price Tier</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Hardshell Jackets</td>
              <td>Extreme weather, mountaineering</td>
              <td>3-layer laminate, fully taped seams, helmet-compatible hood</td>
              <td>15,000-20,000mm</td>
              <td>$$$</td>
            </tr>
            <tr>
              <td>Softshell Jackets</td>
              <td>Active pursuits, variable conditions</td>
              <td>Stretch fabric, breathable, water-resistant, articulated fit</td>
              <td>5,000-10,000mm</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Windbreakers</td>
              <td>Lightweight wind protection</td>
              <td>Packable, windproof membrane, lightweight construction</td>
              <td>1,000-3,000mm</td>
              <td>$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Insulated Jackets</td>
              <td>Cold weather protection</td>
              <td>Synthetic insulation, weather-resistant shell, thermal efficiency</td>
              <td>5,000-10,000mm</td>
              <td>$$$</td>
            </tr>
            <tr>
              <td>Rain Jackets</td>
              <td>Wet weather protection</td>
              <td>Waterproof, breathable, lightweight, packable</td>
              <td>10,000-15,000mm</td>
              <td>$$</td>
            </tr>
          </tbody>
          <caption>All types available from 300 pieces minimum. Custom combinations possible with higher minimums.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Waterproof Technologies</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Waterproof and Breathable Technologies</h2>
      </div>
      <div class="section__text">
        <p>Waterproof technology selection determines outerwear performance, comfort, and application. We offer multiple membrane technologies optimized for different conditions and price points. All technologies feature breathable construction to manage moisture while blocking water ingress. Technology selection depends on intended use, weather conditions, and brand positioning requirements.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Technology</th>
              <th>Construction</th>
              <th>Waterproof Rating</th>
              <th>Breathability</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>ePTFE Membrane</td>
              <td>3-layer laminate</td>
              <td>20,000mm</td>
              <td>15,000g/m²/24h</td>
              <td>Extreme weather, premium outerwear</td>
            </tr>
            <tr>
              <td>Polyurethane Laminate</td>
              <td>2.5-3 layer</td>
              <td>10,000-15,000mm</td>
              <td>8,000-10,000g/m²/24h</td>
              <td>All-weather performance, value positioning</td>
            </tr>
            <tr>
              <td>Coated Fabric</td>
              <td>PU coating</td>
              <td>5,000-10,000mm</td>
              <td>3,000-5,000g/m²/24h</td>
              <td>Lightweight rain jackets, cost-efficient</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>DWR Treated Fabric</td>
              <td>Surface treatment</td>
              <td>1,000-3,000mm</td>
              <td>High air permeability</td>
              <td>Windbreakers, water-resistant shells</td>
            </tr>
          </tbody>
          <caption>All technologies include seam sealing options. Custom specifications available with fabric development.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Specifications</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Fabric Options by GSM</h2>
      </div>
      <div class="section__text">
        <p>Fabric weight (GSM) significantly impacts outerwear packability, durability, and thermal properties. We offer technical outerwear fabrics from 150-300 GSM to serve different applications and performance requirements. All fabrics maintain waterproof and breathable characteristics across weight ranges.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>GSM Range</th>
              <th>Weight Category</th>
              <th>Applications</th>
              <th>Packability</th>
              <th>Durability</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>150-180 GSM</td>
              <td>Lightweight</td>
              <td>Packable rain jackets, ultralight shells</td>
              <td>Highly packable</td>
              <td>Moderate</td>
            </tr>
            <tr>
              <td>180-220 GSM</td>
              <td>Midweight</td>
              <td>All-season jackets, hiking outerwear</td>
              <td>Packable</td>
              <td>Good</td>
            </tr>
            <tr>
              <td>220-260 GSM</td>
              <td>Heavyweight</td>
              <td>Technical shells, ski jackets</td>
              <td>Limited</td>
              <td>High</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>260-300 GSM</td>
              <td>Expedition</td>
              <td>Mountaineering, extreme weather</td>
              <td>Not packable</td>
              <td>Very High</td>
            </tr>
          </tbody>
          <caption>Weight selection affects packability and durability. Custom GSM available with fabric development.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Construction Features</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Construction Features</h2>
      </div>
      <div class="section__text">
        <p>Construction features define technical outerwear functionality and user experience. We offer multiple construction options to enhance waterproof performance, breathability, and durability. All construction methods follow industry best practices for technical garment manufacturing.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Description</th>
              <th>Waterproof Benefit</th>
              <th>Best For</th>
              <th>Cost Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Fully Taped Seams</td>
              <td>All seams sealed with waterproof tape</td>
              <td>Maximum waterproof protection</td>
              <td>Hardshell jackets, rain jackets</td>
              <td>+</td>
            </tr>
            <tr>
              <td>Critically Taped Seams</td>
              <td>Key seams only taped</td>
              <td>Targeted waterproof protection</td>
              <td>Softshell, windbreakers</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>YKK Aquaguard Zippers</td>
              <td>Waterproof zipper construction</td>
              <td>Prevents water ingress through closures</td>
              <td>All technical outerwear</td>
              <td>+</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Laminated Cuffs</td>
              <td>Seamless cuff construction</td>
              <td>Eliminates seam leak points</td>
              <td>Premium hardshell jackets</td>
              <td>++</td>
            </tr>
            <tr>
              <td>Pocket Flaps with Velcro</td>
              <td>Overlapping pocket closures</td>
              <td>Additional water protection</td>
              <td>All technical outerwear</td>
              <td>Standard</td>
            </tr>
          </tbody>
          <caption>Construction features can be combined for enhanced performance. Custom features available.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Price Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Price Range by Type</h2>
      </div>
      <div class="section__text">
        <p>Pricing varies by membrane technology, fabric GSM, construction complexity, and order quantity. FOB Bangladesh pricing for standard production runs. Custom membranes, specialized construction, and premium finishes are additional. Volume discounts available for orders exceeding 1,000 pieces.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Type</th>
              <th>300-500 pcs</th>
              <th>500-1000 pcs</th>
              <th>1000-2000 pcs</th>
              <th>2000+ pcs</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Windbreakers (Lightweight)</td>
              <td>$12-18</td>
              <td>$10-15</td>
              <td>$8-12</td>
              <td>$7-10</td>
            </tr>
            <tr>
              <td>Rain Jackets (PU Coated)</td>
              <td>$15-22</td>
              <td>$13-19</td>
              <td>$11-16</td>
              <td>$10-14</td>
            </tr>
            <tr>
              <td>Softshell Jackets</td>
              <td>$18-28</td>
              <td>$16-25</td>
              <td>$14-22</td>
              <td>$12-19</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Hardshell Jackets (PU Laminate)</td>
              <td>$25-40</td>
              <td>$22-35</td>
              <td>$19-30</td>
              <td>$17-27</td>
            </tr>
            <tr>
              <td>Hardshell Jackets (ePTFE)</td>
              <td>$35-55</td>
              <td>$32-50</td>
              <td>$28-45</td>
              <td>$25-40</td>
            </tr>
            <tr>
              <td>Insulated Jackets</td>
              <td>$28-45</td>
              <td>$25-40</td>
              <td>$22-35</td>
              <td>$20-32</td>
            </tr>
          </tbody>
          <caption>FOB Bangladesh pricing. Includes fabric, membrane, cut, sew, basic branding. Customization additional.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Certifications</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Certifications</h2>
      </div>
      <div class="section__text">
        <p>Certifications ensure technical outerwear meets international standards for environmental responsibility, chemical safety, and quality management. Our certifications provide assurance that your outerwear is produced sustainably and safely. We hold bluesign certification for sustainable textile production, covering the entire supply chain from raw materials to finished garments. OEKO-TEX Standard 100 certification ensures all fabrics and components are free from harmful substances, critical for garments worn against the skin in active conditions. ISO 9001 certification validates our quality management systems, ensuring consistent production standards across all technical outerwear manufacturing.</p>
        
        <p>bluesign certification specifically addresses chemical management in technical outerwear production, where waterproof membranes and DWR coatings require specialized chemistry. Our bluesign certification ensures that all chemical processes meet strict environmental standards, reducing water consumption, minimizing emissions, and eliminating harmful substances from the production chain. This certification is increasingly important for brands targeting environmentally conscious consumers and markets with strict chemical regulations.</p>
        
        <p>OEKO-TEX Standard 100 certification is particularly relevant for technical outerwear due to the extensive chemical treatments involved in waterproofing and DWR applications. Our certification ensures that all chemical treatments are tested for harmful substances and meet strict limits for skin contact. This certification provides assurance to consumers that technical outerwear is safe for extended wear during active pursuits, even when sweating or in wet conditions.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Technical Outerwear Manufacturer FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What types of technical outerwear do you manufacture?</h3>
          <p class="faq__answer">We manufacture hardshell jackets with waterproof membranes, softshell jackets with stretch performance, windbreakers with windproof construction, insulated jackets with synthetic down alternatives, and rain jackets with waterproof ratings. All products available from 300 pieces minimum with bluesign and OEKO-TEX certifications.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What waterproof technologies do you use?</h3>
          <p class="faq__answer">We use Gore-Tex alternative membranes including ePTFE and polyurethane laminates, 3-layer laminate construction for durability, DWR coatings for water repellency, and windproof membranes for weather protection. All fabrics tested to 10,000-20,000mm waterproof ratings with breathability ratings of 5,000-15,000g/m²/24h.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabric GSM options do you offer?</h3>
          <p class="faq__answer">We offer technical outerwear fabrics from 150-300 GSM. Lightweight options at 150-180 GSM for packable rain jackets, midweight at 180-220 GSM for all-season performance, and heavyweight at 220-300 GSM for extreme weather protection. All options maintain waterproof and breathability performance.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your minimum order for technical outerwear?</h3>
          <p class="faq__answer">Our technical outerwear minimum is 300 pieces per style. This applies to hardshell jackets, softshell jackets, windbreakers, insulated jackets, and rain jackets. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you offer custom waterproof ratings?</h3>
          <p class="faq__answer">Yes. We can customize waterproof ratings from 5,000mm to 20,000mm depending on membrane selection and lamination specifications. Breathability ratings can be adjusted from 5,000g/m²/24h to 15,000g/m²/24h. Custom specifications require fabric development with 45-60 day lead time and higher minimum orders of 500 pieces.</p>
