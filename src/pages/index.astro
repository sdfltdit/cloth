<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={combinedSchema}
  ogType="website"

>

<Fragment slot="head">
  <!-- Homepage CSS, non-blocking: everything below-the-fold (FAQ, cards,
       testimonials, calculators, country grid, etc — the bulk of the old
       27KB inline block). The small critical subset below (root vars +
       hero) stays inline/blocking on purpose: deferring THOSE too in the
       first version of this fix caused hero text to paint once unstyled
       and again once this file loaded, which made LCP render delay worse
       (230ms -> 380ms) and introduced hero-subtitle layout shift (CLS). -->
  <link rel="preload" as="style" href={indexPageCssUrl} />
  <link rel="stylesheet" href={indexPageCssUrl} media="print" onload="this.media='all'; this.onload=null;" />
  <noscript><link rel="stylesheet" href={indexPageCssUrl} /></noscript>
</Fragment>

<style>
  :root {
    --color-bg: #000000;
    --color-bg-card: #000000;
    --color-bg-light: #000000;
    --color-bg-secondary: #000000;
    --color-bg-footer: #000000;
    --color-bg-input: #000000;
    --color-bg-modal: #000000;
    --color-bg-button: #000000;
    
    --color-text: #FFFFFF;
    --color-text-subtle: rgba(255, 255, 255, 0.7);
    --color-text-placeholder: rgba(255, 255, 255, 0.5);
    
    --color-accent: #e00;
    --color-border: #e00;
    --color-border-thin: #e00;
    --color-border-input: #e00;
    --color-border-focus: #e00;
    --color-link-hover: #e00;
    --color-red: #e00;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 5rem;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --transition: 0.2s ease;
  }

  .index {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: 'Inter', 'Inter Fallback', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.7;
  }

  .index__container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .index__section {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border-red);
  }

  .index__section--no-border {
    border-bottom: none;
  }

  .index__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--color-border-red);
    background-color: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition);
    min-height: 44px;
    min-width: 44px;
  }

  .index__btn--primary {
    background-color: var(--color-red);
    border-color: var(--color-red);
  }

  .index__btn--primary:hover {
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .index__btn--secondary:hover {
    border-color: var(--color-red);
    color: var(--color-text);
  }

  .index__btn-group {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .index__hero {
    min-height: 90vh;
    display: grid;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-xl) var(--space-md);
  }

  .index__hero-title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 300;
    color: var(--color-text);
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .index__hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text);
    max-width: 700px;
    margin: 0 auto var(--space-lg);
    line-height: 1.8;
  }

  .index__hero-trust {
    margin-top: var(--space-lg);
    font-size: 0.8rem;
    color: var(--color-text);
  }

  .index__hero-trust span {
    margin: 0 var(--space-sm);
  }

  @media (max-width: 768px) {
    .index__section {
      padding: var(--space-lg) 0;
    }

    .index__hero {
      min-height: auto;
      padding: var(--space-lg) var(--space-md);
    }

    .index__btn-group {
      flex-direction: column;
      width: 100%;
    }

    .index__btn {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .index__container {
      padding: 0 var(--space-sm);
    }

    .index__hero-trust {
      font-size: 0.7rem;
    }

    .index__hero-trust span {
      display: block;
      margin: var(--space-xs) 0;
    }
  }
</style>

