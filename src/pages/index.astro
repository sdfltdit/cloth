---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculators from '../components/Calculators.astro';
import { schemaOrganization, schemaPerson, SITE_URL as SITE } from '../data/schema';

export const prerender = true;

const pageTitle = "Clothing Manufacturers for Startup Fashion Brands | Low MOQ 300 Pieces | SDF";
const pageDescription = "SDF Clothing — trusted clothing manufacturers in Bangladesh since 1998. Custom apparel, OEM, private label and CMT from 300 to 50,000+ pieces. Ships to USA, UK, EU, Australia.";

const faqs = [
  {
    category: "Pricing & Payment",
    question: "What is your minimum order quantity for apparel manufacturing?",
    answer: "Our MOQ is 300 pieces per style with flexible size and colour combinations. This low minimum makes us ideal for startup brands and boutique labels sourcing from Dhaka garment factories."
  },
  {
    category: "Pricing & Payment",
    question: "How do you price your apparel manufacturing services?",
    answer: "All quotes are FOB Chittagong or Dhaka covering fabric, dyeing, finishing, cut and sew, AQL 2.5 inspection, and port delivery. We provide transparent pricing with no hidden charges."
  },
  {
    category: "Pricing & Payment",
    question: "What are your payment terms for bulk orders?",
    answer: "We accept T/T, L/C, and bank transfers. Standard terms are 30% deposit to start production and 70% before shipment. Free samples are available for confirmed bulk orders."
  },
  {
    category: "Pricing & Payment",
    question: "Do you charge extra for labels, hang tags, and packaging?",
    answer: "No. Personalized woven labels, hang tags, branded packaging, and poly bags are included at no extra charge when you order with us. This is part of our full-package manufacturing service."
  },
  {
    category: "MOQ & Production",
    question: "How long does bulk garment production take?",
    answer: "Standard lead time is 40 days for bulk orders. Sample development takes 7-14 days. Our streamlined process ensures on-time delivery for your fashion production needs."
  },
  {
    category: "MOQ & Production",
    question: "Can I mix sizes and colours within the 300 piece MOQ?",
    answer: "Yes. Our 300 piece MOQ allows flexible size and colour combinations. You can distribute the 300 pieces across multiple sizes and colours within the same style."
  },
  {
    category: "MOQ & Production",
    question: "What is your maximum production capacity per order?",
    answer: "We can handle orders up to 50,000 pieces per style with a 40-day lead time. For larger orders, we can discuss staggered delivery schedules to meet your timeline."
  },
  {
    category: "MOQ & Production",
    question: "Do you offer rush production for urgent orders?",
    answer: "Yes. We offer expedited production for urgent orders with reduced lead times. Additional rush fees may apply. Contact us directly with your timeline requirements."
  },
  {
    category: "Quality & Certifications",
    question: "What quality standards do you follow?",
    answer: "We follow AQL 2.5 inspection standards for all orders. Our quality control team checks fabric, stitching, measurements, and finishing at multiple production stages."
  },
  {
    category: "Quality & Certifications",
    question: "What certifications do you hold?",
    answer: "We hold 13 international certifications including GOTS, OEKO-TEX, ISO 9001, BSCI, SEDEX, GRS, OCS, RCS, C-TPAT, WRAP, SA8000, ISO 14001, and BCI."
  },
  {
    category: "Quality & Certifications",
    question: "What does GOTS certification mean for my brand?",
    answer: "GOTS certification ensures your garments are made with organic cotton and meet strict environmental and social criteria. This is essential for brands targeting eco-conscious consumers."
  },
  {
    category: "Quality & Certifications",
    question: "How do you ensure consistent quality across orders?",
    answer: "We maintain detailed quality records for each client, use approved fabric suppliers, and follow standardized production processes. This ensures consistency whether you order 300 or 30,000 pieces."
  },
  {
    category: "Shipping & Logistics",
    question: "What shipping options do you offer?",
    answer: "We offer FOB delivery from Chittagong or Dhaka ports. We can arrange sea freight or air freight based on your timeline and budget requirements."
  },
  {
    category: "Shipping & Logistics",
    question: "Do you handle customs documentation?",
    answer: "Yes. We provide all necessary export documentation including commercial invoices, packing lists, certificates of origin, and any required compliance certificates for your destination market."
  },
  {
    category: "Shipping & Logistics",
    question: "What is your on-time delivery rate?",
    answer: "Our on-time delivery rate is 98%. We track production schedules closely and communicate proactively if any delays are anticipated, giving you time to adjust your plans."
  },
  {
    category: "Shipping & Logistics",
    question: "Can you ship directly to my warehouse?",
    answer: "Yes. We can arrange door-to-door delivery to your warehouse or fulfillment center. We work with reliable freight forwarders to ensure smooth customs clearance and delivery."
  },
  {
    category: "Sustainability",
    question: "What sustainable materials do you offer?",
    answer: "We offer GOTS organic cotton, GRS recycled polyester, OCS organic cotton, RCS recycled content, and BCI Better Cotton. We can source other sustainable materials based on your requirements."
  },
  {
    category: "Sustainability",
    question: "How do you minimize environmental impact?",
    answer: "Our ISO 14001 certified facilities follow strict environmental management practices. We use eco-friendly dyes, reduce water consumption, and properly treat wastewater before discharge."
  },
  {
    category: "Sustainability",
    question: "Are your factories ethically compliant?",
    answer: "Yes. Our BSCI, SEDEX, WRAP, and SA8000 certifications ensure fair labor practices, safe working conditions, and compliance with international labor standards."
  },
  {
    category: "Getting Started",
    question: "What makes SDF Clothing the right Low MOQ clothing manufacturer for startup fashion brands?",
    answer: "With 300 pieces MOQ, GOTS certification since 1998, and global shipping to EU, UK, USA, Canada, and Australia, we provide full-package manufacturing from fabric sourcing to finished garments specifically designed for first-time fashion brand owners."
  },
  {
    category: "Getting Started",
    question: "How do I get a quote for my fashion line?",
    answer: "Fill out our quote form with your garment type, quantity, and requirements. You can also contact us via WhatsApp for faster response. We provide quotes within 48 hours."
  },
  {
    category: "Getting Started",
    question: "Do I need a tech pack to get started?",
    answer: "A tech pack is helpful but not required initially. If you have reference images or detailed descriptions, we can work with those. Our design team can also help create tech packs."
  },
  {
    category: "Getting Started",
    question: "How long does sample development take?",
    answer: "Sample development typically takes 7-14 days depending on complexity. We provide proto samples for fit approval, then pre-production samples before bulk manufacturing."
  },
  {
    category: "Getting Started",
    question: "What information do you need to provide a quote?",
    answer: "We need garment type, fabric preference, quantity per style, size breakdown, desired delivery date, and any special requirements like printing or embroidery."
  }
];

const schemaWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE + "/#website",
  "name": "SDF Clothing",
  "url": SITE,
  "description": pageDescription,
  "publisher": { "@id": SITE + "/#organization" },
  "inLanguage": "en",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": SITE + "/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": SITE + "/#webpage",
  "name": pageTitle,
  "description": pageDescription,
  "url": SITE,
  "isPartOf": { "@id": SITE + "/#website" },
  "about": { "@id": SITE + "/#organization" },
  "datePublished": "1998-01-01",
  "dateModified": new Date().toISOString().split("T")[0],
  "inLanguage": "en",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "jobTitle": "Founder & CEO, SDF Clothing"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE }
    ]
  }
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const schemaHowTo = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Order Custom Clothing Manufacturing with SDF Clothing",
  "description": "Complete process from design brief to FOB shipment for custom apparel production handled entirely in-house.",
  "totalTime": "P45D",
  "provider": { "@id": SITE + "/#organization" },
  "step": [
    { "@type": "HowToStep", "position": "1", "name": "Send Your Brief", "text": "Email or WhatsApp your design sketch photo or description. We accept rough sketches, photos, or tech packs." },
    { "@type": "HowToStep", "position": "2", "name": "Quote and Consultation", "text": "We send pricing, lead time, fabric options, and certifications within 48 hours. No hidden costs. MOQ is 300 pieces per style." },
    { "@type": "HowToStep", "position": "3", "name": "Tech Pack and Fabric Sourcing", "text": "We develop or review your design. We find and confirm fabric. You approve before we start. Days 3 to 7." },
    { "@type": "HowToStep", "position": "4", "name": "Sample Development", "text": "30 percent deposit required to start sampling. Samples ready in 14 days. Free for confirmed orders. We remake up to 10 times if needed." },
    { "@type": "HowToStep", "position": "5", "name": "Order Confirmation", "text": "70 percent balance secures your production slot. We do not outsource. Orders up to 5000 pieces finish in 20 days or less." },
    { "@type": "HowToStep", "position": "6", "name": "Bulk Production", "text": "We cut, sew, finish, embroider, and print in-house. AQL 2.5 quality checks at every step. 20 days for up to 5,000 pieces. 40 to 60 days for 20,000 plus pieces." },
    { "@type": "HowToStep", "position": "7", "name": "AQL Inspection", "text": "Final inspection before packing. AQL 2.5 standard. Third-party inspection available via SGS, Bureau Veritas, and Intertek." },
    { "@type": "HowToStep", "position": "8", "name": "FOB Shipment", "text": "We pack and document your order. We load at Chittagong or Dhaka port. All export documents provided." }
  ]
};

const schemaProductList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Clothing and Apparel Categories Manufactured by SDF Clothing",
  "description": "Custom garment manufacturing for all apparel categories. Produced in-house at our Dhaka factory from 300 pieces MOQ.",
  "numberOfItems": 20,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "item": { "@type": "Product", "name": "Custom T-Shirt Manufacturing", "description": "Custom t-shirts from single jersey, ringspun, and organic cotton. GOTS certified. From 300 pieces per style.", "material": ["100% Cotton","Organic Cotton","Poly Cotton Blend","Recycled Polyester"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 2, "item": { "@type": "Product", "name": "Custom Polo Shirt Manufacturing", "description": "Custom polo shirts from pique and jersey fabrics. GOTS certified options available. From 300 pieces per style.", "material": ["Pique Cotton","Jersey","Organic Cotton"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 3, "item": { "@type": "Product", "name": "Custom Hoodie Manufacturing", "description": "French terry and fleece hoodies from 240 to 450 GSM. Heavyweight options available. GOTS certified. From 300 pieces per style.", "material": ["French Terry","Fleece","Organic Cotton Fleece"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 4, "item": { "@type": "Product", "name": "Custom Sweatshirt Manufacturing", "description": "Custom sweatshirts from fleece and french terry. Various GSM options. GOTS certified. From 300 pieces.", "material": ["Fleece","French Terry","Organic Cotton"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 5, "item": { "@type": "Product", "name": "Custom Jogger Manufacturing", "description": "Custom joggers from fleece and french terry fabrics. Elastic waistband and cuff options. From 300 pieces per style.", "material": ["Fleece","French Terry","Poly Cotton Blend"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 6, "item": { "@type": "Product", "name": "Custom Shorts Manufacturing", "description": "Custom shorts from jersey, twill, and woven fabrics. Casual and performance options. From 300 pieces per style.", "material": ["Jersey","Twill","Recycled Polyester"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 7, "item": { "@type": "Product", "name": "Custom Dress Shirt Manufacturing", "description": "Custom dress shirts from poplin, oxford, and twill woven fabrics. From 300 pieces per style.", "material": ["Poplin","Oxford","Twill"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 8, "item": { "@type": "Product", "name": "Custom Jacket Manufacturing", "description": "Custom jackets from canvas, nylon, and woven fabrics. Casual and outerwear constructions. From 300 pieces per style.", "material": ["Canvas","Nylon","Oxford Weave"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 9, "item": { "@type": "Product", "name": "Custom Dress Manufacturing", "description": "Custom dresses from viscose, linen, and chiffon fabrics. Women's fashion and resort wear. From 300 pieces per style.", "material": ["Viscose","Linen","Chiffon","Poplin"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 10, "item": { "@type": "Product", "name": "Custom Leggings Manufacturing", "description": "Custom leggings from lycra blend and recycled polyester. From 300 pieces per style.", "material": ["Lycra Blend","Recycled Polyester","Nylon Spandex"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 11, "item": { "@type": "Product", "name": "Custom Activewear Manufacturing", "description": "Custom activewear and sportswear from performance fabrics. Moisture-wicking, stretch, and recycled options. GOTS certified. From 300 pieces.", "material": ["Recycled Polyester","Lycra Blend","Nylon","Moisture-Wicking Fabric"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 12, "item": { "@type": "Product", "name": "Custom Blouse Manufacturing", "description": "Custom blouses from viscose, chiffon, and lightweight woven fabrics. From 300 pieces per style.", "material": ["Viscose","Chiffon","Poplin","Linen"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 13, "item": { "@type": "Product", "name": "Custom Denim Manufacturing", "description": "Custom denim garments from 8oz to 14oz denim. Rigid and stretch options. Various washes available. From 300 pieces per style.", "material": ["8oz Denim","10oz Denim","14oz Stretch Denim"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 14, "item": { "@type": "Product", "name": "Custom Sustainable Clothing Manufacturing", "description": "Eco-friendly garments from GOTS certified organic cotton and GRS certified recycled polyester. OEKO-TEX compliant. From 300 pieces.", "material": ["GOTS Organic Cotton","GRS Recycled Polyester","Bamboo","Modal"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 15, "item": { "@type": "Product", "name": "Custom Streetwear Manufacturing", "description": "Custom heavyweight streetwear including oversized t-shirts, hoodies, and joggers. From 300 pieces.", "material": ["Heavyweight Fleece","French Terry","Ringspun Cotton"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 16, "item": { "@type": "Product", "name": "Custom Workwear Manufacturing", "description": "Custom workwear from canvas and twill fabrics. Durable constructions for professional use. From 300 pieces per style.", "material": ["Canvas","Cotton Twill","Poly Twill"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 17, "item": { "@type": "Product", "name": "Custom Resort Wear Manufacturing", "description": "Custom summer and resort wear from linen and lightweight woven fabrics. From 300 pieces per style.", "material": ["Linen","Cotton Poplin","Viscose"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 18, "item": { "@type": "Product", "name": "Custom Premium Basics Manufacturing", "description": "Premium basics from modal and bamboo fabrics. Soft knit constructions for everyday wear. From 300 pieces per style.", "material": ["Modal","Bamboo","Organic Cotton","Cotton Interlock"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 19, "item": { "@type": "Product", "name": "Custom Swimwear Manufacturing", "description": "Custom swimwear from lycra blend and nylon fabrics. From 300 pieces per style.", "material": ["Lycra Blend","Nylon Spandex","Recycled Polyester"], "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 20, "item": { "@type": "Product", "name": "Custom Pet Wear Manufacturing", "description": "Custom dog t-shirts, hoodies, jackets, raincoats, bandanas, and cat sweaters. OEKO-TEX certified fabrics. All sizes XS to XXL.", "material": ["Knit Cotton","French Terry","Fleece","Waterproof Nylon"], "brand": { "@id": SITE + "/#organization" } } }
  ]
};

const schemaAccessoryList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Accessories and Specialty Items Manufactured by SDF Clothing",
  "description": "Custom accessories, home textiles, bags, caps, and pet wear produced at our Dhaka factory.",
  "numberOfItems": 10,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "item": { "@type": "Product", "name": "Custom Cap Manufacturing", "description": "Baseball caps, bucket hats, beanies, trucker caps, and dad hats. Structured and unstructured options. Branded embroidery available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 2, "item": { "@type": "Product", "name": "Custom Bag Manufacturing", "description": "Tote bags, backpacks, crossbody bags, gym bags, waist bags, and shopping bags. Canvas, cotton, and nylon options.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 3, "item": { "@type": "Product", "name": "Custom Towel Manufacturing", "description": "Hand towels, bath towels, and beach towels. 100% cotton terry. 400gsm to 600gsm options. Branded print available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 4, "item": { "@type": "Product", "name": "Custom Blanket Manufacturing", "description": "Fleece, sherpa, and knit blankets. Custom size and weight. Branded print options available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 5, "item": { "@type": "Product", "name": "Custom Cushion Cover Manufacturing", "description": "Woven and knit cushion covers. Zip and envelope closure options. Custom print available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 6, "item": { "@type": "Product", "name": "Custom Apron Manufacturing", "description": "Cotton and canvas aprons. Adjustable strap. Custom print options available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 7, "item": { "@type": "Product", "name": "Custom Beanie Manufacturing", "description": "Knit beanies with fleece lining options. Custom length and color. From 300 pieces per style.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 8, "item": { "@type": "Product", "name": "Custom Pet Bed Cover Manufacturing", "description": "Removable woven pet bed covers. All sizes. Machine washable. OEKO-TEX certified fabrics available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 9, "item": { "@type": "Product", "name": "Custom Pet Blanket Manufacturing", "description": "Fleece and sherpa pet blankets. Custom size, print, and color. OEKO-TEX certified fabrics available.", "brand": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 10, "item": { "@type": "Product", "name": "Custom Beret Manufacturing", "description": "Wool and cotton blend berets. Tailored size and color options. From 300 pieces per style.", "brand": { "@id": SITE + "/#organization" } } }
  ]
};

const schemaToolsList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Apparel Manufacturing Tools and Calculators by SDF Clothing",
  "description": "Free B2B tools for fashion brands covering manufacturing costs, MOQ, sampling timelines, AQL quality standards, and global shipping estimates.",
  "numberOfItems": 10,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "item": { "@type": "SoftwareApplication", "name": "Apparel Price Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 2, "item": { "@type": "SoftwareApplication", "name": "Import Duty and VAT Calculator", "applicationCategory": "FinanceApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 3, "item": { "@type": "SoftwareApplication", "name": "Global Shipping Time Estimator", "applicationCategory": "BusinessApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 4, "item": { "@type": "SoftwareApplication", "name": "Sampling Date and Lead Time Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 5, "item": { "@type": "SoftwareApplication", "name": "Fabric GSM Calculator", "applicationCategory": "DesignApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 6, "item": { "@type": "SoftwareApplication", "name": "AQL Quality Inspection Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 7, "item": { "@type": "SoftwareApplication", "name": "EU Digital Product Passport Generator", "applicationCategory": "ComplianceApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 8, "item": { "@type": "SoftwareApplication", "name": "Fabric Shrinkage Calculator", "applicationCategory": "DesignApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 9, "item": { "@type": "SoftwareApplication", "name": "Pantone Color Converter", "applicationCategory": "DesignApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } },
    { "@type": "ListItem", "position": 10, "item": { "@type": "SoftwareApplication", "name": "Tech Pack Builder", "applicationCategory": "DesignApplication", "operatingSystem": "All", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "provider": { "@id": SITE + "/#organization" } } }
  ]
};

const combinedSchema = [
  schemaOrganization,
  schemaWebSite,
  schemaWebPage,
  schemaFAQ,
  schemaPerson,
  schemaHowTo,
  schemaProductList,
  schemaAccessoryList,
  schemaToolsList
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={combinedSchema}
  datePublished="1998-01-01"
  dateModified={new Date().toISOString().split("T")[0]}
>

<style>
  :root {
    --color-bg: #000000;
    --color-bg-card: #000000;
    --color-bg-light: #000000;
    --color-bg-secondary: #000000;
    --color-bg-footer: #000000;
    --color-bg-input: #000000;
    --color-bg-modal: #000000;
    --color-bg-button: #000000;
    
    --color-text: #FFFFFF;
    --color-text-subtle: rgba(255, 255, 255, 0.7);
    --color-text-placeholder: rgba(255, 255, 255, 0.5);
    
    --color-accent: #e00;
    --color-border: #e00;
    --color-border-thin: #e00;
    --color-border-input: #e00;
    --color-border-focus: #e00;
    --color-link-hover: #e00;
    --color-red: #e00;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
    --space-2xl: 5rem;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --transition: 0.2s ease;
  }

  .index {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.7;
  }

  .index__container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .index__section {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border-red);
  }

  .index__section--no-border {
    border-bottom: none;
  }

  .index__section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .index__section-label {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .index__section-title {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    color: var(--color-text);
