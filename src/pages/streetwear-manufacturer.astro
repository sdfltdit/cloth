---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Streetwear Manufacturer Bangladesh | 300 Piece MOQ | SDF";
const pageDescription = "Leading streetwear manufacturer in Bangladesh. 300 piece MOQ, heavyweight tees, oversized hoodies. Custom graphic apparel. Get free quote for streetwear.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Streetwear manufacturer from Bangladesh providing heavyweight tees, oversized hoodies, joggers, and graphic apparel for streetwear brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for streetwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce heavyweight streetwear tees?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer heavyweight tees from 220-280 GSM for premium streetwear positioning. Heavyweight tees provide substantial weight and durability for premium streetwear brands."
          }
        },
        {
          "@type": "Question",
          "name": "What streetwear categories do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture heavyweight tees, oversized boxy tees, heavyweight hoodies 380-450 GSM, drop-shoulder hoodies, cargo pants and joggers, coach jackets, workwear-inspired pieces, and graphic prints and embroidery."
          }
        },
        {
          "@type": "Question",
          "name": "Can you do oversized and drop-shoulder fits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Oversized and drop-shoulder fits are our specialty for streetwear brands. We use specialized grading and construction techniques to achieve authentic oversized silhouettes with consistent sizing."
          }
        },
        {
          "@type": "Question",
          "name": "How long does streetwear production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic streetwear. 35-50 days for custom fabric development or heavyweight options. 7-14 days for sampling before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce graphic prints and embroidery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer screen printing (plastisol, water-based), DTG printing, embroidery, patches, and custom branding. Streetwear brands often combine multiple techniques for premium graphic apparel."
          }
        },
        {
          "@type": "Question",
          "name": "What streetwear fabrics do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer heavyweight cotton 240-300 GSM, French terry 280-350 GSM, fleece 300-450 GSM, denim, and performance fabrics. Oversized fits require heavier fabrics for structure and drape. All fabrics available in various weights for different streetwear aesthetics."
          }
        },
        {
          "@type": "Question",
          "name": "Can you manufacture oversized and drop-shoulder streetwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We specialize in oversized streetwear including drop-shoulder hoodies, boxy fit t-shirts, wide-leg pants, and baggy joggers. Custom measurements and proportions accommodated. Oversized fits require 300-piece minimum per style with specialized pattern development."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Streetwear Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Streetwear Manufacturing Service",
      "description": "Custom streetwear manufacturing from 300 pieces with heavyweight tees, oversized hoodies, and graphic apparel options",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Streetwear Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Heavyweight Streetwear Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "10",
              "maxPrice": "30"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Streetwear from SDF Clothing",
      "description": "Step-by-step process for ordering custom streetwear from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your streetwear design, fabric specifications (GSM preferences), size chart, target quantity, and decoration requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, decoration, and shipping for your streetwear order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review streetwear samples for fit, fabric weight, print/embroidery quality within 7-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard streetwear items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your streetwear order"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="streetwear manufacturer, custom streetwear manufacturer, heavyweight tee manufacturer, oversized hoodie manufacturer, streetwear brand manufacturer, low MOQ streetwear" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Streetwear Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Streetwear Manufacturer | Since 1998 | Heavyweight Options</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Streetwear Manufacturer from 300 Pieces | Low MOQ Options
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Streetwear is defined by oversized fits, heavyweight fabrics, and bold graphics. The right streetwear production defines your brand identity and customer loyalty. SDF Clothing, a full-service clothing manufacturer in Bangladesh, produces streetwear from heavyweight tees, oversized hoodies, joggers, and graphic apparel. From 300 pieces per style with specialized construction for authentic streetwear silhouettes.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20streetwear-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">450+</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">GSM Heavyweight</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">30-40</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Oversized</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Fits Available</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Streetwear Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our streetwear manufacturing covers the full production cycle from fabric sourcing to finished garment. We source heavyweight fabrics from certified mills, cut, sew with specialized construction for oversized fits, apply graphic treatments, and package for shipment.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Production capacity: 40,000-60,000 streetwear pieces per month across multiple production lines. We handle basic streetwear for wholesale, premium heavyweight streetwear for boutique brands, and graphic-heavy collections for fashion-forward lines.
    </p>
  </div>
</section>

<!-- Categories Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Streetwear Garment Categories</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Heavyweight Tees (220-280 GSM)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Premium heavyweight tees for streetwear positioning. 220-240 GSM for premium heavyweight, 250-280 GSM for extra heavyweight category. Substantial weight and durability for premium streetwear brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Oversized Boxy Tees</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Authentic oversized boxy tees with drop shoulders and relaxed fit. Specialized grading for consistent oversized silhouette across all sizes. Popular for contemporary streetwear brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Heavyweight Hoodies (380-450 GSM)</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Premium heavyweight hoodies for streetwear. 380-400 GSM for standard heavyweight hoodies, 410-450 GSM for extra heavyweight category. Substantial weight for premium streetwear positioning.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Drop-Shoulder Hoodies</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Authentic drop-shoulder hoodies with relaxed fit and oversized silhouette. Specialized construction for authentic streetwear aesthetic. Available in pullover and zip-up styles.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cargo Pants and Joggers</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Cargo pants with functional pockets and joggers with elastic waistbands. Available in heavyweight cotton and cotton-spandex blends. Oversized and relaxed fits for streetwear aesthetic.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Coach Jackets</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic coach jackets with snap-front closures. Available in satin, nylon, and cotton materials. Custom embroidery and patches for branding. Popular for streetwear collections.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Workwear-Inspired Pieces</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Workwear-inspired streetwear including chore coats, work shirts, and utility pants. Authentic workwear details with modern streetwear styling. Heavyweight fabrics and reinforced construction.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Graphic Prints and Embroidery</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Full-service graphic apparel production. Screen printing (plastisol, water-based, puff), DTG printing, embroidery, patches, and custom branding. Streetwear brands often combine multiple techniques.
    </p>
  </div>
</section>

<!-- Construction Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Construction</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Streetwear Construction Details</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Heavyweight fabric specifications (220-450 GSM)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Oversized fits and grading (authentic silhouettes)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Premium trims and details (heavyweight zippers, metal hardware)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Specialty washes and treatments (enzyme wash, vintage effects)
      </li>
    </ul>
  </div>
</section>

<!-- Customization Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Customization</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Streetwear Customization</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Screen printing (plastisol, water-based, puff, discharge)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Embroidery and patches (woven, embroidered, leather)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Custom trims and labels (heavyweight zippers, metal buttons)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Heavyweight branded packaging (custom boxes, stickers)
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Heavyweight tee (220-280 GSM): $6-12 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Heavyweight hoodie (380-450 GSM): $10-18 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Cargo pants/joggers: $12-20 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. Custom printing, embroidery, and premium packaging are additional.
    </p>

    <table style="width:100%;max-width:800px;margin-top:2rem;border-collapse:collapse;background:#0a0a0a;">
      <thead>
        <tr style="background:#e00;">
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Product Type</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">GSM Range</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">MOQ</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Price (500 pcs)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Heavyweight T-Shirts</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">220-280 GSM</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$8-15 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Oversized Hoodies</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">380-450 GSM</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Cargo Joggers</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">280-340 GSM</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$12-20 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Coach Jackets</td>
