    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">DPP Documentation</p>
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Product Passport Data</h3>
