const pageDescription = "Custom joggers manufacturer in Bangladesh. Cotton fleece, French terry from 300 pieces. Tapered fit, cuffed ankles, cargo styles. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
