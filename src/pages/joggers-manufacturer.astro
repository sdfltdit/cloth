              <td>Roomy fit, comfort focus, warm</td>
              <td>Lounging, casual wear, cold climates</td>
              <td>$</td>
            </tr>
            <tr>
              <td>Cargo Joggers</td>
              <td>280-320</td>
              <td>Multiple pockets, utility focus, functional</td>
              <td>Utility fashion, practical wear</td>
              <td>$$$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Track Joggers</td>
              <td>260-300</td>
              <td>Side stripes, sport aesthetic, ribbed cuffs</td>
              <td>Athletic heritage, retro styling</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Fleece-Lined Joggers</td>
              <td>320-380</td>
              <td>Fleece interior, maximum warmth, cold weather</td>
              <td>Winter wear, outdoor lifestyle</td>
              <td>$$$</td>
