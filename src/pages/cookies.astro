---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Cookie Policy | SDF Clothing";
const pageDescription = "SDF Clothing's full cookie policy — what cookies we use, why we use them, and how to manage your preferences. GDPR and international standard compliant.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Cookie Policy",
		"description": "SDF Clothing cookie policy — GDPR compliant breakdown of all cookies used on sdfltd.com.",
		"url": "https://sdfltd.com/cookies",
		"dateModified": "2026-05-07",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
				{ "@type": "ListItem", "position": 2, "name": "Cookie Policy", "item": "https://sdfltd.com/cookies" }
			]
		}
	}
	</script>

	<!-- Main Cookie Policy Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Cookie Policy</h1>
				<p class="text-white/70 mb-2">Last updated: May 7, 2026 | Version 1.0</p>
			</div>

			<div class="prose prose-invert max-w-none" style="font-size: 0.95rem; line-height: 1.9; color: #fff;">
				
				<!-- SECTION 1 — WHAT ARE COOKIES -->
				<h2 id="what-are-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 1 — WHAT ARE COOKIES
				</h2>
				<p style="margin-bottom: 2rem;">
					Cookies are small text files placed on your device when you visit a website. They allow the website to remember your actions and preferences over time, so you do not have to re-enter information every time you visit. Cookies are not programs and cannot carry viruses or malware. They serve essential functions ranging from security to performance optimisation and user experience improvements.
				</p>

				<!-- SECTION 2 — WHO WE ARE -->
				<h2 id="who-we-are" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 2 — WHO WE ARE
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd is the operator of sdfltd.com, a Bangladesh-based international garment manufacturer and exporter. We are the data controller for all cookies set by this website. For privacy-related enquiries, please use our <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a> at /contact.
				</p>

				<!-- SECTION 3 — HOW WE USE COOKIES -->
				<h2 id="how-we-use-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 3 — HOW WE USE COOKIES
				</h2>
				<p style="margin-bottom: 2rem;">
					We use cookies to:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Ensure the website functions correctly and securely</li>
					<li style="margin-bottom: 0.75rem;">Protect against malicious traffic and bot attacks (via Cloudflare)</li>
					<li style="margin-bottom: 0.75rem;">Remember your cookie consent preferences</li>
					<li style="margin-bottom: 0.75rem;">Analyse how visitors use our website so we can improve it</li>
					<li style="margin-bottom: 0.75rem;">Measure the effectiveness of our content and pages</li>
				</ul>
				<p style="margin-bottom: 1.5rem;">We do NOT use cookies for:</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Advertising or retargeting</li>
					<li style="margin-bottom: 0.75rem;">Selling data to third parties</li>
					<li style="margin-bottom: 0.75rem;">Cross-site tracking for marketing purposes</li>
					<li style="margin-bottom: 0.75rem;">Profiling individual visitors for commercial gain</li>
				</ul>

				<!-- SECTION 4 — TYPES OF COOKIES WE USE -->
				<h2 id="types-of-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 4 — TYPES OF COOKIES WE USE
				</h2>
				<p style="margin-bottom: 2rem;">
					The table below provides a complete breakdown of all cookies used on sdfltd.com, their purpose, and duration.
				</p>
				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; background: #000; border: 1px solid #333;">
						<thead>
							<tr style="border-bottom: 1px solid #333;">
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Cookie Name</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Set By</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Type</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Purpose</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Duration</th>
							</tr>
						</thead>
						<tbody>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">cf_clearance</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cloudflare</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Strictly Necessary</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Security challenge verification token — confirms the visitor has passed a Cloudflare security check</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Session</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">__cf_bm</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cloudflare</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Strictly Necessary</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Bot management — distinguishes between humans and automated traffic to protect the website</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">30 minutes</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">__cfruid</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cloudflare</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Strictly Necessary</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cloudflare internal rate limiting and abuse prevention</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Session</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">sdf_cookie_consent</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">SDF Clothing</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Strictly Necessary</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Stores your cookie consent preferences so you are not asked again on every visit</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">1 year</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">_ga</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Google Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Assigns a unique identifier to each visitor to distinguish users and calculate visit metrics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">2 years</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">_ga_XXXXXXXXXX</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Google Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Used to persist session state across page requests for Google Analytics 4</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">2 years</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">_gid</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Google Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Stores and updates a unique value for each page visited — used for daily visit tracking</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">24 hours</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">_gat</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Google Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Analytics</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Used to throttle the rate of requests to Google Analytics servers</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">1 minute</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p style="margin-bottom: 2rem;">
					We do not use advertising cookies, social media tracking cookies, or any third-party marketing pixels on this website.
				</p>

				<!-- SECTION 5 — STRICTLY NECESSARY COOKIES -->
				<h2 id="strictly-necessary-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 5 — STRICTLY NECESSARY COOKIES (CANNOT BE DISABLED)
				</h2>
				<p style="margin-bottom: 2rem;">
					These cookies are essential for the website to function. Without them, the site cannot operate securely. They do not require your consent under GDPR, UK GDPR, or PECR (Privacy and Electronic Communications Regulations). They are set automatically when you visit the site.
				</p>
				<p style="margin-bottom: 2rem;">
					Cloudflare cookies (cf_clearance, __cf_bm, __cfruid) are set by our hosting and security infrastructure provider, Cloudflare Inc. These cookies protect our website against DDoS attacks, malicious bots, and automated scraping. They do not collect any personally identifiable information beyond what is technically necessary for security purposes. Cloudflare's privacy policy: <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://www.cloudflare.com/privacypolicy/</a>
				</p>
				<p style="margin-bottom: 2rem;">
					Our consent cookie (sdf_cookie_consent) records whether you have accepted or declined non-essential cookies. This is required to comply with GDPR consent obligations and ensures we do not repeatedly ask for consent you have already given.
				</p>

				<!-- SECTION 6 — ANALYTICS COOKIES -->
				<h2 id="analytics-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 6 — ANALYTICS COOKIES (REQUIRE CONSENT)
				</h2>
				<p style="margin-bottom: 2rem;">
					We use Google Analytics 4 to understand how visitors interact with our website. This helps us identify which pages are most useful, how users navigate the site, and where we can improve the experience.
				</p>
				<p style="margin-bottom: 2rem;">
					Important facts about our analytics cookies:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">IP anonymisation is enabled — your full IP address is never stored by Google Analytics</li>
					<li style="margin-bottom: 0.75rem;">We do not use Google Analytics data for advertising purposes</li>
					<li style="margin-bottom: 0.75rem;">Data is processed by Google LLC and may be stored on servers in the United States — governed by Standard Contractual Clauses under GDPR</li>
					<li style="margin-bottom: 0.75rem;">You can opt out of Google Analytics tracking at any time using Google's opt-out browser add-on: <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://tools.google.com/dlpage/gaoptout</a></li>
					<li style="margin-bottom: 0.75rem;">Analytics cookies are only set if you click "Accept All" on our cookie banner. If you click "Decline", no analytics cookies are placed.</li>
				</ul>
				<p style="margin-bottom: 2rem;">
					Google's privacy policy: <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://policies.google.com/privacy</a>
				</p>

				<!-- SECTION 7 — OUR COOKIE BANNER & YOUR CHOICES -->
				<h2 id="cookie-banner" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 7 — OUR COOKIE BANNER & YOUR CHOICES
				</h2>
				<p style="margin-bottom: 2rem;">
					When you first visit sdfltd.com, you will see our cookie consent banner. You have two options:
				</p>
				<p style="margin-bottom: 2rem;">
					<strong>Accept All:</strong> Strictly necessary cookies plus analytics cookies will be set. This helps us improve the website for all visitors.
				</p>
				<p style="margin-bottom: 2rem;">
					<strong>Decline:</strong> Only strictly necessary cookies will be set. Your visit will not be tracked by Google Analytics.
				</p>
				<p style="margin-bottom: 2rem;">
					You can change your preference at any time by clearing your browser cookies and revisiting the site, which will trigger the banner again.
				</p>

				<!-- SECTION 8 — HOW TO MANAGE COOKIES IN YOUR BROWSER -->
				<h2 id="manage-cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 8 — HOW TO MANAGE COOKIES IN YOUR BROWSER
				</h2>
				<p style="margin-bottom: 2rem;">
					You can control and delete cookies through your browser settings. Note that disabling all cookies may affect the functionality of this and other websites.
				</p>

				<p style="margin-bottom: 1.5rem;"><strong>Google Chrome:</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Settings → Privacy and Security → Cookies and other site data → See all cookies and site data → Search "sdfltd.com" → Delete</p>

				<p style="margin-bottom: 1.5rem;"><strong>Mozilla Firefox:</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Settings → Privacy & Security → Cookies and Site Data → Manage Data → Search "sdfltd.com" → Remove</p>

				<p style="margin-bottom: 1.5rem;"><strong>Apple Safari:</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Preferences → Privacy → Manage Website Data → Search "sdfltd.com" → Remove</p>

				<p style="margin-bottom: 1.5rem;"><strong>Microsoft Edge:</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Settings → Cookies and site permissions → Manage and delete cookies and site data → See all cookies → Search "sdfltd.com" → Delete</p>

				<p style="margin-bottom: 1.5rem;"><strong>Samsung Internet (Mobile):</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Settings → Privacy → Smart Anti-Tracking → Delete browsing data → Cookies</p>

				<!-- SECTION 9 — GREEN HOSTING & ENVIRONMENTAL COMMITMENT -->
				<h2 id="green-hosting" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 9 — GREEN HOSTING & OUR ENVIRONMENTAL COMMITMENT
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing's website is hosted exclusively on Cloudflare Pages — officially certified as a green host by the Green Web Foundation, running on 100% renewable energy. This means the cookies set by Cloudflare on our website are part of a renewable-energy-powered security infrastructure.
				</p>
				<p style="margin-bottom: 2rem;">
					As a company committed to sustainable manufacturing — including active tree plantation initiatives — we believe every aspect of our business, including our digital infrastructure, should reflect our environmental values.
				</p>
				<p style="margin-bottom: 2rem;">
					You can verify our green hosting status at: <a href="https://www.thegreenwebfoundation.org/" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://www.thegreenwebfoundation.org/</a>
				</p>

				<!-- SECTION 10 — THIRD-PARTY LINKS -->
				<h2 id="third-party-links" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 10 — THIRD-PARTY LINKS
				</h2>
				<p style="margin-bottom: 2rem;">
					Our website may contain links to third-party websites, including industry partners, certification bodies, and payment providers. These websites have their own cookie policies. We are not responsible for cookies set by external websites. We encourage you to review the cookie and privacy policies of any third-party site you visit.
				</p>

				<!-- SECTION 11 — CHANGES TO THIS COOKIE POLICY -->
				<h2 id="changes-to-policy" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 11 — CHANGES TO THIS COOKIE POLICY
				</h2>
				<p style="margin-bottom: 2rem;">
					We may update this Cookie Policy from time to time to reflect changes in the cookies we use, regulatory requirements, or improvements to our practices. The "Last updated" date at the top of this page indicates when the policy was last revised. We encourage you to review this page periodically.
				</p>

				<!-- SECTION 12 — CONTACT -->
				<h2 id="contact" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 12 — CONTACT
				</h2>
				<p style="margin-bottom: 2rem;">
					If you have any questions about our use of cookies or this Cookie Policy, please use our <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a> at /contact. We will respond within 30 days.
				</p>
				<p style="margin-bottom: 2rem;">
					For regulatory complaints regarding our use of cookies:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>EU residents:</strong> Contact your national Data Protection Authority — <a href="https://edpb.europa.eu/about-edpb/about-edpb/members_en" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://edpb.europa.eu/about-edpb/about-edpb/members_en</a></li>
					<li style="margin-bottom: 0.75rem;"><strong>UK residents:</strong> Information Commissioner's Office — <a href="https://ico.org.uk" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://ico.org.uk</a></li>
					<li style="margin-bottom: 0.75rem;"><strong>California residents:</strong> California Privacy Protection Agency — <a href="https://cppa.ca.gov" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://cppa.ca.gov</a></li>
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>
