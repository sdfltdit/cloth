---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Small Batch Activewear Manufacturer | 100+ pcs | SDF";
const pageDescription = "Small batch activewear manufacturer in Bangladesh. Leggings, sports bras and sets from 100 pieces. Technical fabrics, OEKO-TEX. Get a free factory quote today.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Small Batch Activewear Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for small batch activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our small batch minimum is 100 pieces per style. This applies per colorway and size range, allowing you to test activewear designs with manageable inventory for sizing validation and fabric testing."
          }
        },
        {
          "@type": "Question",
          "name": "How long does small batch activewear production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small batch activewear production takes 30-40 days from fabric receipt. Sampling requires 10-14 days before bulk commitment. Technical fabric development adds 7-10 days for custom materials."
          }
        },
        {
          "@type": "Question",
          "name": "Can I mix leggings and sports bras in a 100-piece order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can order 100 pieces split between leggings, sports bras, and sets. Each style counts toward the minimum. Mix styles to test complete activewear collections with your target market."
          }
        },
        {
          "@type": "Question",
          "name": "What technical fabrics are available for small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4-way stretch polyester, moisture-wicking blends, compression fabrics, bamboo blends, recycled polyester (GRS certified). All fabrics tested for stretch recovery, moisture management, and durability."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide plus size activewear in small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Plus size activewear available from 100 pieces. Extended size ranges up to 5XL with specialized grading for activewear fit. Same quality standards across all sizes."
          }
        },
        {
          "@type": "Question",
          "name": "What construction techniques are used for activewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flatlock seams for comfort, bonded seams for compression, 4-way stretch construction, reinforced stress points, high-rise waistbands with hidden pockets. All techniques available at small batch quantities."
          }
        },
        {
          "@type": "Question",
          "name": "How much does small batch activewear cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pricing depends on fabric, style, and construction. Basic leggings: $6-9 per piece at 100 pieces, $4-6 per piece at 300 pieces. Sports bras: $5-8 per piece at 100 pieces. Sets: $10-15 per piece at 100 pieces."
          }
        },
        {
          "@type": "Question",
          "name": "Why do activewear startups need small batch most?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Activewear requires precise sizing validation and fabric testing before scaling. Small batch enables testing of technical fabrics, fit across size ranges, and customer feedback on performance features before committing to large inventory."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Small Batch Activewear Manufacturing Service",
      "description": "Custom activewear manufacturing from 100 pieces for brands with performance fabrics and technical testing",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Small Batch Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Small Batch Activewear Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "150",
              "maxPrice": "600"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Small Batch Activewear from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Brief",
          "text": "Send your activewear design, fabric preference, technical requirements, size range, target quantity, and decoration requirements via our contact form."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote Within 24 Hours",
          "text": "Get detailed pricing including fabric cost, unit price, sampling fee, decoration costs, and lead times. All costs itemized for transparency."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Receive physical samples in 10-14 days. Evaluate fit, fabric performance, stretch recovery, moisture management, and construction quality. Revisions included before bulk commitment."
        },
        {
          "@type": "HowToStep",
          "name": "Place Bulk Order",
          "text": "Confirm purchase order for 100+ pieces. Production starts with inline quality checks at cutting, sewing, and finishing stages."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Shipment",
          "text": "Final inspection, packing, and export documentation. Ship to your freight forwarder or direct warehouse. Track throughout transit."
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Small Batch Activewear Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Small Batch Production | Since 1998 | Bangladesh Factory</div>
        <h1 class="hero__title">Small Batch Activewear Manufacturer | Custom Gym Wear from 100 Pieces for Fitness and Wellness Brands</h1>
        <p class="hero__description">
          Launch your activewear line without traditional bulk minimums. SDF Clothing, a full-service clothing manufacturer, produces custom leggings, sports bras, and sets in Bangladesh from 100 pieces per style with technical fabrics, OEKO-TEX certification, and performance construction. Perfect for fitness brands, wellness startups, and brands testing new designs with sizing validation.
        </p>
        <div class="hero__ctas">
          <a href="/contact/" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20small%20batch%20activewear`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">100</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">98%</span>
          <span class="hero__stat-label">On-Time Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Understanding Small Batch</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What Small Batch Activewear Manufacturing Actually Means</h2>
      </div>
      <div class="section__text">
        <p>Small batch activewear production refers to orders between 100-300 pieces per style, significantly lower than traditional bulk manufacturing which typically requires 1,000-5,000 pieces minimum. Activewear is unique among clothing categories because it requires precise sizing validation and technical fabric testing before scaling. For fitness and wellness brands, small batch means you can test technical fabrics, validate fit across diverse body types, and gather customer feedback on performance features without committing to large inventory that may not meet market expectations.</p>
        
        <p>The 100-piece minimum at SDF applies per style, colorway, and size range. You can order 100 pieces of a single legging style in one color across multiple sizes, or split the quantity between leggings, sports bras, and matching sets with 30-40 pieces each. This flexibility enables you to test complete activewear collections with coordinated pieces before scaling production. For example, a fitness brand might order 100 pieces split between high-waisted leggings and matching sports bras to test customer response to the full collection, then scale to 300-500 pieces per style once the collection is validated.</p>
        
        <p>Small batch activewear production at SDF maintains the same technical standards as our bulk orders. Every piece receives the same attention to fabric sourcing, construction quality, and performance testing regardless of order size. Activewear requires specialized construction | flatlock seams for comfort, 4-way stretch for mobility, reinforced stress points for durability, and moisture-wicking fabrics for performance | and we maintain these standards even at 100-piece quantities. Your small batch order receives the same care and quality control as orders from established fitness brands ordering thousands of pieces.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Cost Analysis</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Small Batch vs Bulk | Cost Per Unit Comparison</h2>
      </div>
      <div class="section__text">
        <p>Activewear pricing reflects technical fabric costs and specialized construction requirements. The table below shows typical FOB Bangladesh pricing for technical polyester activewear. Unit costs decrease as quantity increases, but small batch pricing remains competitive compared to domestic production. Activewear commands premium retail pricing due to performance features, so healthy profit margins are achievable even at 100-piece quantities with proper positioning.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Quantity</th>
              <th>Leggings Cost/Unit</th>
              <th>Sports Bra Cost/Unit</th>
              <th>Set Cost/Unit</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>100 pieces</td>
              <td>$7.50 - $9.50</td>
              <td>$6.00 - $8.00</td>
              <td>$12.00 - $15.00</td>
              <td>Sizing validation, fabric testing</td>
            </tr>
            <tr>
              <td>200 pieces</td>
              <td>$6.00 - $8.00</td>
              <td>$5.00 - $7.00</td>
              <td>$10.00 - $13.00</td>
              <td>Small brand launch, pilot collection</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>300 pieces</td>
              <td>$5.00 - $7.00</td>
              <td>$4.00 - $6.00</td>
              <td>$8.00 - $11.00</td>
              <td>Brand scaling, seasonal collection</td>
            </tr>
            <tr>
              <td>500 pieces</td>
              <td>$4.00 - $6.00</td>
              <td>$3.50 - $5.50</td>
              <td>$7.00 - $10.00</td>
              <td>Growing brand, wholesale orders</td>
            </tr>
            <tr>
              <td>1,000 pieces</td>
              <td>$3.50 - $5.50</td>
              <td>$3.00 - $5.00</td>
              <td>$6.00 - $9.00</td>
              <td>Established brand, retail chains</td>
            </tr>
            <tr>
              <td>2,000+ pieces</td>
              <td>$3.00 - $5.00</td>
              <td>$2.50 - $4.50</td>
              <td>$5.00 - $8.00</td>
              <td>Large scale production, major retail</td>
            </tr>
          </tbody>
          <caption>Prices are FOB Bangladesh for technical polyester activewear with standard construction. Actual pricing depends on fabric specifications, construction complexity, and current market conditions.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Technical Fabrics</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Fabric Options Available at Small Batch Quantities</h2>
      </div>
      <div class="section__text">
        <p>Small batch activewear production doesn't mean limited fabric options. SDF offers the full range of technical fabrics at 100-piece minimums, including premium materials that many manufacturers restrict to bulk orders only. Technical fabric selection impacts performance features like moisture management, stretch recovery, and compression. All fabrics are tested for stretch recovery, moisture wicking, colorfastness, and durability regardless of order size.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>Composition</th>
              <th>Features</th>
              <th>Best For</th>
              <th>Small Batch Available?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>4-Way Stretch Polyester</td>
              <td>88% Polyester, 12% Spandex</td>
              <td>4-way stretch, moisture-wicking</td>
              <td>Leggings, performance wear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Compression Fabric</td>
              <td>80% Nylon, 20% Spandex</td>
              <td>High compression, muscle support</td>
              <td>Sports bras, compression wear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Moisture-Wicking Blend</td>
              <td>85% Polyester, 15% Spandex</td>
              <td>Quick-dry, breathable</td>
              <td>Gym wear, training gear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Bamboo Blend</td>
              <td>70% Bamboo, 30% Cotton</td>
              <td>Soft, antimicrobial, sustainable</td>
              <td>Yoga wear, wellness brands</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Recycled Polyester (GRS)</td>
              <td>85% Recycled Polyester, 15% Spandex</td>
              <td>Sustainable, performance</td>
              <td>Eco-friendly activewear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Organic Cotton Blend</td>
              <td>90% Organic Cotton, 10% Spandex</td>
              <td>Natural feel, light stretch</td>
              <td>Yoga, low-impact activities</td>
              <td>Yes</td>
            </tr>
          </tbody>
          <caption>All fabrics available at 100-piece minimum with full certification documentation. Fabric sourcing included in production.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Construction Techniques</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Print and Decoration at Small Batch</h2>
      </div>
      <div class="section__text">
        <p>Activewear construction requires specialized techniques for performance and comfort. Small batch production at SDF includes all standard activewear construction methods without quantity restrictions. Flatlock seams prevent chafing, bonded seams provide smooth surfaces for compression garments, and reinforced stress points ensure durability during high-impact activities. All construction techniques available at 100-piece minimum with the same quality as bulk orders.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Technique</th>
              <th>Min Qty</th>
              <th>Application</th>
              <th>Benefits</th>
              <th>Cost Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Flatlock Seams</td>
              <td>100 pieces</td>
              <td>All activewear</td>
              <td>No chafing, flat surface</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Bonded Seams</td>
              <td>100 pieces</td>
              <td>Compression wear</td>
              <td>Smooth, seamless feel</td>
              <td>+$0.30-0.50/pc</td>
            </tr>
            <tr>
              <td>4-Way Stretch Construction</td>
              <td>100 pieces</td>
              <td>Leggings, performance</td>
              <td>Maximum mobility</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Reinforced Stress Points</td>
              <td>100 pieces</td>
              <td>All activewear</td>
              <td>Durability</td>
              <td>Standard</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>High-Rise Waistband</td>
              <td>100 pieces</td>
              <td>Leggings</td>
              <td>Tummy control, secure fit</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Hidden Waistband Pockets</td>
              <td>100 pieces</td>
              <td>Leggings</td>
              <td>Convenience, storage</td>
              <td>+$0.50-1.00/pc</td>
            </tr>
          </tbody>
          <caption>All construction techniques available at 100-piece minimum. Costs are approximate and depend on complexity.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Our Process</span>
        <div class="accent-line"></div>
        <h2 class="section__title">SDF Small Batch Process | From Design to Delivery</h2>
      </div>
      <div class="process">
        <div class="process__step">
          <div class="process__number">1</div>
          <div class="process__content">
            <h3 class="process__title">Submit Your Design Brief</h3>
            <p class="process__text">Include your activewear design, fabric preference, technical requirements (compression, moisture-wicking), size range, target quantity, and decoration requirements. Submit via <a href="/contact/" style="color: var(--color-primary);">our sample request form</a> or contact form. Response within 24 hours.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">2</div>
          <div class="process__content">
            <h3 class="process__title">Receive Detailed Quote</h3>
            <p class="process__text">Quote includes fabric options, unit cost at target quantity, sampling fee, decoration costs, and both sample and bulk lead times. All costs itemized for transparency. Adjust specifications to optimize pricing for your brand.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">3</div>
          <div class="process__content">
            <h3 class="process__title">Sample Production | 10 to 14 Days</h3>
            <p class="process__text">One to three samples per design depending on complexity. Receive physical samples for evaluation. Check fit across size range, fabric performance (stretch recovery, moisture management), and construction quality. Revisions included before bulk commitment.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">4</div>
          <div class="process__content">
            <h3 class="process__title">Place Bulk Order | From 100 Pieces</h3>
            <p class="process__text">Purchase order confirmation starts production. 30% deposit required, balance before shipment. Inline quality checks at cutting, sewing, and finishing stages. Production capacity: 40,000 pieces per month per style.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">5</div>
          <div class="process__content">
            <h3 class="process__title">Final Inspection, Packing, and Shipment</h3>
            <p class="process__text">AQL inspection covers stretch recovery and seam strength alongside standard visual checks before packing. Goods ship to your freight forwarder or direct warehouse with packing list, commercial invoice, certifications, and fabric test reports included, ready for retail.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Small Batch Activewear FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What is the minimum order quantity for small batch activewear?</h3>
          <p class="faq__answer">Our small batch minimum is 100 pieces per style. This applies per colorway and size range, allowing you to test activewear designs with manageable inventory for sizing validation and fabric testing before scaling production.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How long does small batch activewear production take?</h3>
          <p class="faq__answer">Small batch activewear production takes 30-40 days from fabric receipt. Sampling requires 10-14 days before bulk commitment. Technical fabric development adds 7-10 days for custom materials. Rush production available at additional cost.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Can I mix leggings and sports bras in a 100-piece order?</h3>
          <p class="faq__answer">Yes. You can order 100 pieces split between leggings, sports bras, and sets. Each style counts toward the minimum. Mix styles to test complete activewear collections with your target market before committing to larger quantities of each.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What technical fabrics are available for small batch?</h3>
          <p class="faq__answer">4-way stretch polyester, moisture-wicking blends, compression fabrics, bamboo blends, recycled polyester (GRS certified). All fabrics tested for stretch recovery, moisture management, and durability. Fabric sourcing included in production.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you provide plus size activewear in small batch?</h3>
          <p class="faq__answer">Yes. Plus size activewear available from 100 pieces. Extended size ranges up to 5XL with specialized grading for activewear fit. Same quality standards and construction techniques across all sizes. Inclusive sizing from launch.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What construction techniques are used for activewear?</h3>
          <p class="faq__answer">Flatlock seams for comfort, bonded seams for compression, 4-way stretch construction, reinforced stress points, high-rise waistbands with hidden pockets. All techniques available at small batch quantities with same quality as bulk orders.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How much does small batch activewear cost?</h3>
          <p class="faq__answer">Pricing depends on fabric, style, and construction. Basic leggings: $6-9 per piece at 100 pieces, $4-6 per piece at 300 pieces. Sports bras: $5-8 per piece at 100 pieces. Sets: $10-15 per piece at 100 pieces. Use our <a href="/tools/price-calculator/" style="color: var(--color-primary);">price calculator</a> for detailed estimates.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Why do activewear startups need small batch most?</h3>
          <p class="faq__answer">Activewear requires precise sizing validation and fabric testing before scaling. Small batch enables testing of technical fabrics, fit across size ranges, and customer feedback on performance features before committing to large inventory. Reduces risk of sizing issues or fabric performance problems at scale.</p>
        </div>
      </div>
    </div>
