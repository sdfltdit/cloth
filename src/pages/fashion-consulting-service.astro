---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Fashion Consulting Service Bangladesh | Brand Strategy & ...";
const pageDescription = "Fashion brand consulting from Bangladesh. Manufacturing strategy, fabric sourcing advice, MOQ planning, production timeline. Free initial consultation.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Fashion Consulting Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/fashion-consulting-service/"
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="fashion consulting service, fashion brand consultant, manufacturing consulting, sourcing consulting, fashion production strategy, fashion brand advisor" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Fashion Consulting Service
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Fashion Consulting | Since 1998 | Free Initial Consultation</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Fashion Consulting Service for New and Growing Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Strategic guidance from a working clothing manufacturer for fashion brands navigating manufacturing decisions. Our consulting service covers manufacturing strategy (OEM vs ODM vs CMT), fabric sourcing advice, MOQ planning, cost optimization, and production timeline management. Free initial consultation for new brands.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Free Consultation</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20fashion%20consulting`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
