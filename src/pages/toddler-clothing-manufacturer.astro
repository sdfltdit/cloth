      "name": "Toddler Clothing Manufacturing Service",
      "description": "Custom toddler clothing manufacturing from 300 pieces including safe kids wear, organic cotton toddler clothing with EN 14682 compliance and hypoallergenic fabrics",
      "provider": {
        "@id": "https://sdfltd.com/#organization"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Toddler Clothing Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Toddler Clothing Production"
