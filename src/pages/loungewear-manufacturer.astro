---
import { getYearsExperiencePlus } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, schemaPerson, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "Loungewear Manufacturer | Lounge Sets & Home Wear | SDF";
const pageDescription = "Loungewear manufacturer in Bangladesh. Comfortable lounge sets, sleepwear, and casual home wear. 300 piece MOQ. Get your free quote for loungewear today.";

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20loungewear%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-21",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle
          }
        ]
      },
      "publisher": { "@id": SITE + "/#org" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is loungewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Loungewear is casual, comfortable clothing designed for relaxing at home. Unlike sleepwear which is specifically for sleeping, loungewear is suitable for wearing around the house during the day. Loungewear includes lounge sets, joggers, hoodies, sweatshirts, and relaxed-fit tops. The category has expanded significantly with the rise of remote work and athleisure trends. Loungewear balances comfort with presentability - you're comfortable at home but presentable enough for quick errands or video calls."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between loungewear and sleepwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sleepwear is specifically designed for sleeping, typically featuring lighter fabrics, loose fits, and minimal fasteners for comfort during sleep. Loungewear is designed for daytime home wear, often with more structured designs, durable fabrics, and presentable styling. Sleepwear includes pajamas, nightgowns, and robes. Loungewear includes lounge sets, joggers, hoodies, and casual separates. While some garments overlap (like comfortable robes), loungewear is generally more substantial and designed for visibility, while sleepwear prioritizes sleeping comfort above appearance."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics are best for loungewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Best loungewear fabrics include cotton for breathability and natural feel, polyester for durability and wrinkle resistance, and blends like poly-cotton for balanced performance. Modal and rayon offer luxurious softness and drape. Fleece provides warmth for winter loungewear. Jersey knits offer stretch and comfort. For premium loungewear, bamboo fabric offers softness and sustainability. The best fabric depends on your target market and price point - cotton for natural preference, polyester for durability and affordability, blends for balanced performance. SDF sources all loungewear fabric types."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most popular loungewear styles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Popular loungewear styles include matching lounge sets (coordinating tops and bottoms), joggers with elastic waistbands, hoodies and sweatshirts, relaxed-fit t-shirts, casual dresses, and lounge shorts. Lounge sets are particularly popular, offering coordinated looks in comfortable fabrics. Athleisure-inspired pieces like leggings and crop tops bridge loungewear and casual wear. Oversized silhouettes, neutral colors, and minimalist designs are trending. Comfort-focused features like elastic waists, soft fabrics, and relaxed fits are essential across all loungewear styles."
          }
        },
        {
          "@type": "Question",
          "name": "Can loungewear be worn outside the home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, modern loungewear is designed to be presentable enough for quick errands, coffee runs, or casual outings. The athleisure trend has blurred lines between loungewear and casual wear. However, traditional sleepwear is generally not appropriate for public wear. When designing loungewear for dual home-and-public use, focus on presentable styling, quality fabrics, and neat construction. Avoid overly worn-out looks or sleepwear-specific features like overly loose fits or delicate fabrics. Many brands now market loungewear as 'lifestyle apparel' suitable for various casual settings."
          }
        },
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for loungewear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most loungewear manufacturers require 500-1,000 pieces per style. However, SDF Clothing offers 300 piece minimums per style for loungewear manufacturing, making us accessible to startup brands and smaller collections. We can produce 300-piece orders across multiple sizes and colors. This flexibility enables new brands to test designs without committing to large quantities. As your brand grows, we can scale production to meet increasing demand. Our low MOQ loungewear manufacturing is ideal for brands testing the market or launching new categories."
          }
        },
        {
          "@type": "Question",
          "name": "How do I design a lounge set?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Designing a lounge set involves creating coordinating top and bottom pieces that work together aesthetically. Start with your brand aesthetic and target customer preferences. Choose a comfortable fabric - cotton jersey, poly-cotton fleece, or modal blends are popular. Design the top (hoodie, sweatshirt, or relaxed tee) and bottom (joggers, shorts, or lounge pants) with coordinating colors, patterns, or design elements. Consider practical features like elastic waists, pockets, and comfortable necklines. Create a <a href='/tech-pack-service'>tech pack</a> with detailed specifications for both pieces. Our <a href='/sampling-service'>sampling service</a> can develop prototypes for fit and design verification."
          }
        },
        {
          "@type": "Question",
          "name": "Is private label loungewear available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, SDF Clothing offers private label loungewear manufacturing. We can produce loungewear with your brand labels, tags, and packaging. Private label means you select from our existing styles and add your branding, or we can develop custom styles based on your specifications. Private label loungewear is ideal for brands wanting to launch quickly with proven designs. We handle production while you focus on branding and marketing. Our <a href='/private-label-clothing-manufacturer'>private label service</a> includes full customization of labels, hangtags, and packaging to match your brand identity."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Loungewear Manufacturing",
      "provider": { "@id": SITE + "/#org" },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "IT", "ES"],
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "USD",
          "price": "300",
          "description": "Starting MOQ | 300 pieces per style"
        }
      }
    },
    {
      "@type": "HowTo",
      "name": "Loungewear Manufacturing Process",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Design and Fabric Selection",
          "text": "Submit your lounge set designs or select from our existing styles. Choose comfortable fabrics - cotton, poly-cotton, modal, or fleece based on your target market and season. Specify colors, patterns, and branding requirements."
        },
        {
          "@type": "HowToStep",
          "name": "Pattern Making and Sampling",
          "text": "Develop patterns for top and bottom pieces. Create samples for fit evaluation and design verification. Adjust patterns based on fitting results. Sample costs are credited against bulk orders."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "After sample approval, begin bulk production with 30% deposit. Our quality team conducts inline inspections at 20%, 50%, and 80% completion. Production typically takes 40-45 days."
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection and Shipment",
          "text": "Conduct final AQL 2.5 inspection before shipment. Pay 70% balance upon approval. Apply your private labels and packaging. Ship FOB from Bangladesh port."
        }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Loungewear Products",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Lounge Sets"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Joggers"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Hoodies"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Sweatshirts"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Sleepwear"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

