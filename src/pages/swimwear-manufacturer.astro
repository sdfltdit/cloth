    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Swimwear manufacturing costs vary by fabric and complexity:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic bikini: $8-15 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          One-piece: $10-18 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Performance swimwear: $15-25 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. UPF treatments, custom linings, and premium packaging are additional.
    </p>

    <table style="width:100%;max-width:800px;margin-top:2rem;border-collapse:collapse;background:#0a0a0a;">
      <thead>
        <tr style="background:#e00;">
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Product Type</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Fabric</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">MOQ</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Price (300 pcs)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Bikinis</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Polyester-spandex blend</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$8-15 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">One-Piece</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Nylon-spandex blend</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$10-18 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Board Shorts</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Quick-dry polyester</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$12-20 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Performance Swimwear</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Competitive swim fabric</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Rash Guards</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">UPF 50+ nylon blend</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$10-18 per piece</td>
        </tr>
      </tbody>
    </table>

    
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Swimwear Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard swimwear production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fabric sourcing: 5-10 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sampling: 7-10 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bulk production: 25-35 days (basic styles)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quality inspection: 2-3 days
      </li>
      <li style="padding-left:1.5rem;position:relative;">
