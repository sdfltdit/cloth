---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAge } from '../utils/companyAge';
import { schemaOrganization, schemaPerson, SITE_URL as SITE } from '../data/schema';
export const prerender = true;

const yearsExp = getCompanyAge();

const pageTitle = "Apparel Manufacturer Bangladesh | About SDF Clothing | Since 1998";
const pageDescription = "SDF Clothing is a full-package apparel manufacturer in Dhaka, Bangladesh since 1998. Low MOQ 300 pieces, GOTS certified, 13 international certifications, OEM & private label apparel production for 200+ global fashion brands across EU, UK, USA, Australia and Canada.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[schemaOrganization, schemaPerson]}
  datePublished="1998-08-22"
  dateModified={new Date().toISOString().split("T")[0]}
>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://sdfltd.com/about/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://sdfltd.com/about/" }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "legalName": "SDF Clothing Ltd",
      "url": "https://sdfltd.com",
      "logo": "https://sdfltd.com/logo-small.webp",
      "image": "https://sdfltd.com/hero.webp",
      "description": "Full-package apparel manufacturer in Dhaka, Bangladesh since 1998. OEM, private label, and CMT apparel production for international fashion brands. GOTS certified, OEKO-TEX Standard 100, BSCI, SEDEX SMETA, GRS, ISO 9001. MOQ 300 pieces. Serving EU, UK, USA, Australia, and Canada.",
      "foundingDate": "1998-08-22",
      "foundingLocation": {
        "@type": "Place",
        "name": "Dhaka, Bangladesh"
      },
      "numberOfEmployees": {
        "@type": "QuantitativeValue",
        "minValue": 500
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House 125, Road 01, Baridhara DOHS",
        "addressLocality": "Dhaka",
        "postalCode": "1212",
        "addressCountry": "BD"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+8801911733226",
          "contactType": "sales",
          "areaServed": ["EU","GB","US","AU","CA"],
          "availableLanguage": ["English"],
          "hoursAvailable": "Mo-Sa 08:00-18:00"
        }
      ],
      "sameAs": [
        "https://linkedin.com/company/sdfclothing",
        "https://twitter.com/sdfclothing"
      ],
      "areaServed": [
        { "@type": "Country", "name": "European Union" },
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "Australia" },
        { "@type": "Country", "name": "Canada" }
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "name": "GOTS — Global Organic Textile Standard" },
        { "@type": "EducationalOccupationalCredential", "name": "OEKO-TEX Standard 100" },
        { "@type": "EducationalOccupationalCredential", "name": "GRS — Global Recycled Standard" },
        { "@type": "EducationalOccupationalCredential", "name": "BSCI Social Compliance" },
        { "@type": "EducationalOccupationalCredential", "name": "SEDEX SMETA 4-Pillar Audit" },
        { "@type": "EducationalOccupationalCredential", "name": "ISO 9001 Quality Management" },
        { "@type": "EducationalOccupationalCredential", "name": "REACH Chemical Compliance" }
      ],
      "knowsAbout": [
        "Apparel Manufacturing",
        "OEM Clothing Production",
        "Private Label Apparel",
        "CMT Garment Services",
        "GOTS Organic Apparel",
        "EU GSP Duty-Free Exports",
        "Digital Product Passport",
        "Bangladesh Garment Export"
      ]
    },
    {
      "@type": "Person",
      "@id": "https://sdfltd.com/#founder",
      "name": "Chowdhury Remon",
      "jobTitle": "Founder & CEO",
      "description": "Apparel manufacturing expert with 28+ years of experience in Bangladesh's garment industry. Founder of SDF Clothing in 1998. Specialist in EU market supply chains, sustainable apparel production, GSP compliance, and international brand partnerships.",
      "worksFor": { "@id": "https://sdfltd.com/#org" },
      "url": "https://sdfltd.com/about",
      "knowsAbout": [
        "Apparel Manufacturing Bangladesh",
        "EU GSP Trade Compliance",
        "GOTS Organic Textile Standard",
        "International Fashion Brand Sourcing",
        "Sustainable Garment Production"
      ]
    },
    {
      "@type": "AboutPage",
      "@id": "https://sdfltd.com/about/#page",
      "url": "https://sdfltd.com/about/",
      "name": "About SDF Clothing — Apparel Manufacturer Bangladesh Since 1998",
      "mainEntity": { "@id": "https://sdfltd.com/#org" },
      "author": { "@id": "https://sdfltd.com/#founder" },
      "datePublished": "1998-08-22",
      "dateModified": "2026-06-01"
    },
    {
      "@type": "FAQPage",
      "@id": "https://sdfltd.com/about/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is SDF Clothing's minimum order quantity (MOQ)?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing accepts orders from 300 pieces per style across OEM, private label, CMT, and ODM apparel production. Flexible size distribution within the 300-piece minimum. No minimum across styles on the same purchase order." }
        },
        {
          "@type": "Question",
          "name": "Where is SDF Clothing's apparel factory located?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing's manufacturing facility is located in Dhaka, Bangladesh — in a 75,000 sq ft purpose-built factory housing cutting, sewing, finishing, embroidery, screen printing, and quality control departments. The facility has been operational since 1998." }
        },
        {
          "@type": "Question",
          "name": "What certifications does SDF Clothing hold for apparel manufacturing?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing holds GOTS (Global Organic Textile Standard), OEKO-TEX Standard 100, GRS (Global Recycled Standard), BSCI Social Compliance, SEDEX SMETA 4-Pillar Audit, ISO 9001 Quality Management, and REACH chemical compliance. Full certificate copies are provided with every shipment." }
        },
        {
          "@type": "Question",
          "name": "Does SDF Clothing produce apparel for EU brands duty-free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Bangladesh holds EU GSP EBA (Everything But Arms) status, meaning all apparel manufactured by SDF Clothing enters the EU at 0% import duty. We provide EUR.1 Movement Certificates and all EU customs documentation with every shipment." }
        },
        {
          "@type": "Question",
          "name": "What types of apparel does SDF Clothing manufacture?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing produces knitwear, woven shirts and blouses, dresses, trousers, outerwear and jackets, activewear, loungewear, sleepwear, and children's apparel. OEM, private label, CMT, and ODM production models are all supported from 300 pieces MOQ." }
        },
        {
          "@type": "Question",
          "name": "How long has SDF Clothing been manufacturing apparel in Bangladesh?",
          "acceptedAnswer": { "@type": "Answer", "text": "SDF Clothing was founded on August 22, 1998 in Dhaka, Bangladesh. The company has over 28 years of apparel manufacturing experience, supplying international fashion brands across EU, UK, USA, Australia, and Canada." }
        }
      ]
    }
  ]
}
</script>

<style>
  .about-pg { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; }

  /* Layout helpers */
  .c { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
  .cn { max-width: 720px; margin: 0 auto; padding: 0 1.25rem; }

  /* Typography */
  .eyebrow { font-size: 0.6rem; letter-spacing: 0.35em; text-transform: uppercase; color: #e00; margin-bottom: 0.7rem; display: block; }
  .h1 { font-size: clamp(1.9rem, 4.5vw, 3.1rem); font-weight: 200; color: #fff; line-height: 1.14; margin-bottom: 1rem; letter-spacing: -0.01em; }
  .h1 em { font-style: normal; font-weight: 700; color: #e00; }
  .h2 { font-size: clamp(1.25rem, 2.6vw, 1.85rem); font-weight: 300; color: #fff; line-height: 1.22; margin-bottom: 0.5rem; }
  .h3 { font-size: 0.96rem; font-weight: 600; color: #fff; margin-bottom: 0.4rem; }
  .lead { font-size: 0.97rem; color: #ccc; line-height: 1.8; margin-bottom: 1.5rem; max-width: 680px; }
  .body { font-size: 0.9rem; color: #999; line-height: 1.76; margin-bottom: 0.9rem; }
  .body a { color: #cc4444; text-decoration: none; border-bottom: 1px solid rgba(204,68,68,0.3); }
  .body a:hover { color: #e06666; }
  .small { font-size: 0.76rem; color: #444; }

  /* Breadcrumb */
  .bc { padding: 0.8rem 0; font-size: 0.76rem; color: #444; border-bottom: 1px solid #1a1a1a; }
  .bc a { color: #666; text-decoration: none; } .bc a:hover { color: #e00; }
  .bc span { margin: 0 0.38rem; }

  /* Hero */
  .hero { padding: 4.5rem 0 3.5rem; border-bottom: 2px solid #e00; background: linear-gradient(150deg, #0e0505 0%, #0a0a0a 60%, #050a0e 100%); position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; right: -60px; top: -80px; width: 460px; height: 460px; background: radial-gradient(ellipse, rgba(220,0,0,0.06) 0%, transparent 65%); pointer-events: none; }

  .badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.3rem 0 2rem; }
  .badge { font-size: 0.65rem; letter-spacing: 0.07em; padding: 0.27rem 0.62rem; border: 1px solid rgba(220,0,0,0.38); color: #aa7070; border-radius: 2px; white-space: nowrap; }
  .badge.g { border-color: rgba(31,168,90,0.4); color: #60aa78; }

  .cta-row { display: flex; gap: 0.85rem; flex-wrap: wrap; }
  .btn-r { display: inline-block; background: #cc0000; color: #fff; padding: 0.7rem 1.5rem; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 2px; transition: background 0.17s; }
  .btn-r:hover { background: #aa0000; }
  .btn-o { display: inline-block; border: 1px solid rgba(255,255,255,0.18); color: #aaa; padding: 0.7rem 1.3rem; font-size: 0.82rem; text-decoration: none; border-radius: 2px; transition: border-color 0.17s, color 0.17s; }
  .btn-o:hover { border-color: #e00; color: #fff; }

  /* Section */
  .sec { padding: 3.75rem 0; border-bottom: 1px solid #1a1a1a; }

  /* Grid */
  .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.3rem; }
  .g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }

  /* Cards */
  .card { background: #0e0e0e; border: 1px solid #1e1e1e; border-radius: 3px; padding: 1.4rem; }
  .card.red { border-color: rgba(220,0,0,0.3); }
  .icon { font-size: 1.5rem; margin-bottom: 0.6rem; line-height: 1; }
  .stat-n { font-size: 2.3rem; font-weight: 800; color: #e00; line-height: 1; margin-bottom: 0.15rem; }
  .stat-n.w { color: #fff; }
  .stat-l { font-size: 0.79rem; font-weight: 600; color: #ddd; margin-bottom: 0.15rem; }
  .stat-s { font-size: 0.72rem; color: #555; }

  /* Timeline */
  .timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #111; }
  .tl-item { background: #0a0a0a; padding: 1.75rem; }
  .tl-year { font-size: 1.6rem; font-weight: 200; color: #e00; line-height: 1; margin-bottom: 0.4rem; }
  .tl-title { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: #fff; font-weight: 600; margin-bottom: 0.6rem; }
  .tl-body { font-size: 0.8rem; color: #777; line-height: 1.6; }

  /* Founder quote */
  .founder-box { border: 1px solid #e00; padding: 2.5rem; text-align: center; }
  .founder-quote { font-size: clamp(0.92rem, 1.5vw, 1.05rem); color: #ccc; line-height: 1.85; font-style: italic; max-width: 780px; margin: 0 auto 1.5rem; }
  .founder-sig { font-size: 0.78rem; color: #555; letter-spacing: 0.1em; text-transform: uppercase; }

  /* Cert table */
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.83rem; margin-top: 1rem; }
  .tbl th { text-align: left; font-size: 0.6rem; letter-spacing: 0.17em; text-transform: uppercase; color: #444; padding: 0.5rem 0.7rem; border-bottom: 1px solid #1e1e1e; }
  .tbl td { padding: 0.68rem 0.7rem; border-bottom: 1px solid #111; color: #888; vertical-align: top; line-height: 1.5; }
  .tbl tr:last-child td { border-bottom: none; }
  .tbl td:first-child { color: #ccc; font-weight: 500; }
  .tbl tr:hover td { background: rgba(255,255,255,0.015); }
  .yes { color: #1fa85a; font-weight: 700; }

  /* Checklist */
  .cl { list-style: none; padding: 0; margin: 0.75rem 0; }
  .cl li { font-size: 0.85rem; color: #888; padding: 0.35rem 0; border-bottom: 1px solid #111; display: flex; gap: 0.6rem; line-height: 1.5; }
  .cl li:last-child { border-bottom: none; }
  .cl li::before { content: "—"; color: #e00; flex-shrink: 0; }

  /* Author bar */
  .author-bar { background: #0e0e0e; border: 1px solid #1e1e1e; border-radius: 3px; padding: 1rem 1.35rem; display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
  .author-dot { width: 2.2rem; height: 2.2rem; background: #cc0000; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.82rem; font-weight: 800; color: #fff; flex-shrink: 0; }
  .author-name { font-size: 0.82rem; font-weight: 600; color: #ddd; }
  .author-sub { font-size: 0.71rem; color: #555; margin-top: 0.1rem; }

  /* FAQ */
  .faq-item { border-bottom: 1px solid #141414; padding: 1.15rem 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-q { font-size: 0.93rem; font-weight: 600; color: #eee; margin-bottom: 0.4rem; }
  .faq-a { font-size: 0.85rem; color: #888; line-height: 1.72; }
  .faq-a strong { color: #bbb; }

  /* Internal links */
  .lc { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.85rem; }
  .lc a { font-size: 0.75rem; padding: 0.27rem 0.62rem; border: 1px solid #1e1e1e; color: #555; text-decoration: none; border-radius: 2px; transition: border-color 0.14s, color 0.14s; }
  .lc a:hover { border-color: #e00; color: #ddd; }

  /* CTA */
  .cta-sec { padding: 4.5rem 0; border-top: 2px solid #e00; text-align: center; }

  /* Facility grid */
  .facility-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #111; margin-top: 1px; }
  .fac-item { background: #0a0a0a; padding: 1.75rem; }
  .fac-label { font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: #e00; margin-bottom: 0.45rem; }
  .fac-body { font-size: 0.78rem; color: #777; line-height: 1.58; }

  /* Country pills */
  .country-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: #111; }
  .country-item { background: #0a0a0a; padding: 1.75rem; text-align: center; }
  .country-flag { font-size: 1.6rem; margin-bottom: 0.5rem; }
  .country-name { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: #e00; margin-bottom: 0.4rem; }
  .country-note { font-size: 0.74rem; color: #666; line-height: 1.5; }

  @media (max-width: 768px) {
    .g2, .g3, .g4, .timeline, .facility-grid { grid-template-columns: 1fr !important; }
    .country-row { grid-template-columns: 1fr 1fr !important; }
    .author-bar { flex-direction: column; text-align: center; }
  }
  @media (max-width: 520px) {
    .h1 { font-size: 1.7rem; }
    .cta-row { flex-direction: column; }
    .btn-r, .btn-o { text-align: center; }
    .country-row { grid-template-columns: 1fr !important; }
  }
</style>

<div class="about-pg">

  <!-- BREADCRUMB -->
  <nav class="bc" aria-label="Breadcrumb">
    <div class="c">
      <a href="/">Home</a><span>›</span>
      <span aria-current="page">About</span>
    </div>
  </nav>

  <!-- ====================================================
    HERO
  ==================================================== -->
  <section class="hero" aria-labelledby="about-h1">
    <div class="c">
      <span class="eyebrow">Apparel Manufacturer Bangladesh · Dhaka · Since 1998</span>
      <h1 class="h1" id="about-h1">
        <em>Apparel Manufacturer</em><br>
        Bangladesh — Since 1998
      </h1>
      <p class="lead" style="margin-bottom:0;">
        SDF Clothing is a full-package <a href="/clothing-manufacturers" style="color:#cc4444;text-decoration:none;border-bottom:1px solid rgba(204,68,68,0.3);">apparel manufacturer</a> in Dhaka, Bangladesh, founded by Chowdhury Remon on August 22, 1998. We produce OEM, private label, CMT, and ODM apparel for 200+ international fashion brands across the EU, UK, USA, Australia, and Canada. 300 pieces MOQ, 13 international certifications, 75,000 sq ft facility, 500+ skilled professionals. No agents, no outsourcing — direct factory access from day one.
      </p>
      <div class="badges">
        <span class="badge g">GOTS Certified Apparel</span>
        <span class="badge g">OEKO-TEX Standard 100</span>
        <span class="badge g">GRS Recycled Standard</span>
        <span class="badge">BSCI Social Compliance</span>
        <span class="badge">SEDEX SMETA 4-Pillar</span>
        <span class="badge">ISO 9001 Certified</span>
        <span class="badge">EU GSP 0% Duty</span>
        <span class="badge">MOQ 300 Pieces</span>
        <span class="badge">Founded 1998</span>
      </div>
      <div class="cta-row">
        <a href="/contact" class="btn-r">Get Free Apparel Quote</a>
        <a href="/certifications" class="btn-o">View Certifications</a>
      </div>
    </div>
  </section>

  <!-- AUTHOR / E-E-A-T -->
  <div style="padding:1.2rem 0;border-bottom:1px solid #1a1a1a;">
    <div class="c">
      <div class="author-bar">
        <div class="author-dot" aria-hidden="true">CR</div>
        <div>
          <div class="author-name">Chowdhury Remon — Founder &amp; CEO, SDF Clothing</div>
          <div class="author-sub">28+ years in Bangladesh apparel manufacturing · Specialist in EU market supply chains, OEM apparel production, GOTS organic certification, and international brand partnerships · BGMEA member · Last updated June 2026</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ====================================================
    SECTION 1 — KEY NUMBERS
  ==================================================== -->
  <section class="sec" aria-labelledby="nums-h2">
    <div class="c">
      <span class="eyebrow">At a Glance</span>
      <h2 class="h2" id="nums-h2">SDF Clothing — Apparel Manufacturing Facts</h2>
      <p class="lead">The numbers that international apparel buyers ask first — answered upfront.</p>
      <div class="g4">
        <div class="card red" style="text-align:center;">
          <div class="stat-n">{yearsExp}+</div>
          <div class="stat-l">Years Manufacturing</div>
          <div class="stat-s">Founded August 22, 1998 — Dhaka, Bangladesh</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-n">300</div>
          <div class="stat-l">Pieces MOQ</div>
          <div class="stat-s">Per style — OEM, private label, CMT, ODM</div>
        </div>
        <div class="card red" style="text-align:center;">
          <div class="stat-n">200+</div>
          <div class="stat-l">Global Brand Clients</div>
          <div class="stat-s">EU, UK, USA, Australia, Canada — 36 countries</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-n">13</div>
          <div class="stat-l">Certifications</div>
          <div class="stat-s">GOTS, OEKO-TEX, BSCI, SEDEX, GRS, ISO 9001 & more</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-n">500+</div>
          <div class="stat-l">Skilled Workers</div>
          <div class="stat-s">Avg tenure 7+ years — pattern makers, QC, samplers, logistics</div>
        </div>
        <div class="card red" style="text-align:center;">
          <div class="stat-n">75K</div>
          <div class="stat-l">Sq Ft Facility</div>
          <div class="stat-s">Dhaka — cutting, sewing, embroidery, printing, QC in-house</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-n">50K</div>
          <div class="stat-l">Pieces / 45 Days</div>
          <div class="stat-s">Production capacity per cycle — scalable by order</div>
        </div>
        <div class="card red" style="text-align:center;">
          <div class="stat-n">0%</div>
          <div class="stat-l">EU Import Duty</div>
          <div class="stat-s">Bangladesh GSP EBA — all apparel HS chapters 61 &amp; 62</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
    SECTION 2 — WHO WE ARE / COMPANY STORY
  ==================================================== -->
  <section class="sec" aria-labelledby="story-h2">
    <div class="c">
      <span class="eyebrow">Our Story</span>
      <h2 class="h2" id="story-h2">From 25 Machines to a Full-Package Apparel Manufacturer — 28 Years in Dhaka</h2>

      <div class="g2" style="margin-top:1.5rem;">
        <div>
          <p class="body">SDF Clothing was founded on August 22, 1998, with 25 sewing machines in a modest unit in Dhaka's textile district. The founding premise was straightforward: build an apparel factory in Bangladesh that could meet international quality standards while offering fashion brands direct access — no agents, no buying houses, no margin layers between the brand and the factory floor.</p>
          <p class="body">Over the following decade, we evolved from basic knitwear production into a comprehensive full-package apparel manufacturer. By 2003, we had secured our first EU export client. By 2011, ISO 9001 quality certification was in place. By 2017, GOTS organic and OEKO-TEX Standard 100 certification covered our full production chain. Today, SDF Clothing operates across 75,000 sq ft of purpose-built manufacturing space, employs 500+ skilled professionals, and serves 200+ international fashion brands across 36 countries.</p>
          <p class="body">What has not changed in 28 years is the operating model: own factory, own team, no outsourcing. When a brand places an order with SDF Clothing, every stage of production — fabric inspection, cutting, sewing, embroidery, printing, finishing, quality inspection, and packing — happens under our roof, under our quality management system, with our workers. That visibility is what our clients are actually buying. The apparel is the output. The transparency is the product.</p>
        </div>
        <div>
          <div class="card" style="margin-bottom:1.2rem;">
            <div class="h3">🏭 What "Full-Package Apparel Manufacturer" Means</div>
            <p class="body" style="margin-bottom:0;">Full-package means we handle the complete supply chain — not just cut and sew. We source fabric from our vetted mill partners, develop patterns, produce samples, manage bulk production, apply embroidery and printing, conduct AQL 2.5 final inspection, pack, and arrange FOB shipment from Chittagong port. You send us a tech pack. We send you finished, certified, compliant apparel ready for retail.</p>
          </div>
          <div class="card">
            <div class="h3">📦 Production Models We Support</div>
            <ul class="cl">
              <li><strong style="color:#ccc;">OEM</strong> — Original Equipment Manufacturing from your tech pack</li>
