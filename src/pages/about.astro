---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAge, getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, schemaPerson, SITE_URL as SITE } from '../data/schema';
export const prerender = true;

const yearsExp = getCompanyAge();

const pageTitle = "About SDF Clothing — Global Garment Manufacturers Since 1998";
const pageDescription = "SDF Clothing is a global low MOQ clothing manufacturer based in Dhaka, Bangladesh. Founded by Chowdhury Remon in 1998, we serve startup fashion brands worldwide with 300 piece minimum orders, GOTS certification, and 13 international quality certifications.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[schemaOrganization, schemaPerson]}
  datePublished="1998-01-01"
  dateModified={new Date().toISOString().split("T")[0]}
>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://www.sdfltd.com",
      "logo": "https://www.sdfltd.com/logo-small.webp",
      "description": "Leading apparel manufacturer in Dhaka since 1998, providing OEM and private label clothing production services to international fashion brands across EU, UK, USA, Australia, and Canada.",
      "foundingDate": "1998-08-22",
      "foundingLocation": "Dhaka, Bangladesh",
      "numberOfEmployees": "500+",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House 125, Road 01",
        "addressLocality": "Baridhara DOHS",
        "addressRegion": "Dhaka",
        "postalCode": "1212",
        "addressCountry": "BD"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+8801911733226",
        "contactType": "sales",
        "areaServed": ["EU", "UK", "US", "AU", "CA"],
        "availableLanguage": ["English"],
        "hoursAvailable": "Mo-Sa 08:00-18:00"
      },
      "sameAs": [
        "https://linkedin.com/company/sdfclothing",
        "https://twitter.com/sdfclothing",
        "https://reddit.com/r/sdfclothing"
      ],
      "areaServed": ["European Union", "United Kingdom", "United States", "Australia", "Canada"],
      "award": ["GOTS Certified", "OEKO-TEX Certified", "ISO 9001 Certified", "BSCI Certified", "WRAP Certified", "SA8000 Certified"]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.sdfltd.com/#local",
      "name": "SDF Clothing - Apparel Manufacturer Bangladesh",
      "image": "https://www.sdfltd.com/hero.webp",
      "url": "https://www.sdfltd.com",
      "telephone": "+8801911733226",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House 125, Road 01",
        "addressLocality": "Baridhara DOHS",
        "addressRegion": "Dhaka",
        "postalCode": "1212",
        "addressCountry": "BD"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "23.8138",
        "longitude": "90.4128"
      },
      "openingHours": "Mo-Sa 08:00-18:00",
      "priceRange": "$$",
      "areaServed": ["European Union", "United Kingdom", "United States", "Australia", "Canada"],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "200+"
      }
    },
    {
      "@type": "AboutPage",
      "@id": "https://www.sdfltd.com/about",
      "url": "https://www.sdfltd.com/about",
      "mainEntity": {
        "@id": "https://www.sdfltd.com/#org"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.sdfltd.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "About",
            "item": "https://www.sdfltd.com/about"
          }
        ]
      }
    }
  ]
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">›</span>
        About
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Since 1998 · Dhaka, South Asia</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Apparel Manufacturer Bangladesh <br>{yearsExp}+ Years of Manufacturing Excellence</h1>
    <p style="color:#FFFFFF;max-width:650px;line-height:1.8;font-size:0.95rem;">SDF Clothing is a full-package apparel producer in Dhaka serving 200+ international fashion brands across EU, UK, USA, Australia, and Canada. GOTS, OEKO-TEX, ISO 9001, BSCI, SEDEX, WRAP, and SA8000 certified with 13 international compliance standards. 300 pieces MOQ, 75,000 sq ft facility, 500+ skilled professionals.</p>
  </div>
</section>

<!-- COMPANY HISTORY -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;background:#000000;">
      <div style="background:#000;padding:3rem;">
        <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Our History</p>
        <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;margin-bottom:1.5rem;">From 25 Machines to a Global Apparel Producer</h2>
        <p style="color:#FFFFFF;line-height:1.9;font-size:0.92rem;margin-bottom:1rem;">SDF Clothing was founded on August 22, 1998, in the heart of Dhaka's textile district. What began as a small sewing unit with just 25 machines has evolved into one of the region's most trusted <a href="/garments-manufacturers" style="color:#fff;border-bottom:1px solid #e00;text-decoration:none;">clothing suppliers</a>, serving fashion brands across four continents.</p>
        <p style="color:#FFFFFF;line-height:1.9;font-size:0.92rem;margin-bottom:1rem;">Over the past {yearsExp}+ years, we transformed from basic garment production into a comprehensive full-package manufacturer. Our capabilities now encompass the complete supply chain: fabric sourcing, pattern development, dyeing, finishing, cut & sew, embroidery, screen printing, AQL 2.5 quality inspection, and FOB delivery from Chittagong port.</p>
        <p style="color:#FFFFFF;line-height:1.9;font-size:0.92rem;">Our commitment to ethical manufacturing, quality excellence, and environmental responsibility has earned the trust of 200+ international brands. Today, our certified manufacturing facility produces over 50,000 pieces per 45-day production cycle while maintaining the highest standards of quality and worker welfare.</p>
      </div>
      <div style="background:#000;display:grid;grid-template-columns:1fr 1fr;gap:1px;background-color:#000000;align-content:start;">
        {[
          [yearsExp+"+","Years Exporting"],
          ["300","Pieces MOQ"],
          ["50K","Pcs / 45 Days"],
          ["13","Certifications"],
          ["200+","Global Brands"],
          ["500+","Skilled Workers"],
        ].map(([n,l]) => (
          <div style="background:#000;padding:2rem;text-align:center;">
            <div style="font-size:1.8rem;font-weight:200;color:#e00;margin-bottom:0.25rem;">{n}</div>
            <div style="font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- COMPANY MILESTONE TIMELINE -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Journey</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Company Milestones</h2>
      <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">From a small sewing unit to a globally recognized apparel factory in Dhaka  our growth story.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#000000;">
      {[
        ["1998","Founded","Established in Dhaka with 25 sewing machines, focusing on basic knitwear production for local markets."],
        ["2003","First Export","Secured first international client from EU, marking transition to export-oriented manufacturing."],
        ["2007","Facility Expansion","Expanded to 10,000 sq ft facility, added embroidery and screen printing capabilities in-house."],
        ["2011","First Certification","Achieved ISO 9001 certification, establishing quality management systems for international compliance."],
        ["2014","Full-Service Model","Transitioned to full-package manufacturing, adding fabric sourcing and pattern development departments."],
        ["2017","Global Expansion","Expanded buyer network to USA and Australia, achieved GOTS and OEKO-TEX certifications."],
        ["2019","Certification Growth","Added BSCI, SEDEX, and WRAP certifications, meeting all major international compliance requirements."],
        ["2021","Facility Upgrade","Expanded to 75,000 sq ft manufacturing facility, dedicated production lines for knit, woven, and outerwear."],
        ["2023","Sustainability Focus","Achieved ISO 14001 environmental certification, launched comprehensive sustainability and worker welfare programs."],
        ["2024","Advanced Certifications","Added SA8000, C-TPAT, and additional sustainability certifications (GRS, OCS, RCS, BCI)."],
        ["2025","Digital Transformation","Implemented ERP systems for complete production tracking and client portal for real-time order visibility."],
        ["2026","Global Leadership","Serving 200+ international brands across 5 continents, recognized as a leading apparel producer in the region for sustainable and ethical production."],
      ].map(([year, title, description]) => (
        <div style="background:#000;padding:2rem;">
          <div style="font-size:1.5rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">{year}</div>
          <div style="font-size:0.85rem;font-weight:500;color:#fff;margin-bottom:0.75rem;letter-spacing:0.1em;text-transform:uppercase;">{title}</div>
          <div style="font-size:0.78rem;color:#FFFFFF;line-height:1.6;">{description}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FOUNDER VISION STATEMENT -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="border:1px solid #e00;padding:3rem;">
      <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;text-align:center;">Our Purpose</p>
      <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;margin-bottom:1.5rem;text-align:center;">Founder's Vision for the Region's Apparel Industry</h2>
      <p style="color:#FFFFFF;max-width:800px;margin:0 auto;line-height:1.9;font-size:0.95rem;text-align:center;">"When we started SDF Clothing in 1998, our vision was simple: to build an apparel factory in Dhaka that could compete with the best in the world while upholding the highest standards of ethics, quality, and worker welfare. Over the past {yearsExp}+ years, this vision has guided every decision we make  from investing in certified technology to ensuring fair wages for every worker, from achieving 13 international certifications to maintaining complete transparency with our brand partners. We believe that South Asia's clothing industry can be both globally competitive and ethically exemplary. Our mission is to prove this every day through our commitment to quality manufacturing, sustainable practices, and the dignity of every worker in our facility."</p>
      <div style="margin-top:2rem;text-align:center;">
        <p style="font-size:0.85rem;color:#FFFFFF;letter-spacing:0.1em;text-transform:uppercase;"> SDF Clothing Leadership Team</p>
      </div>
    </div>
  </div>
</section>

<!-- SUSTAINABILITY AND WORKER WELFARE -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Responsible Manufacturing</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Sustainability & Worker Welfare</h2>
      <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">As an apparel producer in Dhaka, we believe that ethical production and environmental responsibility are not optional  they are essential to our business.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2.5rem;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;letter-spacing:0.15em;text-transform:uppercase;">Environmental Sustainability</h3>
        <ul style="list-style:none;padding:0;margin:0;">
          {[
            "ISO 14001 certified environmental management system",
            "Wastewater treatment plant ensuring zero harmful discharge",
            "Solar energy integration reducing factory carbon footprint",
            "Water recycling systems reducing consumption by 40%",
            "GOTS organic cotton and GRS recycled material sourcing",
            "Chemical management compliant with ZDHC guidelines",
            "Tree plantation program offsetting carbon emissions",
            "Energy-efficient machinery and LED factory lighting",
            "Biodegradable packaging materials for exports",
            "Continuous monitoring of environmental KPIs and targets"
          ].map(item => (
            <li style="color:#FFFFFF;font-size:0.85rem;line-height:2;padding-left:1rem;position:relative;">
              <span style="position:absolute;left:0;color:#e00;">•</span> {item}
            </li>
          ))}
        </ul>
      </div>
      <div style="background:#000;padding:2.5rem;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;letter-spacing:0.15em;text-transform:uppercase;">Worker Welfare & Rights</h3>
        <ul style="list-style:none;padding:0;margin:0;">
          {[
            "Living wages compliant with BSCI and SA8000 standards",
            "Safe working conditions with fire safety systems installed",
            "Free healthcare clinic for all workers and families",
            "On-site childcare facility for working mothers",
            "Skills development and technical training programs",
            "Zero tolerance for child labor, forced labor, or discrimination",
            "Worker representation through elected committees",
            "Overtime strictly regulated with voluntary participation",
            "Clean drinking water and nutritious meals provided daily",
            "Regular third-party social compliance audits"
          ].map(item => (
            <li style="color:#FFFFFF;font-size:0.85rem;line-height:2;padding-left:1rem;position:relative;">
              <span style="position:absolute;left:0;color:#e00;">•</span> {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div style="margin-top:3rem;padding:2rem;background:#000;border:1px solid #e00;">
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;text-align:center;">Our commitment to sustainability and worker welfare is verified through 13 international certifications including GOTS, OEKO-TEX, BSCI, SEDEX, WRAP, SA8000, and ISO 14001. We are proud to be an apparel factory in the region that sets the standard for responsible production practices in the industry.</p>
    </div>
  </div>
</section>

<!-- QUALITY STANDARDS -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <div>
        <span class="section-label">Quality Assurance</span>
        <div class="accent-line"></div>
        <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Quality Standards & Inspection</h2>
        <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">Rigorous quality control at every production stage ensures consistent excellence for international garment buyers.</p>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      {[
        ["AQL 2.5","Industry-standard acceptance quality limit for final inspection"],
        ["In-Line QC","Real-time quality checks during production process"],
        ["Pre-Shipment","100% final inspection before export approval"],
        ["Lab Testing","Fabric and garment testing by accredited laboratories"],
        ["Size Accuracy","Precision measurement verification for all sizes"],
        ["Color Consistency","Spectrophotometer color matching across batches"],
        ["Stitch Quality","Tensile strength testing for seam durability"],
        ["Packaging Check","Final packaging inspection for export readiness"],
      ].map(([std, desc]) => (
        <div style="background:#000;padding:2rem;">
          <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">{std}</div>
          <div style="font-size:0.78rem;color:#FFFFFF;line-height:1.6;">{desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BUYER COUNTRIES -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <div>
        <span class="section-label">Global Reach</span>
        <div class="accent-line"></div>
        <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Export Markets & Buyer Countries</h2>
        <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">We serve fashion brands across major markets with trade agreement benefits and compliance-ready documentation.</p>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:#000000;">
      {[
        ["European Union","GSP duty-free access, EU EPR 2026 compliant"],
        ["United Kingdom","UK GSP, Modern Slavery Act compliant"],
        ["United States","C-TPAT certified, FOB export ready"],
        ["Australia","AANZFTA trade agreement benefits"],
        ["Canada","CPTPP trade agreement, duty-free access"],
      ].map(([country, benefit]) => (
        <div style="background:#000;padding:2rem;text-align:center;">
          <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">{country}</div>
          <div style="font-size:0.78rem;color:#FFFFFF;line-height:1.6;">{benefit}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FACTORY DETAILS -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <div>
        <span class="section-label">Our Facility</span>
        <div class="accent-line"></div>
        <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Factory Details & Infrastructure</h2>
        <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">Our certified manufacturing facility is designed for efficiency, quality, and scalability  supporting brands from startup to enterprise scale.</p>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2.5rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Facility Overview</p>
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;">75,000 Sq Ft Manufacturing Facility</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;margin-bottom:1rem;">Our purpose-built factory houses cutting, sewing, finishing, embroidery, screen printing, DTF printing, sublimation, heat transfer, and quality control departments under one roof. Complete in-house production ensures total control over quality, timelines, and intellectual property protection.</p>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Strategic location provides easy access to Chittagong port (FOB) for sea freight and Dhaka airport for air freight shipments. Proximity to fabric mills, dye houses, and accessory suppliers ensures efficient supply chain management and rapid material sourcing.</p>
      </div>
      <div style="background:#000;padding:2.5rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Production Infrastructure</p>
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Dedicated Production Lines & Equipment</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;margin-bottom:1rem;">Separate production lines for knit, woven, and outerwear categories prevent cross-contamination and maintain specialized workflow. Each line features computerized sewing machines, automated cutting tables, and dedicated supervisors and quality controllers. Embroidery department with multi-head machines up to 15 colors. Printing department with screen, DTF, and sublimation capabilities.</p>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Flexible production scheduling accommodates orders from 300 pieces to 50,000 pieces per style. Staggered delivery options available for large volume orders. Real-time production tracking through ERP system provides clients with order visibility at every stage.</p>
      </div>
    </div>
    <div style="margin-top:1px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      {[
        ["Computerized Cutting","Automated pattern making and precision cutting equipment"],
        ["Multi-Head Embroidery","15-color capacity for complex logo and badge production"],
        ["Screen Printing","Automated carousel for bulk orders with color matching"],
        ["In-House QC Lab","Fabric testing, color measurement, and garment inspection"],
        ["Sample Development","Dedicated sample room with rapid prototyping"],
        ["Secure Storage","Climate-controlled fabric and finished goods warehousing"],
        ["Fire Safety Systems","Advanced fire suppression and emergency protocols"],
        ["Backup Power","Generator ensuring uninterrupted production operations"]
      ].map(([feature, detail]) => (
        <div style="background:#000;padding:2rem;">
          <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">{feature}</div>
          <div style="font-size:0.78rem;color:#FFFFFF;line-height:1.6;">{detail}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEAM EXPERTISE -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <div>
        <span class="section-label">Our People</span>
        <div class="accent-line"></div>
        <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:300;color:#fff;">Team Expertise & Experience</h2>
        <p style="color:#FFFFFF;max-width:600px;line-height:1.8;font-size:0.92rem;">Our team of 500+ skilled professionals represents decades of combined experience in the region's garment industry, delivering excellence for international fashion brands.</p>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2.5rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Workforce</p>
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;">500+ Skilled Professionals</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;margin-bottom:1rem;">Our team includes experienced pattern makers, graders, sample technicians, quality inspectors, production supervisors, embroidery specialists, printing technicians, and logistics coordinators. Average worker tenure exceeds 7 years  a testament to our stable work environment and expertise retention in the competitive textile industry.</p>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Regular training programs keep our workforce updated on latest production techniques, safety protocols, and quality standards. Technical team members have 10+ years of experience in garment manufacturing for international markets, with specialized expertise in EU, UK, and US buyer requirements.</p>
      </div>
      <div style="background:#000;padding:2.5rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Management</p>
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Experienced Leadership Team</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;margin-bottom:1rem;">Our management team brings combined experience of <span id="yearsSince1998">{yearsExp}+</span> years in South Asia's apparel sector. Deep understanding of international buyer requirements, trade regulations, customs procedures, and market trends enables us to provide strategic guidance to brand partners beyond just manufacturing.</p>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Dedicated account managers for each client ensure personalized communication, production oversight, and timely delivery. English-speaking team facilitates seamless collaboration with international buyers across time zones. Management actively participates in industry associations including BGMEA, ensuring we stay ahead of regulatory changes and best practices.</p>
      </div>
    </div>
    <div style="margin-top:1px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      {[
        ["Pattern Making","CAD/CAM systems with Gerber and Lectra expertise"],
        ["Quality Control","AQL 2.5 certified inspectors with 10+ years experience"],
        ["Technical Design","Experienced team in fit analysis and size grading"],
        ["Production Planning","Advanced scheduling and capacity management"],
