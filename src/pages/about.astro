  <section class="cta-sec" aria-labelledby="cta-h2">
    <div class="cn">
      <span class="eye" style="display:block;text-align:center;">Start Manufacturing</span>
      <h2 class="h2" id="cta-h2" style="text-align:center;max-width:500px;margin:0 auto 1rem;">Partner with a Bangladesh Apparel Manufacturer — Quote in 48 Hours</h2>
