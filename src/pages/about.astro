<script>
  (function () {
    var btns = document.querySelectorAll('.faq-btn');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var bodyId = btn.getAttribute('aria-controls');
        var body = document.getElementById(bodyId);
        var icon = btn.querySelector('.faq-icon');
        btns.forEach(function (other) {
          if (other !== btn) {
            other.setAttribute('aria-expanded', 'false');
            var ob = document.getElementById(other.getAttribute('aria-controls'));
            var oi = other.querySelector('.faq-icon');
            if (ob) ob.classList.remove('open');
            if (oi) oi.textContent = '+';
          }
        });
        btn.setAttribute('aria-expanded', String(!expanded));
        if (body) body.classList.toggle('open', !expanded);
        if (icon) icon.textContent = expanded ? '+' : '−';
      });
    });
  })();
</script>

