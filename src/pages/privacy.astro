---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Privacy Policy | SDF Clothing";
const pageDescription = "SDF Clothing privacy policy â how we collect, use and protect your data in compliance with GDPR and international standards.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Privacy Policy",
		"description": "SDF Clothing privacy policy â how we collect, use and protect your data in compliance with GDPR and international standards.",
		"url": "https://sdfclothing.com/privacy",
		"dateModified": "2026-04-01",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://sdfclothing.com/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Privacy Policy"
				}
			]
		}
	}
	</script>

	<!-- Main Privacy Policy Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Privacy Policy</h1>
				<p class="text-white/70">Last updated: April 2026</p>
			</div>

			<div class="prose prose-invert max-w-none" style="font-size: 0.95rem; line-height: 1.9; color: #fff;">
				
				<!-- Introduction -->
				<p style="margin-bottom: 2rem;">
					At SDF Clothing, we are committed to protecting your privacy and ensuring the security of your personal information. 
					This privacy policy explains how we collect, use, and protect your data when you visit our website or interact with our services. 
					We comply with GDPR and international data protection standards to safeguard your rights.
				</p>

				<!-- Section 1: Information We Collect -->
				<h2 id="information-we-collect" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					1. Information We Collect
				</h2>
				<p style="margin-bottom: 1.5rem;">
					We collect several types of information to provide and improve our services:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Contact Form Data:</strong> When you submit inquiries through our contact forms, we collect your name, email address, phone number, company name, and message content.</li>
					<li style="margin-bottom: 0.75rem;"><strong>Cookies and Tracking Data:</strong> We use cookies to enhance your browsing experience and analyze website traffic. See our Cookies section for details.</li>
					<li style="margin-bottom: 0.75rem;"><strong>Analytics Data:</strong> We use Google Analytics to understand how visitors interact with our website. This data is anonymized and aggregated.</li>
					<li style="margin-bottom: 0.75rem;"><strong>IP Address and Location:</strong> We collect IP addresses and general location information for security and analytics purposes.</li>
				</ul>

				<!-- Section 2: How We Use Your Information -->
				<h2 id="how-we-use-information" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					2. How We Use Your Information
				</h2>
				<p style="margin-bottom: 1.5rem;">
					We use your information to:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Respond to your inquiries and provide requested information about our manufacturing services</li>
					<li style="margin-bottom: 0.75rem;">Improve our website functionality and user experience</li>
					<li style="margin-bottom: 0.75rem;">Send you relevant information about our services (with your consent)</li>
					<li style="margin-bottom: 0.75rem;">Analyze website traffic and optimize our marketing efforts</li>
					<li style="margin-bottom: 0.75rem;">Ensure website security and prevent fraudulent activities</li>
				</ul>

				<!-- Section 3: Cookies -->
				<h2 id="cookies" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					3. Cookies
				</h2>
				<p style="margin-bottom: 1.5rem;">
					We use cookies to enhance your experience on our website:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Essential Cookies:</strong> Required for basic website functionality</li>
					<li style="margin-bottom: 0.75rem;"><strong>Analytics Cookies:</strong> Help us understand how visitors use our site</li>
					<li style="margin-bottom: 0.75rem;"><strong>Preference Cookies:</strong> Remember your settings and preferences</li>
				</ul>
				<p style="margin-bottom: 1.5rem;">
					Our cookie consent popup allows you to accept or decline non-essential cookies. You can manage your preferences at any time through your browser settings.
				</p>

				<!-- Section 4: Data Sharing -->
				<h2 id="data-sharing" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					4. Data Sharing
				</h2>
				<p style="margin-bottom: 1.5rem;">
					We do not sell your personal information to third parties. We only share data with:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Service Providers:</strong> Hosting services, email platforms, and analytics tools that help us operate our website</li>
					<li style="margin-bottom: 0.75rem;"><strong>Legal Authorities:</strong> When required by law or to protect our rights</li>
					<li style="margin-bottom: 0.75rem;"><strong>Business Partners:</strong> Only with your explicit consent for specific services</li>
				</ul>
				<p style="margin-bottom: 1.5rem;">
					All third-party service providers are contractually obligated to protect your data and comply with applicable privacy laws.
				</p>

				<!-- Section 5: Data Retention -->
				<h2 id="data-retention" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					5. Data Retention
				</h2>
				<p style="margin-bottom: 1.5rem;">
					We retain your information for the following periods:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Contact Form Data:</strong> Retained for 2 years from last contact, then securely deleted</li>
					<li style="margin-bottom: 0.75rem;"><strong>Cookies:</strong> Retained according to your browser settings and cookie preferences</li>
					<li style="margin-bottom: 0.75rem;"><strong>Analytics Data:</strong> Anonymized data retained indefinitely for analytical purposes</li>
				</ul>

				<!-- Section 6: Your Rights (GDPR) -->
				<h2 id="your-rights" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					6. Your Rights (GDPR)
				</h2>
				<p style="margin-bottom: 1.5rem;">
					Under GDPR, you have the following rights:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Right to Access:</strong> Request a copy of your personal data</li>
					<li style="margin-bottom: 0.75rem;"><strong>Right to Rectify:</strong> Correct inaccurate or incomplete data</li>
					<li style="margin-bottom: 0.75rem;"><strong>Right to Delete:</strong> Request deletion of your personal data</li>
					<li style="margin-bottom: 0.75rem;"><strong>Right to Object:</strong> Object to processing of your data</li>
					<li style="margin-bottom: 0.75rem;"><strong>Right to Portability:</strong> Request transfer of your data to another service</li>
				</ul>
				<p style="margin-bottom: 1.5rem;">
					To exercise these rights, please contact us at <a href="mailto:contact@sdfltd.com" style="color: #ffffff; text-decoration: none;">contact@sdfltd.com</a>. We will respond to your request within 30 days.
				</p>

				<!-- Section 7: Third Party Services -->
				<h2 id="third-party-services" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					7. Third Party Services
				</h2>
				<p style="margin-bottom: 1.5rem;">
					Our website uses the following third-party services:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;"><strong>Google Analytics:</strong> For website analytics. All data is anonymized and aggregated.</li>
					<li style="margin-bottom: 0.75rem;"><strong>Web Hosting Providers:</strong> For secure website hosting and data storage.</li>
					<li style="margin-bottom: 0.75rem;"><strong>Email Service Providers:</strong> For communication and newsletter delivery.</li>
				</ul>
				<p style="margin-bottom: 1.5rem;">
					These services have their own privacy policies and we encourage you to review them.
				</p>

				<!-- Section 8: Contact -->
				<h2 id="contact" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					8. Contact
				</h2>
				<p style="margin-bottom: 1.5rem;">
					If you have questions about this privacy policy or need to exercise your rights, please contact us:
				</p>
				<div style="background: #000; border: 1px solid #1a1a1a; padding: 1.5rem; margin-bottom: 2rem;">
					<p style="margin-bottom: 0.75rem;"><strong>Email:</strong> <a href="mailto:contact@sdfltd.com" style="color: #ffffff; text-decoration: none;">contact@sdfltd.com</a></p>
					<p style="margin-bottom: 0.75rem;"><strong>Phone:</strong> +880 1711160511</p>
					<p style="margin-bottom: 0;"><strong>Address:</strong><br>
					House 125, Road 01<br>
					Baridhara DOHS<br>
					Dhaka-1212, Bangladesh</p>
				</div>

				<!-- Policy Updates -->
				<h2 id="policy-updates" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					Policy Updates
				</h2>
				<p style="margin-bottom: 2rem;">
					We may update this privacy policy from time to time to reflect changes in our practices or applicable law. 
					We will notify you of any significant changes by posting the new policy on our website and updating the "Last updated" date.
				</p>

			</div>
		</div>
	</section>
</BaseLayout>