---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Bangladesh vs China vs Vietnam vs India vs Turkey Sourcing";
const pageDescription = "Labor cost, MOQ, duty rates, lead time, and specialization compared across the top 5 apparel sourcing countries — plus which one fits your brand.";
const lastReviewed = "July 23, 2026";

const countryRows = [
  {
    name: "Bangladesh",
    labor: "$113/month",
    moq: "300-500 pcs",
    euDuty: "0% (EBA, until Nov 2026)",
    usDuty: "15-32% (MFN)",
    leadTime: "40-45 days (USA), 35-40 days (EU)",
    specialization: "Knitwear (70% of exports), T-shirts, basics",
    bestFor: "Startups and volume knitwear brands needing low MOQ and low cost"
  },
  {
    name: "China",
    labor: "$400-600/month",
    moq: "500-2,000 pcs",
    euDuty: "12% (standard)",
    usDuty: "MFN + Section 301 tariffs apply",
    leadTime: "30-35 days",
    specialization: "Broadest range — technical fabrics, complex construction, full supply chain depth",
    bestFor: "Complex, technical, or highly customized products where capability matters more than unit cost"
  },
  {
    name: "Vietnam",
    labor: "$150-192/month",
    moq: "500-1,500 pcs",
    euDuty: "0% (EVFTA, rules of origin apply)",
    usDuty: "15-32% (MFN)",
    leadTime: "30-35 days (USA), 25-30 days (EU)",
    specialization: "Woven garments, footwear, technical/performance wear",
    bestFor: "Brands wanting faster logistics than Bangladesh and stronger woven-garment capability"
  },
  {
    name: "India",
    labor: "$150-200/month",
    moq: "500-1,000 pcs",
    euDuty: "9.6% (lost GSP in 2023)",
    usDuty: "15-32% (MFN)",
    leadTime: "45-50 days (USA), 40-45 days (EU)",
    specialization: "Woven, silk, embroidery, artisan and heritage textiles",
    bestFor: "Brands wanting fabric diversity, embroidery, or artisan-level craftsmanship"
  },
  {
    name: "Turkey",
    labor: "30-50% higher FOB cost than Bangladesh",
    moq: "500-1,000 pcs",
    euDuty: "0% (EU customs union)",
    usDuty: "Standard MFN (no preferential agreement)",
    leadTime: "35-45 days production; 5-10 days shipping to EU by truck",
    specialization: "Premium denim, knitwear, tailored garments, activewear",
    bestFor: "EU-focused brands prioritizing fast replenishment and craftsmanship over lowest unit cost"
  }
];

const scenarioRows = [
  { situation: "You're a startup needing the lowest MOQ and cost", need: "Bangladesh — 300-piece MOQ, lowest labor cost of the five" },
  { situation: "Your product needs complex technical fabric or construction", need: "China — deepest supply chain and technical capability, at a higher cost" },
  { situation: "You want faster logistics than Bangladesh with strong woven capability", need: "Vietnam — comparable production speed, better port infrastructure" },
  { situation: "You need embroidery, silk, or artisan-level detail", need: "India — strongest specialization in heritage and handcraft techniques" },
  { situation: "You're an EU brand needing fast replenishment and can absorb higher cost", need: "Turkey — 5-10 day EU shipping beats any Asian sourcing option" },
  { situation: "You're selling into the EU and want 0% duty at the lowest cost", need: "Bangladesh (EBA) or Vietnam (EVFTA) — both duty-free, Bangladesh generally cheaper" }
];

const mistakeFaqs = [
  {
    question: "Is Bangladesh always the cheapest option?",
    answer: "For basic knitwear and high-volume simple garments, usually yes — it has the lowest labor cost of the five and the lowest MOQ. But cost isn't uniform across every product category. A highly technical or complex garment may actually cost less overall in China once you factor in fewer production issues and rework, and a small EU order may come out cheaper from Turkey once you account for Bangladesh's longer shipping time and inventory carrying cost."
  },
  {
    question: "Which country has the fastest total delivery time to the EU?",
    answer: "Turkey, by a wide margin, mainly due to geography rather than production speed. Turkey ships to the EU by truck in 5-10 days, while Bangladesh, Vietnam, India, and China all rely on ocean freight taking several weeks longer. Production time itself is fairly similar across all five countries — the gap comes almost entirely from shipping distance and logistics infrastructure, not manufacturing speed."
  },
  {
    question: "Does losing GSP or EBA status change these numbers over time?",
    answer: "It can, and it already has for one country on this list — India lost its EU GSP preferential access in 2023, moving it to the standard 9.6% duty rate. Bangladesh's EBA duty-free access is currently set to continue until November 2026, after which its terms may change as the country graduates from Least Developed Country status. These aren't permanent arrangements, so confirm current duty rates before finalizing a sourcing decision rather than relying on last year's numbers."
  },
  {
    question: "Can I split production across two of these countries?",
    answer: "Yes, and many established brands do exactly this — for example, sourcing basic knitwear from Bangladesh for cost efficiency while placing a technical or complex line with China, or using Turkey for fast-turn EU replenishment alongside a lower-cost base order from Bangladesh. It adds coordination overhead, so it tends to make more sense once volume justifies managing more than one supply relationship."
  },
  {
    question: "Why isn't [country] on this list?",
    answer: "This page covers the five countries most commonly compared head-to-head for apparel sourcing by brands evaluating multiple options at once. Other manufacturing hubs — Cambodia, Pakistan, Indonesia, Egypt, and others — have real strengths of their own; they're simply outside the scope of this specific five-way comparison."
  },
  {
    question: "Does a lower labor cost country always mean lower total landed cost?",
    answer: "Not necessarily. Labor cost is one input among several that determine what an order actually costs once it lands at your warehouse. Duty rate, shipping time (which ties up capital in transit inventory), MOQ, and rework risk on complex products all factor in. A country with higher labor cost but a trade-duty advantage or shorter shipping time can sometimes land cheaper overall than the lowest-labor-cost option, depending on the specific product and destination market."
  },
  {
    question: "How often do trade agreements and duty rates actually change?",
    answer: "More often than most buyers assume. India's move from 0% to 9.6% EU duty in 2023 happened within a single sourcing cycle for many brands who hadn't priced in the change. Bangladesh's current EBA duty-free access is scheduled to be reviewed as the country graduates from Least Developed Country status, with the current arrangement set to run until November 2026. Building a sourcing strategy assuming today's duty rate will hold indefinitely is a real, common mistake."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mistakeFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Bangladesh vs. China vs. Vietnam vs. India vs. Turkey: Apparel Sourcing Compared",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "jobTitle": "Founder & CEO, SDF Clothing",
    "url": "https://sdfltd.com/about"
  },
  "publisher": { "@type": "Organization", "name": "SDF Clothing", "url": "https://sdfltd.com" },
  "datePublished": "2026-07-23",
  "dateModified": "2026-07-23",
  "mainEntityOfPage": "https://sdfltd.com/bangladesh-vs-china-vs-vietnam-vs-india-vs-turkey-sourcing/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
    { "@type": "ListItem", "position": 2, "name": "Sourcing Countries", "item": "https://sdfltd.com/bangladesh-vs-china-vs-vietnam-vs-india-vs-turkey-sourcing/" }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="website">

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<section style="padding: 6rem 0 3rem; background:#000;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">Sourcing Country Decision Guide</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1.25rem;line-height:1.2;">
      Bangladesh vs. China vs. Vietnam vs. India vs. Turkey: Apparel Sourcing Compared
    </h1>
    <p style="color:#ccc;max-width:760px;line-height:1.8;font-size:0.95rem;">
      These five countries come up in almost every sourcing conversation, and each one wins on a different dimension — cost, capability, speed, or craftsmanship, rarely all four at once. This page pulls the numbers into one place. For the full depth on any single comparison, we've linked out to our dedicated country-pair breakdowns throughout.
    </p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">The Five Countries, Side by Side</h2>

    <div class="country-table-scroll">
      <table class="country-table">
        <colgroup>
          <col style="width:12%;" />
          <col style="width:16%;" />
          <col style="width:12%;" />
          <col style="width:14%;" />
          <col style="width:14%;" />
          <col style="width:16%;" />
          <col style="width:16%;" />
        </colgroup>
        <thead>
          <tr>
            <th>Country</th>
            <th>Labor cost</th>
            <th>Typical MOQ</th>
            <th>EU duty</th>
            <th>US duty</th>
            <th>Lead time</th>
            <th>Specialization</th>
          </tr>
        </thead>
        <tbody>
          {countryRows.map(row => (
            <tr>
              <td class="country-name">{row.name}</td>
              <td>{row.labor}</td>
              <td>{row.moq}</td>
              <td>{row.euDuty}</td>
              <td>{row.usDuty}</td>
              <td>{row.leadTime}</td>
              <td>{row.specialization}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="country-cards">
      {countryRows.map(row => (
        <div class="country-card">
          <p class="country-card-name">{row.name}</p>
          <p class="country-card-row"><span>Labor cost</span>{row.labor}</p>
          <p class="country-card-row"><span>Typical MOQ</span>{row.moq}</p>
          <p class="country-card-row"><span>EU duty</span>{row.euDuty}</p>
          <p class="country-card-row"><span>US duty</span>{row.usDuty}</p>
          <p class="country-card-row"><span>Lead time</span>{row.leadTime}</p>
          <p class="country-card-row"><span>Specialization</span>{row.specialization}</p>
          <p class="country-card-row"><span>Best for</span>{row.bestFor}</p>
        </div>
      ))}
    </div>
    <p style="color:#888;font-size:0.8rem;margin-top:1rem;">Last reviewed {lastReviewed}. Duty rates and trade preferences change — Bangladesh's EBA access is set to run until November 2026, and India lost its EU GSP status in 2023. Confirm current rates before finalizing a sourcing decision.</p>
    <p style="color:#888;font-size:0.8rem;margin-top:0.5rem;">Figures compiled from World Bank, WTO, and ILO trade and wage data, alongside industry bodies including BGMEA (Bangladesh) and AEPC (India) — the same sources cited in our detailed country-pair pages linked below.</p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">The Honest Pros and Cons of Each</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Bangladesh</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Lowest MOQ and labor cost of the five, 0% EU duty, strongest LEED-certified factory density</p>
        <p style="color:#f88;font-size:0.82rem;">− Longer ocean-shipping time than Turkey, narrower specialization (knitwear-heavy), no deep-sea port requires transshipment</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">China</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Deepest supply chain and technical capability, fastest production lead time of the five, handles high complexity well</p>
        <p style="color:#f88;font-size:0.82rem;">− Highest labor cost by a wide margin, no EU duty preference (12% standard), Section 301 tariffs add cost for US-bound goods</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Vietnam</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ 0% EU duty (EVFTA), better port infrastructure than Bangladesh, strong on woven garments and footwear</p>
        <p style="color:#f88;font-size:0.82rem;">− Higher MOQ and labor cost than Bangladesh, no US trade preference, EVFTA rules of origin add compliance complexity</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">India</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Strongest artisan, embroidery, and silk specialization, domestic fabric self-sufficiency, huge domestic market</p>
        <p style="color:#f88;font-size:0.82rem;">− Lost EU GSP status in 2023 (now 9.6% duty), longest lead time of the five, higher MOQ than Bangladesh</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Turkey</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Fastest EU delivery by far (5-10 days by truck), skilled craftsmanship, EU customs union means 0% duty</p>
        <p style="color:#f88;font-size:0.82rem;">− 30-50% higher FOB cost than Bangladesh, higher MOQ, no meaningful advantage for non-EU markets</p>
      </div>
    </div>
  </div>
</section>

<style>
  .country-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .country-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.76rem;
    color: #ddd;
  }
  .country-table thead tr { border-bottom: 1px solid #e00; }
  .country-table th { text-align: left; padding: 0.55rem 0.5rem; color: #fff; font-size: 0.7rem; }
  .country-table tbody tr { border-bottom: 1px solid #1a1a1a; }
  .country-table td {
    padding: 0.6rem 0.5rem;
    vertical-align: top;
    word-wrap: break-word;
    overflow-wrap: break-word;
    line-height: 1.5;
  }
  .country-table td.country-name { color: #fff; font-weight: 600; }

  .country-cards { display: none; }

  @media (max-width: 800px) {
    .country-table-scroll { display: none; }
    .country-cards { display: block; }
    .country-card {
      border: 1px solid #1a1a1a;
      border-top: 2px solid #e00;
      background: #050505;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }
    .country-card-name { color: #fff; font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; }
    .country-card-row { color: #ccc; font-size: 0.85rem; line-height: 1.7; margin-bottom: 0.6rem; }
    .country-card-row span {
      color: #e00; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;
      display: block; margin-bottom: 0.15rem;
    }
  }

  @media (min-width: 801px) and (max-width: 1000px) {
    .country-table { font-size: 0.68rem; }
    .country-table th { font-size: 0.6rem; padding: 0.45rem 0.35rem; }
    .country-table td { padding: 0.45rem 0.35rem; }
  }
</style>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Which Country Actually Fits Your Brand?</h2>
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:0.85rem;color:#ddd;margin-bottom:1.5rem;min-width:520px;">
        <thead>
          <tr style="border-bottom:1px solid #e00;">
            <th style="text-align:left;padding:0.6rem;color:#fff;">If your situation is...</th>
            <th style="text-align:left;padding:0.6rem;color:#fff;">Consider</th>
          </tr>
        </thead>
        <tbody>
          {scenarioRows.map(row => (
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:0.6rem;">{row.situation}</td>
              <td style="padding:0.6rem;">{row.need}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 style="font-size:1.1rem;color:#fff;margin-bottom:1rem;">Speed vs. Cost: Turkey's Real Tradeoff</h3>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:2rem;">Worth calling out on its own: Turkey's production speed isn't dramatically different from the other four countries — the real advantage is 5-10 day truck shipping to the EU versus several weeks of ocean freight from Asia. That's a genuine, significant advantage for EU brands running fast replenishment cycles, but it comes with 30-50% higher FOB pricing than Bangladesh. Whether that tradeoff is worth it depends entirely on how much inventory-carrying cost and stockout risk your business model can absorb versus how much it can pay upfront per unit.</p>

    <h3 style="font-size:1.1rem;color:#fff;margin-bottom:1rem;">One Sourcing Journey, Two Countries</h3>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;">A pattern worth illustrating: a brand launching a basic knitwear line — t-shirts, hoodies — with a limited budget typically finds Bangladesh's low MOQ and cost the easiest entry point. If that same brand later adds a technical, performance-fabric line requiring capability Bangladesh doesn't specialize in, it's common to keep the knitwear order running in Bangladesh while placing the technical line with a Chinese or Vietnamese factory instead — rather than treating the sourcing decision as all-or-nothing for the whole brand.</p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Best Country by Product Category</h2>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:1rem;">The right country shifts depending on what you're actually making — a useful cross-check against the general table above:</p>
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:0.85rem;color:#ddd;margin-bottom:1rem;min-width:520px;">
        <thead>
          <tr style="border-bottom:1px solid #e00;">
            <th style="text-align:left;padding:0.6rem;color:#fff;">Product category</th>
            <th style="text-align:left;padding:0.6rem;color:#fff;">Strongest fit</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:0.6rem;">Basic T-shirts, hoodies, knitwear</td><td style="padding:0.6rem;">Bangladesh — lowest cost, deep knitwear specialization</td></tr>
          <tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:0.6rem;">Denim</td><td style="padding:0.6rem;">Turkey (premium, EU-bound) or China (cost-driven, complex washes)</td></tr>
          <tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:0.6rem;">Activewear / technical performance fabric</td><td style="padding:0.6rem;">China or Vietnam — stronger technical fabric capability</td></tr>
          <tr style="border-bottom:1px solid #1a1a1a;"><td style="padding:0.6rem;">Silk, embroidery, artisan detail</td><td style="padding:0.6rem;">India — specialization no other country on this list matches</td></tr>
          <tr><td style="padding:0.6rem;">Tailored, structured garments</td><td style="padding:0.6rem;">Turkey — strongest craftsmanship reputation of the five</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Go Deeper on Any Single Comparison</h2>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:1rem;">This page is a summary by design — for full detail on any specific pairing, including working conditions, sustainability certifications, product specialization, and detailed FAQs, see:</p>
    <ul style="color:#ddd;font-size:0.9rem;line-height:2;padding-left:1.2rem;">
      <li><a href="/bangladesh-vs-china-clothing-manufacturing" style="color:#e00;text-decoration:none;">Bangladesh vs. China</a> — the classic cost-vs-capability comparison</li>
      <li><a href="/bangladesh-vs-vietnam-clothing-manufacturing" style="color:#e00;text-decoration:none;">Bangladesh vs. Vietnam</a> — cost vs. logistics speed</li>
      <li><a href="/bangladesh-vs-india-clothing-manufacturing" style="color:#e00;text-decoration:none;">Bangladesh vs. India</a> — volume knitwear vs. artisan textile diversity</li>
      <li><a href="/clothing-manufacturer-turkey" style="color:#e00;text-decoration:none;">Turkey manufacturing overview</a> — premium, EU-proximity sourcing in depth</li>
    </ul>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Common Mistakes — and the Myths Behind Them</h2>
    <div style="border:1px solid #1a1a1a;">
      <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> The cheapest country on paper is always the cheapest order</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> Labor cost is one input among several. Shipping time, duty rate, MOQ (which affects your capital tied up in inventory), and rework risk on complex products all factor into true landed cost — the lowest labor-cost country isn't automatically the cheapest total option for every product.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> Duty-free trade access is permanent</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> India's 2023 loss of EU GSP status is a direct example of how these preferences shift. Bangladesh's current EBA access is scheduled to run until November 2026, with terms afterward tied to its Least Developed Country graduation status. Build sourcing decisions around current confirmed terms, not permanent assumptions.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> You have to pick exactly one country and stick with it</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> Splitting production across countries by product type or urgency is common practice once volume justifies the coordination overhead — there's no rule requiring a single-country sourcing strategy.</p>
      </div>
    </div>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
