---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Public Notice | SDF Clothing";
const pageDescription = "Official public notices and announcements from SDF Clothing, Bangladesh's leading clothing manufacturer.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="container">
		<!-- Breadcrumb -->
		<nav aria-label="Breadcrumb" style="margin: 2rem 0;">
			<p style="font-size: 0.8rem; color: #aaa;">
				<a href="/" style="color: #ffffff;">Home</a> &gt; Public Notice
			</p>
		</nav>
		
		<!-- Main Content -->
		<article>
			<h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 2rem; color: #fff;">
				Public Notice
			</h1>
			
			<p style="font-size: 1.1rem; color: #aaa; line-height: 1.8; margin-bottom: 3rem;">
				This section contains official public notices, legal announcements, and important updates from SDF Clothing. As a leading clothing manufacturer in Bangladesh since 1998, we believe in transparency and keeping our stakeholders informed about significant developments, regulatory changes, and company milestones.
			</p>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Recent Announcements
			</h2>
			
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<!-- Notice 1 -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Regulatory Compliance Update
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						SDF Clothing is fully compliant with EU EPR regulations effective January 2026. All our manufacturing processes meet the new requirements for extended producer responsibility, ensuring our international partners can continue seamless operations in European markets.
					</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #1a1a1a;">
						<small style="color: #FFFFFF; font-size: 0.8rem;">Posted: April 2026</small>
					</div>
				</div>
				
				<!-- Notice 2 -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Production Capacity Expansion
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						We're pleased to announce a 20% increase in our monthly production capacity, now reaching 60,000+ pieces while maintaining our commitment to quality and sustainable manufacturing practices.
					</p>
					<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #1a1a1a;">
						<small style="color: #FFFFFF; font-size: 0.8rem;">Posted: March 2026</small>
					</div>
				</div>
				
			</div>
			
			<!-- Contact Information -->
			<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem; margin-top: 3rem;">
				<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
					Questions?
				</h3>
				<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.5rem;">
					For any questions about our public notices or need additional information, please contact our team:
				</p>
				<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
					<div style="flex: 1;">
						<strong style="color: #fff;">Email:</strong>
						<a href="mailto:contact@sdfltd.com" style="color: #ffffff; text-decoration: none;">contact@sdfltd.com</a>
					</div>
					<div style="flex: 1;">
						<strong style="color: #fff;">Phone:</strong>
						<a href="tel:+8801911733226" style="color: #ffffff; text-decoration: none;">+880 1911733226</a>
					</div>
				</div>
			</div>
			
		</article>
		
		<!-- Footer Link -->
		<div style="text-align: center; margin: 4rem 0 2rem; padding-top: 2rem; border-top: 1px solid #1a1a1a;">
			<p style="color: #aaa; font-size: 0.9rem;">
				<a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing,%20I%20need%20more%20information" target="_blank" rel="noopener noreferrer" style="color: #ffffff;">Contact Us</a> for more information
			</p>
		</div>
	</div>
	
</BaseLayout>
