---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Custom Jacket Manufacturer for Outerwear Brands | SDF"
const pageDescription = "Custom jacket manufacturer from Bangladesh. Bomber jackets, denim jackets, blazers, windbreakers, puffer jackets. Fabric and construction. From 300 pieces."
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Custom jacket manufacturer from Bangladesh providing bomber jackets, denim jackets, blazers, windbreakers, and puffer jackets with fabric and construction options to outerwear brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for jacket manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What jacket styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture bomber jackets for casual wear, denim jackets for classic styling, blazers for formal wear, windbreakers for weather protection, and puffer jackets for winter warmth. All styles available with customization options."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric options do you offer for jackets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer polyester, nylon, cotton canvas, denim, wool blends, and technical fabrics. Various weights from lightweight windbreakers to heavy winter puffers. Lining options include polyester, fleece, and thermal insulation."
          }
        },
        {
          "@type": "Question",
          "name": "What construction options do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer quilted construction for puffers, bonded fabric for windbreakers, classic denim construction, tailored blazer construction, and bomber jacket ribbed cuffs. Custom construction available for specific requirements."
          }
        },
        {
          "@type": "Question",
          "name": "How much does jacket manufacturing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jacket manufacturing costs vary by complexity. Basic windbreaker: $12-20 per piece. Denim jacket: $15-25 per piece. Puffer jacket: $18-30 per piece. FOB Bangladesh pricing from 300 pieces minimum."
          }
        },
        {
          "@type": "Question",
          "name": "How long does jacket production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard jacket production timeline: 35-45 days from fabric receipt for basic styles. 45-60 days for complex designs with insulation. 10-14 days for sampling before bulk. Fabric sourcing adds 7-14 days."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Jacket Manufacturer"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Jacket Manufacturing Service",
      "description": "Custom jacket manufacturing from 300 pieces including bomber jackets, denim jackets, blazers, windbreakers, and puffer jackets",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Jacket Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Jacket Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "12",
              "maxPrice": "30"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Jackets from SDF Clothing",
      "description": "Step-by-step process for ordering custom jackets from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your jacket design, fabric specifications, lining options, size chart, target quantity, and construction requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, insulation, and shipping for your jacket order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review jacket samples for fit, fabric quality, construction, and insulation within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard jacket items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your jacket order"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="jacket manufacturer, custom jacket manufacturer, bomber jacket manufacturer, denim jacket manufacturer, puffer jacket manufacturer, windbreaker manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Jacket Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Jacket Manufacturer | Since 1998 | Outerwear</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Jacket Manufacturer for Outerwear Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Jackets are statement pieces - from lightweight windbreakers to warm puffer coats. Custom manufacturing ensures quality construction, proper insulation, and brand consistency. SDF Clothing is a jacket specialist and full-service clothing manufacturer in Bangladesh, producing everything from bombers to puffers, denim to blazers. From 300 pieces per style with full customization.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact/" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20jacket-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">35-45</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Custom</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Construction</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Full</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Lining</div>
      </div>
    </div>
  </div>
</section>

<!-- Jacket Styles Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Jacket Categories We Manufacture</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Bomber Jackets</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic bomber jackets for casual wear. Ribbed cuffs and hem, zip closure, various fabrics. Popular for streetwear and casual collections.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Denim Jackets</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic denim jackets for timeless styling. Various washes, distressing options, metal hardware. Essential for heritage and casual brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Blazers</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Formal blazers for professional wear. Tailored construction, structured shoulders, premium fabrics. Available for men and women.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Windbreakers</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Lightweight windbreakers for weather protection. Water-resistant fabrics, packable designs, active styling. Ideal for outdoor and activewear brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Puffer Jackets</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Insulated puffer jackets for winter warmth. Quilted construction, down or synthetic fill, various shell fabrics. Essential for winter collections.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Fabric Options for Jackets</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Polyester (durable, water-resistant)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Nylon (lightweight, windproof)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cotton canvas (rugged, casual)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Leather (premium, durable) - See our <a href="/leather-clothing-manufacturer" style="color:#e00;text-decoration:underline;">leather clothing manufacturer</a> page
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Denim (classic, durable)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Wool blends (warm, formal)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Technical fabrics (performance, weatherproof)
      </li>
    </ul>
  </div>
</section>

<!-- Construction Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Construction</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem">Fabric and Construction</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quilted construction (puffer jackets)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bonded fabric (windbreakers)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Classic denim construction (denim jackets)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Tailored blazer construction (formal wear)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bomber jacket ribbed cuffs (classic styling)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Custom construction (specific requirements)
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Jacket manufacturing costs vary by complexity:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic windbreaker: $12-20 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Denim jacket: $15-25 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Puffer jacket: $18-30 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. Insulation, custom hardware, and premium packaging are additional.
    </p>

    <table style="width:100%;max-width:800px;margin-top:2rem;border-collapse:collapse;background:#0a0a0a;">
      <thead>
        <tr style="background:#e00;">
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Jacket Type</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Fabric</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">MOQ</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Price (300 pcs)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Windbreaker</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Polyester, nylon</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$12-20 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Denim Jacket</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Denim canvas</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Bomber Jacket</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Nylon, cotton blends</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Puffer Jacket</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Nylon with insulation</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$18-30 per piece</td>
        </tr>
        <tr>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Blazer</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Wool blends, polyester</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$20-30 per piece</td>
        </tr>
      </tbody>
    </table>

    
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Jacket Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard jacket production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fabric sourcing: 7-14 days
