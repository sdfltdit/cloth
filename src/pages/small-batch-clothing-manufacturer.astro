<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="small batch clothing manufacturer, indie brand manufacturer, limited edition production, flexible MOQ, small quantity production, independent clothing brand" />

