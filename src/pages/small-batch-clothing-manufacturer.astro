---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Small Batch Clothing Manufacturer for Independent Brands";
const pageDescription = "Small batch clothing manufacturer from Bangladesh. 100-500 piece runs for indie brands. Limited edition production, flexible MOQ. From 100 pieces. Free quote."
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Small batch clothing manufacturer from Bangladesh providing 100-500 piece runs for independent brands with flexible MOQ and limited edition production since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "100 pieces per style minimum for small batch production. Flexible MOQ for indie brands. 100-500 piece runs ideal for testing, limited editions, and independent brand launches."
          }
        },
        {
          "@type": "Question",
          "name": "How do you support indie brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We support indie brands with flexible MOQ, design consultation, production guidance, and brand development assistance. We understand indie brand challenges and provide tailored support for smaller quantities."
          }
        },
        {
          "@type": "Question",
          "name": "What limited edition production do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Limited edition production for 100-500 piece runs. Exclusive designs, seasonal collections, capsule collections. Ideal for drops, collaborations, and brand differentiation."
          }
        },
        {
          "@type": "Question",
          "name": "How does pricing work for small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small batch pricing is 15-25% higher than bulk production due to lower economies of scale. However, the premium is justified by flexibility, limited exclusivity, and brand positioning. FOB Bangladesh pricing from $10-20 per piece."
          }
        },
        {
          "@type": "Question",
          "name": "What is the production timeline for small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small batch production timeline: 25-35 days from order confirmation. Faster than bulk due to smaller quantities. Fabric sourcing: 5-10 days. Production: 15-20 days. Quality inspection: 1-2 days. Packing and shipping: 3-5 days."
          }
        },
        {
          "@type": "Question",
          "name": "Can I scale up from small batch to bulk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Small batch is ideal for market testing. If successful, scale up to bulk production with volume discounts. We maintain design consistency and quality across production scales. Seamless transition from small batch to bulk."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Small Batch Clothing Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
