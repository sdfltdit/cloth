---
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../../../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../../../data/schema';
export const prerender = true;

const pageTitle = "Pet Clothing Manufacturing Cost | Pricing SDF";
const pageDescription = "Pet clothing manufacturing cost guide. Understand MOQ impact, fabric costs, labor pricing, and cost optimization for dog apparel brands.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Pet Clothing Manufacturer",
            "item": "https://sdfltd.com/pet-clothing-manufacturer/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Pet Clothing Manufacturing Cost"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the typical costs for pet clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pet clothing manufacturing costs typically range from $8-15 per piece for basic items like t-shirts and hoodies, $12-20 for technical items like dog jackets, and $15-25 for complex items like equestrian wear. Costs vary based on fabric selection, complexity, order volume, and customization. Volume production reduces per-unit costs significantly."
          }
        },
        {
          "@type": "Question",
          "name": "How does MOQ affect pet clothing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "MOQ directly impacts pet clothing cost through economies of scale. Higher volume orders reduce per-unit costs by spreading fixed costs across more units. Production setup costs including pattern making, machine programming, and material sourcing are fixed regardless of order size. Orders at 300 pieces typically cost 20-30% more per unit than orders at 1,000 pieces."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric cost factors affect pet clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fabric costs account for 60-70% of total pet clothing manufacturing cost. Factors include material type (cotton vs synthetic), fabric weight, quality grade, organic certification, custom color development, and yardage requirements. Organic and sustainable materials cost 30-50% more than conventional alternatives. Custom fabric colors require dye lot minimums that increase cost."
          }
        },
        {
          "@type": "Question",
          "name": "What are the labor costs in pet clothing production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Labor costs typically represent 15-25% of total pet clothing manufacturing cost. Labor-intensive construction like detailed stitching, multiple panels, or complex assembly increases labor costs. Simple t-shirts require minimal labor, while complex items like dog jackets with multiple components require more skilled labor and time. Bangladesh offers competitive labor costs while maintaining quality."
          }
        },
        {
          "@type": "Question",
          "name": "How can I optimize pet clothing production costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost optimization strategies include increasing order volume for economies of scale, using stock fabrics instead of custom colors, simplifying design to reduce labor, consolidating styles to share patterns, planning seasonal production for efficiency, and negotiating with suppliers for volume pricing. Balancing cost reduction with quality requirements is essential."
          }
        },
        {
          "@type": "Question",
          "name": "What additional costs should I consider?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Additional costs include sampling ($50-100 per sample), shipping ($0.50-2.00 per piece), customs duties (0-20% depending on country), labeling and packaging ($0.50-2.00 per piece), and quality inspection ($0.10-0.30 per piece). These costs add 10-20% to base manufacturing cost. Planning for these costs ensures accurate pricing and margin calculation."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/pet-clothing-manufacturer">Pet Clothing Manufacturer</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Pet Clothing Manufacturing Cost</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Pet Clothing Cost • Since 1998 • Production Pricing Specialists</div>
        <h1 class="hero__title">Pet Clothing Manufacturing Cost • Dog Apparel Production Pricing</h1>
        <p class="hero__description">
          SDF Clothing provides pet clothing manufacturing cost guidance. Dog apparel production pricing, MOQ impact on cost, fabric cost factors, labor costs, pet clothing pricing breakdown, and cost optimization for pet brands.
        </p>
        <div class="hero__ctas">
          <a href="/contact/" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20pet%20clothing%20cost%20information`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">$8-25</span>
          <span class="hero__stat-label">Per Piece Range</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">Volume</span>
          <span class="hero__stat-label">Discounts</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Cost Breakdown</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>MOQ Impact</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Fabric Costs</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Cost Optimization</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Manufacturing Costs</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pet Clothing Production Pricing</h2>
      </div>
      <div class="section__text">
        <p>Pet clothing manufacturing costs vary significantly based on product type, complexity, materials, and order volume. Understanding cost structure helps pet brands price products accurately and maintain healthy margins. Our transparent pricing approach provides clarity on all cost components, enabling informed decision-making.</p>
        
        <p>Basic pet clothing items like t-shirts, simple hoodies, and bandanas typically cost $8-12 per piece at standard minimum quantities. These items use straightforward construction, standard fabrics, and minimal branding. Technical items like dog jackets, raincoats, and performance wear range from $12-20 due to specialized materials, waterproofing, and complex construction.</p>
        
        <p>Complex pet clothing including equestrian wear, competition garments, and multi-component items cost $15-25 per piece. These require specialized patterns, technical fabrics, skilled labor, and quality control. Custom designs, organic materials, and extensive branding add to base costs. Volume production significantly reduces per-unit costs through economies of scale.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">MOQ Impact</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How MOQ Affects Pet Clothing Cost</h2>
      </div>
      <div class="section__text">
        <p>Minimum Order Quantity (MOQ) directly impacts pet clothing cost through economies of scale. Higher volume orders reduce per-unit costs by spreading fixed setup costs across more units. Understanding this relationship helps brands plan production quantities strategically to optimize costs while managing inventory risk.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Order Volume</th>
              <th>Cost Impact</th>
              <th>Per-Unit Savings</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>300-500 pieces</td>
              <td>Base pricing</td>
              <td>0%</td>
              <td>Startups, testing</td>
            </tr>
            <tr>
              <td>500-1,000 pieces</td>
              <td>10-15% reduction</td>
              <td>10-15%</td>
              <td>Growing brands</td>
            </tr>
            <tr>
              <td>1,000-2,000 pieces</td>
              <td>20-25% reduction</td>
              <td>20-25%</td>
              <td>Established brands</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>2,000+ pieces</td>
              <td>30%+ reduction</td>
              <td>30%+</td>
              <td>Large brands</td>
            </tr>
          </tbody>
          <caption>Volume discounts apply across all pet clothing categories. Higher volume enables material cost savings and production efficiency.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Costs</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Fabric Cost Factors in Pet Clothing</h2>
      </div>
      <div class="section__text">
        <p>Fabric costs account for 60-70% of total pet clothing manufacturing cost, making material selection the most significant cost driver. Understanding fabric cost factors enables brands to make informed decisions balancing quality, performance, and cost. Multiple factors influence fabric pricing beyond basic material type.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Factor</th>
              <th>Cost Impact</th>
              <th>Description</th>
              <th>Cost Range</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Material Type</td>
              <td>Base cost</td>
              <td>Cotton vs polyester vs specialty</td>
              <td>30-100% variance</td>
            </tr>
            <tr>
              <td>Fabric Weight</td>
              <td>Linear cost</td>
              <td>Heavier fabrics cost more</td>
              <td>+10-30%</td>
            </tr>
            <tr>
              <td>Quality Grade</td>
              <td>Quality premium</td>
              <td>Premium vs standard quality</td>
              <td>+20-40%</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Organic Certification</td>
              <td>Certification cost</td>
              <td>GOTS organic certification</td>
              <td>+30-50%</td>
            </tr>
            <tr>
              <td>Custom Color</td>
              <td>Dye lot minimum</td>
              <td>Custom color development</td>
              <td>+15-25%</td>
            </tr>
          </tbody>
          <caption>Fabric selection is the primary cost driver. Using stock fabrics in available colors significantly reduces material costs.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Labor Costs</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Labor Costs in Pet Clothing Production</h2>
      </div>
      <div class="section__text">
        <p>Labor costs typically represent 15-25% of total pet clothing manufacturing cost. Labor intensity varies dramatically based on garment complexity, construction methods, and quality requirements. Understanding labor cost drivers helps brands design products that balance cost with quality and functionality.</p>
        
        <p>Simple pet clothing items like t-shirts, basic hoodies, and bandanas require minimal labor with straightforward construction. These items can be produced efficiently with lower labor costs per unit. Complex items like dog jackets with multiple components, zippers, linings, and waterproofing require significantly more skilled labor and assembly time.</p>
        
        <p>Bangladesh offers competitive labor costs while maintaining quality standards that meet international requirements. Our skilled workforce handles complex pet clothing construction efficiently, keeping labor costs reasonable without compromising quality. Labor cost advantages enable competitive pricing for pet brands seeking quality manufacturing at accessible costs.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Cost Breakdown</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pet Clothing Pricing Breakdown</h2>
      </div>
      <div class="section__text">
        <p>A complete pet clothing pricing breakdown includes all cost components from production through delivery. Understanding the full cost structure enables accurate pricing calculation and margin planning. Beyond base manufacturing costs, additional expenses must be accounted for in final product pricing.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Cost Component</th>
              <th>Percentage</th>
              <th>Typical Range</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Fabric</td>
              <td>60-70%</td>
              <td>$5-12 per piece</td>
              <td>Primary material cost</td>
            </tr>
            <tr>
              <td>Labor</td>
              <td>15-25%</td>
              <td>$2-5 per piece</td>
              <td>Production labor cost</td>
            </tr>
            <tr>
              <td>Trims & Accessories</td>
              <td>5-10%</td>
              <td>$0.50-2 per piece</td>
              <td>Zippers, buttons, labels</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Overhead</td>
              <td>5-10%</td>
              <td>$0.50-2 per piece</td>
              <td>Factory overhead</td>
            </tr>
            <tr>
              <td>Shipping</td>
              <td>5-10%</td>
              <td>$0.50-2 per piece</td>
              <td>International shipping</td>
            </tr>
          </tbody>
          <caption>Percentages based on standard production quantities. Additional costs for sampling, customs, and quality inspection add 5-10%.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Cost Optimization</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Optimizing Pet Clothing Production Costs</h2>
      </div>
      <div class="section__text">
        <p>Cost optimization strategies enable pet brands to reduce manufacturing expenses without compromising quality. Strategic decisions in design, material selection, and production planning can significantly impact final costs. The most effective optimization approaches balance cost reduction with product requirements and brand positioning.</p>
        
        <p>Increasing order volume provides the most significant cost reduction through economies of scale. Consolidating orders across styles or planning seasonal production in larger batches reduces per-unit costs. Using stock fabrics in available colors instead of custom fabric development eliminates dye lot minimums and reduces material costs by 15-25%.</p>
        
        <p>Design simplification reduces labor costs by minimizing complex construction. Fewer panels, simpler closures, and reduced embellishments lower labor requirements. Sharing patterns across styles reduces pattern development costs. Planning production strategically to combine orders for similar fabrics or constructions improves factory efficiency and can yield cost savings of 10-15%.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Additional Costs</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Additional Costs to Consider</h2>
      </div>
      <div class="section__text">
        <p>Beyond base manufacturing costs, additional expenses must be factored into total product cost. These additional costs add 10-20% to base manufacturing cost and significantly impact final pricing and margin calculation. Planning for these costs ensures accurate financial planning and prevents margin erosion.</p>
        
        <p>Sampling costs typically range from $50-100 per sample and are essential for product development. While sampling costs are credited against production orders for styles that proceed to manufacturing, they represent upfront investment that must be planned for. Multiple sample rounds increase development costs but reduce risk of production errors.</p>
        
        <p>Shipping costs of $0.50-2.00 per piece depend on order volume, destination, and shipping method. Air shipping is faster but significantly more expensive than sea shipping. Customs duties range from 0-20% depending on destination country and product classification. Labeling and packaging add $0.50-2.00 per piece depending on customization level. Quality inspection costs of $0.10-0.30 per piece ensure product quality but add to total cost.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pet Clothing Manufacturing Cost FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What are the typical costs for pet clothing manufacturing?</h3>
          <p class="faq__answer">Pet clothing manufacturing costs typically range from $8-15 per piece for basic items like t-shirts and hoodies, $12-20 for technical items like dog jackets, and $15-25 for complex items like equestrian wear. Costs vary based on fabric selection, complexity, order volume, and customization. Volume production reduces per-unit costs significantly.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How does MOQ affect pet clothing cost?</h3>
          <p class="faq__answer">MOQ directly impacts pet clothing cost through economies of scale. Higher volume orders reduce per-unit costs by spreading fixed costs across more units. Production setup costs including pattern making, machine programming, and material sourcing are fixed regardless of order size. Orders at 300 pieces typically cost 20-30% more per unit than orders at 1,000 pieces.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabric cost factors affect pet clothing?</h3>
          <p class="faq__answer">Fabric costs account for 60-70% of total pet clothing manufacturing cost. Factors include material type (cotton vs synthetic), fabric weight, quality grade, organic certification, custom color development, and yardage requirements. Organic and sustainable materials cost 30-50% more than conventional alternatives. Custom fabric colors require dye lot minimums that increase cost.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What are the labor costs in pet clothing production?</h3>
          <p class="faq__answer">Labor costs typically represent 15-25% of total pet clothing manufacturing cost. Labor-intensive construction like detailed stitching, multiple panels, or complex assembly increases labor costs. Simple t-shirts require minimal labor, while complex items like dog jackets with multiple components require more skilled labor and time. Bangladesh offers competitive labor costs while maintaining quality.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How can I optimize pet clothing production costs?</h3>
          <p class="faq__answer">Cost optimization strategies include increasing order volume for economies of scale, using stock fabrics instead of custom colors, simplifying design to reduce labor, consolidating styles to share patterns, planning seasonal production for efficiency, and negotiating with suppliers for volume pricing. Balancing cost reduction with quality requirements is essential.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What additional costs should I consider?</h3>
          <p class="faq__answer">Additional costs include sampling ($50-100 per sample), shipping ($0.50-2.00 per piece), customs duties (0-20% depending on country), labeling and packaging ($0.50-2.00 per piece), and quality inspection ($0.10-0.30 per piece). These costs add 10-20% to base manufacturing cost. Planning for these costs ensures accurate pricing and margin calculation.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready for Pet Clothing Cost Analysis?</h2>
      <p class="section__text">
        Contact SDF Clothing for pet clothing manufacturing cost analysis. We provide detailed cost breakdowns, volume pricing, and optimization strategies for pet brands.
      </p>
      <div class="section__ctas">
        <a href="/contact/" class="section__cta section__cta--primary">Get Free Quote</a>
        <a href="/pet-clothing-manufacturer" class="section__cta section__cta--secondary">Pet Clothing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/pet-clothing-manufacturer/dog-hoodie-manufacturer" style="color: var(--color-primary);">dog hoodie manufacturer</a>, <a href="/pet-clothing-manufacturer/private-label-pet-clothing" style="color: var(--color-primary);">private label pet clothing</a>, <a href="/clothing-manufacturing-cost-guide" style="color: var(--color-primary);">clothing manufacturing cost</a>, <a href="/clothing-manufacturer-bangladesh" style="color: var(--color-primary);">clothing manufacturer Bangladesh</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin: 0 var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .hero__stat {
    text-align: center;
  }

  .hero__stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero__stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero__ctas {
    display: flex;
    gap: var(--spacing-sm);
  }

