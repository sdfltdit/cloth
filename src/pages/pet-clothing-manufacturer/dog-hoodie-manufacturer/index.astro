<script>
  (function() {
    const sections = [
      'section-hero',
      'section-problem',
      'section-fabricspec',
      'section-sizing',
      'section-casestudy',
      'section-certifications',
      'section-faq',
      'section-cta'
    ];

    function setActive() {
      const scrollY = window.scrollY + window.innerHeight / 3;
      let current = sections[0];
      sections.forEach(id => {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= scrollY) current = id;
      });
      document.querySelectorAll('.page-nav__dot').forEach(dot => {
        const href = dot.getAttribute('href')?.replace('#', '');
        dot.classList.toggle('page-nav__dot--active', href === current);
      });
    }

    window.addEventListener('scroll', setActive, { passive: true });
    setActive();
  })();
</script>
