---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Dog Hoodie Manufacturer | Custom French Terry & Fleece, 300 MOQ";
const pageDescription = "Custom dog hoodie manufacturer with harness-hole engineering and GOTS organic options. French terry or fleece, GSM-tested fabric, 300 pcs MOQ. Free sample.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const dateModified = new Date().toISOString().split('T')[0];
const foundedDate = new Date('1998-08-22');
const today = new Date();
let yearsExp = today.getFullYear() - foundedDate.getFullYear();
const hasPassedAnniversary = (today.getMonth() > foundedDate.getMonth()) || (today.getMonth() === foundedDate.getMonth() && today.getDate() >= foundedDate.getDate());
if (!hasPassedAnniversary) yearsExp -= 1;
const experienceYears = yearsExp;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sdfltd.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pet Clothing Manufacturer",
      "item": "https://sdfltd.com/pet-clothing-manufacturer/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Dog Hoodie Manufacturer",
      "item": "https://sdfltd.com/pet-clothing-manufacturer/dog-hoodie-manufacturer/"
    }
  ]
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": "https://sdfltd.com/pet-clothing-manufacturer/dog-hoodie-manufacturer/#webpage",
  "url": "https://sdfltd.com/pet-clothing-manufacturer/dog-hoodie-manufacturer/",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "en-GB",
  "datePublished": "2025-02-01",
  "dateModified": dateModified,
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "url": "https://sdfltd.com/about/"
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://sdfltd.com/#website",
    "url": "https://sdfltd.com",
    "name": "SDF Clothing"
  }
};

const articleSchema = {
  "@type": "Article",
  "headline": "Dog Hoodie Manufacturer | Custom French Terry, Fleece & Organic Cotton from 300 Pieces",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SDF Clothing",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sdfltd.com/images/sdf.jpg"
    }
  },
  "datePublished": "2025-02-01",
  "dateModified": dateModified
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What fabric is best for a custom dog hoodie | French terry or fleece?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "French terry (220-300 GSM) is more breathable and holds its shape over repeated washes, making it better for mild climates or dogs that overheat easily. Fleece (280-360 GSM) traps more heat through its brushed nap, making it warmer for cold climates, but it pills faster and compresses over time. Most brands stock both | French terry for transitional seasons, fleece for deep winter."
      }
    },
    {
      "@type": "Question",
      "name": "Should a dog hoodie have a harness hole?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, for any hoodie intended for daily walks. A harness hole placed at the harness D-ring's actual position during movement (not where it sits when the dog is standing still) lets the leash clip through without removing the hoodie. Poor placement causes the garment to twist, ripple, or slide off-centre as the dog moves and the leash pulls against misaligned fabric."
      }
    },
    {
      "@type": "Question",
      "name": "What is the minimum order quantity for custom dog hoodies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "300 pieces per style, split across sizes as needed. A different fabric (French terry vs fleece vs organic cotton) or a different cut counts as a separate style with its own 300-piece minimum. Multiple colourways of the identical pattern are usually treated as one style."
      }
    },
    {
      "@type": "Question",
      "name": "Can dog hoodies be made from organic cotton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. GOTS-certified organic cotton French terry or fleece is available, sourced and processed without synthetic pesticides or toxic dyes. Organic cotton hoodies typically cost more per unit than standard cotton-poly blends, and we'll quote both options side by side so you can compare before committing."
      }
    },
    {
      "@type": "Question",
      "name": "How long does dog hoodie sampling take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "7 to 14 calendar days from a confirmed design brief. Sampling is free with up to 10 revisions included. Bulk cutting does not start until you approve the sample in writing."
      }
    }
  ]
};

const howToSchema = {
  "@type": "HowTo",
  "name": "How to Order Custom Dog Hoodies from SDF Clothing",
  "totalTime": "PT45D",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Send Your Design and Fabric Preference",
      "text": "Submit a sketch, reference photo, or written description through the sample request form. Tell us French terry vs fleece preference, organic cotton interest, harness-hole requirement, and target size range.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Receive Fabric Options and Quote",
      "text": "We respond within one business day with GSM recommendations matched to your climate target, a per-unit cost estimate, and sample plus bulk lead times.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Approve the Sample",
      "text": "Sample production takes 7 to 14 days. You receive physical samples to check fit, fabric hand-feel, harness-hole placement, and stitching. Free revisions until you sign off.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Confirm Bulk Order",
      "text": "Place your PO from 300 pieces per style, split across sizes as needed. 30% deposit starts cutting, 70% balance due before shipment.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Inspection and Shipping",
      "text": "Final AQL inspection runs before packing. Fabric test reports, packing list, and commercial invoice ship with the order.",
      "url": "https://sdfltd.com/sample-request/"
    }
  ]
};

const pageSchema = [breadcrumbSchema, webPageSchema, articleSchema, faqSchema, howToSchema];
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl.href}
  datePublished="2025-02-01"
  dateModified={dateModified}
  schema={pageSchema}
>

<meta name="robots" content="index, follow" />

<style>
  /* Force this page to always render dark */
  :global(html),
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  :root {
    --color-primary: #000000;
    --color-accent: #cc0000;
    --color-text: #ffffff;
    --color-bg: #000000;
    --color-bg-alt: #111111;
    --color-border: #333333;
  }

  /* Force black background regardless of OS light/dark mode */
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .card,
  .cluster-link,
  .stats-bar__item {
    --color-bg-alt: #000000;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-accent);
  }

  .section__label {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .section__subtitle {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .accent-line {
    width: 60px;
    height: 2px;
    background: var(--color-accent);
    margin: 0 auto 1.5rem;
  }

  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--color-accent);
  }

  .hero__eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 200;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__lead {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: transparent;
    margin: 2rem 0;
  }

  .stats-bar__item {
    background: #000000;
    border: 1px solid rgba(204, 0, 0, 0.3);
    padding: 2rem;
    text-align: center;
  }

  .stats-bar__value {
    font-size: 2rem;
    font-weight: 200;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .stats-bar__label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.7;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .cta-button--primary {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cta-button--primary:hover {
    background: #990000;
  }

  .cta-button--secondary {
    background: transparent;
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--color-text);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .cta-button--secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .hero__svg {
    width: 100%;
    height: auto;
    max-width: 580px;
    display: block;
    margin: 3rem auto 0;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb__text {
    font-size: 0.72rem;
    color: var(--color-text);
  }

  .breadcrumb__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .breadcrumb__separator {
    margin: 0 0.5rem;
    color: #cc0000;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  thead {
    background: #cc0000;
  }

  thead th {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  td, th {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(204, 0, 0, 0.2);
  }

  tbody tr:nth-child(even) {
    background: #0a0a0a;
  }

  .comparison-table td:nth-child(2) {
    opacity: 0.6;
  }

  .comparison-table td:nth-child(3) {
    background: rgba(204, 0, 0, 0.1);
  }

  .check--green {
    color: #22c55e;
  }

  .check--red {
    color: #ef4444;
  }

  .check--amber {
    color: #f59e0b;
  }

  .product-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 0;
    max-width: 700px;
  }

  .product-list__item {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.9;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .product-list__item::before {
    content: " | ";
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }

  .product-list--two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
    justify-items: center;
  }

  @media (max-width: 640px) {
    .product-list--two-col {
      grid-template-columns: 1fr;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    background: transparent;
  }

  .card {
    background: #000000;
    border: 1px solid #cc0000;
    padding: 2rem;
    min-height: 200px;
  }

  .card__title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .card__text {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .process-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .process-step__number {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .process-step__content {
    flex: 1;
  }

  .process-step__title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .process-step__text {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.7;
    text-align: center;
  }

  .cluster-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .cluster-link {
    background: #000000;
    padding: 1.5rem;
    border: 1px solid #cc0000;
    transition: border-color 0.2s;
  }

  .cluster-link:hover {
    border-color: var(--color-accent);
  }

  .cluster-link__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .cluster-link__title a {
    color: inherit;
    text-decoration: none;
  }

  .cluster-link__title a:hover {
    text-decoration: underline;
    color: #cc0000;
  }

  .cluster-link__desc {
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .faq-item {
    border-bottom: 1px solid rgba(204, 0, 0, 0.25);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item__question {
    width: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    text-align: left;
    font-family: inherit;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }

  .faq-item__question:hover {
    color: #cc0000;
  }

  .faq-item__question[aria-expanded="true"] {
    color: #cc0000;
  }

  .faq-item__icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    color: #cc0000;
    line-height: 1;
    transition: transform 0.25s ease;
    width: 24px;
    text-align: center;
  }

  .faq-item__question[aria-expanded="true"] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding-bottom: 0;
  }

  .faq-item__answer:not([hidden]) {
    max-height: 600px;
    padding-bottom: 1.25rem;
  }

  .faq-item__answer[hidden] {
    display: block !important;
    max-height: 0;
    padding-bottom: 0;
  }

  .faq-item__answer p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.88rem;
    line-height: 1.8;
    margin: 0;
  }

  .cta-section {
    background: #000000;
    border-top: 2px solid #cc0000;
    border-bottom: 2px solid #cc0000;
    padding: 5rem 0;
  }

  .cta-section__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .cta-section__text {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .cta-section__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-section__subline {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    text-align: center;
    margin-top: 1.5rem;
  }

  .page-nav {
    position: fixed;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .page-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .page-nav__item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .page-nav__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(204, 0, 0, 0.5);
    transition: all 0.25s ease;
    cursor: pointer;
    position: relative;
  }

  .page-nav__dot:hover {
    background: #cc0000;
    border-color: #cc0000;
    transform: scale(1.4);
  }

  .page-nav__dot.active {
    background: #cc0000;
    border-color: #cc0000;
    width: 10px;
    height: 10px;
  }

  .page-nav__dot::after {
    content: attr(aria-label);
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    background: #000000;
    color: #ffffff;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border: 1px solid #cc0000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .page-nav__dot:hover::after {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .page-nav {
      display: none;
    }
  }

  .text-content {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 0.92rem;
    max-width: 800px;
  }

  .text-content p {
    margin-bottom: 1rem;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .cluster-links {
      grid-template-columns: 1fr;
    }

    .process-step {
      flex-direction: column;
    }

    .process-step__number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }

    .hero__title {
      font-size: clamp(1.6rem, 5vw, 2.4rem);
    }

    .section__title {
      font-size: clamp(1.4rem, 4vw, 2rem);
    }

    .table-wrap {
      margin: 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .stats-bar__item {
      padding: 1.25rem;
    }

    .stats-bar__value {
      font-size: 1.5rem;
    }

    .card {
      padding: 1.5rem;
    }

    .cluster-link {
      padding: 1.25rem;
    }

    .cta-group {
      flex-direction: column;
    }

    .cta-button--primary,
    .cta-button--secondary {
      text-align: center;
      width: 100%;
    }
  }

  /* Force dark mode always | this site is black/white/red by design */
  @media (prefers-color-scheme: light) {
    :root {
      --color-primary: #000000;
      --color-accent: #cc0000;
      --color-text: #ffffff;
      --color-bg: #000000;
      --color-bg-alt: #000000;
      --color-border: rgba(204,0,0,0.3);
    }
  }
</style>

<nav aria-label="Breadcrumb" class="breadcrumb">
  <p class="breadcrumb__text">
    <a href="/" class="breadcrumb__link">Home</a>
    <span class="breadcrumb__separator"> | </span>
    <a href="/pet-clothing-manufacturer/" class="breadcrumb__link">Pet Clothing Manufacturer</a>
    <span class="breadcrumb__separator"> | </span>
    Dog Hoodie Manufacturer
  </p>
</nav>

<section class="hero" id="section-hero">
  <div class="container">
    <p class="hero__eyebrow">300 pcs MOQ | GOTS Organic Option | GSM-Tested Fabric</p>
    <h1 class="hero__title">Dog Hoodie Manufacturer: Custom French Terry, Fleece & Organic Cotton, 300 Pieces</h1>
    <p class="hero__lead">
      Most dog hoodie listings say "soft fleece" and stop there. That tells you nothing about how the hoodie will actually perform | French terry and fleece are different fabrics with different GSM ranges, different warmth profiles, and different wear patterns over time. We'll tell you which one fits your climate target before you commit to a sample, and if your hoodie needs a harness hole, we place it where the D-ring actually sits during movement, not where it looks right on a still dog.
    </p>
    
    <div class="stats-bar">
      <div class="stats-bar__item">
        <div class="stats-bar__value">300</div>
        <div class="stats-bar__label">pcs / Minimum Per Style</div>
      </div>
