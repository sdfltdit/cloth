---
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../../../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../../../data/schema';
export const prerender = true;

const pageTitle = "How to Start Pet Clothing Brand | Guide SDF";
const pageDescription = "Learn how to start a pet clothing brand. Covers dog apparel design, manufacturing sourcing, brand development, and launch strategy for pet businesses.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Pet Clothing Manufacturer",
            "item": "https://sdfltd.com/pet-clothing-manufacturer/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "How to Start a Pet Clothing Brand",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the first steps to start a pet clothing brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "First steps include market research to identify your niche and target audience, developing a unique brand concept, creating initial designs, sourcing a reliable manufacturer, and establishing business structure. Start with a focused product line rather than trying to offer everything. Research competitors, identify gaps in the market, and develop a clear brand identity that differentiates your pet clothing business."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find a pet clothing manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Finding a pet clothing manufacturer involves researching potential partners, requesting samples, comparing pricing and capabilities, and verifying quality standards. Look for manufacturers with pet clothing experience, reasonable minimum orders, and good communication. Request samples to assess quality before committing. Consider location, shipping costs, and production capacity in your decision."
          }
        },
        {
          "@type": "Question",
          "name": "What are the startup costs for a pet clothing brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Startup costs include design development ($500-2,000), samples ($200-500), initial production ($3,000-10,000 for 300 pieces), branding and packaging ($500-2,000), website and e-commerce setup ($500-3,000), and marketing budget ($1,000-5,000). Total startup costs typically range from $5,000-25,000 depending on product complexity and initial order volume."
          }
        },
        {
          "@type": "Question",
          "name": "How do I design pet clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pet clothing design requires understanding pet anatomy, sizing across breeds, safety requirements, and functional needs. Start with sketches and create tech packs with measurements. Consider pet-specific features like harness openings, leash access, and easy on-off design. Test prototypes on actual pets to verify fit and comfort. Design for the pet's needs first, aesthetics second."
          }
        },
        {
          "@type": "Question",
          "name": "What are the legal requirements for pet clothing brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Legal requirements include business registration (LLC or corporation), sales tax registration, business insurance, compliance with pet product safety regulations, and proper labeling. Import requirements apply if manufacturing internationally. Consult with legal and accounting professionals to ensure compliance. Trademark your brand name and logos for protection."
          }
        },
        {
          "@type": "Question",
          "name": "How do I market my pet clothing brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Marketing strategies include building a strong social media presence featuring pets wearing your clothing, partnering with pet influencers, participating in pet events and shows, content marketing about pet care and fashion, email marketing to customers, and paid advertising targeting pet owners. Focus on the emotional bond between pets and owners in your marketing."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Start a Pet Clothing Brand",
      "description": "Step-by-step guide to launching a successful pet clothing business",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Conduct Market Research",
          "text": "Research the pet clothing market, identify competitors, find your niche, and understand your target audience"
        },
        {
          "@type": "HowToStep",
          "name": "Develop Brand Concept",
          "text": "Create brand identity, develop unique value proposition, and define brand positioning"
        },
        {
          "@type": "HowToStep",
          "name": "Design Initial Products",
          "text": "Create pet clothing designs considering anatomy, sizing, safety, and functionality"
        },
        {
          "@type": "HowToStep",
          "name": "Source Manufacturer",
          "text": "Find and vet pet clothing manufacturers, request samples, and negotiate production"
        },
        {
          "@type": "HowToStep",
          "name": "Launch and Market",
          "text": "Set up e-commerce, execute marketing strategy, and begin selling pet clothing"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/pet-clothing-manufacturer/index">Pet Clothing Manufacturer</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">How to Start a Pet Clothing Brand</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Pet Brand Launch • Since 1998 • Business Development Specialists</div>
        <h1 class="hero__title">How to Start a Pet Clothing Brand • Dog Apparel Business Guide</h1>
        <p class="hero__description">
          SDF Clothing provides complete guide on how to start a pet clothing brand. Dog apparel business steps, pet brand development, manufacturing sourcing, pet clothing design, brand launch strategy, and growing your pet clothing business.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20want%20to%20start%20a%20pet%20clothing%20brand`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">$5K-25K</span>
          <span class="hero__stat-label">Startup Cost</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">Full</span>
          <span class="hero__stat-label">Support</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Market Research</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Brand Development</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Manufacturing Sourcing</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>Launch Strategy</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">First Steps</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Starting Your Pet Clothing Brand</h2>
      </div>
      <div class="section__text">
        <p>Starting a pet clothing brand begins with thorough market research and strategic planning. The pet apparel market is growing as pet owners increasingly treat their pets as family members, investing in clothing that reflects their lifestyle and values. Success requires understanding this market, identifying your niche, and developing a unique brand concept.</p>
        
        <p>Market research should identify your target audience—are you targeting luxury pet owners, practical outdoor enthusiasts, or eco-conscious consumers? Analyze competitors to find gaps in the market where your brand can differentiate. Research pricing strategies, popular styles, and emerging trends. Understanding the market landscape informs your brand positioning and product development decisions.</p>
        
        <p>Brand development creates the foundation for your pet clothing business. Define your brand values, mission, and unique selling proposition. Your brand should resonate emotionally with pet owners who view their pets as family members. Develop a brand name, logo, and visual identity that communicates your positioning consistently across all touchpoints.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Manufacturing Sourcing</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Finding a Pet Clothing Manufacturer</h2>
      </div>
      <div class="section__text">
        <p>Manufacturing sourcing is critical to pet clothing brand success. The right manufacturer delivers quality products on time at competitive prices. Finding a manufacturer involves research, vetting, and building a relationship that supports your brand's growth. Consider experience, capabilities, communication, and reliability in your selection.</p>
        
        <p>Start by researching manufacturers with specific pet clothing experience. Pet clothing has unique requirements different from human apparel—sizing across breeds, safety considerations, and specialized construction. Manufacturers with pet clothing experience understand these nuances and can provide valuable guidance during development.</p>
        
        <p>Request samples to assess quality, construction, and finish. Samples reveal manufacturer capabilities and help you evaluate whether their work meets your standards. Compare pricing, minimum orders, and lead times across multiple manufacturers. Consider total cost including shipping, customs, and potential delays. Communication responsiveness and language compatibility are essential for smooth collaboration.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Startup Costs</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pet Clothing Brand Startup Costs</h2>
      </div>
      <div class="section__text">
        <p>Understanding startup costs enables realistic financial planning and ensures you have adequate capital to launch successfully. Startup costs vary based on product complexity, initial order volume, and brand investment level. Planning for all costs prevents cash flow issues during the critical launch phase.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Cost Category</th>
              <th>Low End</th>
              <th>High End</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Design Development</td>
              <td>$500</td>
              <td>$2,000</td>
              <td>Professional design, tech packs</td>
            </tr>
            <tr>
              <td>Samples</td>
              <td>$200</td>
              <td>$500</td>
              <td>Proto and fit samples</td>
            </tr>
            <tr>
              <td>Initial Production</td>
              <td>$3,000</td>
              <td>$10,000</td>
              <td>300 pieces at $10-30 each</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Branding & Packaging</td>
              <td>$500</td>
              <td>$2,000</td>
              <td>Labels, hang tags, packaging</td>
            </tr>
            <tr>
              <td>Website & E-commerce</td>
              <td>$500</td>
              <td>$3,000</td>
              <td>Website setup, payment processing</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Marketing Budget</td>
              <td>$1,000</td>
              <td>$5,000</td>
              <td>Social media, advertising, content</td>
            </tr>
          </tbody>
          <caption>Total startup costs typically range from $5,000-25,000. Start lean and scale investment as sales grow.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Pet Clothing Design</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Designing Pet Clothing</h2>
      </div>
      <div class="section__text">
        <p>Pet clothing design requires specialized understanding of pet anatomy, breed variations, safety requirements, and functional needs. Unlike human clothing, pet garments must accommodate unique body shapes, allow natural movement, and include features like harness openings and leash access. Design prioritizes pet comfort and safety while maintaining aesthetic appeal.</p>
        
        <p>Start with sketches and develop detailed tech packs specifying measurements, materials, and construction details. Consider sizing across different breeds—bulldogs need different proportions than greyhounds. Breed-specific patterns accommodate these variations. Safety considerations include avoiding small parts that could be chewed off, ensuring secure closures, and using breathable materials.</p>
        
        <p>Test prototypes on actual pets to verify fit, comfort, and functionality. Watch how the garment moves with the pet during normal activities. Check for restriction of movement, irritation points, or potential hazards. Iterate design based on testing feedback before committing to production. Pet comfort is paramount—uncomfortable clothing will not be worn regardless of how it looks.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Legal Requirements</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Legal Requirements for Pet Brands</h2>
      </div>
      <div class="section__text">
        <p>Legal compliance protects your business and ensures smooth operations. Pet clothing brands must address business registration, tax compliance, product safety regulations, and intellectual property protection. Consulting with legal and accounting professionals ensures you meet all requirements and avoid costly mistakes.</p>
        
        <p>Business registration typically involves forming an LLC or corporation to protect personal assets from business liability. Register your business name and obtain necessary licenses and permits. Sales tax registration is required for e-commerce sales in most jurisdictions. Business insurance including general liability and product liability protects against potential claims.</p>
        
        <p>Product safety regulations vary by market but generally include requirements for materials, labeling, and testing. Ensure your products meet applicable safety standards for pet products. Import requirements apply if manufacturing internationally, including customs duties, documentation, and compliance with import regulations. Trademark your brand name and logos for intellectual property protection.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Brand Launch</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Launching Your Pet Clothing Brand</h2>
      </div>
      <div class="section__text">
        <p>A successful brand launch creates momentum and establishes your presence in the pet clothing market. Launch strategy should build anticipation, generate initial sales, and collect customer feedback for continuous improvement. A well-executed launch positions your brand for sustainable growth.</p>
        
        <p>Build anticipation through social media marketing before launch. Share behind-the-scenes content about design development, manufacturing progress, and the story behind your brand. Create email waitlists to capture interested customers. Partner with pet influencers for launch-day promotion. Consider a soft launch with limited quantities to test the market before full rollout.</p>
        
        <p>Launch day activities include social media announcements, email marketing to your waitlist, influencer posts, and potentially launch promotions or limited-time offers. Monitor launch performance closely—track sales, website traffic, customer feedback, and social media engagement. Use launch data to optimize marketing strategies and product offerings for sustained growth.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Marketing Strategy</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Marketing Your Pet Clothing Brand</h2>
      </div>
      <div class="section__text">
        <p>Marketing your pet clothing brand requires understanding the emotional bond between pets and owners. Successful marketing taps into this relationship, positioning your brand as part of the pet's life and the owner's expression of care. Multiple marketing channels working together create brand awareness and drive sales.</p>
        
        <p>Social media marketing is essential for pet brands. Instagram and TikTok are particularly effective for visual pet content. Post engaging photos and videos of pets wearing your clothing. Encourage user-generated content by featuring customer pets. Partner with pet influencers who have engaged followings. Social media builds community and brand loyalty.</p>
        
        <p>Content marketing positions your brand as an authority in pet care and fashion. Create blog content about pet health, training tips, and fashion advice. Email marketing nurtures customer relationships with exclusive offers and content. Paid advertising on social media and search engines reaches new customers. Participate in pet events, dog shows, and local pet community activities for offline presence.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How to Start a Pet Clothing Brand FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What are the first steps to start a pet clothing brand?</h3>
          <p class="faq__answer">First steps include market research to identify your niche and target audience, developing a unique brand concept, creating initial designs, sourcing a reliable manufacturer, and establishing business structure. Start with a focused product line rather than trying to offer everything. Research competitors, identify gaps in the market, and develop a clear brand identity that differentiates your pet clothing business.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do I find a pet clothing manufacturer?</h3>
          <p class="faq__answer">Finding a pet clothing manufacturer involves researching potential partners, requesting samples, comparing pricing and capabilities, and verifying quality standards. Look for manufacturers with pet clothing experience, reasonable minimum orders, and good communication. Request samples to assess quality before committing. Consider location, shipping costs, and production capacity in your decision.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What are the startup costs for a pet clothing brand?</h3>
          <p class="faq__answer">Startup costs include design development ($500-2,000), samples ($200-500), initial production ($3,000-10,000 for 300 pieces), branding and packaging ($500-2,000), website and e-commerce setup ($500-3,000), and marketing budget ($1,000-5,000). Total startup costs typically range from $5,000-25,000 depending on product complexity and initial order volume.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do I design pet clothing?</h3>
          <p class="faq__answer">Pet clothing design requires understanding pet anatomy, sizing across breeds, safety requirements, and functional needs. Start with sketches and create tech packs with measurements. Consider pet-specific features like harness openings, leash access, and easy on-off design. Test prototypes on actual pets to verify fit and comfort. Design for the pet's needs first, aesthetics second.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What are the legal requirements for pet clothing brands?</h3>
          <p class="faq__answer">Legal requirements include business registration (LLC or corporation), sales tax registration, business insurance, compliance with pet product safety regulations, and proper labeling. Import requirements apply if manufacturing internationally. Consult with legal and accounting professionals to ensure compliance. Trademark your brand name and logos for protection.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How do I market my pet clothing brand?</h3>
          <p class="faq__answer">Marketing strategies include building a strong social media presence featuring pets wearing your clothing, partnering with pet influencers, participating in pet events and shows, content marketing about pet care and fashion, email marketing to customers, and paid advertising targeting pet owners. Focus on the emotional bond between pets and owners in your marketing.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Start Your Pet Clothing Brand?</h2>
      <p class="section__text">
        Contact SDF Clothing for pet clothing manufacturing support. We help pet brands with design development, production, and scaling for successful pet clothing business launch.
      </p>
      <div class="section__ctas">
        <a href="/contact" class="section__cta section__cta--primary">Get Free Quote</a>
        <a href="/pet-clothing-manufacturer/index" class="section__cta section__cta--secondary">Pet Clothing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <p class="section__text--small">
        Related pages: <a href="/pet-clothing-manufacturer/dog-hoodie-manufacturer/index" style="color: var(--color-primary);">dog hoodie manufacturer</a>, <a href="/pet-clothing-manufacturer/private-label-pet-clothing/index" style="color: var(--color-primary);">private label pet clothing</a>, <a href="/clothing-manufacturers-for-startups" style="color: var(--color-primary);">clothing manufacturers for startups</a>, <a href="/clothing-manufacturer-bangladesh" style="color: var(--color-primary);">clothing manufacturer Bangladesh</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin: 0 var(--spacing-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .hero__stat {
    text-align: center;
  }

  .hero__stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero__stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero__ctas {
    display: flex;
    gap: var(--spacing-sm);
  }

  .hero__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .hero__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .hero__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
