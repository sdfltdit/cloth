---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Dog Coat Manufacturer | Custom Waterproof & Fleece Coats, 300 MOQ";
const pageDescription = "Custom dog coat manufacturer with breed-specific sizing and tested waterproofing — rain shells, fleece coats, puffer jackets from 300 pcs. Free sample.";
const ogImage = "/og/dog-coat-manufacturer.svg";
const dateModified = new Date().toISOString().split('T')[0];
const foundedDate = new Date('1998-08-22');
const today = new Date();
let yearsExp = today.getFullYear() - foundedDate.getFullYear();
const hasPassedAnniversary = (today.getMonth() > foundedDate.getMonth()) || (today.getMonth() === foundedDate.getMonth() && today.getDate() >= foundedDate.getDate());
if (!hasPassedAnniversary) yearsExp -= 1;
const experienceYears = yearsExp;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sdfltd.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pet Clothing Manufacturer",
      "item": "https://sdfltd.com/pet-clothing-manufacturer/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Dog Coat Manufacturer",
      "item": "https://sdfltd.com/pet-clothing-manufacturer/dog-coat-manufacturer/"
    }
  ]
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": "https://sdfltd.com/pet-clothing-manufacturer/dog-coat-manufacturer/#webpage",
  "url": "https://sdfltd.com/pet-clothing-manufacturer/dog-coat-manufacturer/",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "en-GB",
  "datePublished": "2025-02-01",
  "dateModified": dateModified,
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "url": "https://sdfltd.com/about/"
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://sdfltd.com/#website",
    "url": "https://sdfltd.com",
    "name": "SDF Clothing"
  }
};

const articleSchema = {
  "@type": "Article",
  "headline": "Dog Coat Manufacturer | Custom Waterproof & Fleece Coats from 300 Pieces",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SDF Clothing",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sdfltd.com/images/sdf.jpg"
    }
  },
  "datePublished": "2025-02-01",
  "dateModified": dateModified
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the minimum order quantity for custom dog coats?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "300 pieces per style. That number can be split across sizes within one design | for example 60 extra small, 100 small, 100 medium, 40 large still counts as one style at 300 units. A separate colourway of the same pattern is usually treated as the same style, but a different fabric or a different cut counts as a new style."
      }
    },
    {
      "@type": "Question",
      "name": "What waterproof rating should a dog rain coat have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "3,000mm water column rating handles light to moderate rain and is the minimum we recommend for any coat marketed as waterproof. 5,000mm or higher holds up in sustained heavy rain and is what we use for premium outdoor lines. Anything under 1,500mm is closer to water-resistant than waterproof and should not be marketed as a rain coat."
      }
    },
    {
      "@type": "Question",
      "name": "How do you size dog coats for different breeds?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We grade by chest girth and back length together, not by weight alone. A Dachshund and a French Bulldog can weigh the same but need completely different proportions | long, narrow body versus short, broad chest. Breed-specific blocks for short-back, deep-chest, and standard proportions are available on request at no extra pattern cost."
      }
    },
    {
      "@type": "Question",
      "name": "Velcro, buckle, or snap closure | which is best for dog coats?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Velcro is fastest to put on but wears out after roughly 300 to 500 open-close cycles and snags on long-haired breeds. Side-release buckles last longer and adjust precisely but take a few seconds more to fasten. Snap closures sit in between on speed and durability. We recommend buckles for daily-wear coats and velcro only for occasional-use or costume pieces."
      }
    },
    {
      "@type": "Question",
      "name": "How long does dog coat sampling take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "7 to 14 calendar days from a confirmed design brief, depending on whether the fabric is in stock or needs sourcing. Sampling is free and we revise up to 10 times at no extra charge. Bulk cutting does not start until you approve the final sample in writing."
      }
    }
  ]
};

const howToSchema = {
  "@type": "HowTo",
  "name": "How to Order Custom Dog Coats from SDF Clothing",
  "totalTime": "PT45D",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Send Your Design and Spec",
      "text": "Submit a sketch, reference photo, or written description through the sample request form. Tell us the target breed size range, fabric type, closure preference, and waterproofing needs if any.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Receive Fabric Options and Quote",
      "text": "We respond within one business day with fabric recommendations matched to your use case, a per-unit cost estimate, and sample plus bulk lead times.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Approve the Sample",
      "text": "Sample production takes 7 to 14 days. You receive physical samples to check fit across your size range, fabric hand-feel, stitching, and hardware. Free revisions until you sign off.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Confirm Bulk Order",
      "text": "Place your PO from 300 pieces per style, split across sizes as needed. 30% deposit starts cutting, 70% balance due before shipment.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Inspection and Shipping",
      "text": "Final AQL inspection runs before packing. Fabric test reports, packing list, and commercial invoice ship with the order. Chittagong port for sea freight, Dhaka airport for air.",
      "url": "https://sdfltd.com/sample-request/"
    }
  ]
};

const pageSchema = [breadcrumbSchema, webPageSchema, articleSchema, faqSchema, howToSchema];
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}

  ogImage={ogImage}
  datePublished="2025-02-01"
  dateModified={dateModified}
  schema={pageSchema}
>

<meta name="robots" content="index, follow" />

<style>
  /* Force this page to always render dark */
  :global(html),
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  :root {
    --color-primary: #000000;
    --color-accent: #cc0000;
    --color-text: #ffffff;
    --color-bg: #000000;
    --color-bg-alt: #111111;
    --color-border: #333333;
  }

  /* Force black background regardless of OS light/dark mode */
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .card,
  .cluster-link,
  .stats-bar__item {
    --color-bg-alt: #000000;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-accent);
  }

  .section__label {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .section__subtitle {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .accent-line {
    width: 60px;
    height: 2px;
    background: var(--color-accent);
    margin: 0 auto 1.5rem;
  }

  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--color-accent);
  }

  .hero__eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 200;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__lead {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: transparent;
    margin: 2rem 0;
  }

  .stats-bar__item {
    background: #000000;
    border: 1px solid rgba(204, 0, 0, 0.3);
    padding: 2rem;
    text-align: center;
  }

  .stats-bar__value {
    font-size: 2rem;
    font-weight: 200;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .stats-bar__label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.7;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .cta-button--primary {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cta-button--primary:hover {
    background: #990000;
  }

  .cta-button--secondary {
    background: transparent;
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--color-text);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .cta-button--secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .hero__svg {
    width: 100%;
    height: auto;
    max-width: 580px;
    display: block;
    margin: 3rem auto 0;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb__text {
    font-size: 0.72rem;
    color: var(--color-text);
  }

  .breadcrumb__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .breadcrumb__separator {
    margin: 0 0.5rem;
    color: #cc0000;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  thead {
    background: #cc0000;
  }

  thead th {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  td, th {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(204, 0, 0, 0.2);
  }

  tbody tr:nth-child(even) {
    background: #0a0a0a;
  }

  .comparison-table td:nth-child(2) {
    opacity: 0.6;
  }

  .comparison-table td:nth-child(3) {
    background: rgba(204, 0, 0, 0.1);
  }

  .check--green {
    color: #22c55e;
  }

  .check--red {
    color: #ef4444;
  }

  .check--amber {
    color: #f59e0b;
  }

  .product-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 0;
    max-width: 700px;
  }

  .product-list__item {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.9;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .product-list__item::before {
    content: " | ";
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }

  .product-list--two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
    justify-items: center;
  }

  @media (max-width: 640px) {
    .product-list--two-col {
      grid-template-columns: 1fr;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    background: transparent;
  }

  .card {
    background: #000000;
    border: 1px solid #cc0000;
    padding: 2rem;
    min-height: 200px;
  }

  .card__title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .card__text {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .process-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .process-step__number {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .process-step__content {
    flex: 1;
  }

  .process-step__title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .process-step__text {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.7;
    text-align: center;
  }

  .cluster-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .cluster-link {
    background: #000000;
    padding: 1.5rem;
    border: 1px solid #cc0000;
    transition: border-color 0.2s;
  }

  .cluster-link:hover {
    border-color: var(--color-accent);
  }

  .cluster-link__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .cluster-link__title a {
    color: inherit;
    text-decoration: none;
  }

  .cluster-link__title a:hover {
    text-decoration: underline;
    color: #cc0000;
  }

  .cluster-link__desc {
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .faq-item {
    border-bottom: 1px solid rgba(204, 0, 0, 0.25);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item__question {
    width: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    text-align: left;
    font-family: inherit;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }

  .faq-item__question:hover {
    color: #cc0000;
  }

  .faq-item__question[aria-expanded="true"] {
    color: #cc0000;
  }

  .faq-item__icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    color: #cc0000;
    line-height: 1;
    transition: transform 0.25s ease;
    width: 24px;
    text-align: center;
  }

  .faq-item__question[aria-expanded="true"] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding-bottom: 0;
  }

  .faq-item__answer:not([hidden]) {
    max-height: 600px;
    padding-bottom: 1.25rem;
  }

  .faq-item__answer[hidden] {
    display: block !important;
    max-height: 0;
    padding-bottom: 0;
  }

  .faq-item__answer p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.88rem;
    line-height: 1.8;
    margin: 0;
  }

  .cta-section {
    background: #000000;
    border-top: 2px solid #cc0000;
    border-bottom: 2px solid #cc0000;
    padding: 5rem 0;
  }

  .cta-section__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .cta-section__text {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .cta-section__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-section__subline {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    text-align: center;
    margin-top: 1.5rem;
  }

  .page-nav {
    position: fixed;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .page-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .page-nav__item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .page-nav__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(204, 0, 0, 0.5);
    transition: all 0.25s ease;
    cursor: pointer;
    position: relative;
  }

  .page-nav__dot:hover {
    background: #cc0000;
    border-color: #cc0000;
    transform: scale(1.4);
  }

  .page-nav__dot.active {
    background: #cc0000;
    border-color: #cc0000;
    width: 10px;
    height: 10px;
  }

  .page-nav__dot::after {
    content: attr(aria-label);
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    background: #000000;
    color: #ffffff;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border: 1px solid #cc0000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .page-nav__dot:hover::after {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .page-nav {
      display: none;
    }
  }

  .text-content {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 0.92rem;
    max-width: 800px;
  }

  .text-content p {
    margin-bottom: 1rem;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .cluster-links {
      grid-template-columns: 1fr;
    }

    .process-step {
      flex-direction: column;
    }

    .process-step__number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }

    .hero__title {
      font-size: clamp(1.6rem, 5vw, 2.4rem);
    }

    .section__title {
      font-size: clamp(1.4rem, 4vw, 2rem);
    }

    .table-wrap {
      margin: 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .stats-bar__item {
      padding: 1.25rem;
    }

    .stats-bar__value {
      font-size: 1.5rem;
    }

    .card {
      padding: 1.5rem;
    }

    .cluster-link {
      padding: 1.25rem;
    }

    .cta-group {
      flex-direction: column;
    }

    .cta-button--primary,
    .cta-button--secondary {
      text-align: center;
      width: 100%;
    }
  }

  /* Force dark mode always | this site is black/white/red by design */
  @media (prefers-color-scheme: light) {
    :root {
      --color-primary: #000000;
      --color-accent: #cc0000;
      --color-text: #ffffff;
      --color-bg: #000000;
      --color-bg-alt: #000000;
      --color-border: rgba(204,0,0,0.3);
    }
  }
</style>

<nav aria-label="Breadcrumb" class="breadcrumb">
  <p class="breadcrumb__text">
    <a href="/" class="breadcrumb__link">Home</a>
    <span class="breadcrumb__separator"> | </span>
    <a href="/pet-clothing-manufacturer/" class="breadcrumb__link">Pet Clothing Manufacturer</a>
    <span class="breadcrumb__separator"> | </span>
    Dog Coat Manufacturer
  </p>
</nav>

<section class="hero" id="section-hero">
  <div class="container">
    <p class="hero__eyebrow">300 pcs MOQ | 3,000mm+ Waterproof Tested | OEKO-TEX Certified</p>
    <h1 class="hero__title">Dog Coat Manufacturer: Custom Rain Shells, Fleece Coats & Puffer Jackets from 300 Pieces</h1>
    <p class="hero__lead">
      Most dog coat suppliers will quote you a price before they ask what breed it's for. That's backwards. A Dachshund coat and a French Bulldog coat need different chest girth ratios even at the same weight class | get that wrong and your return rate climbs fast. We pattern by body type first, then talk fabric and price. Coats ship with a lab test report for water column rating, GSM, and shrinkage, so "waterproof" and "warm" mean something specific instead of just sounding good on a product page.
    </p>
    
    <div class="stats-bar">
      <div class="stats-bar__item">
        <div class="stats-bar__value">300</div>
        <div class="stats-bar__label">pcs / Minimum Per Style</div>
