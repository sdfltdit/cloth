---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Custom Pet Clothing Manufacturer | Low MOQ & Certified";
const pageDescription = "Certified custom pet clothing manufacturer. Dog coats, cat apparel & animal wear from 300 pcs MOQ. GOTS & OEKO-TEX certified. Get a free sample quote.";
const ogImage = "/og/pet-clothing-manufacturer.svg";
const dateModified = new Date().toISOString().split('T')[0];
const foundedDate = new Date('1998-08-22');
const today = new Date();
let yearsExp = today.getFullYear() - foundedDate.getFullYear();
const hasPassedAnniversary = (today.getMonth() > foundedDate.getMonth()) || (today.getMonth() === foundedDate.getMonth() && today.getDate() >= foundedDate.getDate());
if (!hasPassedAnniversary) yearsExp -= 1;
const experienceYears = yearsExp;

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sdfltd.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pet Clothing Manufacturer",
      "item": "https://sdfltd.com/pet-clothing-manufacturer/"
    }
  ]
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": "https://sdfltd.com/pet-clothing-manufacturer/#webpage",
  "url": "https://sdfltd.com/pet-clothing-manufacturer/",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "en-GB",
  "datePublished": "2025-01-01",
  "dateModified": dateModified,
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "url": "https://sdfltd.com/about/"
  },
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://sdfltd.com/#website",
    "url": "https://sdfltd.com",
    "name": "SDF Clothing"
  }
};

const articleSchema = {
  "@type": "Article",
  "headline": "How to Find the Best Custom Pet Clothing Manufacturer with Low MOQ",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SDF Clothing",
    "logo": {
      "@type": "ImageObject",
      "url": "https://sdfltd.com/images/sdf.jpg"
    }
  },
  "datePublished": "2025-01-01",
  "dateModified": dateModified
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the minimum order quantity for custom pet clothing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The minimum order quantity is 300 pieces per style for bulk production. For sampling, you can order 1 to 5 pieces per design. This lets you evaluate quality, sizing, and fabric before making any bulk commitment. Most certified manufacturers require 1,000 or more | SDF starts at 300."
      }
    },
    {
      "@type": "Question",
      "name": "What types of pet clothing can I manufacture with low MOQ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can manufacture the full range | dog coats, hoodies, raincoats, puffer jackets, shirts, pajamas, compression wraps, cat sweaters, recovery suits, equestrian quarter sheets, horse rugs, small animal clothing, and branded pet accessories. All product types are available from 300 pieces per style."
      }
    },
    {
      "@type": "Question",
      "name": "How long does pet clothing sampling take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sample production takes 7 to 14 calendar days from design approval and fabric confirmation. You receive physical samples at your address and evaluate fit, stitching quality, hardware, and label placement before approving anything for bulk production."
      }
    },
    {
      "@type": "Question",
      "name": "What is the lead time for bulk pet clothing orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bulk orders are delivered within 40 days from sample approval and purchase order confirmation. The on-time delivery rate across all product categories including pet apparel is 98%."
      }
    },
    {
      "@type": "Question",
      "name": "Is custom pet clothing safe for animals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, when manufactured correctly. All fabrics used in SDF production are tested under OEKO-TEX Standard 100, which checks for more than 100 harmful substances. GOTS certification adds another layer | ensuring no toxic dyes or chemical finishes enter the supply chain at any stage."
      }
    },
    {
      "@type": "Question",
      "name": "Can I launch a private label pet clothing brand with low MOQ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Private label is standard on all SDF orders regardless of quantity. This includes custom woven labels, printed care labels, hang tags, branded poly bags, and custom shipper boxes. Your brand is on the product from day one | not added as an afterthought."
      }
    },
    {
      "@type": "Question",
      "name": "Which countries do you export custom pet clothing to?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pet apparel is exported to brands and retailers across the USA, UK, Canada, Australia, Germany, France, the Netherlands, Sweden, Japan, and other markets worldwide. All export documentation, certifications, and REACH compliance declarations are included with every shipment."
      }
    },
    {
      "@type": "Question",
      "name": "What certifications does SDF Clothing hold for pet apparel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SDF holds 13 active certifications: GOTS, OEKO-TEX Standard 100, ISO 9001, BSCI, SEDEX, GRS, OCS, RCS, C-TPAT, WRAP, SA8000, ISO 14001, and BCI. These cover chemical safety, labour standards, environmental compliance, recycled content traceability, and quality management."
      }
    },
    {
      "@type": "Question",
      "name": "How do you size pet clothing for breeds with different body shapes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each species and body type uses its own pattern block rather than a single scaled template. For dogs, a French Bulldog and a Dachshund at the same weight have different chest, neck, and back proportions. For cats, a Maine Coon needs more shoulder ease than a domestic shorthair the same length. For horses, rugs size by height at the withers rather than weight or breed. We grade dedicated blocks per body type on request, at no extra pattern cost."
      }
    },
    {
      "@type": "Question",
      "name": "What fabric tests do you run before bulk production?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every fabric batch is tested for water column rating (waterproofing), GSM (insulation weight), shrinkage after three wash cycles, colour fastness for dye bleeding, and pilling resistance. Lab test reports are provided with the shipment so you can verify the specs rather than rely on marketing claims."
      }
    },
    {
      "@type": "Question",
      "name": "Can I order sustainable or organic pet clothing with certification?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. GOTS certification covers organic cotton from fibre to finished garment. GRS covers recycled polyester fill and outer fabric. BCI covers Better Cotton sourcing. Every sustainability claim is backed by a named, auditable certification | not a self-declared eco-friendly label."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get started with a custom pet clothing manufacturer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The easiest start is submitting a sample request with your design idea, target animal, size range, and preferred fabric. The production team responds within one business day with a quote and timeline. No bulk commitment is required at the sample stage. Start here | /sample-request/"
      }
    }
  ]
};

const howToSchema = {
  "@type": "HowTo",
  "name": "How to Order Custom Pet Clothing from SDF Clothing",
  "totalTime": "PT50D",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Submit Your Design Brief",
      "text": "Submit your design brief through the sample request form. Include sketch or reference photo, target animal and size range, fabric preference, hardware type, quantity estimate, and whether you need private label packaging.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Get Quote",
      "text": "Receive your quote within one business day. Quote includes fabric options, unit cost at target quantity, sampling fee, and both sample and bulk lead times.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Sample Production",
      "text": "Sample production takes 7 to 14 calendar days. You receive 1 to 5 physical samples per design. Evaluate fit, stitching, fabric feel, hardware, and label placement before bulk commitment.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Place Bulk Order",
      "text": "Place your bulk order from 300 pieces. PO confirmation starts production. Inline quality checks run through the production run. Capacity: 50,000 pcs per style per month.",
      "url": "https://sdfltd.com/sample-request/"
    },
    {
      "@type": "HowToStep",
      "name": "Inspection and Ship",
      "text": "Final AQL inspection before packing. Ship to freight forwarder or direct warehouse. Full documentation: packing list, commercial invoice, certifications, and test reports included.",
      "url": "https://sdfltd.com/sample-request/"
    }
  ]
};

const pageSchema = [breadcrumbSchema, webPageSchema, articleSchema, faqSchema, howToSchema];
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}

  ogImage={ogImage}
  datePublished="2025-01-01"
  dateModified={dateModified}
  schema={pageSchema}
>

<meta name="robots" content="index, follow" />

<style>
  /* Force this page to always render dark */
  :global(html),
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  :root {
    --color-primary: #000000;
    --color-accent: #cc0000;
    --color-text: #ffffff;
    --color-bg: #000000;
    --color-bg-alt: #111111;
    --color-border: #333333;
  }

  /* Force black background regardless of OS light/dark mode */
  :global(body) {
    background-color: #000000 !important;
    color: #ffffff !important;
  }

  .card,
  .cluster-link,
  .stats-bar__item {
    --color-bg-alt: #000000;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--color-accent);
  }

  .section__label {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 1rem;
  }

  .section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section__title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .section__subtitle {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 400;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .accent-line {
    width: 60px;
    height: 2px;
    background: var(--color-accent);
    margin: 0 auto 1.5rem;
  }

  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--color-accent);
  }

  .hero__eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 200;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero__lead {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: transparent;
    margin: 2rem 0;
  }

  .stats-bar__item {
    background: #000000;
    border: 1px solid rgba(204, 0, 0, 0.3);
    padding: 2rem;
    text-align: center;
  }

  .stats-bar__value {
    font-size: 2rem;
    font-weight: 200;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .stats-bar__label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    opacity: 0.7;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .cta-button--primary {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cta-button--primary:hover {
    background: #990000;
  }

  .cta-button--secondary {
    background: transparent;
    color: var(--color-text);
    padding: 0.75rem 2rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--color-text);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .cta-button--secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .hero__svg {
    width: 100%;
    height: auto;
    max-width: 580px;
    display: block;
    margin: 3rem auto 0;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb__text {
    font-size: 0.72rem;
    color: var(--color-text);
  }

  .breadcrumb__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .breadcrumb__separator {
    margin: 0 0.5rem;
    color: #cc0000;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  thead {
    background: #cc0000;
  }

  thead th {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  td, th {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(204, 0, 0, 0.2);
  }

  tbody tr:nth-child(even) {
    background: #0a0a0a;
  }

  .comparison-table td:nth-child(2) {
    opacity: 0.6;
  }

  .comparison-table td:nth-child(3) {
    background: rgba(204, 0, 0, 0.1);
  }

  .check--green {
    color: #22c55e;
  }

  .check--red {
    color: #ef4444;
  }

  .check--amber {
    color: #f59e0b;
  }

  .product-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 0;
    max-width: 700px;
  }

  .product-list__item {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.9;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .product-list__item::before {
    content: " | ";
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }

  .product-list--two-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2rem;
    justify-items: center;
  }

  @media (max-width: 640px) {
    .product-list--two-col {
      grid-template-columns: 1fr;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    background: transparent;
  }

  .card {
    background: #000000;
    border: 1px solid #cc0000;
    padding: 2rem;
    min-height: 200px;
  }

  .card__title {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .card__text {
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .process-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .process-step__number {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .process-step__content {
    flex: 1;
  }

  .process-step__title {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .process-step__text {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.7;
    text-align: center;
  }

  .cluster-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .cluster-link {
    background: #000000;
    padding: 1.5rem;
    border: 1px solid #cc0000;
    transition: border-color 0.2s;
  }

  .cluster-link:hover {
    border-color: var(--color-accent);
  }

  .cluster-link__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .cluster-link__title a {
    color: inherit;
    text-decoration: none;
  }

  .cluster-link__title a:hover {
    text-decoration: underline;
    color: #cc0000;
  }

  .cluster-link__desc {
    color: var(--color-text);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .faq-item {
    border-bottom: 1px solid rgba(204, 0, 0, 0.25);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item__question {
    width: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    text-align: left;
    font-family: inherit;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }

  .faq-item__question:hover {
    color: #cc0000;
  }

  .faq-item__question[aria-expanded="true"] {
    color: #cc0000;
  }

  .faq-item__icon {
    flex-shrink: 0;
    font-size: 1.4rem;
    font-weight: 300;
    color: #cc0000;
    line-height: 1;
    transition: transform 0.25s ease;
    width: 24px;
    text-align: center;
  }

  .faq-item__question[aria-expanded="true"] .faq-item__icon {
    transform: rotate(45deg);
  }

  .faq-item__answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding-bottom: 0;
  }

  .faq-item__answer:not([hidden]) {
    max-height: 600px;
    padding-bottom: 1.25rem;
  }

  .faq-item__answer[hidden] {
    display: block !important;
    max-height: 0;
    padding-bottom: 0;
  }

  .faq-item__answer p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.88rem;
    line-height: 1.8;
    margin: 0;
  }

  .cta-section {
    background: #000000;
    border-top: 2px solid #cc0000;
    border-bottom: 2px solid #cc0000;
    padding: 5rem 0;
  }

  .cta-section__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .cta-section__text {
    color: var(--color-text);
    max-width: 640px;
    line-height: 1.8;
    font-size: 0.92rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .cta-section__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-section__subline {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    text-align: center;
    margin-top: 1.5rem;
  }

  .page-nav {
    position: fixed;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .page-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .page-nav__item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .page-nav__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(204, 0, 0, 0.5);
    transition: all 0.25s ease;
    cursor: pointer;
    position: relative;
  }

  .page-nav__dot:hover {
    background: #cc0000;
    border-color: #cc0000;
    transform: scale(1.4);
  }

  .page-nav__dot.active {
    background: #cc0000;
    border-color: #cc0000;
    width: 10px;
    height: 10px;
  }

  .page-nav__dot::after {
    content: attr(aria-label);
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    background: #000000;
    color: #ffffff;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border: 1px solid #cc0000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .page-nav__dot:hover::after {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .page-nav {
      display: none;
    }
  }

  .text-content {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 0.92rem;
    max-width: 800px;
  }

  .text-content p {
    margin-bottom: 1rem;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .cluster-links {
      grid-template-columns: 1fr;
    }

    .process-step {
      flex-direction: column;
    }

    .process-step__number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }

    .hero__title {
      font-size: clamp(1.6rem, 5vw, 2.4rem);
    }

    .section__title {
      font-size: clamp(1.4rem, 4vw, 2rem);
    }

    .table-wrap {
      margin: 1rem 0;
    }
  }

  @media (max-width: 480px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
