---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Pants Manufacturer | Custom Trousers & Chinos | SDF";
const pageDescription = "Custom pants manufacturer in Bangladesh. Chinos, trousers, joggers and cargo pants from 300 pieces. Private label ready. Request a free factory quote today.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Custom pants and trousers manufacturer from Bangladesh providing chinos, dress pants, casual trousers, and joggers to fashion brands worldwide since 1998."
    },
    {
      "@type": "Service",
      "serviceType": "Custom Pants and Trousers Manufacturing",
      "provider": { "@id": "https://sdfltd.com/#org" },
      "areaServed": ["US", "GB", "AU", "CA", "DE"],
      "description": "Custom pants manufacturer in Bangladesh. Chinos, trousers, joggers and cargo pants from 300 pieces. Private label ready. Request a free factory quote today."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Pants from SDF Clothing",
      "step": [
        { "@type": "HowToStep", "name": "Submit Design Brief", "text": "Share your pants design, fabric preferences, and fit requirements" },
        { "@type": "HowToStep", "name": "Receive Tech Pack and Quote", "text": "Our team prepares tech pack and factory quote within 48 hours" },
        { "@type": "HowToStep", "name": "Approve Pre-Production Sample", "text": "Review physical sample before bulk production begins" },
        { "@type": "HowToStep", "name": "Bulk Production and Inspection", "text": "Factory produces order with inline quality checks" },
        { "@type": "HowToStep", "name": "Shipment to Your Door", "text": "Order shipped FOB Dhaka or CIF your destination port" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for custom pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What types of pants do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture chinos, dress pants, casual trousers, joggers, cargo pants, linen pants, denim trousers, work pants, and athletic pants. Various fits including slim, regular, relaxed, and plus sizes."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics do you use for pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use cotton twill, cotton canvas, wool blends, polyester blends, linen, denim, stretch fabrics with elastane, and performance fabrics. Fabric selection depends on pant type and intended use."
          }
        },
        {
          "@type": "Question",
          "name": "Can you customize pants with different fits and details?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer custom fits (slim, regular, relaxed, plus), waistband styles, pocket configurations, hem finishes, and closure types. Custom details like pleats, cuffs, and decorative stitching available."
          }
        },
        {
          "@type": "Question",
          "name": "How long does pants production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 35-45 days from fabric receipt for basic pants. 40-55 days for custom fabric development or specialized fabrics. 7-14 days for sampling before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer stretch fabrics for pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer stretch fabrics with elastane/spandex for comfort and mobility. Popular for chinos, joggers, and casual trousers. Stretch content typically 2-5% for dress pants, 5-10% for casual wear."
          }
        },
        {
          "@type": "Question",
          "name": "What size ranges do you offer for pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer full size ranges from 28-inch waist to 42-inch waist with regular, short, and tall inseam options. Custom sizing available for specific brand requirements. Size run flexibility within MOQ enables balanced inventory distribution."
          }
        },
        {
          "@type": "Question",
          "name": "Can you manufacture custom waistbands and closures?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer various waistband styles including standard waistband, elastic waistband, drawstring waistband, and high-rise options. Closure options include button fly, zipper fly, snap buttons, and hook-and-bar. Custom belt loops and waistband lining available."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Pants Manufacturer",
          "item": Astro.url.href
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl.href}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="pants manufacturer, trousers manufacturer, chinos manufacturer, dress pants manufacturer, casual trousers manufacturer, joggers manufacturer, cargo pants manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Pants Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Custom Pants Manufacturer | Since 1998 | Various Fits</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Pants and Trousers Manufacturer for Fashion Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Pants and trousers require precise construction, quality fabrics, and attention to fit details. SDF Clothing manufactures custom pants in Bangladesh with professional tailoring and customization options. From 300 pieces per style with various fabrics, fits, and details.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20pants-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">4</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Fits Available</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">35-45</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Custom</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Details</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Pants Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our custom pants manufacturing covers the full production cycle from fabric sourcing to finished trousers. We source quality fabrics from certified mills, cut, sew with precise tailoring techniques, apply custom details, and package for shipment.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Production capacity: 35,000-50,000 pants per month across multiple production lines. We handle basic casual trousers for retail, premium dress pants for formal wear, and custom pants for specialty brands. Our <a href="/sampling-service" style="color:#e00;text-decoration:underline;">sampling service</a> ensures prototype quality before bulk production.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Fabric Options</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cotton Twill</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Durable woven fabric with diagonal rib pattern. Standard for chinos and casual trousers. Breathable, comfortable, and takes dye well. Available in various weights.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cotton Canvas</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Heavy-duty woven fabric for work pants and cargo pants. Extremely durable and abrasion-resistant. Ideal for utility and outdoor applications.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Wool Blends</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Premium fabric for dress pants and formal trousers. Wool-polyester blends offer drape, wrinkle resistance, and temperature regulation. Ideal for suits and business wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Polyester Blends</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Durable, wrinkle-resistant, and easy-care fabrics. Polyester-cotton blends combine natural comfort with synthetic durability. Popular for uniform and casual pants.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Linen</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Lightweight, breathable natural fiber for summer trousers. Linen pants offer superior cooling and casual elegance. Natural wrinkling is characteristic of the fabric.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Denim</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic cotton twill fabric for jeans and casual trousers. Available in various weights, washes, and finishes. Durable and versatile for casual wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Stretch Fabrics</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Fabrics with elastane/spandex for comfort and mobility. Popular for chinos, joggers, and casual trousers. Stretch content typically 2-5% for dress pants, 5-10% for casual wear.
    </p>
  </div>
</section>

<!-- Products Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Pants Products We Manufacture</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Chinos (slim, regular, relaxed fit)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Dress pants and formal trousers
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Casual trousers and slacks
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Joggers and sweatpants
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cargo pants with multiple pockets
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Linen pants for summer wear
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Denim trousers and jeans
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Work pants and utility trousers
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Athletic pants and performance trousers
      </li>
    </ul>
  </div>
</section>

<!-- Fit Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Fit Options</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Available Fits</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Slim fit (tapered through leg)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Regular fit (classic straight leg)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Relaxed fit (roomier through seat and thigh)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Plus size (extended size range)
      </li>
    </ul>
  </div>
</section>

<!-- Customization Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Customization</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Custom Details</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Waistband styles (standard, wide, elastic)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pocket configurations (slant, patch, welt, cargo)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Hem finishes (plain, cuffed, rolled)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Closure types (zipper fly, button fly, drawstring)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pleats (single, double, flat front)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Decorative stitching and branding
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range. We are among the <a href="/low-moq-clothing-manufacturers" style="color:#e00;text-decoration:underline;">low MOQ clothing manufacturers</a> serving startup and emerging brands.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic chinos (cotton twill): $8-14 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Dress pants (wool blend): $12-22 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Casual trousers (polyester blend): $7-13 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic details, and standard packaging. Custom details, premium fabrics, and specialized finishes are additional. As a <a href="/private-label-manufacturer" style="color:#e00;text-decoration:underline;">private label manufacturer</a>, we handle all branding and packaging elements.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Sample development costs are credited against bulk orders. We provide competitive pricing on prototype samples, with these costs deducted from the final production invoice when the order is placed. This encourages thorough sampling without financial penalty for committed brands.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Rush production options are available for urgent deadlines. Accelerated production schedules with compressed lead times incur 20-30% premium pricing but enable brands to meet critical launch dates or seasonal requirements. We provide clear timelines and cost estimates for rush orders before commitment.
    </p>
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
