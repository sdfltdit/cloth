---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Custom Dress Manufacturer for Fashion Brands SDF"
const pageDescription = "Custom dress manufacturer from Bangladesh. Maxi, midi, mini dresses with fabric options. From 300 pieces. Evening, casual styles. Free quote."
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Custom dress manufacturer from Bangladesh providing maxi, midi, mini dresses, cocktail, evening, and casual dresses with fabric options and customization to women's fashion brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for dress manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What dress styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture maxi dresses, midi dresses, mini dresses, cocktail dresses, evening gowns, and casual dresses. All styles available with customization options including fabric selection, length adjustments, and design details."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric options do you offer for dresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer polyester, viscose, cotton, silk blends, crepe, chiffon, satin, and linen. Various weights from lightweight for summer to heavy for winter. Fabric sourcing from certified mills."
          }
        },
        {
          "@type": "Question",
          "name": "What customization do you offer for dresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer full customization including design development, fabric selection, color matching, length adjustments, neckline variations, sleeve options, and embellishment details. Your brand identity integrated throughout."
          }
        },
        {
          "@type": "Question",
          "name": "How much does dress manufacturing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dress manufacturing costs vary by complexity. Simple casual dresses: $12-20 per piece. Cocktail dresses: $15-25 per piece. Evening gowns: $20-35 per piece. FOB Bangladesh pricing from 300 pieces minimum."
          }
        },
        {
          "@type": "Question",
          "name": "How long does dress production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard dress production timeline: 30-40 days from fabric receipt for basic styles. 40-50 days for complex designs with embellishments. 7-14 days for sampling before bulk. Design development adds 10-15 days."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Dress Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Dress Manufacturing Service",
      "description": "Custom dress manufacturing from 300 pieces including maxi, midi, mini dresses, cocktail and evening gowns",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Dress Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Dress Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "12",
              "maxPrice": "35"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Dresses from SDF Clothing",
      "description": "Step-by-step process for ordering custom dresses from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your dress design, fabric specifications, size chart, target quantity, and customization details via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your dress order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review dress samples for fit, fabric quality, construction, and design accuracy within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard dress items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your dress order"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="dress manufacturer, custom dress manufacturer, maxi dress manufacturer, midi dress manufacturer, cocktail dress manufacturer, evening dress manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Dress Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Dress Manufacturer | Since 1998 | Women's Fashion</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Dress Manufacturer for Women's Fashion Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Dresses are the centerpiece of women's fashion - from casual day dresses to elegant evening gowns. Custom manufacturing enables your brand to offer unique styles with perfect fit and quality. SDF Clothing manufactures dresses in Bangladesh from maxi to mini, casual to cocktail. From 300 pieces per style with full customization.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20dress-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">30-40</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Maxi</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">To Mini</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Custom</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Designs</div>
      </div>
    </div>
  </div>
</section>

<!-- Dress Styles Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Dress Categories We Manufacture</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Maxi Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Full-length maxi dresses for casual and formal occasions. Flowing silhouettes, various necklines, sleeve options. Ideal for summer collections and special events.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Midi Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Mid-length midi dresses for versatile styling. Knee-length options, A-line silhouettes, wrap styles. Perfect for day-to-night transitions and professional settings.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Mini Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Short mini dresses for casual and party wear. Various lengths above knee, body-conscious and relaxed fits. Popular for summer and evening collections.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cocktail Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Elegant cocktail dresses for special occasions. Structured silhouettes, premium fabrics, embellishment options. Ideal for evening wear and formal events.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Evening Gowns</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Formal evening gowns for black-tie events. Floor-length designs, luxury fabrics, intricate details. Premium positioning for special occasions.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Casual Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Everyday casual dresses for comfortable wear. Simple silhouettes, breathable fabrics, relaxed fits. Essential for everyday collections.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Fabric Options for Dresses</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Polyester (durable, wrinkle-resistant)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Viscose (soft drape, breathable)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cotton (natural, comfortable)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Silk blends (luxury, premium)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Crepe (structured, elegant)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Chiffon (lightweight, flowing)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Satin (glossy, evening wear)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Linen (summer, breathable)
      </li>
    </ul>
  </div>
</section>

<!-- Customization Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Customization</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Dress Customization</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Design development (from sketch to pattern)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Fabric selection (from certified mills)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Color matching (Pantone, brand colors)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Length adjustments (custom hemlines)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Neckline variations (V-neck, round, halter, etc.)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sleeve options (sleeveless, short, long, puff)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Embellishment details (beading, embroidery, lace)
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Dress manufacturing costs vary by complexity:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Simple casual dress: $12-20 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Cocktail dress: $15-25 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Evening gown: $20-35 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. Custom design development, embellishments, and premium packaging are additional.
    </p>

    <table style="width:100%;max-width:800px;margin-top:2rem;border-collapse:collapse;background:#0a0a0a;">
      <thead>
        <tr style="background:#e00;">
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Dress Type</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Fabric</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">MOQ</th>
          <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Price (300 pcs)</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Casual Dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Cotton, polyester blends</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$12-20 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Cocktail Dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Crepe, satin, silk blends</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Evening Gowns</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Silk, chiffon, premium fabrics</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$20-35 per piece</td>
        </tr>
        <tr style="border-bottom:1px solid #1a1a1a;">
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Maxi Dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Viscose, rayon, cotton</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$15-25 per piece</td>
        </tr>
        <tr>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Midi/Mini Dresses</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">Lightweight polyester, cotton</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">300 pieces</td>
          <td style="padding:1rem;color:#fff;font-size:0.82rem;">$12-20 per piece</td>
        </tr>
      </tbody>
    </table>

    
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
