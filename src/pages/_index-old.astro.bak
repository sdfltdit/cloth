---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { Image } from 'astro:assets';
import { getCompanyAge } from '../../utils/companyAge';

export const prerender = true;

// Dynamic year calculations
const yearsExp = getCompanyAge();

const pageTitle = "SDF Clothing | Sustainable Clothing Manufacturer Bangladesh";
const pageDescription = "Ethical clothing manufacturer in Bangladesh supplying USA, UK, EU, Australia since 1998. Low MOQ 300 pcs, GOTS certified. Private label apparel manufacturing.";

// FAQ data
const faqs = [
	{
		question: "What is your minimum order quantity?",
		answer: "Our MOQ is 300 pieces per style with flexible size and color combinations. Perfect for startups and boutique brands."
	},
	{
		question: "How long does production take?",
		answer: "Standard lead time is 30-45 days for bulk orders up to 50,000 pieces. Sample development takes 7-14 days."
	},
	{
		question: "Do you offer private label and OEM manufacturing?",
		answer: "Yes. We offer full OEM, ODM, and private label clothing manufacturing services including custom labels, hang tags, and branded packaging."
	},
	{
		question: "Do you manufacture woven and knitwear garments?",
		answer: "Yes. We manufacture woven (denim, twill, poplin, oxford) and knitwear (jersey, fleece, rib, interlock). Custom GSM matched to your tech pack with sustainable options including GOTS organic cotton and GRS recycled polyester."
	},
	{
		question: "What customization options do you offer?",
		answer: "In-house embroidery up to 15 colors, screen print, DTF, heat transfer, and sublimation. Trim options include woven labels, hang tags, branded zippers, and custom buttons. All work completed in-house with no outsourcing."
	},
	{
		question: "What is FOB pricing and how does AQL inspection work?",
		answer: "All quotes are FOB Chittagong or Dhaka, covering fabric, dyeing, finishing, cut and sew, AQL 2.5 inspection, and port delivery. Full cost breakdown with no hidden charges. Use our free price calculator for an instant estimate."
	},
	{
		question: "Do you supply clothing brands in the EU, UK, US and Australia?",
		answer: "Yes. SDF Clothing supplies fashion brands across the EU, UK, US, Australia, and Canada. EU exports benefit from GSP duty-free terms. We meet UK Modern Slavery Act, US customs, and EU EPR requirements."
	},
	{
		question: "What are your payment terms and sample policies?",
		answer: "We accept T/T, L/C, and bank transfers. 30% deposit to start production, 70% before shipment. Free samples available for bulk orders. Sample development takes 7-14 days."
	}
];

---

<BaseLayout title={pageTitle} description={pageDescription}>
	
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "Organization",
				"name": "SDF Clothing",
				"foundingDate": "1998",
				"url": "https://sdfclothing.com",
				"email": "contact@sdfltd.com",
				"telephone": "+16465356343",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "House 125, Road 01, Baridhara DOHS",
					"addressLocality": "Dhaka",
					"postalCode": "1212",
					"addressCountry": "BD"
				},
				"hasCredential": [
					{
						"@type": "Thing",
						"name": "GOTS",
						"description": "Global Organic Textile Standard Certification",
						"url": "https://www.global-standard.org/"
					},
					{
						"@type": "Thing", 
						"name": "OEKO-TEX",
						"description": "Standard 100 Certification for Textile Safety",
						"url": "https://www.oeko-tex.com/"
					},
					{
						"@type": "Thing",
						"name": "ISO 9001",
						"description": "Quality Management System Certification",
						"url": "https://www.iso.org/iso-9001-quality-management.html"
					},
					{
						"@type": "Thing",
						"name": "BSCI",
						"description": "Business Social Compliance Initiative",
						"url": "https://bsci-amfori.org/"
					},
					{
						"@type": "Thing",
						"name": "SEDEX",
						"description": "Supplier Ethical Data Exchange Certification",
						"url": "https://www.sedex.com/"
					},
					{
						"@type": "Thing",
						"name": "GRS",
						"description": "Global Recycled Standard Certification",
						"url": "https://textileexchange.org/standards/grs/"
					},
					{
						"@type": "Thing",
						"name": "OCS",
						"description": "Organic Content Standard Certification",
						"url": "https://textileexchange.org/standards/organic-content-standard/"
					},
					{
						"@type": "Thing",
						"name": "RCS",
						"description": "Recycled Claim Standard Certification",
						"url": "https://textileexchange.org/standards/recycled-claim-standard/"
					},
					{
						"@type": "Thing",
						"name": "C-TPAT",
						"description": "Customs-Trade Partnership Against Terrorism Certification",
						"url": "https://www.cbp.gov/trade/security/c-tpat"
					},
					{
						"@type": "Thing",
						"name": "WRAP",
						"description": "Worldwide Responsible Accredited Production Certification",
						"url": "https://www.wrapcompliance.org/"
					},
					{
						"@type": "Thing",
						"name": "SA8000",
						"description": "Social Accountability Standard Certification",
						"url": "https://www.sai-certification.org/"
					},
					{
						"@type": "Thing",
						"name": "ISO 14001",
						"description": "Environmental Management System Certification",
						"url": "https://www.iso.org/iso-14001-environmental-management.html"
					},
					{
						"@type": "Thing",
						"name": "BCI",
						"description": "Better Cotton Initiative Certification",
						"url": "https://bettercotton.org/"
					}
				],
				"description": "Leading clothing manufacturers in Bangladesh since 1998. Specializing in OEM, private label, and custom apparel manufacturing with low MOQ of 300 pieces per style.",
				"areaServed": ["European Union", "United Kingdom", "United States", "Australia", "Canada", "Worldwide"],
				"knowsLanguage": ["English", "Bengali"],
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": "23.8103",
					"longitude": "90.4125"
				},
				"openingHours": "Mo-Fr 09:00-18:00",
				"priceRange": "$$",
				"paymentAccepted": ["Bank Transfer", "L/C", "T/T"],
				"currenciesAccepted": "USD",
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "5",
					"reviewCount": "200",
					"bestRating": "5",
					"worstRating": "1"
				}
			},
			{
				"@type": "Service",
				"name": "Clothing Manufacturing Service",
				"description": "Complete apparel production solutions including OEM, private label, and custom clothing manufacturing for global fashion brands",
				"provider": {
					"@type": "Organization",
					"name": "SDF Clothing"
				},
				"serviceType": "Clothing Manufacturing",
				"areaServed": ["European Union", "United Kingdom", "United States", "Australia", "Canada"],
				"eligibleRegion": ["EU", "UK", "US", "AU", "CA"],
				"hasOfferCatalog": {
					"@type": "OfferCatalog",
					"name": "Clothing Manufacturing Services",
					"itemListElement": [
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "OEM Clothing Manufacturing",
								"description": "Original equipment manufacturing for fashion brands"
							},
							"minimumOrderQuantity": "300"
						},
						{
							"@type": "Offer", 
							"itemOffered": {
								"@type": "Service",
								"name": "Private Label Clothing Production",
								"description": "Custom branded apparel manufacturing"
							},
							"minimumOrderQuantity": "300"
						}
					]
				},
				"offers": {
					"@type": "Offer",
					"availability": "https://schema.org/InStock",
					"minimumOrderQuantity": "300",
					"priceSpecification": {
						"@type": "PriceSpecification",
						"priceCurrency": "USD"
					}
				},
				"slogan": "Low MOQ Clothing Manufacturer - Starting from 300 pieces"
			},
			{
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is your minimum order quantity?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Our MOQ is 300 pieces per style with flexible size and color combinations. Perfect for startups and boutique brands."
						}
					},
					{
						"@type": "Question",
						"name": "How long does production take?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Standard lead time is 30-45 days for bulk orders up to 50,000 pieces. Sample development takes 7-14 days."
						}
					},
					{
						"@type": "Question",
						"name": "Do you offer private label and OEM manufacturing?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes. We offer full OEM, ODM, and private label clothing manufacturing services including custom labels, hang tags, and branded packaging."
						}
					},
					{
						"@type": "Question",
						"name": "Do you manufacture woven and knitwear garments?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes. We manufacture woven (denim, twill, poplin, oxford) and knitwear (jersey, fleece, rib, interlock). Custom GSM matched to your tech pack with sustainable options including GOTS organic cotton and GRS recycled polyester."
						}
					},
					{
						"@type": "Question",
						"name": "What customization options do you offer?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "In-house embroidery up to 15 colors, screen print, DTF, heat transfer, and sublimation. Trim options include woven labels, hang tags, branded zippers, and custom buttons. All work completed in-house with no outsourcing."
						}
					},
					{
						"@type": "Question",
						"name": "What is FOB pricing and how does AQL inspection work?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "All quotes are FOB Chittagong or Dhaka, covering fabric, dyeing, finishing, cut and sew, AQL 2.5 inspection, and port delivery. Full cost breakdown with no hidden charges. Use our free price calculator for an instant estimate."
						}
					},
					{
						"@type": "Question",
						"name": "Do you supply clothing brands in the EU, UK, US and Australia?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes. SDF Clothing supplies fashion brands across the EU, UK, US, Australia, and Canada. EU exports benefit from GSP duty-free terms. We meet UK Modern Slavery Act, US customs, and EU EPR requirements."
						}
					},
					{
						"@type": "Question",
						"name": "What are your payment terms and sample policies?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "We accept T/T, L/C, and bank transfers. 30% deposit to start production, 70% before shipment. Free samples available for bulk orders. Sample development takes 7-14 days."
						}
					}
				]
			}
		]
	}
	</script>

	
	<section class="relative w-full h-screen min-h-screen overflow-hidden flex items-center justify-center">
		
		<div class="absolute inset-0 w-full h-full overflow-hidden">
			<div class="absolute inset-0 w-full h-full object-cover">
				<Image 
					src="/sdf.webp" 
					alt="SDF Clothing garment factory Dhaka ethical CMT manufacturing for EU, UK, US brands with GOTS and OEKO-TEX certification"
					class="absolute inset-0 w-full h-full object-cover"
					width={1920}
					height={1080}
					loading="eager"
					decoding="async"
					fetchpriority="high"
					format="webp"
					quality={30}
					sizes="(max-width: 768px) 768px, (max-width: 1200px) 1200px, 1920px"
				/>
			</div>
			<div class="absolute inset-0 bg-black/60"></div>
		</div>
		
		<div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
			<h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
				Sustainable Clothing Manufacturer Bangladesh for Global Brands
			</h1>
			<p class="text-xl md:text-2xl text-gray-300 mb-8">
				Ethical apparel manufacturing for USA, UK, EU, Australia markets. 
				Low MOQ 300 pieces, GOTS certified organic cotton, 
				private label production since 1998.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a 
					href="/contact" 
					class="inline-block bg-red-600 text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-red-700 transition-all transform hover:scale-105 min-h-[44px] min-w-[44px]"
				>
					Start Your Project
				</a>
				<a
					href="/products"
					class="inline-block border border-red-600 text-red-500 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-red-600 hover:text-white transition-all min-h-[44px] min-w-[44px]"
				>
					Explore Manufacturing Solutions
				</a>
			</div>
		</div>
	</section>


	<section class="py-8 px-4 bg-black">
		<div class="container mx-auto max-w-6xl">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">{yearsExp}+</div>
					<div class="text-gray-300">Years Experience</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">300</div>
					<div class="text-gray-300">Pieces MOQ</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">50,000</div>
					<div class="text-gray-300">Pieces / 45 Days</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-3xl font-bold text-red-500 mb-2">13</div>
					<div class="text-gray-300">International Certifications</div>
				</div>
			</div>
		</div>
	</section>

	
	<section class="py-10 px-4 border-y border-gray-800">
		<div class="container mx-auto max-w-5xl">
			<p class="text-center text-gray-400 text-xs 
			   uppercase tracking-widest mb-6">
				Supplying clothing brands across
			</p>
			<div class="grid grid-cols-2 sm:grid-cols-3 
						md:grid-cols-5 gap-4">
				<div class="snake-card p-6 text-center">
					<div class="text-2xl mb-2">🇪🇺</div>
					<div class="text-white font-semibold 
								text-sm mb-1">European Union</div>
					<div class="text-gray-400 text-xs">
						GSP duty-free exports
					</div>
				</div>
				<div class="snake-card p-6 text-center">
					<div class="text-2xl mb-2">🇬🇧</div>
					<div class="text-white font-semibold 
								text-sm mb-1">United Kingdom</div>
					<div class="text-gray-400 text-xs">
						UK GSP trade terms
					</div>
				</div>
				<div class="snake-card p-6 text-center">
					<div class="text-2xl mb-2">🇺🇸</div>
					<div class="text-white font-semibold 
								text-sm mb-1">United States</div>
					<div class="text-gray-400 text-xs">
						US customs compliant
					</div>
				</div>
				<div class="snake-card p-6 text-center">
					<div class="text-2xl mb-2">🇦🇺</div>
					<div class="text-white font-semibold 
								text-sm mb-1">Australia</div>
					<div class="text-gray-400 text-xs">
						AU standards compliant
					</div>
				</div>
				<div class="snake-card p-6 text-center 
							col-span-2 sm:col-span-1">
					<div class="text-2xl mb-2">🌍</div>
					<div class="text-white font-semibold 
								text-sm mb-1">Worldwide</div>
					<div class="text-gray-400 text-xs">
						FOB global delivery
					</div>
				</div>
			</div>
		</div>
	</section>

	
	<section class="py-12 px-4 bg-black">
		<div class="container mx-auto max-w-6xl">
			<div class="grid md:grid-cols-3 gap-6">
				<div class="snake-card p-6">
					<div class="text-red-500 mb-3 text-lg 
								tracking-widest">★★★★★</div>
					<p class="text-gray-300 text-sm 
							  leading-relaxed mb-4">
						"SDF delivered 3,000 units of our organic 
						cotton hoodie line on time, within budget, 
						with perfect AQL inspection results. Our 
						EU compliance audit passed first time."
					</p>
					<div class="text-white font-semibold text-sm">
						Activewear Brand, Netherlands
					</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-red-500 mb-3 text-lg 
								tracking-widest">★★★★★</div>
					<p class="text-gray-300 text-sm 
							  leading-relaxed mb-4">
						"From tech pack to final shipment in 38 days.
						Fabric sourcing, dyeing and finishing quality 
						exceeded what our previous manufacturer 
						delivered at 40 percent higher cost."
					</p>
					<div class="text-white font-semibold text-sm">
						Private Label Brand, United Kingdom
					</div>
				</div>
				<div class="snake-card p-6">
					<div class="text-red-500 mb-3 text-lg 
								tracking-widest">★★★★★</div>
					<p class="text-gray-300 text-sm 
							  leading-relaxed mb-4">
						"MOQ of 300 pieces worked perfectly for our 
						startup. Cut and sew quality on our knitwear 
						range was excellent. Embroidery and screen 
						print matched our brand guidelines exactly."
					</p>
					<div class="text-white font-semibold text-sm">
						Streetwear Label, United States
					</div>
				</div>
			</div>
		</div>
	</section>

	
	<section id="about" class="py-20 px-4 bg-black">
		<div class="container mx-auto max-w-6xl">

			
			<div class="bg-[#0d0d0d] border border-red-900/20 rounded-[20px] p-10 shadow-[0_0_60px_rgba(220,38,38,0.07)]">

				
				<p class="text-center text-[11px] font-semibold tracking-[0.15em] uppercase text-red-500 mb-[0.85rem]">Trusted Since 1998</p>

				
				<h2 class="text-center font-bold text-white mb-8 leading-[1.4] text-[clamp(1.4rem,3vw,2rem)]">Why Global Brands Choose SDF<br>as Their Apparel Production Partner</h2>

				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start about-cert-grid">

					
					<div class="bg-white/[0.025] border border-red-900/35 rounded-xl p-6 h-full box-border">
						<p class="text-[15px] leading-[1.8] text-gray-400 mb-4">
							SDF Clothing manufactures premium apparel for fashion brands,
							retailers, and startups across the EU, UK, US, and Australia.
							Our production facility in Baridhara DOHS, Dhaka has operated
							since 1998 with a focus on quality and ethical standards.
						</p>
						<p class="text-[15px] leading-[1.8] text-gray-400 mb-4">
							As a full-package manufacturer, we handle the complete supply
							chain: fabric sourcing, dyeing, finishing, cut and sew
							production, embroidery, screen printing, AQL inspection, and
							FOB delivery. Whether you need OEM, private label, or custom
							apparel, we work to your exact specifications.
						</p>
						<p class="text-[15px] leading-[1.8] text-gray-400 mb-0">
							We hold 13 international certifications including GOTS and
							OEKO-TEX, and our processes meet USA import requirements,
							UK Modern Slavery Act compliance, EU EPR regulations, and
							Australian ethical manufacturing standards.
						</p>
					</div>

					
					<div class="flex flex-col gap-4">

						<div>
							<h3 class="text-lg font-bold text-white mb-1">
								International Certifications
							</h3>
							<p class="text-xs text-gray-500 mb-4">
								13 globally recognised standards verified, audited, maintained
							</p>
						</div>

						
						<div class="grid grid-cols-3 gap-2">
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									GOTS
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Global Organic Textile Standard
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									OEKO-TEX
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Standard 100 Harmful substance
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									ISO 9001
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Quality Management System
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									BSCI
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Business Social Compliance
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									SEDEX
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Supplier Ethical Data Exchange
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									GRS
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Global Recycled Standard
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									OCS
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Organic Content Standard
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									RCS
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Recycled Claim Standard
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									C-TPAT
								</div>
								<div class="text-[11px] text-gray-500 leading-[1.35]">
									Customs-Trade Partnership
								</div>
							</div>
							<div class="bg-white/[0.02] border border-red-900/25 rounded-lg p-[0.6rem_0.7rem]">
								<div class="text-xs font-semibold text-red-500 mb-[3px]">
									WRAP
								</div>
