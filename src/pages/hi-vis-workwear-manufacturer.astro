---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Hi-Vis Workwear Manufacturer Bangladesh | EN ISO 20471 Ce...";
const pageDescription = "Professional hi-vis workwear manufacturer from Bangladesh — custom vests, jackets and t-shirts to EN ISO 20471 standards, reflective tape included.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Hi-vis workwear manufacturer from Bangladesh providing custom hi-vis vests, jackets, and t-shirts with EN ISO 20471 standards, reflective tape, and safety colors to safety apparel brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for hi-vis workwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What hi-vis products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture hi-vis vests, jackets, t-shirts, coveralls, rainwear, and safety accessories. All products meet EN ISO 20471 standards for high-visibility safety apparel."
          }
        },
        {
          "@type": "Question",
          "name": "Do your products meet EN ISO 20471 standards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. All our hi-vis workwear is manufactured to meet EN ISO 20471 standards. This includes proper reflective tape placement, background material requirements, and photometric performance specifications."
          }
        },
        {
          "@type": "Question",
          "name": "What safety colors do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer standard safety colors including fluorescent yellow, fluorescent orange, and fluorescent red. These colors meet EN ISO 20471 requirements for high-visibility background materials."
          }
        },
        {
          "@type": "Question",
          "name": "What reflective tape options do you provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide reflective tape in various widths and performance levels. All reflective tape meets EN ISO 20471 standards for retroreflection. Options include glass bead tape and microprismatic tape."
          }
        },
        {
          "@type": "Question",
          "name": "How long does hi-vis workwear production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic hi-vis workwear. 35-50 days for custom designs with specialized reflective tape or safety features. 7-14 days for sampling before bulk."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Hi-Vis Workwear Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="hi-vis workwear manufacturer, high visibility clothing manufacturer, safety vest manufacturer, reflective clothing manufacturer, EN ISO 20471 workwear" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Hi-Vis Workwear Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Hi-Vis Workwear Manufacturer | Since 1998 | EN ISO 20471 Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Hi-Vis Workwear Manufacturer for Safety Apparel Brands
