---
import BaseLayout from '../layouts/BaseLayout.astro';
import { schemaOrganization, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const pageTitle = "Clothing Manufacturers for Women's Fashion Brands | SDF";
const pageDescription = "Clothing manufacturer for women's fashion brands. Custom dresses, activewear, loungewear and occasion wear from 300 pieces. Size-inclusive options. Get quote.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20women%27s%20fashion%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl.href,
      "url": canonicalUrl.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2026-05-23",
      "dateModified": "2026-05-23",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": canonicalUrl.href
          }
        ]
      },
      "publisher": { "@id": SITE + "/#organization" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can you manufacture women's clothing from 300 pieces?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, SDF Clothing manufactures women's fashion from 300 pieces per style with flexible size and color combinations. Our 300 piece MOQ makes custom women's clothing accessible to emerging brands and boutique labels. We specialize in dresses, activewear, loungewear, and occasion wear with size-inclusive options from XS to 4XL."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer size-inclusive manufacturing up to 4XL?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer size-inclusive manufacturing from XS to 4XL with proper grading for each size range. Women's sizing requires different grading rules for plus sizes to ensure proper fit across the full range. We sample across the size range to verify fit before bulk production. Size inclusivity is increasingly expected by women's fashion consumers."
          }
        },
        {
          "@type": "Question",
          "name": "What women's clothing styles do you specialise in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF specialises in women's dresses (casual, occasion, midi, maxi, wrap, shirt dresses), tops (blouses, crop tops, camisoles, oversized tees), bottoms (skirts, wide-leg trousers, culottes, leggings), activewear (leggings, sports bras, yoga sets), loungewear (co-ords, matching sets, soft knit sets), outerwear (tailored coats, oversized blazers, bombers), and swimwear (bikinis, one-pieces, cover-ups)."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure fit across a women's size range?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We ensure fit across women's size ranges through proper grading following industry standards, sampling across multiple sizes before bulk production, fit testing on different body types, and using accurate block patterns. Plus sizes require different grading rules than standard sizes - we adjust proportions for bust, waist, and hips appropriately. We recommend fit samples in XS, M, XL, and 4XL for size-inclusive collections."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics work best for women's dresses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Best fabrics for women's dresses include satin for formal wear (excellent drape, elegant sheen), chiffon for flowing styles (lightweight, transparent layering), crepe for structured dresses (holds shape, minimal stretch), jersey for casual dresses (comfortable, stretchy), and cotton poplin for shirt dresses (crisp, breathable). Fabric choice depends on dress style, season, and desired hand feel. SDF sources all these fabrics with certification options."
          }
        },
        {
          "@type": "Question",
          "name": "Can you manufacture matching co-ord sets for women?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we manufacture matching co-ord sets for women including two-piece sets, three-piece sets, loungewear co-ords, and activewear matching sets. Co-ord sets are popular in women's fashion for Instagram-worthy looks and easy styling. We ensure perfect color matching across pieces and consistent fabric quality. Our 300 piece MOQ applies to co-ord sets as well."
          }
        },
        {
          "@type": "Question",
          "name": "How long does women's fashion manufacturing take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Women's fashion manufacturing typically takes 7-14 days for sample development and 40-45 days for bulk production from fabric sourcing to shipment. Shipping adds 20-45 days depending on destination. Trend-sensitive women's fashion may require faster turnaround - we offer rush production options for 20-30% premium. Planning production cycles around trend seasons is essential for women's fashion brands."
          }
        },
        {
          "@type": "Question",
          "name": "Can you help develop a size-inclusive women's collection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we help develop size-inclusive women's collections from concept to production. Our services include size range planning (XS-4XL), proper grading for each size, fit sample development across sizes, pattern adjustment for plus sizes, and production sampling to verify fit. Size inclusivity is a competitive advantage in women's fashion - we help you execute it properly to ensure customer satisfaction across the full size range."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications are important for women's fashion brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Important certifications for women's fashion brands include GOTS for organic cotton (sustainability demand), OEKO-TEX for chemical safety (skin contact fabrics), BSCI or WRAP for social compliance (ethical manufacturing concerns), and ISO 9001 for quality management (consistency). Women consumers drive sustainability and ethical fashion demand - certifications support your brand story. SDF holds 13 international certifications."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer sustainable fabric options for women's fashion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer sustainable fabric options for women's fashion including GOTS-certified organic cotton, recycled polyester (rPET for activewear), Tencel for sustainable softness, linen for eco-friendly natural fibers, and recycled fabrics. Women consumers prioritize sustainability - offering certified sustainable options with transaction certificates supports your sustainability claims and appeals to conscious consumers."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Women's Fashion Clothing Manufacturing",
      "provider": { "@id": SITE + "/#organization" },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "IT", "ES"],
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "USD",
          "price": "300",
          "description": "Starting MOQ | 300 pieces per style"
        }
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Work with SDF for Women's Fashion Manufacturing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Women's Fashion Designs",
          "text": "Provide your tech pack or design brief including measurements, materials, colors, and size range. Specify if you need size-inclusive options from XS to 4XL."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Fabric and Size Recommendations",
          "text": "We recommend appropriate fabrics for your women's styles and advise on sizing standards for your target market. We help plan size-inclusive ranges if needed."
        },
        {
          "@type": "HowToStep",
          "name": "Develop Fit Samples",
          "text": "We produce samples in multiple sizes to verify fit across your size range. For size-inclusive collections, we sample XS, M, XL, and 4XL to ensure proper grading."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples and Production",
          "text": "Approve samples for fit, fabric quality, and construction. We proceed with bulk production with regular updates and quality control."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Your Women's Fashion Collection",
          "text": "Final inspection, shipping, and delivery of your women's fashion collection ready for retail. We provide all necessary documentation and size labels."
        }
      ]
    },
    {
      "@type": "ItemList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Dresses",
          "description": "Custom women's dresses from casual to occasion wear"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Activewear",
          "description": "Women's leggings, sports bras, and yoga sets"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Loungewear",
          "description": "Co-ords and matching sets for women"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Swimwear",
          "description": "Bikinis, one-pieces, and cover-ups"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl.href} schema={schema}>

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb__item breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">Women's Fashion Manufacturer</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<main id="main-content">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <p class="hero__label">Women's Fashion Specialist | Size-Inclusive</p>
        <h1 class="hero__title">Clothing Manufacturers for Women's Fashion Brands | Custom Collections from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing specialises in women's fashion manufacturing with size-inclusive options from XS to 4XL. We manufacture dresses, activewear, loungewear, occasion wear, and swimwear with proper fit across the full size range. Women's fashion requires expertise in fit, fabric hand feel, and trend alignment - we deliver on all three.
        </p>
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">XS-4XL</span>
            <span class="hero__stat-label">Size Range</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">300</span>
            <span class="hero__stat-label">Piece MOQ</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">7+</span>
            <span class="hero__stat-label">Categories</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">13</span>
            <span class="hero__stat-label">Certifications</span>
          </div>
        </div>
        <div class="hero__ctas">
          <a href={whatsappQuoteUrl} class="hero__cta hero__cta--primary" target="_blank" rel="noopener noreferrer">
            Get Women's Fashion Quote
          </a>
          <a href="/contact" class="hero__cta hero__cta--secondary">
            Contact Our Team
          </a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/factory.jpg" alt="Women's fashion clothing manufacturing at SDF Clothing factory" width="600" height="400" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Section 1: Unique Requirements -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Why Women's Fashion Has Unique Manufacturing Requirements</h2>
      <p class="section__text">
        Women's fashion manufacturing differs significantly from menswear due to complexity in fit, sizing, fabric requirements, and market dynamics. Fit is critical in women's clothing - women's sizing is more complex than menswear with greater variation in body proportions across sizes. Size inclusivity matters increasingly as consumers demand XS-4XL options as standard rather than exception. This requires proper grading expertise and fit testing across the full size range, not just sample size.
      </p>
      <p class="section__text">
        Trend cycles move faster in women's fashion. While menswear follows longer trend cycles, women's fashion operates on micro-seasons with rapid style turnover. This requires manufacturers who can turn around samples quickly and adapt to evolving trends without sacrificing quality. SDF offers 7-14 day sample development to support trend-responsive women's brands. Fabric hand feel matters more in women's fashion - drape, softness, texture, and how fabric moves on the body directly impact purchase decisions.
      </p>
      <p class="section__text">
        Construction complexity is higher in women's fashion. Darts, structured seams, delicate fabrics, and intricate details require skilled craftsmanship. A simple women's blouse may have more construction complexity than a men's button-down shirt. Returns are higher in women's fashion - online return rates for women's clothing exceed 30% compared to 20% for menswear. This makes quality and fit accuracy even more critical to minimize returns and protect your margins. SDF's quality control systems focus on the details that matter most in women's fashion.
      </p>
    </div>
  </section>

  <!-- Section 2: Product Categories -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Women's Fashion Product Categories SDF Manufactures</h2>
      <p class="section__text">
        SDF manufactures a comprehensive range of women's fashion categories, each requiring specialised expertise. We understand the unique requirements of each category and have the technical capability to deliver quality across diverse women's styles. From casual everyday wear to special occasion pieces, we handle the full spectrum of women's fashion.
      </p>
      
      <h3 class="section__subtitle">Dresses</h3>
      <p class="section__text">
        We manufacture women's dresses across all styles: casual dresses for everyday wear, occasion dresses for events, midi and maxi lengths, wrap dresses that flatter diverse body types, and shirt dresses for professional settings. Each dress style requires specific fabric choices and construction techniques. Our dress manufacturing expertise ensures proper fit, drape, and finish whether you're producing flowing maxi dresses or structured shirt dresses. Learn more about our <a href="/dress-manufacturer">dress manufacturing capabilities</a>.
      </p>
      
      <h3 class="section__subtitle">Tops</h3>
      <p class="section__text">
        Women's tops range from blouses with delicate details to crop tops for contemporary styles, camisoles for layering, and oversized tees for casual comfort. Top manufacturing requires attention to neckline finishes, sleeve construction, and fabric stability. We produce tops in woven and knit fabrics with appropriate construction for each material. Whether you need structured blouses or relaxed oversized styles, we deliver consistent quality across your top collection.
      </p>
      
      <h3 class="section__subtitle">Bottoms</h3>
      <p class="section__text">
        Women's bottoms include skirts in various lengths and silhouettes, wide-leg trousers for contemporary looks, culottes for fashion-forward styles, and leggings for activewear and casual wear. Bottom manufacturing requires expertise in waistband construction, fit through hips and thighs, and hem finishes. We manufacture bottoms in stretch and non-stretch fabrics with proper fit consideration for each. Our <a href="/skirts-manufacturer">skirt manufacturing</a> capabilities cover mini, midi, and maxi lengths.
      </p>
      
      <h3 class="section__subtitle">Activewear</h3>
      <p class="section__text">
        Women's activewear includes leggings with compression and support, sports bras with proper fit and coverage, and yoga sets for coordinated looks. Activewear manufacturing requires performance fabrics with moisture-wicking, four-way stretch, and recovery. We specialise in <a href="/activewear-manufacturer">activewear manufacturing</a> with technical expertise in performance materials and construction. Our activewear meets the demands of active women who need both function and style.
      </p>
      
      <h3 class="section__subtitle">Loungewear</h3>
      <p class="section__text">
        Loungewear includes co-ords and matching sets for Instagram-worthy looks, soft knit sets for comfort, and relaxed separates for home wear. Loungewear manufacturing prioritises soft fabrics, comfortable fits, and easy-care properties. We manufacture <a href="/loungewear-manufacturer">loungewear</a> in cotton blends, modal, and other soft materials with appropriate construction for relaxed styles. Matching sets require perfect color coordination across pieces - we ensure consistency.
      </p>
      
      <h3 class="section__subtitle">Outerwear</h3>
      <p class="section__text">
        Women's outerwear includes tailored coats for winter, oversized blazers for contemporary style, and bomber jackets for casual wear. Outerwear manufacturing requires lining expertise, closure systems, and structured construction. We manufacture outerwear in various weights and materials with attention to finish details. Whether you need structured coats or relaxed jackets, we deliver quality outerwear that completes your women's collection.
      </p>
      
      <h3 class="section__subtitle">Swimwear</h3>
      <p class="section__text">
        Swimwear includes bikinis, one-pieces, and cover-ups for beach and pool wear. Swimwear manufacturing requires expertise in stretch fabrics, lining construction, and secure finishes. We manufacture <a href="/swimwear-manufacturer">swimwear</a> with quick-drying, chlorine-resistant materials and proper fit for active water wear. Swimwear requires specific construction techniques - we have the expertise to deliver quality swimwear that performs.
      </p>
    </div>
  </section>

  <!-- Section 3: Size Inclusivity -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Size Inclusivity in Women's Fashion Manufacturing</h2>
      <p class="section__text">
        Size inclusivity is no longer optional in women's fashion - it's expected. Women consumers demand clothing that fits across the full size range, not just standard sizing. However, size inclusivity requires more than simply extending measurements. Proper grading for plus sizes follows different rules than standard sizing. A straight size grade from XS to XL doesn't translate to proper fit at 4XL. Plus sizes require different proportions for bust, waist, and hips to accommodate body shape changes at larger sizes.
      </p>
      <p class="section__text">
        SDF offers size-inclusive manufacturing from XS to 4XL with proper grading for each size range. Our pattern makers understand the grading rules for plus sizes and adjust proportions appropriately. We don't simply scale up - we grade according to body shape changes to ensure proper fit across the full range. This expertise is critical because poor fit in plus sizes leads to returns and negative reviews, damaging your brand reputation.
      </p>
      
      <div class="comparison-wrapper">
        <table class="comparison" role="table" aria-label="Size range comparison for women's fashion manufacturing">
          <caption>Women's Fashion Size Range Options</caption>
          <thead>
            <tr>
              <th>Size Range</th>
              <th>Grading Approach</th>
              <th>Market</th>
              <th>Key Consideration</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td><strong>XS-L (straight sizes)</strong></td>
              <td>Standard grading rules</td>
              <td>Traditional market</td>
              <td>Limited customer base</td>
            </tr>
            <tr>
              <td><strong>XS-XXL</strong></td>
              <td>Standard plus extended</td>
              <td>Mass market</td>
              <td>May need plus grading at XXL</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>XS-4XL</strong></td>
              <td>Proper plus grading</td>
              <td>Size-inclusive brands</td>
              <td>Industry standard for inclusivity</td>
            </tr>
            <tr>
              <td><strong>XS-6XL</strong></td>
              <td>Extended plus grading</td>
              <td>Plus-focused brands</td>
              <td>Requires specialised expertise</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="section__text">
        Sampling across the size range is essential, not optional. We recommend fit samples in XS, M, XL, and 4XL for size-inclusive collections to verify grading accuracy before bulk production. Fit issues that aren't caught in sampling will multiply in bulk production. Our <a href="/plus-size-clothing-manufacturer">plus-size clothing manufacturing</a> expertise ensures your size-inclusive collection delivers proper fit across all sizes. We also offer <a href="/grading-service">grading services</a> for brands who need size range development.
      </p>
    </div>
  </section>

  <!-- Section 4: Fabric Guide -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Fabric Guide for Women's Fashion | What Drapes, What Moves</h2>
      <p class="section__text">
        Fabric choice makes or breaks women's fashion. The right fabric drapes beautifully, feels luxurious against skin, and moves naturally with the body. The wrong fabric hangs stiffly, feels cheap, and restricts movement. Women consumers are particularly sensitive to fabric hand feel - touch is a primary factor in purchase decisions. Understanding fabric properties helps you choose materials that deliver the aesthetic and performance your brand promises.
      </p>
      
      <div class="comparison-wrapper">
        <table class="comparison" role="table" aria-label="Fabric guide for women's fashion">
          <caption>Women's Fashion Fabric Guide</caption>
          <thead>
            <tr>
              <th>Fabric</th>
              <th>Drape</th>
              <th>Hand Feel</th>
              <th>Best Women's Style</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td><strong>Satin</strong></td>
              <td>Excellent</td>
              <td>Smooth, silky</td>
              <td>Evening dresses, blouses</td>
              <td>Elegant sheen, prone to snagging</td>
            </tr>
            <tr>
              <td><strong>Chiffon</strong></td>
              <td>Fluid</td>
              <td>Light, airy</td>
              <td>Flowing dresses, layering</td>
              <td>Transparent, needs lining</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>Crepe</strong></td>
              <td>Structured</td>
              <td>Textured, matte</td>
              <td>Structured dresses, pants</td>
              <td>Holds shape, minimal stretch</td>
            </tr>
            <tr>
              <td><strong>Jersey</strong></td>
              <td>Soft drape</td>
              <td>Stretchy, soft</td>
              <td>T-shirts, casual dresses</td>
              <td>Comfortable, can pill</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>French terry</strong></td>
              <td>Medium</td>
              <td>Soft, looped back</td>
              <td>Loungewear, hoodies</td>
              <td>Cozy, casual aesthetic</td>
            </tr>
            <tr>
              <td><strong>Linen</strong></td>
              <td>Crisp</td>
              <td>Natural, textured</td>
              <td>Summer dresses, tops</td>
              <td>Wrinkles, breathable</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>Tencel</strong></td>
              <td>Fluid</td>
              <td>Silky, sustainable</td>
              <td>Draping dresses, blouses</td>
              <td>Eco-friendly, luxurious</td>
            </tr>
            <tr>
              <td><strong>Silk alternative</strong></td>
              <td>Excellent</td>
              <td>Smooth, premium</td>
              <td>Luxury dresses, blouses</td>
              <td>Affordable silk substitute</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>Cotton poplin</strong></td>
              <td>Crisp</td>
              <td>Smooth, structured</td>
              <td>Shirt dresses, blouses</td>
              <td>Breathable, easy care</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="section__text">
        Fabric selection should align with your brand positioning and target market. Luxury brands use satin, silk alternatives, and Tencel for premium hand feel. Sustainable brands choose linen, Tencel, and organic cotton. Casual brands favour jersey and French terry for comfort. Performance brands use technical fabrics with moisture-wicking properties. SDF sources all these fabrics with certification options including GOTS for organic, OEKO-TEX for chemical safety, and GRS for recycled materials. Our <a href="/linen-clothing-manufacturer">linen manufacturing</a> and <a href="/tencel-clothing-manufacturer">Tencel manufacturing</a> capabilities support sustainable women's fashion.
      </p>
    </div>
  </section>

  <!-- Section 5: Sizing Standards -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Sizing Standards for Women's Fashion | US, UK, EU, AU</h2>
      <p class="section__text">
        Women's sizing varies significantly across markets. A US size 8 is a UK size 12, EU size 36, and AU size 12. These differences matter for brands selling internationally. Using the wrong size standards for your market leads to fit issues and returns. Understanding international sizing standards helps you choose the right size labels for your target market and provide accurate size charts to customers.
      </p>
      
      <div class="comparison-wrapper">
        <table class="comparison" role="table" aria-label="International women's size conversion table">
          <caption>International Women's Size Conversion</caption>
          <thead>
            <tr>
              <th>Size Label</th>
              <th>US Size</th>
              <th>UK Size</th>
              <th>EU Size</th>
              <th>AU Size</th>
              <th>Bust (cm)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td><strong>XS</strong></td>
              <td>0-2</td>
              <td>4-6</td>
              <td>32-34</td>
              <td>4-6</td>
              <td>78-82</td>
            </tr>
            <tr>
              <td><strong>S</strong></td>
              <td>4-6</td>
              <td>8-10</td>
              <td>36-38</td>
              <td>8-10</td>
              <td>84-89</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>M</strong></td>
              <td>8-10</td>
              <td>12-14</td>
              <td>40-42</td>
              <td>12-14</td>
              <td>91-97</td>
            </tr>
            <tr>
              <td><strong>L</strong></td>
              <td>12-14</td>
              <td>16-18</td>
              <td>44-46</td>
              <td>16-18</td>
              <td>99-104</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>XL</strong></td>
              <td>16-18</td>
