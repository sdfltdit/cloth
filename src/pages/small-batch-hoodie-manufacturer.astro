---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Small Batch Hoodie Manufacturer | 100+ Pieces | SDF";
const pageDescription = "Small batch hoodie manufacturer in Bangladesh. Custom hoodies from 100 pieces. Fleece, French terry and organic cotton. Private label ready. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Small Batch Hoodie Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for small batch hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our small batch minimum is 100 pieces per style. This applies per colorway and size range, allowing you to test hoodie designs with manageable inventory and reduced financial risk."
          }
        },
        {
          "@type": "Question",
          "name": "How long does small batch hoodie production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small batch hoodie production takes 30-40 days from fabric receipt. Sampling requires 10-14 days before bulk commitment. Fabric development adds 5-10 days for custom materials."
          }
        },
        {
          "@type": "Question",
          "name": "Can I order both pullover and zip hoodies in small batch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can order 100 pieces split between pullover and zip styles, or focus on one style. Each style counts toward the minimum. Mix styles to test different designs with your target market."
          }
        },
        {
          "@type": "Question",
          "name": "What fleece weights are available for small batch hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "200 GSM lightweight fleece for spring/summer, 280 GSM midweight for all-season, 350 GSM heavyweight for winter. All weights available at 100-piece minimum with same quality standards."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide embroidery for small batch hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Embroidery available from 50 pieces. Left chest logos, back designs, sleeve embroidery all supported. Screen print also available for larger designs. Both decoration methods included in production."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics are available for small batch hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cotton fleece, French terry, polyester fleece, organic cotton fleece (GOTS certified), recycled polyester fleece (GRS certified). Fabric sourcing included. All materials tested for pilling and shrinkage."
          }
        },
        {
          "@type": "Question",
          "name": "How much does small batch hoodie production cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pricing depends on fabric weight, style, and decoration. Basic cotton fleece hoodies: $8-12 per piece at 100 pieces, $6-9 per piece at 300 pieces. Use our price calculator at /tools/price-calculator for estimates."
          }
        },
        {
          "@type": "Question",
          "name": "Can streetwear brands launch with small batch hoodies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Many streetwear brands launch with 100-300 piece hoodie drops. Small batch reduces financial risk while maintaining premium positioning. Hoodies are high-ticket items, so lower quantities still generate meaningful revenue."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Small Batch Hoodie Manufacturing Service",
      "description": "Custom hoodie manufacturing from 100 pieces for brands with fleece weight options and decoration services",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Small Batch Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Small Batch Hoodie Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "150",
              "maxPrice": "600"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Small Batch Hoodies from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Brief",
          "text": "Send your hoodie design, fabric preference, fleece weight, pullover vs zip, size range, and decoration requirements via our contact form."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote Within 24 Hours",
          "text": "Get detailed pricing including fabric cost, unit price, sampling fee, decoration costs, and lead times. All costs itemized for transparency."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Receive physical samples in 10-14 days. Evaluate fit, fabric hand feel, embroidery or print quality. Revisions included before bulk commitment."
        },
        {
          "@type": "HowToStep",
          "name": "Place Bulk Order",
          "text": "Confirm purchase order for 100+ pieces. Production starts with inline quality checks at cutting, sewing, and finishing stages."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Shipment",
          "text": "Final inspection, packing, and export documentation. Ship to your freight forwarder or direct warehouse. Track throughout transit."
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Small Batch Hoodie Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Small Batch Production | Since 1998 | Bangladesh Factory</div>
        <h1 class="hero__title">Small Batch Hoodie Manufacturer | Custom Hoodies from 100 Pieces for Startup and Independent Brands</h1>
        <p class="hero__description">
          Launch your hoodie line without traditional bulk minimums. SDF Clothing manufactures custom hoodies in Bangladesh from 100 pieces per style with fleece, French terry, and organic cotton options. Perfect for streetwear brands, startups, and brands testing new designs with reduced financial risk. Explore our <a href="/clothing-manufacturers/" style="color:#e00;text-decoration:none;">clothing manufacturers</a> and <a href="/small-batch-streetwear-manufacturer/" style="color:#e00;text-decoration:none;">small batch streetwear manufacturer</a>.
        </p>
        <div class="hero__ctas">
          <a href="/contact/" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20small%20batch%20hoodies`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">100</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">98%</span>
          <span class="hero__stat-label">On-Time Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Understanding Small Batch</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What Small Batch Hoodie Manufacturing Actually Means</h2>
      </div>
      <div class="section__text">
        <p>Small batch hoodie production refers to orders between 100-300 pieces per style, significantly lower than traditional bulk manufacturing which typically requires 1,000-5,000 pieces minimum. Hoodies are high-ticket items with higher material and construction costs than t-shirts, making small batch production particularly valuable for reducing financial risk. For streetwear brands and fashion startups, small batch means you can launch premium hoodies without committing to large inventory that may not sell, while still accessing factory-direct pricing and quality.</p>
        
        <p>The 100-piece minimum at SDF applies per style, colorway, and size range. You can order 100 pieces of a single hoodie design in one color across multiple sizes, or split the quantity between pullover and zip styles with 50 pieces each. This flexibility enables you to test different hoodie styles, fleece weights, or color combinations before scaling production. For example, a streetwear brand might order 100 pieces of a heavyweight pullover hoodie to test market response, then follow up with 300 pieces across three colors and both pullover and zip styles once customer demand is confirmed.</p>
        
        <p>Small batch hoodie production at SDF maintains the same quality standards as our bulk orders. Every hoodie receives the same attention to fabric sourcing, construction quality, and decoration precision regardless of order size. Hoodies require more complex construction than t-shirts | ribbed cuffs and waistbands, lined hoods, drawstrings, and reinforced stitching | and we maintain these standards even at 100-piece quantities. Your small batch order receives the same care and quality control as orders from established streetwear brands ordering thousands of pieces.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Cost Analysis</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Small Batch vs Bulk | Cost Per Unit Comparison</h2>
      </div>
      <div class="section__text">
        <p>Hoodie pricing reflects the higher material and construction costs compared to t-shirts. The table below shows typical FOB Bangladesh pricing for cotton fleece hoodies with basic embroidery. Unit costs decrease as quantity increases, but small batch pricing remains competitive compared to domestic production. Hoodies command higher retail prices than t-shirts, so even at 100-piece quantities, healthy profit margins are achievable with proper positioning.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Quantity</th>
              <th>Cost/Unit</th>
              <th>Total FOB</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>100 pieces</td>
              <td>$10.50 - $12.50</td>
              <td>$1,050 - $1,250</td>
              <td>Design validation, streetwear drops</td>
            </tr>
            <tr>
              <td>200 pieces</td>
              <td>$9.00 - $11.00</td>
              <td>$1,800 - $2,200</td>
              <td>Small brand launch, seasonal collection</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>300 pieces</td>
              <td>$7.50 - $9.50</td>
              <td>$2,250 - $2,850</td>
              <td>Brand scaling, wholesale orders</td>
            </tr>
            <tr>
              <td>500 pieces</td>
              <td>$6.50 - $8.50</td>
              <td>$3,250 - $4,250</td>
              <td>Growing brand, wholesale expansion</td>
            </tr>
            <tr>
              <td>1,000 pieces</td>
              <td>$5.50 - $7.50</td>
              <td>$5,500 - $7,500</td>
              <td>Established brand, retail chains</td>
            </tr>
            <tr>
              <td>2,000+ pieces</td>
              <td>$4.50 - $6.50</td>
              <td>$9,000 - $13,000+</td>
              <td>Large scale production, major retail</td>
            </tr>
          </tbody>
          <caption>Prices are FOB Bangladesh for cotton fleece hoodies (280 GSM) with basic embroidery. Actual pricing depends on fabric weight, style (pullover vs zip), decoration complexity, and current market conditions.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Fabric Options Available at Small Batch Quantities</h2>
      </div>
      <div class="section__text">
        <p>Small batch hoodie production doesn't mean limited fabric options. SDF offers the full range of hoodie fabrics at 100-piece minimums, including premium materials that many manufacturers restrict to bulk orders only. Fleece weight selection impacts both cost and seasonal positioning | lighter weights for spring/summer, heavier weights for winter. All fabrics are tested for pilling resistance, shrinkage control, and durability regardless of order size.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>GSM</th>
              <th>Best For</th>
              <th>Small Batch Available?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Cotton Fleece (Lightweight)</td>
              <td>200 GSM</td>
              <td>Spring/season hoodies, layering</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Cotton Fleece (Midweight)</td>
              <td>280 GSM</td>
              <td>All-season hoodies, streetwear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Cotton Fleece (Heavyweight)</td>
              <td>350 GSM</td>
              <td>Winter hoodies, premium positioning</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>French Terry</td>
              <td>260-300 GSM</td>
              <td>Lightweight hoodies, athleisure</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Polyester Fleece</td>
              <td>280-320 GSM</td>
              <td>Performance hoodies, moisture-wicking</td>
              <td>Yes</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Organic Cotton Fleece (GOTS)</td>
              <td>280-320 GSM</td>
              <td>Sustainable brands, premium positioning</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Recycled Polyester Fleece (GRS)</td>
              <td>280-320 GSM</td>
              <td>Eco-friendly performance, outdoor</td>
              <td>Yes</td>
            </tr>
          </tbody>
          <caption>GSM = grams per square meter. Higher GSM indicates heavier, warmer fleece. All fabrics available at 100-piece minimum with full certification documentation.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Style Guide</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pullover vs Zip Hoodie at Small Batch</h2>
      </div>
      <div class="section__text">
        <p>Choosing between pullover and zip hoodies impacts both cost and customer preference. Pullover hoodies have lower production costs due to simpler construction (no zipper, no additional front panels), while zip hoodies offer versatility and layering options. Many streetwear brands offer both styles, with pullovers for core collections and zip hoodies for seasonal additions. At SDF, you can order 100 pieces split between styles or focus on one style based on your brand positioning.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Style</th>
              <th>Construction</th>
              <th>Cost Difference</th>
              <th>Best For</th>
              <th>Small Batch Available?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Pullover Hoodie</td>
              <td>Simpler, no zipper</td>
              <td>Base price</td>
              <td>Core collections, streetwear</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Zip Hoodie</td>
              <td>Zipper, front panels</td>
              <td>+$1.50-2.50 per piece</td>
              <td>Layering, versatility</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Pullover + Zip Mix</td>
              <td>Both styles</td>
              <td>Average of both</td>
              <td>Testing both styles</td>
              <td>Yes (100 pieces total)</td>
            </tr>
          </tbody>
          <caption>Cost differences are approximate and depend on fabric weight and zipper quality. Both styles can be ordered in the same 100-piece batch with 50 pieces each.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fleece Weight Guide</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Fleece Weight Selection for Your Brand</h2>
      </div>
      <div class="section__text">
        <p>Fleece weight determines both the seasonal positioning and perceived quality of your hoodies. Lightweight fleece (200 GSM) works for spring/season pieces and layering, while heavyweight fleece (350 GSM) commands premium positioning for winter collections. Midweight fleece (280 GSM) offers versatility for all-season wear. Selecting the right weight for your target market and price point is crucial for brand positioning and customer satisfaction.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Weight</th>
              <th>GSM Range</th>
              <th>Season</th>
              <th>Retail Positioning</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Lightweight</td>
              <td>180-220 GSM</td>
              <td>Spring/Summer</td>
              <td>Mid-range</td>
              <td>Layering, athleisure, gym wear</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Midweight</td>
              <td>260-300 GSM</td>
              <td>All-Season</td>
              <td>Premium</td>
              <td>Streetwear, everyday wear</td>
            </tr>
            <tr>
              <td>Heavyweight</td>
              <td>320-380 GSM</td>
              <td>Fall/Winter</td>
              <td>Luxury/Premium</td>
              <td>Winter collections, luxury brands</td>
            </tr>
          </tbody>
          <caption>Midweight fleece (280 GSM) is the most versatile choice for new brands. All weights available at 100-piece minimum with consistent quality.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Our Process</span>
        <div class="accent-line"></div>
        <h2 class="section__title">SDF Small Batch Process | From Design to Delivery</h2>
      </div>
      <div class="process">
        <div class="process__step">
          <div class="process__number">1</div>
          <div class="process__content">
            <h3 class="process__title">Submit Your Design Brief</h3>
            <p class="process__text">Include your hoodie design, fabric preference, fleece weight, pullover vs zip, size range, target quantity, and decoration requirements. We accept everything from rough sketches to finished tech packs. Submit via <a href="/contact/" style="color: var(--color-primary);">our sample request form</a> or contact form. Response within 24 hours.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">2</div>
          <div class="process__content">
            <h3 class="process__title">Receive Detailed Quote</h3>
            <p class="process__text">Quote includes fabric options, unit cost at target quantity, sampling fee, decoration costs, and both sample and bulk lead times. All costs itemized for transparency. Adjust quantity or specifications to optimize pricing for your brand.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">3</div>
          <div class="process__content">
            <h3 class="process__title">Sample Production | 10 to 14 Days</h3>
            <p class="process__text">One to three samples per design depending on complexity. Receive physical samples at your address for evaluation. Check fit across size range, fabric hand feel, embroidery or print quality, drawstring construction. Revisions included before bulk commitment.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">4</div>
          <div class="process__content">
            <h3 class="process__title">Place Bulk Order | From 100 Pieces</h3>
            <p class="process__text">Purchase order confirmation starts production. 30% deposit required, balance before shipment. Inline quality checks at cutting, sewing, and finishing stages. Production capacity: 30,000 hoodies per month per style. Your order never delayed by full production floor.</p>
          </div>
        </div>
        
        <div class="process__step">
          <div class="process__number">5</div>
          <div class="process__content">
            <h3 class="process__title">Final Inspection, Packing, and Shipment</h3>
            <p class="process__text">AQL final inspection checks fleece weight, pilling resistance, and embroidery placement before packing. Goods ship to your freight forwarder or direct warehouse with packing list, commercial invoice, certifications, and test reports included.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Small Batch Hoodie FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What is the minimum order quantity for small batch hoodies?</h3>
          <p class="faq__answer">Our small batch minimum is 100 pieces per style. This applies per colorway and size range, allowing you to test hoodie designs with manageable inventory and reduced financial risk. You can split 100 pieces between pullover and zip styles if needed.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">How long does small batch hoodie production take?</h3>
          <p class="faq__answer">Small batch hoodie production takes 30-40 days from fabric receipt. Sampling requires 10-14 days before bulk commitment. Fabric development adds 5-10 days for custom materials. Rush production available at additional cost for urgent deadlines.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Can I order both pullover and zip hoodies in small batch?</h3>
          <p class="faq__answer">Yes. You can order 100 pieces split between pullover and zip styles, or focus on one style. Each style counts toward the minimum. Mix styles to test different designs with your target market before committing to larger quantities of each.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fleece weights are available for small batch hoodies?</h3>
          <p class="faq__answer">200 GSM lightweight fleece for spring/summer, 280 GSM midweight for all-season, 350 GSM heavyweight for winter. All weights available at 100-piece minimum with same quality standards. Midweight (280 GSM) recommended for new brands.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you provide embroidery for small batch hoodies?</h3>
          <p class="faq__answer">Yes. Embroidery available from 50 pieces. Left chest logos, back designs, sleeve embroidery all supported. Screen print also available for larger designs. Both decoration methods included in production with no extra setup fees.</p>
        </div>
        
