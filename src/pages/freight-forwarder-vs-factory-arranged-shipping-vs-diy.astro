---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Freight Forwarder vs Factory-Arranged Shipping vs DIY";
const pageDescription = "Who is actually liable when a shipment goes wrong, real cost tradeoffs, and which logistics setup fits your order size and import experience level.";
const lastReviewed = "July 23, 2026";

const modelRows = [
  {
    name: "Your Own Freight Forwarder",
    whoArranges: "You hire an independent forwarder directly, typically under FOB terms",
    whoLiable: "Your forwarder answers to you directly — the most direct accountability chain of the three",
    cost: "Often the most competitive freight rate, since you can shop and negotiate directly",
    bestFor: "Buyers past their first few orders who want cost control and are willing to manage one more relationship"
  },
  {
    name: "Factory-Arranged Shipping",
    whoArranges: "The factory's own logistics network handles it, typically under CIF or DDP terms",
    whoLiable: "The factory's forwarder answers to the factory, not to you directly — if something goes wrong, your leverage runs through the factory relationship",
    cost: "Usually a premium over arranging it yourself, since the factory is pricing in convenience and their own margin",
    bestFor: "First-time importers who want one point of contact and are willing to pay for that simplicity"
  },
  {
    name: "Fully In-House Logistics",
    whoArranges: "Your own team manages customs brokerage and delivery directly, cutting out both the factory's and any third-party forwarder's margin",
    whoLiable: "You — full control, full responsibility, no intermediary to lean on if something goes wrong",
    cost: "Potentially the lowest cost per shipment, but only once volume justifies the overhead of maintaining that expertise",
    bestFor: "High-volume, experienced importers already running frequent shipments"
  }
];

const scenarioRows = [
  { situation: "This is your first or second import order", need: "Factory-arranged shipping (CIF/DDP) — pay the premium for the simplicity while you learn the process" },
  { situation: "You've done a handful of orders and want to control cost", need: "Your own freight forwarder under FOB terms — the standard recommended setup for growing brands" },
  { situation: "You're shipping frequently and at real volume", need: "Consider fully in-house logistics — the overhead starts paying for itself" },
  { situation: "You want the factory to bear responsibility if the shipment is delayed or damaged in transit", need: "Factory-arranged shipping under DDP — risk stays with the factory until it reaches your door" },
  { situation: "You want to negotiate your own freight rates and choose your own broker", need: "Your own freight forwarder — factory-arranged shipping takes that control away" },
  { situation: "The order is urgent and sea freight's transit time won't work", need: "Air freight, arranged either way — but note this is a separate freight-mode decision from who arranges it, and air freight costs substantially more than ocean regardless of who books it" }
];

const mistakeFaqs = [
  {
    question: "Isn't factory-arranged shipping just easier, so why would I ever arrange it myself?",
    answer: "It is easier, and that's exactly what you're paying for. The tradeoff is cost and leverage: the factory is pricing in their own margin on freight and insurance, and if something goes wrong in transit, you're negotiating through the factory relationship rather than directly with the party responsible. For a first order, that simplicity is often worth the premium. Once you've done a few orders and understand the process, arranging your own forwarder usually saves real money."
  },
  {
    question: "If I hire my own freight forwarder, does the factory still have any responsibility?",
    answer: "This is exactly what Incoterms exist to define. Under FOB terms, the factory's responsibility generally ends once the goods are loaded at the port of origin — everything after that (ocean freight, insurance, customs, final delivery) is yours to arrange and be responsible for. See our full breakdown of FOB, CIF, and DDP for the precise risk-transfer points."
  },
  {
    question: "How much does a freight forwarder actually cost compared to letting the factory arrange it?",
    answer: "It varies by route, volume, and season, so get an actual quote rather than assuming a fixed number — but the general pattern holds: an independent forwarder you've negotiated with directly is usually cheaper than a factory-arranged CIF or DDP price for the same route, because the factory is adding their own margin on top of whatever rate they get. The gap tends to be more noticeable at higher volumes."
  },
  {
    question: "What does a customs broker actually do, and do I need one if I arrange my own forwarder?",
    answer: "Yes, generally — a customs broker (often part of your forwarder's service, sometimes separate) prepares import documentation, handles HTS code classification, and communicates with customs on your behalf. Broker fees typically run $100-300 per shipment, a small cost against the delays and penalties a documentation error can cause. Our customs clearance guide covers this in more depth."
  },
  {
    question: "At what order volume does in-house logistics actually start making sense?",
    answer: "There's no single universal threshold — it depends on how many shipments you're running per year and how much internal expertise you're willing to build. As a rough signal, once you're shipping frequently enough that forwarder and broker fees are becoming a meaningful line item, and you have someone capable of managing customs compliance directly, it's worth running the numbers. For most growing brands, that point comes well after the first dozen or so orders, not before."
  },
  {
    question: "What's the difference between demurrage and detention, and who pays them?",
    answer: "Both are daily penalty fees, but for different things. Demurrage is charged by the shipping line if your container sits at the port past its free period without being picked up. Detention is charged if the container itself isn't returned to the shipping line after being unloaded at your facility. Whoever is responsible for customs clearance and delivery under your Incoterm — you or the factory — is generally the one exposed to these charges if delays happen on their end."
  },
  {
    question: "Do I need cargo insurance if I'm arranging my own freight forwarder?",
    answer: "It's not automatically included, so yes, you should arrange it yourself unless your Incoterm already covers it. CIF includes a minimum level of insurance by definition; FOB and most other terms leave that decision to you. Given that the premium is small relative to a full container's value, most experienced importers treat it as a default, not an optional extra."
  },
  {
    question: "Should I use air freight instead of ocean freight, and does that change who arranges shipping?",
    answer: "Air freight versus ocean freight is a separate decision from who books the logistics — you can arrange air freight yourself or have the factory arrange it, the same as with ocean freight. The real tradeoff is cost versus speed: air freight typically costs several times more per unit but can cut transit time from weeks to days, which matters for urgent or time-sensitive orders regardless of which party is doing the booking."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mistakeFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Freight Forwarder vs. Factory-Arranged Shipping vs. Your Own Logistics",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "jobTitle": "Founder & CEO, SDF Clothing",
    "url": "https://sdfltd.com/about"
  },
  "publisher": { "@type": "Organization", "name": "SDF Clothing", "url": "https://sdfltd.com" },
  "datePublished": "2026-07-23",
  "dateModified": "2026-07-23",
  "mainEntityOfPage": "https://sdfltd.com/freight-forwarder-vs-factory-arranged-shipping-vs-diy/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
    { "@type": "ListItem", "position": 2, "name": "Incoterms Explained", "item": "https://sdfltd.com/insights/incoterms-explained" },
    { "@type": "ListItem", "position": 3, "name": "Freight Forwarder vs Factory-Arranged vs DIY", "item": "https://sdfltd.com/freight-forwarder-vs-factory-arranged-shipping-vs-diy/" }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="website">

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<section style="padding: 6rem 0 3rem; background:#000;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">Logistics Decision Guide</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1.25rem;line-height:1.2;">
      Freight Forwarder vs. Factory-Arranged Shipping vs. Your Own Logistics
    </h1>
    <p style="color:#ccc;max-width:760px;line-height:1.8;font-size:0.95rem;">
      This isn't the same question as choosing an Incoterm — it's about who actually executes the logistics once the terms are set, and that choice changes both your cost and who you're negotiating with if something goes wrong. For the legal risk-transfer mechanics behind FOB, CIF, and DDP, see our <a href="/insights/incoterms-explained" style="color:#e00;text-decoration:none;">Incoterms guide</a>. This page is about the practical operational choice sitting on top of those terms.
    </p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">The Three Setups, Side by Side</h2>

    <div class="model-table-scroll">
      <table class="model-table">
        <colgroup>
          <col style="width:18%;" />
          <col style="width:24%;" />
          <col style="width:28%;" />
          <col style="width:30%;" />
        </colgroup>
        <thead>
          <tr>
            <th>Setup</th>
            <th>Who arranges it</th>
            <th>Who's liable if things go wrong</th>
            <th>Cost pattern</th>
          </tr>
        </thead>
        <tbody>
          {modelRows.map(row => (
            <tr>
              <td class="model-name">{row.name}</td>
              <td>{row.whoArranges}</td>
              <td>{row.whoLiable}</td>
              <td>{row.cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="model-cards">
      {modelRows.map(row => (
        <div class="model-card">
          <p class="model-card-name">{row.name}</p>
          <p class="model-card-row"><span>Who arranges it</span>{row.whoArranges}</p>
          <p class="model-card-row"><span>Who's liable</span>{row.whoLiable}</p>
          <p class="model-card-row"><span>Cost pattern</span>{row.cost}</p>
          <p class="model-card-row"><span>Best for</span>{row.bestFor}</p>
        </div>
      ))}
    </div>
    <p style="color:#888;font-size:0.8rem;margin-top:1rem;">Last reviewed {lastReviewed}. SDF quotes FOB Chittagong as standard and can arrange CIF or DDP shipping on request — see our <a href="/insights/incoterms-explained" style="color:#e00;text-decoration:none;">Incoterms guide</a> for exact risk-transfer points under each term.</p>
    <p style="color:#888;font-size:0.8rem;margin-top:0.5rem;">Risk-transfer definitions referenced throughout this page follow Incoterms® 2020, published by the International Chamber of Commerce (ICC) and current through at least 2026, with the next scheduled revision expected around 2030.</p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">The Honest Pros and Cons of Each</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Your Own Freight Forwarder</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Best cost control, direct relationship and leverage if something goes wrong, freedom to shop rates</p>
        <p style="color:#f88;font-size:0.82rem;">− One more relationship to manage, requires enough experience to evaluate forwarder quality yourself</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Factory-Arranged Shipping</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Simplest for a first order, one point of contact, no forwarder research required</p>
        <p style="color:#f88;font-size:0.82rem;">− Real cost premium, less direct leverage since the forwarder answers to the factory, not you</p>
      </div>
      <div style="border:1px solid #1a1a1a;border-top:2px solid #e00;background:#050505;padding:1.25rem;">
        <p style="color:#fff;font-weight:600;margin-bottom:0.75rem;">Fully In-House Logistics</p>
        <p style="color:#8f8;font-size:0.82rem;margin-bottom:0.4rem;">+ Lowest potential cost per shipment once volume justifies it, full control end to end</p>
        <p style="color:#f88;font-size:0.82rem;">− Significant overhead to build and maintain, poor fit for anything but high, frequent volume</p>
      </div>
    </div>
  </div>
</section>

<style>
  .model-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .model-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.78rem;
    color: #ddd;
  }
  .model-table thead tr { border-bottom: 1px solid #e00; }
  .model-table th { text-align: left; padding: 0.55rem 0.5rem; color: #fff; font-size: 0.72rem; }
  .model-table tbody tr { border-bottom: 1px solid #1a1a1a; }
  .model-table td {
    padding: 0.6rem 0.5rem;
    vertical-align: top;
    word-wrap: break-word;
    overflow-wrap: break-word;
    line-height: 1.5;
  }
  .model-table td.model-name { color: #fff; font-weight: 600; }

  .model-cards { display: none; }

  @media (max-width: 760px) {
    .model-table-scroll { display: none; }
    .model-cards { display: block; }
    .model-card {
      border: 1px solid #1a1a1a;
      border-top: 2px solid #e00;
      background: #050505;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }
    .model-card-name { color: #fff; font-weight: 600; font-size: 1rem; margin-bottom: 0.75rem; }
    .model-card-row { color: #ccc; font-size: 0.85rem; line-height: 1.7; margin-bottom: 0.6rem; }
    .model-card-row span {
      color: #e00; font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;
      display: block; margin-bottom: 0.15rem;
    }
  }

  @media (min-width: 761px) and (max-width: 950px) {
    .model-table { font-size: 0.7rem; }
    .model-table th { font-size: 0.62rem; padding: 0.45rem 0.35rem; }
    .model-table td { padding: 0.45rem 0.35rem; }
  }
</style>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Which One Do You Actually Need?</h2>
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:0.85rem;color:#ddd;margin-bottom:1.5rem;min-width:480px;">
        <thead>
          <tr style="border-bottom:1px solid #e00;">
            <th style="text-align:left;padding:0.6rem;color:#fff;">If your situation is...</th>
            <th style="text-align:left;padding:0.6rem;color:#fff;">You need</th>
          </tr>
        </thead>
        <tbody>
          {scenarioRows.map(row => (
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:0.6rem;">{row.situation}</td>
              <td style="padding:0.6rem;">{row.need}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 style="font-size:1.1rem;color:#fff;margin-bottom:1rem;">A Common Growth Path</h3>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:2rem;">A pattern worth knowing: many brands start with factory-arranged DDP shipping for their first order or two, paying the premium to remove logistics from the list of things they're learning at once. Once they understand the process — how customs clearance works, what a forwarder actually does, where delays tend to happen — they switch to FOB terms and arrange their own forwarder, capturing the cost savings once the learning curve is behind them. Very few buyers start with fully in-house logistics; it's usually where high-volume importers end up, not where anyone begins.</p>

    <h3 style="font-size:1.1rem;color:#fff;margin-bottom:1rem;">Liability at Each Stage of the Journey</h3>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:1rem;">A shipment passes through several distinct stages — factory, pickup, port of origin, ocean or air freight, customs, final delivery — and who's responsible shifts at each one depending on the Incoterm and who's arranged the logistics:</p>
    <ul style="color:#ddd;font-size:0.9rem;line-height:2;padding-left:1.2rem;margin-bottom:2rem;">
      <li><strong style="color:#fff;">Factory to pickup:</strong> the factory, under every setup — this part doesn't change</li>
      <li><strong style="color:#fff;">Loading at origin port:</strong> risk generally transfers to you here under FOB, but stays with the factory under CIF/DDP</li>
      <li><strong style="color:#fff;">Ocean or air freight:</strong> whoever booked the freight (you or the factory) is the one with direct leverage over the carrier if there's damage or delay</li>
      <li><strong style="color:#fff;">Customs clearance at destination:</strong> your responsibility under FOB and CIF; the factory's under DDP</li>
      <li><strong style="color:#fff;">Final delivery to your door:</strong> yours to arrange under FOB and CIF; included under DDP</li>
    </ul>

    <h3 style="font-size:1.1rem;color:#fff;margin-bottom:1rem;">Hidden Costs That Don't Show Up in the Headline Quote</h3>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:1rem;">Whichever setup you choose, watch for these — they rarely appear in an initial quote:</p>
    <ul style="color:#ddd;font-size:0.9rem;line-height:2;padding-left:1.2rem;">
      <li><strong style="color:#fff;">Demurrage</strong> — a daily fee charged by the shipping line if your container isn't picked up from the port within the free period</li>
      <li><strong style="color:#fff;">Detention</strong> — a separate daily fee if the container itself isn't returned to the shipping line on time after being unloaded</li>
      <li><strong style="color:#fff;">Port and terminal handling charges</strong> — often not itemized in an initial freight quote, but real and billed separately</li>
      <li><strong style="color:#fff;">Documentation fees</strong> — charged by forwarders or brokers for preparing bills of lading, certificates of origin, and customs paperwork</li>
      <li><strong style="color:#fff;">Cargo insurance</strong> — not automatically included unless the Incoterm requires it (CIF includes minimum coverage; FOB and most others don't)</li>
    </ul>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Common Mistakes — and the Myths Behind Them</h2>
    <div style="border:1px solid #1a1a1a;">
      <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> Factory-arranged shipping means the factory takes all the risk</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> It depends entirely on the Incoterm attached to it. Factory-arranged shipping under CIF still transfers risk to you once goods are loaded at origin — only DDP keeps the factory responsible all the way to your door. "Factory-arranged" is about who books the logistics, not automatically who bears the risk.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> Arranging your own freight forwarder is only for large, experienced importers</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> It's the standard recommended setup once a buyer has done even a couple of orders — most Bangladesh manufacturers, including SDF, quote FOB as their default precisely because it's the common, expected arrangement, not a niche advanced option.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Myth:</span> A cheaper freight quote is always the better choice</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Fact:</span> A forwarder or broker with genuine garment-import experience and familiarity with your specific HTS codes can prevent costly clearance delays — sometimes worth more than the cheapest quoted rate. Cost and reliability aren't the same thing.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;border-top:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Mistake:</span> Skipping cargo insurance to save a small fee</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Reality:</span> Insurance isn't automatic under most Incoterms — FOB and DDP don't require it, only CIF does, and even then often at minimum coverage. A few hundred dollars in premium against the full value of a container is rarely the place to cut costs.</p>
      </div>
      <div style="padding:1.25rem 1.5rem;border-top:1px solid #1a1a1a;">
        <p style="color:#fff;font-size:0.9rem;margin-bottom:0.4rem;"><span style="color:#e00;">Mistake:</span> Signing a purchase order before confirming which Incoterm applies</p>
        <p style="color:#bbb;font-size:0.85rem;line-height:1.7;margin:0;"><span style="color:#888;">Reality:</span> The Incoterm determines who's paying for freight, insurance, and customs, and where risk actually transfers — confirm it in writing before the order is placed, not after a dispute makes the ambiguity expensive.</p>
      </div>
    </div>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Where SDF Stands — An Honest Self-Assessment</h2>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;margin-bottom:0.75rem;"><strong>What we can back up:</strong> we quote FOB Chittagong as our standard, letting you arrange your own freight forwarder and keep control over that cost — but we can also arrange CIF or DDP shipping on request if you'd rather have us handle logistics for a first order. Full mechanics of each term are on our <a href="/insights/incoterms-explained" style="color:#e00;text-decoration:none;">Incoterms page</a>, and landed-cost math on our <a href="/insights/how-to-calculate-landed-cost" style="color:#e00;text-decoration:none;">landed cost guide</a>.</p>
    <p style="color:#ddd;line-height:1.8;font-size:0.9rem;">
      <strong>Where the honest caveat sits:</strong> if you ask us to arrange CIF or DDP shipping, that convenience comes at a real premium over arranging your own forwarder — we're not going to pretend it's the same price. If you're comfortable managing that piece yourself, FOB will generally save you money.
    </p>
    <p style="color:#888;font-size:0.8rem;margin-top:1rem;">This page is general guidance, not customs or legal advice — confirm specific duty rates, documentation requirements, and contractual terms with your own broker, forwarder, or trade counsel before finalizing an order.</p>
  </div>
</section>

<section style="padding: 3rem 0 5rem; background:#000; border-top:1px solid #1a1a1a;">
  <div class="container" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <h2 style="font-size:1.6rem;font-weight:300;color:#fff;margin-bottom:2rem;">Questions Buyers Actually Ask</h2>
    <div style="background:#000;border:1px solid rgba(255,255,255,0.1);">
      {mistakeFaqs.map((faq, index) => (
        <details style="border-bottom:1px solid rgba(255,255,255,0.1);" open={index === 0}>
          <summary style="padding:1.5rem;cursor:pointer;color:#fff;font-size:0.95rem;font-weight:500;display:flex;justify-content:space-between;align-items:center;list-style:none;gap:1rem;">
            {faq.question}
            <span style="font-size:1.5rem;color:#e00;flex-shrink:0;">+</span>
          </summary>
          <div style="padding:0 1.5rem 1.5rem;">
            <p style="color:#bbb;line-height:1.8;font-size:0.9rem;margin:0;">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
