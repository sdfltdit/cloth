---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const pageTitle = "Terms of Service | SDF Clothing";
const pageDescription = "Terms of service for SDF Clothing  clothing manufacturers in Bangladesh. Usage terms, intellectual property, and service conditions.";
---
<BaseLayout title={pageTitle} description={pageDescription}>

<section style="padding:5rem 0 3rem;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#555;"><a href="/" style="color:#888;text-decoration:none;">Home</a><span style="margin:0 0.5rem;color:#333;">›</span>Terms of Service</p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Legal</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;">Terms of Service</h1>
    <p style="color:#888;font-size:0.88rem;">Last updated: January 2025</p>
  </div>
</section>

<section style="padding:4rem 0;">
  <div class="container">
    <div style="max-width:760px;display:flex;flex-direction:column;gap:2.5rem;">

      <div style="border-left:2px solid #cc0000;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">1. Acceptance of Terms</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">By accessing or using sdfltd.com and its tools (Price Calculator, Lead Time Calculator, EU Readiness Checker), you agree to be bound by these Terms of Service. If you do not agree, please do not use this website.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">2. Use of Services</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">This website and its tools are provided for informational and business inquiry purposes. Price estimates, lead time calculations, and compliance scores are indicative only and do not constitute a formal quotation or legal advice. All formal quotes must be confirmed in writing by SDF Clothing.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">3. Intellectual Property</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">All content on this website  including text, tools, design, and data  is the property of SDF Clothing Ltd. You may not reproduce, distribute, or create derivative works without written permission.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">4. NDA & Confidentiality</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">SDF Clothing treats all client inquiries, tech packs, designs, and order details as strictly confidential. Mutual NDAs are available upon request before any design or specification sharing.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">5. Limitation of Liability</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">SDF Clothing is not liable for any indirect, incidental, or consequential damages arising from use of this website or its tools. All manufacturing agreements are governed by separate written contracts.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">6. Governing Law</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">These terms are governed by the laws of Bangladesh. Any disputes shall be subject to the jurisdiction of the courts of Dhaka, Bangladesh.</p>
      </div>

      <div style="border-left:2px solid #1a1a1a;padding-left:1.5rem;">
        <h2 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">7. Contact</h2>
        <p style="color:#ccc;font-size:0.88rem;line-height:1.9;">For any questions regarding these terms, please <a href="/contact" style="color:#fff;border-bottom:1px solid #cc0000;text-decoration:none;">contact us</a> or reach us via <a href="https://wa.me/8801911733226" target="_blank" rel="noopener noreferrer" style="color:#fff;border-bottom:1px solid #cc0000;text-decoration:none;">WhatsApp</a>.</p>
      </div>

    </div>
  </div>
</section>

</BaseLayout>
