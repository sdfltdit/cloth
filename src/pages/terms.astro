---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Terms & Conditions | SDF Clothing";
const pageDescription = "SDF Clothing's terms and conditions — covering orders, payment, sampling, delivery, intellectual property, and liability for international garment manufacturing clients.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Terms & Conditions",
		"description": "SDF Clothing Ltd terms and conditions for international garment manufacturing, sampling, payment, and export services.",
		"url": "https://sdfltd.com/terms",
		"dateModified": "2026-05-07",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
				{ "@type": "ListItem", "position": 2, "name": "Terms & Conditions", "item": "https://sdfltd.com/terms" }
			]
		}
	}
	</script>

	<!-- Main Terms & Conditions Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Terms & Conditions</h1>
				<p class="text-white/70 mb-2">Last updated: May 7, 2026 | Version 1.0</p>
			</div>

			<!-- Notice Box -->
			<div style="border: 1px solid #333; background: #0a0a0a; padding: 1.5rem; margin-bottom: 2rem;">
				<p style="margin: 0; color: #fff; font-size: 0.95rem; line-height: 1.7;">
					These Terms & Conditions govern all business relationships, sample requests, orders, and transactions between SDF Clothing Ltd and its clients. By submitting an enquiry, requesting samples, or placing an order, you agree to be bound by these terms. Please read them carefully before engaging our services.
				</p>
			</div>

			<div class="prose prose-invert max-w-none" style="font-size: 0.95rem; line-height: 1.9; color: #fff;">
				
				<!-- SECTION 1 — ABOUT SDF CLOTHING LTD -->
				<h2 id="about-sdf-clothing" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 1 — ABOUT SDF CLOTHING LTD
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd is a registered garment manufacturer and exporter based in Bangladesh, operating in full compliance with Bangladesh's national garment industry regulations and international export standards. We provide end-to-end garment manufacturing services including OEM production, private label manufacturing, CMT (Cut, Make, Trim) services, and custom sample development for clients worldwide.
				</p>
				<p style="margin-bottom: 2rem;">
					Our operations conform to internationally recognised ethical manufacturing and compliance frameworks. Full compliance documentation is available to verified business partners upon written request following successful client qualification.
				</p>
				<p style="margin-bottom: 2rem;">
					<strong>Registered address:</strong> House 125, Road 01, Baridhara DOHS, Dhaka-1212, Bangladesh<br>
					<strong>Website:</strong> https://sdfltd.com<br>
					<strong>Business enquiries:</strong> via <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a> at /contact only
				</p>

				<!-- SECTION 2 — ACCEPTANCE OF TERMS -->
				<h2 id="acceptance-of-terms" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 2 — ACCEPTANCE OF TERMS
				</h2>
				<p style="margin-bottom: 2rem;">
					By accessing our website, submitting a contact or sample request form, or entering into any business correspondence with SDF Clothing Ltd, you acknowledge that you have read, understood, and agree to be bound by these Terms & Conditions in their entirety.
				</p>
				<p style="margin-bottom: 2rem;">
					These terms apply to:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">All website visitors</li>
					<li style="margin-bottom: 0.75rem;">All prospective and active clients</li>
					<li style="margin-bottom: 0.75rem;">All sample requesters</li>
					<li style="margin-bottom: 0.75rem;">All confirmed order clients</li>
					<li style="margin-bottom: 0.75rem;">All business partners and agents</li>
				</ul>
				<p style="margin-bottom: 2rem;">
					If you do not agree to these terms, you must not use our website or engage our services.
				</p>

				<!-- SECTION 3 — SERVICES WE PROVIDE -->
				<h2 id="services-we-provide" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 3 — SERVICES WE PROVIDE
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd offers the following manufacturing and export services:
				</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.1 OEM Manufacturing</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Full original equipment manufacturing for brands and retailers — production based on client-supplied specifications, tech packs, and approved samples.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.2 Private Label Manufacturing</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">End-to-end production with client branding, labels, hang tags, and packaging as specified by the client.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.3 CMT Services</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Cut, Make, and Trim services for clients who supply their own fabric and materials.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.4 Sample Development</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Custom sample creation based on client tech packs, reference samples, or design briefs prior to bulk order confirmation.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.5 Export Services</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Full export documentation, customs compliance, and international shipping coordination under agreed Incoterms.</p>

				<!-- SECTION 4 — SAMPLING POLICY -->
				<h2 id="sampling-policy" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 4 — SAMPLING POLICY
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>4.1 Sample Request Process</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Sample development begins only after the client has submitted complete specifications including tech pack, fabric requirements, colour references, label details, and any other relevant documentation. Incomplete submissions will delay the sampling process.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.2 Sample Development Deposit</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">A non-refundable deposit of 30% of the confirmed bulk order value (or a mutually agreed sample development fee for clients without a confirmed order value) is required before any sample development commences. This deposit serves as a commitment of genuine intent and covers initial material sourcing and production costs.</p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">This deposit policy exists to protect both parties. We have found that without a deposit requirement, a significant proportion of sample requests do not convert to orders, resulting in unrecovered costs for both material sourcing and production time. The deposit ensures we can allocate dedicated resources to your development.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.3 Deposit Credit</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">The 30% deposit paid for sample development is fully credited toward your confirmed bulk order value. It is not an additional charge — it is an advance payment against your production order.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.4 Non-Refundable Nature</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">The sample development deposit is non-refundable in all circumstances, including if the client decides not to proceed with a bulk order after samples are completed, if the client requests design changes that require re-sampling, or if the client does not respond within 60 days of sample completion.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.5 Sample Ownership</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Physical samples remain the property of SDF Clothing Ltd until the sample development deposit is received in full. Upon receipt of payment, completed samples are shipped to the client at the client's expense.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.6 Sample Shipping</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All sample shipping costs are borne by the client. SDF Clothing Ltd will provide a shipping cost estimate prior to dispatch. The client must provide a valid shipping account number or prepay shipping charges before samples are dispatched.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.7 Revisions</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Up to two rounds of sample revisions are included within the sample development process. Additional revision rounds may be subject to additional development fees, which will be communicated and agreed in writing before commencing.</p>

				<!-- SECTION 5 — ORDER TERMS -->
				<h2 id="order-terms" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 5 — ORDER TERMS
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>5.1 Minimum Order Quantity</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">The minimum order quantity (MOQ) is 300 pieces per style. A maximum of 2 styles may be combined within a single order, with up to 4 colour variations permitted per style.</p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Orders below the MOQ will not be accepted. Clients requiring smaller quantities are encouraged to contact us to discuss options for future seasons as their volume scales.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.2 Order Confirmation</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">An order is confirmed only upon receipt of:</p>
				<ul style="margin-bottom: 2rem; padding-left: 2.5rem;">
					<li style="margin-bottom: 0.75rem;">A signed Purchase Order (PO) or written order confirmation from the client</li>
					<li style="margin-bottom: 0.75rem;">Receipt of the required advance payment (see Section 6 — Payment Terms)</li>
					<li style="margin-bottom: 0.75rem;">Approval of the pre-production sample (PP sample) where applicable</li>
				</ul>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Verbal agreements, email discussions, and preliminary quotations do not constitute confirmed orders.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.3 Order Changes</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Changes to confirmed orders — including style, colour, quantity, fabric, or delivery date — must be submitted in writing via our <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a>. Changes may affect pricing and lead times. SDF Clothing Ltd reserves the right to accept or decline changes depending on the production stage at which the change is requested.</p>

				<p style="margin-bottom: 1.5rem;"><strong>5.4 Order Cancellation</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Once production has commenced, order cancellation is not permitted. If a client requests cancellation before production commencement, the advance payment (30% deposit) is forfeited. Any materials already sourced or cut will be charged to the client at cost.</p>

				<!-- SECTION 6 — PAYMENT TERMS -->
				<h2 id="payment-terms" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 6 — PAYMENT TERMS
				</h2>
				<p style="margin-bottom: 2rem;"><strong>6.1 Payment Structure by Order Value</strong><br>SDF Clothing Ltd operates a tiered payment method system:</p>
				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; background: #000; border: 1px solid #333;">
						<thead>
							<tr style="border-bottom: 1px solid #333;">
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Order Value</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Preferred Method</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Reason</th>
							</tr>
						</thead>
						<tbody>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">USD 30,000 and above</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Letter of Credit (LC)</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Documentary security and international banking protection</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">USD 5,000 to USD 29,999</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Telegraphic Transfer (TT)</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Reliable bank-to-bank settlement for mid-value orders</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Below USD 5,000</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">WorldRemit</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Faster settlement, reduced banking overhead</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p style="margin-bottom: 1.5rem;"><strong>6.2 LC Payment Terms</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">LC must be issued by a reputable internationally recognised bank</li>
					<li style="margin-bottom: 0.75rem;">LC terms must be confirmed in writing and agreed by both parties before issuance</li>
					<li style="margin-bottom: 0.75rem;">All LC charges outside Bangladesh are to the account of the client (buyer)</li>
					<li style="margin-bottom: 0.75rem;">LC must be received and verified by SDF Clothing Ltd's bank before production commences</li>
					<li style="margin-bottom: 0.75rem;">LC must be valid for a minimum of 21 days beyond the scheduled shipment date</li>
				</ul>
				<p style="margin-bottom: 1.5rem;"><strong>6.3 TT Payment Terms</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">30% advance payment required prior to production commencement</li>
					<li style="margin-bottom: 0.75rem;">Remaining 70% payable against copy of shipping documents sent via email</li>
					<li style="margin-bottom: 0.75rem;">Original documents released upon receipt of final payment</li>
					<li style="margin-bottom: 0.75rem;">TT charges outside Bangladesh are to the account of the client</li>
				</ul>
				<p style="margin-bottom: 1.5rem;"><strong>6.4 WorldRemit Payment Terms</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Accepted exclusively for orders with a total value below USD 5,000</li>
					<li style="margin-bottom: 0.75rem;">Full payment required prior to sample development or production commencement</li>
					<li style="margin-bottom: 0.75rem;">WorldRemit privacy policy: <a href="https://www.worldremit.com/en/privacy-policy" target="_blank" rel="noopener noreferrer" style="color:#fff;text-decoration:underline;">https://www.worldremit.com/en/privacy-policy</a></li>
				</ul>
				<p style="margin-bottom: 1.5rem;"><strong>6.5 Payment Reference & Dispute Resolution</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All clients must retain their payment reference number. Disputes must be raised within 30 days via our <a href="/contact" style="color:#fff;text-decoration:underline;">Contact Form</a>.</p>
				<p style="margin-bottom: 1.5rem;"><strong>6.6 Late Payment</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Late payment may result in suspension of production, cancellation with forfeiture of advance payments, and recovery of costs incurred.</p>
				<p style="margin-bottom: 1.5rem;"><strong>6.7 Currency</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All prices are quoted and invoiced in United States Dollars (USD) unless otherwise agreed in writing.</p>

				<!-- SECTION 7 — PRICING & QUOTATIONS -->
				<h2 id="pricing-quotations" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 7 — PRICING & QUOTATIONS
				</h2>
				<p style="margin-bottom: 1.5rem;"><strong>7.1 Quotation Validity</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All price quotations provided by SDF Clothing Ltd are valid for 30 days from the date of issue unless otherwise stated.</p>
				<p style="margin-bottom: 1.5rem;"><strong>7.2 Price Inclusions</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Quotations clearly state the Incoterms basis. The client is responsible for understanding what costs are included and excluded.</p>
				<p style="margin-bottom: 1.5rem;"><strong>7.3 Price Revisions</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">SDF Clothing Ltd reserves the right to revise pricing in the event of significant changes in raw material costs, energy costs, or currency exchange rates.</p>

				<!-- SECTION 8 — DELIVERY TERMS & INCOTERMS -->
				<h2 id="delivery-terms" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 8 — DELIVERY TERMS & INCOTERMS
				</h2>
				<p style="margin-bottom: 2rem;"><strong>8.1 Supported Incoterms</strong><br>SDF Clothing Ltd supports the following Incoterms 2020:</p>
				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; background: #000; border: 1px solid #333;">
						<thead>
							<tr style="border-bottom: 1px solid #333;">
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Incoterm</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Full Name</th>
								<th style="background: #111; color: white; padding: 0.75rem 1rem; text-align: left; font-weight: 600;">Client Responsibility Begins</th>
							</tr>
						</thead>
						<tbody>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">EXW</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Ex Works</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At our factory gate in Bangladesh</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">FCA</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Free Carrier</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At named carrier/port in Bangladesh</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">FOB</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Free On Board</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Once goods are on board the vessel at Chittagong Port</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">CFR</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cost and Freight</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At destination port (freight paid by SDF Clothing)</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">CIF</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Cost, Insurance & Freight</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At destination port (freight and insurance paid by SDF Clothing)</td>
							</tr>
							<tr style="background: #000; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">DAP</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Delivered at Place</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At named destination (duties payable by client)</td>
							</tr>
							<tr style="background: #0a0a0a; border-bottom: 1px solid #222;">
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">DDP</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">Delivered Duty Paid</td>
								<td style="padding: 0.75rem 1rem; border-bottom: 1px solid #222;">At named destination (all costs including duties paid by SDF Clothing)</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p style="margin-bottom: 1.5rem;"><strong>8.2 Lead Times</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Standard production lead times are communicated at order confirmation. Typical lead times range from 60 to 120 days from PP sample approval and advance payment receipt.</p>
				<p style="margin-bottom: 1.5rem;"><strong>8.3 Delivery Delays</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">SDF Clothing Ltd will make every reasonable effort to meet agreed delivery dates. We are not liable for delays caused by force majeure events, port congestion, shipping line delays, or customs clearance issues beyond our control.</p>
				<p style="margin-bottom: 1.5rem;"><strong>8.4 Shipping Documentation</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Standard export documentation includes commercial invoice, packing list, bill of lading or airway bill, certificate of origin, and any additional documents required by the destination country.</p>

				<!-- SECTION 9 — QUALITY CONTROL -->
				<h2 id="quality-control" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 9 — QUALITY CONTROL
				</h2>
				<p style="margin-bottom: 1.5rem;"><strong>9.1 In-Line Inspection</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Our quality control team conducts in-line inspections throughout the production process, including fabric inspection upon receipt, in-process inspection at critical production stages, and final inspection prior to packing.</p>
				<p style="margin-bottom: 1.5rem;"><strong>9.2 Third-Party Inspection</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Clients are welcome to arrange third-party quality inspections at our facility prior to shipment. Inspection appointments must be arranged a minimum of 7 days in advance. Inspection costs are borne by the client.</p>
				<p style="margin-bottom: 1.5rem;"><strong>9.3 Quality Disputes</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">In the event of a quality dispute, the client must notify SDF Clothing Ltd in writing within 14 days of receiving the shipment, providing photographic evidence and a detailed description of the alleged defect. Claims raised after 14 days of receipt will not be accepted.</p>

				<!-- SECTION 10 — INTELLECTUAL PROPERTY -->
				<h2 id="intellectual-property" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 10 — INTELLECTUAL PROPERTY
				</h2>
				<p style="margin-bottom: 1.5rem;"><strong>10.1 Client Ownership</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All designs, tech packs, artwork, CAD files, patterns, label designs, brand assets, and any other intellectual property submitted by the client remain the sole property of the client at all times.</p>
				<p style="margin-bottom: 1.5rem;"><strong>10.2 Our Confidentiality Commitment</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Client-supplied intellectual property is treated as strictly confidential. It is accessed only by production team members directly involved in the client's order.</p>
				<p style="margin-bottom: 1.5rem;"><strong>10.3 Sample & Pattern Confidentiality</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Patterns, samples, and prototypes developed for a client are specific to that client and will not be reproduced for or shared with any other party.</p>
				<p style="margin-bottom: 1.5rem;"><strong>10.4 Our Intellectual Property</strong></p>
