---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Confidentiality & IP Policy | SDF Clothing";
const pageDescription = "SDF Clothing's commitment to protecting your designs, tech packs, artwork, and brand assets. Confidentiality and IP policy for our manufacturing clients.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Confidentiality & IP Policy",
		"description": "SDF Clothing Ltd confidentiality and intellectual property policy — protecting client designs, tech packs, brand assets, and business information.",
		"url": "https://sdfltd.com/confidentiality",
		"dateModified": "2026-05-07",
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
				{ "@type": "ListItem", "position": 2, "name": "Confidentiality & IP Policy", "item": "https://sdfltd.com/confidentiality" }
			]
		}
	}
	</script>

	<!-- Main Confidentiality & IP Policy Content -->
	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Confidentiality & Intellectual Property Policy</h1>
				<p class="text-white/70 mb-2">Last updated: May 7, 2026 | Version 1.0</p>
			</div>

			<!-- Notice Box -->
			<div style="border: 1px solid #333; background: #0a0a0a; padding: 1.5rem; margin-bottom: 2rem;">
				<p style="margin: 0; color: #fff; font-size: 0.95rem; line-height: 1.7;">
					Your designs, tech packs, artwork, and brand assets are your property — always. This policy sets out exactly how SDF Clothing Ltd protects your intellectual property and confidential business information throughout our working relationship.
				</p>
			</div>

			<div class="prose prose-invert max-w-none" style="font-size: 0.95rem; line-height: 1.9; color: #fff;">
				
				<!-- SECTION 1 — OUR COMMITMENT -->
				<h2 id="our-commitment" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 1 — OUR COMMITMENT
				</h2>
				<p style="margin-bottom: 2rem;">
					In the international garment manufacturing industry, protecting a client's intellectual property is not merely a legal obligation — it is a fundamental business ethic. Brands invest significantly in their designs, patterns, and brand identity. Sharing, replicating, or misusing that investment is a breach of the trust that makes long-term manufacturing partnerships possible.
				</p>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd is built on that trust. Every member of our team — from our design liaison team to our production floor — operates under strict confidentiality obligations. Client information does not leave our controlled environment without explicit written authorisation from the client.
				</p>

				<!-- SECTION 2 — WHAT WE DEFINE AS CONFIDENTIAL INFORMATION -->
				<h2 id="confidential-information" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 2 — WHAT WE DEFINE AS CONFIDENTIAL INFORMATION
				</h2>
				<p style="margin-bottom: 2rem;">
					The following categories of information are treated as strictly confidential by SDF Clothing Ltd:
				</p>

				<p style="margin-bottom: 1.5rem;"><strong>2.1 Design & Technical Documents</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Tech packs and technical specifications</li>
					<li style="margin-bottom: 0.75rem;">CAD files, pattern files, grading charts</li>
					<li style="margin-bottom: 0.75rem;">Construction details and seam specifications</li>
					<li style="margin-bottom: 0.75rem;">Fit notes and measurement charts</li>
					<li style="margin-bottom: 0.75rem;">Trim and accessories specifications</li>
				</ul>

				<p style="margin-bottom: 1.5rem;"><strong>2.2 Brand Assets</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Label designs, hang tag artwork, and packaging graphics</li>
					<li style="margin-bottom: 0.75rem;">Brand logos and trademark materials</li>
					<li style="margin-bottom: 0.75rem;">Embroidery files and print artwork</li>
					<li style="margin-bottom: 0.75rem;">Woven label specifications and care label content</li>
					<li style="margin-bottom: 0.75rem;">Branded packaging materials and instructions</li>
				</ul>

				<p style="margin-bottom: 1.5rem;"><strong>2.3 Sample & Prototype Information</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Pre-production samples and prototypes</li>
					<li style="margin-bottom: 0.75rem;">Fabric swatches and colour standards</li>
					<li style="margin-bottom: 0.75rem;">Lab dip records and colour approval documentation</li>
					<li style="margin-bottom: 0.75rem;">Pilot production records</li>
				</ul>

				<p style="margin-bottom: 1.5rem;"><strong>2.4 Business Information</strong></p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Order quantities, pricing, and commercial terms</li>
					<li style="margin-bottom: 0.75rem;">Delivery schedules and production timelines</li>
					<li style="margin-bottom: 0.75rem;">Client identity and brand affiliation</li>
					<li style="margin-bottom: 0.75rem;">Communication records and correspondence</li>
					<li style="margin-bottom: 0.75rem;">Supply chain and sourcing information specific to the client</li>
				</ul>

				<!-- SECTION 3 — HOW WE PROTECT YOUR INFORMATION -->
				<h2 id="protection-measures" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 3 — HOW WE PROTECT YOUR INFORMATION
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>3.1 Access Controls</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Client confidential information is accessible only to the specific production team members assigned to that client's order. Access is granted on a strict need-to-know basis. Senior management reviews access permissions regularly.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.2 Internal Confidentiality Obligations</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All SDF Clothing Ltd employees, contractors, and production partners involved in client orders are bound by confidentiality obligations as a condition of their engagement with us. These obligations survive the termination of their employment or contract.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.3 Digital Security</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All digital files received from clients — including tech packs, artwork, and brand assets — are stored in access-controlled environments. Files are not stored on personal devices or transferred via unsecured channels. Upon completion of an order, client files are archived in a secure environment and are not accessible to general staff.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.4 Physical Security</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Physical samples, patterns, and print materials are stored in a secure production environment with restricted access. Rejected or surplus samples are destroyed and not retained, sold, or passed to any third party.</p>

				<p style="margin-bottom: 1.5rem;"><strong>3.5 Third-Party Production Partners</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Where SDF Clothing Ltd engages sub-contractors or specialist production partners for specific processes (such as embroidery, printing, or washing), those partners are required to maintain the same confidentiality standards and are bound by written confidentiality agreements before receiving any client materials or information.</p>

				<!-- SECTION 4 — INTELLECTUAL PROPERTY OWNERSHIP -->
				<h2 id="ip-ownership" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 4 — INTELLECTUAL PROPERTY OWNERSHIP
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>4.1 Client Owns Their IP — Always</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Any intellectual property submitted to SDF Clothing Ltd by a client — including designs, tech packs, artwork, patterns, and brand assets — remains the sole and exclusive property of that client. SDF Clothing Ltd acquires no ownership, licence, or rights over client intellectual property beyond what is strictly necessary to fulfil the production order.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.2 We Do Not Copy or Adapt Client Designs</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">SDF Clothing Ltd does not copy, adapt, replicate, or derive new designs from client-submitted intellectual property for any purpose — including our own production, other clients, or internal use. Client designs are used solely for the production of that client's confirmed order.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.3 No Portfolio Use Without Permission</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">SDF Clothing Ltd does not use client designs, products, or branding in our own marketing, portfolio, website, or promotional materials without explicit written consent from the client. Where a client permits us to reference the relationship, we will do so only in terms agreed in writing.</p>

				<p style="margin-bottom: 1.5rem;"><strong>4.4 SDF Clothing Ltd's Own IP</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Any production methods, operational processes, factory systems, and proprietary techniques developed internally by SDF Clothing Ltd remain our intellectual property. Clients do not acquire rights over our internal processes as a result of our working relationship.</p>

				<!-- SECTION 5 — TECH PACK & DESIGN CONFIDENTIALITY PROCESS -->
				<h2 id="tech-pack-process" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 5 — TECH PACK & DESIGN CONFIDENTIALITY PROCESS
				</h2>
				<p style="margin-bottom: 2rem;">
					When a client submits a tech pack or design to SDF Clothing Ltd, the following process is followed:
				</p>

				<p style="margin-bottom: 1.5rem;"><strong>Step 1 — Receipt & Logging</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All submitted documents are logged with a reference number, date of receipt, and client identifier. Access to the document is immediately restricted to the assigned production team.</p>

				<p style="margin-bottom: 1.5rem;"><strong>Step 2 — Internal Distribution</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Documents are distributed internally only to team members who require them to perform their specific role in the production process.</p>

				<p style="margin-bottom: 1.5rem;"><strong>Step 3 — Production & Sampling</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Files are used exclusively for the production of the client's order. No copies are made beyond what is operationally necessary.</p>

				<p style="margin-bottom: 1.5rem;"><strong>Step 4 — Order Completion</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Upon order completion and shipment, client-specific production files are archived in a secure, restricted environment. They are not reused, shared, or repurposed under any circumstances.</p>

				<p style="margin-bottom: 1.5rem;"><strong>Step 5 — Retention Period</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Client design files and technical documents are retained for a maximum of 3 years from order completion for potential reorder purposes, unless the client requests earlier deletion via our <a href="/contact/" style="color:#fff;text-decoration:underline;">Contact Form</a>. After 3 years, all files are securely deleted.</p>

				<!-- SECTION 6 — SAMPLE CONFIDENTIALITY -->
				<h2 id="sample-confidentiality" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 6 — SAMPLE CONFIDENTIALITY
				</h2>

				<p style="margin-bottom: 1.5rem;"><strong>6.1 Pre-Production Samples</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">All samples produced for a client are manufactured exclusively for that client's use. Sample specifications, patterns, and construction details are not shared with any other party.</p>

				<p style="margin-bottom: 1.5rem;"><strong>6.2 Rejected Samples</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Samples that are rejected, revised, or superseded are not retained in our general inventory. They are either returned to the client at the client's request and expense, or destroyed securely. They are never sold, gifted, or provided to any third party.</p>

				<p style="margin-bottom: 1.5rem;"><strong>6.3 Approved Pre-Production Samples</strong></p>
				<p style="margin-bottom: 2rem; margin-left: 1.5rem;">Approved PP samples are retained by SDF Clothing Ltd as quality benchmarks for the duration of the production run only. Upon shipment completion, retained PP samples are archived or destroyed as agreed with the client.</p>

				<!-- SECTION 7 — PAYMENT & BANKING CONFIDENTIALITY -->
				<h2 id="payment-confidentiality" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 7 — PAYMENT & BANKING CONFIDENTIALITY
				</h2>
				<p style="margin-bottom: 2rem;">
					Client payment details — including banking information, LC details, TT references, and WorldRemit transaction data — are treated as strictly confidential financial information. They are:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">Used only for the purpose of processing the specific transaction</li>
					<li style="margin-bottom: 0.75rem;">Accessible only to authorised finance personnel</li>
					<li style="margin-bottom: 0.75rem;">Never stored in unsecured systems</li>
					<li style="margin-bottom: 0.75rem;">Never shared with any third party other than the relevant banking institution for processing purposes</li>
				</ul>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd does not store full banking credentials, IBAN numbers, or account details beyond what is required for transaction processing. All payment processing is conducted through regulated banking channels or WorldRemit's regulated platform.
				</p>

				<!-- SECTION 8 — CLIENT IDENTITY & ORDER CONFIDENTIALITY -->
				<h2 id="client-confidentiality" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 8 — CLIENT IDENTITY & ORDER CONFIDENTIALITY
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd does not disclose the identity of our clients, the nature of their orders, or any commercial terms to any third party — including other clients, industry contacts, or media — without explicit written consent. We understand that in competitive markets, buyer-supplier relationships are commercially sensitive.
				</p>
				<p style="margin-bottom: 2rem;">
					This means:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">We do not list our clients publicly without permission</li>
					<li style="margin-bottom: 0.75rem;">We do not discuss one client's orders with another client</li>
					<li style="margin-bottom: 0.75rem;">We do not confirm or deny that a specific brand sources from us</li>
					<li style="margin-bottom: 0.75rem;">We do not share order quantities, pricing, or timelines externally</li>
				</ul>

				<!-- SECTION 9 — THIRD-PARTY IP COMPLIANCE -->
				<h2 id="third-party-ip" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 9 — THIRD-PARTY IP COMPLIANCE
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd will not knowingly manufacture products that infringe third-party intellectual property rights. Clients warrant that all designs, branding, trademarks, and materials submitted to us are either owned by the client or properly licensed for production.
				</p>
				<p style="margin-bottom: 2rem;">
					If SDF Clothing Ltd becomes aware — or has reasonable grounds to suspect — that a submitted design or brand asset infringes the intellectual property of a third party, we reserve the right to suspend production and require written confirmation of IP ownership or licence before proceeding.
				</p>
				<p style="margin-bottom: 2rem;">
					The client assumes full legal responsibility for any third-party IP infringement claims arising from client-supplied designs, branding, or materials.
				</p>

				<!-- SECTION 10 — NDA REQUESTS -->
				<h2 id="nda-requests" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 10 — NDA REQUESTS
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd understands that some clients prefer to formalise their confidentiality requirements through a Non-Disclosure Agreement (NDA) before sharing design materials or entering into detailed discussions.
				</p>
				<p style="margin-bottom: 2rem;">
					We are open to reviewing client-supplied NDA documents as part of the onboarding process for confirmed orders. NDA requests should be submitted via our <a href="/contact/" style="color:#fff;text-decoration:underline;">Contact Form</a>. Please note:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">We review each NDA individually and may propose amendments</li>
					<li style="margin-bottom: 0.75rem;">NDA review applies to confirmed order relationships, not preliminary enquiries</li>
					<li style="margin-bottom: 0.75rem;">Our standard Terms & Conditions and this Confidentiality Policy already provide contractual confidentiality protections from the commencement of our business relationship</li>
				</ul>

				<!-- SECTION 11 — BREACH OF CONFIDENTIALITY -->
				<h2 id="breach" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 11 — BREACH OF CONFIDENTIALITY
				</h2>
				<p style="margin-bottom: 2rem;">
					SDF Clothing Ltd takes any breach of confidentiality extremely seriously. In the event that a breach of this policy is identified:
				</p>
				<ul style="margin-bottom: 2rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 0.75rem;">The affected client will be notified immediately</li>
					<li style="margin-bottom: 0.75rem;">An internal investigation will be conducted</li>
					<li style="margin-bottom: 0.75rem;">Appropriate disciplinary action will be taken against responsible individuals</li>
					<li style="margin-bottom: 0.75rem;">The client will be provided with a full written account of the breach and remedial actions taken</li>
				</ul>
				<p style="margin-bottom: 2rem;">
					Clients who believe their confidential information has been mishandled are encouraged to contact us immediately via our <a href="/contact/" style="color:#fff;text-decoration:underline;">Contact Form</a>.
				</p>

				<!-- SECTION 12 — GOVERNING LAW -->
				<h2 id="governing-law" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 12 — GOVERNING LAW
				</h2>
				<p style="margin-bottom: 2rem;">
					This Confidentiality & IP Policy forms part of the contractual relationship between SDF Clothing Ltd and its clients, governed by the laws of the People's Republic of Bangladesh, consistent with our Terms & Conditions available at <a href="/terms/" style="color:#fff;text-decoration:underline;">/terms</a>.
				</p>

				<!-- SECTION 13 — CONTACT -->
				<h2 id="contact" style="color: #fff; font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem;">
					SECTION 13 — CONTACT
				</h2>
				<p style="margin-bottom: 2rem;">
					For any questions about our confidentiality practices, to request secure document submission procedures, or to raise a concern about your intellectual property, please use our <a href="/contact/" style="color:#fff;text-decoration:underline;">Contact Form</a> at /contact.
				</p>
				<p style="margin-bottom: 2rem;">
					We respond to all confidentiality enquiries within 2 business days.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
