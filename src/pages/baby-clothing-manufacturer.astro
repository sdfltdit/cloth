---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Baby Clothing Manufacturer | Organic & Custom | SDF Clothing";
const pageDescription = "Baby clothing manufacturer in Bangladesh. Organic, cotton baby clothes from 300 pieces. Onesies, rompers, sleepwear. OEKO-TEX certified. Get a free quote.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
