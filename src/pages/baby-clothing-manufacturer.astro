          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your baby clothing design, fabric preferences (organic cotton, bamboo), product type, size chart, and target quantity via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your baby clothing order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review baby clothing samples for fit, fabric softness, construction quality, and safety within 15-20 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard baby clothing items"
        },
