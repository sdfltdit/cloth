          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Baby Clothing Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "5",
              "maxPrice": "18"
            }
