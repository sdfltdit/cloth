              { factor:"Garment construction",  pod:"Standard — no control",  wl:"Fixed spec per style" },
              { factor:"Branding options",      pod:"Print only",             wl:"Woven labels, hang tags, packaging" },
              { factor:"Woven label",           pod:"Not available",           wl:"Included standard" },
              { factor:"Certification",         pod:"None",                    wl:"GOTS, OEKO-TEX, BSCI, 10 more" },
              { factor:"Retailer onboarding",   pod:"Not supported",           wl:"BSCI / SEDEX docs available" },
              { factor:"Production time",       pod:"3–10 days per order",     wl:"20–30 days bulk" },
              { factor:"Unit economics at scale", pod:"Margin gets worse at scale", wl:"Margin improves at scale" },
            ].map((row, i) => (
              <tr style={`border-bottom: 1px solid #111; background: ${i % 2 === 0 ? '#000' : '#040404'}`}>
