---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "White Label Clothing Manufacturer for Quick Brand Launch";
const pageDescription = "White label clothing manufacturer from Bangladesh. Ready-to-rebrand apparel for fast market entry. Quick launch, lower customization. From 300 pieces."
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl.href,
      "url": canonicalUrl.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "White label clothing manufacturer from Bangladesh providing ready-to-rebrand apparel for fast market entry to fashion brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for white label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What white label products do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer ready-to-rebrand products including t-shirts, hoodies, joggers, dresses, and basic apparel. Pre-designed styles with your branding applied. Faster launch than custom private label."
          }
        },
        {
          "@type": "Question",
          "name": "How fast is white label launch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "White label launch is significantly faster than private label. Production timeline: 20-30 days from order confirmation. No design development phase. Pre-designed styles ready for your branding."
          }
        },
        {
          "@type": "Question",
          "name": "What customization is available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "White label offers limited customization: your brand labels and tags, your brand colors on existing designs, custom packaging. No custom design development. Ideal for fast market entry with basic customization."
          }
        },
        {
          "@type": "Question",
          "name": "How does white label compare to private label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "White label is faster and lower cost but offers less customization. Private label is custom-designed with full control. White label ideal for market testing and fast launch. Private label for brand differentiation."
          }
        },
        {
          "@type": "Question",
          "name": "What is the pricing for white label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "White label pricing is typically 10-20% lower than private label due to pre-designed products and no design development. FOB Bangladesh pricing from $6-18 per piece depending on garment type and complexity."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "White Label Manufacturer",
          "item": canonicalUrl.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl.href}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="white label manufacturer, white label clothing manufacturer, ready to rebrand apparel, fast market entry, white label production, quick brand launch" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        White Label Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">White Label Manufacturer | Since 1998 | Ready-to-Rebrand</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      White Label Clothing Manufacturer for Quick Brand Launch
