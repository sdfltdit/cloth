---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Plus Size Clothing Manufacturer Bangladesh | 300 MOQ | SDF";
const pageDescription = "Leading plus size clothing manufacturer in Bangladesh. 300 piece MOQ, specialized grading 1X-5X, fit testing. Inclusive sizing. Get free quote for plus size.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Plus size clothing manufacturer from Bangladesh providing custom plus size clothing with specialized grading (1X-5X), fit testing, and inclusive sizing to inclusive brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for plus size clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What plus size range do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer plus size grading from 1X to 5X. Our specialized grading ensures proper fit across the full size range with proportional adjustments for larger body types."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer fit testing for plus sizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer comprehensive fit testing for plus size garments including fit samples across multiple sizes, fit model testing, and pattern adjustments based on fit feedback."
          }
        },
        {
          "@type": "Question",
          "name": "What plus size products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture plus size dresses, tops, bottoms, outerwear, activewear, and intimate apparel. All categories are available in 1X-5X sizing with proper fit considerations."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure proper fit for plus sizes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use specialized grading rules for plus sizes, conduct fit testing with plus size fit models, and adjust patterns based on real-world feedback. Our grading ensures proportional fit across all sizes."
          }
        },
        {
          "@type": "Question",
          "name": "How long does plus size clothing production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic plus size clothing. 35-50 days for custom grading development or specialized fit requirements. 7-14 days for sampling before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "What plus size range do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture plus sizes 1X-5X, equivalent to 14W-30W or XL-5XL. Custom sizing available beyond 5X for specialized requirements. We can also extend standard size ranges to include plus sizes in the same collection. Size charts provided for accuracy."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce extended plus sizes beyond 5X?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We can produce plus sizes beyond 5X including 6X, 7X, and custom size requirements. Extended plus sizes require specialized pattern development and fit testing. 300-piece minimum applies per style regardless of size range. Grading maintains proportional fit across all sizes."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Plus Size Clothing Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Plus Size Clothing Manufacturing Service",
      "description": "Custom plus size clothing manufacturing from 300 pieces with specialized grading 1X-5X and fit testing",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Plus Size Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plus Size Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "10",
              "maxPrice": "30"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Plus Size Clothing from SDF Clothing",
      "description": "Step-by-step process for ordering custom plus size clothing from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your plus size design, size range requirements (1X-5X), fit specifications, target quantity, and fabric preferences via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including grading costs, production, fit testing, and shipping for your plus size order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Fit Samples",
          "text": "Review plus size fit samples across multiple sizes (1X-5X) for proper proportional fit within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after fit approval with specialized grading for 1X-5X sizing and 30-40 day turnaround"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with fit verification documentation and tracking for your plus size order"
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="plus size clothing manufacturer, plus size apparel manufacturer, inclusive sizing manufacturer, 1X-5X clothing manufacturer, plus size fit testing" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Plus Size Clothing Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Plus Size Clothing Manufacturer | Since 1998 | Inclusive Sizing</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Plus Size Manufacturer from 300 Pieces | Low MOQ Options
