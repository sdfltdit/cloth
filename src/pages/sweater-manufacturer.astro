---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Custom Sweater Manufacturer for Knitwear Brands | SDF"
const pageDescription = "Custom sweater manufacturer from Bangladesh. Pullover sweaters, cardigans, cable knits, fully fashioned, gauge options. Knitwear production. From 300 pieces."
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Custom sweater manufacturer from Bangladesh providing pullover sweaters, cardigans, cable knits, fully fashioned, and gauge options to knitwear brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for sweater manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What sweater styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture pullover sweaters for casual wear, cardigans for layering, cable knits for classic styling, fully fashioned sweaters for premium quality, and various knit patterns. All styles available with customization options."
          }
        },
        {
          "@type": "Question",
          "name": "What gauge options do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer 3GG (chunky, winter), 5GG (medium, versatile), 7GG (fine, lightweight), 12GG (ultra-fine, luxury), and 14GG (ultra-fine, premium). Gauge selection affects fabric weight and handfeel."
          }
        },
        {
          "@type": "Question",
          "name": "What knit patterns do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer cable knits (classic textures), rib knits (stretch, structure), plain knits (smooth, basic), jacquard knits (patterns, designs), and intarsia knits (colorwork). Custom pattern development available."
          }
        },
        {
          "@type": "Question",
          "name": "How much does sweater manufacturing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sweater manufacturing costs vary by gauge and complexity. Basic pullover: $12-20 per piece. Cable knit: $15-25 per piece. Fully fashioned: $18-30 per piece. FOB Bangladesh pricing from 300 pieces minimum."
          }
        },
        {
          "@type": "Question",
          "name": "How long does sweater production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard sweater production timeline: 30-40 days from yarn receipt for basic styles. 40-50 days for complex cable knits. 10-14 days for sampling before bulk. Yarn sourcing adds 7-14 days."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Sweater Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="sweater manufacturer, custom sweater manufacturer, pullover sweater manufacturer, cardigan manufacturer, cable knit manufacturer, knitwear manufacturer" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Sweater Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Sweater Manufacturer | Since 1998 | Knitwear</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Sweater Manufacturer for Knitwear Brands
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Sweaters are cozy essentials - from chunky cable knits to lightweight pullovers. Custom knitting ensures perfect gauge, quality construction, and premium handfeel. SDF Clothing, a full-service clothing manufacturer in Bangladesh, produces sweaters from pullovers to cardigans, cable to fully fashioned. From 300 pieces per style with full customization.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact/" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20sweater-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">30-40</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">3-14</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Gauge Options</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Custom</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Patterns</div>
      </div>
    </div>
  </div>
</section>

<!-- Sweater Styles Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sweater Categories We Manufacture</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Pullover Sweaters</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic pullover sweaters for casual wear. Various necklines, sleeve lengths, and fits. Ideal for everyday collections and casual brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cardigans</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Versatile cardigans for layering. Button-front or zip options, various lengths and styles. Perfect for transitional seasons and layering collections.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cable Knits</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Classic cable knits for textured styling. Various cable patterns, chunky gauges, premium handfeel. Essential for winter and heritage collections.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Fully Fashioned Sweaters</h3>
    <p style="color:#URL:100px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Premium fully fashioned sweaters for luxury positioning. Shaped construction, seamless panels, superior fit. Ideal for premium and luxury brands.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Knit Patterns</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Custom knit patterns including cable, rib, plain, jacquard, and intarsia. Pattern development available for unique brand identity.
    </p>
  </div>
</section>

<!-- Gauge Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Knitting</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Gauge Options</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        3GG (chunky, winter weight)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        5GG (medium, versatile)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        7GG (fine, lightweight)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        12GG (ultra-fine, luxury)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        14GG (ultra-fine, premium)
      </li>
    </ul>
  </div>
</section>

<!-- Knit Patterns Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Patterns</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Knit Patterns</h2>
    </div>
    
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cable knits (classic textures)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Rib knits (stretch, structure)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Plain knits (smooth, basic)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Jacquard knits (patterns, designs)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Intarsia knits (colorwork)
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Sweater manufacturing costs vary by gauge and complexity:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Basic pullover: $12-20 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Cable knit: $15-25 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Fully fashioned: $18-30 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes yarn, knitting, finishing, basic branding, and standard packaging. Custom patterns, fully fashioned construction, and premium packaging are additional.
    </p>
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Sweater Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard sweater production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Yarn sourcing: 7-14 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sampling: 10-14 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bulk production: 30-40 days (basic styles)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quality inspection: 2-3 days
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Packing and shipping: 3-5 days
      </li>
    </ul>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Total timeline: 55-75 days from order to delivery. Complex cable knits add 10-15 days.
    </p>
  </div>
</section>

<!-- FAQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Common Questions</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Frequently Asked Questions</h2>
    </div>
    
    <div style="max-width:800px;">
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What is the minimum order for sweater manufacturing?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What sweater styles do you manufacture?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We manufacture pullover sweaters for casual wear, cardigans for layering, cable knits for classic styling, fully fashioned sweaters for premium quality, and various knit patterns. All styles available with customization options.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What gauge options do you offer?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We offer 3GG (chunky, winter), 5GG (medium, versatile), 7GG (fine, lightweight), 12GG (ultra-fine, luxury), and 14GG (ultra-fine, premium). Gauge selection affects fabric weight and handfeel.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What knit patterns do you offer?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We offer cable knits (classic textures), rib knits (stretch, structure), plain knits (smooth, basic), jacquard knits (patterns, designs), and intarsia knits (colorwork). Custom pattern development available.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How much does sweater manufacturing cost?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Sweater manufacturing costs vary by gauge and complexity. Basic pullover: $12-20 per piece. Cable knit: $15-25 per piece. Fully fashioned: $18-30 per piece. FOB Bangladesh pricing from 300 pieces minimum.</p>
      </div>
      <div style="padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How long does sweater production take?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Standard sweater production timeline: 30-40 days from yarn receipt for basic styles. 40-50 days for complex cable knits. 10-14 days for sampling before bulk. Yarn sourcing adds 7-14 days.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
