---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Pleated Skirt Manufacturer | Custom Skirts SDF";
const pageDescription = "Pleated skirt manufacturer in Bangladesh. Custom skirts, knife pleat, box pleat, accordion from 300 pieces. Polyester, chiffon, cotton fabrics. Free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Pleated Skirt Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What pleat styles do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture knife pleats for classic uniform appearance, box pleats for structured fullness, accordion pleats for even narrow folds, sunray pleats for flowing movement, and inverted pleats for clean front appearance. All pleat styles available from 300 pieces minimum with custom sizing and fabric options."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics do you use for pleated skirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use polyester for durability and cost efficiency, chiffon for lightweight drape, cotton for natural feel, satin for lustrous finish, linen for textured appearance, and wool blends for structured pleats. All fabrics tested for pleat retention and available in 120-250 GSM range."
          }
        },
        {
          "@type": "Question",
          "name": "What skirt lengths do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer mini skirts at 14-18 inches for casual styling, midi skirts at 20-26 inches for versatile wear, and maxi skirts at 28-36 inches for elegant styling. Custom lengths available with pattern development. All lengths maintain consistent pleat quality and proportion."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for pleated skirts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our pleated skirt minimum is 300 pieces per style. This applies to all pleat types, fabric choices, and length options. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer custom waistband options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer elastic waistbands for comfort, fitted waistbands with zippers for tailored fit, high-waisted options for styling, and drawstring waistbands for casual wear. All waistband options available with custom width, closure types, and lining specifications."
          }
        },
        {
          "@type": "Question",
          "name": "What lining options do you provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide full lining for opacity and structure, partial lining for lightweight feel, and unlined options for summer wear. Lining fabrics include polyester, acetate, and cotton blends. Lining color matched or contrasted per brand requirements."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Pleated Skirt Manufacturing Service",
      "description": "Custom pleated skirt manufacturing from 300 pieces including knife pleat, box pleat, accordion skirts with polyester, chiffon, cotton, satin, linen fabrics",
      "provider": {
        "@id": "https://sdfltd.com/#organization"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Pleated Skirt Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Pleated Skirt Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "6",
              "maxPrice": "18"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Pleated Skirts from SDF Clothing",
      "description": "Step-by-step process for ordering custom pleated skirts from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your pleated skirt design, pleat type (knife, box, accordion), fabric specifications (polyester, chiffon, cotton, satin, linen), size chart, target quantity, and waistband requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, pleating process, production, customization, and shipping for your pleated skirt order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review pleated skirt samples for pleat quality, fabric drape, waistband fit, and construction within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for pleated skirts including pleating process"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check including pleat inspection and sizing verification before shipment with tracking documentation for your pleated skirt order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Pleated Skirt Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Pleated Skirt Manufacturer • Since 1998 • Women's Fashion Specialists</div>
        <h1 class="hero__title">Pleated Skirt Manufacturer • Custom Skirts and Wholesale Production from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a pleated skirt manufacturer in Bangladesh producing custom skirts, knife pleat skirts, box pleat skirts, accordion skirts, sunray pleats, and inverted pleats from 300 pieces minimum. Polyester, chiffon, cotton, satin, linen, wool blend fabrics with waistband customization, lining options, and zipper types.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20pleated-skirt-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">5+</span>
          <span class="hero__stat-label">Pleat Styles</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>BSCI Social Compliance</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>WRAP Certified</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Pleat Styles</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleat Styles We Manufacture</h2>
      </div>
      <div class="section__text">
        <p>We manufacture five primary pleat styles, each creating distinct visual effects and movement characteristics. Knife pleats feature uniform folds facing one direction for classic structured appearance, commonly used in school uniforms and professional wear. Box pleats consist of two knife pleats facing away from each other, creating structured fullness with clean lines ideal for fashion skirts. Accordion pleats feature narrow, even folds that expand and contract with movement, perfect for flowing skirts and dancewear. Sunray pleats start narrow at the waist and widen toward the hem for dramatic movement and elegant drape. Inverted pleats hide the fold inside for clean front appearance with hidden fullness. All pleat styles maintain consistent quality and are available from 300 pieces minimum.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Pleat Style</th>
              <th>Appearance</th>
              <th>Fullness</th>
              <th>Best Fabrics</th>
              <th>Price Tier</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Knife Pleats</td>
              <td>Uniform directional folds</td>
              <td>Moderate</td>
              <td>Polyester, cotton blends</td>
              <td>$</td>
            </tr>
            <tr>
              <td>Box Pleats</td>
              <td>Structured outward folds</td>
              <td>High</td>
              <td>Cotton, wool blends</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Accordion Pleats</td>
              <td>Narrow even folds</td>
              <td>Very High</td>
              <td>Chiffon, polyester</td>
              <td>$$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Sunray Pleats</td>
              <td>Narrow to wide expansion</td>
              <td>High</td>
              <td>Chiffon, silk blends</td>
              <td>$$$</td>
            </tr>
            <tr>
              <td>Inverted Pleats</td>
              <td>Clean front appearance</td>
              <td>Moderate</td>
              <td>Polyester, cotton</td>
              <td>$$</td>
            </tr>
          </tbody>
          <caption>All styles available from 300 pieces minimum. Custom pleat depths and spacing available.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleated Skirt Fabric Selection</h2>
      </div>
      <div class="section__text">
        <p>Fabric selection determines pleat retention, drape, and overall skirt appearance. We offer multiple fabric options optimized for different pleat styles and price points. All fabrics are tested for pleat retention and available in 120-250 GSM range to suit different seasons and styling preferences.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>GSM Range</th>
              <th>Pleat Retention</th>
              <th>Drape</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Polyester</td>
              <td>120-180 GSM</td>
              <td>Excellent</td>
              <td>Medium</td>
              <td>Knife pleats, school uniforms</td>
            </tr>
            <tr>
              <td>Chiffon</td>
              <td>80-120 GSM</td>
              <td>Good</td>
              <td>Excellent</td>
              <td>Accordion pleats, evening wear</td>
            </tr>
            <tr>
              <td>Cotton</td>
              <td>140-200 GSM</td>
              <td>Good</td>
              <td>Medium</td>
              <td>Box pleats, casual wear</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Satin</td>
              <td>120-160 GSM</td>
              <td>Good</td>
              <td>Good</td>
              <td>Sunray pleats, formal wear</td>
            </tr>
            <tr>
              <td>Linen</td>
              <td>160-220 GSM</td>
              <td>Moderate</td>
              <td>Medium</td>
              <td>Box pleats, summer wear</td>
            </tr>
            <tr>
              <td>Wool Blends</td>
              <td>200-250 GSM</td>
              <td>Excellent</td>
              <td>Low</td>
              <td>Structured skirts, winter wear</td>
            </tr>
          </tbody>
          <caption>Heavier GSM improves pleat retention. Lighter fabrics enhance drape and movement.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Skirt Lengths</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleated Skirt Length Options</h2>
      </div>
      <div class="section__text">
        <p>Skirt length significantly impacts styling, target market, and seasonal application. We offer three primary length categories with custom options available. All lengths maintain consistent pleat quality and proportional grading across size ranges.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Length</th>
              <th>Measurement</th>
              <th>Styling</th>
              <th>Target Market</th>
              <th>Season</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Mini Skirt</td>
              <td>14-18 inches</td>
              <td>Casual, youthful</td>
              <td>Young adults, fashion</td>
              <td>Spring/Summer</td>
            </tr>
            <tr>
              <td>Midi Skirt</td>
              <td>20-26 inches</td>
              <td>Versatile, professional</td>
              <td>All ages, office wear</td>
              <td>All seasons</td>
            </tr>
            <tr>
              <td>Maxi Skirt</td>
              <td>28-36 inches</td>
              <td>Elegant, flowing</td>
              <td>All ages, formal</td>
              <td>All seasons</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Custom Length</td>
              <td>Any specification</td>
              <td>Brand-specific</td>
              <td>Brand-defined</td>
              <td>All seasons</td>
            </tr>
          </tbody>
          <caption>Lengths measured from waist to hem. Custom lengths available with pattern development.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Waistband Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Waistband and Closure Types</h2>
      </div>
      <div class="section__text">
        <p>Waistband design affects comfort, fit, and styling of pleated skirts. We offer multiple waistband configurations to serve different body types, activities, and fashion preferences. All waistbands feature secure construction and proper interfacing for stability.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Waistband Type</th>
              <th>Construction</th>
              <th>Comfort</th>
              <th>Best For</th>
              <th>Cost Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Elastic Waistband</td>
              <td>Encased elastic</td>
              <td>High</td>
              <td>Casual wear, comfort focus</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Fitted Waistband with Zipper</td>
              <td>Structured with closure</td>
              <td>Medium</td>
              <td>Tailored look, professional</td>
              <td>+</td>
            </tr>
            <tr>
              <td>High-Waisted</td>
              <td>Extended rise</td>
              <td>Medium-High</td>
              <td>Modern styling, fashion</td>
              <td>Standard</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Drawstring Waistband</td>
              <td>Elastic with drawstring</td>
              <td>High</td>
              <td>Casual, adjustable fit</td>
              <td>Standard</td>
            </tr>
            <tr>
              <td>Contour Waistband</td>
              <td>Shaped construction</td>
              <td>High</td>
              <td>Premium fit, luxury</td>
              <td>++</td>
            </tr>
          </tbody>
          <caption>Zipper types include invisible, exposed, and side seam options. Button or hook closures available.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Price Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleated Skirt Price Range by Style</h2>
      </div>
      <div class="section__text">
        <p>Pricing varies by fabric type, pleat complexity, length, and order quantity. FOB Bangladesh pricing for standard production runs. Custom pleat patterns, premium fabrics, and specialized finishes are additional. Volume discounts available for orders exceeding 1,000 pieces.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Style</th>
              <th>300-500 pcs</th>
              <th>500-1000 pcs</th>
              <th>1000-2000 pcs</th>
              <th>2000+ pcs</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Knife Pleat (Polyester)</td>
              <td>$6-10</td>
              <td>$5-8</td>
              <td>$4-7</td>
              <td>$3-6</td>
            </tr>
            <tr>
              <td>Box Pleat (Cotton)</td>
              <td>$8-14</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-9</td>
            </tr>
            <tr>
              <td>Accordion Pleat (Chiffon)</td>
              <td>$10-16</td>
              <td>$9-14</td>
              <td>$8-12</td>
              <td>$7-11</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Sunray Pleat (Satin)</td>
              <td>$12-20</td>
              <td>$11-18</td>
              <td>$10-16</td>
              <td>$9-14</td>
            </tr>
            <tr>
              <td>Inverted Pleat (Polyester)</td>
              <td>$8-14</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-9</td>
            </tr>
            <tr>
              <td>Structured Pleat (Wool Blend)</td>
              <td>$14-22</td>
              <td>$13-20</td>
              <td>$12-18</td>
              <td>$11-16</td>
            </tr>
          </tbody>
          <caption>FOB Bangladesh pricing. Includes fabric, pleating, cut, sew, basic branding. Customization additional.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Lining Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleated Skirt Lining Specifications</h2>
      </div>
      <div class="section__text">
        <p>Lining selection affects opacity, comfort, and garment structure. We offer multiple lining options to serve different fabric types, styling requirements, and seasonal needs. Proper lining ensures pleated skirts maintain their shape while providing comfort and modesty.</p>
        
        <p>Full lining provides complete opacity and additional structure to pleated skirts, particularly important for lightweight fabrics like chiffon and thin polyester. Full lining extends from waist to hem and is typically attached at the waistband with free movement at the hem to allow pleats to drape naturally. Lining fabrics include smooth polyester for comfort, acetate for luster, and cotton blends for natural feel. Lining color can be matched to the outer fabric for seamless appearance or contrasted for design interest.</p>
        
        <p>Partial lining offers lightweight alternative for summer-weight skirts and fabrics with sufficient opacity. Partial lining typically covers the body area from waist to mid-thigh, leaving the lower portion unlined for enhanced drape and breathability. This option works well for midi and maxi length skirts where the lower portion benefits from unlined movement. Partial lining reduces fabric costs while maintaining comfort and modesty in key areas.</p>
        
        <p>Unlined options are available for heavyweight fabrics like wool blends and structured cotton that provide sufficient opacity and structure without additional lining. Unlined construction reduces cost and weight while allowing maximum drape and movement of pleats. Unlined skirts require careful fabric selection to ensure opacity and proper interfacing at waistband and hem to maintain structure. We recommend unlined construction primarily for winter-weight fabrics and structured pleat styles where the fabric itself provides adequate coverage.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Pleated Skirt Manufacturer FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What pleat styles do you manufacture?</h3>
          <p class="faq__answer">We manufacture knife pleats for classic uniform appearance, box pleats for structured fullness, accordion pleats for even narrow folds, sunray pleats for flowing movement, and inverted pleats for clean front appearance. All pleat styles available from 300 pieces minimum with custom sizing and fabric options.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabrics do you use for pleated skirts?</h3>
          <p class="faq__answer">We use polyester for durability and cost efficiency, chiffon for lightweight drape, cotton for natural feel, satin for lustrous finish, linen for textured appearance, and wool blends for structured pleats. All fabrics tested for pleat retention and available in 120-250 GSM range.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What skirt lengths do you offer?</h3>
          <p class="faq__answer">We offer mini skirts at 14-18 inches for casual styling, midi skirts at 20-26 inches for versatile wear, and maxi skirts at 28-36 inches for elegant styling. Custom lengths available with pattern development. All lengths maintain consistent pleat quality and proportion.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your minimum order for pleated skirts?</h3>
          <p class="faq__answer">Our pleated skirt minimum is 300 pieces per style. This applies to all pleat types, fabric choices, and length options. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you offer custom waistband options?</h3>
          <p class="faq__answer">Yes. We offer elastic waistbands for comfort, fitted waistbands with zippers for tailored fit, high-waisted options for styling, and drawstring waistbands for casual wear. All waistband options available with custom width, closure types, and lining specifications.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What lining options do you provide?</h3>
          <p class="faq__answer">We provide full lining for opacity and structure, partial lining for lightweight feel, and unlined options for summer wear. Lining fabrics include polyester, acetate, and cotton blends. Lining color matched or contrasted per brand requirements.</p>
        </div>
      </div>
    </div>
