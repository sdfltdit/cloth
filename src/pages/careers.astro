---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Careers | Jobs at SDF Clothing Bangladesh";
const pageDescription = "Open positions at SDF Clothing — production, quality, sustainability, and corporate roles in Bangladesh's premium garment manufacturing industry.";
