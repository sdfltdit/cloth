---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Careers | SDF Clothing";
const pageDescription = "Join SDF Clothing team - explore career opportunities at Bangladesh's leading clothing manufacturer since 1998.";
const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="container">
		<!-- Breadcrumb -->
		<nav aria-label="Breadcrumb" style="margin: 2rem 0;">
			<p style="font-size: 0.8rem; color: #aaa;">
				<a href="/" style="color: #ccc;">Home</a> &gt; Careers
			</p>
		</nav>
		
		<!-- Main Content -->
		<article>
			<h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; margin-bottom: 2rem; color: #fff;">
				Careers at SDF Clothing
			</h1>
			
			<p style="font-size: 1.1rem; color: #aaa; line-height: 1.8; margin-bottom: 3rem;">
				Join Bangladesh's leading clothing manufacturer and be part of our {companyAge} legacy in ethical apparel production. We're always looking for talented professionals who share our commitment to quality, sustainability, and innovation in garment manufacturing.
			</p>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Why Work With Us
			</h2>
			
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<!-- Growth -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Career Growth
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						Work alongside industry experts and grow your skills in a dynamic environment. We offer continuous training, skill development programs, and opportunities for advancement within our global manufacturing operations.
					</p>
				</div>
				
				<!-- Impact -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Global Impact
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem;">
						Be part of sustainable fashion movement. Your work at SDF Clothing directly contributes to ethical manufacturing practices that are shaping the future of the global apparel industry.
					</p>
				</div>
			</div>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				Open Positions
			</h2>
			
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0;">
				
				<!-- Production Manager -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Production Manager
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.5rem;">
						5+ years experience in garment manufacturing, strong leadership skills, and knowledge of quality control systems. Must be familiar with GOTS certification and international compliance standards.
					</p>
					<div style="margin-top: 1.5rem;">
						<a href="mailto:contact@sdfltd.com" style="display: inline-block; background: #666; color: #fff; padding: 0.8rem 2rem; text-decoration: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; border-radius: 4px;">
							Apply Now
						</a>
					</div>
				</div>
				
				<!-- Quality Assurance -->
				<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem;">
					<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
						Quality Assurance Specialist
					</h3>
					<p style="color: #aaa; line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.5rem;">
						Detail-oriented professional with experience in AQL 2.5 standards, fabric inspection, and garment quality control. Strong understanding of international quality requirements for UK, US, and EU markets.
					</p>
					<div style="margin-top: 1.5rem;">
						<a href="mailto:contact@sdfltd.com" style="display: inline-block; background: #666; color: #fff; padding: 0.8rem 2rem; text-decoration: none; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; border-radius: 4px;">
							Apply Now
						</a>
					</div>
				</div>
			</div>
			
			<h2 style="font-size: 1.8rem; font-weight: 400; margin: 3rem 0 1.5rem; color: #fff;">
				How to Apply
			</h2>
			
			<div style="background: #000; border: 1px solid #1a1a1a; ; padding: 2rem; margin: 2rem 0;">
				<h3 style="font-size: 1.3rem; font-weight: 500; margin-bottom: 1rem; color: #fff;">
					Application Process
				</h3>
				<ol style="color: #aaa; line-height: 1.8; font-size: 0.95rem; padding-left: 1.5rem;">
					<li style="margin-bottom: 1rem;">
						<strong style="color: #fff;">Email your resume</strong> to <a href="mailto:contact@sdfltd.com" style="color: #ccc; text-decoration: none;">contact@sdfltd.com</a> with the position title in the subject line.
					</li>
					<li style="margin-bottom: 1rem;">
						<strong style="color: #fff;">Portfolio review</strong> - Share examples of your work in garment manufacturing, quality control, or related fields.
					</li>
					<li style="margin-bottom: 1rem;">
						<strong style="color: #fff;">Initial interview</strong> - We'll review your application and contact qualified candidates within 5-7 business days.
					</li>
					<li style="margin-bottom: 1rem;">
						<strong style="color: #fff;">Technical assessment</strong> - Practical evaluation of your skills and experience.
					</li>
					<li style="margin-bottom: 0;">
						<strong style="color: #fff;">Final interview</strong> - Meet with our leadership team and facility tour.
					</li>
				</ol>
			</div>
			
		</article>
		
		<!-- Footer Link -->
		<div style="text-align: center; margin: 4rem 0 2rem; padding-top: 2rem; border-top: 1px solid #1a1a1a;">
			<p style="color: #aaa; font-size: 0.9rem;">
				Ready to join our team? <a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing,%20I'm%20interested%20in%20career%20opportunities" target="_blank" rel="noopener noreferrer" style="color: #ccc;">Contact us directly</a> to discuss opportunities.
			</p>
		</div>
	</div>
	
</BaseLayout>