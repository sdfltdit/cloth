<!-- JAVASCRIPT FOR FILTERS AND FORMS -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const deptFilters = document.querySelectorAll('.dept-filter');
  const locFilters = document.querySelectorAll('.loc-filter');
  const jobCards = document.querySelectorAll('.job-card');
  
  let currentDept = 'all';
  let currentLoc = 'all';
  
  deptFilters.forEach(btn => {
    btn.addEventListener('click', function() {
      deptFilters.forEach(b => {
        b.classList.remove('active');
        b.style.background = 'transparent';
        b.style.color = '#e00';
      });
      this.classList.add('active');
      this.style.background = '#e00';
      this.style.color = '#FFFFFF';
      currentDept = this.dataset.dept;
      filterJobs();
    });
  });
  
  locFilters.forEach(btn => {
    btn.addEventListener('click', function() {
      locFilters.forEach(b => {
        b.classList.remove('active');
        b.style.background = 'transparent';
        b.style.color = '#e00';
      });
      this.classList.add('active');
      this.style.background = '#e00';
      this.style.color = '#FFFFFF';
      currentLoc = this.dataset.loc;
      filterJobs();
    });
  });
  
  function filterJobs() {
    jobCards.forEach(card => {
      const cardDept = card.dataset.dept;
      const cardLoc = card.dataset.loc;
      
      const deptMatch = currentDept === 'all' || cardDept === currentDept;
      const locMatch = currentLoc === 'all' || cardLoc === currentLoc;
      
      if (deptMatch && locMatch) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
  
  jobCards.forEach(card => {
    card.addEventListener('mouseenter', function() {
      this.style.borderColor = '#e00';
    });
    card.addEventListener('mouseleave', function() {
      this.style.borderColor = 'rgba(255,255,255,0.1)';
    });
  });
  
  // Job apply buttons - open general form and pre-fill position
  const applyBtns = document.querySelectorAll('.apply-btn');
  const generalFormSection = document.getElementById('general-form-section');
  const generalForm = document.getElementById('general-application-form');
  const positionInput = generalForm ? generalForm.querySelector('input[name="position"]') : null;
  
  applyBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const jobTitle = this.dataset.job;
      if (generalFormSection) {
        generalFormSection.style.display = 'block';
        if (positionInput) {
          positionInput.value = jobTitle;
        }
        generalFormSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
  
  const generalApplyBtn = document.getElementById('general-apply-btn');
  
  if (generalApplyBtn && generalFormSection) {
    generalApplyBtn.addEventListener('click', function() {
      generalFormSection.style.display = generalFormSection.style.display === 'none' ? 'block' : 'none';
      if (generalFormSection.style.display === 'block') {
        if (positionInput) {
          positionInput.value = 'General Application';
        }
        generalFormSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }
  
  const generalSubmitBtn = document.getElementById('general-submit-btn');
  const generalSuccessMsg = document.getElementById('general-success-message');
  
  if (generalForm && generalSubmitBtn) {
    const WEB3_ACCESS_KEY = 'e72c8f4e-012f-488b-8d3c-443737652450';
    const FORMSPREE_URL = 'https://formspree.io/f/xqenpqye';
    
    generalSubmitBtn.disabled = true;
    setTimeout(() => {
      generalSubmitBtn.disabled = false;
    }, 3000);
    
    generalForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const data = {};
      new FormData(generalForm).forEach((v, k) => { data[k] = v; });
      
      if (data._honey) {
        generalForm.reset();
        if (generalSuccessMsg) {
          generalSuccessMsg.style.display = 'block';
          setTimeout(() => generalSuccessMsg.style.display = 'none', 5000);
        }
        return;
      }
      
      generalSubmitBtn.disabled = true;
      generalSubmitBtn.textContent = 'Submitting...';
      
      let success = false;
      
      try {
        const body = new FormData();
        body.append('access_key', WEB3_ACCESS_KEY);
        Object.entries(data).forEach(([k, v]) => body.append(k, v));
        const r = await fetch('https://api.web3forms.com/submit', { method: 'POST', body });
        const j = await r.json();
        success = j.success === true;
      } catch {}
      
      if (!success) {
        try {
          const r = await fetch(FORMSPREE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data)
          });
          success = r.ok;
        } catch {}
      }
      
      generalSubmitBtn.disabled = false;
      generalSubmitBtn.textContent = 'Submit Application';
      
      if (success) {
        generalForm.reset();
        if (generalSuccessMsg) {
          generalSuccessMsg.style.display = 'block';
          setTimeout(() => generalSuccessMsg.style.display = 'none', 5000);
        }
      } else {
        alert('Something went wrong. Please email us directly at contact@sdfltd.com');
      }
    });
  }
});
</script>

