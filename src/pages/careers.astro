<!-- HERO SECTION -->
<section style="background: #000000; padding: 5rem 0; border-bottom: 1px solid #e00;">
  <div class="container">
    <p style="font-size: 0.65rem; letter-spacing: 0.3em; text-transform: uppercase; color: #e00; margin-bottom: 1rem; font-family: 'Inter', monospace;">CAREERS</p>
    <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 200; color: #FFFFFF; margin-bottom: 1.5rem; line-height: 1.2;">Open Positions at SDF Clothing</h1>
    <p style="color: rgba(255,255,255,0.6); max-width: 600px; line-height: 1.8; font-size: 0.95rem;">Join Bangladesh's premium garment manufacturer. We're hiring across production, quality control, sustainability, design, and corporate functions. View current openings below and apply directly.</p>
  </div>
</section>

<!-- FILTER BAR -->
<section style="background: #000000; padding: 2rem 0; border-bottom: 1px solid rgba(255,255,255,0.1);">
  <div class="container">
    <div style="margin-bottom: 1.5rem;">
      <p style="font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 0.75rem;">Department</p>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <button class="filter-btn dept-filter active" data-dept="all" style="background: #e00; color: #FFFFFF; border: 1px solid #e00; padding: 0.5rem 1rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; font-family: 'Inter', monospace;">All</button>
        <button class="filter-btn dept-filter" data-dept="production" style="background: transparent; color: #e00; border: 1px solid #e00; padding: 0.5rem 1rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; font-family: 'Inter', monospace;">Production</button>
        <button class="filter-btn dept-filter" data-dept="quality" style="background: transparent; color: #e00; border: 1px solid #e00; padding: 0.5rem 1rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; font-family: 'Inter', monospace;">Quality Control</button>
        <button class="filter-btn dept-filter" data-dept="sustainability" style="background: transparent; color: #e00; border: 1px solid #e00; padding: 0.5rem 1rem; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; font-family: 'Inter', monospace;">Sustainability</button>
