---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Fashion Designer Jobs Remote — Submit Your CV to SDF Clothing";
const pageDescription = "Looking for remote fashion designer jobs or garment industry careers worldwide? Submit your CV to SDF Clothing — we hire talented people across design, merchandising, quality, and production. Open to candidates globally.";
const canonicalURL = "https://sdfltd.com/careers";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Fashion Designer Jobs Remote — Submit Your CV to SDF Clothing",
    "description": "Looking for remote fashion designer jobs or garment industry careers worldwide? Submit your CV to SDF Clothing — we hire talented people across design, merchandising, quality, and production.",
    "url": "https://sdfltd.com/careers",
    "isPartOf": {
      "@type": "WebSite",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Careers",
          "item": "https://sdfltd.com/careers"
        }
      ]
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SDF Clothing",
    "url": "https://sdfltd.com",
    "logo": "https://sdfltd.com/logo-small.svg",
    "sameAs": [
      "https://www.linkedin.com/company/clothing-manufacturers",
      "https://x.com/clothing_makers"
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "House 125, Road 01, Baridhara DOHS",
      "addressLocality": "Dhaka",
      "postalCode": "1212",
      "addressCountry": "BD"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does SDF Clothing offer remote fashion designer jobs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Several roles at SDF Clothing — including design, merchandising, and marketing — are open to remote candidates worldwide. We review every CV submitted regardless of location."
        }
      },
      {
        "@type": "Question",
        "name": "What types of garment industry jobs does SDF Clothing hire for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We hire across six areas: fashion design and pattern making, quality assurance and compliance, garment merchandising, sustainability and certifications, industrial engineering, and corporate functions including marketing and operations."
        }
      },
      {
        "@type": "Question",
        "name": "How do I apply for a job at SDF Clothing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Submit your CV using the form on this page. We accept PDF, DOC, and DOCX files only. Include your area of interest and a short note about your background. We review every submission and contact candidates when a suitable opening arises."
        }
      },
      {
        "@type": "Question",
        "name": "Can I apply from outside Bangladesh?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We welcome applications from candidates worldwide. Some positions are based at our Dhaka facility, but design, merchandising, and corporate roles have been filled by candidates from the UK, USA, Europe, and Southeast Asia."
        }
      },
      {
        "@type": "Question",
        "name": "What file formats do you accept for CV submissions?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We accept PDF, DOC, and DOCX files only. Please do not send image files, ZIP archives, or Google Drive links. Maximum file size is 10MB."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to hear back after submitting a CV?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We review every submission. If your background matches a current or upcoming opening, we will contact you directly within two to four weeks. We keep CVs on file for six months."
        }
      }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "JobPosting",
    "title": "Fashion Designer — Remote and Dhaka-Based Roles",
    "description": "SDF Clothing is always looking for skilled fashion designers, pattern makers, and garment industry professionals. We hire for remote and on-site roles across design, merchandising, quality, and production. Submit your CV to be considered for current and future openings.",
    "datePosted": "2026-06-01",
    "validThrough": "2026-12-31",
    "employmentType": ["FULL_TIME", "CONTRACTOR"],
    "jobLocationType": "TELECOMMUTE",
    "hiringOrganization": {
      "@type": "Organization",
      "name": "SDF Clothing",
      "sameAs": "https://sdfltd.com",
      "logo": "https://sdfltd.com/logo-small.svg"
    },
    "applicantLocationRequirements": {
      "@type": "Country",
      "name": "Worldwide"
    },
    "jobLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dhaka",
        "addressCountry": "BD"
      }
    }
  }
  </script>

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="breadcrumb-nav">
    <div class="container">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">Careers</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <p class="hero__eyebrow">CAREERS — OPEN WORLDWIDE</p>
      <h1 id="hero-heading" class="hero__heading">
        Remote Fashion Designer Jobs<br>
        <span class="hero__heading-accent">and Garment Industry Roles</span>
      </h1>
      <p class="hero__body">
        We are a clothing manufacturer based in Dhaka, Bangladesh, operating since 1998. We work with fashion brands across 36 countries and hire people who understand how real garments are made — from the first sketch to the finished shipment. No specific positions are listed here. Instead, we keep a pool of CVs from people we want to work with, and we reach out when the right opening comes up.
      </p>
      <div class="hero__stats" role="list">
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-number">28</span>
          <span class="hero__stat-label">Years in garment manufacturing</span>
        </div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-number">36</span>
          <span class="hero__stat-label">Countries we ship to</span>
        </div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-number">13</span>
          <span class="hero__stat-label">International certifications</span>
        </div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-number">Global</span>
          <span class="hero__stat-label">Candidates welcome</span>
        </div>
      </div>
      <a href="#cv-form" class="hero__cta" aria-label="Go to CV submission form">Submit Your CV</a>
    </div>
  </section>

  <!-- WHY JOIN -->
  <section class="why-join" aria-labelledby="why-heading">
    <div class="container">
      <p class="section__eyebrow">WHY WORK WITH US</p>
      <h2 id="why-heading" class="section__heading">What working here actually looks like</h2>
      <p class="section__subheading">We are not a large corporation with a formal HR department. We are a factory that has been run by the same family since 1998. The people who join us tend to stay for a long time, because the work is specific, the team is small, and the products we make end up in fashion stores worldwide.</p>

      <div class="why-grid" role="list">

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">🌍</div>
          <h3 class="why-card__title">Remote-friendly roles</h3>
          <p class="why-card__body">Design, merchandising, and marketing roles have been filled by candidates from the UK, USA, Europe, and Southeast Asia. We work across time zones using clear briefs and structured check-ins. If your skill set is strong, location is rarely a barrier.</p>
        </article>

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">🧵</div>
          <h3 class="why-card__title">Real garment work</h3>
          <p class="why-card__body">Every role here touches actual production. Designers review factory samples. Merchandisers visit the cutting floor. Quality staff work inside GOTS-certified facilities. This is not a brand agency — it is a working factory, and the work reflects that.</p>
        </article>

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">📈</div>
          <h3 class="why-card__title">Room to move</h3>
          <p class="why-card__body">We are a growing business. People who join as coordinators often move into senior roles within two to three years because the team is small enough that good work is noticed. We do not have a rigid hierarchy that blocks progression.</p>
        </article>

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">🏭</div>
          <h3 class="why-card__title">End-to-end production</h3>
          <p class="why-card__body">We run our own spinning, knitting, dyeing, cutting, sewing, and finishing in-house. Working here means you see the complete picture of how a garment goes from fabric to finished product — something most fashion industry jobs do not give you.</p>
        </article>

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">🌱</div>
          <h3 class="why-card__title">Sustainability is actual work</h3>
          <p class="why-card__body">We hold GOTS, OEKO-TEX, BSCI, SA8000, and nine other certifications. Sustainability is not a marketing brief here — it is audit schedules, supplier documentation, and production decisions made every week. People who care about this find real substance in the role.</p>
        </article>

        <article class="why-card" role="listitem">
          <div class="why-card__icon" aria-hidden="true">✈️</div>
          <h3 class="why-card__title">International client exposure</h3>
          <p class="why-card__body">Our clients are fashion brands from the USA, UK, Germany, Australia, and beyond. Merchandising and design roles involve direct communication with international buyers, which is a level of exposure that most Bangladesh-based manufacturing jobs do not offer.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- TALENT AREAS -->
  <section class="talent-areas" aria-labelledby="talent-heading">
    <div class="container">
      <p class="section__eyebrow">WHO WE HIRE</p>
      <h2 id="talent-heading" class="section__heading">The six areas we hire across</h2>
      <p class="section__subheading">We do not post every opening publicly. Instead, we keep CVs from people with strong backgrounds in these areas and approach them when something relevant opens up. If your experience sits in one of these categories, submit your CV and tell us which area fits best.</p>

      <div class="talent-grid" role="list">

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">🎨</span>
            <h3 class="talent-card__title">Fashion Design &amp; Pattern Making</h3>
          </div>
          <p class="talent-card__body">Fashion designers, pattern makers, CAD operators, tech pack developers, and sample coordinators. Remote-friendly for design and development work. On-site for sample review and production grading.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>Fashion design</li>
            <li>Pattern making</li>
            <li>Lectra CAD</li>
            <li>Tech packs</li>
            <li>Sample development</li>
          </ul>
        </article>

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">🔍</span>
            <h3 class="talent-card__title">Quality Assurance &amp; Compliance</h3>
          </div>
          <p class="talent-card__body">In-line and end-line quality inspectors, AQL specialists, compliance officers, and audit managers. Mostly on-site at our Dhaka and Narayanganj facilities. Remote options for documentation and reporting roles.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>AQL inspection</li>
            <li>BSCI audits</li>
            <li>GOTS compliance</li>
            <li>Defect analysis</li>
            <li>QC reporting</li>
          </ul>
        </article>

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">📦</span>
            <h3 class="talent-card__title">Garment Merchandising</h3>
          </div>
          <p class="talent-card__body">Merchandisers who manage buyer communication from sample stage through bulk delivery. Experience with international fashion brands preferred. These roles involve direct contact with clients in the USA, UK, and Europe.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>Buyer communication</li>
            <li>Production planning</li>
            <li>Order tracking</li>
            <li>ERP systems</li>
            <li>Multi-style management</li>
          </ul>
        </article>

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">🌱</span>
            <h3 class="talent-card__title">Sustainability &amp; Certifications</h3>
          </div>
          <p class="talent-card__body">Specialists in GOTS, OEKO-TEX, ESPR, and Digital Product Passport compliance. We are preparing for EU DPP requirements in 2026–27 and need people who understand the regulatory side of sustainable apparel production.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>GOTS 7.0</li>
            <li>OEKO-TEX</li>
            <li>ESPR readiness</li>
            <li>Audit management</li>
            <li>Sustainability reporting</li>
          </ul>
        </article>

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">⚙️</span>
            <h3 class="talent-card__title">Industrial Engineering &amp; Production</h3>
          </div>
          <p class="talent-card__body">Industrial engineers, line supervisors, production planners, and floor managers. SAM calculation, GSD, lean manufacturing, and efficiency improvement. On-site roles based at our Dhaka production facility.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>SAM calculation</li>
            <li>GSD</li>
            <li>Line balancing</li>
            <li>Lean manufacturing</li>
            <li>Time studies</li>
          </ul>
        </article>

        <article class="talent-card" role="listitem">
          <div class="talent-card__header">
            <span class="talent-card__icon" aria-hidden="true">💼</span>
            <h3 class="talent-card__title">Marketing, Operations &amp; Corporate</h3>
          </div>
          <p class="talent-card__body">B2B marketing coordinators, content writers, operations managers, and corporate support roles. These positions are well-suited to remote candidates. Experience in fashion, apparel, or manufacturing is a genuine advantage.</p>
          <ul class="talent-card__tags" aria-label="Related skills">
            <li>B2B marketing</li>
            <li>Content writing</li>
            <li>LinkedIn management</li>
            <li>Trade show coordination</li>
            <li>Operations planning</li>
          </ul>
        </article>

      </div>
    </div>
  </section>

  <!-- PROCESS STEPS -->
  <section class="process" aria-labelledby="process-heading">
    <div class="container">
      <p class="section__eyebrow">WHAT HAPPENS NEXT</p>
      <h2 id="process-heading" class="section__heading">How we handle every CV we receive</h2>

      <div class="process-steps" role="list">

        <article class="process-step" role="listitem">
          <div class="process-step__marker" aria-hidden="true">01</div>
          <div class="process-step__content">
            <h3 class="process-step__title">You submit your CV</h3>
            <p class="process-step__body">Fill in the form below with your name, email, the area you work in, and your CV as a PDF, DOC, or DOCX file. A short note about your background helps us understand where you fit — even two or three sentences is enough.</p>
          </div>
        </article>

        <article class="process-step" role="listitem">
          <div class="process-step__marker" aria-hidden="true">02</div>
          <div class="process-step__content">
            <h3 class="process-step__title">We read it and file it</h3>
            <p class="process-step__body">Someone here reads every CV we receive. We are not running automated filters. If your background is relevant to what we do, your CV goes into our active pool. If it is not a match for any area we hire in, we will let you know.</p>
          </div>
        </article>

        <article class="process-step" role="listitem">
          <div class="process-step__marker" aria-hidden="true">03</div>
          <div class="process-step__content">
            <h3 class="process-step__title">We contact you when there is a fit</h3>
            <p class="process-step__body">When an opening comes up that matches your background, we contact you directly. We keep CVs on file for six months. Most conversations start with a short email exchange, followed by a video call with the relevant team lead.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- CV UPLOAD FORM -->
  <section class="cv-form-section" id="cv-form" aria-labelledby="form-heading">
    <div class="container">
      <div class="cv-form-wrapper">

        <div class="cv-form-intro">
          <p class="section__eyebrow">SUBMIT YOUR CV</p>
          <h2 id="form-heading" class="section__heading">Send us your CV — we keep it on file</h2>
          <p class="cv-form-intro__body">There is no specific job to apply for right now. You are submitting your details so we can reach out when something relevant opens up. We accept candidates from anywhere in the world. Remote and on-site roles both available depending on the position.</p>

          <div class="cv-form-requirements" role="list" aria-label="File requirements">
            <div class="cv-req" role="listitem">
              <span class="cv-req__icon" aria-hidden="true">📄</span>
              <span class="cv-req__text">PDF, DOC, or DOCX only</span>
            </div>
            <div class="cv-req" role="listitem">
              <span class="cv-req__icon" aria-hidden="true">📏</span>
              <span class="cv-req__text">Maximum file size 10MB</span>
            </div>
            <div class="cv-req" role="listitem">
              <span class="cv-req__icon" aria-hidden="true">🔒</span>
              <span class="cv-req__text">Your data is kept private</span>
            </div>
            <div class="cv-req" role="listitem">
              <span class="cv-req__icon" aria-hidden="true">🗂️</span>
              <span class="cv-req__text">CVs kept on file for 6 months</span>
            </div>
          </div>
        </div>

        <div class="cv-form-container">
          <form
            id="cv-upload-form"
            action="https://usebasin.com/f/9ecfe65e8aee"
            method="POST"
            enctype="multipart/form-data"
            novalidate
            aria-label="CV submission form"
          >
            <input type="text" name="_honey" class="cv-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="cv-form__field">
              <label for="cv-name" class="cv-form__label">Full Name <span class="cv-form__required" aria-label="required">*</span></label>
              <input
                type="text"
                id="cv-name"
                name="name"
                required
                autocomplete="name"
                placeholder="Your full name"
                class="cv-form__input"
                aria-required="true"
                aria-describedby="cv-name-error"
              />
              <span id="cv-name-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__field">
              <label for="cv-email" class="cv-form__label">Email Address <span class="cv-form__required" aria-label="required">*</span></label>
              <input
                type="email"
                id="cv-email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="cv-form__input"
                aria-required="true"
                aria-describedby="cv-email-error"
              />
              <span id="cv-email-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__row">
              <div class="cv-form__field">
                <label for="cv-phone" class="cv-form__label">Phone Number</label>
                <input
                  type="tel"
                  id="cv-phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+1 555 000 0000"
                  class="cv-form__input"
                  aria-describedby="cv-phone-hint"
                />
                <span id="cv-phone-hint" class="cv-form__hint">Include country code</span>
              </div>

              <div class="cv-form__field">
                <label for="cv-country" class="cv-form__label">Country <span class="cv-form__required" aria-label="required">*</span></label>
                <input
                  type="text"
                  id="cv-country"
                  name="country"
                  required
                  autocomplete="country-name"
                  placeholder="e.g. United Kingdom"
                  class="cv-form__input"
                  aria-required="true"
                  aria-describedby="cv-country-error"
                />
                <span id="cv-country-error" class="cv-form__error" role="alert" aria-live="polite"></span>
              </div>
            </div>

            <div class="cv-form__field">
              <label for="cv-area" class="cv-form__label">Area of expertise <span class="cv-form__required" aria-label="required">*</span></label>
              <select
                id="cv-area"
                name="area_of_expertise"
                required
                class="cv-form__select"
                aria-required="true"
                aria-describedby="cv-area-error"
              >
                <option value="">Select the area that fits best</option>
                <option value="Fashion Design & Pattern Making">Fashion Design &amp; Pattern Making</option>
                <option value="Quality Assurance & Compliance">Quality Assurance &amp; Compliance</option>
                <option value="Garment Merchandising">Garment Merchandising</option>
                <option value="Sustainability & Certifications">Sustainability &amp; Certifications</option>
                <option value="Industrial Engineering & Production">Industrial Engineering &amp; Production</option>
                <option value="Marketing, Operations & Corporate">Marketing, Operations &amp; Corporate</option>
                <option value="Other / Not Listed">Other / Not Listed</option>
              </select>
              <span id="cv-area-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__field">
              <label for="cv-experience" class="cv-form__label">Years of experience <span class="cv-form__required" aria-label="required">*</span></label>
              <select
                id="cv-experience"
                name="years_of_experience"
                required
                class="cv-form__select"
                aria-required="true"
                aria-describedby="cv-experience-error"
              >
                <option value="">Select years of experience</option>
                <option value="Under 1 year">Under 1 year</option>
                <option value="1 to 3 years">1 to 3 years</option>
                <option value="3 to 5 years">3 to 5 years</option>
                <option value="5 to 10 years">5 to 10 years</option>
                <option value="Over 10 years">Over 10 years</option>
              </select>
              <span id="cv-experience-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__field">
              <label for="cv-work-type" class="cv-form__label">Preferred work arrangement <span class="cv-form__required" aria-label="required">*</span></label>
              <select
                id="cv-work-type"
                name="work_arrangement"
                required
                class="cv-form__select"
                aria-required="true"
                aria-describedby="cv-work-type-error"
              >
                <option value="">Select your preference</option>
                <option value="Remote — open to any location">Remote — open to any location</option>
                <option value="On-site — Dhaka, Bangladesh">On-site — Dhaka, Bangladesh</option>
                <option value="Either remote or on-site">Either remote or on-site</option>
                <option value="Hybrid arrangement preferred">Hybrid arrangement preferred</option>
              </select>
              <span id="cv-work-type-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__field">
              <label for="cv-file" class="cv-form__label">Your CV <span class="cv-form__required" aria-label="required">*</span></label>
              <div class="cv-form__upload-area" id="upload-area" role="button" tabindex="0" aria-label="Click or drag and drop to upload your CV">
                <span class="cv-form__upload-icon" aria-hidden="true">📎</span>
                <span class="cv-form__upload-main" id="upload-main-text">Drag and drop your CV here, or click to browse</span>
                <span class="cv-form__upload-sub">PDF, DOC, or DOCX — maximum 10MB</span>
                <input
                  type="file"
                  id="cv-file"
                  name="cv_file"
                  required
                  accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                  class="cv-form__file-input"
                  aria-required="true"
                  aria-describedby="cv-file-error cv-file-hint"
                />
              </div>
              <span id="cv-file-hint" class="cv-form__hint">Only PDF, DOC, and DOCX files are accepted</span>
              <span id="cv-file-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__field">
              <label for="cv-linkedin" class="cv-form__label">LinkedIn profile URL</label>
              <input
                type="url"
                id="cv-linkedin"
                name="linkedin_url"
                placeholder="https://linkedin.com/in/yourname"
                class="cv-form__input"
                aria-describedby="cv-linkedin-hint"
              />
              <span id="cv-linkedin-hint" class="cv-form__hint">Optional but helpful for design and marketing roles</span>
            </div>

            <div class="cv-form__field">
              <label for="cv-note" class="cv-form__label">A short note about your background</label>
              <textarea
                id="cv-note"
                name="background_note"
                rows="4"
                maxlength="600"
                placeholder="Two or three sentences about your experience and what kind of role you are looking for. This helps us place your CV in the right folder."
                class="cv-form__textarea"
                aria-describedby="cv-note-hint cv-note-count"
              ></textarea>
              <div class="cv-form__textarea-footer">
                <span id="cv-note-hint" class="cv-form__hint">Optional. Maximum 600 characters.</span>
                <span id="cv-note-count" class="cv-form__char-count" aria-live="polite">0 / 600</span>
              </div>
            </div>

            <div class="cv-form__consent">
              <label class="cv-form__checkbox-label">
                <input
                  type="checkbox"
                  id="cv-consent"
                  name="gdpr_consent"
                  value="yes"
                  required
                  class="cv-form__checkbox"
                  aria-required="true"
                  aria-describedby="cv-consent-error"
                />
                <span class="cv-form__checkbox-text">
                  I agree that SDF Clothing may store my details and CV for up to six months for recruitment purposes. I understand I can request removal at any time by contacting <a href="/contact" class="cv-form__consent-link">the team directly</a>.
                </span>
              </label>
              <span id="cv-consent-error" class="cv-form__error" role="alert" aria-live="polite"></span>
            </div>

            <div class="cv-form__submit-row">
              <button type="submit" id="cv-submit-btn" class="cv-form__submit" aria-describedby="cv-submit-status">
                <span class="cv-form__submit-text">Submit Your CV</span>
                <span class="cv-form__submit-spinner" aria-hidden="true" hidden></span>
              </button>
              <span id="cv-submit-status" class="cv-form__submit-status" aria-live="polite"></span>
            </div>

          </form>

          <div id="cv-success" class="cv-form__success" hidden role="status" aria-live="polite">
            <span class="cv-form__success-icon" aria-hidden="true">✅</span>
            <div>
              <p class="cv-form__success-title">CV received — thank you</p>
              <p class="cv-form__success-body">We have your details on file. If your background matches a current or upcoming opening, we will be in touch directly. Most contact happens within two to four weeks of a relevant opening arising.</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="container">
      <p class="section__eyebrow">COMMON QUESTIONS</p>
      <h2 id="faq-heading" class="section__heading">Questions about applying</h2>

      <div class="faq-list" role="list">

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-1">
            Does SDF Clothing offer remote fashion designer jobs?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-1" hidden>
            <p>Yes. Several roles at SDF Clothing — including design, merchandising, and marketing — are open to remote candidates worldwide. We review every CV submitted regardless of where the candidate is based. On-site roles at our Dhaka facility are also available for candidates who are relocating or already based in Bangladesh.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-2">
            What types of garment industry jobs does SDF Clothing hire for?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-2" hidden>
            <p>We hire across six areas: fashion design and pattern making, quality assurance and compliance, garment merchandising, sustainability and certifications, industrial engineering and production, and corporate functions including marketing and operations. The form above lets you indicate which area fits your background.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-3">
            Can I apply from outside Bangladesh?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-3" hidden>
            <p>Yes. We welcome applications from candidates worldwide. Some positions — primarily production floor and quality inspection roles — require on-site presence in Dhaka. But design, merchandising, marketing, and certain compliance roles have been filled by candidates from the UK, USA, Europe, and Southeast Asia working remotely.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-4">
            What file formats do you accept for CV submissions?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-4" hidden>
            <p>We accept PDF, DOC, and DOCX files only. Please do not send image files, ZIP archives, portfolios in unsupported formats, or Google Drive links. Maximum file size is 10MB. If your CV is currently in another format, convert it to PDF before submitting — PDF is the most reliable format for us to open across different devices.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-5">
            How long does it take to hear back after submitting a CV?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-5" hidden>
            <p>We review every submission. If your background matches a current or upcoming opening, we will contact you directly within two to four weeks. If there is no immediate match, your CV stays in our active pool for six months. We do not send automated rejection emails — if you do not hear from us, your CV is still on file and we may reach out later.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-6">
            Do I need experience specifically in Bangladesh's garment industry?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-6" hidden>
            <p>No. What matters is that your experience is relevant to the area you are applying for. Several of our current team members came from fashion brands, buying houses, or design agencies outside Bangladesh. A background in garment manufacturing anywhere in the world is an advantage, but it is not a requirement for every role.</p>
          </div>
        </article>

        <article class="faq-item" role="listitem">
          <button class="faq-item__question" aria-expanded="false" aria-controls="faq-7">
            Is there a way to check if my CV was received?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__answer" id="faq-7" hidden>
            <p>Yes. After submitting, you will see a confirmation message on this page. If you do not see that message, your CV may not have been submitted successfully — try again or contact us directly through the <a href="/contact" style="color: var(--color-accent);">contact page</a>. We do not send automated confirmation emails, so the on-screen message is your confirmation.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="bottom-cta" aria-labelledby="cta-heading">
    <div class="container">
      <div class="bottom-cta__inner">
        <div>
          <h2 id="cta-heading" class="bottom-cta__heading">Not looking for a job — but know someone who is?</h2>
          <p class="bottom-cta__body">Share this page with anyone working in fashion design, garment manufacturing, or apparel sourcing. We are always building our pool of people to reach out to, and introductions are always welcome.</p>
        </div>
        <div class="bottom-cta__actions">
          <a href="#cv-form" class="bottom-cta__btn bottom-cta__btn--primary">Submit a CV</a>
          <a href="/contact" class="bottom-cta__btn bottom-cta__btn--secondary">Get in touch instead</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  (function () {
    'use strict';

    /* ── FAQ accordion ── */
    document.querySelectorAll('.faq-item__question').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var answerId = this.getAttribute('aria-controls');
        var answer = document.getElementById(answerId);
        var isOpen = this.getAttribute('aria-expanded') === 'true';
        var icon = this.querySelector('.faq-item__icon');

        this.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (isOpen) {
          answer.hidden = true;
          if (icon) icon.textContent = '+';
        } else {
          answer.hidden = false;
          if (icon) icon.textContent = '−';
        }
      });
    });

    /* ── File upload drag-drop ── */
    var uploadArea = document.getElementById('upload-area');
    var fileInput = document.getElementById('cv-file');
    var uploadMainText = document.getElementById('upload-main-text');

    if (uploadArea && fileInput) {
      uploadArea.addEventListener('click', function () { fileInput.click(); });

      uploadArea.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      });

      ['dragenter', 'dragover'].forEach(function (evt) {
        uploadArea.addEventListener(evt, function (e) {
          e.preventDefault();
          uploadArea.classList.add('cv-form__upload-area--drag');
        });
      });

      ['dragleave', 'drop'].forEach(function (evt) {
        uploadArea.addEventListener(evt, function (e) {
          e.preventDefault();
          uploadArea.classList.remove('cv-form__upload-area--drag');
        });
      });

      uploadArea.addEventListener('drop', function (e) {
        var dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length) {
          fileInput.files = dt.files;
          updateFileName(dt.files[0]);
        }
      });

      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) {
          updateFileName(this.files[0]);
        }
      });

      function updateFileName(file) {
        if (uploadMainText) {
          uploadMainText.textContent = '📎 ' + file.name;
        }
        uploadArea.classList.add('cv-form__upload-area--has-file');
      }
    }

    /* ── Char counter ── */
    var noteTextarea = document.getElementById('cv-note');
    var noteCount = document.getElementById('cv-note-count');

    if (noteTextarea && noteCount) {
      noteTextarea.addEventListener('input', function () {
        noteCount.textContent = this.value.length + ' / 600';
      });
    }

    /* ── Form validation helpers ── */
    function showError(inputId, message) {
      var input = document.getElementById(inputId);
      var error = document.getElementById(inputId + '-error');
      if (input) input.classList.add('cv-form__input--error');
      if (error) error.textContent = message;
    }

    function clearError(inputId) {
      var input = document.getElementById(inputId);
      var error = document.getElementById(inputId + '-error');
      if (input) input.classList.remove('cv-form__input--error');
      if (error) error.textContent = '';
    }

    function validateForm() {
      var valid = true;

      var name = document.getElementById('cv-name');
      clearError('cv-name');
      if (!name || name.value.trim().length < 2) {
        showError('cv-name', 'Please enter your full name.');
        valid = false;
      }

      var email = document.getElementById('cv-email');
      clearError('cv-email');
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
        showError('cv-email', 'Please enter a valid email address.');
        valid = false;
      }

      var country = document.getElementById('cv-country');
      clearError('cv-country');
      if (!country || country.value.trim().length < 2) {
        showError('cv-country', 'Please enter your country.');
        valid = false;
      }

      var area = document.getElementById('cv-area');
      clearError('cv-area');
      if (!area || !area.value) {
        showError('cv-area', 'Please select your area of expertise.');
        valid = false;
      }

      var experience = document.getElementById('cv-experience');
      clearError('cv-experience');
      if (!experience || !experience.value) {
        showError('cv-experience', 'Please select your years of experience.');
        valid = false;
      }

      var workType = document.getElementById('cv-work-type');
      clearError('cv-work-type');
      if (!workType || !workType.value) {
        showError('cv-work-type', 'Please select your preferred work arrangement.');
        valid = false;
      }

      var file = document.getElementById('cv-file');
      clearError('cv-file');
      if (!file || !file.files || !file.files[0]) {
        showError('cv-file', 'Please attach your CV file.');
        valid = false;
      } else {
        var f = file.files[0];
        var allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
        var allowedExtensions = /\.(pdf|doc|docx)$/i;
        if (!allowedTypes.includes(f.type) && !allowedExtensions.test(f.name)) {
          showError('cv-file', 'Only PDF, DOC, and DOCX files are accepted.');
          valid = false;
        } else if (f.size > 10 * 1024 * 1024) {
          showError('cv-file', 'File size must be under 10MB.');
          valid = false;
        }
      }

      var consent = document.getElementById('cv-consent');
      clearError('cv-consent');
      if (!consent || !consent.checked) {
        showError('cv-consent', 'Please confirm your consent to continue.');
        valid = false;
      }

      return valid;
    }

    /* ── Form submission ── */
    var form = document.getElementById('cv-upload-form');
    var submitBtn = document.getElementById('cv-submit-btn');
    var submitText = submitBtn ? submitBtn.querySelector('.cv-form__submit-text') : null;
    var submitSpinner = submitBtn ? submitBtn.querySelector('.cv-form__submit-spinner') : null;
    var successBlock = document.getElementById('cv-success');
    var submitStatus = document.getElementById('cv-submit-status');

    if (form && submitBtn) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (!validateForm()) {
          var firstError = form.querySelector('.cv-form__input--error, .cv-form__select.cv-form__input--error');
          if (firstError) firstError.focus();
          return;
        }

        /* honeypot check */
        var honey = form.querySelector('input[name="_honey"]');
        if (honey && honey.value) { return; }

        submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Submitting…';
        if (submitSpinner) submitSpinner.hidden = false;
        if (submitStatus) submitStatus.textContent = 'Sending your CV — please wait.';

        var formData = new FormData(form);

        try {
          var response = await fetch('https://usebasin.com/f/9ecfe65e8aee', {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });

          if (response.ok) {
            form.hidden = true;
            if (successBlock) successBlock.hidden = false;
            if (submitStatus) submitStatus.textContent = '';
          } else {
            throw new Error('Server returned ' + response.status);
          }
        } catch (err) {
          submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Submit Your CV';
          if (submitSpinner) submitSpinner.hidden = true;
          if (submitStatus) submitStatus.textContent = '';
          var fileErr = document.getElementById('cv-file-error');
          if (fileErr) fileErr.textContent = 'Something went wrong. Please try again or contact us directly through the contact page.';
        }
      });

      /* live clear errors on input */
      ['cv-name', 'cv-email', 'cv-country'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', function () { clearError(id); });
      });
      ['cv-area', 'cv-experience', 'cv-work-type'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', function () { clearError(id); });
      });
    }
  })();
  </script>

  <style>
