---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Remote Fashion Designer Jobs — Submit Your CV | SDF";
const pageDescription = "Hiring remote fashion designers, merchandisers, and garment industry roles worldwide. Submit your CV to SDF Clothing — candidates from any country welcome.";
const canonicalURL = "https://sdfltd.com/careers";

const talentAreas = [
  {
    id: "design",
    emoji: "🎨",
    title: "Fashion Design & Pattern Making",
    subtitle: "Remote & On-site",
    color: "#1a1a2e",
    accent: "#e00",
    description: "Fashion designers, pattern makers, CAD operators, tech pack developers, and sample coordinators. Remote-friendly for design work. On-site for sample review and production grading at our Dhaka facility.",
    tags: ["Fashion Design", "Pattern Making", "Lectra CAD", "Tech Packs", "Sample Dev"]
  },
  {
    id: "quality",
    emoji: "🔍",
    title: "Quality Assurance & Compliance",
    subtitle: "Primarily On-site",
    color: "#1a2e1a",
    accent: "#e00",
    description: "In-line and end-line quality inspectors, AQL specialists, compliance officers, and audit managers. Mostly on-site at our Dhaka and Narayanganj facilities.",
    tags: ["AQL Inspection", "BSCI Audits", "GOTS Compliance", "Defect Analysis", "QC Reporting"]
  },
  {
    id: "merchandising",
    emoji: "📦",
    title: "Garment Merchandising",
    subtitle: "Remote & On-site",
    color: "#2e2a1a",
    accent: "#e00",
    description: "Merchandisers managing buyer communication from sample stage through bulk delivery. Direct contact with fashion brand clients in the USA, UK, and Europe.",
    tags: ["Buyer Communication", "Production Planning", "Order Tracking", "ERP Systems", "Multi-style Mgmt"]
  },
  {
    id: "sustainability",
    emoji: "🌱",
    title: "Sustainability & Certifications",
    subtitle: "Remote Possible",
    color: "#1a2e2a",
    accent: "#e00",
    description: "Specialists in GOTS, OEKO-TEX, ESPR, and Digital Product Passport compliance. We are preparing for EU DPP requirements and need people who understand regulatory apparel standards.",
    tags: ["GOTS 7.0", "OEKO-TEX", "ESPR Readiness", "Audit Management", "DPP Compliance"]
  },
  {
    id: "engineering",
    emoji: "⚙️",
    title: "Industrial Engineering & Production",
    subtitle: "On-site Dhaka",
    color: "#2e1a2a",
    accent: "#e00",
    description: "Industrial engineers, line supervisors, production planners, and floor managers. SAM calculation, GSD, lean manufacturing, and efficiency improvement roles.",
    tags: ["SAM Calculation", "GSD", "Line Balancing", "Lean Manufacturing", "Time Studies"]
  },
  {
    id: "corporate",
    emoji: "💼",
    title: "Marketing, Operations & Corporate",
    subtitle: "Mostly Remote",
    color: "#1a1e2e",
    accent: "#e00",
    description: "B2B marketing coordinators, content writers, operations managers, and corporate support roles. Well-suited to remote candidates. Fashion or manufacturing experience is an advantage.",
    tags: ["B2B Marketing", "Content Writing", "LinkedIn Mgmt", "Trade Shows", "Operations"]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Remote Fashion Designer Jobs — Submit Your CV | SDF Clothing",
    "description": "Hiring remote fashion designers, merchandisers, and garment industry roles worldwide. Submit your CV to SDF Clothing — candidates from any country welcome.",
    "url": "https://sdfltd.com/careers",
    "lastReviewed": "2026-06-11",
    "isPartOf": {
      "@type": "WebSite",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com" },
        { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://sdfltd.com/careers" }
      ]
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "JobPosting",
    "title": "Remote Fashion Designer — Garment Industry Roles Worldwide",
    "description": "SDF Clothing is always looking for skilled fashion designers, pattern makers, merchandisers, and garment industry professionals for remote and on-site roles. Submit your CV to be considered for current and future openings across design, quality, merchandising, sustainability, and production.",
    "datePosted": "2026-06-01",
    "validThrough": "2026-12-31",
    "employmentType": ["FULL_TIME", "CONTRACTOR"],
    "jobLocationType": "TELECOMMUTE",
    "hiringOrganization": {
      "@type": "Organization",
      "name": "SDF Clothing",
      "sameAs": "https://sdfltd.com",
      "logo": "https://sdfltd.com/logo-small.svg"
    },
    "applicantLocationRequirements": { "@type": "Country", "name": "Worldwide" },
    "jobLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dhaka",
        "addressCountry": "BD"
      }
    },
    "occupationalCategory": ["Fashion Design", "Garment Manufacturing", "Textile Industry", "Apparel Merchandising"],
    "skills": "Fashion Design, Pattern Making, Garment Merchandising, Quality Assurance, AQL, GOTS, Sustainability, Industrial Engineering"
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does SDF Clothing offer remote fashion designer jobs?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Design, merchandising, and marketing roles are open to remote candidates worldwide. We review every CV regardless of location and contact candidates when a suitable opening arises." }
      },
      {
        "@type": "Question",
        "name": "What garment industry jobs does SDF Clothing hire for?",
        "acceptedAnswer": { "@type": "Answer", "text": "We hire across six areas: fashion design and pattern making, quality assurance and compliance, garment merchandising, sustainability and certifications, industrial engineering, and corporate functions including marketing and operations." }
      },
      {
        "@type": "Question",
        "name": "Can I apply for fashion jobs from outside Bangladesh?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We welcome candidates worldwide. Design, merchandising, and marketing roles have been filled by candidates from the UK, USA, Europe, and Southeast Asia working remotely." }
      },
      {
        "@type": "Question",
        "name": "What CV file formats do you accept?",
        "acceptedAnswer": { "@type": "Answer", "text": "PDF, DOC, and DOCX only. Maximum file size is 10MB. No image files, ZIP archives, or Google Drive links." }
      },
      {
        "@type": "Question",
        "name": "How long does it take to hear back after submitting a CV?",
        "acceptedAnswer": { "@type": "Answer", "text": "We read every CV. If your background matches a current or upcoming opening, we contact you within two to four weeks. CVs are kept on file for six months." }
      },
      {
        "@type": "Question",
        "name": "What is the best way to find remote fashion designer jobs at a garment factory?",
        "acceptedAnswer": { "@type": "Answer", "text": "Submit your CV directly to manufacturers like SDF Clothing who hire internationally for design and merchandising roles. Include your area of expertise, preferred work arrangement, and a short note about your background. Factories that work with international brands are most likely to offer remote options." }
      }
    ]
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SDF Clothing",
    "url": "https://sdfltd.com",
    "logo": "https://sdfltd.com/logo-small.svg",
    "foundingDate": "1998",
    "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 500 },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "House 125, Road 01, Baridhara DOHS",
      "addressLocality": "Dhaka",
      "postalCode": "1212",
      "addressCountry": "BD"
    },
    "sameAs": [
      "https://www.linkedin.com/company/clothing-manufacturers",
      "https://x.com/clothing_makers"
    ]
  }
  </script>

  <!-- BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="c-breadcrumb">
    <div class="c-container">
      <ol class="c-breadcrumb__list">
        <li class="c-breadcrumb__item"><a href="/" class="c-breadcrumb__link">Home</a></li>
        <li class="c-breadcrumb__item" aria-current="page">Careers</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="c-hero" aria-labelledby="hero-h1">
    <div class="c-container">
      <div class="c-hero__inner">
        <div class="c-hero__text">
          <p class="c-eyebrow">Careers — Open Worldwide</p>
          <h1 id="hero-h1" class="c-hero__h1">
            Remote Fashion Designer Jobs<br>
            <span class="c-hero__h1-line2">and Garment Industry Careers</span>
          </h1>
          <p class="c-hero__lead">
            We are a clothing manufacturer in Dhaka, Bangladesh — running our own factory since 1998. We work with fashion brands across 36 countries. When we need someone good, we look everywhere. Submit your CV and we will reach out when the right role opens.
          </p>
          <div class="c-hero__actions">
            <a href="#cv-form" class="c-btn c-btn--primary">Submit Your CV</a>
            <a href="#talent-areas" class="c-btn c-btn--ghost">See Open Areas</a>
          </div>
        </div>
        <div class="c-hero__stats" aria-label="Company facts">
          <div class="c-stat">
            <span class="c-stat__num">1998</span>
            <span class="c-stat__label">Factory founded</span>
          </div>
          <div class="c-stat">
            <span class="c-stat__num">36</span>
            <span class="c-stat__label">Countries served</span>
          </div>
          <div class="c-stat">
            <span class="c-stat__num">13</span>
            <span class="c-stat__label">Certifications held</span>
          </div>
          <div class="c-stat">
            <span class="c-stat__num">6</span>
            <span class="c-stat__label">Areas we hire in</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TALENT AREA CARDS — Google Careers style -->
  <section class="c-areas" id="talent-areas" aria-labelledby="areas-h2">
    <div class="c-container">
      <p class="c-eyebrow">Who We Hire</p>
      <h2 id="areas-h2" class="c-section-h2">Six areas we are always hiring in</h2>
      <p class="c-section-lead">We do not post every opening. Instead we keep a pool of CVs and reach out when something comes up. Pick the area that fits your background when you submit below.</p>

      <div class="c-areas__grid" role="list">
        {talentAreas.map((area) => (
          <article class="c-area-card" role="listitem" data-area-id={area.id}>
            <div class="c-area-card__top">
              <div class="c-area-card__emoji" aria-hidden="true">{area.emoji}</div>
              <span class="c-area-card__badge">{area.subtitle}</span>
            </div>
            <h3 class="c-area-card__title">{area.title}</h3>
            <p class="c-area-card__desc">{area.description}</p>
            <ul class="c-area-card__tags" aria-label="Skills">
              {area.tags.map(tag => <li>{tag}</li>)}
            </ul>
            <button
              class="c-area-card__apply"
              data-area={area.title}
              aria-label={`Apply for ${area.title} — opens CV form`}
            >
              Submit CV for this area →
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY JOIN -->
  <section class="c-why" aria-labelledby="why-h2">
    <div class="c-container">
      <p class="c-eyebrow">Why Work Here</p>
      <h2 id="why-h2" class="c-section-h2">What working at SDF actually looks like</h2>
      <div class="c-why__grid" role="list">
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">🌍</span>
          <h3 class="c-why-card__title">Remote-friendly positions</h3>
          <p class="c-why-card__body">Design, merchandising, and marketing roles have been filled by people in the UK, USA, Germany, and Southeast Asia. If your work is strong, location rarely stops us.</p>
        </article>
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">🧵</span>
          <h3 class="c-why-card__title">Real production exposure</h3>
          <p class="c-why-card__body">Every role here touches actual garments. Designers review factory samples. Merchandisers see the cutting floor. You learn how fashion actually moves from sketch to shipment.</p>
        </article>
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">📈</span>
          <h3 class="c-why-card__title">Room to grow quickly</h3>
          <p class="c-why-card__body">The team is small enough that good work gets noticed. Several people joined as coordinators and moved into senior roles within two years because there is no rigid hierarchy blocking them.</p>
        </article>
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">🌱</span>
          <h3 class="c-why-card__title">Sustainability is real work</h3>
          <p class="c-why-card__body">We hold GOTS, OEKO-TEX, BSCI, SA8000 and nine more certifications. This is not marketing — it is audit schedules and production decisions made every single week.</p>
        </article>
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">✈️</span>
          <h3 class="c-why-card__title">International client base</h3>
          <p class="c-why-card__body">Our clients are fashion brands from the USA, UK, Germany, and Australia. Merchandising and design roles involve direct communication with buyers you would not normally reach from a factory job.</p>
        </article>
        <article class="c-why-card" role="listitem">
          <span class="c-why-card__icon" aria-hidden="true">🏭</span>
          <h3 class="c-why-card__title">End-to-end manufacturing</h3>
          <p class="c-why-card__body">Spinning, knitting, dyeing, cutting, sewing, finishing — all in-house. You see the complete picture of how a garment goes from fibre to finished product. Most fashion jobs do not give you that.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="c-process" aria-labelledby="process-h2">
    <div class="c-container">
      <p class="c-eyebrow">How It Works</p>
      <h2 id="process-h2" class="c-section-h2">What happens after you submit your CV</h2>
      <div class="c-process__steps" role="list">
        <article class="c-process-step" role="listitem">
          <div class="c-process-step__num" aria-hidden="true">01</div>
          <div class="c-process-step__body">
            <h3 class="c-process-step__title">Submit your CV below</h3>
            <p class="c-process-step__text">Fill in the form, choose your area, attach your CV as a PDF, DOC, or DOCX, and write a short paragraph about your background and what you are looking for. This note is required and helps us understand your fit before anything else.</p>
          </div>
        </article>
        <article class="c-process-step" role="listitem">
          <div class="c-process-step__num" aria-hidden="true">02</div>
          <div class="c-process-step__body">
            <h3 class="c-process-step__title">A person reads it</h3>
            <p class="c-process-step__text">No automated filters. Someone here reads every CV. If your background is relevant, your file goes into our active pool and stays there for six months.</p>
          </div>
        </article>
        <article class="c-process-step" role="listitem">
          <div class="c-process-step__num" aria-hidden="true">03</div>
          <div class="c-process-step__body">
            <h3 class="c-process-step__title">We contact you when there is a match</h3>
            <p class="c-process-step__text">When an opening fits your profile, we email you directly. Most conversations start with a short email exchange followed by a video call with the team lead.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CV FORM -->
  <section class="c-form-section" id="cv-form" aria-labelledby="form-h2">
    <div class="c-container">
      <div class="c-form-layout">

        <div class="c-form-sidebar">
          <p class="c-eyebrow">Submit Your CV</p>
          <h2 id="form-h2" class="c-section-h2">Send us your details — we keep your CV on file</h2>
          <p class="c-form-sidebar__body">There is no specific job to apply for right now. You are submitting so we can reach out when something relevant opens up. Candidates from any country are welcome.</p>
          <div class="c-form-sidebar__reqs" role="list" aria-label="File requirements">
            <div class="c-req" role="listitem"><span aria-hidden="true">📄</span><span>PDF, DOC, or DOCX only</span></div>
            <div class="c-req" role="listitem"><span aria-hidden="true">📏</span><span>Maximum file size 10 MB</span></div>
            <div class="c-req" role="listitem"><span aria-hidden="true">🔒</span><span>Your data stays private</span></div>
            <div class="c-req" role="listitem"><span aria-hidden="true">🗂️</span><span>CV kept on file for 6 months</span></div>
            <div class="c-req" role="listitem"><span aria-hidden="true">🌍</span><span>Open to candidates worldwide</span></div>
          </div>
        </div>

        <div class="c-form-box">
          <form
            id="cv-upload-form"
            novalidate
            aria-label="CV submission form"
          >
            <!-- Honeypot -->
            <input type="text" name="_honey" class="c-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none;" />

            <div class="c-field">
              <label for="f-name" class="c-label">Full Name <span class="c-req-star" aria-label="required">*</span></label>
              <input type="text" id="f-name" name="name" required autocomplete="name" placeholder="Your full name" class="c-input" aria-required="true" aria-describedby="e-name" />
              <span id="e-name" class="c-field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="c-field-row">
              <div class="c-field">
                <label for="f-email" class="c-label">Email Address <span class="c-req-star" aria-label="required">*</span></label>
                <input type="email" id="f-email" name="email" required autocomplete="email" placeholder="you@example.com" class="c-input" aria-required="true" aria-describedby="e-email" />
                <span id="e-email" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
              <div class="c-field">
                <label for="f-phone" class="c-label">Phone Number</label>
                <input type="tel" id="f-phone" name="phone" autocomplete="tel" placeholder="+1 555 000 0000" class="c-input" aria-describedby="h-phone" />
                <span id="h-phone" class="c-field-hint">Include country code</span>
              </div>
            </div>

            <div class="c-field-row">
              <div class="c-field">
                <label for="f-nid" class="c-label">National ID Number <span class="c-req-star" aria-label="required">*</span></label>
                <input type="text" id="f-nid" name="nid" required placeholder="Your national ID number" class="c-input" aria-required="true" aria-describedby="h-nid e-nid" />
                <span id="h-nid" class="c-field-hint">Used solely to maintain your candidate record and prevent duplicate applications. Stored securely and never shared.</span>
                <span id="e-nid" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
              <div class="c-field">
                <label for="f-salary" class="c-label">Expected Salary (USD/month)</label>
                <input type="text" id="f-salary" name="expected_salary" placeholder="e.g. 800" class="c-input" aria-describedby="h-salary" />
                <span id="h-salary" class="c-field-hint">Optional — helps us match you to the right opportunity</span>
              </div>
            </div>

            <div class="c-field-row">
              <div class="c-field">
                <label for="f-country" class="c-label">Country <span class="c-req-star" aria-label="required">*</span></label>
                <input type="text" id="f-country" name="country" required autocomplete="country-name" placeholder="e.g. United Kingdom" class="c-input" aria-required="true" aria-describedby="e-country" />
                <span id="e-country" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
              <div class="c-field">
                <label for="f-experience" class="c-label">Years of Experience <span class="c-req-star" aria-label="required">*</span></label>
                <select id="f-experience" name="years_of_experience" required class="c-select" aria-required="true" aria-describedby="e-experience">
                  <option value="">Select</option>
                  <option value="Under 1 year">Under 1 year</option>
                  <option value="1 to 3 years">1 to 3 years</option>
                  <option value="3 to 5 years">3 to 5 years</option>
                  <option value="5 to 10 years">5 to 10 years</option>
                  <option value="Over 10 years">Over 10 years</option>
                </select>
                <span id="e-experience" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
            </div>

            <div class="c-field-row">
              <div class="c-field">
                <label for="f-area" class="c-label">Area of Expertise <span class="c-req-star" aria-label="required">*</span></label>
                <select id="f-area" name="area_of_expertise" required class="c-select" aria-required="true" aria-describedby="e-area">
                  <option value="">Select area</option>
                  <option value="Fashion Design & Pattern Making">Fashion Design &amp; Pattern Making</option>
                  <option value="Quality Assurance & Compliance">Quality Assurance &amp; Compliance</option>
                  <option value="Garment Merchandising">Garment Merchandising</option>
                  <option value="Sustainability & Certifications">Sustainability &amp; Certifications</option>
                  <option value="Industrial Engineering & Production">Industrial Engineering &amp; Production</option>
                  <option value="Marketing, Operations & Corporate">Marketing, Operations &amp; Corporate</option>
                  <option value="Other">Other / Not Listed</option>
                </select>
                <span id="e-area" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
              <div class="c-field">
                <label for="f-work" class="c-label">Work Preference <span class="c-req-star" aria-label="required">*</span></label>
                <select id="f-work" name="work_arrangement" required class="c-select" aria-required="true" aria-describedby="e-work">
                  <option value="">Select preference</option>
                  <option value="Remote — open to any location">Remote — any location</option>
                  <option value="On-site — Dhaka, Bangladesh">On-site — Dhaka</option>
                  <option value="Hybrid arrangement preferred">Hybrid preferred</option>
                  <option value="Either remote or on-site">Either works for me</option>
                </select>
                <span id="e-work" class="c-field-error" role="alert" aria-live="polite"></span>
              </div>
            </div>

            <div class="c-field">
              <label for="f-cv" class="c-label">Your CV <span class="c-req-star" aria-label="required">*</span></label>
              <div class="c-upload" id="upload-zone" role="button" tabindex="0" aria-label="Click or drag to upload your CV file">
                <span class="c-upload__icon" aria-hidden="true">📎</span>
                <span class="c-upload__main" id="upload-label">Drag &amp; drop your CV here, or click to browse</span>
                <span class="c-upload__sub">PDF, DOC, or DOCX — max 10 MB</span>
                <input type="file" id="f-cv" name="cv_file" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="c-upload__input" aria-required="true" aria-describedby="e-cv h-cv" />
              </div>
              <span id="h-cv" class="c-field-hint">Only PDF, DOC, and DOCX accepted</span>
              <span id="e-cv" class="c-field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="c-field-row">
              <div class="c-field">
                <label for="f-linkedin" class="c-label">LinkedIn Profile URL</label>
                <input type="url" id="f-linkedin" name="linkedin_url" placeholder="https://linkedin.com/in/yourname" class="c-input" aria-describedby="h-linkedin" />
                <span id="h-linkedin" class="c-field-hint">Optional — helpful for design and marketing roles</span>
              </div>
              <div class="c-field">
                <label for="f-portfolio" class="c-label">Portfolio / Work Samples</label>
                <input type="url" id="f-portfolio" name="portfolio_url" placeholder="https://yourportfolio.com" class="c-input" aria-describedby="h-portfolio" />
                <span id="h-portfolio" class="c-field-hint">Optional — Behance, Dribbble, personal site, or Drive link</span>
              </div>
            </div>

            <div class="c-field">
              <label for="f-reference" class="c-label">Professional Reference</label>
              <input type="text" id="f-reference" name="reference" placeholder="Name, Company, Phone — e.g. John Smith, ABC Garments, +880 1711 000000" class="c-input" aria-describedby="h-reference" />
              <span id="h-reference" class="c-field-hint">Optional — a previous supervisor or manager we can contact if needed</span>
            </div>

            <div class="c-field">
              <label for="f-employer" class="c-label">Current / Last Employer</label>
              <input type="text" id="f-employer" name="current_employer" placeholder="e.g. ABC Fashion Ltd" class="c-input" aria-describedby="h-employer" />
              <span id="h-employer" class="c-field-hint">Optional — helps us understand your background</span>
            </div>

            <div class="c-field">
              <label for="f-note" class="c-label">Tell us about your background <span class="c-req-star" aria-label="required">*</span></label>
              <textarea id="f-note" name="background_note" rows="7" minlength="400" maxlength="1500" required placeholder="Tell us about your work experience, the kind of role you are looking for, and why you would be a good fit. Please write at least a few solid paragraphs — this is the main thing we read when deciding who to contact, so the more relevant detail you give us, the better we can match you to the right opening." class="c-textarea" aria-required="true" aria-describedby="h-note note-count e-note"></textarea>
              <div class="c-field-footer">
                <span id="h-note" class="c-field-hint">Please write at least a few paragraphs — minimum 400 characters</span>
                <span id="note-count" class="c-char-count" aria-live="polite">0 / 400 minimum</span>
              </div>
              <span id="e-note" class="c-field-error" role="alert" aria-live="polite"></span>
            </div>

            <div class="c-field">
              <label class="c-checkbox-label c-checkbox-label--custom">
                <input type="checkbox" id="f-consent" name="gdpr_consent" value="yes" required class="c-checkbox-input" aria-required="true" aria-describedby="e-consent" />
                <span class="c-checkbox-custom" aria-hidden="true"></span>
                <span class="c-checkbox-text">I agree that SDF Clothing may retain my details, CV, and National ID number for up to six months for recruitment and candidate identification purposes. My NID is used solely to maintain my candidate record and prevent duplicate applications — it is stored securely and never shared with third parties. I can request removal at any time by <a href="/contact" class="c-link">contacting the team</a>. All data is processed in accordance with applicable data protection laws.</span>
              </label>
              <span id="e-consent" class="c-field-error" role="alert" aria-live="polite"></span>
            </div>

            <button type="submit" id="cv-submit" class="c-btn c-btn--primary c-btn--full" aria-describedby="submit-status">
              <span id="submit-label">Submit Your CV</span>
              <span id="submit-spinner" class="c-spinner" aria-hidden="true" hidden></span>
            </button>
            <span id="submit-status" class="c-submit-status" aria-live="polite"></span>

          </form>

          <!-- SUCCESS MESSAGE (shown after submit) -->
          <div id="cv-success" class="c-success" hidden role="status" aria-live="polite">
            <div class="c-success__icon" aria-hidden="true">✅</div>
            <div class="c-success__body">
              <h3 class="c-success__title">Your CV has been received — thank you</h3>
              <p class="c-success__text">We have everything we need from you. Someone on our team will read your CV and, if your background matches a current or upcoming opening, we will be in touch directly by email.</p>
              <p class="c-success__text">There is nothing else for you to do. We do not send automated acknowledgement emails, so this confirmation on screen is your record that the submission went through. We keep CVs on file for six months.</p>
              <div class="c-success__notice">
                <span class="c-success__notice-icon" aria-hidden="true">🛡️</span>
                <p class="c-success__notice-text">As part of our standard verification process, we record basic submission details below — including your approximate location and device information. This is collected from every applicant to help us identify spam and fraudulent submissions, and is handled in line with our <a href="/privacy" class="c-link">privacy policy</a>.</p>
              </div>
              <div class="c-success__meta" id="submission-meta" aria-label="Submission details"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="c-faq" aria-labelledby="faq-h2">
    <div class="c-container">
      <p class="c-eyebrow">Common Questions</p>
      <h2 id="faq-h2" class="c-section-h2">Questions about applying</h2>
      <div class="c-faq__list" role="list">

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a1">
            Does SDF Clothing offer remote fashion designer jobs?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a1" hidden>
            <p>Yes. Design, merchandising, and marketing roles are open to remote candidates worldwide. We review every CV regardless of location and reach out when a suitable opening arises. On-site roles at our Dhaka facility are also available.</p>
          </div>
        </article>

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a2">
            What garment industry jobs does SDF Clothing hire for?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a2" hidden>
            <p>We hire across six areas: fashion design and pattern making, quality assurance and compliance, garment merchandising, sustainability and certifications, industrial engineering and production, and corporate functions including marketing and operations.</p>
          </div>
        </article>

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a3">
            Can I apply from outside Bangladesh?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a3" hidden>
            <p>Yes. We welcome applications from anywhere in the world. Some positions require on-site presence in Dhaka. But design, merchandising, marketing, and certain compliance roles have been filled by candidates in the UK, USA, Europe, and Southeast Asia working remotely.</p>
          </div>
        </article>

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a4">
            What file formats do you accept for CV submissions?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a4" hidden>
            <p>PDF, DOC, and DOCX only. Maximum file size is 10 MB. Do not send image files, ZIP archives, or Google Drive links. If your CV is in another format, convert to PDF before submitting — it is the most reliable format for us to open.</p>
          </div>
        </article>

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a5">
            How long does it take to hear back?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a5" hidden>
            <p>We read every CV. If your background matches a current or upcoming opening, we will contact you within two to four weeks. CVs stay in our active pool for six months. We do not send automated rejection emails — no response means your CV is still on file.</p>
          </div>
        </article>

        <article class="c-faq-item" role="listitem">
          <button class="c-faq-item__q" aria-expanded="false" aria-controls="faq-a6">
            Do I need Bangladesh garment industry experience?
            <span class="c-faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="c-faq-item__a" id="faq-a6" hidden>
            <p>No. What matters is that your experience is relevant to the area you are applying for. Several current team members came from fashion brands and design agencies outside Bangladesh. Industry experience anywhere in the world counts.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="c-cta-bottom" aria-labelledby="cta-h2">
    <div class="c-container">
      <div class="c-cta-bottom__inner">
        <div class="c-cta-bottom__text">
          <h2 id="cta-h2" class="c-cta-bottom__h2">Not looking yourself — but know someone who is?</h2>
          <p class="c-cta-bottom__body">Share this page with anyone working in fashion design, garment manufacturing, or apparel sourcing. We are always looking for the right people.</p>
        </div>
        <div class="c-cta-bottom__actions">
          <a href="#cv-form" class="c-btn c-btn--primary">Submit a CV</a>
          <a href="/contact" class="c-btn c-btn--ghost">Get in touch instead</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  (function () {
    'use strict';

    /* ─── FAQ accordion ─── */
    document.querySelectorAll('.c-faq-item__q').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = this.getAttribute('aria-controls');
        var panel = document.getElementById(id);
        var icon = this.querySelector('.c-faq-item__icon');
        var open = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', open ? 'false' : 'true');
        panel.hidden = open;
        if (icon) icon.textContent = open ? '+' : '−';
      });
    });

    /* ─── Area card → pre-select form ─── */
    document.querySelectorAll('.c-area-card__apply').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var area = this.getAttribute('data-area');
        var sel = document.getElementById('f-area');
        if (sel && area) {
          for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].value === area) { sel.selectedIndex = i; break; }
          }
        }
        var form = document.getElementById('cv-form');
        if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* ─── Upload drag-drop ─── */
    var zone = document.getElementById('upload-zone');
    var fileInput = document.getElementById('f-cv');
    var uploadLabel = document.getElementById('upload-label');

    if (zone && fileInput) {
      zone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      ['dragenter', 'dragover'].forEach(function (ev) {
        zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.add('c-upload--drag'); });
      });
      ['dragleave', 'drop'].forEach(function (ev) {
        zone.addEventListener(ev, function (e) { e.preventDefault(); zone.classList.remove('c-upload--drag'); });
      });
      zone.addEventListener('drop', function (e) {
        if (e.dataTransfer && e.dataTransfer.files.length) {
          fileInput.files = e.dataTransfer.files;
          setFileName(e.dataTransfer.files[0]);
        }
      });
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) setFileName(this.files[0]);
      });
      function setFileName(f) {
        if (uploadLabel) uploadLabel.textContent = '📎 ' + f.name;
        zone.classList.add('c-upload--has-file');
        clearErr('f-cv');
      }
    }

    /* ─── Char counter ─── */
    var noteEl = document.getElementById('f-note');
    var noteCount = document.getElementById('note-count');
    if (noteEl && noteCount) {
      noteEl.addEventListener('input', function () {
        var len = this.value.length;
        if (len < 400) {
          noteCount.textContent = len + ' / 400 minimum';
          noteCount.classList.add('c-char-count--under');
        } else {
          noteCount.textContent = len + ' / 1500';
          noteCount.classList.remove('c-char-count--under');
        }
        clearErr('f-note');
      });
    }

    /* ─── Validation helpers ─── */
    function showErr(id, msg) {
      var el = document.getElementById(id);
      var err = document.getElementById('e-' + id.replace('f-', ''));
      if (el) el.classList.add('c-input--err');
      if (err) err.textContent = msg;
    }
    function clearErr(id) {
      var el = document.getElementById(id);
      var errId = 'e-' + id.replace('f-', '');
      var err = document.getElementById(errId);
      if (el) el.classList.remove('c-input--err');
      if (err) err.textContent = '';
    }

    function validate() {
      var ok = true;
      var name = document.getElementById('f-name');
      clearErr('f-name');
      if (!name || name.value.trim().length < 2) { showErr('f-name', 'Please enter your full name.'); ok = false; }

      var email = document.getElementById('f-email');
      clearErr('f-email');
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) { showErr('f-email', 'Please enter a valid email address.'); ok = false; }

      var country = document.getElementById('f-country');
      clearErr('f-country');
      if (!country || country.value.trim().length < 2) { showErr('f-country', 'Please enter your country.'); ok = false; }

      var exp = document.getElementById('f-experience');
      clearErr('f-experience');
      if (!exp || !exp.value) { showErr('f-experience', 'Please select your years of experience.'); ok = false; }

      var area = document.getElementById('f-area');
      clearErr('f-area');
      if (!area || !area.value) { showErr('f-area', 'Please select your area of expertise.'); ok = false; }

      var work = document.getElementById('f-work');
      clearErr('f-work');
      if (!work || !work.value) { showErr('f-work', 'Please select your work preference.'); ok = false; }

      var note = document.getElementById('f-note');
      clearErr('f-note');
      if (!note || note.value.trim().length < 400) {
        showErr('f-note', 'A few more details would help us a great deal. Please share a little more about your background and experience — at least 400 characters — so our team can review your application properly.');
        ok = false;
      }

      var file = document.getElementById('f-cv');
      clearErr('f-cv');
      if (!file || !file.files || !file.files[0]) {
        showErr('f-cv', 'Please attach your CV file.');
        ok = false;
      } else {
        var f = file.files[0];
        var allowed = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
        var extOk = /\.(pdf|doc|docx)$/i.test(f.name);
        if (!allowed.includes(f.type) && !extOk) { showErr('f-cv', 'Only PDF, DOC, and DOCX files are accepted.'); ok = false; }
        else if (f.size > 10 * 1024 * 1024) { showErr('f-cv', 'File size must be under 10 MB.'); ok = false; }
      }

      var consent = document.getElementById('f-consent');
      clearErr('f-consent');
      if (!consent || !consent.checked) { showErr('f-consent', 'Please confirm your consent to continue.'); ok = false; }

      return ok;
    }

    /* ─── Live clear errors ─── */
    ['f-name','f-email','f-country','f-note'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', function () { clearErr(id); });
    });
    ['f-experience','f-area','f-work'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('change', function () { clearErr(id); });
    });

    /* ─── AI / Paste Detection ─── */
    var _pasteDetected = false;
    var _keystrokeCount = 0;
    var _backspaceCount = 0;
    var _fieldFocusTime = 0;
    var _tabSwitches = 0;

    var noteField = document.getElementById('f-note');
    if (noteField) {
      noteField.addEventListener('focus', function () {
        if (!_fieldFocusTime) _fieldFocusTime = Date.now();
      });
      noteField.addEventListener('keydown', function (e) {
        _keystrokeCount++;
        if (e.key === 'Backspace' || e.key === 'Delete') _backspaceCount++;
      });
      noteField.addEventListener('paste', function (e) {
        _pasteDetected = true;
      });
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) _tabSwitches++;
    });

    function calcAIScore(text) {
      var score = 0;

      /* Paste / speed signals */
      if (_pasteDetected) score += 35;
      if (_fieldFocusTime) {
        var mins = (Date.now() - _fieldFocusTime) / 60000;
        var words = text.trim().split(/\s+/).filter(function(w){return w.length>0;}).length;
        var wpm = mins > 0 ? Math.round(words / mins) : 0;
        if (wpm > 130) score += 20;
      }
      if (_backspaceCount < 3 && text.length > 400) score += 15;
      if (_fieldFocusTime && Math.round((Date.now() - _fieldFocusTime) / 1000) < 20 && text.length > 300) score += 15;
      if (_tabSwitches >= 3) score += 10;

      /* Linguistic signals */
      var aiCliches = ['furthermore', 'moreover', 'in conclusion', 'to summarize', 'it is worth noting',
        'i am passionate about', 'i am a highly motivated', 'i thrive in', 'leveraging my expertise',
        'in addition to', 'as a result', 'it is important to note', 'i am excited to', 'dynamic environment'];
      var lower = text.toLowerCase();
      var clicherCount = 0;
      aiCliches.forEach(function(c){ if (lower.indexOf(c) !== -1) clicherCount++; });
      if (clicherCount >= 2) score += 10;
      if (clicherCount >= 4) score += 10;

      /* Sentence uniformity check */
      var sentences = text.split(/[.!?]+/).filter(function(s){return s.trim().length > 10;});
      if (sentences.length >= 4) {
        var lens = sentences.map(function(s){return s.trim().split(/\s+/).length;});
        var avg = lens.reduce(function(a,b){return a+b;},0) / lens.length;
        var variance = lens.reduce(function(a,b){return a+Math.pow(b-avg,2);},0) / lens.length;
        if (variance < 5 && sentences.length >= 5) score += 10;
      }

      return Math.min(score, 100);
    }

    /* ─── Form submit → /api/careers ─── */
    var form = document.getElementById('cv-upload-form');
    var submitBtn = document.getElementById('cv-submit');
    var submitLabelEl = document.getElementById('submit-label');
    var spinner = document.getElementById('submit-spinner');
    var statusEl = document.getElementById('submit-status');

    if (form && submitBtn) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        /* honeypot */
        var honey = form.querySelector('input[name="_honey"]');
        if (honey && honey.value) return;

        if (!validate()) {
          var firstErr = form.querySelector('.c-input--err');
          if (firstErr) firstErr.focus();
          return;
        }

        /* loading state */
        submitBtn.disabled = true;
        if (submitLabelEl) submitLabelEl.textContent = 'Submitting…';
        if (spinner) spinner.hidden = false;
        if (statusEl) statusEl.textContent = 'Sending your CV — please wait…';

        /* Collect form data */
        var nameVal  = (document.getElementById('f-name')      || {}).value || '';
        var emailVal = (document.getElementById('f-email')     || {}).value || '';
        var phoneVal = (document.getElementById('f-phone')     || {}).value || '';
        var nidVal   = (document.getElementById('f-nid')       || {}).value || '';
        var countryVal  = (document.getElementById('f-country')  || {}).value || '';
        var expVal      = (document.getElementById('f-experience')|| {}).value || '';
        var areaVal     = (document.getElementById('f-area')      || {}).value || '';
        var workVal     = (document.getElementById('f-work')      || {}).value || '';
        var linkedinVal = (document.getElementById('f-linkedin')  || {}).value || '';
        var portfolioVal= (document.getElementById('f-portfolio') || {}).value || '';
        var referenceVal= (document.getElementById('f-reference') || {}).value || '';
        var employerVal = (document.getElementById('f-employer')  || {}).value || '';
        var salaryVal   = (document.getElementById('f-salary')    || {}).value || '';
        var noteVal     = (document.getElementById('f-note')      || {}).value || '';

        /* AI Score */
        var aiScore = calcAIScore(noteVal);
        var timeInField = _fieldFocusTime ? Math.round((Date.now() - _fieldFocusTime) / 1000) : null;
        var words = noteVal.trim().split(/\s+/).filter(function(w){return w.length>0;}).length;
        var wpm = (_fieldFocusTime && (Date.now()-_fieldFocusTime)>0)
          ? Math.round(words / ((Date.now()-_fieldFocusTime)/60000)) : 0;

        /* CV file → base64 */
        var cvFile = document.getElementById('f-cv');
        if (!cvFile || !cvFile.files || !cvFile.files[0]) {
          submitBtn.disabled = false;
          if (submitLabelEl) submitLabelEl.textContent = 'Submit Your CV';
          if (spinner) spinner.hidden = true;
          return;
        }

        var reader = new FileReader();
        reader.onload = function (ev) {
          var base64 = ev.target.result.split(',')[1];
          var filename = cvFile.files[0].name;

          var payload = {
            name: nameVal, email: emailVal, phone: phoneVal, nid: nidVal,
            country: countryVal, experience: expVal, area: areaVal,
            workPreference: workVal, linkedin: linkedinVal, portfolio: portfolioVal,
            reference: referenceVal, currentEmployer: employerVal,
            expectedSalary: salaryVal, note: noteVal,
            cvBase64: base64, cvFilename: filename,
            aiScore: aiScore, pasteDetected: _pasteDetected,
            avgWpm: wpm, backspaceCount: _backspaceCount,
            tabSwitches: _tabSwitches,
            timeInField: timeInField
          };

          fetch('https://sdfltd.com/api/careers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(function(r){ return r.json(); })
          .then(function(d){
            submitBtn.disabled = false;
            if (submitLabelEl) submitLabelEl.textContent = 'Submit Your CV';
            if (spinner) spinner.hidden = true;
            if (d.ok) {
              /* Store for success screen */
              try {
                sessionStorage.setItem('sdf_cv_name',  nameVal);
                sessionStorage.setItem('sdf_cv_email', emailVal);
                sessionStorage.setItem('sdf_cv_area',  areaVal);
                sessionStorage.setItem('sdf_cv_ref',   d.referenceId || '');
              } catch(err){}
              if (d.duplicate) {
                showDuplicate(d.previousRef, d.previousDate, d.previousArea);
              } else {
                showSuccess();
              }
            } else {
              if (statusEl) statusEl.textContent = 'Something went wrong. Please try again or email jobs@sdfltd.com directly.';
            }
          })
          .catch(function(){
            submitBtn.disabled = false;
            if (submitLabelEl) submitLabelEl.textContent = 'Submit Your CV';
            if (spinner) spinner.hidden = true;
            if (statusEl) statusEl.textContent = 'Network error. Please try again or email jobs@sdfltd.com directly.';
          });
        };
        reader.readAsDataURL(cvFile.files[0]);
      });
    }

    function showDuplicate(prevRef, prevDate, prevArea) {
      var formEl = document.getElementById('cv-upload-form');
      var successEl = document.getElementById('cv-success');
      var titleEl = successEl ? successEl.querySelector('.c-success__title') : null;
      var textEls = successEl ? successEl.querySelectorAll('.c-success__text') : [];
      if (formEl) formEl.hidden = true;
      if (successEl) successEl.hidden = false;
      if (successEl) successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (titleEl) titleEl.textContent = 'Your profile is already on file';
      if (textEls[0]) textEls[0].textContent = 'Our records show you have previously submitted an application to SDF Clothing. Your original profile remains on file and our team will be in touch should a suitable opportunity arise.';
      if (textEls[1]) textEls[1].textContent = 'If your circumstances have changed significantly — such as a new qualification or area of expertise — please contact us directly at jobs@sdfltd.com and we will update your file accordingly.';
      /* Show previous ref in meta */
      var metaEl = document.getElementById('submission-meta');
      if (metaEl && prevRef) {
        metaEl.innerHTML =
          '<div class="c-success__meta-row c-success__meta-row--highlight"><span>🆔 Previous Reference</span><span>' + prevRef + '</span></div>' +
          (prevDate ? '<div class="c-success__meta-row"><span>📅 Originally Submitted</span><span>' + prevDate + '</span></div>' : '') +
          (prevArea ? '<div class="c-success__meta-row"><span>🗂️ Area Applied For</span><span>' + prevArea + '</span></div>' : '');
      }
    }

    function showSuccess() {
      var formEl = document.getElementById('cv-upload-form');
      var successEl = document.getElementById('cv-success');
      var metaEl = document.getElementById('submission-meta');
      if (formEl) formEl.hidden = true;
      if (successEl) successEl.hidden = false;
      if (successEl) successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

      /* Device / browser info */
      var now = new Date();
      var timeStr = now.toLocaleString('en-GB', { dateStyle: 'long', timeStyle: 'short' });
      var ua = navigator.userAgent;
      var device = /Mobile|Android|iPhone|iPad/i.test(ua) ? '📱 Mobile' : '🖥️ Desktop';
      var os = 'Unknown OS';
      if (/Windows NT 10/i.test(ua)) os = 'Windows 10 / 11';
      else if (/Windows/i.test(ua)) os = 'Windows';
      else if (/Mac OS X/i.test(ua)) os = 'macOS';
      else if (/Android/i.test(ua)) os = 'Android';
      else if (/iPhone|iPad/i.test(ua)) os = 'iOS';
      else if (/Linux/i.test(ua)) os = 'Linux';
      var browser = 'Unknown browser';
      if (/Edg\//i.test(ua)) browser = 'Microsoft Edge';
      else if (/OPR\//i.test(ua)) browser = 'Opera';
      else if (/Chrome\//i.test(ua)) browser = 'Google Chrome';
      else if (/Firefox\//i.test(ua)) browser = 'Mozilla Firefox';
      else if (/Safari\//i.test(ua)) browser = 'Apple Safari';
      var lang = navigator.language || 'Unknown';
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown';
      var screen_res = window.screen.width + ' × ' + window.screen.height;

      /* Connection type, if available */
      var connType = 'Unknown';
      if (navigator.connection && navigator.connection.effectiveType) {
        connType = navigator.connection.effectiveType.toUpperCase();
      }

      /* Reference ID for this submission */
      var refId = 'SDF-' + now.getFullYear() +
        String(now.getMonth() + 1).padStart(2, '0') +
        String(now.getDate()).padStart(2, '0') + '-' +
        Math.random().toString(36).substring(2, 7).toUpperCase();

      /* Applicant summary — read from sessionStorage since the form is
         empty after the redirect back from Basin */
      var nameVal = '—';
      var emailVal = '—';
      var areaVal = '—';
      try {
        nameVal = sessionStorage.getItem('sdf_cv_name') || '—';
        emailVal = sessionStorage.getItem('sdf_cv_email') || '—';
        areaVal = sessionStorage.getItem('sdf_cv_area') || '—';
        sessionStorage.removeItem('sdf_cv_name');
        sessionStorage.removeItem('sdf_cv_email');
        sessionStorage.removeItem('sdf_cv_area');
      } catch (err) { /* sessionStorage unavailable */ }

      /* Build meta rows — IP + location fetched from free API */
      var baseRows =
        '<div class="c-success__meta-row c-success__meta-row--highlight"><span>🆔 Reference ID</span><span>' + refId + '</span></div>' +
        '<div class="c-success__meta-row"><span>👤 Applicant</span><span>' + nameVal + '</span></div>' +
        '<div class="c-success__meta-row"><span>✉️ Email on file</span><span>' + emailVal + '</span></div>' +
        '<div class="c-success__meta-row"><span>🗂️ Area applied for</span><span>' + areaVal + '</span></div>' +
        '<div class="c-success__meta-row"><span>📅 Submitted</span><span>' + timeStr + '</span></div>' +
        '<div class="c-success__meta-row"><span>' + device + ' · ' + os + '</span><span>' + browser + '</span></div>' +
        '<div class="c-success__meta-row"><span>🖥️ Screen resolution</span><span>' + screen_res + '</span></div>' +
        '<div class="c-success__meta-row"><span>📶 Connection</span><span>' + connType + '</span></div>' +
        '<div class="c-success__meta-row"><span>🌐 Time zone</span><span>' + tz + '</span></div>' +
        '<div class="c-success__meta-row"><span>🗣️ Browser language</span><span>' + lang + '</span></div>';

      if (metaEl) {
        metaEl.innerHTML = baseRows + '<div class="c-success__meta-row" id="ip-row"><span>🌍 Location</span><span class="c-meta-loading">Detecting…</span></div>';
      }

      /* Fetch IP + geolocation — try ipwho.is first, fall back to ipapi.co */
      function fetchLocation() {
        return fetch('https://ipwho.is/')
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || d.success === false) throw new Error('ipwho.is failed');
            return {
              ip: d.ip || '',
              city: d.city || '',
              country: d.country || ''
            };
          })
          .catch(function () {
            return fetch('https://ipapi.co/json/')
              .then(function (r) { return r.json(); })
              .then(function (d) {
                return {
                  ip: d.ip || '',
                  city: d.city || '',
                  country: d.country_name || ''
                };
              });
          });
      }

      fetchLocation()
        .then(function (d) {
          var ipRow = document.getElementById('ip-row');
          if (ipRow && d) {
            var loc = [d.city, d.country].filter(Boolean).join(', ');
            ipRow.innerHTML =
              '<span>🌍 Location</span><span>' + (loc || 'Unknown') + '</span>';
            /* Add IP row */
            if (d.ip && metaEl) {
              var ipDiv = document.createElement('div');
              ipDiv.className = 'c-success__meta-row';
              ipDiv.innerHTML = '<span>🔗 IP Address</span><span>' + d.ip + '</span>';
              metaEl.appendChild(ipDiv);
            }
          }
        })
        .catch(function () {
          var ipRow = document.getElementById('ip-row');
          if (ipRow) ipRow.innerHTML = '<span>🌍 Location</span><span>Unable to detect — network restricted</span>';
        });

      /* Clean URL */
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, '', '/careers');
      }
    }

  })();
  </script>

  <style>
    /* ── Tokens ── */
    :root {
      --bg:           #000000;
      --bg-card:      #0d0d0d;
      --bg-card-2:    #111111;
      --bg-form:      #0a0a0a;
      --acc:          #ee0000;
      --acc-dim:      rgba(238,0,0,0.1);
      --acc-border:   rgba(238,0,0,0.35);
      --txt:          #ffffff;
      --txt-2:        rgba(255,255,255,0.6);
      --txt-3:        rgba(255,255,255,0.35);
      --border:       rgba(255,255,255,0.08);
      --border-2:     rgba(255,255,255,0.16);
      --mono:         'Inter', ui-monospace, monospace;
      --sec:          clamp(4rem, 8vw, 7rem);
      --radius:       4px;
    }

    /* ── Layout ── */
    .c-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 clamp(1rem, 4vw, 2.5rem);
    }

    /* ── Breadcrumb ── */
    .c-breadcrumb {
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: .75rem 0;
    }
    .c-breadcrumb__list {
      list-style: none;
      margin: 0; padding: 0;
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
    }
    .c-breadcrumb__item {
      font-size: .68rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--txt-2);
      font-family: var(--mono);
    }
    .c-breadcrumb__item + .c-breadcrumb__item::before { content: '/'; margin-right: .5rem; color: var(--txt-3); }
    .c-breadcrumb__item[aria-current="page"] { color: var(--acc); }
    .c-breadcrumb__link { color: var(--txt-2); text-decoration: none; transition: color .15s; }
    .c-breadcrumb__link:hover,
    .c-breadcrumb__link:focus-visible { color: var(--acc); }
    .c-breadcrumb__link:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }

    /* ── Shared type ── */
    .c-eyebrow {
      font-size: .62rem;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: var(--acc);
      margin: 0 0 .8rem;
      font-family: var(--mono);
    }
    .c-section-h2 {
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 300;
      color: var(--txt);
      margin: 0 0 .9rem;
      line-height: 1.2;
      letter-spacing: -.01em;
    }
    .c-section-lead {
      font-size: clamp(.88rem, 1.4vw, 1rem);
      color: var(--txt-2);
      line-height: 1.8;
      max-width: 680px;
      margin: 0 0 3rem;
    }

    /* ── Buttons ── */
    .c-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      text-decoration: none;
      padding: .8rem 1.8rem;
      font-size: .72rem;
      letter-spacing: .15em;
      text-transform: uppercase;
      font-family: var(--mono);
      min-height: 44px;
      cursor: pointer;
      border: none;
      transition: opacity .15s, border-color .15s, color .15s;
    }
    .c-btn--primary { background: var(--acc); color: var(--txt); }
    .c-btn--primary:hover, .c-btn--primary:focus-visible { opacity: .85; }
    .c-btn--ghost { background: transparent; color: var(--txt-2); border: 1px solid var(--border-2); }
    .c-btn--ghost:hover, .c-btn--ghost:focus-visible { color: var(--txt); border-color: var(--acc); }
    .c-btn--full { width: 100%; border-radius: 0; }
    .c-btn:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
    .c-btn:disabled { opacity: .5; cursor: not-allowed; }

    /* ── HERO ── */
    .c-hero {
      background: var(--bg);
      padding: var(--sec) 0;
      border-bottom: 1px solid var(--acc);
    }
    .c-hero__inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 3rem;
      align-items: start;
    }
    .c-hero__h1 {
      font-size: clamp(2rem, 5vw, 3.6rem);
      font-weight: 200;
      color: var(--txt);
      margin: 0 0 1.4rem;
      line-height: 1.1;
      letter-spacing: -.025em;
    }
    .c-hero__h1-line2 { color: var(--acc); }
    .c-hero__lead {
      font-size: clamp(.9rem, 1.5vw, 1.05rem);
      color: var(--txt-2);
      line-height: 1.8;
      max-width: 620px;
      margin: 0 0 2rem;
    }
    .c-hero__actions { display: flex; gap: .75rem; flex-wrap: wrap; }
    .c-hero__stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      min-width: 220px;
      flex-shrink: 0;
    }
    .c-stat { background: var(--bg); padding: 1.25rem 1rem; }
    .c-stat__num {
      display: block;
      font-size: clamp(1.4rem, 2.5vw, 1.9rem);
      font-weight: 200;
      color: var(--txt);
      font-family: var(--mono);
      line-height: 1;
      margin-bottom: .3rem;
    }
    .c-stat__label {
      display: block;
      font-size: .62rem;
      letter-spacing: .06em;
      color: var(--txt-2);
      text-transform: uppercase;
      line-height: 1.4;
    }

    /* ── TALENT AREA CARDS — Google Careers style ── */
    .c-areas {
      background: var(--bg-card);
      padding: var(--sec) 0;
      border-bottom: 1px solid var(--border);
    }
    .c-areas__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .c-area-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
