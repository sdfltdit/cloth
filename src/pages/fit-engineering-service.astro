---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Fit Engineering Service Bangladesh | Garment Fit Specialists";
const pageDescription = "Professional fit engineering service from Bangladesh. Pattern adjustments, fit testing, fit blocks and brand-specific fit creation. Fit consistency across all sizes.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Fit Engineering Service",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/fit-engineering-service/"
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="fit engineering service, garment fit specialist, fit consultant Bangladesh, brand fit development, fit block creation, fit testing service" />

