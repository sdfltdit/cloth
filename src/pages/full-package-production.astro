---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Full Package Production | Complete Manufacturing Service";
const pageDescription = "Full package production from design to delivery — fabric sourcing, pattern making, sampling, manufacturing, and quality control. 300-piece MOQ.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Full Package Production",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/full-package-production/"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://sdfltd.com/full-package-production/",
    "name": "Full Package Production",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Full Package Production"
        }
      ]
    }
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
	<!-- Robots Meta -->
	<meta name="robots" content="index, follow" />
	
	<!-- Open Graph Tags -->





	
	<!-- Twitter Card -->





	<!-- Breadcrumb Navigation -->
	<nav aria-label="Breadcrumb" class="py-4 px-4 bg-black/50">
		<div class="container mx-auto max-w-7xl">
			<ol class="flex items-center space-x-2 text-sm">
				<li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
				<li class="text-white/40">/</li>
				<li><span class="text-white">Full Package Production</span></li>
			</ol>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="py-16 px-4 bg-gradient-to-b from-black to-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h1 class="text-3xl md:text-5xl font-bold text-white mb-6">
				Full Package Production: From Idea to Finished Product
			</h1>
			<p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8">
				We handle everything. You focus on your brand. As a full-service clothing manufacturer, we take care of fabric sourcing, design, sampling, manufacturing, and quality control—all in one place.
			</p>
			<a href="/contact/" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				Get Your Free Quote
			</a>
		</div>
	</section>

	<!-- What is Full Package Production -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				What is Full Package Production?
			</h2>
			<p class="text-white/80 leading-relaxed mb-6">
				Full package production means we take care of every step of making your clothes. You give us your design idea, and we handle everything else—from finding the right fabric to delivering finished garments to your door.
			</p>
			<p class="text-white/80 leading-relaxed mb-6">
				This service is perfect for fashion brands, startups, and businesses who want to save time and avoid the headache of managing multiple suppliers. Instead of talking to fabric mills, pattern makers, and factories separately, you work with just one team—us.
			</p>
			<p class="text-white/80 leading-relaxed">
				With our full package production, you get consistent quality, faster delivery, and lower costs because we manage the entire process efficiently.
			</p>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				How Our Full Package Production Works
			</h2>
			<p class="text-white/80 leading-relaxed mb-12 text-center">
				We make the process simple and clear. Here's what happens step by step:
			</p>

			<div class="space-y-8">
				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 1: Share Your Design Idea</h3>
					<p class="text-white/70 leading-relaxed">
						Send us your sketches, photos, or even just describe what you want. If you don't have a design yet, our team can help you create one. We'll discuss your requirements, fabric preferences, colors, and quantity.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 2: Fabric Sourcing & Material Selection</h3>
					<p class="text-white/70 leading-relaxed">
						We find and source the best fabrics for your clothes. We work with trusted suppliers to get high-quality materials at the best prices. You can choose from organic cotton, recycled polyester, and many other sustainable options.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 3: Pattern Making & Sampling</h3>
					<p class="text-white/70 leading-relaxed">
						Our experts create patterns based on your design. Then we make sample garments for you to review. You can see and feel the actual product before we start bulk production. We'll make adjustments until you're happy with the sample.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 4: Bulk Manufacturing</h3>
					<p class="text-white/70 leading-relaxed">
						Once you approve the sample, we start making your clothes in bulk. Our factory has modern machines and skilled workers. We can handle orders from 300 pieces up to 50,000 pieces per style.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 5: Quality Control</h3>
					<p class="text-white/70 leading-relaxed">
						We check every piece of clothing carefully. Our quality team follows strict standards to make sure each garment meets your requirements. We fix any issues before shipping.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 6: Packaging & Delivery</h3>
					<p class="text-white/70 leading-relaxed">
						We pack your clothes according to your specifications. We can add your branded labels, hang tags, and packaging. Then we ship the finished products to your warehouse or directly to your customers.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Why Choose Our Full Package Production?
			</h2>

			<div class="grid md:grid-cols-2 gap-6 mt-8">
				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Save Time</h3>
					<p class="text-white/70 leading-relaxed">
						No need to manage multiple suppliers. We handle everything, so you can focus on growing your brand.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Lower Costs</h3>
					<p class="text-white/70 leading-relaxed">
						Buying materials and managing production in bulk helps us offer you better prices.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Consistent Quality</h3>
					<p class="text-white/70 leading-relaxed">
						One team manages everything, so your products always have the same high quality.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Fast Delivery</h3>
					<p class="text-white/70 leading-relaxed">
						Our streamlined process ensures your orders are completed on time. Standard lead time is 40 days.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Low Minimum Order</h3>
					<p class="text-white/70 leading-relaxed">
						Start with just 300 pieces per style. Perfect for startups and test orders.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Expert Support</h3>
					<p class="text-white/70 leading-relaxed">
						Our team has 27+ years of experience. We guide you through every step.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Who Is This For -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Who Is Full Package Production For?
			</h2>
			
			<div class="space-y-6 mt-8">
				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Fashion Startups</h3>
						<p class="text-white/70 leading-relaxed">
							New brands who need help turning ideas into products without managing complex supply chains.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Growing Brands</h3>
						<p class="text-white/70 leading-relaxed">
							Established brands looking to scale production while maintaining quality control.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">E-commerce Sellers</h3>
						<p class="text-white/70 leading-relaxed">
							Online retailers who need reliable production for their clothing lines.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Boutique Labels</h3>
						<p class="text-white/70 leading-relaxed">
							Small to medium brands that want premium quality with flexible order quantities.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Pricing & Minimum Order
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				Our full package production starts at <strong class="text-white">300 pieces per style</strong>. This low minimum makes it easy for startups to get started. Pricing depends on your design, fabric choice, and order quantity.
			</p>
			<p class="text-white/80 leading-relaxed mb-8">
				We provide transparent quotes with no hidden fees. Our pricing covers fabric, production, labels, packaging, and quality control.
			</p>
			<a href="/contact/" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				Request a Quote
			</a>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Ready to Start Your Production?
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				Let us handle the manufacturing while you focus on building your brand. Get in touch today for a free quote.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact/" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					Get Free Quote
				</a>
				<a href="/about/" class="bg-transparent border border-white text-white px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				 Learn More About Us
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
