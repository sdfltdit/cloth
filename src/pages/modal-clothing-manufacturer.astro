---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Modal Clothing Manufacturer | Premium Softness Production";
const pageDescription = "Manufacture modal clothing with SDF's premium softness production. We specialize in beech wood fabric manufacturing for global fashion brands.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Modal clothing manufacturer from Bangladesh providing custom modal apparel with beech wood pulp source, premium softness, t-shirts, lounge wear, and underwear to premium soft apparel brands worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for modal clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs."
          }
        },
        {
          "@type": "Question",
          "name": "What makes modal fabric premium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modal is sourced from beech wood pulp and is exceptionally soft, more absorbent than cotton, and resistant to pilling. It drapes beautifully and maintains color vibrancy. Premium softness with sustainable credentials."
          }
        },
        {
          "@type": "Question",
          "name": "What modal products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture modal t-shirts, modal underwear, modal loungewear, modal sleepwear, and modal dresses. All products leverage modal's exceptional softness and moisture management for premium comfort apparel."
          }
        },
        {
          "@type": "Question",
          "name": "How does modal compare to cotton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modal is softer than cotton, more absorbent, and resists pilling better. It has a beautiful drape and maintains color vibrancy. Modal typically costs 20-40% more than cotton but offers premium softness and better performance."
          }
        },
        {
          "@type": "Question",
          "name": "What construction considerations apply to modal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modal is soft but can show seam slippage. We use appropriate seam finishes, reinforce stress points, and select suitable interfacings. Pre-washing is standard to minimize shrinkage and ensure consistent sizing."
          }
        },
        {
          "@type": "Question",
          "name": "How long does modal clothing production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 35-45 days from fabric receipt for basic modal clothing. 40-55 days for custom fabric development or specialized modal options. 10-14 days for sampling before bulk."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Modal Clothing Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="modal clothing manufacturer, modal apparel manufacturer, modal t-shirt manufacturer, modal underwear manufacturer, modal loungewear manufacturer, premium soft fabric" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Modal Clothing Manufacturer
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Modal Clothing Manufacturer | Since 1998 | Premium Softness</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Custom Modal Clothing Manufacturer for Premium Soft Apparel
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Modal is the fabric of comfort - exceptionally soft, more absorbent than cotton, and resistant to pilling. Sourced from beech wood pulp, modal drapes beautifully and maintains color vibrancy. Premium modal clothing requires specialized construction to maximize the fabric's softness and performance. SDF Clothing manufactures modal clothing in Bangladesh with certified modal fabrics. From 300 pieces per style.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20modal-clothing-manufacturer`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">300</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Pieces Minimum</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">50%</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">More Absorbent</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">35-45</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Days Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">Pilling</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Resistant</div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Our Capabilities</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Modal Manufacturing Capabilities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Our modal manufacturing covers the full production cycle from fabric sourcing to finished garment. We source premium modal fabrics from certified mills, cut, sew with specialized construction for modal's softness and drape, apply finishing, and package for shipment.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Production capacity: 30,000-40,000 modal pieces per month across dedicated production lines. We handle 100% modal for premium soft positioning, modal blends for accessibility, and specialized modal constructions for comfort apparel.
    </p>
  </div>
</section>

<!-- Fabric Options Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Materials</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Modal Fabric Properties</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Beech Wood Pulp Source</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal is sourced from beech wood pulp, a renewable resource. The production process is more environmentally friendly than conventional rayon, with lower chemical usage and better energy efficiency. Premium sustainable softness.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Premium Softness</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal is exceptionally soft, softer than cotton and many other fabrics. The fiber's smooth surface creates a luxurious handfeel that enhances comfort against the skin. Ideal for underwear, loungewear, and sleepwear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Moisture Management</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal is 50% more absorbent than cotton, making it ideal for activewear, underwear, and sleepwear. The fiber wicks moisture away from skin while remaining soft and comfortable during wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Pilling Resistance</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal resists pilling better than many other soft fabrics, maintaining a smooth appearance through repeated washing and wear. This durability ensures modal garments look newer longer.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Color Vibrancy</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Modal maintains color vibrancy through repeated washing better than cotton. The fiber holds dye well, ensuring modal garments retain their rich colors over time. Premium appearance retention.
    </p>
  </div>
</section>

<!-- Products Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Product Range</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Modal Products We Manufacture</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Modal T-Shirts</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal t-shirts for men and women. Basic tees, fashion tees, and polo shirts. Modal-cotton blends for structure. Pure modal for softness. Premium comfort for everyday wear.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Modal Underwear</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal underwear for men and women. Briefs, boxers, panties, and bras. Pure modal for exceptional softness against skin. Modal-spandex blends for stretch and fit. Premium intimate apparel.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Modal Loungewear</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal loungewear for men and women. Pajamas, robes, and relaxation wear. Modal-cotton blends for structure. Pure modal for premium softness. Sustainable comfort for home.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Modal Sleepwear</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Modal sleepwear for men and women. Nightgowns, pajama sets, and sleep shirts. Pure modal for exceptional softness and moisture management. Sustainable sleep essentials.
    </p>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Modal Dresses</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Modal dresses for women. Casual dresses, summer dresses, and flowing garments. Modal-spandex blends for comfortable stretch. Pure modal for beautiful drape. Sustainable fashion.
    </p>
  </div>
</section>

<!-- Construction Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Construction</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Modal Construction Considerations</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Modal is soft but can show seam slippage if not constructed properly. We use appropriate seam finishes, reinforce stress points, and select suitable interfacings to maximize modal's softness while ensuring durability.
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Reinforced seams (to prevent seam slippage)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Appropriate seam finishes (French seams, overlock)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Stress point reinforcement (armholes, waistbands)
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Pre-washing to minimize shrinkage
      </li>
    </ul>
  </div>
</section>

<!-- MOQ and Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">MOQ and Pricing</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      <strong>MOQ:</strong> 300 pieces per style minimum. Applies per design, colorway, and size range.
    </p>
    
    <div style="margin-top:2rem;">
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
        Modal typically costs 20-40% more than cotton due to premium fiber properties and production. The premium is justified by modal's exceptional softness, moisture management, and pilling resistance. Modal-cotton blends offer a mid-range option.
      </p>
      <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
        FOB Bangladesh pricing for 500-piece orders:
      </p>
      <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Modal t-shirt (100% modal): $12-22 per piece
        </li>
        <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Modal t-shirt (modal-cotton blend): $10-18 per piece
        </li>
        <li style="padding-left:1.5rem;position:relative;">
          <span style="color:#e00;position:absolute;left:0;">✓</span>
          Modal underwear: $8-15 per piece
        </li>
      </ul>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Pricing includes fabric, cut, sew, basic branding, and standard packaging. Custom printing, embroidery, and premium packaging are additional.
    </p>
  </div>
</section>

<!-- Timeline Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Production Timeline</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Modal Clothing Production Timeline</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Standard modal clothing production timeline from order confirmation to shipment:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:1.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Modal fabric sourcing: 10-15 days (certified modal fabrics)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Sampling: 10-14 days (with pre-washing)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Bulk production: 35-45 days
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Quality inspection: 2-3 days
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Packing and shipping: 3-5 days
      </li>
    </ul>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:2rem;">
      Total timeline: 60-85 days from order to delivery. Modal fabric sourcing and certification verification add 5-10 days compared to cotton. Rush production available at 20-30% premium.
    </p>
  </div>
</section>

<!-- FAQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Common Questions</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Frequently Asked Questions</h2>
    </div>
    
    <div style="max-width:800px;">
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What is the minimum order for modal clothing?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">300 pieces per style minimum. This applies per design, colorway, and size range. Lower quantities possible at higher per-piece cost for sampling or prototype runs.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What makes modal fabric premium?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Modal is sourced from beech wood pulp and is exceptionally soft, more absorbent than cotton, and resistant to pilling. It drapes beautifully and maintains color vibrancy. Premium softness with sustainable credentials.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What modal products do you manufacture?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">We manufacture modal t-shirts, modal underwear, modal loungewear, modal sleepwear, and modal dresses. All products leverage modal's exceptional softness and moisture management for premium comfort apparel.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How does modal compare to cotton?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Modal is softer than cotton, more absorbent, and resists pilling better. It has a beautiful drape and maintains color vibrancy. Modal typically costs 20-40% more than cotton but offers premium softness and better performance.</p>
      </div>
      <div style="border-bottom:1px solid #e00;padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">What construction considerations apply to modal?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Modal is soft but can show seam slippage. We use appropriate seam finishes, reinforce stress points, and select suitable interfacings. Pre-washing is standard to minimize shrinkage and ensure consistent sizing.</p>
      </div>
      <div style="padding:1.5rem 0;">
        <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.75rem;">How long does modal clothing production take?</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.8;">Standard production timeline: 35-45 days from fabric receipt for basic modal clothing. 40-55 days for custom fabric development or specialized modal options. 10-14 days for sampling before bulk.</p>
      </div>
    </div>
