              <td>20cm</td>
              <td>21cm</td>
              <td>22cm</td>
              <td>23cm</td>
              <td>24cm</td>
              <td>25cm</td>
            </tr>
            <tr>
              <td><strong>Shoulder width</strong></td>
              <td>42cm</td>
              <td>45cm</td>
              <td>48cm</td>
              <td>51cm</td>
              <td>54cm</td>
              <td>57cm</td>
            </tr>
            <tr>
              <td><strong>Neck width</strong></td>
              <td>18cm</td>
              <td>19cm</td>
              <td>20cm</td>
              <td>21cm</td>
              <td>22cm</td>
              <td>23cm</td>
            </tr>
            <tr>
              <td><strong>Sleeve opening</strong></td>
              <td>20cm</td>
              <td>21cm</td>
              <td>22cm</td>
              <td>23cm</td>
              <td>24cm</td>
              <td>25cm</td>
            </tr>
            <tr>
              <td><strong>Cuff width</strong></td>
              <td>17cm</td>
              <td>18cm</td>
