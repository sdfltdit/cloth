  <!-- Trust Indicators -->
  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Tech Pack Creation Included</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">48-Hour Review</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
