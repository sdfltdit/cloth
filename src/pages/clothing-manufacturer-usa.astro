    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
      <a href="https://wa.me/8801819172080?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20clothing-manufacturer-usa" target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
