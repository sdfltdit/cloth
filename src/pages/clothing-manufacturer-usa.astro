---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
export const prerender = true;

const pageTitle = "Clothing Manufacturer for USA Brands | C-TPAT Compliant Bangladesh | SDF Clothing";
const pageDescription = "US-trade-compliant clothing manufacturer for American fashion brands. C-TPAT, WRAP, SA8000 certified. HTS codes, duty guidance. MOQ 300 pieces. FOB Chittagong.";
const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clothing Manufacturer for USA Brands | C-TPAT Compliant Bangladesh | SDF Clothing",
  "provider": {"@id": "https://sdfltd.com/#org"},
  "areaServed": "United States",
  "serviceType": "Clothing Manufacturing",
  "url": "https://sdfltd.com/clothing-manufacturer-usa"
}
</script>

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">›</span>
        Clothing Manufacturer for USA Brands
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">USA Market · C-TPAT Compliant · Since 1998</p>
