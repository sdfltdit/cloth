---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Sample Request | Free Clothing Manufacturing Samples";
const pageDescription = "Request free clothing manufacturing samples from SDF Clothing. Get quality samples for your apparel production in Bangladesh.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Sample Request",
		"description": "Request free clothing manufacturing samples from SDF Clothing",
		"url": "https://sdfclothing.com/tools/sample-request",
		"provider": {
			"@type": "Organization",
			"name": "SDF Clothing",
			"url": "https://sdfclothing.com"
		}
	}
	</script>

	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
					Free Sample Request
				</h1>
				<p class="text-white/70 text-lg">
					Get quality samples to evaluate our manufacturing capabilities before placing bulk orders
				</p>
			</div>

			<div class="snake-card p-8 max-w-2xl mx-auto">
				<form id="sampleRequest" class="space-y-6">
					<div class="grid md:grid-cols-2 gap-6">
						<div>
						<label for="sample-firstname" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">First Name *</label>
						<input type="text" id="sample-firstname" name="firstName" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" placeholder="John">
					</div>
						<div>
						<label for="sample-lastname" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Last Name *</label>
						<input type="text" id="sample-lastname" name="lastName" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" placeholder="Doe">
					</div>
					</div>

					<div>
					<label for="sample-company" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Company Name *</label>
					<input type="text" id="sample-company" name="company" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" placeholder="Your Fashion Brand">
				</div>

					<div>
					<label for="sample-email" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Email Address *</label>
					<input type="email" id="sample-email" name="email" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" placeholder="john@company.com">
				</div>

					<div style="margin-bottom:1.5rem;">
					<label for="phone-number-input" style="display:block;font-size:0.65rem;letter-spacing:0.14em;text-transform:uppercase;color:#FFFFFF;margin-bottom:0.45rem;">
						Phone Number *
					</label>
					<div style="display:flex;border:1px solid #e00;overflow:visible;">
						<select
							id="phone-code-select"
							name="phoneCode"
							style="background:#000;border:none;border-right:1px solid #333;color:#fff;padding:0.65rem 0.4rem;font-size:0.82rem;outline:none;font-family:inherit;width:130px;flex-shrink:0;cursor:pointer;"
						>
							<option value="">🌍 +??</option>
						</select>
						<input
							type="tel"
							id="phone-number-input"
							name="phoneNumber"
							required
							placeholder="Your number"
							style="background:#000;border:none;color:#fff;padding:0.65rem 0.9rem;font-size:0.82rem;flex:1;width:calc(100% - 130px);outline:none;font-family:inherit;display:block;"
						/>
					</div>
					<input type="hidden" id="sample-phone-hidden" name="phone" />
				</div>

					<div>
					<label for="sample-country" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Country *</label>
					<select id="sample-country" name="country" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
						<option value="">Select your country</option>
					</select>
				</div>

					<div>
					<label for="sample-type" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Sample Type *</label>
					<select id="sample-type" name="sampleType" required style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
						<option value="">Select sample type</option>
						<option value="t-shirt">T-Shirt Sample</option>
						<option value="polo">Polo Shirt Sample</option>
						<option value="hoodie">Hoodie Sample</option>
						<option value="jeans">Denim Sample</option>
						<option value="custom">Custom Design Sample</option>
						<option value="fabric">Fabric Swatches</option>
					</select>
				</div>

					<div>
					<label for="sample-details" style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#FFFFFF; margin-bottom:0.45rem;">Project Details</label>
					<textarea id="sample-details" name="details" rows="4" style="background:#000; border:1px solid #e00; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none; resize:vertical;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" placeholder="Tell us about your project, target quantity, timeline, and any specific requirements..."></textarea>
				</div>

					<div class="flex items-start">
						<input type="checkbox" id="agreeTerms" required class="mt-1 mr-3">
						<label for="agreeTerms" class="text-white/70 text-sm">
							I agree to be contacted regarding my sample request and understand that samples are provided for evaluation purposes only.
						</label>
					</div>

					<div style="position:absolute;left:-9999px;" aria-hidden="true">
				<input type="text" name="_hp" tabindex="-1" autocomplete="off" />
			</div>

				<button type="submit" style="background:transparent; border: 1px solid #e00; color: #e00; padding: 0.85rem 2rem; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s, color 0.2s; font-family: inherit; width: 100%;" onmouseover="this.style.background='#e00';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='#e00'">Request Sample</button>
				</form>

				<div id="successMessage" class="hidden mt-8 p-6 bg-green-900/20 border border-green-700 rounded-lg">
					<h3 class="text-xl font-bold text-green-400 mb-2">Sample Request Received!</h3>
					<p class="text-white/70">
						Thank you for your sample request. Our team will review your requirements and contact you within 48 hours to discuss next steps.
					</p>
				</div>
			</div>

			<div class="mt-12 grid md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="text-3xl mb-3">Complimentary Sample Shipping</div>
					<h3 class="text-xl font-bold text-white mb-2">Complimentary Sample Shipping</h3>
					<p class="text-white/70 text-sm">Sample shipping is free for qualified bulk order inquiries</p>
				</div>
				<div class="text-center">
					<div class="text-3xl mb-3">48-Hour Sample Dispatch</div>
					<h3 class="text-xl font-bold text-white mb-2">48-Hour Sample Dispatch</h3>
					<p class="text-white/70 text-sm">Samples delivered within 7-14 days worldwide</p>
				</div>
				<div class="text-center">
					<div class="text-3xl mb-3">Production Sample Match</div>
					<h3 class="text-xl font-bold text-white mb-2">Production Sample Match</h3>
					<p class="text-white/70 text-sm">Production samples match final bulk order quality</p>
				</div>
			</div>
		</div>
