---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Sample Request | Free Clothing Manufacturing Samples";
const pageDescription = "Request free clothing manufacturing samples from SDF Clothing. Get quality samples for your apparel production in Bangladesh.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Sample Request",
		"description": "Request free clothing manufacturing samples from SDF Clothing",
		"url": "https://sdfclothing.com/tools/sample-request",
		"provider": {
			"@type": "Organization",
			"name": "SDF Clothing",
			"url": "https://sdfclothing.com"
		}
	}
	</script>

	<section class="py-20 px-4">
		<div class="container mx-auto max-w-4xl">
			<div class="text-center mb-12">
				<h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
					Free Sample Request
				</h1>
				<p class="text-white/70 text-lg">
					Get quality samples to evaluate our manufacturing capabilities before placing bulk orders
				</p>
			</div>

			<div class="snake-card p-8 max-w-2xl mx-auto">
				<form id="sampleRequest" class="space-y-6">
					<div class="grid md:grid-cols-2 gap-6">
						<div>
							<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">First Name *</label>
							<input type="text" id="firstName" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="John">
						</div>
						<div>
							<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Last Name *</label>
							<input type="text" id="lastName" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="Doe">
						</div>
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Company Name *</label>
						<input type="text" id="company" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="Your Fashion Brand">
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Email Address *</label>
						<input type="email" id="email" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="john@company.com">
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Phone Number *</label>
						<input type="tel" id="phone" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="+880 1711160511">
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Country *</label>
						<select id="country" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
							<option value="">Select your country</option>
							<option value="US">United States</option>
							<option value="UK">United Kingdom</option>
							<option value="DE">Germany</option>
							<option value="FR">France</option>
							<option value="IT">Italy</option>
							<option value="ES">Spain</option>
							<option value="NL">Netherlands</option>
							<option value="AU">Australia</option>
							<option value="CA">Canada</option>
							<option value="RU">Russia</option>
							<option value="Other">Other</option>
						</select>
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Sample Type *</label>
						<select id="sampleType" required style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
							<option value="">Select sample type</option>
							<option value="t-shirt">T-Shirt Sample</option>
							<option value="polo">Polo Shirt Sample</option>
							<option value="hoodie">Hoodie Sample</option>
							<option value="jeans">Denim Sample</option>
							<option value="custom">Custom Design Sample</option>
							<option value="fabric">Fabric Swatches</option>
						</select>
					</div>

					<div>
						<label style="display:block; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:#555; margin-bottom:0.45rem;">Project Details</label>
						<textarea id="projectDetails" rows="4" style="background:#000; border:1px solid #1a1a1a; color:#fff; padding:0.65rem 0.9rem; font-size:0.82rem; width:100%; outline:none; font-family:inherit; appearance:none; resize:vertical;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" placeholder="Tell us about your project, target quantity, timeline, and any specific requirements..."></textarea>
					</div>

					<div class="flex items-start">
						<input type="checkbox" id="agreeTerms" required class="mt-1 mr-3">
						<label for="agreeTerms" class="text-white/70 text-sm">
							I agree to be contacted regarding my sample request and understand that samples are provided for evaluation purposes only.
						</label>
					</div>

					<div style="position:absolute;left:-9999px;" aria-hidden="true">
				<input type="text" name="_hp" tabindex="-1" autocomplete="off" />
			</div>

				<button type="submit" style="background:transparent; border: 1px solid #cc0000; color: #cc0000; padding: 0.85rem 2rem; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s, color 0.2s; font-family: inherit; width: 100%;" onmouseover="this.style.background='#cc0000';this.style.color='#000'" onmouseout="this.style.background='transparent';this.style.color='#cc0000'">Request Sample</button>
				</form>

				<div id="successMessage" class="hidden mt-8 p-6 bg-green-900/20 border border-green-700 rounded-lg">
					<h3 class="text-xl font-bold text-green-400 mb-2">Sample Request Received!</h3>
					<p class="text-white/70">
						Thank you for your sample request. Our team will review your requirements and contact you within 48 hours to discuss next steps.
					</p>
				</div>
			</div>

			<div class="mt-12 grid md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="text-3xl mb-3">Free Shipping</div>
					<h3 class="text-xl font-bold text-white mb-2">Free Shipping</h3>
					<p class="text-white/70 text-sm">Sample shipping is free for qualified bulk order inquiries</p>
				</div>
				<div class="text-center">
					<div class="text-3xl mb-3">Quick Turnaround</div>
					<h3 class="text-xl font-bold text-white mb-2">Quick Turnaround</h3>
					<p class="text-white/70 text-sm">Samples delivered within 7-14 days worldwide</p>
				</div>
				<div class="text-center">
					<div class="text-3xl mb-3">Quality Guaranteed</div>
					<h3 class="text-xl font-bold text-white mb-2">Quality Guaranteed</h3>
					<p class="text-white/70 text-sm">Production samples match final bulk order quality</p>
				</div>
			</div>
		</div>
	</section>

		<script>
	(function(){
	  const WEB3 = '6cdc0c73-5cd1-4d25-a4c8-562a46b623ae';
	  const FCARRY = 'https://formcarry.com/s/46IEwVrAjO_';

	  function getDevice(){
	    const ua=navigator.userAgent;
	    if(/iPhone/.test(ua)) return 'iPhone';
	    if(/iPad/.test(ua)) return 'iPad';
	    if(/Android/.test(ua)) return 'Android Device';
	    if(/Mac/.test(ua)) return 'Mac';
	    if(/Windows/.test(ua)) return 'Windows PC';
	    return 'Unknown Device';
	  }

	  async function getGeo(){
	    try{ const r=await fetch('https://ipapi.co/json/'); const d=await r.json(); return {ip:d.ip||'–',city:d.city||'',country:d.country_name||'Unknown'}; }
	    catch{ return {ip:'–',city:'',country:'Unknown'}; }
	  }

	  function showThanks(geo,device){
	    const now=new Date();
	    const time=now.toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
	    const loc=[geo.city,geo.country].filter(Boolean).join(', ');
	    const html=`<div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);display:flex;align-items:center;justify-content:center;z-index:9999;padding:2rem;"><div style="max-width:420px;width:100%;border:1px solid #cc0000;padding:2.5rem;text-align:center;"><div style="font-size:2rem;color:#cc0000;margin-bottom:1rem;">✓</div><h2 style="font-size:1rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">Sample Request Received</h2><p style="font-size:0.82rem;color:#888;margin-bottom:1.5rem;line-height:1.7;">We'll review your request and respond within 48 hours.</p><div style="border-top:1px solid #1a1a1a;padding-top:1.25rem;text-align:left;margin-bottom:1.5rem;"><div style="display:grid;grid-template-columns:auto 1fr;gap:0.4rem 1rem;font-size:0.78rem;"><span style="color:#555;">Device</span><span style="color:#fff;">${device}</span><span style="color:#555;">Location</span><span style="color:#fff;">${loc||'–'}</span><span style="color:#555;">IP</span><span style="color:#fff;">${geo.ip}</span><span style="color:#555;">Time</span><span style="color:#fff;">${time}</span></div></div><button onclick="this.closest('div').parentElement.remove()" style="background:#cc0000;color:#fff;border:none;padding:0.7rem 2rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;">Close</button></div></div>`;
	    document.body.insertAdjacentHTML('beforeend',html);
	  }

	  const form = document.getElementById('sampleRequest');
	  if(!form) return;

	  form.addEventListener('submit', async function(e){
	    e.preventDefault();
	    const btn = form.querySelector('[type="submit"]');
	    if(btn){ btn.disabled=true; btn.textContent='Sending…'; }

	    const data = {
	      subject: 'New Sample Request  SDF Clothing',
	      firstName: document.getElementById('firstName')?.value||'',
	      lastName:  document.getElementById('lastName')?.value||'',
	      company:   document.getElementById('company')?.value||'',
	      email:     document.getElementById('email')?.value||'',
	      phone:     document.getElementById('phone')?.value||'',
	      country:   document.getElementById('country')?.value||'',
	      sampleType:document.getElementById('sampleType')?.value||'',
	      details:   document.getElementById('projectDetails')?.value||'',
	    };

	    const [geo, device] = await Promise.all([getGeo(), Promise.resolve(getDevice())]);
	    data._device = device;
	    data._location = [geo.city,geo.country].filter(Boolean).join(', ');
	    data._ip = geo.ip;

	    // Web3Forms
	    let ok = false;
	    try {
	      const body = new FormData();
	      body.append('access_key', WEB3);
	      Object.entries(data).forEach(([k,v])=>body.append(k,v));
	      const r = await fetch('https://api.web3forms.com/submit',{method:'POST',body});
	      const j = await r.json();
	      ok = j.success;
	    } catch{}

	    // Formcarry backup
	    if(ok){
	      fetch(FCARRY,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)}).catch(()=>{});
	    } else {
	      try{
	        const r=await fetch(FCARRY,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)});
	        ok=r.ok;
	      }catch{}
	    }

	    if(btn){ btn.disabled=false; btn.textContent='Request Sample'; }
	    if(ok){ form.reset(); showThanks(geo,device); }
	    else{ alert('Something went wrong. Please WhatsApp us: wa.me/8801911733226'); }
	  });
	})();
	</script>

</BaseLayout>