	  function populatePhoneDropdown(selectedCode) {
	    const sel = document.getElementById('phone-code-select');
	    if (!sel) return;
	    sel.innerHTML = '';
	    COUNTRIES.forEach(c => {
	      const opt = document.createElement('option');
	      opt.value = c.phone;
	      opt.textContent = `${c.flag} ${c.phone}`;
	      opt.dataset.code = c.code;
	      if (c.code === selectedCode) opt.selected = true;
	      sel.appendChild(opt);
	    });
	  }

	  function populateCountryDropdown(selectedCode) {
	    const sel = document.getElementById('sample-country');
	    if (!sel) return;
	    sel.innerHTML = '<option value="">Select your country</option>';
	    COUNTRIES.forEach(c => {
	      const opt = document.createElement('option');
	      opt.value = c.name;
	      opt.textContent = `${c.flag} ${c.name}`;
	      if (c.code === selectedCode) opt.selected = true;
	      sel.appendChild(opt);
	    });
	  }

	  async function autoDetect() {
	    const geo = await getGeo();
	    
	    if (geo.countryCode && geo.countryCode !== '') {
	      populateCountryDropdown(geo.countryCode);
	      populatePhoneDropdown(geo.countryCode);
	    } else {
	      populateCountryDropdown('');
	      populatePhoneDropdown('');
	      
	      const wrapper = document.getElementById('phone-wrapper');
	      if (wrapper) {
	        const warn = document.createElement('p');
	        warn.style.cssText = 'font-size:0.72rem;color:#e00;margin-top:0.3rem;';
	        warn.textContent = '⚠ Location not detected. Please select your country and phone code manually.';
	        wrapper.parentNode.insertBefore(warn, wrapper.nextSibling);
	      }
	    }
	    
	    return geo;
	  }

	  function combinePhone() {
	    const code = document.getElementById('phone-code-select')?.value || '';
	    const num = document.getElementById('phone-number-input')?.value.trim() || '';
	    const hidden = document.getElementById('sample-phone-hidden');
	    if (hidden) hidden.value = code + num;
	  }

	  autoDetect();

	  function getDevice(){
	    const ua=navigator.userAgent;
	    if(/iPhone/.test(ua)) return 'iPhone';
	    if(/iPad/.test(ua)) return 'iPad';
	    if(/Android/.test(ua)) return 'Android Device';
	    if(/Mac/.test(ua)) return 'Mac';
	    if(/Windows/.test(ua)) return 'Windows PC';
	    return 'Unknown Device';
	  }

	  async function getGeo(){
	    try {
	      const r = await fetch('https://ipinfo.io/json');
	      const d = await r.json();
	      if (d.ip) return {
	        ip: d.ip,
	        city: d.city||'',
	        region: d.region||'',
	        country: d.country||'Unknown',
	        countryCode: d.country||'',
	        isp: d.org||'Unknown'
	      };
	    } catch {}
	    try {
	      const r = await fetch('https://ipapi.co/json/');
	      const d = await r.json();
	      if (d.ip) return {
	        ip: d.ip,
	        city: d.city||'',
	        region: d.region||'',
	        country: d.country_name||'Unknown',
	        countryCode: d.country_code||'',
	        isp: d.org||'Unknown'
	      };
	    } catch {}
	    try {
	      const r = await fetch('https://ip-api.com/json/');
	      const d = await r.json();
	      if (d.query) return {
	        ip: d.query,
	        city: d.city||'',
	        region: d.regionName||'',
	        country: d.country||'Unknown',
	        countryCode: d.countryCode||'',
	        isp: d.isp||'Unknown'
	      };
	    } catch {}
	    try {
	      const r = await fetch('https://api.ipify.org?format=json');
	      const d = await r.json();
	      return {ip:d.ip||'–',city:'',region:'',
              country:'Unknown',countryCode:'',isp:'Unknown'};
	    } catch {}
	    return {ip:'–',city:'',region:'',country:'Unknown',
            countryCode:'',isp:'Unknown'};
	  }

	  function generateReferenceId(ip) {
	    const now = new Date();
	    const year = now.getFullYear();
	    const month = String(now.getMonth()+1).padStart(2,'0');
	    const day = String(now.getDate()).padStart(2,'0');
	    const hours = String(now.getHours()).padStart(2,'0');
	    const minutes = String(now.getMinutes()).padStart(2,'0');
	    const seconds = String(now.getSeconds()).padStart(2,'0');
	    const hhmm = `${hours}${minutes}`;
	    
	    // Generate device fingerprint
	    const canvas = document.createElement('canvas');
	    const gl = canvas.getContext('webgl');
	    const debugInfo = gl ? gl.getExtension('WEBGL_debug_renderer_info') : null;
	    const gpuHash = debugInfo ? 
	      gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL).slice(0,4).replace(/\s/g,'') : 
	      Math.random().toString(36).slice(2,6).toUpperCase();
	    
	    // IP last segment or random
	    let ipSuffix = '0000';
	    if (ip && ip !== '–' && ip !== 'Unknown') {
	      const parts = ip.split('.');
	      if (parts.length === 4) {
	        ipSuffix = (parts[2].padStart(2,'0') + parts[3].padStart(2,'0')).slice(0,4);
	      }
	    } else {
	      ipSuffix = Math.floor(1000 + Math.random() * 9000).toString();
	    }
	    
	    return `SDF-${year}${month}${day}-${hhmm}${seconds}-${ipSuffix}`;
	  }

	  function showThanks(geo,device,fillDuration,referenceId,deviceId){
	    const now=new Date();
	    const time=now.toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
	    const loc=[geo.city,geo.region,geo.country].filter(Boolean).join(', ');
	    const resolution = `${window.screen.width} x ${window.screen.height}`;
	    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown';
	    const html=`<div style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);display:flex;align-items:center;justify-content:center;z-index:9999;padding:2rem;"><div style="max-width:420px;width:100%;border:1px solid #e00;padding:2.5rem;text-align:center;"><div style="font-size:2rem;color:#e00;margin-bottom:1rem;">✓</div><h2 style="font-size:1rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">Sample Request Received</h2><p style="font-size:0.82rem;color:#FFFFFF;margin-bottom:1.5rem;line-height:1.7;">We'll review your request and respond within 48 hours.</p><div style="border-top:1px solid #e00;padding-top:1.25rem;text-align:left;margin-bottom:1.5rem;"><div style="display:grid;grid-template-columns:auto 1fr;gap:0.4rem 1rem;font-size:0.78rem;"><span style="color:#FFFFFF;">Reference ID</span><span style="color:#fff;">${referenceId}</span><span style="color:#FFFFFF;">Device ID</span><span style="color:#fff;">${deviceId||'N/A'}</span><span style="color:#FFFFFF;">Device</span><span style="color:#fff;">${device}</span><span style="color:#FFFFFF;">Location</span><span style="color:#fff;">${loc||'–'}</span><span style="color:#FFFFFF;">IP</span><span style="color:#fff;">${geo.ip}</span><span style="color:#FFFFFF;">Resolution</span><span style="color:#fff;">${resolution}</span><span style="color:#FFFFFF;">Timezone</span><span style="color:#fff;">${timezone}</span><span style="color:#FFFFFF;">Fill Time</span><span style="color:#fff;">${fillDuration}s</span><span style="color:#FFFFFF;">Time</span><span style="color:#fff;">${time}</span></div></div><button onclick="this.closest('div').parentElement.remove()" style="background:#e00;color:#fff;border:none;padding:0.7rem 2rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;">Close</button></div></div>`;
	    document.body.insertAdjacentHTML('beforeend',html);
	  }

	  const form = document.getElementById('sampleRequest');
	  if(!form) return;

	  const ipSubmissionCount = {};

	  form.addEventListener('submit', async function(e){
	    e.preventDefault();
	    combinePhone();

	    const btn = form.querySelector('[type="submit"]');
	    if(btn){ btn.disabled=true; btn.textContent='Sending…'; }

	    const fd = new FormData(form);
	    const data = {
	      subject:    'New Sample Request — SDF Clothing',
	      _subject:   'New Sample Request — SDF Clothing',
	      _replyto:   fd.get('email') || '',
	      firstName:  fd.get('firstName') || '',
	      lastName:   fd.get('lastName') || '',
	      name:       ((fd.get('firstName')||'') + ' ' + (fd.get('lastName')||'')).trim(),
	      company:    fd.get('company') || '',
	      email:      fd.get('email') || '',
	      phone:      fd.get('phoneNumber') || fd.get('phone') || fd.get('whatsapp') || '',
	      country:    fd.get('country') || '',
	      sampleType: fd.get('sampleType') || '',
	      details:    fd.get('details') || '',
	    };

	    const fillDuration = ((Date.now() - pageLoadTime) / 1000).toFixed(1);

	    // Honeypot check
	    if (data._hp) {
	      form.reset();
	      const geo = await getGeo();
	      const referenceId = generateReferenceId(geo.ip);
	      showThanks(geo, getDevice(), fillDuration, referenceId, null);
	      return;
	    }

	    // Fill time check (bot detection)
	    if (parseFloat(fillDuration) < 3) {
	      form.reset();
	      const geo = await getGeo();
	      const referenceId = generateReferenceId(geo.ip);
	      showThanks(geo, getDevice(), fillDuration, referenceId, null);
	      return;
	    }

	    const [geo, device] = await Promise.all([getGeo(), Promise.resolve(getDevice())]);

	    // IP rate limiting
	    if (geo.ip && geo.ip !== '–') {
	      ipSubmissionCount[geo.ip] = (ipSubmissionCount[geo.ip] || 0) + 1;
	      if (ipSubmissionCount[geo.ip] > 3) {
	        if(btn){ btn.disabled=false; btn.textContent='Request Sample'; }
	        alert('Too many submissions. Please WhatsApp us: wa.me/8801911733226');
	        return;
	      }
	    }

	    // Collect device fingerprint
	    const deviceFingerprint = {
	      screen: `${window.screen.width}x${window.screen.height}`,
	      colorDepth: window.screen.colorDepth,
	      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
	      language: navigator.language,
	      platform: navigator.platform,
	      cookieEnabled: navigator.cookieEnabled,
	      touchPoints: navigator.maxTouchPoints || 0,
	      deviceMemory: navigator.deviceMemory || 'unknown',
	      hardwareConcurrency: navigator.hardwareConcurrency || 'unknown',
	    };

	    const deviceId = btoa(JSON.stringify({
	      ua: navigator.userAgent.slice(0,50),
	      screen: deviceFingerprint.screen,
	      tz: deviceFingerprint.timezone,
	      lang: deviceFingerprint.language
	    })).slice(0,20);

	    const referenceId = generateReferenceId(geo.ip);
	    data._device = device;
	    data._location = [geo.city,geo.region,geo.country].filter(Boolean).join(', ');
	    data._ip = geo.ip;
	    data._reference_id = referenceId;
	    data._device_id = deviceId;
	    data._device_fingerprint = JSON.stringify(deviceFingerprint);
	    data._screen = deviceFingerprint.screen;
	    data._timezone = deviceFingerprint.timezone;
	    data._language = deviceFingerprint.language;
	    data.subject = 'New Sample Request — SDF Clothing';

	    // Web3Forms
	    let ok = false;
	    try {
	      const body = new FormData();
	      body.append('access_key', WEB3);
	      Object.entries(data).forEach(([k,v])=>body.append(k,v));
	      const r = await fetch('https://api.web3forms.com/submit',{method:'POST',body});
	      const j = await r.json();
	      ok = j.success;
	    } catch{}

	    // Formcarry backup
	    if(ok){
	      fetch(FCARRY,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)}).catch(()=>{});
	    } else {
	      try{
	        const r=await fetch(FCARRY,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)});
	        ok=r.ok;
	      }catch{}
	    }

	    if(btn){ btn.disabled=false; btn.textContent='Request Sample'; }
	    if(ok){ form.reset(); showThanks(geo,device,fillDuration,referenceId,deviceId); }
	    else{ alert('Something went wrong. Please WhatsApp us: wa.me/8801911733226'); }
	  });
	})();
	</script>

