function initColorWheel() {
  const canvas = document.getElementById('colorWheel');
  const ctx = canvas.getContext('2d');
  const cx = canvas.width/2, cy = canvas.height/2, r = canvas.width/2 - 10;
  for (let a=0;a<360;a++) {
    ctx.beginPath();
    ctx.moveTo(cx,cy);
    ctx.arc(cx,cy,r,(a-2)*Math.PI/180,(a+2)*Math.PI/180);
    ctx.closePath();
    ctx.fillStyle=`hsl(${a},100%,50%)`;
    ctx.fill();
  }
  const g=ctx.createRadialGradient(cx,cy,0,cx,cy,r);
  g.addColorStop(0,'#FFFFFF');
  g.addColorStop(1,'transparent');
  ctx.fillStyle=g;
  ctx.beginPath();
  ctx.arc(cx,cy,r,0,2*Math.PI);
  ctx.fill();
  let drag=false;
  function pick(e) {
    const rc=canvas.getBoundingClientRect();
    const sx=canvas.width/rc.width, sy=canvas.height/rc.height;
    const px=(e.clientX-rc.left)*sx, py=(e.clientY-rc.top)*sy;
    const d=ctx.getImageData(Math.round(px),Math.round(py),1,1).data;
    currentRGB={r:d[0],g:d[1],b:d[2]};
    updateAllConversions();
  }
  canvas.addEventListener('mousedown',e=>{drag=true;pick(e);});
  canvas.addEventListener('mousemove',e=>{if(drag)pick(e);});
  canvas.addEventListener('mouseup',()=>drag=false);
  canvas.addEventListener('mouseleave',()=>drag=false);
  canvas.addEventListener('touchstart',e=>{e.preventDefault();drag=true;pick(e.touches[0]);},{passive:false});
  canvas.addEventListener('touchmove',e=>{e.preventDefault();if(drag)pick(e.touches[0]);},{passive:false});
  canvas.addEventListener('touchend',()=>drag=false);
}

function initPalette() {
  const grid=document.getElementById('paletteGrid');
  garmentPalette.forEach(c=>{
    const s=document.createElement('div');
    s.className='palette-swatch';
    s.style.backgroundColor=c;
    s.title=c;
    s.addEventListener('click',()=>{currentRGB=hexToRgb(c);updateAllConversions();});
    grid.appendChild(s);
  });
}

function updateAllConversions() {
  const {r,g,b}=currentRGB;
  const hex=rgbToHex(r,g,b);
  const l2=adjustB(r,g,b,40),l1=adjustB(r,g,b,20),d1=adjustB(r,g,b,-20),d2=adjustB(r,g,b,-40);
  document.getElementById('colorPreviewLighter2').style.backgroundColor=rgbToHex(l2.r,l2.g,l2.b);
  document.getElementById('colorPreviewLighter1').style.backgroundColor=rgbToHex(l1.r,l1.g,l1.b);
  document.getElementById('colorPreview').style.backgroundColor=hex;
  document.getElementById('colorPreviewDarker1').style.backgroundColor=rgbToHex(d1.r,d1.g,d1.b);
  document.getElementById('colorPreviewDarker2').style.backgroundColor=rgbToHex(d2.r,d2.g,d2.b);
  updateNamedColors(r,g,b);
  ['hexSwatch','rgbSwatch','cmykSwatch','labSwatch','lchSwatch','hslSwatch','hsvSwatch','ncsSwatch','munsellSwatch','xyzSwatch'].forEach(id=>{
    const el=document.getElementById(id);if(el)el.style.backgroundColor=hex;
  });
  document.getElementById('hexValue').textContent=hex.toUpperCase();
  document.getElementById('rgbValue').textContent=`rgb(${r}, ${g}, ${b})`;
  const cmyk=rgbToCmyk(r,g,b);
  document.getElementById('cmykValue').textContent=`${cmyk.c}%, ${cmyk.m}%, ${cmyk.y}%, ${cmyk.k}%`;
  const lab=rgbToLab(r,g,b);
  document.getElementById('labValue').textContent=`L:${Math.round(lab.L)}, A:${Math.round(lab.a)}, B:${Math.round(lab.b)}`;
  const lch=labToLch(lab.L,lab.a,lab.b);
  document.getElementById('lchValue').textContent=`L:${Math.round(lch.L)}, C:${Math.round(lch.C)}, H:${Math.round(lch.h)}°`;
  const hsl=rgbToHsl(r,g,b);
  document.getElementById('hslValue').textContent=`hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
  const hsv=rgbToHsv(r,g,b);
  document.getElementById('hsvValue').textContent=`hsv(${hsv.h}, ${hsv.s}%, ${hsv.v}%)`;
  document.getElementById('ncsValue').textContent=rgbToNcs(lab);
  const p=findNearest(r,g,b,pantoneColors);
  document.getElementById('pantoneValue').textContent=p.name;
  document.getElementById('pantoneSwatch').style.backgroundColor=p.hex;
  document.getElementById('deltaEValue').textContent=calcDE2000(lab,rgbToLab(p.r,p.g,p.b)).toFixed(2);
  const ral=findNearest(r,g,b,ralColors);
  document.getElementById('ralValue').textContent=ral.name;
  document.getElementById('ralSwatch').style.backgroundColor=ral.hex;
  document.getElementById('munsellValue').textContent=labToMunsell(lab);
  const xyz=rgbToXyz(r,g,b);
  document.getElementById('xyzValue').textContent=`X:${Math.round(xyz.X)}, Y:${Math.round(xyz.Y)}, Z:${Math.round(xyz.Z)}`;
  document.getElementById('rInput').value=r;
  document.getElementById('gInput').value=g;
  document.getElementById('bInput').value=b;
  document.getElementById('colorInput').value=hex.toUpperCase();
}

function adjustB(r,g,b,a){return{r:Math.max(0,Math.min(255,r+a)),g:Math.max(0,Math.min(255,g+a)),b:Math.max(0,Math.min(255,b+a))};}

function updateNamedColors(r,g,b) {
  const lab1=rgbToLab(r,g,b);
  const sorted=namedColors.map(c=>({...c,delta:calcDE2000(lab1,rgbToLab(c.r,c.g,c.b))})).sort((a,b)=>a.delta-b.delta).slice(0,10);
  const grid=document.getElementById('namedColorsGrid');
  grid.innerHTML='';
  sorted.forEach(c=>{
    const item=document.createElement('div');
    item.className='named-color-item';
    item.onclick=()=>{currentRGB={r:c.r,g:c.g,b:c.b};updateAllConversions();};
    const sw=document.createElement('div');
    sw.className='named-color-swatch';
    sw.style.backgroundColor=`rgb(${c.r},${c.g},${c.b})`;
    const nm=document.createElement('span');
    nm.className='named-color-name';
    nm.textContent=c.name;
    item.appendChild(sw);item.appendChild(nm);grid.appendChild(item);
  });
}

function selectPreviewColor(idx) {
  const ids=['colorPreviewLighter2','colorPreviewLighter1','colorPreview','colorPreviewDarker1','colorPreviewDarker2'];
  ids.forEach(id=>document.getElementById(id).classList.remove('color-preview--selected'));
  document.getElementById(ids[idx]).classList.add('color-preview--selected');
  const bg=document.getElementById(ids[idx]).style.backgroundColor;
  const m=bg.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
  if(m){currentRGB={r:parseInt(m[1]),g:parseInt(m[2]),b:parseInt(m[3])};updateAllConversions();}
}

function rgbToHex(r,g,b){return'#'+[r,g,b].map(x=>x.toString(16).padStart(2,'0')).join('');}
function hexToRgb(hex){const r=/^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);return r?{r:parseInt(r[1],16),g:parseInt(r[2],16),b:parseInt(r[3],16)}:{r:0,g:0,b:0};}
function rgbToCmyk(r,g,b){let c=1-r/255,m=1-g/255,y=1-b/255,k=Math.min(c,m,y);c=((c-k)/(1-k))||0;m=((m-k)/(1-k))||0;y=((y-k)/(1-k))||0;return{c:Math.round(c*100),m:Math.round(m*100),y:Math.round(y*100),k:Math.round(k*100)};}
function rgbToLab(r,g,b){let[lr,lg,lb]=[r,g,b].map(x=>{x=x/255;return(x>0.04045?Math.pow((x+0.055)/1.055,2.4):x/12.92)*100;});let x=(lr*0.4124+lg*0.3576+lb*0.1805)/95.047,y=(lr*0.2126+lg*0.7152+lb*0.0722)/100,z=(lr*0.0193+lg*0.1192+lb*0.9505)/108.883;[x,y,z]=[x,y,z].map(v=>v>0.008856?Math.pow(v,1/3):7.787*v+16/116);return{L:116*y-16,a:500*(x-y),b:200*(y-z)};}
function labToLch(L,a,b){const C=Math.sqrt(a*a+b*b),h=Math.atan2(b,a)*180/Math.PI;return{L,C,h:h<0?h+360:h};}
function rgbToHsl(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b);let h,s,l=(mx+mn)/2;if(mx===mn){h=s=0;}else{const d=mx-mn;s=l>0.5?d/(2-mx-mn):d/(mx+mn);switch(mx){case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break;}}return{h:Math.round(h*360),s:Math.round(s*100),l:Math.round(l*100)};}
function rgbToHsv(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;let h;if(d===0)h=0;else switch(mx){case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break;}return{h:Math.round(h*360),s:Math.round((mx===0?0:d/mx)*100),v:Math.round(mx*100)};}
function rgbToXyz(r,g,b){let[lr,lg,lb]=[r,g,b].map(x=>{x=x/255;return x>0.04045?Math.pow((x+0.055)/1.055,2.4):x/12.92;});return{X:lr*41.24+lg*35.76+lb*18.05,Y:lr*21.26+lg*71.52+lb*7.22,Z:lr*1.93+lg*11.92+lb*95.05};}
function rgbToNcs(lab){const L=lab.L,C=Math.sqrt(lab.a*lab.a+lab.b*lab.b),h=Math.atan2(lab.b,lab.a)*180/Math.PI;const bl=Math.round((100-L)/2),ch=Math.round(C/1.5),ha=h<0?h+360:h;let hc='';if(ha<45)hc='Y'+Math.round(ha/45*90)+'R';else if(ha<90)hc='R'+Math.round((ha-45)/45*90)+'Y';else if(ha<135)hc='Y'+Math.round((ha-90)/45*90)+'G';else if(ha<180)hc='G'+Math.round((ha-135)/45*90)+'Y';else if(ha<225)hc='G'+Math.round((ha-180)/45*90)+'B';else if(ha<270)hc='B'+Math.round((ha-225)/45*90)+'G';else if(ha<315)hc='B'+Math.round((ha-270)/45*90)+'R';else hc='R'+Math.round((ha-315)/45*90)+'B';return`S ${String(ch).padStart(2,'0')}${String(bl).padStart(2,'0')}-${hc}`;}
function labToMunsell(lab){const L=lab.L,C=Math.sqrt(lab.a*lab.a+lab.b*lab.b),h=Math.atan2(lab.b,lab.a)*180/Math.PI,v=Math.round(L/10),ch=Math.round(C/2),ha=h<0?h+360:h;let hu='5R';if(ha<36)hu='5R';else if(ha<72)hu='5YR';else if(ha<108)hu='5Y';else if(ha<144)hu='5GY';else if(ha<180)hu='5G';else if(ha<216)hu='5BG';else if(ha<252)hu='5B';else if(ha<288)hu='5PB';else if(ha<324)hu='5P';else hu='5RP';return`${hu} ${Math.min(v,10)}/${Math.min(ch,20)}`;}
function findNearest(r,g,b,arr){const lab1=rgbToLab(r,g,b);return arr.reduce((best,c)=>{const d=calcDE2000(lab1,rgbToLab(c.r,c.g,c.b));return d<best.delta?{...c,delta:d}:best;},{...arr[0],delta:Infinity});}

function calcDE2000(l1,l2){
  const{L:L1,a:a1,b:b1}=l1,{L:L2,a:a2,b:b2}=l2;
  const Lb=(L1+L2)/2,C1=Math.sqrt(a1*a1+b1*b1),C2=Math.sqrt(a2*a2+b2*b2),Cb=(C1+C2)/2;
  const p7=Math.pow(Cb,7),q7=Math.pow(25,7),adj=1-Math.sqrt(p7/(p7+q7));
  const a1p=a1+a1/2*adj,a2p=a2+a2/2*adj;
  const C1p=Math.sqrt(a1p*a1p+b1*b1),C2p=Math.sqrt(a2p*a2p+b2*b2),Cbp=(C1p+C2p)/2;
  let h1p=Math.atan2(b1,a1p)*180/Math.PI;if(h1p<0)h1p+=360;
  let h2p=Math.atan2(b2,a2p)*180/Math.PI;if(h2p<0)h2p+=360;
  const Hbp=Math.abs(h1p-h2p)>180?(h1p+h2p+360)/2:(h1p+h2p)/2;
  const T=1-0.17*Math.cos((Hbp-30)*Math.PI/180)+0.24*Math.cos(2*Hbp*Math.PI/180)+0.32*Math.cos((3*Hbp+6)*Math.PI/180)-0.20*Math.cos((4*Hbp-63)*Math.PI/180);
  let dhp=Math.abs(h2p-h1p)<=180?h2p-h1p:(h2p-h1p>180?h2p-h1p-360:h2p-h1p+360);
  const dLp=L2-L1,dCp=C2p-C1p,dHp2=2*Math.sqrt(C1p*C2p)*Math.sin(dhp*Math.PI/360);
  const SL=1+0.015*Math.pow(Lb-50,2)/Math.sqrt(20+Math.pow(Lb-50,2)),SC=1+0.045*Cbp,SH=1+0.015*Cbp*T;
  const RT=-2*Math.sqrt(Math.pow(Cbp,7)/(Math.pow(Cbp,7)+q7))*Math.sin(60*Math.exp(-Math.pow((Hbp-275)/25,2))*Math.PI/180);
  return Math.sqrt(Math.pow(dLp/SL,2)+Math.pow(dCp/SC,2)+Math.pow(dHp2/SH,2)+RT*(dCp/SC)*(dHp2/SH));
}
function calcDE1994(l1,l2){const dL=l1.L-l2.L,dC=Math.sqrt(l1.a*l1.a+l1.b*l1.b)-Math.sqrt(l2.a*l2.a+l2.b*l2.b),dH=Math.sqrt(Math.max(0,Math.pow(l1.a-l2.a,2)+Math.pow(l1.b-l2.b,2)-dC*dC)),C1=Math.sqrt(l1.a*l1.a+l1.b*l1.b);return Math.sqrt(Math.pow(dL,2)+Math.pow(dC/(1+0.045*C1),2)+Math.pow(dH/(1+0.015*C1),2));}
function calcDE1976(l1,l2){return Math.sqrt(Math.pow(l1.L-l2.L,2)+Math.pow(l1.a-l2.a,2)+Math.pow(l1.b-l2.b,2));}

function handleColorInput(){
  const v=document.getElementById('colorInput').value.trim();
  if(v.startsWith('#')&&v.length>=4){const rgb=hexToRgb(v);if(rgb.r||rgb.g||rgb.b||v==='#000000'){currentRGB=rgb;updateAllConversions();}}
  else if(v.toLowerCase().startsWith('rgb')){const m=v.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);if(m){currentRGB={r:parseInt(m[1]),g:parseInt(m[2]),b:parseInt(m[3])};updateAllConversions();}}
  else if(v.length>2){const t=document.createElement('div');t.style.color=v;document.body.appendChild(t);const c=window.getComputedStyle(t).color;document.body.removeChild(t);const m=c.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);if(m){currentRGB={r:parseInt(m[1]),g:parseInt(m[2]),b:parseInt(m[3])};updateAllConversions();}}
}

function handleRGBInput(){
  currentRGB={
    r:Math.max(0,Math.min(255,parseInt(document.getElementById('rInput').value)||0)),
    g:Math.max(0,Math.min(255,parseInt(document.getElementById('gInput').value)||0)),
    b:Math.max(0,Math.min(255,parseInt(document.getElementById('bInput').value)||0))
  };
  updateAllConversions();
}

function calculateDistance(){
  const hA=document.getElementById('colorAInput').value.trim(),hB=document.getElementById('colorBInput').value.trim();
  const rA=hexToRgb(hA),rB=hexToRgb(hB);
  ['colorAPreview','comparisonA'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.backgroundColor=hA;});
  ['colorBPreview','comparisonB'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.backgroundColor=hB;});
  const lA=rgbToLab(rA.r,rA.g,rA.b),lB=rgbToLab(rB.r,rB.g,rB.b);
  const de2=calcDE2000(lA,lB),de94=calcDE1994(lA,lB),de76=calcDE1976(lA,lB);
  document.getElementById('deltaE2000').textContent=de2.toFixed(2);
  document.getElementById('deltaE1994').textContent=de94.toFixed(2);
  document.getElementById('deltaE1976').textContent=de76.toFixed(2);
  const mq=document.getElementById('matchQuality');
  if(de2<1)mq.textContent='Excellent Match — Imperceptible Difference (ΔE < 1.0)';
  else if(de2<2)mq.textContent='Good Match — Acceptable for Branded Garments (ΔE 1.0–2.0)';
  else if(de2<3.5)mq.textContent='Acceptable Match — Suitable for High Street (ΔE 2.0–3.5)';
  else if(de2<5)mq.textContent='Marginal Match — Check Buyer Tolerance (ΔE 3.5–5.0)';
  else mq.textContent='Poor Match — Reject and Rework Required (ΔE > 5.0)';
}

function copyToClipboard(id){
  const t=document.getElementById(id).textContent;
  navigator.clipboard.writeText(t).then(()=>{
    const btn=event.target,orig=btn.textContent;
    btn.textContent='Copied';
    setTimeout(()=>{btn.textContent=orig;},1500);
  }).catch(()=>{});
}

function initFAQ(){
  document.querySelectorAll('.faq-question').forEach(btn=>{
    btn.addEventListener('click',function(){
      const ans=this.nextElementSibling,icon=this.querySelector('.faq-icon'),open=ans.classList.contains('faq-answer--visible');
      document.querySelectorAll('.faq-answer').forEach(a=>a.classList.remove('faq-answer--visible'));
      document.querySelectorAll('.faq-icon').forEach(i=>{i.classList.remove('faq-icon--open');i.textContent='+';});
      document.querySelectorAll('.faq-question').forEach(q=>q.setAttribute('aria-expanded','false'));
      if(!open){ans.classList.add('faq-answer--visible');icon.classList.add('faq-icon--open');icon.textContent='−';this.setAttribute('aria-expanded','true');}
    });
  });
}
</script>

