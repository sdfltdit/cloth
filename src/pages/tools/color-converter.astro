      updateAllConversions();
    });
    paletteGrid.appendChild(swatch);
  });
}

function updateAllConversions() {
  const { r, g, b } = currentRGB;
  const hex = rgbToHex(r, g, b);

  const lighter2 = adjustBrightness(r, g, b, 40);
  const lighter1 = adjustBrightness(r, g, b, 20);
  const darker1 = adjustBrightness(r, g, b, -20);
  const darker2 = adjustBrightness(r, g, b, -40);

  document.getElementById('colorPreviewLighter2').style.backgroundColor = rgbToHex(lighter2.r, lighter2.g, lighter2.b);
  document.getElementById('colorPreviewLighter1').style.backgroundColor = rgbToHex(lighter1.r, lighter1.g, lighter1.b);
  document.getElementById('colorPreview').style.backgroundColor = hex;
  document.getElementById('colorPreviewDarker1').style.backgroundColor = rgbToHex(darker1.r, darker1.g, darker1.b);
  document.getElementById('colorPreviewDarker2').style.backgroundColor = rgbToHex(darker2.r, darker2.g, darker2.b);

  updateNamedColors(r, g, b);

  ['hexSwatch','rgbSwatch','cmykSwatch','labSwatch','lchSwatch','hslSwatch',
   'hsvSwatch','ncsSwatch','munsellSwatch','xyzSwatch'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.backgroundColor = hex;
  });

  document.getElementById('hexValue').textContent = hex.toUpperCase();
  document.getElementById('rgbValue').textContent = `rgb(${r}, ${g}, ${b})`;

  const cmyk = rgbToCmyk(r, g, b);
  document.getElementById('cmykValue').textContent = `${cmyk.c}%, ${cmyk.m}%, ${cmyk.y}%, ${cmyk.k}%`;

  const lab = rgbToLab(r, g, b);
  document.getElementById('labValue').textContent = `L:${Math.round(lab.L)}, A:${Math.round(lab.a)}, B:${Math.round(lab.b)}`;

  const lch = labToLch(lab.L, lab.a, lab.b);
  document.getElementById('lchValue').textContent = `L:${Math.round(lch.L)}, C:${Math.round(lch.C)}, H:${Math.round(lch.h)}°`;

  const hsl = rgbToHsl(r, g, b);
  document.getElementById('hslValue').textContent = `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;

  const hsv = rgbToHsv(r, g, b);
  document.getElementById('hsvValue').textContent = `hsv(${hsv.h}, ${hsv.s}%, ${hsv.v}%)`;

  document.getElementById('ncsValue').textContent = rgbToNcs(lab);

  const pantone = findNearestPantone(r, g, b);
  document.getElementById('pantoneValue').textContent = pantone.name;
  document.getElementById('pantoneSwatch').style.backgroundColor = pantone.hex;

  const deltaE = calculateDeltaE2000(lab, rgbToLab(pantone.r, pantone.g, pantone.b));
  document.getElementById('deltaEValue').textContent = deltaE.toFixed(2);

  const ral = findNearestRal(r, g, b);
  document.getElementById('ralValue').textContent = ral.name;
  document.getElementById('ralSwatch').style.backgroundColor = ral.hex;

  document.getElementById('munsellValue').textContent = labToMunsell(lab);

  const xyz = rgbToXyz(r, g, b);
  document.getElementById('xyzValue').textContent = `X:${Math.round(xyz.X)}, Y:${Math.round(xyz.Y)}, Z:${Math.round(xyz.Z)}`;

  document.getElementById('rInput').value = r;
  document.getElementById('gInput').value = g;
  document.getElementById('bInput').value = b;
  document.getElementById('colorInput').value = hex.toUpperCase();
}

function adjustBrightness(r, g, b, amount) {
  return {
    r: Math.max(0, Math.min(255, r + amount)),
    g: Math.max(0, Math.min(255, g + amount)),
    b: Math.max(0, Math.min(255, b + amount))
  };
}

function updateNamedColors(r, g, b) {
  const lab1 = rgbToLab(r, g, b);
  const sorted = namedColors
    .map(c => ({ ...c, delta: calculateDeltaE2000(lab1, rgbToLab(c.r, c.g, c.b)) }))
    .sort((a, b) => a.delta - b.delta)
    .slice(0, 10);

  const grid = document.getElementById('namedColorsGrid');
  grid.innerHTML = '';
  sorted.forEach(color => {
    const item = document.createElement('div');
    item.className = 'named-color-item';
    item.onclick = () => { currentRGB = { r: color.r, g: color.g, b: color.b }; updateAllConversions(); };

    const swatch = document.createElement('div');
    swatch.className = 'named-color-swatch';
    swatch.style.backgroundColor = `rgb(${color.r},${color.g},${color.b})`;

    const name = document.createElement('span');
    name.className = 'named-color-name';
    name.textContent = color.name;

    item.appendChild(swatch);
    item.appendChild(name);
    grid.appendChild(item);
  });
}

function selectPreviewColor(index) {
  const ids = ['colorPreviewLighter2','colorPreviewLighter1','colorPreview','colorPreviewDarker1','colorPreviewDarker2'];
  ids.forEach(id => document.getElementById(id).classList.remove('color-preview--selected'));
  document.getElementById(ids[index]).classList.add('color-preview--selected');
  const bg = document.getElementById(ids[index]).style.backgroundColor;
  const match = bg.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
  if (match) {
    currentRGB = { r: parseInt(match[1]), g: parseInt(match[2]), b: parseInt(match[3]) };
    updateAllConversions();
  }
}

function rgbToHex(r, g, b) {
  return '#' + [r, g, b].map(x => x.toString(16).padStart(2, '0')).join('');
}

function hexToRgb(hex) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? { r: parseInt(result[1],16), g: parseInt(result[2],16), b: parseInt(result[3],16) } : { r: 0, g: 0, b: 0 };
}

function rgbToCmyk(r, g, b) {
  let c = 1 - r/255, m = 1 - g/255, y = 1 - b/255;
  let k = Math.min(c, m, y);
  c = ((c - k) / (1 - k)) || 0;
  m = ((m - k) / (1 - k)) || 0;
  y = ((y - k) / (1 - k)) || 0;
  return { c: Math.round(c*100), m: Math.round(m*100), y: Math.round(y*100), k: Math.round(k*100) };
}

function rgbToLab(r, g, b) {
  let [lr, lg, lb] = [r, g, b].map(x => {
    x = x / 255;
    return (x > 0.04045 ? Math.pow((x + 0.055) / 1.055, 2.4) : x / 12.92) * 100;
  });
  let x = (lr*0.4124 + lg*0.3576 + lb*0.1805) / 95.047;
  let y = (lr*0.2126 + lg*0.7152 + lb*0.0722) / 100;
  let z = (lr*0.0193 + lg*0.1192 + lb*0.9505) / 108.883;
  [x, y, z] = [x, y, z].map(v => v > 0.008856 ? Math.pow(v, 1/3) : 7.787*v + 16/116);
  return { L: 116*y - 16, a: 500*(x - y), b: 200*(y - z) };
}

function labToLch(L, a, b) {
  const C = Math.sqrt(a*a + b*b);
  const h = Math.atan2(b, a) * 180 / Math.PI;
  return { L, C, h: h < 0 ? h + 360 : h };
}

function rgbToHsl(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  const max = Math.max(r,g,b), min = Math.min(r,g,b);
  let h, s, l = (max + min) / 2;
  if (max === min) { h = s = 0; } else {
    const d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g-b)/d + (g<b?6:0)) / 6; break;
      case g: h = ((b-r)/d + 2) / 6; break;
      case b: h = ((r-g)/d + 4) / 6; break;
    }
  }
  return { h: Math.round(h*360), s: Math.round(s*100), l: Math.round(l*100) };
}

function rgbToHsv(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  const max = Math.max(r,g,b), min = Math.min(r,g,b), d = max - min;
  let h;
  if (d === 0) { h = 0; } else {
    switch (max) {
      case r: h = ((g-b)/d + (g<b?6:0)) / 6; break;
      case g: h = ((b-r)/d + 2) / 6; break;
      case b: h = ((r-g)/d + 4) / 6; break;
    }
  }
  return { h: Math.round(h*360), s: Math.round((max===0?0:d/max)*100), v: Math.round(max*100) };
}

function rgbToXyz(r, g, b) {
  let [lr, lg, lb] = [r, g, b].map(x => {
    x = x / 255;
    return x > 0.04045 ? Math.pow((x + 0.055) / 1.055, 2.4) : x / 12.92;
  });
  return { X: lr*41.24 + lg*35.76 + lb*18.05, Y: lr*21.26 + lg*71.52 + lb*7.22, Z: lr*1.93 + lg*11.92 + lb*95.05 };
}

function rgbToNcs(lab) {
  const L = lab.L, C = Math.sqrt(lab.a*lab.a + lab.b*lab.b);
  const h = Math.atan2(lab.b, lab.a) * 180 / Math.PI;
  const blackness = Math.round((100 - L) / 2);
  const chromaticness = Math.round(C / 1.5);
  const ha = h < 0 ? h + 360 : h;
  let hueCode = '';
  if (ha < 45) hueCode = 'Y' + Math.round(ha/45*90) + 'R';
  else if (ha < 90) hueCode = 'R' + Math.round((ha-45)/45*90) + 'Y';
  else if (ha < 135) hueCode = 'Y' + Math.round((ha-90)/45*90) + 'G';
  else if (ha < 180) hueCode = 'G' + Math.round((ha-135)/45*90) + 'Y';
  else if (ha < 225) hueCode = 'G' + Math.round((ha-180)/45*90) + 'B';
  else if (ha < 270) hueCode = 'B' + Math.round((ha-225)/45*90) + 'G';
  else if (ha < 315) hueCode = 'B' + Math.round((ha-270)/45*90) + 'R';
  else hueCode = 'R' + Math.round((ha-315)/45*90) + 'B';
  return `S ${String(chromaticness).padStart(2,'0')}${String(blackness).padStart(2,'0')}-${hueCode}`;
}

function labToMunsell(lab) {
  const L = lab.L, C = Math.sqrt(lab.a*lab.a + lab.b*lab.b);
  const h = Math.atan2(lab.b, lab.a) * 180 / Math.PI;
  const value = Math.round(L / 10);
  const chroma = Math.round(C / 2);
  const ha = h < 0 ? h + 360 : h;
  let hue = '5R';
  if (ha < 36) hue = '5R';
  else if (ha < 72) hue = '5YR';
  else if (ha < 108) hue = '5Y';
  else if (ha < 144) hue = '5GY';
  else if (ha < 180) hue = '5G';
  else if (ha < 216) hue = '5BG';
  else if (ha < 252) hue = '5B';
  else if (ha < 288) hue = '5PB';
  else if (ha < 324) hue = '5P';
  else hue = '5RP';
  return `${hue} ${Math.min(value,10)}/${Math.min(chroma,20)}`;
}

function findNearestPantone(r, g, b) {
  const lab1 = rgbToLab(r, g, b);
  return pantoneColors.reduce((best, c) => {
    const d = calculateDeltaE2000(lab1, rgbToLab(c.r, c.g, c.b));
    return d < best.delta ? { ...c, delta: d } : best;
  }, { ...pantoneColors[0], delta: Infinity });
}

function findNearestRal(r, g, b) {
  const lab1 = rgbToLab(r, g, b);
  return ralColors.reduce((best, c) => {
    const d = calculateDeltaE2000(lab1, rgbToLab(c.r, c.g, c.b));
    return d < best.delta ? { ...c, delta: d } : best;
  }, { ...ralColors[0], delta: Infinity });
}

function calculateDeltaE2000(lab1, lab2) {
  const { L: L1, a: a1, b: b1 } = lab1, { L: L2, a: a2, b: b2 } = lab2;
  const Lbar = (L1+L2)/2;
  const C1 = Math.sqrt(a1*a1+b1*b1), C2 = Math.sqrt(a2*a2+b2*b2);
  const Cbar = (C1+C2)/2;
  const pow7 = Math.pow(Cbar,7), pow25 = Math.pow(25,7);
  const adj = 1 - Math.sqrt(pow7/(pow7+pow25));
  const a1p = a1 + a1/2*adj, a2p = a2 + a2/2*adj;
  const C1p = Math.sqrt(a1p*a1p+b1*b1), C2p = Math.sqrt(a2p*a2p+b2*b2);
  const Cbarp = (C1p+C2p)/2;
  let h1p = Math.atan2(b1,a1p)*180/Math.PI; if (h1p<0) h1p+=360;
  let h2p = Math.atan2(b2,a2p)*180/Math.PI; if (h2p<0) h2p+=360;
  const Hbarp = Math.abs(h1p-h2p)>180 ? (h1p+h2p+360)/2 : (h1p+h2p)/2;
  const T = 1 - 0.17*Math.cos((Hbarp-30)*Math.PI/180) + 0.24*Math.cos(2*Hbarp*Math.PI/180)
              + 0.32*Math.cos((3*Hbarp+6)*Math.PI/180) - 0.20*Math.cos((4*Hbarp-63)*Math.PI/180);
  let dHp = Math.abs(h2p-h1p)<=180 ? h2p-h1p : (h2p-h1p>180 ? h2p-h1p-360 : h2p-h1p+360);
  const dLp = L2-L1, dCp = C2p-C1p;
  const dHp2 = 2*Math.sqrt(C1p*C2p)*Math.sin(dHp*Math.PI/360);
  const SL = 1 + 0.015*Math.pow(Lbar-50,2)/Math.sqrt(20+Math.pow(Lbar-50,2));
  const SC = 1 + 0.045*Cbarp, SH = 1 + 0.015*Cbarp*T;
  const RT = -2*Math.sqrt(Math.pow(Cbarp,7)/(Math.pow(Cbarp,7)+pow25))*Math.sin(60*Math.exp(-Math.pow((Hbarp-275)/25,2))*Math.PI/180);
  return Math.sqrt(Math.pow(dLp/SL,2)+Math.pow(dCp/SC,2)+Math.pow(dHp2/SH,2)+RT*(dCp/SC)*(dHp2/SH));
}

function calculateDeltaE1994(lab1, lab2) {
  const dL = lab1.L-lab2.L;
  const dC = Math.sqrt(lab1.a*lab1.a+lab1.b*lab1.b)-Math.sqrt(lab2.a*lab2.a+lab2.b*lab2.b);
  const dH = Math.sqrt(Math.max(0, Math.pow(lab1.a-lab2.a,2)+Math.pow(lab1.b-lab2.b,2)-dC*dC));
  const C1 = Math.sqrt(lab1.a*lab1.a+lab1.b*lab1.b);
  return Math.sqrt(Math.pow(dL,2)+Math.pow(dC/(1+0.045*C1),2)+Math.pow(dH/(1+0.015*C1),2));
}

function calculateDeltaE1976(lab1, lab2) {
  return Math.sqrt(Math.pow(lab1.L-lab2.L,2)+Math.pow(lab1.a-lab2.a,2)+Math.pow(lab1.b-lab2.b,2));
}

function handleColorInput() {
  const input = document.getElementById('colorInput').value.trim();
  if (input.startsWith('#') && input.length >= 4) {
    const rgb = hexToRgb(input);
    if (rgb.r || rgb.g || rgb.b || input === '#000000') { currentRGB = rgb; updateAllConversions(); }
  } else if (input.toLowerCase().startsWith('rgb')) {
    const match = input.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
    if (match) { currentRGB = { r: parseInt(match[1]), g: parseInt(match[2]), b: parseInt(match[3]) }; updateAllConversions(); }
  } else if (input.length > 2) {
    const tmp = document.createElement('div');
    tmp.style.color = input;
    document.body.appendChild(tmp);
    const comp = window.getComputedStyle(tmp).color;
    document.body.removeChild(tmp);
    const match = comp.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/i);
    if (match) { currentRGB = { r: parseInt(match[1]), g: parseInt(match[2]), b: parseInt(match[3]) }; updateAllConversions(); }
  }
}

function handleRGBInput() {
  currentRGB = {
    r: Math.max(0, Math.min(255, parseInt(document.getElementById('rInput').value) || 0)),
    g: Math.max(0, Math.min(255, parseInt(document.getElementById('gInput').value) || 0)),
    b: Math.max(0, Math.min(255, parseInt(document.getElementById('bInput').value) || 0))
  };
  updateAllConversions();
}

function calculateDistance() {
  const hexA = document.getElementById('colorAInput').value.trim();
  const hexB = document.getElementById('colorBInput').value.trim();
  const rgbA = hexToRgb(hexA), rgbB = hexToRgb(hexB);

  ['colorAPreview','comparisonA'].forEach(id => { const el = document.getElementById(id); if (el) el.style.backgroundColor = hexA; });
  ['colorBPreview','comparisonB'].forEach(id => { const el = document.getElementById(id); if (el) el.style.backgroundColor = hexB; });

  const labA = rgbToLab(rgbA.r, rgbA.g, rgbA.b);
  const labB = rgbToLab(rgbB.r, rgbB.g, rgbB.b);

  const de2000 = calculateDeltaE2000(labA, labB);
  const de1994 = calculateDeltaE1994(labA, labB);
  const de1976 = calculateDeltaE1976(labA, labB);

  document.getElementById('deltaE2000').textContent = de2000.toFixed(2);
  document.getElementById('deltaE1994').textContent = de1994.toFixed(2);
  document.getElementById('deltaE1976').textContent = de1976.toFixed(2);

  const mq = document.getElementById('matchQuality');
  if (de2000 < 1) mq.textContent = 'Excellent Match — Imperceptible Difference (ΔE < 1.0)';
  else if (de2000 < 2) mq.textContent = 'Good Match — Acceptable for Branded Garments (ΔE 1–2)';
  else if (de2000 < 3.5) mq.textContent = 'Acceptable Match — Suitable for High Street (ΔE 2–3.5)';
  else if (de2000 < 5) mq.textContent = 'Marginal Match — Borderline, Check Buyer Tolerance (ΔE 3.5–5)';
  else mq.textContent = 'Poor Match — Reject and Rework Required (ΔE > 5)';
}

function copyToClipboard(elementId) {
  const text = document.getElementById(elementId).textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = event.target;
    const orig = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => { btn.textContent = orig; }, 1500);
  }).catch(() => {});
}

function initFAQ() {
  document.querySelectorAll('.faq-question').forEach(button => {
    button.addEventListener('click', function () {
      const answer = this.nextElementSibling;
      const icon = this.querySelector('.faq-icon');
      const isOpen = answer.classList.contains('faq-answer--visible');

      document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('faq-answer--visible'));
      document.querySelectorAll('.faq-icon').forEach(i => { i.classList.remove('faq-icon--open'); i.textContent = '+'; });
      document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded','false'));

      if (!isOpen) {
        answer.classList.add('faq-answer--visible');
        icon.classList.add('faq-icon--open');
        icon.textContent = '−';
        this.setAttribute('aria-expanded', 'true');
      }
    });
  });
}
</script>

