.field-group select option { background: #111; }
.field-error { font-size: 0.72rem; color: #ff6b6b; display: none; }
.field-group.has-error select, .field-group.has-error input { border-color: #e00; }
.field-group.has-error .field-error { display: block; }
.field-help { font-size: 0.74rem; color: rgba(255,255,255,0.35); line-height: 1.5; }

.fields-section { margin-bottom: 1.25rem; }
.fields-section-title { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: #e00; margin-bottom: 1rem; margin-top: 1.5rem; }

.gen-btn-wrap { margin-top: 1.5rem; margin-bottom: 2.5rem; }
.gen-btn {
  width: 100%; background: #e00; color: #fff; border: none;
  padding: 1rem; font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase;
  cursor: pointer; transition: background 0.2s; font-family: inherit; min-height: 52px;
  border-radius: 2px;
}
.gen-btn:hover { background: #c00; }
