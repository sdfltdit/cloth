  // ---------- Template builders ----------
  function buildInquiry(tone, name, brand) {
    const garment = val('garment-type');
    const svc = val('service-type');
    const qty = val('quantity');
    const fabric = val('fabric');
    const certs = val('certifications');
    const tl = val('timeline');
    const dest = val('destination');
    const inco = val('incoterms');
    const extra = val('extra-info');

    let hasError = false;
    if (!garment) { showError('fg-garment-type', true); hasError = true; } else { showError('fg-garment-type', false); }
    if (!qty) { showError('fg-quantity', true); hasError = true; } else { showError('fg-quantity', false); }
    if (hasError) return null;

    const techPackLine = svc.startsWith('OEM')
      ? 'We have a full tech pack ready to share once you confirm capacity.'
      : (svc.startsWith('ODM') || svc.startsWith('Private Label'))
        ? "We don't have a tech pack yet — happy to review your existing base styles or catalogue."
        : 'We can share full technical documentation once capacity is confirmed.';

    const extraPara = extra ? `\nAdditional requirements:\n${extra}\n` : '';

    const subject = `Production Inquiry — ${garment} — ${qty}`;

    if (tone === 'formal') {
      const body = `${greeting(tone)}

I'm reaching out on behalf of ${brand} regarding an upcoming production order.

Order details:
- Garment: ${garment}
- Production type: ${svc}
- Quantity: ${qty}
- Primary fabric: ${fabric}
- Certifications: ${certs}
- Target delivery: ${tl}
- Ship to: ${dest}
- Preferred incoterms: ${inco}
${extraPara}
${techPackLine}

We're looking to establish a manufacturing partner for this order and can move quickly to samples once we have a quote.

Could you let us know:
1. Whether this fits within your current production schedule and our timeline
2. Your FOB price per unit for the above
3. Sample lead time and any sample charge
4. Minimum order quantity per style and per colour
5. Certifications your factory currently holds

Thank you for your time — I look forward to hearing from you.

${signoff(tone, name, brand)}`;
      return { subject, body };
    }

    const body = `${greeting(tone)}

I'm reaching out from ${brand} — we're putting together a production order and wanted to see if it's something your team might be a good fit for.

Here's what we're looking at:
- Garment: ${garment}
- Production type: ${svc}
- Quantity: ${qty}
- Fabric: ${fabric}
- Certifications: ${certs}
- Timeline: ${tl}
- Shipping to: ${dest}
- Incoterms: ${inco}
${extraPara}
${techPackLine}

If this looks like something you can take on, it'd be great to get a sense of pricing and timelines so we can move things forward — happy to jump on a call too if that's easier.

A few quick questions if you don't mind:
1. Can you fit this into your schedule within our timeline?
2. What would your FOB price be for the above?
3. How long would a sample take, and is there a sample fee?
4. What's your minimum order per style/colour?
5. Which certifications does your factory currently hold?

Thanks a lot — looking forward to hearing from you!

${signoff(tone, name, brand)}`;
    return { subject, body };
  }

  function buildLowMoq(tone, name, brand) {
    const garment = val('lm-garment');
    const qty = val('lm-quantity');
    const growth = val('lm-growth');

    let hasError = false;
    if (!garment) { showError('fg-lm-garment', true); hasError = true; } else { showError('fg-lm-garment', false); }
    if (!qty) { showError('fg-lm-quantity', true); hasError = true; } else { showError('fg-lm-quantity', false); }
    if (hasError) return null;

    const growthLine = growth ? ` ${growth.charAt(0).toUpperCase() + growth.slice(1)}.` : '';

    const subject = `Small Order Inquiry — ${garment} (${qty})`;

    if (tone === 'formal') {
      const body = `${greeting(tone)}

I'm writing on behalf of ${brand} to ask whether your factory would consider an order below your usual minimum quantity.

We're looking at ${garment}, with a planned quantity of ${qty}. I understand this may be smaller than your typical production runs, so I wanted to be upfront about it from the outset rather than raise it later in the conversation.${growthLine}

If this quantity doesn't work for your production line, I'd also be glad to hear whether you offer any alternatives — for example a private-label range, a sampling arrangement, or a referral to a sister factory that handles smaller orders.

Could you let us know whether this is something you'd be able to support, and if so, roughly what pricing and lead time we should expect?

Thank you for considering this, and I look forward to your response.

${signoff(tone, name, brand)}`;
      return { subject, body };
    }

    const body = `${greeting(tone)}

I run ${brand}, and I wanted to reach out about a smaller order than you might usually take on — hope that's okay to ask about directly!

We're looking at ${garment}, and our planned quantity is ${qty}. I know that's likely below what you'd normally produce, so I didn't want to dance around it.${growthLine}

If this size doesn't work for you, no worries at all — but if you have any other options for smaller first orders (private label, sampling, a sister factory that handles smaller runs, anything like that), I'd love to hear about it.

Either way, if you can let me know whether this is workable and roughly what it might cost, that'd be really helpful.

Thanks so much for taking the time to read this!

${signoff(tone, name, brand)}`;
    return { subject, body };
  }

  function buildSample(tone, name, brand) {
