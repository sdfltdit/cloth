  // ---------- Element refs ----------
  const typeCards = document.querySelectorAll('.type-card');
  const toneBtns = document.querySelectorAll('.tone-btn');
  const toneHintEl = document.getElementById('tone-hint');
  const fieldSections = document.querySelectorAll('[data-fields]');
  const resultsEl = document.getElementById('results');
  const emailCardLabel = document.getElementById('email-card-label');

  // ---------- Type / tone switching ----------
  function switchType(type) {
    currentType = type;
    typeCards.forEach((card) => {
      const isActive = card.getAttribute('data-type') === type;
      card.classList.toggle('active', isActive);
      card.setAttribute('aria-checked', String(isActive));
    });
    fieldSections.forEach((section) => {
      section.style.display = section.getAttribute('data-fields') === type ? '' : 'none';
    });
    updateToneHint();
    resultsEl.classList.remove('visible');
  }

  function switchTone(tone) {
    currentTone = tone;
    toneBtns.forEach((btn) => {
      const isActive = btn.getAttribute('data-tone') === tone;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-checked', String(isActive));
    });
    updateToneHint();
  }

  function updateToneHint() {
    toneHintEl.textContent = toneHints[currentType][currentTone];
  }

  typeCards.forEach((card) => {
    card.addEventListener('click', () => switchType(card.getAttribute('data-type')));
  });
  toneBtns.forEach((btn) => {
    btn.addEventListener('click', () => switchTone(btn.getAttribute('data-tone')));
  });

  // ---------- Helpers ----------
  function showError(fieldGroupId, show) {
    const el = document.getElementById(fieldGroupId);
    if (el) el.classList.toggle('has-error', show);
  }

  function val(id) {
    const el = document.getElementById(id);
    return el ? el.value.trim() : '';
  }

  function greeting(tone) {
    return tone === 'formal' ? 'Dear Sir or Madam,' : 'Hi there,';
  }

  function signoff(tone, name, brand) {
    const closing = tone === 'formal' ? 'Best regards,' : 'Thanks so much,';
    return `${closing}\n${name}\n${brand}`;
  }

  // ---------- Tip sets ----------
  const tipSets = {
    inquiry: {
      title: '4 things that improve your response rate',
      tips: [
        ['📎', 'Attach your tech pack or reference images', 'Even rough sketches or a reference photo help. Attachments signal a buyer who\u2019s ready to move to samples.'],
        ['⏰', 'Send during Bangladesh business hours', 'Bangladesh is UTC+6. Emails sent in the morning local time (roughly 9am\u20131pm, Sunday\u2013Thursday) tend to get same-day attention.'],
        ['📱', 'Follow up on WhatsApp after a few days', 'Many Bangladesh factories use WhatsApp for day-to-day business. A short message referencing your email is a normal nudge.'],
        ['🎯', 'Lead with specs, not your brand story', 'Save the "why we started this brand" story for a call. The first email should be actionable on its own.']
      ]
    },
    lowmoq: {
      title: 'Setting this up for a useful reply',
      tips: [
        ['🎯', 'State your quantity honestly', 'Hiding or rounding up your real quantity tends to surface as a mismatch later. Being upfront gets you a faster, more useful answer.'],
        ['📈', 'Mention growth plans if they\u2019re real', 'A genuine plan to reorder at higher volumes can shift a factory\u2019s answer from "no" to "let\u2019s talk" — but only if it\u2019s realistic.'],
        ['🔁', 'Be ready for alternatives', 'A "no" to your exact request sometimes comes with a useful alternative — a private-label catalogue, a sister factory, or a sampling-only arrangement.'],
        ['🤝', 'Multiple factories, multiple chances', 'Send this to several factories. Low-MOQ willingness varies a lot factory to factory, even within the same product category.']
      ]
    },
    sample: {
      title: 'Getting a useful sample, faster',
      tips: [
        ['📐', 'Share measurements if you have them', 'Even approximate body measurements help the factory get closer on the first attempt, saving a revision round.'],
        ['🎨', 'Be specific about colour references', 'A Pantone code or a physical swatch avoids "close enough" colour matching that needs correcting later.'],
        ['💰', 'Ask about sample cost upfront', 'Most factories charge a sample fee, often credited against a future order. It\u2019s a normal question to ask directly.'],
        ['⏱', 'Confirm the sample lead time', 'Knowing the lead time lets you plan your own timeline backwards from a launch date.']
      ]
    },
    samplefeedback: {
      title: 'Making your feedback easy to act on',
      tips: [
        ['📏', 'Be precise about measurements', 'Numbers ("2cm shorter than spec") are easier to action than impressions ("feels a bit short").'],
        ['📸', 'Attach photos where possible', 'A photo next to the spec sheet or approved reference removes ambiguity about what "doesn\u2019t match" means.'],
        ['✅', 'Separate must-fix from nice-to-have', 'If some points matter more than others, say so — it helps the factory prioritise the revision.'],
        ['🔄', 'Confirm what happens after the fix', 'State clearly whether you need to see another sample, or whether you\u2019ll approve based on a description of the fix.']
      ]
    },
    followup: {
      title: 'Before you send this follow-up',
      tips: [
        ['📅', 'Give it enough time first', 'Merchandisers handle production alongside inquiries. Under a week is often too soon — three to five working days is fairer.'],
        ['🔁', 'Don\u2019t resend the whole original email', 'A short nudge referencing your earlier message is easier to act on than a wall of text repeated in full.'],
        ['📱', 'Try WhatsApp alongside email', 'If you have a WhatsApp number for the factory, a brief message referencing your email often gets a faster response.'],
        ['🚪', 'It\u2019s okay to move on after three tries', 'If there\u2019s still silence after a polite third message, that\u2019s useful information — reach out to other suppliers.']
      ]
    },
    negotiation: {
      title: 'Negotiating without burning the relationship',
      tips: [
        ['🎯', 'Anchor your number to something', 'A competing quote, a spec change, or a volume commitment all give the factory a reason to move, rather than just being asked to absorb a loss.'],
        ['🤝', 'Offer something in return', 'A volume commitment, faster payment terms, or simplified packaging can all be currency in a negotiation, not just price.'],
        ['📊', 'Use our cost calculator first', 'Knowing your full landed cost (including freight and duty) helps you negotiate the number that actually matters for your margin.'],
        ['⚖️', 'Keep it a starting point', 'Frame your counter-offer as the start of a conversation unless you genuinely mean it as a final position.']
      ]
    },
    reorder: {
      title: 'Smooth re-orders',
      tips: [
        ['📋', 'Reference the original order or PO', 'Even a rough date or style number helps the factory pull up the right records quickly.'],
        ['💲', 'Ask if pricing still applies', 'Fabric and labour costs can shift between orders — it\u2019s worth confirming pricing rather than assuming it\u2019s unchanged.'],
        ['📦', 'Flag any changes clearly', 'Even small changes (a colour swap, a different trim) are easier to manage if flagged upfront rather than discovered mid-production.'],
        ['📅', 'Confirm the new lead time', 'Lead times can vary by season depending on the factory\u2019s current order book.']
      ]
    },
    quality: {
      title: 'Raising this issue effectively',
      tips: [
        ['📸', 'Attach photos and measurements', 'Specific evidence is much easier for a factory to act on quickly than a general description.'],
        ['📋', 'Reference your PO or order number', 'This lets the factory pull up the relevant production records immediately.'],
        ['🎯', 'State the resolution you want', 'Rework, credit, or an explanation — being specific about what would resolve this for you speeds up the response.'],
        ['🙂', 'Keep it factual, even if you\u2019re frustrated', 'A measured tone tends to get a faster, more cooperative response than an accusatory one — and keeps the relationship workable.']
      ]
    }
  };

  function renderTips(type) {
    const set = tipSets[type];
    document.getElementById('tips-title').textContent = set.title;
    const grid = document.getElementById('tips-grid');
    grid.innerHTML = '';
    set.tips.forEach(([icon, title, text]) => {
      const tip = document.createElement('div');
      tip.className = 'tip';

      const iconEl = document.createElement('div');
      iconEl.className = 'tip-icon';
      iconEl.textContent = icon;

      const titleEl = document.createElement('div');
      titleEl.className = 'tip-title';
      titleEl.textContent = title;

      const textEl = document.createElement('div');
      textEl.className = 'tip-text';
      textEl.textContent = text;

      tip.appendChild(iconEl);
      tip.appendChild(titleEl);
      tip.appendChild(textEl);
      grid.appendChild(tip);
