<script>
let gSubject = '';
let gBody = '';

function generateEmail(){
  const brand  = document.getElementById('brand-name').value.trim() || 'Our Company';
  const name   = document.getElementById('your-name').value.trim() || 'the Sourcing Team';
  const garment= document.getElementById('garment-type').value;
  const svc    = document.getElementById('service-type').value;
  const qty    = document.getElementById('quantity').value;
  const fabric = document.getElementById('fabric').value;
  const certs  = document.getElementById('certifications').value;
  const tl     = document.getElementById('timeline').value;
  const dest   = document.getElementById('destination').value;
  const inco   = document.getElementById('incoterms').value;
  const extra  = document.getElementById('extra-info').value.trim();

  if(!garment){ alert('Please select a garment type.'); return; }

  const hasTechPack = svc.toLowerCase().includes('full tech pack');
  const techPackLine = hasTechPack
    ? 'We have a full tech pack ready to share upon your confirmation of capacity.'
    : svc.toLowerCase().includes('odm')||svc.toLowerCase().includes('private')
      ? 'We do not have a tech pack — we are open to reviewing your existing base styles or ODM catalogue.'
      : 'We can provide full tech pack documentation upon confirmation of production capacity.';

  const extraPara = extra ? `\nAdditional requirements:\n${extra}\n` : '';

  gSubject = `Production Inquiry — ${garment} | ${brand} | ${qty}`;

  gBody = `Dear SDF Clothing Team,

I am writing on behalf of ${brand} to inquire about production capacity for an upcoming order.

Order Specification:
• Garment: ${garment}
• Production type: ${svc}
• Quantity: ${qty}
• Primary fabric: ${fabric}
• Certifications required: ${certs}
• Required delivery: ${tl}
• Ship-to destination: ${dest}
• Preferred incoterms: ${inco}
${extraPara}
${techPackLine}

We are actively sourcing a long-term manufacturing partner and are prepared to move to sample stage promptly on receipt of a satisfactory quote.

Please confirm the following at your earliest convenience:
1. Can you accommodate this order within our required timeline?
2. Your FOB price per unit for the above specification
3. Sample lead time and sample charge (if applicable)
4. Minimum order quantity per style and per colour
5. Any relevant certifications you hold (GOTS, OEKO-TEX, BSCI, ISO)

We look forward to your response.

Best regards,
${name}
${brand}`;

  document.getElementById('email-subject').textContent = gSubject;
  document.getElementById('email-body').textContent = gBody;

  const res = document.getElementById('results');
  res.classList.add('visible');
  res.scrollIntoView({behavior:'smooth',block:'start'});
}

function copyEmail(){
  const full = 'Subject: ' + gSubject + '\n\n' + gBody;
  const btn = document.getElementById('copy-btn');

  const doFallback = () => {
    const ta = document.createElement('textarea');
    ta.value = full; ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0;';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch(e){}
    document.body.removeChild(ta);
    btn.textContent = 'Copied ✓'; btn.classList.add('copied');
    setTimeout(()=>{ btn.textContent='Copy Email'; btn.classList.remove('copied'); }, 2500);
  };

  if(navigator.clipboard){
    navigator.clipboard.writeText(full).then(()=>{
      btn.textContent = 'Copied ✓'; btn.classList.add('copied');
      setTimeout(()=>{ btn.textContent='Copy Email'; btn.classList.remove('copied'); }, 2500);
    }).catch(doFallback);
  } else { doFallback(); }
}
</script>

