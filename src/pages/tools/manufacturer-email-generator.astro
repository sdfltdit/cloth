.crumb-nav a { color:rgba(255,255,255,0.3); text-decoration:none; }
.crumb-nav a:hover { color:#fff; }
.crumb-nav .sep { color:rgba(255,255,255,0.18); }
.crumb-nav .current { color:#fff; }

.tool-hero { margin-bottom: 2rem; margin-top: 2rem; }
.section-label { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: #e00; font-weight: 500; }
.tool-hero h1 { font-size: clamp(1.9rem, 3.5vw, 2.7rem); font-weight: 300; color: #fff; letter-spacing: 0.03em; line-height: 1.2; margin: 0.75rem 0; }
.tool-hero .sub { font-size: 0.9rem; color: rgba(255,255,255,0.6); max-width: 660px; line-height: 1.85; margin-bottom: 1.25rem; }
.trust-row { display: flex; flex-wrap: wrap; gap: 1rem; }
.trust-item { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); display: flex; align-items: center; gap: 0.35rem; }
.trust-item::before { content: '✓'; color: #e00; }

/* Email type selector */
.type-select-wrap { margin: 2rem 0 1.5rem; }
