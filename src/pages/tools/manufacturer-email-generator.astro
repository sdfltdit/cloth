.type-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
@media (max-width: 760px) { .type-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 420px) { .type-grid { grid-template-columns: 1fr; } }
.type-card {
  background: #000; border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.55);
  padding: 0.9rem 0.75rem; font-size: 0.74rem; letter-spacing: 0.04em; text-align: left;
  cursor: pointer; transition: all 0.15s; font-family: inherit; min-height: 64px; border-radius: 2px;
  display: flex; flex-direction: column; gap: 0.2rem; line-height: 1.4;
}
.type-card strong { color: #fff; font-weight: 500; font-size: 0.78rem; display: block; }
.type-card span { color: rgba(255,255,255,0.4); font-size: 0.7rem; }
.type-card:hover { border-color: rgba(255,255,255,0.35); }
.type-card.active { border-color: #e00; background: rgba(238,0,0,0.06); }
