      body = tone === 'formal'
        ? `${greeting(tone)}

I wanted to follow up on the inquiry I sent ${sinceWhen} regarding ${garment} production for ${brand}.

I understand things get busy, so I just wanted to check this hasn't been missed. If it would help, I'm happy to resend the original details or answer any questions that would help with putting together a quote.

Looking forward to hearing from you when you have a moment.

${signoff(tone, name, brand)}`
        : `${greeting(tone)}

Just a quick nudge on the ${garment} inquiry I sent over ${sinceWhen} for ${brand} — totally understand things get busy on your end!

Happy to resend the details or answer anything that'd help put a quote together. No rush, just wanted to make sure it didn't slip through the cracks.

Thanks so much!

${signoff(tone, name, brand)}`;
    } else if (followUpNum === '2') {
      subjectPrefix = 'Checking in again';
      body = tone === 'formal'
        ? `${greeting(tone)}

I'm following up again on the ${garment} inquiry I sent ${sinceWhen} for ${brand} — I haven't yet heard back and wanted to check whether this is something your team is able to take on.

We're moving forward with planning this order and would value the chance to work with your factory if the timeline and specification are a good fit. If now isn't a good time, even a short note to that effect would be genuinely helpful so we can plan accordingly.

Thank you, and I hope to hear from you soon.

${signoff(tone, name, brand)}`
        : `${greeting(tone)}

Checking in again on the ${garment} inquiry from ${sinceWhen} for ${brand} — still haven't heard anything, and just wanted to see if this is on your radar.

We're keen to get this moving and would really like to work with you if the timing and specs line up. If it's just not the right fit at the moment, even a quick "not right now" would help us plan around it.

Thanks again, hope to hear from you soon!

${signoff(tone, name, brand)}`;
    } else {
      subjectPrefix = 'Final follow-up';
      body = tone === 'formal'
        ? `${greeting(tone)}

This is a final follow-up on the ${garment} inquiry I sent ${sinceWhen} for ${brand}.

As we haven't been able to connect, we'll proceed with other manufacturing partners for this order. If your availability changes or you'd like to discuss future opportunities, please feel free to reach out — we'd be glad to consider your factory for upcoming seasons.

Thank you for your time.

${signoff(tone, name, brand)}`
        : `${greeting(tone)}

Just a final note on the ${garment} inquiry from ${sinceWhen} for ${brand} — since we haven't managed to connect, we'll go ahead with other suppliers for this order.

If things free up on your end, we'd genuinely love to stay in touch for future seasons — no hard feelings at all, just timing!

Thanks for your time.

${signoff(tone, name, brand)}`;
    }

    const subject = `${subjectPrefix}: ${garment} Production Inquiry — ${brand}`;
    return { subject, body };
  }

  function buildNegotiation(tone, name, brand) {
    const garment = val('ng-garment');
    const quoted = val('ng-quoted');
    const target = val('ng-target');
    const reason = val('ng-reason');
    const volume = val('ng-volume');

    let hasError = false;
    if (!garment) { showError('fg-ng-garment', true); hasError = true; } else { showError('fg-ng-garment', false); }
    if (!quoted) { showError('fg-ng-quoted', true); hasError = true; } else { showError('fg-ng-quoted', false); }
    if (!target) { showError('fg-ng-target', true); hasError = true; } else { showError('fg-ng-target', false); }
    if (hasError) return null;

    const volumeLine = volume
      ? ` To support this, we'd be glad to discuss ${volume} as part of the arrangement.`
      : '';

    const subject = `Quote Discussion — ${garment} Pricing`;

    if (tone === 'formal') {
      const body = `${greeting(tone)}

Thank you for sending through the quote for ${garment} at ${quoted} — we appreciate the detail provided.

Having reviewed it against our budget, ${reason}. We were hoping to find a way to bring the price closer to ${target} per unit.${volumeLine}

We'd value the opportunity to continue working with you on this, and would welcome the chance to discuss whether there's a way to bridge this gap — whether through pricing, a small adjustment to the specification, or another approach you'd suggest.

Please let us know your thoughts, and thank you again for your work on this quote.

${signoff(tone, name, brand)}`;
      return { subject, body };
    }

    const body = `${greeting(tone)}

Thanks for putting together the quote for ${garment} at ${quoted} — really appreciate the detail.

Looking at our numbers, ${reason}. We were hoping we might be able to get closer to ${target} per unit if there's any flexibility.${volumeLine}

We'd love to keep working with you on this if we can find a way to make the numbers work — whether that's on price, a small tweak to the spec, or something else you might suggest.

Let us know what you think, and thanks again for putting this together!

${signoff(tone, name, brand)}`;
    return { subject, body };
  }

  function buildReorder(tone, name, brand) {
    const garment = val('ro-garment');
    const qty = val('ro-quantity');
    const changes = val('ro-changes');
    const tl = val('ro-timeline');
    const extra = val('ro-extra');

    let hasError = false;
    if (!garment) { showError('fg-ro-garment', true); hasError = true; } else { showError('fg-ro-garment', false); }
    if (!qty) { showError('fg-ro-quantity', true); hasError = true; } else { showError('fg-ro-quantity', false); }
    if (hasError) return null;

    const extraPara = extra ? `\n${extra}\n` : '';
    const subject = `Re-Order — ${garment}`;

    if (tone === 'formal') {
      const body = `${greeting(tone)}

We'd like to place a re-order for ${garment}, which we previously produced with your team.

Quantity for this order: ${qty}.
Changes from the previous order: ${changes}.
Required delivery: ${tl}.
${extraPara}
Could you confirm whether current pricing and lead times remain the same as our previous order, or let us know of any changes? Please also confirm the next steps to move this forward.

Thank you, and we look forward to working with you again on this.

${signoff(tone, name, brand)}`;
      return { subject, body };
    }

    const body = `${greeting(tone)}

Hope you're doing well! We'd like to go ahead with a re-order for ${garment} — same as the run we did with you before.

Quantity this time: ${qty}.
Anything different from last time: ${changes}.
Delivery needed by: ${tl}.
${extraPara}
Could you confirm if pricing and lead times are still the same as before, or let us know if anything's changed? Happy to move ahead quickly once we've got that confirmed.

Thanks again — looking forward to working together on this one!

${signoff(tone, name, brand)}`;
    return { subject, body };
  }

  function buildQuality(tone, name, brand) {
    const ref = val('qi-ref');
    const issueType = val('qi-type');
    const detail = val('qi-detail');
    const resolution = val('qi-resolution');

    let hasError = false;
    if (!ref) { showError('fg-qi-ref', true); hasError = true; } else { showError('fg-qi-ref', false); }
    if (!issueType) { showError('fg-qi-type', true); hasError = true; } else { showError('fg-qi-type', false); }
    if (!detail) { showError('fg-qi-detail', true); hasError = true; } else { showError('fg-qi-detail', false); }
    if (hasError) return null;

    const subject = `Quality Issue — Order ${ref}`;

    if (tone === 'formal') {
      const body = `${greeting(tone)}

I'm writing regarding order ${ref}, where we've identified an issue that we'd like to bring to your attention.

The issue: ${issueType}.

Additional detail: ${detail}

To resolve this, we would propose ${resolution}.

We value our work together and would like to find a resolution that works for both sides. Please let us know your thoughts, and if it would help, we're happy to share further documentation or discuss this by call.

Thank you for looking into this.

${signoff(tone, name, brand)}`;
      return { subject, body };
    }

    const body = `${greeting(tone)}

Hope you're well — wanted to flag something about order ${ref} that we've come across.

The issue: ${issueType}.

A bit more detail: ${detail}

For a resolution, we were thinking ${resolution} would work well — but happy to talk through other options too.

We really value working with you and just want to get this sorted together. Let us know if more photos or details would help, or if a quick call makes sense.

Thanks for looking into this!

${signoff(tone, name, brand)}`;
    return { subject, body };
  }

  // ---------- Generate ----------
  const builders = {
    inquiry: buildInquiry,
    lowmoq: buildLowMoq,
    sample: buildSample,
    samplefeedback: buildSampleFeedback,
    followup: buildFollowup,
    negotiation: buildNegotiation,
    reorder: buildReorder,
    quality: buildQuality
  };

  document.getElementById('generate-btn').addEventListener('click', () => {
    const name = val('your-name') || NAME_FALLBACK;
    const brand = val('brand-name') || BRAND_FALLBACK;

    const result = builders[currentType](currentTone, name, brand);
    if (!result) return;

    currentSubject = result.subject;
    currentBody = result.body;

    document.getElementById('email-subject').textContent = currentSubject;
    document.getElementById('email-body').textContent = currentBody;

    const labels = {
      inquiry: 'Factory Inquiry Email — Ready to Send',
      lowmoq: 'Small Order Inquiry — Ready to Send',
      sample: 'Sample Request Email — Ready to Send',
      samplefeedback: 'Sample Feedback Email — Ready to Send',
      followup: 'Follow-Up Email — Ready to Send',
      negotiation: 'Price Negotiation Email — Ready to Send',
      reorder: 'Re-Order Email — Ready to Send',
      quality: 'Quality Issue Email — Ready to Send'
    };
    emailCardLabel.textContent = labels[currentType];

    renderTips(currentType);

    resultsEl.classList.add('visible');
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---------- Copy ----------
  document.getElementById('copy-btn').addEventListener('click', () => {
    const full = 'Subject: ' + currentSubject + '\n\n' + currentBody;
    const btn = document.getElementById('copy-btn');

    const showCopied = () => {
      btn.textContent = 'Copied ✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copy Email';
        btn.classList.remove('copied');
      }, 2500);
    };

    const fallbackCopy = () => {
      const ta = document.createElement('textarea');
      ta.value = full;
      ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0;';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
      } catch (err) {
        // Clipboard unavailable; user can select text manually.
      }
      document.body.removeChild(ta);
      showCopied();
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(full).then(showCopied).catch(fallbackCopy);
    } else {
      fallbackCopy();
    }
  });
</script>

</BaseLayout>
