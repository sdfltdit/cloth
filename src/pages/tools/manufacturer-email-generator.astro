        <option value="jackets and outerwear">Jackets / Outerwear</option>
        <option value="pants and trousers">Pants / Trousers</option>
        <option value="shorts">Shorts</option>
        <option value="dresses and skirts">Dresses / Skirts</option>
        <option value="activewear and sportswear">Activewear / Sportswear</option>
        <option value="denim jeans">Denim Jeans</option>
        <option value="swimwear">Swimwear</option>
        <option value="a full collection (multiple styles)">Full Collection</option>
      </select>
    </div>
    <div class="field-group">
      <label for="service-type">Service Required</label>
      <select id="service-type" aria-label="Select production service type">
        <option value="OEM manufacturing (full tech pack provided)">OEM — I have tech packs</option>
        <option value="ODM manufacturing (design assistance needed)">ODM — Need design help</option>
        <option value="private label manufacturing">Private Label</option>
        <option value="CMT (Cut, Make, Trim) — buyer supplies fabric">CMT — I supply fabric</option>
      </select>
    </div>
    <div class="field-group">
      <label for="quantity">Order Quantity</label>
      <select id="quantity" aria-label="Select order quantity">
        <option value="300–500 pieces per style">300–500 pieces per style</option>
        <option value="500–1,000 pieces per style">500–1,000 pieces per style</option>
        <option value="1,000–3,000 pieces per style">1,000–3,000 pieces per style</option>
        <option value="3,000–10,000 pieces per style">3,000–10,000 pieces per style</option>
        <option value="10,000+ pieces per style">10,000+ pieces per style</option>
      </select>
    </div>
    <div class="field-group">
      <label for="fabric">Primary Fabric</label>
      <select id="fabric" aria-label="Select primary fabric">
        <option value="100% cotton">100% Cotton</option>
        <option value="organic cotton (GOTS preferred)">Organic Cotton (GOTS)</option>
        <option value="100% polyester">100% Polyester</option>
        <option value="poly-cotton blend">Poly-Cotton Blend</option>
        <option value="fleece / French terry">Fleece / French Terry</option>
        <option value="denim">Denim</option>
        <option value="recycled fabric (GRS certified preferred)">Recycled Fabric (GRS)</option>
        <option value="nylon / ripstop">Nylon / Ripstop</option>
      </select>
    </div>
    <div class="field-group">
      <label for="certifications">Certifications Required</label>
      <select id="certifications" aria-label="Select certification requirements">
        <option value="no specific certifications required at this stage">None at this stage</option>
        <option value="GOTS certification (organic textiles)">GOTS (organic)</option>
        <option value="OEKO-TEX Standard 100">OEKO-TEX Standard 100</option>
        <option value="BSCI or equivalent social compliance audit">BSCI / Social Audit</option>
