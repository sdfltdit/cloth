/* Tone toggle */
.tone-wrap { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0; flex-wrap: wrap; }
.tone-label { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
.tone-toggle { display: flex; border: 1px solid rgba(255,255,255,0.12); border-radius: 2px; overflow: hidden; }
