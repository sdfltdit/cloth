      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/tools" itemprop="item"><span itemprop="name">Free Tools</span></a>
        <meta itemprop="position" content="2" />
      </li>
      <li class="sep">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="current" itemprop="name">Manufacturer Email Generator</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </nav>

  <div class="tool-hero">
    <span class="section-label">Free Tool · 8 Email Types · No Signup</span>
    <h1>Clothing Manufacturer Email Generator</h1>
    <p class="sub">Working with a clothing factory means writing a different kind of email at almost every stage — the first inquiry, a nudge when they go quiet, a sample request, a counter-offer on price, or a complaint when something arrives wrong. Pick the situation you're in, choose a formal or friendly tone, fill in a few details, and get an email that's ready to send.</p>
    <div class="trust-row">
      <span class="trust-item">8 situations covered</span>
      <span class="trust-item">Formal or friendly tone</span>
      <span class="trust-item">One-click copy</span>
      <span class="trust-item">No signup</span>
    </div>
  </div>

  <!-- EMAIL TYPE SELECTOR -->
  <div class="type-select-wrap">
    <div class="type-select-label">Step 1 — What's the situation?</div>
    <div class="type-grid" role="radiogroup" aria-label="Email type">
      <button class="type-card active" data-type="inquiry" role="radio" aria-checked="true">
        <strong>First Inquiry</strong>
        <span>Contacting a factory for the first time</span>
      </button>
      <button class="type-card" data-type="lowmoq" role="radio" aria-checked="false">
        <strong>Small Order / Low MOQ</strong>
        <span>Your quantity is below their usual minimum</span>
      </button>
      <button class="type-card" data-type="sample" role="radio" aria-checked="false">
        <strong>Sample Request</strong>
        <span>Ask for a sample before committing to bulk</span>
      </button>
      <button class="type-card" data-type="samplefeedback" role="radio" aria-checked="false">
        <strong>Sample Feedback</strong>
        <span>Request changes after reviewing a sample</span>
      </button>
      <button class="type-card" data-type="followup" role="radio" aria-checked="false">
        <strong>Follow-Up</strong>
        <span>No response yet — gentle to final nudge</span>
      </button>
      <button class="type-card" data-type="negotiation" role="radio" aria-checked="false">
        <strong>Price Negotiation</strong>
        <span>Counter-offer after receiving a quote</span>
      </button>
      <button class="type-card" data-type="reorder" role="radio" aria-checked="false">
        <strong>Re-Order</strong>
        <span>Repeat an order with an existing supplier</span>
      </button>
      <button class="type-card" data-type="quality" role="radio" aria-checked="false">
        <strong>Quality Issue</strong>
        <span>Raise a problem with a completed order</span>
      </button>
    </div>
  </div>

  <!-- TONE TOGGLE -->
  <div class="tone-wrap">
    <span class="tone-label">Step 2 — Tone</span>
    <div class="tone-toggle" role="radiogroup" aria-label="Email tone">
      <button class="tone-btn active" data-tone="formal" role="radio" aria-checked="true">Formal</button>
      <button class="tone-btn" data-tone="friendly" role="radio" aria-checked="false">Friendly</button>
    </div>
    <span class="tone-hint" id="tone-hint">Formal — best for a first contact with a factory you don't know yet.</span>
  </div>

  <!-- SHARED FIELDS (always visible) -->
  <div class="fields-section">
    <div class="fields-section-title">Your Details</div>
    <div class="form-grid">
      <div class="field-group">
        <label for="your-name">Your Name &amp; Title</label>
        <input type="text" id="your-name" placeholder="e.g. Sarah Mitchell, Head of Sourcing" aria-label="Enter your name and title" />
      </div>
      <div class="field-group">
        <label for="brand-name">Your Brand / Company Name</label>
        <input type="text" id="brand-name" placeholder="e.g. Apex Apparel Co." aria-label="Enter your brand or company name" />
      </div>
    </div>
  </div>

  <!-- TYPE-SPECIFIC FIELDS -->

  <!-- INQUIRY -->
  <div class="fields-section" data-fields="inquiry">
    <div class="fields-section-title">Order Details</div>
    <div class="form-grid">
      <div class="field-group" id="fg-garment-type">
        <label for="garment-type">Garment Type</label>
        <select id="garment-type" aria-label="Select garment type">
          <option value="">Select garment type…</option>
          <option value="T-Shirts">T-Shirts</option>
          <option value="Polo Shirts">Polo Shirts</option>
          <option value="Hoodies / Sweatshirts">Hoodies / Sweatshirts</option>
          <option value="Jackets / Outerwear">Jackets / Outerwear</option>
          <option value="Pants / Trousers">Pants / Trousers</option>
          <option value="Shorts">Shorts</option>
          <option value="Dresses / Skirts">Dresses / Skirts</option>
          <option value="Activewear / Sportswear">Activewear / Sportswear</option>
          <option value="Denim Jeans">Denim Jeans</option>
          <option value="Swimwear">Swimwear</option>
          <option value="a full collection across multiple styles">Full Collection (multiple styles)</option>
        </select>
        <span class="field-error">Please select a garment type.</span>
      </div>
      <div class="field-group">
        <label for="service-type">Service Required</label>
        <select id="service-type" aria-label="Select production service type">
          <option value="OEM — we have a complete tech pack ready to share">OEM — I have tech packs</option>
          <option value="ODM — we'd like to work from your existing patterns or base styles">ODM — Need design help</option>
          <option value="Private Label — we'd like to brand existing finished products">Private Label</option>
          <option value="CMT (Cut, Make, Trim) — we will supply the fabric">CMT — I supply fabric</option>
        </select>
      </div>
      <div class="field-group" id="fg-quantity">
        <label for="quantity">Order Quantity</label>
        <select id="quantity" aria-label="Select order quantity">
