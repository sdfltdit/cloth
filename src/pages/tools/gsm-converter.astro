  .measure-steps li::before {
    content: counter(steps);
    background-color: #e00;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .faq-container {
