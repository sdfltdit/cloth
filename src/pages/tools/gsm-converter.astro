  }

  .form-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.8rem;
    font-size: 1rem;
    font-family: inherit;
    background-color: #000;
    color: #fff;
    border: 1px solid #e00;
    min-height: 48px;
    cursor: pointer;
    touch-action: manipulation;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: #e00;
  }

  .form-helper {
    font-size: 0.75rem;
    color: #fff;
    margin-top: 0.5rem;
  }

  .calc-card {
    background-color: #000;
    border: 1px solid #e00;
    padding: 2rem;
    max-width: 600px;
  }

  .result-box {
    display: none;
    padding: 1.5rem;
    border: 1px solid #e00;
    background-color: #000;
  }

  .result-box--with-margin {
    margin-top: 1.5rem;
    max-width: 600px;
  }

  .result-box--visible {
    display: block;
  }

  .result-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .result-value {
    font-size: 2rem;
