    margin-bottom: 0.25rem;
  }

  .measure-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: steps;
  }

  .measure-steps li {
    counter-increment: steps;
    display: flex;
    gap: 1rem;
