    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 200;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .page-intro {
    font-size: 1rem;
    color: #ccc;
    max-width: 700px;
    line-height: 1.7;
    margin: 0 auto 2rem auto;
  }

  .page-subtitle {
    font-size: 0.95rem;
    color: #fff;
    max-width: 600px;
    line-height: 1.2;
    margin: 0 auto 0 auto;
  }

  .hero-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 0;
    margin: 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.5rem;
    margin-top: 1.5rem;
  }

  .section-title--center {
    text-align: center;
  }

  .section-intro {
    font-size: 0.95rem;
    color: #ccc;
    max-width: 800px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .converter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
