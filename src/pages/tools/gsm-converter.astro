---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Fabric GSM Converter — Convert GSM to oz/yd² Free | SDF Clothing";
const pageDescription = "Convert fabric GSM to oz/yd² instantly. Free tool with fabric weight classifier, shrinkage calculator, and GSM reference chart for textile professionals.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Fabric GSM Converter",
  "description": "Free fabric GSM converter with weight classification, shrinkage calculation, roll weight calculator, and fabric type reference table for textile professionals.",
  "url": "https://sdfltd.com/tools/gsm-converter",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "featureList": [
    "GSM to oz/yd² conversion",
    "oz/yd² to GSM conversion",
    "Fabric weight classification",
    "Roll weight calculator",
    "Shrinkage adjusted GSM calculator",
    "Fabric type GSM reference table"
  ],
  "provider": { "@type": "Organization", "name": "SDF Clothing", "url": "https://sdfltd.com" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://sdfltd.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tools",
      "item": "https://sdfltd.com/tools"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Fabric GSM Converter"
    }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is GSM in fabric?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GSM stands for Grams per Square Meter. It measures the weight of fabric and indicates its thickness and density. Higher GSM means heavier, thicker fabric, while lower GSM indicates lighter, thinner material. GSM is the standard unit used globally in textile manufacturing."
      }
    },
    {
      "@type": "Question",
      "name": "How do I convert GSM to oz/yd²?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To convert GSM to ounces per square yard, multiply the GSM value by 0.0294935. For example, 200 GSM × 0.0294935 = 5.9 oz/yd². To convert oz/yd² back to GSM, multiply by 33.9057."
      }
    },
    {
      "@type": "Question",
      "name": "What is considered lightweight fabric?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lightweight fabric typically ranges from 80 to 150 GSM. This includes fabrics like poplin, voile, and lawn. Ultra lightweight fabrics are under 80 GSM (chiffon, georgette), while medium weight fabrics range from 150–250 GSM (twill, oxford)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I measure fabric GSM at home?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cut a 10cm × 10cm square of fabric. Weigh it in grams on a kitchen scale. Multiply that weight by 100 to get GSM. For example, if the piece weighs 2.2g, the fabric is 220 GSM. For better accuracy, use a 30cm × 30cm piece and divide the weight by 0.09."
      }
    },
    {
      "@type": "Question",
      "name": "Why does fabric GSM change after washing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fabric shrinkage during washing causes fibers to compress, increasing fabric density. This results in a higher GSM measurement after washing. The shrinkage calculator on this page helps you determine the post-wash GSM based on expected shrinkage percentage."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate fabric roll weight?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roll weight (kg) = (GSM × Width in inches × Length in meters × 0.0254) ÷ 1000. This formula accounts for converting inches to meters and grams to kilograms. The roll weight calculator on this page automates this calculation."
      }
    },
    {
      "@type": "Question",
      "name": "What GSM is best for t-shirts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard t-shirts use 120–180 GSM fabric. Lightweight summer t-shirts are 120–140 GSM. Mid-weight everyday tees are 150–180 GSM. Premium heavyweight t-shirts use 180–220 GSM. Single jersey knit at 140–180 GSM is the most common choice for comfort and durability."
      }
    },
    {
      "@type": "Question",
      "name": "What is the GSM of denim fabric?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Denim GSM ranges from 200–450 depending on weight. Lightweight denim is 200–300 GSM (summer jeans), medium weight is 300–380 GSM (standard jeans), and heavyweight denim is 380–450 GSM (workwear, vintage styles)."
      }
    },
    {
      "@type": "Question",
      "name": "How accurate is GSM measurement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GSM measurement accuracy depends on sampling method and equipment. Standard industry tolerance is ±5%. For accurate results, cut multiple samples from different areas of the fabric, measure with a calibrated GSM cutter and precision scale, and calculate the average."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use GSM for both woven and knit fabrics?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, GSM is used for both woven and knit fabrics. However, typical GSM ranges differ. Knit fabrics generally have lower GSM (120–280 for common knits) compared to woven fabrics of similar thickness due to their stretch and construction."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between GSM and fabric thickness?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GSM measures weight per area, while thickness measures physical depth. Two fabrics can have the same GSM but different thicknesses due to fiber density. A tightly woven fabric may be thinner but the same GSM as a loftier knit. GSM is more commonly used in textile specifications."
      }
    }
  ]
}
</script>

<style>
  .gsm-page {
    background-color: #000;
    color: #fff;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.7;
    min-height: auto;
    padding: 0;
    margin: 0;
  }

  .gsm-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gsm-section {
    padding: 4rem 0;
    border-bottom: 1px solid #e00;
  }

  .gsm-section--no-border {
    border-bottom: none;
  }

  .gsm-section--no-top-padding {
    padding-top: 0;
  }

