  .faq-question:hover {
    color: #fff;
  }

  .faq-icon {
    flex-shrink: 0;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.2s;
    color: #e00;
  }

  .faq-icon--open {
    transform: rotate(45deg);
