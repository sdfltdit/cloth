  .breadcrumb {
    font-size: 0.75rem;
    color: #666;
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: #888;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #fff;
  }

  .breadcrumb span {
    margin: 0 0.4rem;
