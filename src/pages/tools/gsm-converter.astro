  }

  .gsm-table {
    min-width: 600px;
  }

  .gsm-table {
    width: 100%;
    border-collapse: collapse;
    background-color: #000;
    border: 1px solid #e00;
  }

  .gsm-table th {
    border: 1px solid #e00;
    padding: 1rem;
    text-align: left;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background-color: #000;
  }

  .gsm-table td {
    border: 1px solid #e00;
    padding: 1rem;
    color: #fff;
  }

  .content-block {
    max-width: 800px;
    margin-bottom: 2.5rem;
  }

  .content-block p {
    font-size: 0.95rem;
    color: #ccc;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .garment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background-color: #e00;
    border: 1px solid #e00;
    margin-bottom: 1.5rem;
  }

  .garment-card {
    background-color: #000;
    padding: 1.5rem;
  }

  .garment-card h3 {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
