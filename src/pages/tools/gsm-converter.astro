  .faq-answer {
    display: none;
    padding-bottom: 1.5rem;
  }

  .faq-answer--visible {
    display: block;
  }

  .faq-answer p {
    font-size: 0.95rem;
    color: #ccc;
    line-height: 1.8;
  }

  .cta-section {
    text-align: center;
  }

  .cta-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 1rem;
  }

  .cta-text {
    color: #ccc;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .cta-button {
    display: inline-block;
    background-color: #e00;
    color: #fff;
    padding: 1rem 2.5rem;
    text-decoration: none;
    font-size: 0.85rem;
