---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Lead Time Calculator | Bangladesh Clothing Manufacturing";
const pageDescription = "Free lead time calculator for clothing manufacturing from Bangladesh. Get accurate delivery dates for sea and air freight to EU, UK, USA, and Australia.";

const toolFaqs = [
  {
    question: "How accurate is this lead time calculator?",
    answer: "Estimates are based on typical Bangladesh factory timelines and are accurate within ±3–5 days for most orders. Actual dates depend on fabric availability, customs clearance, and public holidays in Bangladesh."
  },
  {
    question: "Does the lead time include sampling?",
    answer: "Yes. The calculator includes proto/fit sampling and approval time before bulk production starts. If you already have an approved sample, production can start sooner than shown."
  },
  {
    question: "Why is air freight so much more expensive than sea freight?",
    answer: "Air freight typically costs 3–5 times more than sea freight, but cuts transit time by 20–30 days. It's usually only worth it for urgent reorders or small top-up shipments, not full bulk orders."
  },
  {
    question: "Can rush production shorten these timelines?",
    answer: "Some factories, including SDF, offer rush production for urgent orders at a premium, which can shorten the bulk production window shown here. Contact us directly to check rush availability for your order."
  },
  {
    question: "Does order quantity affect the lead time shown?",
    answer: "Yes. Larger orders (5,000+ pieces) add production days because they run across more cutting and sewing lines. The calculator adjusts the production estimate automatically based on the quantity you select."
  }
];
const toolFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": toolFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Clothing Manufacturing Lead Time Calculator",
  "description": "Calculate clothing manufacturing lead times from Bangladesh to EU, UK, USA, Australia. Sea vs air freight comparison.",
  "url": "https://sdfltd.com/lead-time-calculator",
  "applicationCategory": "BusinessApplication",
  "provider": { "@id": "https://sdfltd.com/#org" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>
<script type="application/ld+json" set:html={JSON.stringify(toolFaqSchema)} />

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Free Tool · Instant Results</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Clothing Manufacturing<br>Lead Time Calculator</h1>
    <p style="color:#ffffff;max-width:520px;line-height:1.8;font-size:0.92rem;">Calculate exact delivery dates for your clothing order from Bangladesh. Compare sea freight vs air freight to EU, UK, USA, and Australia.</p>
  </div>
</section>

<!-- CALCULATOR -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;background:#000000;">

      <!-- LEFT: Inputs -->
      <div style="background:#000;padding:3rem;">
        <h2 style="font-size:0.9rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:2rem;">Order Details</h2>

        <div style="margin-bottom:1.25rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#ffffff;display:block;margin-bottom:0.4rem;">Order Quantity</label>
          <select id="lt-qty" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
            <option value="300">300 pieces (MOQ)</option>
            <option value="500" selected>500 pieces</option>
            <option value="1000">1,000 pieces</option>
            <option value="3000">3,000 pieces</option>
            <option value="5000">5,000 pieces</option>
            <option value="10000">10,000+ pieces</option>
          </select>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#ffffff;display:block;margin-bottom:0.4rem;">Garment Complexity</label>
          <select id="lt-complex" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
            <option value="simple">Simple  basic t-shirts, no special details</option>
            <option value="medium" selected>Medium  standard garments, some customization</option>
            <option value="complex">Complex  detailed designs, multiple processes</option>
          </select>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#ffffff;display:block;margin-bottom:0.4rem;">Shipping Destination</label>
          <select id="lt-dest" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
            <option value="europe">European Union</option>
            <option value="uk">United Kingdom</option>
            <option value="usa" selected>United States</option>
            <option value="australia">Australia</option>
            <option value="other">Other / Rest of World</option>
          </select>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#ffffff;display:block;margin-bottom:0.75rem;">Shipping Method</label>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:#000000;">
            <label id="lbl-sea" style="background:#000;padding:0.85rem;text-align:center;cursor:pointer;font-size:0.78rem;color:#fff;transition:background 0.2s;border:1px solid #e00;">
              <input type="radio" name="lt-ship" value="sea" checked style="display:none;" /> Sea
            </label>
            <label id="lbl-air" style="background:#000;padding:0.85rem;text-align:center;cursor:pointer;font-size:0.78rem;color:#FFFFFF;transition:background 0.2s;">
              <input type="radio" name="lt-ship" value="air" style="display:none;" /> Air
            </label>
            <label id="lbl-both" style="background:#000;padding:0.85rem;text-align:center;cursor:pointer;font-size:0.78rem;color:#FFFFFF;transition:background 0.2s;">
              <input type="radio" name="lt-ship" value="both" style="display:none;" /> Compare
            </label>
          </div>
        </div>

        <div style="margin-bottom:2rem;">
          <label for="lt-date" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#ffffff;display:block;margin-bottom:0.4rem;">Order Start Date</label>
          <input type="date" id="lt-date" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;color-scheme:dark;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
        </div>

        <button id="lt-calc" style="background:#e00;color:#fff;border:none;padding:0.9rem 2rem;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;transition:background 0.2s;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#e00'">
          Calculate Delivery Date
        </button>
      </div>

      <!-- RIGHT: Results -->
      <div style="background:#000;;padding:3rem;">
        <h2 style="font-size:0.9rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:2rem;">Delivery Timeline</h2>

        <!-- Default state -->
        <div id="lt-default" style="display:flex;flex-direction:column;gap:1px;background:#000000;">
          {[
            ["Sampling","7–21 days","Proto, fit & pre-production samples"],
            ["Bulk Production","30–45 days","Quality checks at every stage"],
            ["QC & Packing","3–5 days","AQL 2.5 inspection + packaging"],
            ["Sea Freight","20–35 days","FOB Chittagong to destination"],
            ["Air Freight","5–10 days","Express DHL / FedEx option"],
          ].map(([phase, days, note]) => (
            <div style="background:#000;padding:1rem 1.25rem;display:grid;grid-template-columns:1fr auto;gap:0.5rem;align-items:start;">
              <div>
                <div style="font-size:0.82rem;color:#fff;margin-bottom:0.2rem;">{phase}</div>
                <div style="font-size:0.72rem;color:#ffffff;">{note}</div>
              </div>
              <div style="font-size:0.82rem;color:#e00;white-space:nowrap;">{days}</div>
            </div>
          ))}
        </div>

        <!-- Result state (hidden until calculated) -->
        <div id="lt-result" style="display:none;"></div>

        <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #e00;">
          <a href="https://wa.me/8801819172080?text=Hi%20SDF%20Clothing%2C%20I%20need%20exact%20lead%20time%20for%20my%20order" target="_blank" rel="noopener noreferrer" class="whatsapp-cta" style="display:flex;justify-content:center;align-items:center;gap:0.5rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;width:100%;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Get Exact Timeline on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- HOW TO USE THIS TOOL (static, server-rendered) -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <h2 style="font-size:1.4rem;font-weight:400;color:#fff;margin-bottom:1.5rem;">How to Use This Tool</h2>
    <ol style="color:#ffffff;line-height:1.9;font-size:0.9rem;max-width:700px;padding-left:1.2rem;">
      <li style="margin-bottom:0.6rem;">Select your order quantity — the calculator adjusts production days for larger runs automatically.</li>
      <li style="margin-bottom:0.6rem;">Choose garment complexity. Simple basics (t-shirts) sample faster than detailed, multi-process garments.</li>
      <li style="margin-bottom:0.6rem;">Pick your shipping destination and method — sea freight is cheaper, air freight is faster.</li>
      <li style="margin-bottom:0.6rem;">Set your order start date and click "Calculate Delivery Date" to see sampling, production, QC, and shipping milestones.</li>
    </ol>
    <p style="color:#ffffff;line-height:1.8;font-size:0.9rem;max-width:700px;margin-top:1rem;">This tool models SDF Clothing's actual production stages — sampling and approval, bulk production with inline quality control, AQL 2.5 final inspection, then sea or air freight — so the dates reflect a realistic factory timeline rather than a generic estimate.</p>
  </div>
</section>

<!-- FAQ (static, server-rendered) -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <h2 style="font-size:1.4rem;font-weight:400;color:#fff;margin-bottom:1.5rem;">Lead Time FAQ</h2>
    <div style="display:flex;flex-direction:column;gap:1px;background:#000000;max-width:800px;">
      {toolFaqs.map(faq => (
        <div style="background:#000;padding:1.25rem;">
          <div style="font-size:0.9rem;color:#fff;margin-bottom:0.4rem;font-weight:500;">{faq.question}</div>
          <div style="font-size:0.85rem;color:#ffffff;line-height:1.7;">{faq.answer}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- INTERNAL LINKS -->
<section style="padding:3rem 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <a href="/tools/eu-readiness-checker" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.4rem;">Tool</div>
        <div style="font-size:0.85rem;color:#fff;">EU Readiness Checker</div>
      </a>
      <a href="/guides/clothing-manufacturing-lead-time" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.4rem;">Guide</div>
        <div style="font-size:0.85rem;color:#fff;">Lead Time Guide</div>
      </a>
      <a href="/contact/" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.4rem;">Quote</div>
        <div style="font-size:0.85rem;color:#fff;">Request Free Quote</div>
      </a>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  // Set today as default date
  document.getElementById('lt-date').value = new Date().toISOString().split('T')[0];

  // Radio label styling
  document.querySelectorAll('input[name="lt-ship"]').forEach(function(r){
    r.addEventListener('change', function(){
      ['sea','air','both'].forEach(v=>{
        const lbl = document.getElementById('lbl-'+v);
        if(lbl){ lbl.style.border='none'; lbl.style.borderColor='transparent'; lbl.style.color='#888'; }
      });
      const active = document.getElementById('lbl-'+this.value);
      if(active){ active.style.border='1px solid #e00'; active.style.color='#fff'; }
    });
  });

  const transit = {
    europe:{sea:28,air:7}, uk:{sea:30,air:7}, usa:{sea:25,air:6}, australia:{sea:30,air:8}, other:{sea:35,air:10}
  };

  function addDays(d,n){ const r=new Date(d); r.setDate(r.getDate()+n); return r; }
  function fmt(d){ return d.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',year:'numeric'}); }

  function row(label, days, date, note, accent){
    return `<div style="background:#000;padding:1rem 1.25rem;border-bottom:1px solid #0d0d0d;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem;">
        <span style="font-size:0.82rem;color:#fff;">${label}</span>
        <span style="font-size:0.82rem;color:${accent||'#e00'};">${days} days</span>
      </div>
      <div style="font-size:0.72rem;color:#ffffff;">Complete by ${fmt(date)}</div>
      ${note?`<div style="font-size:0.72rem;color:#ffffff;margin-top:0.2rem;">${note}</div>`:''}
    </div>`;
  }

  function deliveryBox(title, date, days, note, color){
    return `<div style="border:1px solid ${color};padding:1.25rem;margin-bottom:1px;">
      <div style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:${color};margin-bottom:0.4rem;">${title}</div>
      <div style="font-size:1.2rem;font-weight:300;color:#fff;margin-bottom:0.25rem;">${fmt(date)}</div>
      <div style="font-size:0.72rem;color:#ffffff;">Transit: ${days} days · ${note}</div>
    </div>`;
  }

  document.getElementById('lt-calc').addEventListener('click', function(){
    const qty    = parseInt(document.getElementById('lt-qty').value);
    const comp   = document.getElementById('lt-complex').value;
    const dest   = document.getElementById('lt-dest').value;
    const method = document.querySelector('input[name="lt-ship"]:checked').value;
    const start  = new Date(document.getElementById('lt-date').value);

    const sampDays = comp==='simple'?8:comp==='medium'?12:18;
    const prodDays = qty>=10000?45:qty>=5000?40:qty>=1000?35:qty>=500?32:30;
    const qcDays   = 4;

    const sampEnd = addDays(start, sampDays);
    const prodEnd = addDays(sampEnd, prodDays);
    const qcEnd   = addDays(prodEnd, qcDays);
    const seaEnd  = addDays(qcEnd, transit[dest].sea);
    const airEnd  = addDays(qcEnd, transit[dest].air);

    document.getElementById('lt-default').style.display='none';
    const res = document.getElementById('lt-result');
    res.style.display='block';

    let html = '<div style="display:flex;flex-direction:column;gap:1px;background:#000000;margin-bottom:1rem;">';
    html += row('Sampling & Approval', sampDays, sampEnd, 'Proto, fit & pre-production samples');
    html += row('Bulk Production',     prodDays, prodEnd, 'With inline QC at every stage');
    html += row('QC & Packing',        qcDays,   qcEnd,   'AQL 2.5 inspection + export packing');
    html += '</div>';

    if(method==='both'){
      html += deliveryBox('Sea Freight Delivery', seaEnd, transit[dest].sea, 'Cost-effective', '#1a1a1a');
      html += deliveryBox('Air Freight Delivery', airEnd, transit[dest].air, `Saves ${transit[dest].sea-transit[dest].air} days vs sea`, '#e00');
      html += `<p style="font-size:0.7rem;color:#ffffff;margin-top:0.75rem;line-height:1.6;">Air freight costs 3–5× more than sea freight. Recommended for urgent reorders only.</p>`;
    } else if(method==='sea'){
      html += deliveryBox('Sea Freight Delivery', seaEnd, transit[dest].sea, 'Most economical option', '#1a1a1a');
    } else {
      html += deliveryBox('Air Freight Delivery', airEnd, transit[dest].air, 'Fastest option · 3–5× cost of sea', '#e00');
    }

    html += `<p style="font-size:0.7rem;color:#ffffff;margin-top:1rem;line-height:1.6;">Estimates only. Actual times may vary ±3–5 days based on customs, holidays, and order specifics.</p>`;
    res.innerHTML = html;
  });
});
</script>

<style>
@media(max-width:768px){
  section > .container > div[style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important;}
  section:last-of-type .container > div{grid-template-columns:1fr 1fr!important;}
}
</style>

</BaseLayout>
