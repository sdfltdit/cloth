---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "EU Readiness Checker for Clothing Brands — GPSR, REACH & Textile Compliance | SDF Clothing";
const pageDescription = "Free EU compliance checker for fashion brands. Instantly see if your clothing line meets EU market entry requirements — GPSR 2024, REACH chemical restrictions, EU textile labelling regulation, ESPR readiness, and factory certification. Built for brands sourcing from Bangladesh. No signup needed.";
const canonicalUrl = "https://sdfltd.com/tools/eu-readiness-checker";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  dateModified={new Date().toISOString().split("T")[0]}
>

<meta name="robots" content="index, follow" />
<meta property="og:title" content="EU Readiness Checker for Clothing Brands — GPSR, REACH & Textile Compliance" />
<meta property="og:description" content="Free interactive checker: see if your clothing line meets EU market requirements — GPSR 2024, REACH, textile labelling, ESPR, factory certifications. Instant results, no signup." />
<meta property="og:url" content="https://sdfltd.com/tools/eu-readiness-checker" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="EU Clothing Compliance Checker — GPSR, REACH, Textile Labelling" />
<meta name="twitter:description" content="Is your clothing brand ready for the EU market? Check GPSR, REACH, textile labelling, ESPR, and factory certifications instantly. Free tool, no signup." />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://sdfltd.com/tools/eu-readiness-checker#app",
      "name": "EU Readiness Checker for Clothing Brands",
      "url": "https://sdfltd.com/tools/eu-readiness-checker",
      "description": "Free interactive EU compliance checker for clothing brands and fashion importers. Covers GPSR 2024, REACH chemical restrictions, EU Textile Labelling Regulation 1007/2011, ESPR and Digital Product Passport readiness, and factory certification requirements.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Apparel Compliance Tool",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "featureList": [
        "GPSR 2024 compliance checklist",
        "REACH chemical restriction check",
        "EU textile labelling regulation checker",
        "ESPR and Digital Product Passport readiness",
        "Factory certification assessment",
        "EU Responsible Person requirement check",
        "Personalised compliance score and action plan"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "@id": "https://sdfltd.com/#org"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://sdfltd.com/tools" },
        { "@type": "ListItem", "position": 3, "name": "EU Readiness Checker", "item": "https://sdfltd.com/tools/eu-readiness-checker" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is GPSR and does it apply to clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GPSR (General Product Safety Regulation EU 2023/988) replaced the older GPSD and became fully effective on 13 December 2024. It applies to all consumer products sold in the EU, including clothing and textiles. Under GPSR, brands must conduct product risk assessments, maintain technical documentation for 10 years, ensure product traceability, provide EU contact information on labels or packaging, and appoint an EU Responsible Person if the brand is based outside the EU."
          }
        },
        {
          "@type": "Question",
          "name": "What is REACH and how does it affect garment imports into the EU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "REACH (Registration, Evaluation, Authorisation and Restriction of Chemicals, EC 1907/2006) restricts the use of hazardous substances in products sold in the EU, including clothing. For garments, this means restrictions on certain azo dyes, formaldehyde, heavy metals (cadmium, lead, chromium VI), flame retardants, and other substances in fabrics, dyes, and trims. REACH-compliant production requires chemical testing through accredited laboratories. SDF Clothing uses OEKO-TEX Standard 100 certified fabrics which are tested against REACH restrictions."
          }
        },
        {
          "@type": "Question",
          "name": "What must EU textile labels include?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under EU Textile Labelling Regulation 1007/2011, all garments sold in the EU must include: fibre composition (e.g. 100% Cotton, 95% Cotton 5% Elastane) in the official language of the country of sale, a permanent label fixed to the garment, and a note if the product contains non-textile parts of animal origin. Care symbols alone are not sufficient — fibre content must be stated in words using official EU fibre names."
          }
        },
        {
          "@type": "Question",
          "name": "What is the EU Digital Product Passport for textiles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Digital Product Passport (DPP) is a mandatory digital record under the EU's Ecodesign for Sustainable Products Regulation (ESPR). For textiles and apparel, the DPP will require brands to provide QR-accessible data on material composition, manufacturing origin, chemical compliance, durability, and recyclability. Delegated acts defining exact requirements are expected in late 2026 to early 2027, with compliance enforcement around mid-2028."
          }
        },
        {
          "@type": "Question",
          "name": "Does Bangladesh have duty-free access to the EU for clothing exports?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Bangladesh benefits from EBA (Everything But Arms), granting duty-free, quota-free access for all exports to the EU including clothing and textiles. EU buyers importing from Bangladesh pay 0% import duty, compared to 12% from China. To benefit from EBA, garments must meet EU Rules of Origin — typically requiring fabric cut and sewn in Bangladesh (two-stage transformation rule)."
          }
        },
        {
          "@type": "Question",
          "name": "What factory certifications are EU buyers looking for in Bangladesh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EU buyers sourcing from Bangladesh typically require: GOTS (Global Organic Textile Standard) for organic cotton products; OEKO-TEX Standard 100 confirming no harmful chemicals; BSCI or SEDEX/SMETA social compliance audit; ISO 9001 for quality management; and GRS (Global Recycled Standard) for recycled content claims. SDF Clothing holds GOTS and OEKO-TEX certifications and undergoes regular BSCI social compliance audits."
          }
        }
      ]
    }
  ]
}
</script>

<style>
.tool-page { max-width: 920px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }

.tool-hero { margin-bottom: 2.5rem; }
.tool-hero h1 { font-size: clamp(1.9rem, 3.5vw, 2.7rem); font-weight: 300; color: #fff; letter-spacing: 0.03em; line-height: 1.2; margin-bottom: 0.75rem; }
.tool-hero .sub { font-size: 0.9rem; color: rgba(255,255,255,0.6); max-width: 640px; line-height: 1.85; margin-bottom: 1.25rem; }
.trust-row { display: flex; flex-wrap: wrap; gap: 1rem; }
.trust-item { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); display: flex; align-items: center; gap: 0.35rem; }
.trust-item::before { content: '✓'; color: #e00; }

.reg-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2rem 0 2.5rem; }
.reg-tag { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.3rem 0.7rem; border: 1px solid #e00; color: #e00; }

.checker-section { margin-bottom: 2rem; }
.checker-section-title { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: #e00; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
.checker-section-title span { display: inline-block; width: 18px; height: 1px; background: #e00; }

.q-block { border: 1px solid rgba(255,255,255,0.07); padding: 1.1rem 1.25rem; margin-bottom: 0; border-bottom: none; transition: border-color 0.2s; }
.q-block:last-of-type { border-bottom: 1px solid rgba(255,255,255,0.07); }
.q-block.answered-yes { border-left: 2px solid #4ade80; }
.q-block.answered-no { border-left: 2px solid #e00; }
.q-block.answered-partial { border-left: 2px solid #facc15; }
.q-text { font-size: 0.87rem; color: #fff; margin-bottom: 0.5rem; line-height: 1.55; }
.q-hint { font-size: 0.75rem; color: rgba(255,255,255,0.38); margin-bottom: 0.85rem; line-height: 1.6; }
.q-options { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.q-btn { background: #000; color: rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.12); padding: 0.4rem 0.9rem; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.15s; font-family: inherit; min-height: 36px; }
.q-btn:hover { border-color: rgba(255,255,255,0.3); color: #fff; }
.q-btn.sel-yes { background: rgba(74,222,128,0.08); border-color: #4ade80; color: #4ade80; }
.q-btn.sel-no { background: rgba(238,0,0,0.08); border-color: #e00; color: #e00; }
.q-btn.sel-partial { background: rgba(250,204,21,0.08); border-color: #facc15; color: #facc15; }

.check-btn { width: 100%; background: #e00; color: #fff; border: none; padding: 1rem; font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; font-family: inherit; min-height: 52px; margin: 2rem 0; }
.check-btn:hover { background: #c00; }

.results { display: none; animation: fadeIn 0.4s ease; }
.results.visible { display: block; }
@keyframes fadeIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

.score-row { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: center; margin-bottom: 2rem; background: #000; border: 1px solid rgba(255,255,255,0.08); padding: 1.5rem; }
@media(max-width:480px){ .score-row { grid-template-columns: 1fr; } }
.score-circle { width: 88px; height: 88px; border-radius: 50%; border: 2px solid #e00; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.score-num { font-size: 1.8rem; font-weight: 300; color: #fff; }
.score-label { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.3rem; }
.score-verdict { font-size: 1.15rem; font-weight: 300; color: #fff; margin-bottom: 0.25rem; }
.score-sub { font-size: 0.8rem; color: rgba(255,255,255,0.70); line-height: 1.6; }

.cat-scores { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 2rem; }
@media(max-width:500px){ .cat-scores { grid-template-columns: 1fr 1fr; } }
.cat-item { background: #000; padding: 1rem; }
.cat-lbl { font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 0.3rem; }
.cat-bar-bg { height: 3px; background: rgba(255,255,255,0.07); margin-bottom: 0.3rem; }
.cat-bar-fill { height: 100%; transition: width 0.6s ease; }
.cat-pct { font-size: 0.9rem; font-weight: 300; color: #fff; }

.actions-title { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 1rem; font-weight: 400; }
.action-list { display: flex; flex-direction: column; gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 2rem; }
.action-item { background: #000; padding: 1rem 1.25rem; display: flex; gap: 1rem; align-items: flex-start; }
.action-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700; margin-top: 1px; }
.action-icon.critical { background: rgba(238,0,0,0.15); color: #e00; border: 1px solid #e00; }
.action-icon.warning { background: rgba(250,204,21,0.1); color: #facc15; border: 1px solid #facc15; }
.action-icon.ok { background: rgba(74,222,128,0.08); color: #4ade80; border: 1px solid #4ade80; }
.action-title { font-size: 0.87rem; color: #fff; margin-bottom: 0.2rem; font-weight: 500; }
.action-desc { font-size: 0.78rem; color: rgba(255,255,255,0.70); line-height: 1.65; }
.action-link { font-size: 0.75rem; color: #e00; text-decoration: none; }
.action-link:hover { text-decoration: underline; }

.tool-cta { background: #000; border: 1px solid #e00; padding: 2rem; text-align: center; margin-bottom: 3rem; }
.tool-cta p { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-bottom: 1.25rem; line-height: 1.8; }
.cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

.tl-section { margin-bottom: 2rem; }
.tl-section-title { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 1rem; font-weight: 400; }
.tl-rows { display: flex; flex-direction: column; gap: 1px; background: rgba(255,255,255,0.07); }
.tl-row { background: #000; display: grid; grid-template-columns: 130px 1fr; gap: 1rem; padding: 0.85rem 1rem; align-items: start; }
.tl-date { font-size: 0.72rem; letter-spacing: 0.08em; color: #e00; font-weight: 500; padding-top: 1px; }
.tl-text { font-size: 0.82rem; color: rgba(255,255,255,0.6); line-height: 1.6; }
.tl-text strong { color: #fff; }
.tl-row.future { opacity: 0.6; }
.tl-row.now .tl-date { color: #4ade80; }

.seo-content { border-top: 1px solid rgba(255,255,255,0.07); padding-top: 3rem; }
.seo-content h2 { font-size: 1.35rem; font-weight: 300; color: #fff; letter-spacing: 0.04em; margin-bottom: 1rem; margin-top: 2.5rem; }
.seo-content h2:first-child { margin-top: 0; }
.seo-content h3 { font-size: 1rem; font-weight: 500; color: #fff; margin-bottom: 0.6rem; margin-top: 1.75rem; }
.seo-content p { font-size: 0.87rem; color: rgba(255,255,255,0.6); line-height: 1.9; margin-bottom: 1rem; }
.seo-content ul { margin: 0.75rem 0 1rem; padding: 0; list-style: none; }
.seo-content ul li { font-size: 0.87rem; color: rgba(255,255,255,0.6); line-height: 1.8; padding-left: 1.2rem; position: relative; margin-bottom: 0.35rem; }
.seo-content ul li::before { content: '—'; position: absolute; left: 0; color: #e00; }
.seo-content a { color: #e00; text-decoration: none; }
.seo-content a:hover { text-decoration: underline; }
.faq-item { border-bottom: 1px solid rgba(255,255,255,0.07); padding-bottom: 1.25rem; margin-bottom: 1.25rem; }
.faq-item:last-child { border-bottom: none; }
</style>

<div class="tool-page">

  <nav aria-label="Breadcrumb" style="margin-bottom:2rem;">
    <ol style="display:flex;gap:0.5rem;list-style:none;font-size:0.7rem;color:rgba(255,255,255,0.3);" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" style="color:rgba(255,255,255,0.3);text-decoration:none;" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1" />
      </li>
      <li style="color:rgba(255,255,255,0.18);">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/tools" style="color:rgba(255,255,255,0.3);text-decoration:none;" itemprop="item"><span itemprop="name">Free Tools</span></a>
        <meta itemprop="position" content="2" />
      </li>
      <li style="color:rgba(255,255,255,0.18);">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span style="color:#fff;" itemprop="name">EU Readiness Checker</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </nav>

  <div class="tool-hero">
    <span class="section-label">Free Tool — Updated for GPSR December 2024</span>
    <h1>EU Readiness Checker for Clothing Brands</h1>
    <p class="sub">Selling clothing into the EU became significantly more complex when GPSR became law in December 2024. ESPR is reshaping supply chain transparency, and EU textile labelling rules are tightening. Answer 18 questions and get a personalised compliance score, gap analysis, and prioritised action plan — built specifically for brands sourcing from Bangladesh.</p>
    <div class="trust-row">
      <span class="trust-item">GPSR Dec 2024</span>
      <span class="trust-item">REACH restrictions</span>
      <span class="trust-item">Textile labelling 1007/2011</span>
      <span class="trust-item">ESPR &amp; DPP readiness</span>
      <span class="trust-item">EBA duty-free</span>
      <span class="trust-item">Factory certifications</span>
    </div>
  </div>

  <div class="reg-bar" aria-label="Regulations covered by this checker">
    <span class="reg-tag">GPSR 2024</span>
    <span class="reg-tag">REACH</span>
    <span class="reg-tag">Textile Labelling 1007/2011</span>
    <span class="reg-tag">ESPR / DPP</span>
    <span class="reg-tag">EBA Duty-Free</span>
    <span class="reg-tag">Factory Certifications</span>
    <span class="reg-tag">Rules of Origin</span>
  </div>

  <!-- SECTION 1 -->
  <div class="checker-section">
    <div class="checker-section-title"><span></span>Section 1 — GPSR: General Product Safety Regulation</div>

    <div class="q-block" id="q1">
      <div class="q-text">Do you have a written product risk assessment for each garment style you sell into the EU?</div>
      <div class="q-hint">GPSR requires a documented risk assessment covering physical risks (cords, buttons), chemical risks (dyes, treatments), and allergenic risks. Must be kept for 10 years.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q1','yes',this)">Yes, documented</button>
        <button class="q-btn" onclick="answer('q1','partial',this)">In progress</button>
        <button class="q-btn" onclick="answer('q1','no',this)">Not yet</button>
      </div>
    </div>
    <div class="q-block" id="q2">
      <div class="q-text">Do your garment labels or packaging include EU manufacturer or importer contact details?</div>
      <div class="q-hint">GPSR requires a name, registered address, and contact point (email or web address) for the responsible economic operator — on the garment label, packaging, or accompanying document.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q2','yes',this)">Yes, on all products</button>
        <button class="q-btn" onclick="answer('q2','partial',this)">Some products only</button>
        <button class="q-btn" onclick="answer('q2','no',this)">Not included</button>
      </div>
    </div>
    <div class="q-block" id="q3">
      <div class="q-text">Have you appointed an EU Responsible Person (if your brand is based outside the EU)?</div>
      <div class="q-hint">Non-EU brands must designate an EU-based Responsible Person who can liaise with EU authorities. Their contact details must appear on the product or packaging. This is a hard legal requirement.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q3','yes',this)">Yes, appointed</button>
        <button class="q-btn" onclick="answer('q3','partial',this)">Identifying one now</button>
        <button class="q-btn" onclick="answer('q3','no',this)">No / not aware</button>
        <button class="q-btn" onclick="answer('q3','yes',this)">EU-based brand (N/A)</button>
      </div>
    </div>
    <div class="q-block" id="q4">
      <div class="q-text">Do you have product traceability — lot numbers or style codes — on all garment labels?</div>
      <div class="q-hint">GPSR requires traceability identifiers so products can be tracked and recalled if a safety issue arises. A style code + season code on the care label meets the minimum standard.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q4','yes',this)">Yes, lot + style codes</button>
        <button class="q-btn" onclick="answer('q4','partial',this)">Style codes only</button>
        <button class="q-btn" onclick="answer('q4','no',this)">No system yet</button>
      </div>
    </div>
  </div>

  <!-- SECTION 2 -->
  <div class="checker-section">
    <div class="checker-section-title"><span></span>Section 2 — REACH: Chemical Compliance</div>

    <div class="q-block" id="q5">
      <div class="q-text">Are your fabrics tested against REACH restricted substances — including azo dyes, formaldehyde, and heavy metals?</div>
      <div class="q-hint">REACH restricts hazardous chemicals in textiles. Key risks: azo dyes releasing carcinogenic amines, formaldehyde in fabric finishes, chromium VI in leather trims, cadmium and lead in metal components.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q5','yes',this)">Yes, test reports available</button>
        <button class="q-btn" onclick="answer('q5','partial',this)">Some fabrics tested</button>
        <button class="q-btn" onclick="answer('q5','no',this)">Not tested</button>
      </div>
    </div>
    <div class="q-block" id="q6">
      <div class="q-text">Does your factory hold OEKO-TEX Standard 100 or equivalent certification for your garment fabrics?</div>
      <div class="q-hint">OEKO-TEX Standard 100 certifies every component — fabric, thread, buttons — has been tested for harmful substances. Widely accepted as REACH compliance evidence by EU retailers and customs authorities.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q6','yes',this)">Yes, OEKO-TEX certified</button>
        <button class="q-btn" onclick="answer('q6','partial',this)">GOTS certified (partial coverage)</button>
        <button class="q-btn" onclick="answer('q6','no',this)">No certification</button>
      </div>
    </div>
  </div>

  <!-- SECTION 3 -->
  <div class="checker-section">
    <div class="checker-section-title"><span></span>Section 3 — EU Textile Labelling Regulation 1007/2011</div>

    <div class="q-block" id="q7">
      <div class="q-text">Do your garment labels state exact fibre composition using official EU fibre names (e.g. "Cotton" not "Soft Cotton")?</div>
      <div class="q-hint">EU Regulation 1007/2011 mandates fibre content using exact EU fibre names from Annex I. Invented fabric names like "Softex" or "EcoFleece" are not permitted — the underlying fibre must be stated.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q7','yes',this)">Yes, correct fibre names</button>
        <button class="q-btn" onclick="answer('q7','partial',this)">Some need review</button>
        <button class="q-btn" onclick="answer('q7','no',this)">Not checked</button>
      </div>
    </div>
    <div class="q-block" id="q8">
      <div class="q-text">Are your labels in the official language(s) of each EU country you sell in?</div>
      <div class="q-hint">Fibre content must be in the national language of the country of sale. Selling in Germany, France, and Italy requires German, French, and Italian labels — or a single multilingual label.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q8','yes',this)">Yes, multilingual labels</button>
        <button class="q-btn" onclick="answer('q8','partial',this)">English only (needs update)</button>
        <button class="q-btn" onclick="answer('q8','no',this)">Single country only</button>
      </div>
    </div>
    <div class="q-block" id="q9">
      <div class="q-text">If your garment includes leather, fur, feathers, or other animal-origin non-textile parts, does the label declare this?</div>
      <div class="q-hint">Article 12 of EU 1007/2011 requires "Contains non-textile parts of animal origin" for any animal-origin component including leather patches, feather filling, or fur trim. Select N/A if fully synthetic or plant-based.</div>
      <div class="q-options">
        <button class="q-btn" onclick="answer('q9','yes',this)">Yes, declared on label</button>
        <button class="q-btn" onclick="answer('q9','yes',this)">N/A — no animal components</button>
        <button class="q-btn" onclick="answer('q9','no',this)">Has animal parts, not declared</button>
      </div>
    </div>
  </div>

  <!-- SECTION 4 -->
  <div class="checker-section">
    <div class="checker-section-title"><span></span>Section 4 — ESPR &amp; Digital Product Passport Readiness</div>

