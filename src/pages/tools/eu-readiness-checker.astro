---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "EU Clothing Regulations 2026 Compliance Checker | Free Tool  SDF Clothing";
const pageDescription = "Check if your brand meets EU clothing regulations 2026. Free EU readiness checker for fashion brands sourcing from Bangladesh. EPR, DPP, GOTS, traceability  score in 60 seconds.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "EU Clothing Regulations 2026 Readiness Checker",
  "description": "Free EU compliance checker for fashion brands. Check EPR, Digital Product Passport, GOTS, traceability requirements for 2026.",
  "url": "https://sdfltd.com/eu-readiness-checker",
  "applicationCategory": "BusinessApplication",
  "provider": { "@id": "https://sdfltd.com/#org" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Free Tool · 60 Seconds</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">EU Clothing Regulations<br>2026 Readiness Checker</h1>
    <p style="color:#FFFFFF;max-width:520px;line-height:1.8;font-size:0.92rem;">Check if your brand is compliant with EU 2025–2026 clothing regulations  EPR, Digital Product Passport, GOTS, traceability. Free compliance score in under 60 seconds.</p>
  </div>
</section>

<!-- CHECKER -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;background:#000000;">

      <!-- LEFT: Quiz/Result -->
      <div style="background:#000;padding:3rem;">

        <!-- Quiz -->
        <div id="eu-quiz">
          <!-- Progress -->
          <div style="height:1px;background:rgba(255,255,255,0.1);margin-bottom:0.75rem;">
            <div id="eu-prog" style="height:100%;background:#e00;width:0%;transition:width 0.4s;"></div>
          </div>
          <p id="eu-step-lbl" style="font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:2rem;">Question 1 of 6</p>

          <div id="eu-q0" class="eu-q" style="display:block;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Does your supplier hold a <strong style="color:#fff;font-weight:500;">GOTS</strong> or <strong style="color:#fff;font-weight:500;">OEKO-TEX</strong> certification?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="0" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes</button>
              <button class="eu-opt" data-q="0" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="0" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Not sure</button>
            </div>
          </div>

          <div id="eu-q1" class="eu-q" style="display:none;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Is your supplier registered for <strong style="color:#fff;font-weight:500;">Extended Producer Responsibility (EPR)</strong> in EU countries?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="1" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes</button>
              <button class="eu-opt" data-q="1" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="1" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Not sure</button>
            </div>
          </div>

          <div id="eu-q2" class="eu-q" style="display:none;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Can your supplier provide a <strong style="color:#fff;font-weight:500;">Digital Product Passport (DPP)</strong> for garments from 2026?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="2" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes, ready</button>
              <button class="eu-opt" data-q="2" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="2" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Not sure</button>
            </div>
          </div>

          <div id="eu-q3" class="eu-q" style="display:none;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Does your supplier provide full <strong style="color:#fff;font-weight:500;">traceability documentation</strong>  material origin, dye certificates?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="3" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes</button>
              <button class="eu-opt" data-q="3" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="3" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Partial</button>
            </div>
          </div>

          <div id="eu-q4" class="eu-q" style="display:none;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Are your products designed for <strong style="color:#fff;font-weight:500;">durability, repairability, and recyclability</strong> (Ecodesign requirements)?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="4" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes</button>
              <button class="eu-opt" data-q="4" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="4" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Partially</button>
            </div>
          </div>

          <div id="eu-q5" class="eu-q" style="display:none;">
            <p style="font-size:1rem;color:#fff;line-height:1.7;margin-bottom:1.5rem;font-weight:300;">Does your brand have an <strong style="color:#fff;font-weight:500;">EU importer of record</strong> or EU representative in place?</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button class="eu-opt" data-q="5" data-val="yes" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">Yes</button>
              <button class="eu-opt" data-q="5" data-val="no"  style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">No</button>
              <button class="eu-opt" data-q="5" data-val="unsure" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.65rem 1.5rem;font-size:0.8rem;letter-spacing:0.08em;cursor:pointer;font-family:inherit;transition:all 0.2s;">In progress</button>
            </div>
          </div>
        </div>

        <!-- Result -->
        <div id="eu-result" style="display:none;">
          <div style="display:flex;align-items:center;gap:2rem;margin-bottom:2rem;padding-bottom:2rem;border-bottom:1px solid #e00;flex-wrap:wrap;">
            <div id="eu-circle" style="width:90px;height:90px;border-radius:50%;border:2px solid #e00;display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;">
              <span id="eu-score-num" style="font-size:1.5rem;font-weight:200;color:#fff;line-height:1;"></span>
              <span style="font-size:0.5rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-top:0.2rem;">Score</span>
            </div>
            <div>
              <p id="eu-score-label" style="font-size:1rem;font-weight:400;color:#fff;margin-bottom:0.4rem;"></p>
              <p id="eu-score-desc"  style="font-size:0.82rem;color:#FFFFFF;line-height:1.7;max-width:340px;margin:0;"></p>
            </div>
          </div>
          <div id="eu-gaps" style="display:flex;flex-direction:column;gap:0.6rem;margin-bottom:2rem;"></div>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
            <a href="/contact" class="cta-button" style="font-size:0.72rem;">Talk to Our Compliance Team →</a>
            <button id="eu-retake" style="background:transparent;border:1px solid #e00;color:#FFFFFF;padding:0.85rem 1.5rem;font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:all 0.2s;min-height:44px;" onmouseover="this.style.borderColor='#e00';this.style.color='#fff'" onmouseout="this.style.borderColor='#e00';this.style.color='#fff'">Retake Checker</button>
          </div>
        </div>

      </div>

      <!-- RIGHT: EU Regulation Info -->
      <div style="background:#000;;padding:3rem;">
        <p style="font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1.5rem;">EU Regulations Timeline</p>

        <div style="display:flex;flex-direction:column;gap:0;">
          {[
            ["2023","EU Textile EPR Strategy announced. Brands begin voluntary registration."],
            ["2024","ESPR (Ecodesign for Sustainable Products) regulation passed."],
            ["Jan 2025","EPR mandatory for textiles in France, Germany, Netherlands."],
            ["Jan 2026","Digital Product Passport (DPP) pilot for textiles begins."],
            ["2027","Full DPP mandatory for all garments sold in EU."],
            ["2028","Complete traceability documentation required for all imports."],
          ].map(([year,desc]) => (
            <div style="display:grid;grid-template-columns:60px 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid #0d0d0d;align-items:start;">
              <span style="font-size:0.72rem;font-weight:600;color:#e00;">{year}</span>
              <span style="font-size:0.8rem;color:#FFFFFF;line-height:1.6;">{desc}</span>
            </div>
          ))}
        </div>

        <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid #e00;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1rem;">SDF Clothing EU Compliance Status</p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            {["GOTS Certified","OEKO-TEX Certified","Full traceability docs","DPP-ready process","EPR-compliant supplier"].map(item => (
              <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8rem;color:#FFFFFF;">
                <span style="color:#e00;font-size:0.75rem;">✓</span>{item}
              </div>
            ))}
          </div>
          <div style="margin-top:1.5rem;">
            <a href="/certifications" style="font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:#e00;text-decoration:none;border-bottom:1px solid #e00;padding-bottom:2px;">View All Certifications →</a>
          </div>
        </div>

        <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid #e00;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:0.75rem;">Related Resources</p>
          <div style="display:flex;flex-direction:column;gap:0.4rem;">
            <a href="/insights/eu-clothing-regulations-2026" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #0d0d0d;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">EU Clothing Regulations 2026 <span style="color:#e00;">→</span></a>
            <a href="/eu-epr-explained" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #0d0d0d;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">EU EPR Explained <span style="color:#e00;">→</span></a>
            <a href="/clothing-manufacturer-europe" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;padding:0.4rem 0;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">EU Clothing Manufacturers Guide <span style="color:#e00;">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const QUESTIONS = [
    {key:'gots',    label:'GOTS / OEKO-TEX Certification'},
    {key:'epr',     label:'EPR Registration in EU'},
    {key:'dpp',     label:'Digital Product Passport (DPP)'},
    {key:'trace',   label:'Full Traceability Documentation'},
    {key:'eco',     label:'Ecodesign Compliance'},
    {key:'importer',label:'EU Importer of Record'},
  ];
  let answers={}, current=0;

  function updateProgress(){
    const pct = Math.round((current/QUESTIONS.length)*100);
    document.getElementById('eu-prog').style.width=pct+'%';
    document.getElementById('eu-step-lbl').textContent='Question '+(current+1)+' of '+QUESTIONS.length;
  }

  function showQ(idx){
    document.querySelectorAll('.eu-q').forEach(el=>el.style.display='none');
    const el = document.getElementById('eu-q'+idx);
    if(el) el.style.display='block';
    updateProgress();
  }

  function showResult(){
    document.getElementById('eu-quiz').style.display='none';
    document.getElementById('eu-result').style.display='block';
    document.getElementById('eu-prog').style.width='100%';

    const yes = Object.values(answers).filter(v=>v==='yes').length;
    const score = Math.round((yes/QUESTIONS.length)*100);
    document.getElementById('eu-score-num').textContent=score+'%';

    let label, desc, borderColor;
    if(score>=80){
      label='EU Ready'; desc='Your sourcing is well-aligned with EU 2025–2026 regulations. Minor gaps may still need attention.'; borderColor='#4a4';
    } else if(score>=50){
      label='Partially Ready'; desc='Some compliance gaps exist. Taking action now will avoid costly delays when regulations take effect.'; borderColor='#aa6600';
    } else {
      label='Action Required'; desc='Significant compliance gaps detected. SDF Clothing can resolve all these issues  we are already fully compliant.'; borderColor='#e00';
    }
    document.getElementById('eu-score-label').textContent=label;
    document.getElementById('eu-score-desc').textContent=desc;
    document.getElementById('eu-circle').style.borderColor=borderColor;

    const gapsEl = document.getElementById('eu-gaps');
    gapsEl.innerHTML='';
    QUESTIONS.forEach(function(q,i){
      const val=answers[q.key];
      const pass=val==='yes';
      const note=pass?'Compliant':val==='unsure'?'Needs verification  SDF Clothing can assist':'Gap identified  SDF Clothing is fully compliant here';
      const div=document.createElement('div');
      div.style.cssText='display:flex;align-items:flex-start;gap:0.75rem;padding:0.75rem 1rem;border:1px solid '+(pass?'#1a3a1a':'#1a1a1a')+';background:#000;font-size:0.8rem;color:#FFFFFF;line-height:1.5;';
      div.innerHTML='<span style="color:'+(pass?'#4a4':'#e00')+';font-size:0.85rem;flex-shrink:0;">'+(pass?'✓':'✗')+'</span><div><strong style="color:#fff;font-size:0.8rem;">'+q.label+'</strong><br><span style="font-size:0.75rem;color:#FFFFFF;">'+note+'</span></div>';
      gapsEl.appendChild(div);
    });
  }

  document.querySelectorAll('.eu-opt').forEach(function(btn){
    btn.addEventListener('mouseover',function(){ this.style.borderColor='#e00'; this.style.color='#fff'; });
    btn.addEventListener('mouseout',function(){
      if(!this.classList.contains('eu-selected')){ this.style.borderColor='#1a1a1a'; this.style.color='#FFFFFF'; }
    });
    btn.addEventListener('click',function(){
      const q=parseInt(this.dataset.q);
      const val=this.dataset.val;
      answers[QUESTIONS[q].key]=val;
      document.querySelectorAll('.eu-opt[data-q="'+q+'"]').forEach(b=>{
        b.style.borderColor='#1a1a1a'; b.style.color='#FFFFFF'; b.style.background='transparent';
        b.classList.remove('eu-selected');
      });
      this.style.borderColor='#e00'; this.style.background='rgba(204,0,0,0.08)'; this.style.color='#fff';
      this.classList.add('eu-selected');
      setTimeout(()=>{
        current=q+1;
        if(current<QUESTIONS.length){ showQ(current); } else { showResult(); }
      },300);
    });
  });

  document.getElementById('eu-retake').addEventListener('click',function(){
    answers={}; current=0;
    document.getElementById('eu-result').style.display='none';
    document.getElementById('eu-quiz').style.display='block';
    document.querySelectorAll('.eu-opt').forEach(b=>{
      b.style.borderColor='#1a1a1a'; b.style.color='#FFFFFF'; b.style.background='transparent';
      b.classList.remove('eu-selected');
    });
    showQ(0);
  });

  showQ(0);
})();
</script>

<style>
@media(max-width:768px){
  section > .container > div[style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important;}
  #eu-result > div:first-child{flex-direction:column;}
}
</style>

</BaseLayout>
