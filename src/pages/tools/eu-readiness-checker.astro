<script>
const answers = {};

function answer(qId, val, btn) {
  answers[qId] = val;
  document.getElementById(qId).querySelectorAll('.q-btn').forEach(b => b.classList.remove('sel-yes','sel-no','sel-partial'));
  btn.classList.add(val==='yes'?'sel-yes':val==='no'?'sel-no':'sel-partial');
  document.getElementById(qId).className = 'q-block answered-'+(val==='yes'?'yes':val==='no'?'no':'partial');
}

function sc(ids) {
  let t=0; ids.forEach(id=>{ if(answers[id]==='yes') t+=1; else if(answers[id]==='partial') t+=0.5; });
  return Math.round((t/ids.length)*100);
}

function bColor(p) { return p>=75?'#4ade80':p>=50?'#facc15':'#e00'; }

function showResults() {
  if(Object.keys(answers).length < 12) { alert('Please answer at least 12 questions for an accurate score.'); return; }

  const gpsr    = sc(['q1','q2','q3','q4']);
  const reach   = sc(['q5','q6']);
  const label   = sc(['q7','q8','q9']);
  const espr    = sc(['q10','q11','q12']);
  const factory = sc(['q13','q14','q15','q16','q17','q18']);
  const overall = sc(['q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11','q12','q13','q14','q15','q16','q17','q18']);

  document.getElementById('score-num').textContent = overall+'%';
  document.getElementById('score-circle').style.borderColor = bColor(overall);

  const verdicts = [
    [80,'Strong EU Readiness','Well-prepared for the EU market. Address remaining gaps before your next shipment to EU retailers or marketplaces.'],
    [55,'Partial EU Readiness','A foundation exists but meaningful compliance gaps remain. Several will block EU retail or marketplace onboarding.'],
    [30,'Significant Gaps','Multiple compliance requirements are not met. Do not begin EU market activity until GPSR, labelling, and chemical compliance are addressed.'],
    [0,'Not EU Market Ready','Your brand currently does not meet core EU requirements. Work through the action plan below before selling into Europe.']
  ];
  const [,verdict,sub] = verdicts.find(([min])=>overall>=min);
  document.getElementById('score-verdict').textContent = verdict;
  document.getElementById('score-sub').textContent = sub;

  [['gpsr',gpsr],['reach',reach],['label',label],['espr',espr],['factory',factory]].forEach(([k,p])=>{
    document.getElementById('bar-'+k).style.width=p+'%';
    document.getElementById('bar-'+k).style.background=bColor(p);
    document.getElementById('pct-'+k).textContent=p+'%';
  });

  const acts = [];
  const add=(pr,t,d,l)=>acts.push({pr,t,d,l});

  if(answers['q3']==='no') add('critical','Appoint an EU Responsible Person immediately','Non-EU brands cannot legally sell into the EU without an appointed EU Responsible Person under GPSR. Their contact details must appear on your product or packaging. This is a hard legal requirement.',null);
  if(answers['q1']==='no') add('critical','Create written product risk assessments for all EU styles','GPSR requires documented risk assessments covering physical, chemical, and allergenic risks for every style. Without these, EU customs and market surveillance can block or recall your products.',null);
  if(answers['q5']==='no') add('critical','Commission REACH testing or obtain OEKO-TEX certification','Selling garments with restricted substances in the EU is a criminal offence. Get accredited lab testing for azo dyes, formaldehyde, and heavy metals — or switch to OEKO-TEX certified fabrics.','/contact');
  if(answers['q17']==='no') add('critical','Remove or substantiate all EU sustainability claims immediately','EU Directive 2024/825 prohibits vague claims like "eco-friendly" or "sustainable" without third-party certification. Remove these claims or obtain GOTS/GRS certification before your next EU shipment.',null);
  if(answers['q7']==='no'||answers['q7']==='partial') add('warning','Review fibre content labels for EU compliance','EU Regulation 1007/2011 requires official EU fibre names in local language. Update label templates before next production run. SDF Clothing can produce compliant multilingual labels.','/contact');
  if(answers['q2']==='no') add('warning','Add EU contact information to product labels or packaging','GPSR requires a responsible economic operator name and contact address on or with every product.',null);
  if(answers['q8']==='partial'||answers['q8']==='no') add('warning','Add multilingual labels for each EU market language','Fibre content must be in the official language of the country of sale. Update to multilingual labels before expanding.',null);
  if(answers['q14']==='no') add('warning','Obtain a BSCI or SEDEX social compliance audit','Zalando, ASOS EU, and most EU retailers require BSCI or SMETA audit results during supplier onboarding. SDF Clothing holds a current BSCI audit.','/contact');
  if(answers['q15']==='no'||answers['q15']==='partial') add('warning','Claim Bangladesh EBA 0% duty — you are leaving money on the table','Bangladesh qualifies for 0% EU import duty under EBA. Ensure your factory provides GSP Form A or REX statement of origin with every shipment.',null);
  if(answers['q10']==='no') add('warning','Start collecting material composition data for ESPR/DPP readiness','DPP enforcement begins mid-2028. Start recording fabric mill, fibre %, certifications, and manufacturing origin for every style.',null);
  if(answers['q4']==='no') add('warning','Add lot numbers or style codes to all garment labels','A style code + season code on the care label meets the GPSR traceability minimum standard.',null);
  if(answers['q18']==='no') add('warning','Document your product withdrawal and safety complaints procedure','A one-page internal document covering your response process is sufficient for GPSR compliance.',null);

  if(acts.length===0) add('ok','Compliance foundation is strong — maintain and monitor','Continue maintaining documentation, renewing certifications annually, and monitoring ESPR DPP updates for 2027.',null);

  acts.sort((a,b)=>a.pr==='critical'&&b.pr!=='critical'?-1:0);
  let html='';
  acts.slice(0,8).forEach(a=>{
    const ic=a.pr==='critical'?'critical':a.pr==='warning'?'warning':'ok';
    const sym=a.pr==='critical'?'!':a.pr==='warning'?'▲':'✓';
    html+=`<div class="action-item"><div class="action-icon ${ic}">${sym}</div><div><div class="action-title">${a.t}</div><div class="action-desc">${a.d}${a.l?` <a href="${a.l}" class="action-link">SDF can help →</a>`:''}</div></div></div>`;
  });
  document.getElementById('action-list').innerHTML=html;

  const crit=acts.filter(a=>a.pr==='critical').length;
  if(crit>0) document.getElementById('cta-text').textContent=`You have ${crit} critical compliance gap${crit>1?'s':''} to address before selling into the EU. SDF Clothing is GOTS, OEKO-TEX, and BSCI certified — we provide full compliance documentation with every confirmed order.`;

  const res=document.getElementById('results');
  res.classList.add('visible');
  res.scrollIntoView({behavior:'smooth',block:'start'});
}
</script>

