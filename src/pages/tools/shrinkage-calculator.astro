</div>

<script>
  (function () {
    const FACTORS = {
      fabric: {
        cotton:           { warp: 4.5, weft: 3.5, relax: 2.0 },
        polyester:        { warp: 1.5, weft: 1.0, relax: 0.5 },
        wool:             { warp: 5.0, weft: 4.0, relax: 2.5 },
        silk:             { warp: 3.0, weft: 2.0, relax: 1.5 },
        linen:            { warp: 4.0, weft: 3.0, relax: 2.0 },
        viscose:          { warp: 5.5, weft: 4.5, relax: 3.0 },
        nylon:            { warp: 2.0, weft: 1.5, relax: 1.0 },
        'cotton-polyester': { warp: 3.0, weft: 2.0, relax: 1.5 },
        'cotton-elastane':  { warp: 5.0, weft: 4.0, relax: 2.5 }
      },
      construction: {
        woven:   1.00,
        knit:    1.30,
        denim:   0.90,
        terry:   1.40,
        fleece:  1.35
      },
      weave: {
        plain:         1.00,
        twill:         0.95,
        satin:         1.05,
        rib:           1.10,
        interlock:     1.05,
        'single-jersey': 1.15
      },
      temperature: {
        30: 0.70,
        40: 0.85,
        60: 1.00,
        90: 1.25
      },
      drying: {
        'tumble-dry': 1.20,
        'line-dry':   0.90,
        'flat-dry':   0.85
      }
    };

    function gsmMod(gsm) {
      if (!gsm || isNaN(gsm)) return 1.0;
      if (gsm < 120) return 0.90;
      if (gsm < 180) return 0.95;
      if (gsm < 260) return 1.00;
      if (gsm < 350) return 1.05;
      return 1.10;
    }

    function cycleFactor(n) {
      return Math.min(1 + (n - 5) * 0.04, 1.45);
    }

    function fmt(n, dec) { return n.toFixed(dec); }

    function run() {
      const fabricVal    = document.getElementById('fabric-type').value;
      const constVal     = document.getElementById('construction').value;
      const weaveVal     = document.getElementById('weave-type').value;
      const tempVal      = document.getElementById('temperature').value;
      const dryVal       = document.getElementById('drying-method').value;
      const gsm          = parseFloat(document.getElementById('gsm').value);
      const initMeas     = parseFloat(document.getElementById('initial-measurement').value);
      const cycles       = parseInt(document.getElementById('wash-cycles').value) || 5;
      const tolerance    = parseFloat(document.getElementById('buyer-tolerance').value) || 5;

      const errorEl = document.getElementById('sc-error-msg');

      if (!fabricVal || !constVal || !weaveVal || !tempVal || !dryVal || isNaN(gsm) || isNaN(initMeas)) {
        errorEl.classList.add('sc-error-msg--visible');
        return;
      }
      errorEl.classList.remove('sc-error-msg--visible');

      const btn = document.getElementById('calculate-btn');
      btn.disabled = true;
      btn.textContent = 'Calculating…';

      try {
        const base  = FACTORS.fabric[fabricVal];
        const cm    = FACTORS.construction[constVal];
        const wm    = FACTORS.weave[weaveVal] || 1.0;
        const tm    = FACTORS.temperature[parseInt(tempVal)];
        const dm    = FACTORS.drying[dryVal];
        const gm    = gsmMod(gsm);
        const cf    = cycleFactor(cycles);

        const warp  = base.warp  * cm * wm * tm * dm * gm * cf;
        const weft  = base.weft  * cm * wm * tm * dm * gm * cf;
        const relax = base.relax * cm * gm;
        const total = Math.sqrt(warp * warp + weft * weft);

        const allowWarp = initMeas / (1 - warp / 100) - initMeas;
        const allowWeft = initMeas / (1 - weft / 100) - initMeas;
        const finished  = initMeas * (1 - total / 100);
        const pass      = total <= tolerance;

        document.getElementById('res-warp').textContent    = fmt(warp, 2)  + '%';
        document.getElementById('res-weft').textContent    = fmt(weft, 2)  + '%';
        document.getElementById('res-relax').textContent   = fmt(relax, 2) + '%';
        document.getElementById('res-total').textContent   = fmt(total, 2) + '%';

        document.getElementById('res-allow-warp').textContent = '+' + fmt(allowWarp, 2) + ' cm';
        document.getElementById('res-allow-weft').textContent = '+' + fmt(allowWeft, 2) + ' cm';
        document.getElementById('res-allow-warp-note').textContent =
          'Cut at ' + fmt(initMeas + allowWarp, 2) + ' cm for ' + fmt(initMeas, 1) + ' cm finished';
        document.getElementById('res-allow-weft-note').textContent =
          'Cut at ' + fmt(initMeas + allowWeft, 2) + ' cm for ' + fmt(initMeas, 1) + ' cm finished';

        document.getElementById('res-finished').textContent = fmt(finished, 2) + ' cm';

        const tolEl  = document.getElementById('res-tolerance');
        const tolSub = document.getElementById('res-tolerance-sub');
        tolEl.textContent  = pass ? 'PASS' : 'FAIL';
        tolEl.className    = 'sc-result-value ' + (pass ? 'sc-result-value--pass' : 'sc-result-value--fail');
        tolSub.textContent = pass
          ? fmt(total, 2) + '% is within your ' + fmt(tolerance, 1) + '% limit'
          : fmt(total, 2) + '% exceeds your ' + fmt(tolerance, 1) + '% limit — review fabric or pre-treat';

        document.getElementById('sc-results').classList.add('sc-results--visible');
        document.getElementById('sc-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorEl.textContent = 'Calculation error. Please check all fields and try again.';
        errorEl.classList.add('sc-error-msg--visible');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Calculate Shrinkage';
      }
    }

    function initFAQ() {
      document.querySelectorAll('.sc-faq-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var answer = btn.nextElementSibling;
          var icon   = btn.querySelector('.sc-faq-icon');
          var isOpen = answer.classList.contains('sc-faq-answer--visible');
          answer.classList.toggle('sc-faq-answer--visible', !isOpen);
          icon.classList.toggle('sc-faq-icon--open', !isOpen);
          icon.textContent = isOpen ? '+' : '×';
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      var calcBtn = document.getElementById('calculate-btn');
      if (calcBtn) calcBtn.addEventListener('click', run);
      initFAQ();
    });
  })();
</script>

