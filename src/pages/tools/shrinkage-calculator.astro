const pageDescription = "Free fabric shrinkage calculator for textile professionals — warp, weft, relaxation, and total shrinkage with cutting allowances. ISO 6330 / AATCC 135 based.";
const canonicalURL = "https://sdfltd.com/tools/shrinkage-calculator/";
