<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Fabric Shrinkage Calculator — Free Warp, Weft & Total Shrinkage Tool",
  "description": "Free fabric shrinkage calculator for textile professionals. Calculate warp, weft, relaxation, and total shrinkage with pattern cutting allowances and buyer tolerance checks.",
