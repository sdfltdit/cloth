---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Free Garment Manufacturing Tools — Calculators for Clothing Brands & Buyers | SDF Clothing";
const pageDescription = "14 free garment manufacturing tools for clothing brands and apparel buyers. AQL calculator, GSM converter, landed cost calculator, production timeline, EU readiness checker, HS code finder, fabric shrinkage calculator, wash care label generator, and more. No signup required.";
const canonicalUrl = "https://sdfltd.com/tools";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogType="website"
  dateModified={new Date().toISOString().split("T")[0]}
>

<script type="application/ld+json">
