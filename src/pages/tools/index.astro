---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "13 Free Garment Manufacturing Tools | SDF Clothing";
const pageDescription = "13 free garment manufacturing tools built by a Bangladesh factory — AQL calculator, GSM converter, landed cost calculator, EU readiness checker, and more.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}

  ogType="website"
>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://sdfltd.com/tools/#page",
      "name": "Free Garment Manufacturing Tools",
      "url": "https://sdfltd.com/tools/",
      "description": "13 free calculators and tools for clothing brands, garment buyers, and apparel sourcing teams. Covers costing, quality inspection, fabric conversion, EU compliance, production planning, care labelling, and customs classification.",
      "provider": { "@id": "https://sdfltd.com/#org" },
      "inLanguage": "en",
      "hasPart": [
        { "@type": "SoftwareApplication", "name": "AQL Calculator", "url": "https://sdfltd.com/tools/aql-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "GSM to OZ Converter", "url": "https://sdfltd.com/tools/gsm-converter/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Garment Cost Calculator", "url": "https://sdfltd.com/tools/garment-cost-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Production Timeline Calculator", "url": "https://sdfltd.com/tools/production-timeline/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "EU Readiness Checker", "url": "https://sdfltd.com/tools/eu-readiness-checker/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Manufacturer Email Generator", "url": "https://sdfltd.com/tools/manufacturer-email-generator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Wash Care Label Generator", "url": "https://sdfltd.com/tools/wash-care-label-generator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Fabric Shrinkage Calculator", "url": "https://sdfltd.com/tools/shrinkage-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "HS Code Finder", "url": "https://sdfltd.com/tools/hs-code/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "MOQ Calculator", "url": "https://sdfltd.com/tools/moq-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Lead Time Calculator", "url": "https://sdfltd.com/tools/lead-time-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Price Calculator", "url": "https://sdfltd.com/tools/price-calculator/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } },
        { "@type": "SoftwareApplication", "name": "Colour Converter", "url": "https://sdfltd.com/tools/color-converter/", "applicationCategory": "BusinessApplication", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Manufacturing Tools", "item": "https://sdfltd.com/tools/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is an AQL calculator and how do I use it for garment inspection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An AQL (Acceptable Quality Level) calculator tells you two things: how many garments to randomly inspect from your production lot (sample size), and how many defects are allowable before the entire batch is rejected (accept/reject number). It is based on ISO 2859-1 (ANSI/ASQ Z1.4). To use it: enter your lot size (total pieces), select your inspection level (General Level II is standard for most garment orders), and select your AQL value (2.5 for major defects is the industry standard). The calculator returns your code letter, sample size, and accept/reject numbers. AQL 2.5 means if more than 2.5% of the inspected sample has major defects, the entire batch is rejected and must be reworked."
          }
        },
        {
          "@type": "Question",
          "name": "How do I convert GSM to ounces per yard for fabric weight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To convert GSM (grams per square metre) to oz/yd² (ounces per square yard): divide the GSM value by 33.906. Example: 300 GSM ÷ 33.906 = 8.85 oz/yd². To convert oz/yd² to GSM: multiply by 33.906. Example: 10 oz/yd² × 33.906 = 339 GSM. The conversion factor is exactly 33.906 for all fabric types regardless of composition. GSM is used by manufacturers in Bangladesh, China, Vietnam, and most of Europe. oz/yd² is primarily used in the United States. When sourcing internationally, always confirm which unit your supplier is quoting in before placing an order."
          }
        },
        {
          "@type": "Question",
          "name": "What does EU Digital Product Passport mean for clothing brands in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EU Digital Product Passport (DPP) is a requirement under the Ecodesign for Sustainable Products Regulation (ESPR). For textiles and apparel, DPPs will require brands to attach a digital record to every product sold in the EU — covering materials used, production location, certification status, carbon footprint data, repairability information, and end-of-life guidance. The Delegated Acts defining exact textile DPP requirements are expected in 2027 with mandatory compliance to follow. Brands sourcing from GOTS, GRS, and OEKO-TEX certified manufacturers like SDF Clothing are already well-positioned — these certifications cover most DPP data requirements. Use our EU Readiness Checker to assess your current compliance position."
          }
        },
        {
          "@type": "Question",
          "name": "What care label symbols are required on clothing sold in the EU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "EU Textile Labelling Regulation 1007/2011 requires care labels on all garments sold in the EU. Care symbols must follow ISO 3758 / GINETEX standard and must appear in this sequence: washing, bleaching, drying, ironing, professional care. The symbols must be permanently attached, legible, and in the language of the country of sale. The wash temperature symbol (numbers inside a washtub) must reflect the maximum safe washing temperature, not the recommended temperature. An X through any symbol means 'do not'. Bars below the washtub indicate gentleness — one bar = gentle cycle, two bars = very gentle. Use our free Wash Care Label Generator to produce the correct symbol sequence for your specific fabric and construction."
          }
        },
        {
          "@type": "Question",
          "name": "What HS codes apply to clothing imports — chapters 61 and 62 explained?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clothing HS codes fall under two chapters: Chapter 61 (knitted or crocheted garments) and Chapter 62 (not knitted — woven, woven shell, etc.). Key codes: T-shirts = HS 6109, Hoodies and sweatshirts = HS 6110, Men's woven suits = HS 6203, Women's woven blouses = HS 6206, Men's woven trousers = HS 6203, Woven jackets and blazers = HS 6201/6202. The correct HS code determines your import duty rate and whether you can claim preferential duty-free access for Bangladesh-origin goods under EU GSP (0-12% reduced duty) or UK DCTS. Misclassification results in duty underpayment penalties and retrospective assessments. Always confirm with a licensed customs broker for your specific destination market."
          }
        },
        {
          "@type": "Question",
          "name": "What is fabric shrinkage and how is it calculated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fabric shrinkage is the reduction in a fabric's dimensions after washing or processing. It must be measured separately in warp direction (length) and weft direction (width) as they shrink at different rates. Formula: Shrinkage % = [(Pre-wash measurement – Post-wash measurement) ÷ Pre-wash measurement] × 100. A shrinkage rate of 3% or below is generally acceptable to most retail buyers. Cotton typically shrinks 2–5% untreated. Polyester shrinks 0–1%. Wool can shrink up to 10% without preshrink treatment. Manufacturers should test fabric shrinkage on a washed swatch before cutting bulk fabric. SDF pre-shrinks all cotton fabrics where dimensional stability is critical before cutting."
          }
        },
        {
          "@type": "Question",
          "name": "Are these tools really free and do they collect my data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — all 14 tools are completely free to use with no signup, no email address required, and no usage limits. SDF Clothing does not collect, store, or share any data entered into these tools. They run in your browser. No account is created. The tools are provided as a free resource for clothing brands and apparel buyers worldwide — you do not need to be an SDF client to use them."
          }
        }
      ]
    }
  ]
}
</script>

<style>
.tp { max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }

/* Hero */
.th h1 { font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 0.75rem; }
.th .sub { font-size: 0.92rem; color: rgba(255,255,255,0.6); max-width: 680px; line-height: 1.85; margin-bottom: 1.25rem; }
.trust-row { display: flex; flex-wrap: wrap; gap: 1rem; }
.ti { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); display: flex; align-items: center; gap: 0.35rem; }
.ti::before { content: '✓'; color: #e00; }

/* Category label */
.cl { font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase; color: #e00; margin-bottom: 1rem; margin-top: 3rem; display: block; }
.cl:first-of-type { margin-top: 0; }

/* Grids */
.tg3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 0.25rem; }
.tg2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 0.25rem; }
@media (max-width: 700px) { .tg3 { grid-template-columns: 1fr; } .tg2 { grid-template-columns: 1fr; } }
@media (min-width: 701px) and (max-width: 960px) { .tg3 { grid-template-columns: 1fr 1fr; } }

/* Cards */
.tc { background: #000; padding: 1.75rem; border-top: 2px solid transparent; transition: border-color 0.2s; display: flex; flex-direction: column; }
.tc:hover { border-top-color: #e00; }
.tc a { text-decoration: none; color: inherit; flex: 1; display: flex; flex-direction: column; }
.tcf { background: #000; padding: 2rem; border-top: 2px solid #e00; display: flex; flex-direction: column; }
.tcf a { text-decoration: none; color: inherit; flex: 1; display: flex; flex-direction: column; }

.badge { font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: #e00; margin-bottom: 0.6rem; }
.badge.new { color: #4ade80; }
.badge.upd { color: #facc15; }
.tc-title { font-size: 0.97rem; font-weight: 500; color: #fff; margin-bottom: 0.5rem; line-height: 1.35; }
.tc-desc { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.75; flex: 1; margin-bottom: 1rem; }
.tc-arrow { font-size: 0.75rem; color: #e00; margin-top: auto; }

/* SEO body */
.seo { border-top: 1px solid rgba(255,255,255,0.07); padding-top: 3.5rem; margin-top: 4rem; }
.seo h2 { font-size: 1.35rem; font-weight: 300; color: #fff; margin-bottom: 1rem; margin-top: 2.5rem; }
.seo h2:first-child { margin-top: 0; }
.seo h3 { font-size: 1rem; font-weight: 500; color: #fff; margin-bottom: 0.6rem; margin-top: 1.75rem; }
.seo p { font-size: 0.87rem; color: rgba(255,255,255,0.6); line-height: 1.9; margin-bottom: 1rem; }
.seo ul { margin: 0.75rem 0 1rem; padding: 0; list-style: none; }
.seo li { font-size: 0.87rem; color: rgba(255,255,255,0.6); line-height: 1.8; padding-left: 1.2rem; position: relative; margin-bottom: 0.3rem; }
.seo li::before { content: '—'; position: absolute; left: 0; color: #e00; }
.seo a { color: #e00; text-decoration: none; }
.seo a:hover { text-decoration: underline; }
.faq-item { border-bottom: 1px solid rgba(255,255,255,0.07); padding-bottom: 1.25rem; margin-bottom: 1.25rem; }
.faq-item:last-child { border-bottom: none; }

/* Comparison table */
.comp-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin: 1.5rem 0; }
.comp-table th { text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: rgba(255,255,255,0.4); font-weight: 400; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; border-bottom: 1px solid #e00; }
.comp-table td { padding: 0.8rem 1rem 0.8rem 0; border-bottom: 1px solid #111; vertical-align: top; line-height: 1.6; }
.comp-table tr:last-child td { border-bottom: none; }
.comp-table .f { color: #fff; }
.comp-table .m { color: rgba(255,255,255,0.55); }
.comp-table .w { color: rgba(255,255,255,0.3); }
.comp-table .g { color: #4ade80; }
</style>

<div class="tp">

  <nav aria-label="Breadcrumb" style="margin-bottom:2rem;">
    <ol style="display:flex;gap:0.5rem;list-style:none;font-size:0.7rem;color:rgba(255,255,255,0.3);padding:0;margin:0;">
      <li><a href="/" style="color:rgba(255,255,255,0.3);text-decoration:none;">Home</a></li>
      <li style="color:rgba(255,255,255,0.18);">/</li>
      <li style="color:#fff;">Free Tools</li>
    </ol>
  </nav>

  <!-- HERO -->
  <div class="th" style="margin-bottom:3.5rem;">
    <p style="font-size:0.62rem;letter-spacing:0.28em;text-transform:uppercase;color:#e00;margin-bottom:0.85rem;">Free Tools — No Signup — No Data Collected</p>
    <h1>Free Garment Manufacturing Tools for Clothing Brands &amp; Apparel Buyers</h1>
    <p class="sub">
      13 free calculators and tools covering every stage of apparel sourcing — from AQL quality inspection and GSM fabric weight conversion to EU compliance checking, production timeline planning, wash care label generation, and HS code classification. Built and maintained by SDF Clothing, a Bangladesh garment manufacturer since 1998. These tools are used before every order we produce — which is why they are accurate.
    </p>
    <div class="trust-row">
      <span class="ti">No signup required</span>
      <span class="ti">No data stored or shared</span>
      <span class="ti">Updated June 2026</span>
      <span class="ti">Built by a working factory</span>
    </div>
  </div>

  <!-- HOW SDF TOOLS DIFFER FROM CONTENT SITES -->
  <div style="border:1px solid #1a1a1a;padding:1.5rem 2rem;margin-bottom:3rem;background:#040404;">
    <p style="font-size:0.62rem;letter-spacing:0.25em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Why tools from a factory are different</p>
    <p style="font-size:0.85rem;color:rgba(255,255,255,0.6);line-height:1.85;max-width:720px;margin:0;">
      Most garment manufacturing calculators are built by content websites that have never produced a garment. SDF Clothing has been running production since 1998. Our AQL calculator reflects how we actually inspect orders. Our GSM reference values are taken from the fabrics we source and cut. Our EU compliance checker covers the regulations our EU clients ask about every week. These tools are accurate because we use them ourselves.
    </p>
  </div>

  <!-- FEATURED: BRAND PLANNING -->
  <span class="cl">Brand Planning &amp; Sourcing — Most Used</span>
  <div class="tg2">

    <div class="tcf">
      <a href="/tools/garment-cost-calculator/" title="Free garment cost calculator — FOB price, import duty, landed cost per unit">
        <div class="badge new">Updated June 2026</div>
        <div class="tc-title">Garment Cost Calculator</div>
        <div class="tc-desc">
          Enter garment type, fabric weight, quantity, and destination country — get your estimated FOB price from Bangladesh, import duty rate under EU GSP or UK DCTS, sea or air freight estimate, and total landed cost per unit. Includes gross margin calculator and Bangladesh vs China vs Vietnam cost comparison. The only free tool that shows your all-in cost before you contact a factory.
        </div>
        <span class="tc-arrow">Calculate landed cost →</span>
      </a>
    </div>

    <div class="tcf">
      <a href="/tools/production-timeline/" title="Free apparel production timeline calculator — reverse-engineer from your launch date">
        <div class="badge new">Updated June 2026</div>
        <div class="tc-title">Production Timeline Calculator</div>
        <div class="tc-desc">
          Enter your target in-warehouse date and get every deadline reverse-engineered — brief submission, proto sample approval, pre-production sign-off, bulk cut start, AQL inspection, and FOB shipment. Urgency alerts fire when your window is too short. Supports OEM, ODM, CMT, and white label timelines. The most common reason brands miss their season is underestimating lead time — this tool prevents that.
        </div>
        <span class="tc-arrow">Build my production timeline →</span>
      </a>
    </div>

    <div class="tcf">
      <a href="/tools/manufacturer-email-generator/" title="Free manufacturer inquiry email generator — structured emails that get factory replies">
        <div class="badge new">Updated June 2026</div>
        <div class="tc-title">Manufacturer Email Generator</div>
        <div class="tc-desc">
          Factories receive 30–50 inquiry emails a day. Most are too vague to quote against and get ignored. Fill in your garment type, quantity, timeline, certification requirements, and incoterms — get a structured, factory-ready inquiry email in under a minute. Written from the factory's perspective. Copy and send to any manufacturer. The difference between a response in 48 hours and no response at all is usually the quality of the initial email.
        </div>
        <span class="tc-arrow">Generate my inquiry email →</span>
      </a>
    </div>

    <div class="tcf">
      <a href="/tools/eu-readiness-checker/" title="Free EU compliance checker — GPSR 2024, REACH, ESPR, Digital Product Passport">
        <div class="badge new">Updated for GPSR Dec 2024</div>
        <div class="tc-title">EU Readiness Checker</div>
        <div class="tc-desc">
          Answer 18 questions and get a personalised EU compliance score across five categories: General Product Safety Regulation (GPSR, effective December 2024), REACH chemical restrictions, EU Textile Labelling Regulation 1007/2011, ESPR and Digital Product Passport readiness, and factory certification requirements for EU retailer onboarding. Free compliance gap analysis and prioritised action plan. No tool like this exists anywhere else — built specifically for clothing brands selling into the EU.
        </div>
        <span class="tc-arrow">Check my EU compliance →</span>
      </a>
    </div>

  </div>

  <!-- QUALITY & INSPECTION -->
  <span class="cl">Quality Control &amp; Inspection</span>
  <div class="tg3">

    <div class="tc">
      <a href="/tools/aql-calculator/" title="Free AQL calculator — garment inspection sample size and accept/reject criteria per ISO 2859-1">
        <div class="badge">ISO 2859-1 · AQL Standard</div>
        <div class="tc-title">AQL Calculator</div>
        <div class="tc-desc">
          Calculate your garment inspection sample size and accept/reject criteria based on ISO 2859-1. Enter lot size and inspection level — get your code letter, sample size, and maximum allowable defects. AQL 2.5 is the garment industry standard. Supports General Inspection Levels I, II, and III. Includes switching rules for tightened and reduced inspection. Use before every pre-shipment inspection.
        </div>
        <span class="tc-arrow">Calculate inspection size →</span>
      </a>
    </div>

    <div class="tc">
      <a href="/tools/shrinkage-calculator/" title="Free fabric shrinkage calculator — warp and weft shrinkage rate for garment production">
        <div class="badge">Pre-Production Testing</div>
        <div class="tc-title">Fabric Shrinkage Calculator</div>
        <div class="tc-desc">
          Calculate shrinkage rate from pre-wash and post-wash measurements in both warp (length) and weft (width) directions — they shrink at different rates. Shrinkage above 3% is rejected by most major retail buyers. Cotton shrinks 2–5%; polyester 0–1%; wool up to 10% without preshrink treatment. Essential before cutting bulk — a 4% shrinkage error on a 300-piece hoodie order means 300 garments out of spec.
        </div>
        <span class="tc-arrow">Calculate shrinkage rate →</span>
      </a>
    </div>

  </div>

  <!-- FABRIC & TECHNICAL -->
  <span class="cl">Fabric &amp; Technical Specification</span>
  <div class="tg3">

    <div class="tc">
      <a href="/tools/gsm-converter/" title="Free GSM to OZ fabric weight converter — instant conversion with garment reference chart">
        <div class="badge">Fabric Specification</div>
        <div class="tc-title">GSM to OZ Converter</div>
        <div class="tc-desc">
          Convert fabric weight between GSM (grams per square metre) and oz/yd² (ounces per square yard) instantly. Formula: GSM ÷ 33.906 = oz/yd². Essential when comparing US suppliers (who quote in oz) with Asian suppliers (who quote in GSM). A 300 GSM hoodie fleece = 8.85 oz. Includes a reference chart covering 20+ common garments with typical GSM ranges and what each weight means for hand-feel, durability, and price.
        </div>
        <span class="tc-arrow">Convert fabric weight →</span>
      </a>
    </div>

    <div class="tc">
      <a href="/tools/wash-care-label-generator/" title="Free wash care label generator — ISO 3758 GINETEX symbols for EU, US, and Australia compliance">
        <div class="badge">ISO 3758 · GINETEX</div>
        <div class="tc-title">Wash Care Label Generator</div>
        <div class="tc-desc">
          Generate correct ISO 3758 / GINETEX care label symbols for your garment based on fabric type and construction. EU Textile Labelling Regulation requires care symbols on all garments sold in Europe. US FTC Care Labeling Rule requires instructions in the US. Select fabric, wash method, drying, ironing, and bleach instructions — get your correct symbol sequence. Symbol sequence must always follow: washing → bleaching → drying → ironing → professional care.
        </div>
        <span class="tc-arrow">Generate care label →</span>
      </a>
    </div>

    <div class="tc">
      <a href="/tools/color-converter/" title="Free Pantone to hex and RGB colour converter for garment tech pack specification">
        <div class="badge">Colour Specification</div>
        <div class="tc-title">Colour Converter</div>
        <div class="tc-desc">
          Convert Pantone colours to hex, RGB, and CMYK for garment specifications. Factories require Pantone references for accurate colour matching — a digital hex code alone is insufficient because screen rendering varies between devices and operating systems. Use this tool to identify the closest Pantone reference for any digital colour before submitting your tech pack. A correct Pantone reference prevents the most common source of colour disputes in production.
        </div>
        <span class="tc-arrow">Convert my colours →</span>
      </a>
    </div>

  </div>

  <!-- COSTING & TRADE -->
  <span class="cl">Costing, Trade &amp; Customs</span>
  <div class="tg3">

    <div class="tc">
      <a href="/tools/price-calculator/" title="Free garment price calculator — FOB estimate from fabric cost, CM rate, and margin">
        <div class="badge">Costing</div>
        <div class="tc-title">Price Calculator</div>
        <div class="tc-desc">
          Estimate your garment FOB price from fabric cost, cut and make (CM) rate, trim cost, and commercial costs. Input target margin — get a FOB price estimate and recommended retail price range at standard fashion markup ratios (4x wholesale = standard; 6x = premium brand). Works for knitwear, wovens, and accessories. Useful for validating factory quotes and setting retail prices before sampling begins.
        </div>
        <span class="tc-arrow">Estimate my price →</span>
      </a>
    </div>

    <div class="tc">
      <a href="/tools/hs-code/" title="Free HS code finder for clothing and apparel — chapters 61 and 62 classification">
        <div class="badge">Customs Classification</div>
        <div class="tc-title">HS Code Finder</div>
        <div class="tc-desc">
          Find the correct Harmonised System (HS) code for your garment. Clothing falls under Chapter 61 (knitted) and Chapter 62 (woven). T-shirts = HS 6109. Hoodies = HS 6110. Woven trousers = HS 6203/6204. Jackets = HS 6201/6202. The correct HS code determines your duty rate and whether you can claim EU GSP or UK DCTS duty-free access for Bangladesh origin goods. Misclassification carries retrospective duty assessments.
        </div>
        <span class="tc-arrow">Find my HS code →</span>
      </a>
    </div>

    <div class="tc">
      <a href="/tools/moq-calculator/" title="Free MOQ calculator — check order quantity viability and size distribution">
        <div class="badge">Order Planning</div>
        <div class="tc-title">MOQ Calculator</div>
        <div class="tc-desc">
          Check whether your planned order quantity meets factory minimums and how to distribute pieces across styles, sizes, and colourways. SDF's MOQ is 300 pieces per style with flexible size and colour splits. This tool helps startup brands understand whether their order is viable and how to structure a multi-style order efficiently without going below minimum quantities on any individual style.
        </div>
        <span class="tc-arrow">Check my MOQ →</span>
      </a>
