.trust-item { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); display: flex; align-items: center; gap: 0.35rem; }
.trust-item::before { content: '✓'; color: #e00; }

/* Category label */
.cat-label { font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase; color: #e00; margin-bottom: 1rem; margin-top: 3rem; display: block; }
.cat-label:first-of-type { margin-top: 0; }

/* Tool grid */
