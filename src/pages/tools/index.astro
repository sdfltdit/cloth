@media (max-width: 700px) { .tool-grid { grid-template-columns: 1fr; } }
@media (min-width: 701px) and (max-width: 960px) { .tool-grid { grid-template-columns: 1fr 1fr; } }

.tool-card { background: #000; padding: 1.75rem; border-top: 2px solid transparent; transition: border-color 0.2s; display: flex; flex-direction: column; }
.tool-card:hover { border-top-color: #e00; }
.tool-card a { text-decoration: none; color: inherit; flex: 1; display: flex; flex-direction: column; }

.tc-badge { font-size: 0.58rem; letter-spacing: 0.18em; text-transform: uppercase; color: #e00; margin-bottom: 0.6rem; }
.tc-badge.new { color: #4ade80; }
.tc-badge.updated { color: #facc15; }

.tc-title { font-size: 0.97rem; font-weight: 500; color: #fff; margin-bottom: 0.5rem; line-height: 1.35; }
.tc-desc { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.75; flex: 1; margin-bottom: 1rem; }
.tc-arrow { font-size: 0.75rem; color: #e00; margin-top: auto; }

/* 2-col grid for featured tools */
.tool-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 0.25rem; }
@media (max-width: 600px) { .tool-grid-2 { grid-template-columns: 1fr; } }

.tool-card-featured { background: #000; padding: 2rem; border-top: 2px solid #e00; display: flex; flex-direction: column; }
.tool-card-featured a { text-decoration: none; color: inherit; flex: 1; display: flex; flex-direction: column; }

/* SEO body */
.seo-section { border-top: 1px solid rgba(255,255,255,0.07); padding-top: 3.5rem; margin-top: 4rem; }
.seo-section h2 { font-size: 1.35rem; font-weight: 300; color: #fff; margin-bottom: 1rem; margin-top: 2.5rem; }
.seo-section h2:first-child { margin-top: 0; }
.seo-section h3 { font-size: 1rem; font-weight: 500; color: #fff; margin-bottom: 0.6rem; margin-top: 1.75rem; }
.seo-section p { font-size: 0.87rem; color: rgba(255,255,255,0.6); line-height: 1.9; margin-bottom: 1rem; }
.seo-section ul { margin: 0.75rem 0 1rem; padding: 0; list-style: none; }
