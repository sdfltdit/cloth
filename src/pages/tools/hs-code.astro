<script define:vars={{ hsCodes }}>
document.addEventListener('DOMContentLoaded', function(){
  const searchInput = document.getElementById('searchInput');
  const filterSelect = document.getElementById('categoryFilter');
  const codeChapter = document.getElementById('code-chapter');
  const codeHeading = document.getElementById('code-heading');
  const codeSubheading = document.getElementById('code-subheading');
  const codeCountry = document.getElementById('code-country');
  const codeBreakdownResults = document.getElementById('code-breakdown-results');
  const codeBreakdownEmpty = document.getElementById('code-breakdown-empty');
  const codeBreakdownList = document.getElementById('code-breakdown-list');
  const hsContainer = document.getElementById('hs-container');
  const hsNoResults = document.getElementById('hs-no-results');
  const hsReset = document.getElementById('hs-reset');
  const hsLeftPanel = document.getElementById('hs-left-panel');
  const hsRightPanel = document.getElementById('hs-right-panel');
  const hsDefaultMessage = document.getElementById('hs-default-message');
  const hsCountryBreakdown = document.getElementById('hs-country-breakdown');
  const hsEmptyState = document.getElementById('hs-empty-state');
  const selectedCode = document.getElementById('selected-code');
  const selectedDescription = document.getElementById('selected-description');
  const selectedNotes = document.getElementById('selected-notes');

  const hsData = hsCodes;
  let searchTerm = '';
  let selectedCategory = '';
  let chapterValue = '';
  let headingValue = '';
  let subheadingValue = '';
  let countryValue = '';
  let constructedCode = '';
  let visibleCount = 0;
  let hasResults = false;
  let categoryVisible = false;
  let categoryMatches = false;
  let matchesSearch = false;
  let hasSearchOrFilter = false;
  let code = '';
  let description = '';
  let notes = '';

  function filterHS() {
    searchTerm = searchInput.value.toLowerCase();
    selectedCategory = filterSelect.value;
    chapterValue = codeChapter.value;
    headingValue = codeHeading.value;
    subheadingValue = codeSubheading.value;
    countryValue = codeCountry.value;
    
    // Construct HS code from breakdown inputs
    constructedCode = '';
    if (chapterValue || headingValue || subheadingValue || countryValue) {
      constructedCode = (chapterValue || '') + (headingValue || '') + (subheadingValue || '') + (countryValue || '');
    }
    
    visibleCount = 0;
    hasResults = false;

    // Check if we should show empty state
    hasSearchOrFilter = searchTerm || selectedCategory !== 'all' || constructedCode;
    
    if (hasSearchOrFilter) {
      hsEmptyState.style.display = 'none';
    } else {
      hsEmptyState.style.display = 'block';
    }

    // Update code breakdown results box
    if (constructedCode) {
      codeBreakdownEmpty.style.display = 'none';
      codeBreakdownList.style.display = 'block';
      codeBreakdownList.innerHTML = '';
      
      Object.entries(hsData).forEach(([category, codes]) => {
        codes.forEach(item => {
          if (item.code.toLowerCase().includes(constructedCode.toLowerCase())) {
            const resultItem = document.createElement('div');
            resultItem.style.background = '#000000';
            resultItem.style.border = '1px solid #000000';
            resultItem.style.padding = '0.75rem';
            resultItem.style.marginBottom = '0.5rem';
            resultItem.style.borderRadius = '4px';
            resultItem.style.cursor = 'pointer';
            resultItem.style.transition = 'background 0.2s';
            resultItem.onmouseover = function() { this.style.background = '#050505'; };
            resultItem.onmouseout = function() { this.style.background = '#000000'; };
            resultItem.innerHTML = `
              <div style="font-family:'Courier New',monospace;font-size:0.9rem;color:#ffffff;font-weight:500;margin-bottom:0.25rem;">${item.code}</div>
              <div style="font-size:0.8rem;color:#fff;margin-bottom:0.25rem;">${item.description}</div>
              <div style="font-size:0.7rem;color:#ffffff;">${category}</div>
            `;
            codeBreakdownList.appendChild(resultItem);
          }
        });
      });
      
      if (codeBreakdownList.children.length === 0) {
        codeBreakdownEmpty.style.display = 'block';
        codeBreakdownEmpty.textContent = 'No codes found matching your input.';
        codeBreakdownList.style.display = 'none';
      }
    } else {
      codeBreakdownEmpty.style.display = 'block';
      codeBreakdownEmpty.textContent = 'Enter a code above to see results.';
      codeBreakdownList.style.display = 'none';
    }

    Object.entries(hsData).forEach(([category, codes]) => {
      const categoryDiv = document.querySelector(`.hs-category[data-category="${category}"]`);
      const rows = categoryDiv.querySelectorAll('.hs-row');
      categoryVisible = false;

      // Check if category matches filter
      categoryMatches = selectedCategory === 'all' || selectedCategory === category;

      rows.forEach(row => {
        code = row.dataset.code.toLowerCase();
        description = row.dataset.description.toLowerCase();
        notes = row.dataset.notes.toLowerCase();
        
        matchesSearch = code.includes(searchTerm) || 
                              description.includes(searchTerm) || 
                              notes.includes(searchTerm) ||
                              code.includes(constructedCode.toLowerCase());
        
        if (hasSearchOrFilter && categoryMatches && matchesSearch) {
          row.style.display = 'grid';
          visibleCount++;
          categoryVisible = true;
          hasResults = true;
        } else {
          row.style.display = 'none';
        }
      });

      if (hasSearchOrFilter && categoryVisible) {
        categoryDiv.style.display = 'block';
      } else {
        categoryDiv.style.display = 'none';
      }
    });

    // Show/hide no results message
    if (hasSearchOrFilter && !hasResults) {
      hsContainer.style.display = 'none';
      hsNoResults.style.display = 'block';
    } else {
      hsContainer.style.display = 'grid';
      hsNoResults.style.display = 'none';
    }
  }

  function showCountryBreakdown(codeParam, descriptionParam, notesParam) {
    selectedCode.textContent = codeParam.substring(0, 6);
    selectedDescription.textContent = descriptionParam;
    selectedNotes.textContent = notesParam;
    
    hsDefaultMessage.style.display = 'none';
    hsCountryBreakdown.style.display = 'block';
  }

  // Click handlers for HS code rows
  document.querySelectorAll('.hs-row.clickable').forEach(row => {
    row.addEventListener('click', function(){
      const code = this.dataset.code;
      const description = this.dataset.description;
      const notes = this.dataset.notes;
      
      // Remove active class from all rows
      document.querySelectorAll('.hs-row.clickable').forEach(r => {
        r.style.background = '#000';
      });
      
      // Add active state to clicked row
      this.style.background = '#000000';
      
      showCountryBreakdown(code, description, notes);
    });
  });

  searchInput.addEventListener('input', filterHS);
  filterSelect.addEventListener('change', filterHS);
  codeChapter.addEventListener('input', filterHS);
  codeHeading.addEventListener('input', filterHS);
  codeSubheading.addEventListener('input', filterHS);
  codeCountry.addEventListener('input', filterHS);

  hsReset.addEventListener('click', function(){
    searchInput.value = '';
    filterSelect.value = 'all';
    codeChapter.value = '';
    codeHeading.value = '';
    codeSubheading.value = '';
    codeCountry.value = '';
    filterHS();
  });

  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(button => {
    button.addEventListener('click', () => {
      const answer = button.nextElementSibling;
      const icon = button.querySelector('.faq-icon');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      
      button.setAttribute('aria-expanded', !isExpanded);
      answer.classList.toggle('faq-answer--visible');
      icon.classList.toggle('faq-icon--open');
    });
  });

  // Initialize filter on load
  filterHS();
});
</script>

