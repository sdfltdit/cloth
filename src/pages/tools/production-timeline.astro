<script>
  const doneMap = {};

  function sub(d, n) { const x = new Date(d); x.setDate(x.getDate() - n); return x; }
  function fmtLong(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
  function fmtShort(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); }
  function gap(a, b) { return Math.round((b - a) / 86400000); }

  function getStatus(date, today, isDone, isPast, isLaunch) {
    if (isLaunch) return 'launch';
    if (isDone)   return 'done';
    if (isPast)   return 'past';
    const d = gap(today, date);
    if (d <= 7)  return 'critical';
    if (d <= 21) return 'warning';
    return 'ok';
  }

  const STATUS = {
    done:     { dot: 'dot-done',     card: 'mc-done',     dateClass: 'date-done',     chip: 'chip-done',     chipText: 'Done ✓' },
    past:     { dot: 'dot-past',     card: 'mc-past',     dateClass: 'date-past',     chip: 'chip-past',     chipText: 'Past' },
    critical: { dot: 'dot-critical', card: 'mc-critical', dateClass: 'date-critical', chip: 'chip-critical', chipText: 'This week' },
    warning:  { dot: 'dot-warning',  card: 'mc-warning',  dateClass: 'date-warning',  chip: 'chip-warning',  chipText: 'Coming up' },
    ok:       { dot: 'dot-ok',       card: 'mc-ok',       dateClass: 'date-ok',       chip: 'chip-ok',       chipText: 'Upcoming' },
    launch:   { dot: 'dot-launch',   card: 'mc-launch',   dateClass: 'date-launch',   chip: 'chip-launch',   chipText: 'Launch' }
  };

  function calc() {
    const dv = document.getElementById('launch-date').value;
    const emptyEl = document.getElementById('empty-state');
    const resEl   = document.getElementById('results-panel');
    const apEl    = document.getElementById('alert-pill');

    if (!dv) {
      emptyEl.style.display = 'flex';
      resEl.style.display   = 'none';
      apEl.style.display    = 'none';
      const cdNum = document.getElementById('cd-num');
      cdNum.textContent = '—'; cdNum.style.color = 'var(--muted)';
      document.getElementById('cd-sub').textContent = 'Select a launch date';
      document.getElementById('cd-sub').style.color = 'var(--muted)';
      document.getElementById('cd-bar').style.background = 'var(--border)';
      return;
    }

    const launch = new Date(dv);
    const svc    = document.getElementById('svc-type').value;
    const qty    = document.getElementById('order-qty').value;
    const ship   = document.getElementById('ship-mode').value;
    const today  = new Date(); today.setHours(0, 0, 0, 0);

    const freight  = ship === 'air' ? 7 : 43;
    const customs  = 5;
    const prod     = { small: 30, medium: 40, large: 52, xlarge: 68 }[qty];
    const samp     = (svc === 'odm' || svc === 'private') ? 13 : 18;
    const pp       = svc === 'cmt' ? 0 : 10;
    const ppR      = svc === 'cmt' ? 0 : 5;
    const br       = 7, conf = 4, tpd = (svc === 'oem' || svc === 'cmt') ? 3 : 0;
    const total    = tpd + conf + samp + br + pp + ppR + prod + freight + customs;

    const portArr  = sub(launch, customs);
    const shipDep  = sub(portArr, freight);
    const exF      = sub(shipDep, 3);
    const bulkS    = sub(exF, prod);
    const ppApp    = sub(bulkS, ppR);
    const ppRdy    = sub(ppApp, pp);
    const prApp    = pp > 0 ? sub(ppRdy, br) : sub(bulkS, br);
    const prRdy    = sub(prApp, samp);
    const oc       = sub(prRdy, conf);
    const tpDue    = sub(oc, tpd + 1);
    const startDate = (svc === 'oem' || svc === 'cmt') ? tpDue : oc;
    const dts      = gap(today, startDate);

    /* ── Countdown ── */
    const cdNum = document.getElementById('cd-num');
    const cdSub = document.getElementById('cd-sub');
    const cdBar = document.getElementById('cd-bar');
    if (dts < 0) {
      cdNum.textContent = Math.abs(dts); cdNum.style.color = '#ef4444';
      cdSub.textContent = 'days overdue'; cdSub.style.color = '#ef4444';
      cdBar.style.background = '#ef4444'; cdBar.style.width = '100%';
    } else if (dts <= 14) {
      cdNum.textContent = dts; cdNum.style.color = '#f59e0b';
      cdSub.textContent = 'days to start deadline'; cdSub.style.color = '#f59e0b';
      cdBar.style.background = '#f59e0b';
      cdBar.style.width = Math.round((dts / 14) * 100) + '%';
    } else {
      cdNum.textContent = dts; cdNum.style.color = '#22c55e';
      cdSub.textContent = 'days until you must start'; cdSub.style.color = '#22c55e';
      cdBar.style.background = '#22c55e';
      cdBar.style.width = Math.min(100, Math.round((dts / 90) * 100)) + '%';
    }

    /* ── Alert pill ── */
    apEl.style.display = 'block';
    if (dts < 0) {
      apEl.className = 'ap ap-r';
      apEl.innerHTML = '<span class="ap-icon">⚠</span><span>Start deadline passed <strong>' + Math.abs(dts) + ' days ago</strong>. Contact SDF now for fast-track options.</span>';
    } else if (dts <= 14) {
      apEl.className = 'ap ap-y';
      apEl.innerHTML = '<span class="ap-icon">⚡</span><span>Only <strong>' + dts + ' days</strong> left to start. Check SDF slot availability today.</span>';
    } else {
      apEl.className = 'ap ap-g';
      apEl.innerHTML = '<span class="ap-icon">✓</span><span>Timeline achievable — start by <strong>' + fmtShort(startDate) + '</strong> and you\'ll make it.</span>';
    }

    /* ── Summary cards ── */
    const startClass = dts < 0 ? 'sc-red' : dts <= 14 ? 'sc-amber' : 'sc-green';
    document.getElementById('sum-row').innerHTML =
      '<div class="sc ' + startClass + '"><div class="sc-lbl">Must start by</div><div class="sc-val">' + fmtShort(startDate) + '</div></div>' +
      '<div class="sc sc-neutral"><div class="sc-lbl">Total lead time</div><div class="sc-val">' + total + ' days</div></div>' +
      '<div class="sc sc-neutral"><div class="sc-lbl">Your launch date</div><div class="sc-val">' + fmtShort(launch) + '</div></div>';

    /* ── Progress bar ── */
    const elapsed = Math.max(0, gap(startDate, today));
    const pct = Math.min(100, Math.round((elapsed / total) * 100));
    const barColor = pct >= 75 ? '#22c55e' : pct >= 35 ? 'var(--r)' : 'rgba(255,255,255,0.3)';
    setTimeout(() => {
      const fill = document.getElementById('pbar-fill');
      fill.style.width = pct + '%';
      fill.style.background = barColor;
      const pbarPct = document.getElementById('pbar-pct');
      pbarPct.textContent = pct + '% of journey elapsed';
      pbarPct.style.color = barColor;
    }, 60);

    /* ── Build milestones ── */
    const ms = [];
    if (svc === 'oem' || svc === 'cmt') {
      ms.push({ date: tpDue, title: 'Submit tech pack / spec sheet', desc: 'Complete measurements, BOM, fabric spec, and artwork files. Missing details delay sampling by 1–2 weeks before a single stitch is sewn.', badgeClass: 'bg-buyer', badgeLabel: 'Your action', key: 'tp', canCheck: true });
    }
    ms.push({ date: oc, title: 'Order confirmation + 30% deposit', desc: 'Confirm quantities, colourways, size ratio, and incoterms. Sampling begins only after payment clears — every day of delay here matters.', badgeClass: 'bg-buyer', badgeLabel: 'Your action', key: 'oc', canCheck: true });
    ms.push({ date: prRdy, title: 'Proto sample ready', desc: (svc === 'odm' || svc === 'private') ? 'SDF delivers first prototype from existing base pattern — faster than OEM.' : 'SDF delivers first prototype from your tech pack for fit, construction, and fabric review.', badgeClass: 'bg-factory', badgeLabel: 'SDF action', key: 'pr' });
    ms.push({ date: prApp, title: 'Proto sample approval', desc: 'Review against your spec and send precise written approval or revision comments. Each extra revision round adds 12–18 days to your schedule.', badgeClass: 'bg-buyer', badgeLabel: 'Your action', key: 'pa', canCheck: true });
    if (pp > 0) {
      ms.push({ date: ppRdy, title: 'Pre-production sample ready', desc: 'Final sample in actual bulk fabric with confirmed trims. Your last checkpoint before the full production run begins.', badgeClass: 'bg-factory', badgeLabel: 'SDF action', key: 'ppr' });
      ms.push({ date: ppApp, title: 'PP sample sign-off', desc: 'Written approval is mandatory. Bulk production cannot start without it. Aim to review within 5 days to protect your bulk start date.', badgeClass: 'bg-buyer', badgeLabel: 'Your action', key: 'ppa', canCheck: true });
    }
    ms.push({ date: bulkS, title: 'Bulk production starts', desc: 'Fabric cut, sewing lines assigned, trims staged. ' + prod + ' production days from this point. SDF sends weekly progress updates.', badgeClass: 'bg-factory', badgeLabel: 'SDF action', key: 'bs' });
    ms.push({ date: exF, title: 'Ex-factory — final QC + packing', desc: 'AQL inspection, carton packing, and export documentation. Balance payment (70%) due before the shipment is released.', badgeClass: 'bg-factory', badgeLabel: 'SDF action', key: 'ef' });
    ms.push({ date: shipDep, title: ship === 'air' ? 'Air shipment departs Dhaka' : 'Sea container departs Chittagong', desc: ship === 'air' ? 'Via Dhaka Hazrat Shahjalal International Airport — transit approximately 5–7 days.' : 'FCL or LCL container from Chittagong port — transit approximately 40–43 days.', badgeClass: 'bg-ship', badgeLabel: 'Logistics', key: 'sh' });
    ms.push({ date: launch, title: '🎯 Goods in hand — launch ready', desc: 'Goods arrive, clear customs, and reach your warehouse or 3PL. Ready for your launch, retail drop, Amazon FBA, or wholesale delivery.', badgeClass: 'bg-launch', badgeLabel: 'Your launch', key: 'la', isLaunch: true });

    /* Progress meta */
    const totalActions  = ms.filter(m => m.canCheck).length;
    const doneCount     = ms.filter(m => m.canCheck && doneMap[m.key]).length;
    document.getElementById('ms-meta').textContent = doneCount + ' / ' + totalActions + ' actions done';

    /* Render milestones */
    const listEl = document.getElementById('ms-list');
    listEl.innerHTML = '';

    ms.forEach(m => {
      const isDone  = !!doneMap[m.key];
      const isPast  = today > m.date && !m.isLaunch;
      const st      = getStatus(m.date, today, isDone, isPast, m.isLaunch);
      const col     = STATUS[st];

      const item = document.createElement('div');
      item.className = 'ms-item';

      /* Dot */
      const dotCol = document.createElement('div');
      dotCol.className = 'ms-dot-col';
      const dot = document.createElement('div');
      dot.className = 'ms-dot ' + col.dot;
      dotCol.appendChild(dot);

      /* Card body */
      const bodyEl = document.createElement('div');
      bodyEl.style.flex = '1';

      const card = document.createElement('div');
      card.className = 'ms-card ' + col.card;

      const dateEl = document.createElement('div');
      dateEl.className = 'ms-date ' + col.dateClass;
      dateEl.textContent = fmtLong(m.date);

      const titleEl = document.createElement('div');
      titleEl.className = 'ms-title';
      titleEl.textContent = m.title;

      const descEl = document.createElement('div');
      descEl.className = 'ms-desc';
      descEl.textContent = m.desc;

      const bottomEl = document.createElement('div');
      bottomEl.className = 'ms-bottom';

      const badge = document.createElement('span');
      badge.className = 'badge ' + m.badgeClass;
      badge.textContent = m.badgeLabel;

      const rightEl = document.createElement('div');
      rightEl.className = 'ms-right';

      const chip = document.createElement('span');
      chip.className = 'chip ' + col.chip;
      chip.textContent = col.chipText;
      rightEl.appendChild(chip);

      if (m.canCheck) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chk-btn' + (isDone ? ' done' : '');
        btn.setAttribute('aria-pressed', String(isDone));
        btn.textContent = isDone ? '✓ Done' : 'Mark done';
        btn.addEventListener('click', () => {
          doneMap[m.key] = !doneMap[m.key];
          calc();
        });
        rightEl.appendChild(btn);
      }

      bottomEl.appendChild(badge);
      bottomEl.appendChild(rightEl);

      card.appendChild(dateEl);
      card.appendChild(titleEl);
      card.appendChild(descEl);
      card.appendChild(bottomEl);
      bodyEl.appendChild(card);
      item.appendChild(dotCol);
      item.appendChild(bodyEl);
      listEl.appendChild(item);
    });

    /* CTA text */
    const sampleLabel = (svc === 'odm' || svc === 'private') ? '13-day' : '14-day';
    document.getElementById('cta-text').textContent = dts < 0
      ? 'Your start deadline has passed. Contact SDF Clothing now — we assess urgent orders quickly and offer air freight where the timeline allows.'
      : 'SDF offers ' + sampleLabel + ' sample turnaround and ' + prod + '-day bulk production. Slots fill ' + (total > 90 ? '90' : '60') + ' days ahead of peak season — worth locking yours in early.';

    emptyEl.style.display = 'none';
    resEl.style.display   = 'block';
  }

  /* Season presets */
  document.querySelectorAll('.sb').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sb').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('launch-date').value = btn.getAttribute('data-date');
      calc();
    });
  });

  /* Live inputs */
  document.getElementById('launch-date').addEventListener('input', () => {
    document.querySelectorAll('.sb').forEach(b => b.classList.remove('active'));
    calc();
  });
  document.getElementById('ship-mode').addEventListener('change', calc);
  document.getElementById('svc-type').addEventListener('change', calc);
  document.getElementById('order-qty').addEventListener('change', calc);

  /* FAQ accordion */
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.classList.remove('open');
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.classList.add('open');
      }
    });
  });
</script>

</BaseLayout>
