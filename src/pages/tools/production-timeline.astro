---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Clothing Production Timeline Calculator — Plan From Launch Date Backwards";
const pageDescription = "Free clothing production timeline calculator. Enter your launch date and get every deadline mapped backwards — tech pack, sampling, bulk production, QC, and sea or air freight. Built for brands sourcing from Bangladesh.";
const canonicalUrl = "https://sdfltd.com/tools/production-timeline";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  dateModified={new Date().toISOString().split("T")[0]}
>

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta property="og:title" content="Clothing Production Timeline Calculator — Plan From Launch Date Backwards" />
<meta property="og:description" content="Enter your launch date and get every deadline mapped backwards — tech pack, sampling, bulk production, and shipment. Free for clothing brands sourcing from Bangladesh." />
<meta property="og:url" content="https://sdfltd.com/tools/production-timeline" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Clothing Production Timeline Calculator — Plan From Launch Date Backwards" />
<meta name="twitter:description" content="Enter your launch date and get every deadline mapped backwards — tech pack, sampling, bulk production, and shipment. Free, no signup." />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://sdfltd.com/tools/production-timeline#app",
      "name": "Clothing Production Timeline Calculator",
      "url": "https://sdfltd.com/tools/production-timeline",
      "description": "Free production timeline calculator for clothing brands. Enter a target launch or in-hand date and get every milestone mapped backwards — tech pack, proto sampling, PP sample approval, bulk production, QC, packing, and sea or air freight. Built for brands sourcing from Bangladesh.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Fashion Production Planning Tool",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "isAccessibleForFree": true,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "@id": "https://sdfltd.com/#org"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://sdfltd.com/tools" },
        { "@type": "ListItem", "position": 3, "name": "Production Timeline Calculator", "item": "https://sdfltd.com/tools/production-timeline" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does clothing production take from Bangladesh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard OEM order of 500 to 2,000 pieces from Bangladesh takes roughly 90 days from tech pack confirmation to goods arriving in your warehouse by sea freight — around 3 to 5 days for order confirmation, 14 to 18 days for proto sampling, 7 days for buyer review, 7 to 10 days for the pre-production sample, 40 days for bulk cut and sew, and 40 to 43 days for sea freight from Chittagong. ODM and private label orders are somewhat faster because the factory starts from existing patterns."
          }
        },
        {
          "@type": "Question",
          "name": "When do I need to start production to hit a Christmas launch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For goods in a US warehouse by 1 December by sea freight from Bangladesh, a container typically needs to leave Chittagong around 10 to 15 October. Working back from there, bulk production needs to start by around 1 September, pre-production sample sign-off by 20 August, and tech pack submission by early-to-mid July at the latest."
          }
        },
        {
          "@type": "Question",
          "name": "What is a pre-production sample and why does it matter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pre-production sample (PP sample) is made in the actual bulk fabric and confirmed trims, after the first proto sample has been approved. It is the final check before cutting begins on the full order. Any issues found at this stage are far cheaper to fix than after the bulk run is complete."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use air freight from Bangladesh if my timeline is too tight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Air freight from Dhaka takes roughly 5 to 7 days compared with 40 to 43 days by sea from Chittagong. The trade-off is cost — air freight runs approximately four to five times more per kilogram than sea, which can add significantly to your landed cost per unit."
          }
        },
        {
          "@type": "Question",
          "name": "What is the biggest cause of delays in clothing production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The single most common cause is an incomplete tech pack at the start, which forces the factory to ask clarifying questions before they can begin — sometimes delaying the sample by one to two weeks before anything is cut. The second is slow sample approval: every additional revision round adds 12 to 18 days."
          }
        }
      ]
    }
  ]
}
</script>

<style>
  /* ── DESIGN TOKENS ── */
  :root {
    --r:  #e00;
    --rd: #c00;
    --g:  #4ade80;
    --y:  #facc15;
    --b:  #60a5fa;
    --w:  #ffffff;
    --border: rgba(255,255,255,0.08);
    --surface: #0d0d0d;
    --text: rgba(255,255,255,0.65);
    --muted: rgba(255,255,255,0.35);
    --label-color: rgba(255,255,255,0.72);
  }

  /* ── PAGE SHELL ── */
  .tool-page { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.5rem 6rem; }

  /* ── BREADCRUMB ── */
  .crumb-nav ol { display:flex; gap:0.5rem; list-style:none; font-size:0.7rem; color:var(--muted); flex-wrap:wrap; margin-bottom:2.5rem; }
  .crumb-nav a { color:var(--muted); text-decoration:none; }
  .crumb-nav a:hover { color:#fff; }
  .crumb-sep { color:rgba(255,255,255,0.15); }

  /* ── HERO ── */
  .hero { margin-bottom:2.5rem; }
  .hero-eyebrow { font-size:0.66rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--r); font-weight:600; margin-bottom:0.9rem; display:block; }
  .hero h1 { font-size:clamp(2rem,4vw,2.9rem); font-weight:200; color:#fff; letter-spacing:0.02em; line-height:1.15; margin:0 0 0.9rem; }
  .hero h1 em { font-style:normal; color:var(--r); }
  .hero-sub { font-size:0.9rem; color:var(--text); max-width:580px; line-height:1.85; margin-bottom:1.5rem; }
  .pill-row { display:flex; flex-wrap:wrap; gap:0.5rem; }
  .pill { font-size:0.68rem; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted); border:1px solid rgba(255,255,255,0.1); padding:0.3rem 0.7rem; border-radius:100px; }

  /* ── STEP CARDS (form) ── */
  .steps-wrap { display:flex; flex-direction:column; gap:1rem; margin:2rem 0 1.5rem; }
  .step-card {
    background:var(--surface); border:1px solid var(--border);
    border-radius:4px; overflow:hidden;
    transition:border-color 0.2s;
  }
  .step-card:focus-within { border-color:rgba(238,0,0,0.4); }
  .step-head {
    display:flex; align-items:center; gap:1rem;
    padding:1rem 1.25rem 0.85rem;
    border-bottom:1px solid var(--border);
  }
  .step-num {
    width:28px; height:28px; border-radius:50%; background:rgba(238,0,0,0.12);
    border:1px solid rgba(238,0,0,0.35); display:flex; align-items:center;
    justify-content:center; font-size:0.72rem; font-weight:700; color:var(--r);
    flex-shrink:0; font-variant-numeric:tabular-nums;
  }
  .step-title { font-size:0.78rem; letter-spacing:0.1em; text-transform:uppercase; color:#fff; font-weight:500; }
  .step-sub { font-size:0.72rem; color:var(--muted); margin-left:auto; }
  .step-body { padding:1.1rem 1.25rem; }

  /* ── INPUTS ── */
  .inp-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  @media(max-width:520px){ .inp-grid { grid-template-columns:1fr; } }
  .inp-group { display:flex; flex-direction:column; gap:0.4rem; }
  .inp-group label { font-size:0.68rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--label-color); }
  .inp-group input,
  .inp-group select {
    background:#000; color:#fff; border:1px solid rgba(255,255,255,0.11);
    padding:0.8rem 1rem; font-size:0.87rem; width:100%;
    outline:none; font-family:inherit; appearance:none; -webkit-appearance:none;
    color-scheme:dark; min-height:46px; border-radius:3px;
    transition:border-color 0.18s;
  }
  .inp-group input:focus,
  .inp-group select:focus { border-color:var(--r); outline:2px solid rgba(238,0,0,0.18); outline-offset:2px; }
  .inp-group select option { background:#111; }
  .inp-hint { font-size:0.69rem; color:var(--muted); }
  .inp-error { font-size:0.72rem; color:#ff6b6b; display:none; }
  .inp-error.show { display:block; }

  /* ── CTA BUTTON ── */
  .cta-row { margin:1.75rem 0 0; }
  .calc-btn {
    width:100%; background:var(--r); color:#fff; border:none;
    padding:1.05rem 1rem; font-size:0.82rem; letter-spacing:0.14em;
    text-transform:uppercase; cursor:pointer; font-family:inherit;
    min-height:54px; border-radius:3px; transition:background 0.18s;
    display:flex; align-items:center; justify-content:center; gap:0.5rem;
  }
  .calc-btn:hover { background:var(--rd); }
  .calc-btn:focus-visible { outline:2px solid #fff; outline-offset:3px; }
  .calc-btn svg { flex-shrink:0; }

  /* ── RESULTS ── */
  .results { display:none; }
  .results.show { display:block; animation:riseIn 0.45s ease both; }
  @keyframes riseIn { from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);} }

  /* Alert banner */
  .alert-banner {
    padding:1rem 1.3rem; margin-bottom:2rem;
    border-left:3px solid; border-radius:0 3px 3px 0; font-size:0.87rem;
    line-height:1.7; display:flex; align-items:flex-start; gap:0.75rem;
  }
  .alert-banner .a-icon { flex-shrink:0; font-size:1.1rem; }
  .ab-green  { border-color:var(--g); background:rgba(74,222,128,0.06); color:var(--g); }
  .ab-yellow { border-color:var(--y); background:rgba(250,204,21,0.06); color:var(--y); }
  .ab-red    { border-color:var(--r); background:rgba(238,0,0,0.06); color:#ff7070; }

  /* Summary 3-up */
  .summary-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); margin-bottom:2rem; border-radius:3px; overflow:hidden; }
  @media(max-width:480px){ .summary-cards { grid-template-columns:1fr; } }
  .sc { background:#000; padding:1.2rem 1.1rem; }
  .sc-lbl { font-size:0.61rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted); margin-bottom:0.35rem; }
  .sc-val { font-size:1.35rem; font-weight:200; color:#fff; line-height:1; }
  .sc-val.accent { color:var(--r); }

  /* Gantt strip — SIGNATURE ELEMENT */
  .gantt-wrap { margin-bottom:2.25rem; }
  .gantt-label { font-size:0.61rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted); margin-bottom:0.6rem; }
  .gantt-track { height:8px; background:rgba(255,255,255,0.06); border-radius:4px; position:relative; overflow:hidden; }
  .gantt-fill {
    height:100%; border-radius:4px; position:absolute; left:0; top:0;
    background:linear-gradient(90deg, var(--r) 0%, rgba(238,0,0,0.6) 100%);
    width:0%; transition:width 1s cubic-bezier(.25,.8,.25,1);
  }
  .gantt-phases { display:flex; justify-content:space-between; margin-top:0.5rem; flex-wrap:wrap; gap:0.3rem; }
  .gantt-phase { font-size:0.62rem; color:var(--muted); display:flex; align-items:center; gap:0.3rem; }
  .gantt-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }

  /* Milestone timeline */
  .ms-section-title { font-size:0.61rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted); margin-bottom:1.25rem; }
  .ms-list { display:flex; flex-direction:column; gap:0; position:relative; }
  .ms-list::before { content:''; position:absolute; left:15px; top:12px; bottom:12px; width:1px; background:var(--border); z-index:0; }

  .ms-item { display:flex; gap:1.25rem; position:relative; }
  .ms-marker { flex-shrink:0; width:31px; display:flex; flex-direction:column; align-items:center; padding-top:2px; position:relative; z-index:1; }
  .ms-dot {
    width:12px; height:12px; border-radius:50%; flex-shrink:0;
    border:2px solid transparent; transition:box-shadow 0.3s;
  }
  .ms-dot.past     { background:var(--g); border-color:var(--g); }
  .ms-dot.now      { background:var(--r); border-color:var(--r); box-shadow:0 0 10px rgba(238,0,0,0.55); }
  .ms-dot.warn     { background:var(--y); border-color:var(--y); box-shadow:0 0 8px rgba(250,204,21,0.45); }
  .ms-dot.future   { background:transparent; border-color:rgba(255,255,255,0.25); }
  .ms-dot.goal     { background:var(--r); border-color:var(--r); box-shadow:0 0 14px rgba(238,0,0,0.6); }

  .ms-body { flex:1; padding-bottom:1.5rem; border-bottom:1px solid rgba(255,255,255,0.05); }
  .ms-item:last-child .ms-body { border-bottom:none; padding-bottom:0; }

  .ms-date { font-size:0.68rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:0.15rem; }
  .ms-date.urgent { color:var(--y); font-weight:600; }
  .ms-date.past-date { color:var(--g); }
  .ms-date.goal-date { color:var(--r); font-weight:600; }

  .ms-title { font-size:0.95rem; font-weight:500; color:#fff; margin-bottom:0.2rem; line-height:1.35; }
  .ms-desc { font-size:0.78rem; color:var(--muted); line-height:1.7; margin-bottom:0.45rem; }

  .ms-badge {
    display:inline-flex; align-items:center; gap:0.3rem;
    font-size:0.59rem; letter-spacing:0.1em; text-transform:uppercase;
    padding:0.2rem 0.55rem; border:1px solid; border-radius:100px;
  }
  .badge-factory { border-color:rgba(238,0,0,0.4); color:rgba(238,0,0,0.9); }
  .badge-buyer   { border-color:rgba(255,255,255,0.2); color:rgba(255,255,255,0.6); }
  .badge-ship    { border-color:rgba(96,165,250,0.4); color:rgba(96,165,250,0.9); }
  .badge-goal    { border-color:rgba(74,222,128,0.4); color:rgba(74,222,128,0.9); }

  /* CTA box */
  .cta-box { background:#000; border:1px solid var(--r); border-radius:4px; padding:2rem 1.75rem; text-align:center; margin:2.5rem 0; }
  .cta-box p { font-size:0.87rem; color:var(--text); margin-bottom:1.25rem; line-height:1.8; }
  .cta-btns { display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap; }
  .btn-solid {
    background:var(--r); color:#fff; border:none; padding:0.85rem 1.6rem;
    font-size:0.78rem; letter-spacing:0.12em; text-transform:uppercase;
    text-decoration:none; border-radius:3px; min-height:46px;
    display:inline-flex; align-items:center; transition:background 0.18s;
  }
  .btn-solid:hover { background:var(--rd); }
  .btn-outline-green {
    background:transparent; color:var(--g); border:1px solid var(--g);
    padding:0.85rem 1.5rem; font-size:0.78rem; letter-spacing:0.12em;
    text-transform:uppercase; text-decoration:none; border-radius:3px;
    min-height:46px; display:inline-flex; align-items:center; gap:0.45rem;
    transition:background 0.18s;
  }
  .btn-outline-green:hover { background:rgba(74,222,128,0.08); }

  .disclaimer { font-size:0.7rem; color:var(--muted); line-height:1.7; border-top:1px solid var(--border); padding-top:1.25rem; margin-top:1.5rem; }

  /* ── SEO CONTENT ── */
  .seo { border-top:1px solid var(--border); padding-top:3rem; margin-top:1rem; }
  .seo h2 { font-size:1.3rem; font-weight:300; color:#fff; margin:2.5rem 0 0.9rem; letter-spacing:0.03em; }
  .seo h2:first-child { margin-top:0; }
  .seo h3 { font-size:0.97rem; font-weight:500; color:#fff; margin:1.75rem 0 0.55rem; }
  .seo p { font-size:0.875rem; color:var(--text); line-height:1.9; margin-bottom:1rem; }
  .seo ul { margin:0.75rem 0 1rem; padding:0; list-style:none; }
  .seo li { font-size:0.875rem; color:var(--text); line-height:1.8; padding-left:1.2rem; position:relative; margin-bottom:0.3rem; }
  .seo li::before { content:'—'; position:absolute; left:0; color:var(--r); }
  .seo a { color:var(--r); text-decoration:none; }
  .seo a:hover { text-decoration:underline; }
  .last-updated { font-size:0.69rem; color:var(--muted); margin-bottom:2rem; }

  /* Timeline data table */
  .data-table { width:100%; border-collapse:collapse; margin:1.25rem 0; font-size:0.82rem; }
  .data-table th { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); padding:0.6rem 0.75rem; border-bottom:1px solid var(--border); text-align:left; font-weight:400; }
  .data-table td { padding:0.65rem 0.75rem; color:var(--text); border-bottom:1px solid rgba(255,255,255,0.04); vertical-align:top; }
  .data-table tr:last-child td { border-bottom:none; }
  .data-table td:first-child { color:#fff; font-weight:500; }

  /* Season grid */
  .season-grid { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--border); margin:1.25rem 0; border-radius:3px; overflow:hidden; }
  @media(max-width:460px){ .season-grid { grid-template-columns:1fr; } }
  .sg-item { background:#000; padding:1rem 1.1rem; }
  .sg-item strong { color:#fff; font-size:0.82rem; display:block; margin-bottom:0.25rem; }
  .sg-item span { color:var(--muted); font-size:0.76rem; line-height:1.6; }

  /* FAQ accordion */
  .faq-list { margin:1.25rem 0; }
  .faq-item { border-bottom:1px solid var(--border); }
  .faq-item:first-child { border-top:1px solid var(--border); }
  .faq-btn {
    width:100%; background:none; border:none; color:#fff; cursor:pointer;
    padding:1.1rem 0; font-size:0.88rem; font-weight:500; font-family:inherit;
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
    text-align:left; line-height:1.45; transition:color 0.15s;
  }
  .faq-btn:hover { color:var(--r); }
  .faq-btn:focus-visible { outline:2px solid var(--r); outline-offset:3px; }
  .faq-icon {
    flex-shrink:0; width:22px; height:22px; border:1px solid rgba(255,255,255,0.2);
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:0.85rem; color:rgba(255,255,255,0.45); transition:all 0.22s;
  }
  .faq-btn[aria-expanded="true"] .faq-icon { border-color:var(--r); color:var(--r); transform:rotate(45deg); }
  .faq-answer {
    overflow:hidden; max-height:0;
    transition:max-height 0.38s ease, padding 0.2s ease;
    font-size:0.85rem; color:var(--text); line-height:1.9;
  }
  .faq-answer.open { max-height:500px; padding-bottom:1.1rem; }
  .faq-answer p { margin:0; }

  @media(prefers-reduced-motion:reduce){
    .results { animation:none; }
    .gantt-fill { transition:none; }
    .faq-answer, .faq-icon { transition:none; }
  }
</style>

<div class="tool-page">

  <!-- BREADCRUMB -->
  <nav class="crumb-nav" aria-label="Breadcrumb">
    <ol itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1" />
      </li>
      <li class="crumb-sep">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/tools" itemprop="item"><span itemprop="name">Free Tools</span></a>
        <meta itemprop="position" content="2" />
      </li>
      <li class="crumb-sep">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span itemprop="name" style="color:#fff;">Production Timeline Calculator</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <span class="hero-eyebrow">Free Tool · No Signup Required</span>
    <h1>When do you need to<br><em>start</em> your order?</h1>
    <p class="hero-sub">Pick your launch date. This tool works backwards through every stage — tech pack, sampling, bulk production, and freight — and tells you exactly when each step has to happen. Most brands miss their season not because the factory was slow, but because they started 30 to 60 days too late.</p>
    <div class="pill-row">
      <span class="pill">Works backwards from launch</span>
      <span class="pill">OEM / ODM / CMT / Private Label</span>
      <span class="pill">Sea &amp; air freight</span>
      <span class="pill">Urgency alerts</span>
    </div>
  </div>

  <!-- STEP 1 — Date + ship mode -->
  <div class="steps-wrap">
    <div class="step-card">
      <div class="step-head">
        <div class="step-num">1</div>
        <div class="step-title">Target date &amp; shipping</div>
        <div class="step-sub">When do you need goods?</div>
      </div>
      <div class="step-body">
        <div class="inp-grid">
          <div class="inp-group">
            <label for="launch-date">Launch or in-hand date</label>
            <input type="date" id="launch-date" aria-required="true" />
            <span class="inp-hint">When do the goods need to be in your warehouse?</span>
            <span class="inp-error" id="date-error">Please select a target date first.</span>
          </div>
          <div class="inp-group">
            <label for="ship-mode">Shipping mode</label>
            <select id="ship-mode">
              <option value="sea">Sea freight — ~40 days from Chittagong</option>
              <option value="air">Air freight — ~5 days from Dhaka</option>
            </select>
          </div>
        </div>
      </div>
    </div>

