<script>
  function sub(d, n) { const x = new Date(d); x.setDate(x.getDate() - n); return x; }
  function fmtLong(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
  function fmtShort(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); }
  function gap(a, b) { return Math.round((b - a) / 86400000); }

  const calcBtn   = document.getElementById('calc-btn');
  const dateErr   = document.getElementById('date-error');
  const resultsEl = document.getElementById('results');

  calcBtn.addEventListener('click', () => {
    const dateVal = document.getElementById('launch-date').value;
    if (!dateVal) {
      dateErr.classList.add('show');
      document.getElementById('launch-date').focus();
      return;
    }
    dateErr.classList.remove('show');

    const launch  = new Date(dateVal);
    const svc     = document.getElementById('service-type').value;
    const qty     = document.getElementById('order-qty').value;
    const shipMode = document.getElementById('ship-mode').value;
    const today   = new Date(); today.setHours(0,0,0,0);

    const freight   = shipMode === 'air' ? 7 : 43;
    const customs   = 5;
    const prod      = { small:30, medium:40, large:52, xlarge:68 }[qty];
    const sampling  = (svc==='odm'||svc==='private') ? 13 : 18;
    const pp        = svc==='cmt' ? 0 : 10;
    const ppReview  = svc==='cmt' ? 0 : 5;
    const buyerRev  = 7;
    const confirm   = 4;
    const tpDays    = (svc==='oem'||svc==='cmt') ? 3 : 0;
    const total     = tpDays + confirm + sampling + buyerRev + pp + ppReview + prod + freight + customs;

    // Calculate milestones working backwards
    const portArr      = sub(launch, customs);
    const shipDepart   = sub(portArr, freight);
    const exFact       = sub(shipDepart, 3);
    const bulkStart    = sub(exFact, prod);
    const ppApprove    = sub(bulkStart, ppReview);
    const ppReady      = sub(ppApprove, pp);
    const protoApprove = pp > 0 ? sub(ppReady, buyerRev) : sub(bulkStart, buyerRev);
    const protoReady   = sub(protoApprove, sampling);
    const orderConfirm = sub(protoReady, confirm);
    const tpDue        = sub(orderConfirm, tpDays + 1);
    const startDate    = (svc==='oem'||svc==='cmt') ? tpDue : orderConfirm;

    const daysToStart = gap(today, startDate);

    // ── Alert ──
    let alertHtml;
    if (daysToStart < 0) {
      alertHtml = `<div class="alert-banner ab-red" role="alert"><span class="a-icon">⚠</span><span>Your start deadline has already passed by <strong>${Math.abs(daysToStart)} days</strong>. Air freight can recover transit time, but production time can't be shortened. Contact SDF now for a fast-track assessment.</span></div>`;
    } else if (daysToStart <= 14) {
      alertHtml = `<div class="alert-banner ab-yellow" role="alert"><span class="a-icon">⚡</span><span>You need to start in <strong>${daysToStart} days</strong>. This is tight. Contact SDF today to check slot availability — air freight may be needed.</span></div>`;
    } else {
      alertHtml = `<div class="alert-banner ab-green" role="alert"><span class="a-icon">✓</span><span>Your timeline is achievable. Start no later than <strong>${fmtLong(startDate)}</strong> and you'll make it.</span></div>`;
    }
    document.getElementById('alert-box').innerHTML = alertHtml;

    // ── Summary ──
    document.getElementById('s-start').textContent  = fmtShort(startDate);
    document.getElementById('s-lead').textContent   = total + ' days';
    document.getElementById('s-launch').textContent = fmtShort(launch);

    // ── Gantt animation ──
    const progress = Math.min(100, Math.max(5, Math.round((gap(startDate, today) / total) * 100)));
    const ganttFill = document.getElementById('gantt-fill');
    ganttFill.style.width = '0%';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => { ganttFill.style.width = progress + '%'; });
    });

    // ── Milestones ──
    const milestones = [];
    const badge = (type, label) => `<span class="ms-badge ${type}">${label}</span>`;

    if (svc==='oem'||svc==='cmt') {
      milestones.push({ date:tpDue, title:'Submit Tech Pack / Spec Sheet', desc:'Send your complete tech pack — measurements, construction notes, BOM, fabric spec, and artwork files. Gaps here are the most common cause of sampling delays.', badgeClass:'badge-buyer', badgeLabel:'Your action' });
    }
    milestones.push({ date:orderConfirm, title:'Order Confirmation + 30% Deposit', desc:'Confirm quantities, colourways, size ratio, and incoterms. Pay the deposit — sampling does not begin until payment clears.', badgeClass:'badge-buyer', badgeLabel:'Your action' });
    milestones.push({ date:protoReady, title:'Proto Sample Ready', desc:(svc==='odm'||svc==='private')?'SDF delivers first prototype from existing base pattern — faster turnaround than OEM.':'SDF delivers first prototype based on your tech pack for fit, construction, and fabric review.', badgeClass:'badge-factory', badgeLabel:'SDF action' });
    milestones.push({ date:protoApprove, title:'Proto Sample Approval', desc:'Review against your spec, measure carefully, and send written approval or clear revision comments. Each extra revision round adds 12–18 days to your schedule.', badgeClass:'badge-buyer', badgeLabel:'Your action' });
    if (pp > 0) {
      milestones.push({ date:ppReady, title:'Pre-Production Sample Ready', desc:'Final sample in actual bulk fabric with confirmed trims. Must match the approved proto exactly. Your last check before the full run begins.', badgeClass:'badge-factory', badgeLabel:'SDF action' });
      milestones.push({ date:ppApprove, title:'PP Sample Sign-Off', desc:'Written approval is mandatory. Bulk production cannot start without it. Aim to review within 5 days to protect your bulk start date.', badgeClass:'badge-buyer', badgeLabel:'Your action' });
    }
    milestones.push({ date:bulkStart, title:'Bulk Production Starts', desc:`Fabric cut, sewing lines assigned, trims staged. ${prod} production days from this date. SDF shares weekly progress updates.`, badgeClass:'badge-factory', badgeLabel:'SDF action' });
    milestones.push({ date:exFact, title:'Ex-Factory — QC + Packing', desc:'AQL final inspection, carton packing, and export documentation. Balance payment (70%) is due before the shipment is released.', badgeClass:'badge-factory', badgeLabel:'SDF action' });
    milestones.push({
      date: shipDepart,
      title: shipMode==='air' ? 'Air Shipment Departs Dhaka' : 'Sea Container Departs Chittagong',
      desc: shipMode==='air' ? 'Air freight via Dhaka Hazrat Shahjalal International. Transit ~5–7 days to destination.' : 'FCL or LCL container from Chittagong port. Transit ~40–43 days to destination.',
      badgeClass:'badge-ship', badgeLabel:'Logistics'
    });
    milestones.push({ date:launch, title:'🎯 Goods In Hand — Launch Ready', desc:'Goods arrive, clear customs, and are delivered to your warehouse or 3PL. Ready for your launch, retail drop, Amazon FBA, or wholesale delivery.', badgeClass:'badge-goal', badgeLabel:'Your launch' });

    const listEl = document.getElementById('ms-list');
    listEl.innerHTML = '';

    milestones.forEach(m => {
      const isPast   = today > m.date;
      const isUrgent = gap(today, m.date) <= 7 && today <= m.date;
      const isGoal   = m.badgeClass === 'badge-goal';
      const isNow    = !isPast && !isGoal && gap(today, m.date) <= 21;

      let dotClass = 'future';
      if (isPast)   dotClass = 'past';
      else if (isGoal) dotClass = 'goal';
      else if (isUrgent) dotClass = 'warn';
      else if (isNow)    dotClass = 'now';

      let dateClass = '';
      if (isPast)   dateClass = 'past-date';
      if (isUrgent) dateClass = 'urgent';
      if (isGoal)   dateClass = 'goal-date';

      const item = document.createElement('div');
      item.className = 'ms-item';

      const marker = document.createElement('div');
      marker.className = 'ms-marker';
      const dot = document.createElement('div');
      dot.className = `ms-dot ${dotClass}`;
      marker.appendChild(dot);

      const body = document.createElement('div');
      body.className = 'ms-body';

      const dateEl = document.createElement('div');
      dateEl.className = `ms-date${dateClass ? ' '+dateClass : ''}`;
      dateEl.textContent = fmtLong(m.date);

      const titleEl = document.createElement('div');
      titleEl.className = 'ms-title';
      titleEl.textContent = m.title;

      const descEl = document.createElement('div');
      descEl.className = 'ms-desc';
      descEl.textContent = m.desc;

      const badgeEl = document.createElement('span');
      badgeEl.className = `ms-badge ${m.badgeClass}`;
      badgeEl.textContent = m.badgeLabel;

      body.appendChild(dateEl);
      body.appendChild(titleEl);
      body.appendChild(descEl);
      body.appendChild(badgeEl);
      item.appendChild(marker);
      item.appendChild(body);
      listEl.appendChild(item);
    });

    // ── CTA text ──
    const sampleLabel = (svc==='odm'||svc==='private') ? '13-day' : '14-day';
    if (daysToStart < 0) {
      document.getElementById('cta-p').textContent = 'Your timeline is critical. Contact SDF Clothing now — we assess urgent orders and offer air freight solutions where the timeline allows it.';
    } else {
      document.getElementById('cta-p').textContent = `You need to start by ${fmtLong(startDate)}. SDF offers ${sampleLabel} sample turnaround and ${prod}-day bulk production. Production slots fill ${total > 90 ? '90' : '60'} days ahead of peak season.`;
    }

    // ── Show results ──
    resultsEl.classList.add('show');
    resultsEl.scrollIntoView({ behavior:'smooth', block:'start' });
  });

  // ── FAQ ──
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.classList.remove('open');
      });
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.classList.add('open');
      }
    });
  });
</script>

