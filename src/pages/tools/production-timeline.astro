<script>
  function addDays(d, n) { const x = new Date(d); x.setDate(x.getDate() + n); return x; }
  function subDays(d, n) { const x = new Date(d); x.setDate(x.getDate() - n); return x; }
  function fmtFull(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
  function fmtShort(d) { return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); }
  function daysBetween(a, b) { return Math.round((b - a) / (1000 * 60 * 60 * 24)); }

  const dateErrorEl = document.getElementById('date-error');

  document.getElementById('calc-btn').addEventListener('click', () => {
    const launchVal = document.getElementById('launch-date').value;
    if (!launchVal) {
      dateErrorEl.classList.add('visible');
      document.getElementById('launch-date').focus();
      return;
    }
    dateErrorEl.classList.remove('visible');

    const launch   = new Date(launchVal);
    const svc      = document.getElementById('service-type').value;
    const qty      = document.getElementById('order-qty').value;
    const shipMode = document.getElementById('ship-mode').value;
    const today    = new Date(); today.setHours(0, 0, 0, 0);

    const freightDays = shipMode === 'air' ? 7 : 43;
    const customsDays = 5;
    const prodDays    = { small: 30, medium: 40, large: 52, xlarge: 68 }[qty];
    const sampleDays  = (svc === 'odm' || svc === 'private') ? 13 : 18;
    const ppDays      = svc === 'cmt' ? 0 : 10;
    const ppReviewDays = svc === 'cmt' ? 0 : 5;
    const buyerReviewDays = 7;
    const confirmDays = 4;
    const techPackDays = (svc === 'oem' || svc === 'cmt') ? 3 : 0;

    const totalDays = techPackDays + confirmDays + sampleDays + buyerReviewDays + ppDays + ppReviewDays + prodDays + freightDays + customsDays;

    const portArr     = subDays(launch, customsDays);
    const shipDepart  = subDays(portArr, freightDays);
    const exFactory   = subDays(shipDepart, 3);
    const bulkStart   = subDays(exFactory, prodDays);
    const ppApprove   = subDays(bulkStart, ppReviewDays);
    const ppReady     = subDays(ppApprove, ppDays);
    const protoApprove = ppDays > 0 ? subDays(ppReady, buyerReviewDays) : subDays(bulkStart, buyerReviewDays);
    const protoReady  = subDays(protoApprove, sampleDays);
    const orderConfirm = subDays(protoReady, confirmDays);
    const techPackDue = subDays(orderConfirm, techPackDays + 1);
    const startDate   = (svc === 'oem' || svc === 'cmt') ? techPackDue : orderConfirm;

    const daysToStart  = daysBetween(today, startDate);

    let alertHtml;
    if (daysToStart < 0) {
      alertHtml = `<div class="alert alert-red" role="alert">⚠ Your start deadline has already passed by ${Math.abs(daysToStart)} days. Air freight can recover some of that time but will increase your unit cost. Contact SDF now for a fast-track assessment.</div>`;
    } else if (daysToStart <= 14) {
      alertHtml = `<div class="alert alert-yellow" role="alert">⚡ You need to start in ${daysToStart} days. This is tight. Contact SDF today to check slot availability — air freight may be needed to make this work.</div>`;
    } else {
      alertHtml = `<div class="alert alert-green" role="alert">✓ This timeline is achievable. Start no later than <strong>${fmtFull(startDate)}</strong> to hit your launch date.</div>`;
    }
    document.getElementById('alert-box').innerHTML = alertHtml;

    document.getElementById('s-start').textContent = fmtShort(startDate);
    document.getElementById('s-lead').textContent = totalDays + ' days';
    document.getElementById('s-launch').textContent = fmtShort(launch);

    const tagLabels = { sdf: 'SDF Action', buyer: 'Your Action', ship: 'Logistics', target: 'Your Launch' };
    const milestones = [];

    if (svc === 'oem' || svc === 'cmt') {
      milestones.push({ date: techPackDue, title: 'Submit Tech Pack / Spec Sheet', desc: 'Send your complete tech pack — measurements, construction notes, bill of materials, fabric spec, and artwork. Gaps here are the most common cause of delays before sampling even begins.', tag: 'buyer' });
    }
    milestones.push({ date: orderConfirm, title: 'Order Confirmation + 30% Deposit', desc: 'Confirm final quantities, colourways, size ratio, incoterms, and pay the deposit. The factory does not begin sampling until the payment clears.', tag: 'buyer' });
    milestones.push({ date: protoReady, title: 'Proto / First Sample Ready', desc: (svc === 'odm' || svc === 'private') ? 'SDF delivers first prototype based on existing base pattern — typically faster turnaround.' : 'SDF delivers first prototype based on your tech pack for fit, construction, and fabric review.', tag: 'sdf' });
    milestones.push({ date: protoApprove, title: 'Proto Sample Approval', desc: 'Review the sample against your spec, measure carefully, and send written approval or clear revision comments. Each extra revision round adds 12 to 18 days to your schedule.', tag: 'buyer' });
    if (ppDays > 0) {
      milestones.push({ date: ppReady, title: 'Pre-Production Sample Ready', desc: 'Final sample made in actual bulk fabric and confirmed trims. Must match the approved proto exactly. This is your sign-off before the full production run begins.', tag: 'sdf' });
      milestones.push({ date: ppApprove, title: 'PP Sample Sign-Off Required', desc: 'Written approval is mandatory — bulk production cannot begin without it. Review within five days to protect your production start date.', tag: 'buyer' });
    }
    milestones.push({ date: bulkStart, title: 'Bulk Production Starts', desc: `Fabric cut, sewing lines assigned, trims staged. ${prodDays} production days. SDF shares weekly production progress reports throughout.`, tag: 'sdf' });
    milestones.push({ date: exFactory, title: 'Ex-Factory — Final QC + Packing', desc: 'AQL final inspection, carton packing, export documentation. Balance payment (70%) is due before shipment release.', tag: 'sdf' });
    milestones.push({ date: shipDepart, title: shipMode === 'air' ? 'Air Shipment Departs Dhaka' : 'Sea Container Departs Chittagong', desc: shipMode === 'air' ? 'Air freight via Dhaka Hazrat Shahjalal Airport. Approximately 5 to 7 days transit to destination.' : 'FCL or LCL container from Chittagong. Approximately 40 to 43 days transit to destination port.', tag: 'ship' });
    milestones.push({ date: launch, title: '🎯 Goods In Hand — Launch Ready', desc: 'Goods arrive at destination port, clear customs, and are delivered to your warehouse or 3PL. Ready for launch, retail drop, Amazon FBA, or wholesale delivery.', tag: 'target' });

    const timelineEl = document.getElementById('timeline');
    timelineEl.innerHTML = '';
    milestones.forEach(m => {
      const isUrgent = daysBetween(today, m.date) <= 7 && today <= m.date;
      const isPast = today > m.date;

      const item = document.createElement('div');
      item.className = 'tl-item';

      const dotCol = document.createElement('div');
      dotCol.className = 'tl-dot-col';
      const dot = document.createElement('div');
      dot.className = 'tl-dot' + (isPast ? ' done' : isUrgent ? ' warn' : m.tag === 'target' ? ' target' : '');
      dotCol.appendChild(dot);

      const body = document.createElement('div');
      body.className = 'tl-body';

      const dateEl = document.createElement('div');
      dateEl.className = 'tl-date' + (isUrgent ? ' urgent' : '');
      dateEl.textContent = fmtFull(m.date);

      const titleEl = document.createElement('div');
      titleEl.className = 'tl-title';
      titleEl.textContent = m.title;

      const descEl = document.createElement('div');
      descEl.className = 'tl-desc';
      descEl.textContent = m.desc;

      const tagEl = document.createElement('span');
      tagEl.className = 'tl-tag ' + m.tag;
      tagEl.textContent = tagLabels[m.tag];

      body.appendChild(dateEl);
      body.appendChild(titleEl);
      body.appendChild(descEl);
      body.appendChild(tagEl);
      item.appendChild(dotCol);
      item.appendChild(body);
      timelineEl.appendChild(item);
    });

    if (daysToStart < 0) {
      document.getElementById('cta-text').textContent = 'Your timeline is critical. Contact SDF Clothing right away — we offer fast-track assessments and air freight for urgent orders.';
    } else {
      const sampleTime = (svc === 'odm' || svc === 'private') ? '13-day' : '14-day';
      document.getElementById('cta-text').textContent = `You need to start by ${fmtFull(startDate)}. SDF Clothing offers ${sampleTime} sample turnaround and ${prodDays}-day bulk production from a confirmed order. Production slots fill ${totalDays > 90 ? '90' : '60'} days ahead of peak season.`;
    }

    const resultsEl = document.getElementById('results');
    resultsEl.classList.add('visible');
    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* FAQ accordion */
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.classList.remove('open');
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.classList.add('open');
      }
    });
  });
</script>

