---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Clothing Production Timeline Calculator — Plan From Launch Date Backwards";
const pageDescription = "Free clothing production timeline calculator. Enter your launch date and get every deadline mapped backwards — tech pack, sampling, production, QC, and freight.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}

  dateModified={new Date().toISOString().split("T")[0]}
>

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />








<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://sdfltd.com/tools/production-timeline#app",
      "name": "Clothing Production Timeline Calculator",
      "url": "https://sdfltd.com/tools/production-timeline",
      "description": "Free production timeline calculator for clothing brands. Enter a target launch or in-hand date and get every milestone mapped backwards — tech pack submission, proto sampling, pre-production sample approval, bulk production start, QC, packing, and sea or air freight transit. Built for brands sourcing from Bangladesh.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Fashion Production Planning Tool",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "isAccessibleForFree": true,
      "featureList": [
        "Launch date reverse-engineering",
        "Season preset shortcuts",
        "Live countdown to start deadline",
        "Status-based color coding per milestone",
        "Milestone done tracker",
        "Sea and air freight options",
        "OEM, ODM, CMT, and private label support",
        "Urgency alerts when timeline is at risk"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "@id": "https://sdfltd.com/#org"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://sdfltd.com/tools" },
        { "@type": "ListItem", "position": 3, "name": "Production Timeline Calculator", "item": "https://sdfltd.com/tools/production-timeline" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does clothing production take from Bangladesh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard OEM order of 500 to 2,000 pieces from Bangladesh takes roughly 90 days from tech pack confirmation to goods arriving in your warehouse by sea freight — around 3 to 5 days for order confirmation, 14 to 18 days for proto sampling, 7 days for buyer review, 7 to 10 days for the pre-production sample, 40 days for bulk cut and sew, and 40 to 43 days for sea freight from Chittagong. ODM and private label orders are somewhat faster because the factory starts from existing patterns."
          }
        },
        {
          "@type": "Question",
          "name": "When do I need to start production to hit a Christmas launch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For goods in a US warehouse by 1 December by sea freight from Bangladesh, a container typically needs to leave Chittagong around 10 to 15 October. Working back from there, bulk production needs to start by around 1 September, pre-production sample sign-off by 20 August, and tech pack submission by early-to-mid July at the latest."
          }
        },
        {
          "@type": "Question",
          "name": "What is a pre-production sample and why does it matter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pre-production sample (PP sample) is made in the actual bulk fabric and confirmed trims, after the first proto sample has been approved. It is the final check before cutting begins on the full order. Any issues found at this stage are far cheaper to fix than after the bulk run is complete."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use air freight from Bangladesh if my timeline is too tight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Air freight from Dhaka takes roughly 5 to 7 days compared with 40 to 43 days by sea from Chittagong. The trade-off is cost — air freight runs approximately four to five times more per kilogram than sea, which can add significantly to your landed cost per unit."
          }
        },
        {
          "@type": "Question",
          "name": "What is the biggest cause of delays in clothing production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The single most common cause is an incomplete tech pack at the start, which forces the factory to ask clarifying questions before they can begin — sometimes delaying the sample by one to two weeks before anything is cut. The second is slow sample approval: every additional revision round adds 12 to 18 days."
          }
        }
      ]
    }
  ]
}
</script>

<style>
  :root {
    --r: #e00;
    --rd: #c00;
    --g: #22c55e;
    --y: #f59e0b;
    --b: #60a5fa;
    --border: rgba(255,255,255,0.08);
    --surface: #0d0d0d;
    --text: rgba(255,255,255,0.65);
    --muted: rgba(255,255,255,0.35);
    --label: rgba(255,255,255,0.68);
  }

  .tool-page { max-width: 960px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }

  /* Breadcrumb */
  .crumb-nav ol { display:flex; gap:0.5rem; list-style:none; font-size:0.7rem; color:var(--muted); flex-wrap:wrap; margin-bottom:2rem; }
  .crumb-nav a { color:var(--muted); text-decoration:none; }
  .crumb-nav a:hover { color:#fff; }
  .crumb-sep { color:rgba(255,255,255,0.15); }

  /* Hero */
  .hero { margin-bottom:2rem; }
  .hero-eyebrow { font-size:0.66rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--r); font-weight:600; margin-bottom:0.75rem; display:block; }
  .hero h1 { font-size:clamp(1.8rem,3.5vw,2.6rem); font-weight:200; color:#fff; letter-spacing:0.02em; line-height:1.15; margin:0 0 0.8rem; }
  .hero h1 em { font-style:normal; color:var(--r); }
  .hero-sub { font-size:0.9rem; color:var(--text); max-width:560px; line-height:1.85; margin-bottom:1.25rem; }
  .pill-row { display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:0; }
  .pill { font-size:0.67rem; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted); border:0.5px solid rgba(255,255,255,0.1); padding:0.28rem 0.7rem; border-radius:100px; }

  /* App layout */
  .app {
    display:grid; grid-template-columns:290px 1fr;
    border:0.5px solid var(--border); border-radius:6px; overflow:hidden;
    margin:2rem 0 3rem;
  }
  @media(max-width:720px){ .app { grid-template-columns:1fr; } }

  /* Left panel */
  .left {
    background:var(--surface); border-right:0.5px solid var(--border);
    padding:1.25rem 1rem; display:flex; flex-direction:column; gap:1rem;
    overflow-y:auto;
  }
  @media(max-width:720px){ .left { border-right:none; border-bottom:0.5px solid var(--border); } }

  .sec-lbl { font-size:0.62rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted); margin-bottom:0.45rem; display:block; }

  /* Countdown */
  .cd-box { background:#000; border:0.5px solid var(--border); border-radius:5px; padding:1rem 0.75rem; text-align:center; }
  .cd-num { font-size:2.8rem; font-weight:200; line-height:1; margin-bottom:0.2rem; transition:color 0.3s; }
  .cd-sub { font-size:0.68rem; letter-spacing:0.1em; text-transform:uppercase; transition:color 0.3s; }
  .cd-bar { height:3px; border-radius:100px; margin-top:0.75rem; transition:background 0.3s, width 0.5s; }

  /* Season grid */
  .sg { display:grid; grid-template-columns:1fr 1fr; gap:0.4rem; }
  .sb {
    background:#000; border:0.5px solid var(--border); border-radius:4px;
    padding:0.55rem 0.5rem; font-size:0.7rem; color:var(--text);
    cursor:pointer; text-align:center; font-family:inherit; line-height:1.35;
    transition:all 0.15s;
  }
  .sb:hover { border-color:var(--r); color:var(--r); }
  .sb.active { border-color:var(--r); background:rgba(238,0,0,0.07); color:var(--r); }
  .sb strong { display:block; font-size:0.65rem; font-weight:600; margin-bottom:0.15rem; }
  .sb:focus-visible { outline:2px solid var(--r); outline-offset:2px; }

  /* Inputs */
  .ig { display:flex; flex-direction:column; gap:0.35rem; }
  .ig label { font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); }
  .ig input, .ig select {
    background:#000; color:#fff; border:0.5px solid var(--border);
    padding:0.65rem 0.75rem; font-size:0.84rem; width:100%;
    border-radius:4px; font-family:inherit; appearance:none; -webkit-appearance:none;
    outline:none; color-scheme:dark; min-height:40px; transition:border-color 0.18s;
  }
  .ig input:focus, .ig select:focus { border-color:var(--r); outline:2px solid rgba(238,0,0,0.18); outline-offset:2px; }
  .ig select option { background:#111; }

  /* Alert pill */
  .ap {
    border-radius:4px; padding:0.65rem 0.75rem; font-size:0.76rem;
    line-height:1.55; display:flex; align-items:flex-start; gap:0.5rem;
    border:0.5px solid; transition:all 0.3s;
  }
  .ap-icon { flex-shrink:0; font-size:0.9rem; margin-top:1px; }
  .ap-g { background:rgba(34,197,94,0.07); border-color:rgba(34,197,94,0.3); color:#15803d; }
  .ap-y { background:rgba(245,158,11,0.07); border-color:rgba(245,158,11,0.3); color:#b45309; }
  .ap-r { background:rgba(238,0,0,0.07); border-color:rgba(238,0,0,0.3); color:#b91c1c; }

  /* Right panel */
  .right { background:#000; padding:1.25rem 1.1rem; min-height:420px; }

  .empty-state {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    height:100%; min-height:340px; gap:0.75rem; text-align:center; color:var(--muted);
  }
  .empty-icon { font-size:2.5rem; opacity:0.2; }
  .empty-state p { font-size:0.84rem; max-width:200px; line-height:1.65; }

  /* Summary */
  .sum-row { display:grid; grid-template-columns:repeat(3,1fr); gap:0.5rem; margin-bottom:1rem; }
  @media(max-width:480px){ .sum-row { grid-template-columns:1fr; } }
  .sc { border-radius:4px; padding:0.75rem 0.85rem; border:0.5px solid; }
  .sc-lbl { font-size:0.61rem; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.3rem; }
  .sc-val { font-size:1.25rem; font-weight:200; line-height:1; }

  /* Summary color states */
  .sc-green { background:rgba(34,197,94,0.07); border-color:rgba(34,197,94,0.3); }
  .sc-green .sc-lbl { color:#15803d; } .sc-green .sc-val { color:#22c55e; }
  .sc-amber { background:rgba(245,158,11,0.07); border-color:rgba(245,158,11,0.3); }
  .sc-amber .sc-lbl { color:#b45309; } .sc-amber .sc-val { color:#f59e0b; }
  .sc-red { background:rgba(238,0,0,0.07); border-color:rgba(238,0,0,0.3); }
  .sc-red .sc-lbl { color:#b91c1c; } .sc-red .sc-val { color:#ef4444; }
  .sc-neutral { background:var(--surface); border-color:var(--border); }
  .sc-neutral .sc-lbl { color:var(--muted); } .sc-neutral .sc-val { color:#fff; }

  /* Progress bar */
  .pbar-wrap { margin-bottom:1.1rem; }
  .pbar-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem; }
  .pbar-lbl { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); }
  .pbar-pct { font-size:0.72rem; font-weight:500; transition:color 0.3s; }
  .pbar-track { height:5px; background:rgba(255,255,255,0.07); border-radius:100px; overflow:hidden; }
  .pbar-fill { height:100%; border-radius:100px; transition:width 0.7s cubic-bezier(.25,.8,.25,1), background 0.4s; }
  .pbar-phases { display:flex; gap:0.85rem; margin-top:0.5rem; flex-wrap:wrap; }
  .pbar-phase { display:flex; align-items:center; gap:0.3rem; font-size:0.65rem; color:var(--muted); }
  .phase-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }

  /* Milestones */
  .ms-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:0.85rem; }
  .ms-hl { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); }
  .ms-meta { font-size:0.7rem; color:var(--muted); }

  .ms-list { position:relative; display:flex; flex-direction:column; }
  .ms-list::before { content:''; position:absolute; left:10px; top:10px; bottom:10px; width:0.5px; background:var(--border); z-index:0; }

  .ms-item { display:flex; gap:0.85rem; padding-bottom:0.85rem; position:relative; }
  .ms-item:last-child { padding-bottom:0; }

  .ms-dot-col { flex-shrink:0; width:20px; display:flex; justify-content:center; padding-top:4px; z-index:1; }
  .ms-dot { width:10px; height:10px; border-radius:50%; border:1.5px solid; flex-shrink:0; transition:all 0.2s; }

  /* Dot colors */
  .dot-done     { background:var(--g); border-color:var(--g); box-shadow:0 0 0 3px rgba(34,197,94,0.15); }
  .dot-past     { background:var(--g); border-color:var(--g); }
  .dot-critical { background:#ef4444; border-color:#ef4444; box-shadow:0 0 8px rgba(239,68,68,0.5); }
  .dot-warning  { background:var(--y); border-color:var(--y); box-shadow:0 0 6px rgba(245,158,11,0.4); }
  .dot-ok       { background:transparent; border-color:rgba(255,255,255,0.2); }
  .dot-launch   { background:var(--r); border-color:var(--r); box-shadow:0 0 10px rgba(238,0,0,0.5); }

  /* Milestone cards */
  .ms-card { border-radius:4px; border:0.5px solid; padding:0.75rem 0.9rem; transition:border-color 0.2s, background 0.2s; }

  .mc-done     { background:rgba(34,197,94,0.06); border-color:rgba(34,197,94,0.3); }
  .mc-past     { background:rgba(34,197,94,0.04); border-color:rgba(34,197,94,0.15); }
  .mc-critical { background:rgba(239,68,68,0.06); border-color:rgba(239,68,68,0.3); }
  .mc-warning  { background:rgba(245,158,11,0.05); border-color:rgba(245,158,11,0.25); }
  .mc-ok       { background:var(--surface); border-color:var(--border); }
  .mc-launch   { background:rgba(238,0,0,0.06); border-color:rgba(238,0,0,0.3); }

  .ms-date { font-size:0.67rem; letter-spacing:0.08em; text-transform:uppercase; margin-bottom:0.2rem; font-weight:500; }
  .date-done     { color:#16a34a; }
  .date-past     { color:#16a34a; }
  .date-critical { color:#ef4444; }
  .date-warning  { color:#d97706; }
  .date-ok       { color:var(--muted); }
  .date-launch   { color:var(--r); }

  .ms-title { font-size:0.88rem; font-weight:500; color:#fff; line-height:1.3; margin-bottom:0.25rem; }
  .ms-desc  { font-size:0.76rem; color:var(--muted); line-height:1.65; margin-bottom:0.5rem; }

  .ms-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.4rem; }
  .ms-right  { display:flex; align-items:center; gap:0.4rem; }

  /* Badges */
  .badge { font-size:0.62rem; padding:0.18rem 0.55rem; border-radius:100px; border:0.5px solid; display:inline-flex; align-items:center; gap:0.25rem; letter-spacing:0.05em; }
  .bg-factory { border-color:rgba(238,0,0,0.3); color:#b91c1c; }
  .bg-buyer   { border-color:rgba(255,255,255,0.18); color:var(--muted); }
  .bg-ship    { border-color:rgba(96,165,250,0.3); color:#60a5fa; }
  .bg-launch  { border-color:rgba(34,197,94,0.3); color:#22c55e; }

  /* Status chips */
  .chip { font-size:0.62rem; padding:0.18rem 0.55rem; border-radius:100px; border:0.5px solid; font-weight:500; }
  .chip-done     { background:rgba(34,197,94,0.12); border-color:rgba(34,197,94,0.4); color:#16a34a; }
  .chip-past     { background:rgba(34,197,94,0.08); border-color:rgba(34,197,94,0.25); color:#16a34a; }
  .chip-critical { background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.35); color:#ef4444; }
  .chip-warning  { background:rgba(245,158,11,0.1); border-color:rgba(245,158,11,0.35); color:#d97706; }
  .chip-ok       { background:var(--surface); border-color:var(--border); color:var(--muted); }
  .chip-launch   { background:rgba(238,0,0,0.1); border-color:rgba(238,0,0,0.35); color:var(--r); }

  /* Mark done button */
  .chk-btn {
    background:none; border:0.5px solid var(--border); border-radius:4px;
    padding:0.2rem 0.55rem; font-size:0.62rem; color:var(--muted); cursor:pointer;
    font-family:inherit; display:flex; align-items:center; gap:0.25rem;
    transition:all 0.15s; white-space:nowrap;
  }
  .chk-btn:hover { border-color:var(--g); color:var(--g); }
  .chk-btn.done { border-color:rgba(34,197,94,0.5); color:var(--g); background:rgba(34,197,94,0.08); }
  .chk-btn:focus-visible { outline:2px solid var(--g); outline-offset:2px; }

  /* CTA box */
  .cta-box {
    background:var(--surface); border:0.5px solid var(--border);
    border-radius:5px; padding:1rem 1.1rem;
    display:flex; align-items:center; justify-content:space-between;
    gap:0.75rem; flex-wrap:wrap; margin-top:1rem;
  }
  .cta-box p { font-size:0.78rem; color:var(--text); line-height:1.6; flex:1; }
  .btn-solid {
    background:var(--r); color:#fff; border:none; padding:0.7rem 1.25rem;
    font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase;
    border-radius:3px; font-family:inherit; cursor:pointer; white-space:nowrap;
    text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem;
    transition:background 0.18s; min-height:40px;
  }
  .btn-solid:hover { background:var(--rd); }
  .btn-solid:focus-visible { outline:2px solid #fff; outline-offset:2px; }
  .whatsapp-btn {
    background:transparent; color:var(--g); border:0.5px solid rgba(34,197,94,0.4);
    padding:0.7rem 1.1rem; font-size:0.72rem; letter-spacing:0.12em;
    text-transform:uppercase; border-radius:3px; font-family:inherit;
    cursor:pointer; white-space:nowrap; text-decoration:none;
    display:inline-flex; align-items:center; gap:0.35rem;
    transition:background 0.18s; min-height:40px;
  }
  .whatsapp-btn:hover { background:rgba(34,197,94,0.08); }
  .cta-btns { display:flex; gap:0.5rem; flex-wrap:wrap; }

  .disclaimer { font-size:0.69rem; color:var(--muted); line-height:1.7; margin-top:0.85rem; padding-top:0.85rem; border-top:0.5px solid var(--border); }

  /* SEO content */
  .seo { border-top:0.5px solid var(--border); padding-top:3rem; }
  .seo h2 { font-size:1.3rem; font-weight:300; color:#fff; margin:2.5rem 0 0.9rem; letter-spacing:0.03em; }
  .seo h2:first-child { margin-top:0; }
  .seo h3 { font-size:0.97rem; font-weight:500; color:#fff; margin:1.75rem 0 0.55rem; }
  .seo p { font-size:0.875rem; color:var(--text); line-height:1.9; margin-bottom:1rem; }
  .seo ul { margin:0.75rem 0 1rem; padding:0; list-style:none; }
  .seo li { font-size:0.875rem; color:var(--text); line-height:1.8; padding-left:1.2rem; position:relative; margin-bottom:0.3rem; }
  .seo li::before { content:'—'; position:absolute; left:0; color:var(--r); }
  .seo a { color:var(--r); text-decoration:none; }
  .seo a:hover { text-decoration:underline; }
  .last-updated { font-size:0.69rem; color:var(--muted); margin-bottom:2rem; }

  .data-table { width:100%; border-collapse:collapse; margin:1.25rem 0; font-size:0.82rem; }
  .data-table th { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); padding:0.6rem 0.75rem; border-bottom:0.5px solid var(--border); text-align:left; font-weight:400; }
  .data-table td { padding:0.65rem 0.75rem; color:var(--text); border-bottom:0.5px solid rgba(255,255,255,0.04); vertical-align:top; }
  .data-table tr:last-child td { border-bottom:none; }
  .data-table td:first-child { color:#fff; font-weight:500; }

  .season-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.5px; background:var(--border); margin:1.25rem 0; border-radius:3px; overflow:hidden; }
  @media(max-width:460px){ .season-grid { grid-template-columns:1fr; } }
  .sg-item { background:#000; padding:0.9rem 1rem; }
  .sg-item strong { color:#fff; font-size:0.82rem; display:block; margin-bottom:0.2rem; }
  .sg-item span { color:var(--muted); font-size:0.76rem; line-height:1.6; }

  /* FAQ accordion */
  .faq-list { margin:1.25rem 0; }
  .faq-item { border-bottom:0.5px solid var(--border); }
  .faq-item:first-child { border-top:0.5px solid var(--border); }
  .faq-btn {
    width:100%; background:none; border:none; color:#fff; cursor:pointer;
    padding:1rem 0; font-size:0.88rem; font-weight:500; font-family:inherit;
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
    text-align:left; line-height:1.45; transition:color 0.15s;
  }
  .faq-btn:hover { color:var(--r); }
  .faq-btn:focus-visible { outline:2px solid var(--r); outline-offset:3px; }
  .faq-icon {
    flex-shrink:0; width:22px; height:22px; border:0.5px solid rgba(255,255,255,0.2);
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:0.85rem; color:rgba(255,255,255,0.4); transition:all 0.22s;
  }
  .faq-btn[aria-expanded="true"] .faq-icon { border-color:var(--r); color:var(--r); transform:rotate(45deg); }
