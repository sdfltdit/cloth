        <option value="air">Air Freight (~5 days from Dhaka)</option>
      </select>
    </div>
  </div>

  <button class="calc-btn" onclick="buildTimeline()" aria-label="Calculate production timeline">
    Build My Production Timeline →
  </button>

  <!-- RESULTS -->
  <div class="results" id="results" aria-live="polite">

    <div id="alert-box"></div>

    <div class="sum-grid">
      <div class="sum-item">
        <div class="s-lbl">Start No Later Than</div>
        <div class="s-val" id="s-start">—</div>
      </div>
      <div class="sum-item">
        <div class="s-lbl">Total Lead Time</div>
        <div class="s-val" id="s-lead">—</div>
      </div>
      <div class="sum-item">
        <div class="s-lbl">Target Launch Date</div>
        <div class="s-val" id="s-launch">—</div>
      </div>
    </div>

    <div class="tl-wrap" id="timeline" aria-label="Production timeline milestones"></div>

    <div class="tool-cta">
      <p id="cta-text">SDF Clothing offers 14-day sample turnaround and 40-day bulk production from confirmed order. Production slots fill 60–90 days ahead of peak season — secure yours today.</p>
