---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Apparel Production Timeline Calculator — Reverse-Engineer Your Launch Date | SDF Clothing";
const pageDescription = "Free clothing production timeline calculator. Enter your target launch date and instantly get every deadline reverse-engineered — tech pack submission, sample approval, bulk cut date, and shipment. Never miss a fashion season. No signup needed.";
const canonicalUrl = "https://sdfltd.com/tools/production-timeline";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  dateModified={new Date().toISOString().split("T")[0]}
>

<meta name="robots" content="index, follow" />
<meta property="og:title" content="Apparel Production Timeline Calculator — Reverse-Engineer Your Launch Date" />
<meta property="og:description" content="Free tool for clothing brands. Enter your launch date, get every production deadline reverse-engineered. Tech pack, sampling, bulk production, shipment — all mapped out instantly." />
<meta property="og:url" content="https://sdfltd.com/tools/production-timeline" />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="Apparel Production Timeline Calculator — Never Miss a Season" />
<meta name="twitter:description" content="Enter your target launch date and get every production deadline mapped out — tech pack, sampling, bulk production, shipment. Free for clothing brands." />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://sdfltd.com/tools/production-timeline#app",
      "name": "Apparel Production Timeline Calculator",
      "url": "https://sdfltd.com/tools/production-timeline",
      "description": "Free clothing production timeline calculator that reverse-engineers every deadline from your target launch date. Covers tech pack submission, proto sampling, pre-production sample approval, bulk production, QC, and sea or air shipment.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Fashion Production Planning Tool",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "featureList": [
        "Launch date reverse-engineering",
        "Tech pack submission deadline",
        "Sample approval milestones",
        "Bulk production start date",
        "Sea and air freight timeline",
        "OEM, ODM, CMT, and private label support",
        "Urgency alerts when timeline is at risk"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "@id": "https://sdfltd.com/#org"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://sdfltd.com/tools" },
        { "@type": "ListItem", "position": 3, "name": "Production Timeline Calculator", "item": "https://sdfltd.com/tools/production-timeline" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does clothing manufacturing take from Bangladesh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Total clothing production lead time from Bangladesh typically ranges from 60 to 120 days depending on order complexity and quantity. A standard order of 500–2,000 pieces with OEM production takes approximately 90 days from tech pack approval to goods delivered by sea freight: 3–5 days order confirmation, 14–18 days proto sampling, 7 days buyer review, 7–10 days pre-production sample, 40 days bulk production, and 40–42 days sea freight from Chittagong."
          }
        },
        {
          "@type": "Question",
          "name": "What is a clothing production timeline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A clothing production timeline is a reverse-engineered schedule that maps every milestone from design confirmation to goods delivery, working backward from your target launch or ship date. It covers tech pack submission, fabric sourcing, proto sampling, pre-production sample approval, bulk cut and sew, quality control inspection, packing, export documentation, and sea or air freight transit."
          }
        },
        {
          "@type": "Question",
          "name": "When should I start production for a Christmas or Holiday launch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a December 1st Christmas launch in the USA with sea freight from Bangladesh, you need goods to depart Chittagong by approximately October 10th. That means bulk production must start by September 1st, pre-production sample approval by August 20th, and tech pack submission by July 10th at the latest. The calculator above will give you exact dates based on your specific garment type and order quantity."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between OEM, ODM, CMT, and private label production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OEM (Original Equipment Manufacturer): You provide the full tech pack and designs; the factory manufactures to your specifications. ODM (Original Design Manufacturer): The factory has existing base designs that you can modify and brand. CMT (Cut, Make, Trim): You supply your own fabric; the factory handles cutting, sewing, and finishing only. Private Label: The factory has ready-made styles you brand as your own with minimal modification. OEM has the longest lead time; CMT and private label are typically fastest."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get air freight from Bangladesh if my timeline is tight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. SDF Clothing ships via air freight from Dhaka Hazrat Shahjalal International Airport. Air transit is 5–7 days versus 40–42 days by sea from Chittagong. However, air freight costs approximately 4–5 times more per unit than sea freight, so it significantly increases your landed cost. Use our Garment Cost Calculator to compare the total cost impact of air vs sea before deciding."
          }
        }
      ]
    }
  ]
}
</script>

<style>
.tool-page { max-width: 920px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }

.tool-hero { margin-bottom: 2.5rem; }
.tool-hero h1 { font-size: clamp(1.9rem, 3.5vw, 2.7rem); font-weight: 300; color: #fff; letter-spacing: 0.03em; line-height: 1.2; margin-bottom: 0.75rem; }
.tool-hero .sub { font-size: 0.9rem; color: rgba(255,255,255,0.6); max-width: 620px; line-height: 1.85; margin-bottom: 1.25rem; }
.trust-row { display: flex; flex-wrap: wrap; gap: 1rem; }
.trust-item { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.35); display: flex; align-items: center; gap: 0.35rem; }
.trust-item::before { content: '✓'; color: #e00; }

.calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin: 2rem 0 1.25rem; }
@media (max-width: 580px) { .calc-grid { grid-template-columns: 1fr; } }

.field-group { display: flex; flex-direction: column; gap: 0.45rem; }
.field-group label { font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.45); }
.field-group select, .field-group input {
  background: #000; color: #fff; border: 1px solid rgba(255,255,255,0.12);
  padding: 0.75rem 1rem; font-size: 0.87rem; width: 100%;
  transition: border-color 0.2s; outline: none; font-family: inherit;
  appearance: none; -webkit-appearance: none; color-scheme: dark;
}
.field-group select:focus, .field-group input:focus { border-color: #e00; outline: 2px solid rgba(238,0,0,0.2); outline-offset: 2px; }
.field-group select option { background: #111; }
.field-hint { font-size: 0.7rem; color: rgba(255,255,255,0.28); margin-top: 0.2rem; }

.calc-btn {
  width: 100%; background: #e00; color: #fff; border: none;
  padding: 1rem; font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase;
  cursor: pointer; transition: background 0.2s; font-family: inherit; min-height: 52px;
  margin-top: 0.25rem; margin-bottom: 2.5rem;
}
.calc-btn:hover { background: #c00; }

/* Results */
.results { display: none; animation: fadeInUp 0.4s ease; }
.results.visible { display: block; }
@keyframes fadeInUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }

/* Alert */
.alert { padding: 1rem 1.25rem; margin-bottom: 1.5rem; border-left: 3px solid; font-size: 0.85rem; line-height: 1.7; }
.alert-green  { border-color: #4ade80; background: rgba(74,222,128,0.05); color: #4ade80; }
.alert-yellow { border-color: #facc15; background: rgba(250,204,21,0.05); color: #facc15; }
.alert-red    { border-color: #e00; background: rgba(238,0,0,0.05); color: #ff6b6b; }

/* Summary */
.sum-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,0.07); margin-bottom: 2rem; }
@media(max-width:480px){ .sum-grid { grid-template-columns: 1fr; } }
.sum-item { background: #000; padding: 1.1rem 1rem; }
.sum-item .s-lbl { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.38); margin-bottom: 0.3rem; }
.sum-item .s-val { font-size: 1.2rem; font-weight: 300; color: #fff; }

/* Timeline */
.tl-wrap { position: relative; margin-bottom: 2.5rem; }
.tl-wrap::before { content:''; position:absolute; left:14px; top:0; bottom:0; width:1px; background:rgba(255,255,255,0.08); }
.tl-item { display:flex; gap:1.5rem; position:relative; }
.tl-dot-col { flex-shrink:0; width:30px; display:flex; align-items:flex-start; padding-top:3px; }
.tl-dot { width:10px; height:10px; border-radius:50%; background:#e00; z-index:1; flex-shrink:0; }
.tl-dot.done  { background:#4ade80; }
.tl-dot.warn  { background:#facc15; }
.tl-dot.late  { background:#ff4444; box-shadow:0 0 8px rgba(255,68,68,0.4); }
.tl-dot.target{ background:#e00; box-shadow:0 0 10px rgba(238,0,0,0.5); }
.tl-body { flex:1; padding-bottom:1.5rem; border-bottom:1px solid rgba(255,255,255,0.05); }
.tl-item:last-child .tl-body { border-bottom:none; }
.tl-date { font-size:0.7rem; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.35); margin-bottom:0.2rem; }
.tl-date.urgent { color:#e00; font-weight:500; }
.tl-title { font-size:0.95rem; font-weight:500; color:#fff; margin-bottom:0.2rem; }
.tl-desc  { font-size:0.8rem; color:rgba(255,255,255,0.42); line-height:1.65; }
.tl-tag { display:inline-block; font-size:0.6rem; letter-spacing:0.1em; text-transform:uppercase; padding:0.18rem 0.45rem; border:1px solid; margin-top:0.4rem; }
.tl-tag.sdf    { border-color:#e00; color:#e00; }
.tl-tag.buyer  { border-color:rgba(255,255,255,0.25); color:rgba(255,255,255,0.45); }
.tl-tag.ship   { border-color:#60a5fa; color:#60a5fa; }
.tl-tag.target { border-color:#4ade80; color:#4ade80; }

/* CTA */
.tool-cta { background:#000; border:1px solid #e00; padding:2rem; text-align:center; margin-bottom:3rem; }
.tool-cta p { font-size:0.85rem; color:rgba(255,255,255,0.6); margin-bottom:1.25rem; line-height:1.8; }
.cta-btns { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }

/* SEO body */
.seo-content { border-top:1px solid rgba(255,255,255,0.07); padding-top:3rem; }
.seo-content h2 { font-size:1.35rem; font-weight:300; color:#fff; letter-spacing:0.04em; margin-bottom:1rem; margin-top:2.5rem; }
.seo-content h2:first-child { margin-top:0; }
.seo-content h3 { font-size:1rem; font-weight:500; color:#fff; margin-bottom:0.6rem; margin-top:1.75rem; }
.seo-content p { font-size:0.87rem; color:rgba(255,255,255,0.6); line-height:1.9; margin-bottom:1rem; }
.seo-content ul { margin:0.75rem 0 1rem 0; padding-left:0; list-style:none; }
.seo-content ul li { font-size:0.87rem; color:rgba(255,255,255,0.6); line-height:1.8; padding-left:1.2rem; position:relative; margin-bottom:0.35rem; }
.seo-content ul li::before { content:'—'; position:absolute; left:0; color:#e00; }

/* Lead time table */
.lt-table { width:100%; border-collapse:collapse; margin:1.25rem 0; font-size:0.82rem; }
.lt-table th { font-size:0.65rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.4); padding:0.6rem 0.75rem; border-bottom:1px solid rgba(255,255,255,0.07); text-align:left; font-weight:400; }
.lt-table td { padding:0.65rem 0.75rem; color:rgba(255,255,255,0.65); border-bottom:1px solid rgba(255,255,255,0.04); }
.lt-table tr:last-child td { border-bottom:none; }
.lt-table td:first-child { color:#fff; }

.disclaimer { font-size:0.71rem; color:rgba(255,255,255,0.28); line-height:1.7; margin-top:1.5rem; border-top:1px solid rgba(255,255,255,0.05); padding-top:1.25rem; }
</style>

