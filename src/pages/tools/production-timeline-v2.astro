    <div class="field-group">
      <label for="order-qty">Order Quantity</label>
      <select id="order-qty" aria-label="Select order quantity range">
        <option value="small">300–500 pieces</option>
        <option value="medium" selected>500–2,000 pieces</option>
        <option value="large">2,000–10,000 pieces</option>
        <option value="xlarge">10,000+ pieces</option>
      </select>
    </div>
    <div class="field-group">
      <label for="ship-mode">Shipping Mode to You</label>
      <select id="ship-mode" aria-label="Select shipping mode">
