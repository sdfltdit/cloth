---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Free AQL Calculator | ISO 2859-1 Sample Size & Acceptance Numbers";
const pageDescription = "Calculate sample size and acceptance/rejection numbers instantly with our free AQL calculator. Based on ISO 2859-1 ANSI/ASQ Z1.4 standard for garment, textile, and product quality inspection. Get accurate sampling plans for critical, major, and minor defects.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free AQL Calculator",
  "description": "Calculate sample size and acceptance/rejection numbers based on ISO 2859-1 ANSI/ASQ Z1.4 standard for quality inspection in garment, textile, and manufacturing industries",
  "url": "https://sdfltd.com/tools/aql-calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@id": "https://sdfltd.com/#org"
  },
  "keywords": "AQL calculator, sample size calculator, acceptance sampling, ISO 2859-1, ANSI/ASQ Z1.4, quality inspection, garment inspection, sampling plan, acceptance number, rejection number"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is AQL in quality inspection?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AQL (Acceptable Quality Limit) is the maximum percentage of defects considered acceptable in a production batch. It's a statistical sampling method defined by ISO 2859-1 and ANSI/ASQ Z1.4 standards used worldwide for quality control in manufacturing."
      }
    },
    {
      "@type": "Question",
      "name": "What are the standard AQL levels for garments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The garment industry standard is: Critical defects AQL 0 (zero tolerance), Major defects AQL 2.5, and Minor defects AQL 4.0, using General Inspection Level II. This combination balances quality assurance with practical inspection costs for apparel production."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Ac and Re numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ac (Acceptance number) is the maximum number of defects allowed for the lot to pass. Re (Rejection number) is the minimum number of defects that causes the lot to fail. For example, Ac=10, Re=11 means 10 or fewer defects pass, 11 or more fail."
      }
    },
    {
      "@type": "Question",
      "name": "What are the inspection levels?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Special inspection levels (S-1 to S-4) are used for small samples or destructive testing. General levels I, II, and III are for normal inspection, with Level II being the standard. Level I requires smaller samples (less strict), Level III requires larger samples (more strict)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I choose the right AQL for my product?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Consider defect severity and your quality requirements. Critical defects (safety issues) should always use AQL 0. Major defects affecting function typically use AQL 1.5–2.5. Minor cosmetic issues often use AQL 4.0–6.5. Your buyer's requirements and industry standards should guide your choice."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if a lot fails AQL inspection?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a lot fails AQL inspection, common actions include: 100% inspection of the entire lot to remove defective units, rework to fix defects, shipment rejection, or negotiating with the supplier. The action depends on your contract and the severity of quality issues."
      }
    },
    {
      "@type": "Question",
      "name": "Is this calculator suitable for all industries?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This calculator implements the ISO 2859-1 / ANSI/ASQ Z1.4 standard, which is used across manufacturing industries including textiles, electronics, automotive, and pharmaceuticals. While the standard is universal, different industries may prefer specific AQL combinations."
      }
    },
    {
      "@type": "Question",
      "name": "What is AQL 2.5?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AQL 2.5 means the acceptable quality limit is set at 2.5%. This is the most commonly used AQL value for general consumer products and is the industry standard for major defects in pre-shipment inspections. With AQL 2.5, a lot is statistically expected to contain no more than 2.5% defective units."
      }
    },
    {
      "@type": "Question",
      "name": "How do I interpret the AQL accept and reject numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After inspecting the specified sample size, count the total number of defective units found. If the count is equal to or less than the Accept number (Ac), the lot passes inspection. If the count is equal to or greater than the Reject number (Re), the lot fails. For example, with Ac = 3 and Re = 4, finding 3 or fewer defects means the lot is accepted; 4 or more means it is rejected."
      }
    }
  ]
}
</script>

