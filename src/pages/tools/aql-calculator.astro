  // Table B: Sample Size and Ac/Re by Code Letter and AQL
  const tableB = {
    'A': { sampleSize: 2, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': null, '1.0': null, '1.5': null, '2.5': null, '4.0': null, '6.5': { ac: 0, re: 1 } } },
    'B': { sampleSize: 3, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': null, '1.0': null, '1.5': null, '2.5': null, '4.0': { ac: 0, re: 1 }, '6.5': { ac: 1, re: 2 } } },
    'C': { sampleSize: 5, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': null, '1.0': null, '1.5': null, '2.5': { ac: 0, re: 1 }, '4.0': { ac: 0, re: 1 }, '6.5': { ac: 1, re: 2 } } },
    'D': { sampleSize: 8, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': null, '1.0': null, '1.5': { ac: 0, re: 1 }, '2.5': { ac: 0, re: 1 }, '4.0': { ac: 1, re: 2 }, '6.5': { ac: 2, re: 3 } } },
    'E': { sampleSize: 13, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': null, '1.0': { ac: 0, re: 1 }, '1.5': { ac: 0, re: 1 }, '2.5': { ac: 1, re: 2 }, '4.0': { ac: 1, re: 2 }, '6.5': { ac: 2, re: 3 } } },
    'F': { sampleSize: 20, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': null, '0.65': { ac: 0, re: 1 }, '1.0': { ac: 0, re: 1 }, '1.5': { ac: 1, re: 2 }, '2.5': { ac: 1, re: 2 }, '4.0': { ac: 2, re: 3 }, '6.5': { ac: 3, re: 4 } } },
    'G': { sampleSize: 32, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': null, '0.40': { ac: 0, re: 1 }, '0.65': { ac: 0, re: 1 }, '1.0': { ac: 1, re: 2 }, '1.5': { ac: 1, re: 2 }, '2.5': { ac: 2, re: 3 }, '4.0': { ac: 3, re: 4 }, '6.5': { ac: 5, re: 6 } } },
    'H': { sampleSize: 50, aql: { '0.065': null, '0.1': null, '0.15': null, '0.25': { ac: 0, re: 1 }, '0.40': { ac: 0, re: 1 }, '0.65': { ac: 1, re: 2 }, '1.0': { ac: 1, re: 2 }, '1.5': { ac: 2, re: 3 }, '2.5': { ac: 3, re: 4 }, '4.0': { ac: 5, re: 6 }, '6.5': { ac: 7, re: 8 } } },
    'J': { sampleSize: 80, aql: { '0.065': null, '0.1': null, '0.15': { ac: 0, re: 1 }, '0.25': { ac: 0, re: 1 }, '0.40': { ac: 1, re: 2 }, '0.65': { ac: 1, re: 2 }, '1.0': { ac: 2, re: 3 }, '1.5': { ac: 3, re: 4 }, '2.5': { ac: 5, re: 6 }, '4.0': { ac: 7, re: 8 }, '6.5': { ac: 10, re: 11 } } },
    'K': { sampleSize: 125, aql: { '0.065': null, '0.1': { ac: 0, re: 1 }, '0.15': { ac: 0, re: 1 }, '0.25': { ac: 1, re: 2 }, '0.40': { ac: 1, re: 2 }, '0.65': { ac: 2, re: 3 }, '1.0': { ac: 3, re: 4 }, '1.5': { ac: 5, re: 6 }, '2.5': { ac: 7, re: 8 }, '4.0': { ac: 10, re: 11 }, '6.5': { ac: 14, re: 15 } } },
    'L': { sampleSize: 200, aql: { '0.065': { ac: 0, re: 1 }, '0.1': { ac: 0, re: 1 }, '0.15': { ac: 1, re: 2 }, '0.25': { ac: 1, re: 2 }, '0.40': { ac: 2, re: 3 }, '0.65': { ac: 3, re: 4 }, '1.0': { ac: 5, re: 6 }, '1.5': { ac: 7, re: 8 }, '2.5': { ac: 10, re: 11 }, '4.0': { ac: 14, re: 15 }, '6.5': { ac: 21, re: 22 } } },
    'M': { sampleSize: 315, aql: { '0.065': { ac: 0, re: 1 }, '0.1': { ac: 1, re: 2 }, '0.15': { ac: 1, re: 2 }, '0.25': { ac: 2, re: 3 }, '0.40': { ac: 3, re: 4 }, '0.65': { ac: 5, re: 6 }, '1.0': { ac: 7, re: 8 }, '1.5': { ac: 10, re: 11 }, '2.5': { ac: 14, re: 15 }, '4.0': { ac: 21, re: 22 }, '6.5': null } },
    'N': { sampleSize: 500, aql: { '0.065': { ac: 1, re: 2 }, '0.1': { ac: 1, re: 2 }, '0.15': { ac: 2, re: 3 }, '0.25': { ac: 3, re: 4 }, '0.40': { ac: 5, re: 6 }, '0.65': { ac: 7, re: 8 }, '1.0': { ac: 10, re: 11 }, '1.5': { ac: 14, re: 15 }, '2.5': { ac: 21, re: 22 }, '4.0': null, '6.5': null } },
    'P': { sampleSize: 800, aql: { '0.065': { ac: 1, re: 2 }, '0.1': { ac: 2, re: 3 }, '0.15': { ac: 3, re: 4 }, '0.25': { ac: 5, re: 6 }, '0.40': { ac: 7, re: 8 }, '0.65': { ac: 10, re: 11 }, '1.0': { ac: 14, re: 15 }, '1.5': { ac: 21, re: 22 }, '2.5': null, '4.0': null, '6.5': null } },
    'Q': { sampleSize: 1250, aql: { '0.065': { ac: 2, re: 3 }, '0.1': { ac: 3, re: 4 }, '0.15': { ac: 5, re: 6 }, '0.25': { ac: 7, re: 8 }, '0.40': { ac: 10, re: 11 }, '0.65': { ac: 14, re: 15 }, '1.0': { ac: 21, re: 22 }, '1.5': null, '2.5': null, '4.0': null, '6.5': null } },
    'R': { sampleSize: 2000, aql: { '0.065': { ac: 3, re: 4 }, '0.1': { ac: 5, re: 6 }, '0.15': { ac: 7, re: 8 }, '0.25': { ac: 10, re: 11 }, '0.40': { ac: 14, re: 15 }, '0.65': { ac: 21, re: 22 }, '1.0': null, '1.5': null, '2.5': null, '4.0': null, '6.5': null } }
  };

  // DOM Elements
  const lotQuantityInput = document.getElementById('lot-quantity');
  const inspectionLevelSelect = document.getElementById('inspection-level');
  const criticalAqlSelect = document.getElementById('critical-aql');
  const majorAqlSelect = document.getElementById('major-aql');
  const minorAqlSelect = document.getElementById('minor-aql');
  const actualDefectsInput = document.getElementById('actual-defects');
  
  const codeLetterEl = document.getElementById('code-letter');
  const sampleSizeEl = document.getElementById('sample-size');
  const criticalAcReEl = document.getElementById('critical-acre');
  const majorAcReEl = document.getElementById('major-acre');
  const minorAcReEl = document.getElementById('minor-acre');
  const passFailResultEl = document.getElementById('pass-fail-result');
  const defectRateEl = document.getElementById('defect-rate');
  const explanationTextEl = document.getElementById('explanation-text');

  // Get code letter from lot size and inspection level
  function getCodeLetter(lotSize, inspectionLevel) {
    for (const range of tableA.lotRanges) {
      if (lotSize >= range.min && lotSize <= range.max) {
        return range.codes[inspectionLevel] || null;
      }
    }
    return null;
  }

  // Format Ac/Re display
  function formatAcRe(acRe) {
    if (!acRe) return '*';
    return `${acRe.ac} / ${acRe.re}`;
  }

  // Calculate and update results
  function calculateAQL() {
    const lotSize = parseInt(lotQuantityInput.value) || 0;
    const inspectionLevel = inspectionLevelSelect.value;
    const majorAql = majorAqlSelect.value;
    const minorAql = minorAqlSelect.value;

    if (lotSize < 2) {
      codeLetterEl.textContent = '-';
      sampleSizeEl.textContent = '-';
      majorAcReEl.textContent = '-';
      minorAcReEl.textContent = '-';
      explanationTextEl.textContent = 'Enter a lot quantity of at least 2 units to calculate sample size.';
      return;
    }

    // Get code letter
    const codeLetter = getCodeLetter(lotSize, inspectionLevel);
    
    if (!codeLetter) {
      codeLetterEl.textContent = '-';
      sampleSizeEl.textContent = '-';
      majorAcReEl.textContent = '-';
      minorAcReEl.textContent = '-';
      explanationTextEl.textContent = 'Unable to determine code letter for the given parameters.';
      return;
    }

    // Get sample size and AQL data
    const tableBData = tableB[codeLetter];
    if (!tableBData) {
      codeLetterEl.textContent = '-';
      sampleSizeEl.textContent = '-';
      return;
    }

    const sampleSize = tableBData.sampleSize;
    const majorAcRe = tableBData.aql[majorAql];
    const minorAcRe = tableBData.aql[minorAql];

    // Update display
    codeLetterEl.textContent = codeLetter;
    sampleSizeEl.textContent = `${sampleSize} units`;
    majorAcReEl.textContent = formatAcRe(majorAcRe);
    minorAcReEl.textContent = formatAcRe(minorAcRe);

    // Update explanation
    let explanation = `For a lot of ${lotSize.toLocaleString()} units at ${inspectionLevel === 'GII' ? 'General Level II' : inspectionLevel + ' level'}, inspect ${sampleSize} units. `;
    
    if (majorAcRe) {
      explanation += `Major defects: accept if ≤${majorAcRe.ac}, reject if ≥${majorAcRe.re}. `;
    } else {
      explanation += `Major defects at AQL ${majorAql}: use switched sampling plan. `;
    }
    
    if (minorAcRe) {
      explanation += `Minor defects: accept if ≤${minorAcRe.ac}, reject if ≥${minorAcRe.re}. `;
    } else {
      explanation += `Minor defects at AQL ${minorAql}: use switched sampling plan. `;
    }
    
    explanation += `Critical defects always require zero tolerance (Ac=0, Re=1).`;
    
    explanationTextEl.textContent = explanation;

    // Update pass/fail if defects entered
    checkPassFail();
  }

  // Check pass/fail based on actual defects
  function checkPassFail() {
    const actualDefects = parseInt(actualDefectsInput.value);
    const sampleSizeText = sampleSizeEl.textContent;
    
    if (!sampleSizeText || sampleSizeText === '-') {
      passFailResultEl.className = 'pass-fail-result pass-fail-result--pending';
      passFailResultEl.textContent = 'Enter parameters first';
      defectRateEl.textContent = '';
      return;
    }

    const sampleSize = parseInt(sampleSizeText.replace(' units', ''));
    
    if (isNaN(actualDefects) || actualDefects === 0) {
      passFailResultEl.className = 'pass-fail-result pass-fail-result--pending';
      passFailResultEl.textContent = 'Enter actual defects found';
      defectRateEl.textContent = '';
      return;
    }

    // Use major AQL for pass/fail determination (most common practice)
    const majorAql = majorAqlSelect.value;
    const codeLetter = codeLetterEl.textContent;
    const tableBData = tableB[codeLetter];
    
    if (!tableBData) return;

    const majorAcRe = tableBData.aql[majorAql];
    
    if (!majorAcRe) {
      passFailResultEl.className = 'pass-fail-result pass-fail-result--pending';
      passFailResultEl.textContent = 'Use switched sampling plan';
      defectRateEl.textContent = '';
      return;
    }

    const passed = actualDefects <= majorAcRe.ac;
    
    if (passed) {
      passFailResultEl.className = 'pass-fail-result pass-fail-result--pass';
      passFailResultEl.textContent = 'PASS ✓';
    } else {
      passFailResultEl.className = 'pass-fail-result pass-fail-result--fail';
      passFailResultEl.textContent = 'FAIL ✗';
    }

    // Calculate defect rate
    const defectRate = ((actualDefects / sampleSize) * 100).toFixed(2);
    defectRateEl.textContent = `Defect rate: ${defectRate}% (${actualDefects}/${sampleSize} units)`;
  }

  // Event listeners
  lotQuantityInput.addEventListener('input', calculateAQL);
  inspectionLevelSelect.addEventListener('change', calculateAQL);
  criticalAqlSelect.addEventListener('change', calculateAQL);
  majorAqlSelect.addEventListener('change', calculateAQL);
  minorAqlSelect.addEventListener('change', calculateAQL);
  actualDefectsInput.addEventListener('input', checkPassFail);

  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(button => {
    button.addEventListener('click', () => {
      const answer = button.nextElementSibling;
      const icon = button.querySelector('.faq-icon');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      
      button.setAttribute('aria-expanded', !isExpanded);
      answer.classList.toggle('faq-answer--visible');
      icon.classList.toggle('faq-icon--open');
    });
  });

  // Initial calculation
  calculateAQL();
</script>

