<div class="aql-page">

  <!-- HERO -->
  <section class="aql-section aql-section--no-border">
    <div class="aql-container" style="text-align: center;">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span style="margin: 0 0.5rem; color: #fff;">›</span>
        <a href="/all-services">Tools</a>
        <span style="margin: 0 0.5rem; color: #fff;">›</span>
        AQL Calculator
      </nav>
      <span class="section-label">Free Quality Control Tool</span>
      <h1 class="page-title">Free AQL Calculator<br>Sample Size & Acceptance Numbers</h1>
      <p class="page-subtitle">Calculate sample size and acceptance/rejection numbers instantly using ISO 2859-1 ANSI/ASQ Z1.4 standard. Perfect for garment, textile, and product quality inspection. Get accurate sampling plans for critical, major, and minor defects in seconds.</p>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="aql-section">
    <div class="aql-container">
      <div class="calculator-grid">
        
        <!-- INPUTS -->
        <div class="calc-card">
          <h2 class="calc-card-title">Inspection Parameters</h2>
          
          <div class="form-group">
            <label class="form-label" for="lot-quantity">Order/Lot Quantity</label>
