  "url": "https://sdfltd.com/tools/aql-calculator/",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web Browser",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@id": "https://sdfltd.com/#org"
  },
