---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Clothing Manufacturing Price Calculator | Free FOB Cost Estimator Bangladesh";
const pageDescription = "Free clothing manufacturing price calculator. Get instant FOB cost estimates for t-shirts, hoodies, denim and more from Bangladesh. No signup required. SDF Clothing.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Clothing Manufacturing Price Calculator",
  "description": "Free FOB price estimator for clothing manufacturing in Bangladesh. Calculate costs for t-shirts, hoodies, denim and more.",
  "url": "https://sdfltd.com/price-calculator",
  "applicationCategory": "BusinessApplication",
  "provider": { "@id": "https://sdfltd.com/#org" },
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Free Tool · No Signup</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Clothing Manufacturing<br>Price Calculator</h1>
    <p style="color:#888;max-width:520px;line-height:1.8;font-size:0.92rem;">Get instant FOB price estimates from Bangladesh clothing manufacturers. Select category, fabric, and quantity  results in 30 seconds.</p>
  </div>
</section>

<!-- CALCULATOR MAIN -->
<section style="padding:4rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;background:#1a1a1a;">

      <!-- LEFT: Calculator Steps -->
      <div style="background:#000;padding:3rem;">

        <!-- Step indicator -->
        <div style="display:flex;gap:0.75rem;align-items:center;margin-bottom:2.5rem;" id="step-indicator">
          <span id="si-1" style="font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;">01 Category</span>
          <span style="color:#333;font-size:0.7rem;"></span>
          <span id="si-2" style="font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:#333;">02 Details</span>
          <span style="color:#333;font-size:0.7rem;"></span>
          <span id="si-3" style="font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:#333;">03 Result</span>
        </div>

        <!-- STEP 1: Category -->
        <div id="step1">
          <h2 style="font-size:0.95rem;font-weight:500;letter-spacing:0.08em;color:#fff;margin-bottom:1.5rem;">Select Product Category</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#1a1a1a;" id="category-grid">
            <button class="cat-btn" data-cat="knit" style="background:#000;border:none;color:#fff;padding:1.5rem;text-align:left;cursor:pointer;transition:background 0.2s;">
              <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Knitwear</div>
              <div style="font-size:0.88rem;font-weight:500;margin-bottom:0.3rem;">Knit Garments</div>
              <div style="font-size:0.75rem;color:#666;">T-shirts, hoodies, activewear</div>
            </button>
            <button class="cat-btn" data-cat="woven" style="background:#000;border:none;color:#fff;padding:1.5rem;text-align:left;cursor:pointer;transition:background 0.2s;">
              <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Woven</div>
              <div style="font-size:0.88rem;font-weight:500;margin-bottom:0.3rem;">Woven Garments</div>
              <div style="font-size:0.75rem;color:#666;">Shirts, trousers, denim, jackets</div>
            </button>
            <button class="cat-btn" data-cat="accessories" style="background:#000;border:none;color:#fff;padding:1.5rem;text-align:left;cursor:pointer;transition:background 0.2s;">
              <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Accessories</div>
              <div style="font-size:0.88rem;font-weight:500;margin-bottom:0.3rem;">Fashion Accessories</div>
              <div style="font-size:0.75rem;color:#666;">Bags, hats, scarves, belts</div>
            </button>
            <button class="cat-btn" data-cat="home" style="background:#000;border:none;color:#fff;padding:1.5rem;text-align:left;cursor:pointer;transition:background 0.2s;">
              <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Home Textile</div>
              <div style="font-size:0.88rem;font-weight:500;margin-bottom:0.3rem;">Home Textiles</div>
              <div style="font-size:0.75rem;color:#666;">Bedding, towels, curtains</div>
            </button>
          </div>
        </div>

        <!-- STEP 2: Item + Fabric + Qty + Customization -->
        <div id="step2" style="display:none;">
          <button id="back-btn" style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#cc0000;background:none;border:none;cursor:pointer;margin-bottom:1.5rem;font-family:inherit;">← Change Category</button>

          <div style="margin-bottom:1.5rem;">
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.5rem;">Product Type</label>
            <select id="item-select" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.7rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
            </select>
          </div>

          <div style="margin-bottom:1.5rem;">
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.5rem;">Fabric Type</label>
            <select id="fabric-select" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.7rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
            </select>
          </div>

          <div style="margin-bottom:1.5rem;">
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.5rem;">Quantity: <span id="qty-display" style="color:#fff;">300</span> pieces</label>
            <input type="range" id="qty-slider" min="300" max="10000" value="300" step="100" style="width:100%;accent-color:#cc0000;cursor:pointer;" />
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem;flex-wrap:wrap;">
              {[300,500,1000,3000,5000].map(q => (
                <button class="qty-preset" data-qty={q} style="background:#000;border:1px solid #1a1a1a;color:#888;padding:0.4rem 0.75rem;font-size:0.72rem;cursor:pointer;font-family:inherit;transition:all 0.2s;">{q.toLocaleString()}</button>
              ))}
            </div>
          </div>

          <div style="margin-bottom:2rem;">
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.5rem;">Customization Level</label>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#1a1a1a;">
              <button class="cust-btn" data-cust="basic" style="background:#000;border:none;color:#fff;padding:1rem 0.75rem;font-size:0.78rem;cursor:pointer;font-family:inherit;transition:background 0.2s;">
                <div style="font-weight:600;margin-bottom:0.2rem;">Basic</div>
                <div style="font-size:0.68rem;color:#666;">Labels only</div>
              </button>
              <button class="cust-btn" data-cust="standard" style="background:#000;border:none;color:#fff;padding:1rem 0.75rem;font-size:0.78rem;cursor:pointer;font-family:inherit;transition:background 0.2s;">
                <div style="font-weight:600;margin-bottom:0.2rem;">Standard</div>
                <div style="font-size:0.68rem;color:#666;">Print + labels</div>
              </button>
              <button class="cust-btn" data-cust="premium" style="background:#000;border:none;color:#fff;padding:1rem 0.75rem;font-size:0.78rem;cursor:pointer;font-family:inherit;transition:background 0.2s;">
                <div style="font-weight:600;margin-bottom:0.2rem;">Premium</div>
                <div style="font-size:0.68rem;color:#666;">Embroidery + full</div>
              </button>
            </div>
          </div>

          <button id="calc-btn" style="background:#cc0000;color:#fff;border:none;padding:0.9rem 2rem;font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;transition:background 0.2s;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#cc0000'">
            Calculate Price
          </button>
        </div>

        <!-- STEP 3: Result -->
        <div id="step3" style="display:none;">
          <button id="recalc-btn" style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#cc0000;background:none;border:none;cursor:pointer;margin-bottom:1.5rem;font-family:inherit;">← Recalculate</button>

          <div style="margin-bottom:1.5rem;">
            <p style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:0.4rem;">FOB Price Per Piece</p>
            <div id="price-per-piece" style="font-size:2rem;font-weight:200;color:#fff;letter-spacing:0.05em;"></div>
          </div>
          <div style="margin-bottom:1.5rem;">
            <p style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:0.4rem;">Total Order Estimate</p>
            <div id="total-price" style="font-size:1.3rem;font-weight:300;color:#ccc;"></div>
          </div>
          <div style="border:1px solid #1a1a1a;padding:1rem;margin-bottom:1.5rem;">
            <div id="result-summary" style="font-size:0.8rem;color:#888;line-height:1.8;"></div>
          </div>
          <p style="font-size:0.72rem;color:#555;line-height:1.7;margin-bottom:1.5rem;">FOB Chittagong or Dhaka. Includes fabric, cut &amp; sew, AQL inspection. Excludes freight &amp; duties. Estimates ±15%.</p>
          <a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing%2C%20I%20used%20your%20price%20calculator%20and%20want%20a%20formal%20quote" target="_blank" rel="noopener noreferrer" class="whatsapp-cta" style="display:flex;justify-content:center;gap:0.5rem;align-items:center;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;width:100%;margin-bottom:0.75rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Request Formal Quote on WhatsApp
          </a>
          <a href="/contact" class="cta-button" style="display:block;text-align:center;">Get Exact FOB Quote →</a>
        </div>

      </div>

      <!-- RIGHT: Animated Currency + Pricing Guide -->
      <div style="background:#000;border-left:1px solid #1a1a1a;display:flex;flex-direction:column;">

        <!-- Currency animation panel -->
        <div style="padding:3rem;border-bottom:1px solid #1a1a1a;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;">
          <p style="font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:#888;margin-bottom:1.5rem;text-align:center;">FOB Prices in Multiple Currencies</p>
          <div id="currency-display" style="text-align:center;">
            <div id="currency-symbol" style="font-size:3.5rem;font-weight:100;color:#cc0000;line-height:1;margin-bottom:0.5rem;transition:opacity 0.4s;">$</div>
            <div id="currency-name" style="font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:#555;margin-bottom:0.5rem;transition:opacity 0.4s;">US Dollar</div>
            <div id="currency-range" style="font-size:1.1rem;color:#fff;font-weight:300;transition:opacity 0.4s;">2.50 – 18.00</div>
            <div style="font-size:0.7rem;color:#666;margin-top:0.4rem;">per piece FOB Bangladesh</div>
          </div>
          <!-- Currency dots -->
          <div style="display:flex;gap:0.5rem;margin-top:1.5rem;" id="currency-dots"></div>
        </div>

        <!-- Product pricing guide -->
        <div style="padding:2rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1.25rem;">Typical FOB Price Ranges (USD)</p>
          <div style="display:flex;flex-direction:column;gap:0;">
            {[
              ["Basic T-Shirt","$2.50","$5.00"],
              ["Premium T-Shirt","$4.00","$8.00"],
              ["Hoodie / Sweatshirt","$8.00","$18.00"],
              ["Polo Shirt","$5.00","$10.00"],
              ["Dress Shirt (Woven)","$6.00","$14.00"],
              ["Denim Jeans","$9.00","$20.00"],
              ["Bomber / Jacket","$15.00","$35.00"],
              ["Activewear Set","$10.00","$22.00"],
              ["Accessories (avg)","$3.00","$12.00"],
            ].map(([name,min,max]) => (
              <div style="display:grid;grid-template-columns:1fr auto auto;gap:0.5rem;align-items:center;padding:0.6rem 0;border-bottom:1px solid #0d0d0d;">
                <span style="font-size:0.78rem;color:#ccc;">{name}</span>
                <span style="font-size:0.72rem;color:#888;">{min}</span>
                <span style="font-size:0.72rem;color:#fff;">{max}</span>
              </div>
            ))}
          </div>
          <p style="font-size:0.68rem;color:#555;margin-top:0.75rem;line-height:1.6;">FOB Chittagong. Prices vary by GSM, customization, and quantity. MOQ 300 pcs.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- GSM CALCULATOR -->
<section style="padding:4rem 0;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;background:#1a1a1a;">
      <div style="background:#000;padding:3rem;">
        <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Bonus Tool</p>
        <h2 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:0.5rem;">Fabric GSM Calculator</h2>
        <p style="font-size:0.82rem;color:#888;line-height:1.7;margin-bottom:2rem;">Check if your GSM spec is correct for your garment type before placing an order.</p>

        <div style="margin-bottom:1rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Fabric Type</label>
          <select id="gsm-type" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.7rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
            <option value="">Select fabric type</option>
            <option value="jersey">Jersey (T-shirt)</option>
            <option value="fleece">Fleece (Hoodie)</option>
            <option value="denim">Denim (Jeans)</option>
            <option value="poplin">Poplin (Shirt)</option>
            <option value="twill">Twill (Trouser)</option>
            <option value="oxford">Oxford (Shirt)</option>
            <option value="rib">Rib (Collar/Cuff)</option>
            <option value="interlock">Interlock (Polo)</option>
          </select>
        </div>
        <div style="margin-bottom:1.5rem;">
          <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">GSM Value</label>
          <input id="gsm-val" type="number" placeholder="e.g. 180" min="60" max="600" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.7rem;font-size:0.85rem;width:100%;font-family:inherit;outline:none;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
        </div>
        <button id="gsm-btn" style="background:#cc0000;color:#fff;border:none;padding:0.8rem 1.5rem;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;width:100%;min-height:44px;font-family:inherit;transition:background 0.2s;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#cc0000'">Check GSM</button>
        <div id="gsm-result" style="display:none;margin-top:1.5rem;border-top:1px solid #1a1a1a;padding-top:1.5rem;font-size:0.82rem;line-height:1.9;"></div>
      </div>
      <div style="background:#000;border-left:1px solid #1a1a1a;padding:3rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1.5rem;">GSM Reference Guide</p>
        <div style="display:flex;flex-direction:column;gap:0;">
          {[
            ["Jersey","120–220 gsm","T-shirts, basic tops"],
            ["Fleece","200–450 gsm","Hoodies, sweatshirts"],
            ["Denim","180–420 gsm","Jeans, jackets"],
            ["Poplin","90–140 gsm","Dress shirts"],
            ["Twill","150–280 gsm","Chinos, trousers"],
            ["Interlock","160–260 gsm","Polo shirts"],
            ["Rib","150–280 gsm","Collars, cuffs"],
            ["Oxford","120–200 gsm","Oxford shirts"],
          ].map(([f,g,u]) => (
            <div style="display:grid;grid-template-columns:auto 1fr;gap:0.25rem 1rem;padding:0.65rem 0;border-bottom:1px solid #0d0d0d;align-items:start;">
              <span style="font-size:0.78rem;color:#fff;font-weight:500;">{f}</span>
              <div>
                <div style="font-size:0.72rem;color:#cc0000;">{g}</div>
                <div style="font-size:0.68rem;color:#555;">{u}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- INTERNAL LINKS -->
<section style="padding:3rem 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#1a1a1a;">
      <a href="/clothing-manufacturers" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Browse</div>
        <div style="font-size:0.85rem;color:#fff;">Clothing Manufacturers</div>
      </a>
      <a href="/lead-time-calculator" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Tool</div>
        <div style="font-size:0.85rem;color:#fff;">Lead Time Calculator</div>
      </a>
      <a href="/eu-readiness-checker" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Tool</div>
        <div style="font-size:0.85rem;color:#fff;">EU Readiness Checker</div>
      </a>
      <a href="/contact" style="background:#000;padding:1.5rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Quote</div>
        <div style="font-size:0.85rem;color:#fff;">Request Exact FOB Price</div>
      </a>
    </div>
  </div>
</section>

<script>
// ===== DATA =====
const items = {
  knit: [
    {name:"Basic T-Shirt",price:[2.5,5]},
    {name:"Premium T-Shirt",price:[4,8]},
    {name:"Polo Shirt",price:[5,10]},
    {name:"Hoodie / Sweatshirt",price:[8,18]},
    {name:"Zip-Up Hoodie",price:[10,22]},
    {name:"Crewneck Sweatshirt",price:[7,15]},
    {name:"Activewear Top",price:[5,12]},
    {name:"Leggings / Joggers",price:[6,14]},
    {name:"Knitwear Dress",price:[8,18]},
    {name:"Long Sleeve Top",price:[4,9]},
  ],
  woven: [
    {name:"Dress Shirt",price:[6,14]},
    {name:"Casual Shirt",price:[5,11]},
    {name:"Denim Jeans",price:[9,20]},
    {name:"Denim Jacket",price:[14,30]},
    {name:"Chino Trousers",price:[8,16]},
    {name:"Blazer / Suit Jacket",price:[18,40]},
    {name:"Shorts (Woven)",price:[5,10]},
    {name:"Woven Dress",price:[9,20]},
    {name:"Windbreaker",price:[12,28]},
    {name:"Bomber Jacket",price:[15,35]},
  ],
  accessories: [
    {name:"Canvas Tote Bag",price:[3,7]},
    {name:"Baseball Cap",price:[3,8]},
    {name:"Beanie",price:[2.5,6]},
    {name:"Scarf / Snood",price:[3,8]},
    {name:"Belt",price:[4,10]},
    {name:"Backpack",price:[8,20]},
    {name:"Socks (pair)",price:[1.5,4]},
    {name:"Gloves",price:[3,8]},
  ],
  home: [
    {name:"Bedsheet Set",price:[8,18]},
    {name:"Pillow Cover",price:[2,5]},
    {name:"Bath Towel",price:[3,8]},
    {name:"Duvet Cover",price:[10,22]},
    {name:"Kitchen Towel",price:[1.5,4]},
    {name:"Curtain Panel",price:[5,14]},
    {name:"Table Runner",price:[3,8]},
  ]
};

const fabrics = {
  knit: ["Jersey (standard)","Piqué (polo)","Fleece (hoodie)","French Terry","Interlock","Waffle Knit","Lycra/Spandex blend"],
  woven: ["100% Cotton","Cotton/Poly blend","Denim (10oz)","Denim (12oz)","Poplin","Oxford","Twill","Linen blend","Satin"],
  accessories: ["Canvas","Nylon","Cotton","Polyester","Leather-look"],
  home: ["100% Cotton","Microfibre","Linen blend","Poly-Cotton","Bamboo blend"]
};

const fabricMult = {
  "Jersey (standard)":1,"Piqué (polo)":1.1,"Fleece (hoodie)":1.2,"French Terry":1.15,"Interlock":1.1,"Waffle Knit":1.2,"Lycra/Spandex blend":1.25,
  "100% Cotton":1,"Cotton/Poly blend":0.95,"Denim (10oz)":1.2,"Denim (12oz)":1.35,"Poplin":1,"Oxford":1.05,"Twill":1.1,"Linen blend":1.3,"Satin":1.4,
  "Canvas":1,"Nylon":1.05,"Polyester":0.9,"Leather-look":1.3,
  "Microfibre":0.95,"Bamboo blend":1.35
};

const custMult = { basic:1, standard:1.15, premium:1.35 };

const currencies = [
  { sym:"$",  name:"US Dollar",   code:"USD", rate:1 },
  { sym:"€",  name:"Euro",        code:"EUR", rate:0.92 },
  { sym:"£",  name:"Brit Pound",  code:"GBP", rate:0.79 },
  { sym:"A$", name:"AUS Dollar",  code:"AUD", rate:1.55 },
  { sym:"CA$",name:"CAN Dollar",  code:"CAD", rate:1.36 },
  { sym:"¥",  name:"Japanese Yen",code:"JPY", rate:150 },
  { sym:"kr", name:"Swedish SEK", code:"SEK", rate:10.5 },
];

// ===== STATE =====
let selCat='', selItem=null, selFabric='', selQty=300, selCust='standard', curCurIdx=0;

// ===== CURRENCY ANIMATION =====
const dotsEl = document.getElementById('currency-dots');
currencies.forEach((c,i) => {
  const d = document.createElement('button');
  d.style.cssText = 'width:8px;height:8px;border-radius:50%;border:none;cursor:pointer;background:'+(i===0?'#cc0000':'#333')+';transition:background 0.3s;padding:0;';
  d.addEventListener('click', () => { curCurIdx=i; updateCurrencyDisplay(); resetCurrencyTimer(); });
  dotsEl.appendChild(d);
});

function updateCurrencyDisplay(minP=2.5, maxP=18) {
  const c = currencies[curCurIdx];
  const symEl = document.getElementById('currency-symbol');
  const nameEl = document.getElementById('currency-name');
  const rangeEl = document.getElementById('currency-range');
  if(!symEl) return;
  symEl.style.opacity='0'; nameEl.style.opacity='0'; rangeEl.style.opacity='0';
  setTimeout(()=>{
    symEl.textContent = c.sym;
    nameEl.textContent = c.name;
    const lo = (minP*c.rate).toFixed(c.rate>=100?0:2);
    const hi = (maxP*c.rate).toFixed(c.rate>=100?0:2);
    rangeEl.textContent = lo + ' – ' + hi;
    symEl.style.opacity='1'; nameEl.style.opacity='1'; rangeEl.style.opacity='1';
  }, 200);
  dotsEl.querySelectorAll('button').forEach((d,i)=>{ d.style.background = i===curCurIdx?'#cc0000':'#333'; });
}

let currencyTimer = setInterval(()=>{ curCurIdx=(curCurIdx+1)%currencies.length; updateCurrencyDisplay(); }, 2500);
function resetCurrencyTimer() { clearInterval(currencyTimer); currencyTimer=setInterval(()=>{ curCurIdx=(curCurIdx+1)%currencies.length; updateCurrencyDisplay(); },2500); }
updateCurrencyDisplay();

// ===== STEP INDICATOR =====
function setStep(s) {
  ['si-1','si-2','si-3'].forEach((id,i)=>{
    const el = document.getElementById(id);
    if(el) el.style.color = i+1===s ? '#cc0000' : '#333';
  });
}

// ===== CATEGORY SELECTION =====
document.querySelectorAll('.cat-btn').forEach(btn=>{
  btn.addEventListener('click',function(){
    selCat = this.dataset.cat;
    document.getElementById('step1').style.display='none';
    document.getElementById('step2').style.display='block';
    setStep(2);
    populateItems();
    populateFabrics();
  });
  btn.addEventListener('mouseover',function(){ this.style.background='#0a0a0a'; });
  btn.addEventListener('mouseout',function(){ this.style.background='#000'; });
});

function populateItems() {
  const sel = document.getElementById('item-select');
  sel.innerHTML = '';
  items[selCat].forEach(i=>{ const o=document.createElement('option'); o.value=i.name; o.textContent=i.name; sel.appendChild(o); });
  selItem = items[selCat][0];
}

function populateFabrics() {
  const sel = document.getElementById('fabric-select');
  sel.innerHTML = '';
  fabrics[selCat].forEach(f=>{ const o=document.createElement('option'); o.value=f; o.textContent=f; sel.appendChild(o); });
  selFabric = fabrics[selCat][0];
}

document.getElementById('item-select').addEventListener('change',function(){
  selItem = items[selCat].find(i=>i.name===this.value) || items[selCat][0];
});
document.getElementById('fabric-select').addEventListener('change',function(){ selFabric=this.value; });

// ===== QTY =====
document.getElementById('qty-slider').addEventListener('input',function(){
  selQty=parseInt(this.value);
  document.getElementById('qty-display').textContent=selQty.toLocaleString();
});
document.querySelectorAll('.qty-preset').forEach(b=>{
  b.addEventListener('click',function(){
    selQty=parseInt(this.dataset.qty);
    document.getElementById('qty-slider').value=selQty;
    document.getElementById('qty-display').textContent=selQty.toLocaleString();
    document.querySelectorAll('.qty-preset').forEach(x=>{ x.style.borderColor='#1a1a1a'; x.style.color='#888'; });
    this.style.borderColor='#cc0000'; this.style.color='#fff';
  });
});

// ===== CUSTOMIZATION =====
document.querySelectorAll('.cust-btn').forEach(b=>{
  b.addEventListener('click',function(){
    document.querySelectorAll('.cust-btn').forEach(x=>{ x.style.background='#000'; x.style.color='#fff'; });
    this.style.background='#1a1a1a'; this.style.color='#cc0000';
    selCust=this.dataset.cust;
  });
  b.addEventListener('mouseover',function(){ if(selCust!==this.dataset.cust) this.style.background='#0a0a0a'; });
  b.addEventListener('mouseout',function(){ if(selCust!==this.dataset.cust) this.style.background='#000'; });
});

// ===== CALCULATE =====
document.getElementById('calc-btn').addEventListener('click',function(){
  if(!selItem) return;
  const fm = fabricMult[selFabric] || 1;
  const cm = custMult[selCust] || 1;
  const qe = selQty>=5000?0.82:selQty>=3000?0.88:selQty>=1000?0.93:selQty>=500?0.97:1;
  const lo = (selItem.price[0]*fm*cm*qe).toFixed(2);
  const hi = (selItem.price[1]*fm*cm*qe).toFixed(2);
  const tlo = Math.round(lo*selQty).toLocaleString();
  const thi = Math.round(hi*selQty).toLocaleString();

  const c = currencies[curCurIdx];
  document.getElementById('price-per-piece').textContent = c.sym+(lo*c.rate).toFixed(c.rate>=100?0:2)+' – '+c.sym+(hi*c.rate).toFixed(c.rate>=100?0:2);
  document.getElementById('total-price').textContent = c.sym+(Math.round(lo*selQty*c.rate)).toLocaleString()+' – '+c.sym+(Math.round(hi*selQty*c.rate)).toLocaleString();
  document.getElementById('result-summary').innerHTML =
    '<span style="color:#888;">Product:</span> <span style="color:#fff;">'+selItem.name+'</span><br>'+
    '<span style="color:#888;">Fabric:</span> <span style="color:#fff;">'+selFabric+'</span><br>'+
    '<span style="color:#888;">Quantity:</span> <span style="color:#fff;">'+selQty.toLocaleString()+' pcs</span><br>'+
    '<span style="color:#888;">Customization:</span> <span style="color:#fff;">'+selCust.charAt(0).toUpperCase()+selCust.slice(1)+'</span>';

  updateCurrencyDisplay(parseFloat(lo), parseFloat(hi));

  document.getElementById('step2').style.display='none';
  document.getElementById('step3').style.display='block';
  setStep(3);
});

document.getElementById('back-btn').addEventListener('click',()=>{ document.getElementById('step2').style.display='none'; document.getElementById('step1').style.display='block'; setStep(1); });
document.getElementById('recalc-btn').addEventListener('click',()=>{ document.getElementById('step3').style.display='none'; document.getElementById('step2').style.display='block'; setStep(2); });

// ===== GSM CALCULATOR =====
const gsmData = {
  jersey:    {min:120,max:220,typ:160,use:"T-shirts, basic tops",note:"160–180gsm = standard. 200g+ = heavyweight."},
  fleece:    {min:200,max:450,typ:320,use:"Hoodies, sweatshirts",note:"280gsm = mid. 320–380gsm = premium. 400g+ = heavy."},
  denim:     {min:180,max:420,typ:300,use:"Jeans, denim jackets",note:"7oz=230g summer. 10oz=330g standard. 12oz+ = rigid."},
  poplin:    {min:90, max:140,typ:110,use:"Dress shirts, blouses",note:"100–110gsm standard. Lightweight, smooth finish."},
  twill:     {min:150,max:280,typ:200,use:"Chinos, trousers",note:"180–220gsm standard. Good drape and durability."},
  oxford:    {min:120,max:200,typ:150,use:"Oxford shirts",note:"140–160gsm standard oxford weave."},
  rib:       {min:150,max:280,typ:200,use:"Collars, cuffs, waistbands",note:"180–220gsm for neckband/cuff trim."},
  interlock: {min:160,max:260,typ:200,use:"Polo shirts, activewear",note:"Double-knit. 180–220gsm standard polo."},
};

document.getElementById('gsm-btn').addEventListener('click',function(){
  const type = document.getElementById('gsm-type').value;
  const val  = parseInt(document.getElementById('gsm-val').value);
  const res  = document.getElementById('gsm-result');
  if(!type){ alert('Select a fabric type.'); return; }
  if(!val||val<60||val>600){ alert('Enter a valid GSM (60–600).'); return; }
  const d = gsmData[type];
  let status;
  if(val<d.min) status='<span style="color:#cc0000;">Below typical range  may be too thin.</span>';
  else if(val>d.max) status='<span style="color:#cc0000;">Above typical range  will be heavy/stiff.</span>';
  else if(Math.abs(val-d.typ)<=20) status='<span style="color:#fff;">Ideal range for '+type+'.</span>';
  else status='<span style="color:#ccc;">Acceptable range.</span>';
  res.innerHTML = '<p style="margin-bottom:0.4rem;"><strong style="color:#fff;">'+val+' gsm</strong>  '+status+'</p><p style="color:#888;font-size:0.78rem;margin-bottom:0.3rem;">Range: <span style="color:#fff;">'+d.min+'–'+d.max+' gsm</span> (typical: '+d.typ+')</p><p style="color:#888;font-size:0.78rem;margin-bottom:0.3rem;">Used for: <span style="color:#fff;">'+d.use+'</span></p><p style="color:#666;font-size:0.75rem;line-height:1.6;">'+d.note+'</p>';
  res.style.display='block';
});
</script>

