  .container > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns:1fr!important; }
  #step2 > div[style*="grid-template-columns:repeat(3"] { grid-template-columns:1fr!important; }
  section:last-of-type .container > div { grid-template-columns:1fr 1fr!important; }
}
</style>

