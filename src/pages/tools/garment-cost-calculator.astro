---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Garment Cost Calculator — FOB & Landed Cost | SDF";
const pageDescription = "Free garment cost calculator for clothing brands. Enter garment type, quantity, and destination to see FOB price, duty, freight, and landed cost update live.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}

  dateModified={new Date().toISOString().split("T")[0]}
>

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />








<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://sdfltd.com/tools/garment-cost-calculator#app",
      "name": "Garment Cost Calculator",
      "url": "https://sdfltd.com/tools/garment-cost-calculator",
      "description": "Free garment cost calculator for clothing brands. Live FOB price, import duty, freight, and landed cost per unit, with a Bangladesh, China, and Vietnam sourcing comparison.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Apparel Sourcing Tool",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "isAccessibleForFree": true,
      "featureList": [
        "Live FOB price estimate by garment, fabric, and quantity",
        "Live import duty calculation by destination country",
        "Sea and air freight cost per unit",
        "Full landed cost breakdown updating in real time",
        "Gross margin calculator against your retail price",
        "Bangladesh vs China vs Vietnam stacked cost comparison"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "@id": "https://sdfltd.com/#org"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://sdfltd.com/tools" },
        { "@type": "ListItem", "position": 3, "name": "Garment Cost Calculator", "item": "https://sdfltd.com/tools/garment-cost-calculator" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is FOB price in clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FOB (Free on Board) is the price a factory charges for a garment once it's manufactured, packed, and loaded onto the vessel at the export port. For Bangladesh, that's Chittagong. Everything after that point — ocean freight, insurance, and import duty at your destination — is the buyer's responsibility, usually handled through a freight forwarder and customs broker."
          }
        },
        {
          "@type": "Question",
          "name": "Why is import duty so much lower for Bangladesh than China?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bangladesh qualifies for preferential trade access in most major markets because of its status as a least-developed country. The UK, EU, Australia, and Canada offer duty-free or near duty-free access on most garment categories, and even the US — which doesn't extend the same preference — has lower effective rates than China on many categories due to differences in how tariff schedules are structured. China pays standard Most Favoured Nation rates with no preferential reduction."
          }
        },
        {
          "@type": "Question",
          "name": "Is landed cost the same as the price I should expect to pay per unit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Landed cost is your all-in cost to get the product into your hands — FOB price, duty, and freight combined. It does not include your own warehousing, fulfilment, payment processing, or marketing costs, which still need to be factored in separately when you're setting a retail price and calculating your true net margin."
          }
        },
        {
          "@type": "Question",
          "name": "How accurate is this calculator compared to a real factory quote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "This tool gives a directional estimate based on typical Bangladesh RMG industry pricing for standard constructions. A real quote will differ based on your exact fabric specification, print or embroidery work, trim choices, packaging requirements, and the factory's current capacity and order book. Treat the numbers here as a planning estimate to use before you request a formal quote, not as a final price."
          }
        },
        {
          "@type": "Question",
          "name": "Does a lower FOB price always mean a better deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not necessarily. A lower FOB price sometimes reflects a lighter fabric weight, simpler construction, or looser quality tolerances — all of which can affect how the finished garment looks and performs. Comparing landed cost is useful for budgeting, but the decision on which factory to use should also weigh fabric quality, certifications, social compliance, and consistency across orders."
          }
        }
      ]
    }
  ]
}
</script>

<style>
  :root {
    --r: #e00;
    --rd: #c00;
    --g: #22c55e;
    --y: #f59e0b;
    --fob-c: #3b82f6;
    --duty-c: #f59e0b;
    --frt-c: #8b5cf6;
    --border: rgba(255,255,255,0.08);
    --surface: #0d0d0d;
    --text: rgba(255,255,255,0.65);
    --muted: rgba(255,255,255,0.35);
    --label: rgba(255,255,255,0.68);
  }

  .tool-page { max-width: 1020px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }

  .crumb-nav ol { display:flex; gap:0.5rem; list-style:none; font-size:0.7rem; color:var(--muted); flex-wrap:wrap; margin-bottom:2rem; }
  .crumb-nav a { color:var(--muted); text-decoration:none; }
  .crumb-nav a:hover { color:#fff; }
  .crumb-sep { color:rgba(255,255,255,0.15); }

  .hero { margin-bottom:2rem; }
  .hero-eyebrow { font-size:0.66rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--r); font-weight:600; margin-bottom:0.75rem; display:block; }
  .hero h1 { font-size:clamp(1.8rem,3.5vw,2.6rem); font-weight:200; color:#fff; letter-spacing:0.02em; line-height:1.15; margin:0 0 0.8rem; }
  .hero h1 em { font-style:normal; color:var(--r); }
  .hero-sub { font-size:0.9rem; color:var(--text); max-width:580px; line-height:1.85; margin-bottom:1.25rem; }
  .pill-row { display:flex; flex-wrap:wrap; gap:0.4rem; }
  .pill { font-size:0.67rem; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted); border:0.5px solid rgba(255,255,255,0.1); padding:0.28rem 0.7rem; border-radius:100px; }

  /* ── DASHBOARD LAYOUT (signature: sidebar + live main panel) ── */
  .dash { display:grid; grid-template-columns:230px 1fr; border:0.5px solid var(--border); border-radius:6px; overflow:hidden; margin:2rem 0 3rem; }
  @media(max-width:760px){ .dash { grid-template-columns:1fr; } }

  .side { background:var(--surface); border-right:0.5px solid var(--border); padding:1.25rem 1rem; display:flex; flex-direction:column; gap:1rem; overflow-y:auto; }
  @media(max-width:760px){ .side { border-right:none; border-bottom:0.5px solid var(--border); } }

  .sec-lbl { font-size:0.62rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--muted); margin-bottom:0.4rem; display:block; }
  .ig { display:flex; flex-direction:column; gap:0.35rem; }
  .ig select, .ig input {
    background:#000; color:#fff; border:0.5px solid var(--border);
    padding:0.6rem 0.75rem; font-size:0.82rem; width:100%;
    border-radius:4px; font-family:inherit; appearance:none; -webkit-appearance:none;
    outline:none; color-scheme:dark; min-height:38px; transition:border-color 0.18s;
  }
  .ig select:focus, .ig input:focus { border-color:var(--r); outline:2px solid rgba(238,0,0,0.18); outline-offset:2px; }
  .ig select option { background:#111; }
  .side-divider { height:0.5px; background:var(--border); margin:0.15rem 0; }
  .ig-error { font-size:0.66rem; color:#ff6b6b; display:none; }
  .ig.has-error select, .ig.has-error input { border-color:var(--r); }
  .ig.has-error .ig-error { display:block; }

  /* ── MAIN PANEL ── */
  .main { background:#000; padding:1.25rem 1.1rem; min-height:480px; }

  .empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; min-height:380px; gap:0.75rem; text-align:center; color:var(--muted); }
  .empty-icon { font-size:2.5rem; opacity:0.2; }
  .empty-state p { font-size:0.84rem; max-width:220px; line-height:1.65; }

  /* Live metric row */
  .metric-row { display:grid; grid-template-columns:repeat(4,1fr); gap:0.5rem; margin-bottom:1.5rem; }
  @media(max-width:560px){ .metric-row { grid-template-columns:1fr 1fr; } }
  .metric { background:var(--surface); border:0.5px solid var(--border); border-radius:4px; padding:0.85rem 0.9rem; position:relative; }
  .metric.result { background:var(--r); border-color:var(--r); }
  .m-lbl { font-size:0.62rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:0.3rem; }
  .metric.result .m-lbl { color:rgba(255,255,255,0.75); }
  .m-val { font-size:1.35rem; font-weight:200; color:#fff; line-height:1; transition:opacity 0.15s; }
  .m-sub { font-size:0.65rem; color:var(--muted); margin-top:0.25rem; }
  .metric.result .m-sub { color:rgba(255,255,255,0.7); }
  .m-sign { position:absolute; top:0.7rem; right:0.75rem; font-size:1.1rem; color:var(--muted); font-weight:300; }

  /* Section titles */
  .section-title { font-size:0.62rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--muted); margin:1.5rem 0 0.85rem; }

  /* Legend */
  .legend-row { display:flex; gap:1rem; margin-bottom:1rem; flex-wrap:wrap; }
  .leg { display:flex; align-items:center; gap:0.4rem; font-size:0.72rem; color:var(--text); }
  .leg-dot { width:9px; height:9px; border-radius:2px; flex-shrink:0; }

  /* Stacked horizontal bars — signature element */
  .stack-row { margin-bottom:1rem; }
  .stack-row.best { background:rgba(34,197,94,0.05); border:0.5px solid rgba(34,197,94,0.25); border-radius:5px; padding:0.7rem 0.8rem; margin-left:-0.8rem; margin-right:-0.8rem; }
  .stack-top { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.5rem; gap:0.5rem; flex-wrap:wrap; }
  .stack-country { font-size:0.85rem; font-weight:500; color:#fff; display:flex; align-items:center; gap:0.5rem; }
  .stack-total { font-size:1.05rem; font-weight:200; color:#fff; }
  .stack-row.best .stack-total { color:var(--g); }
  .best-badge { font-size:0.6rem; background:rgba(34,197,94,0.15); color:var(--g); padding:0.15rem 0.5rem; border-radius:100px; font-weight:500; letter-spacing:0.04em; }
  .stack-bar { height:24px; border-radius:4px; overflow:hidden; display:flex; background:rgba(255,255,255,0.05); }
  .seg { height:100%; transition:width 0.6s cubic-bezier(.25,.8,.25,1); width:0%; }
  .seg-fob { background:var(--fob-c); }
  .seg-duty { background:var(--duty-c); }
  .seg-freight { background:var(--frt-c); }

  /* Margin card */
  .margin-card { background:var(--surface); border:0.5px solid var(--border); border-radius:5px; padding:1.1rem 1.2rem; margin-bottom:1.25rem; }
  .margin-num-row { display:flex; align-items:baseline; gap:0.65rem; margin-bottom:0.4rem; }
  .margin-num { font-size:1.9rem; font-weight:200; line-height:1; }
  .margin-tag { font-size:0.68rem; font-weight:600; padding:0.2rem 0.6rem; border-radius:100px; letter-spacing:0.02em; }
  .margin-note { font-size:0.78rem; color:var(--muted); line-height:1.6; }

  /* Savings strip */
  .savings-strip { background:rgba(34,197,94,0.07); border:0.5px solid rgba(34,197,94,0.3); border-radius:5px; padding:0.85rem 1rem; margin-bottom:1.25rem; font-size:0.82rem; color:#86efac; display:flex; align-items:center; gap:0.6rem; line-height:1.6; }
  .savings-icon { font-size:1.1rem; flex-shrink:0; }
  .savings-strip strong { color:var(--g); font-weight:600; }

  /* CTA strip */
  .cta-strip { display:flex; align-items:center; justify-content:space-between; gap:0.85rem; background:var(--surface); border:0.5px solid var(--border); border-radius:5px; padding:0.9rem 1.1rem; flex-wrap:wrap; }
  .cta-strip p { font-size:0.78rem; color:var(--text); line-height:1.6; flex:1; min-width:200px; }
  .cta-btns { display:flex; gap:0.5rem; flex-wrap:wrap; }
  .btn-solid { background:var(--r); color:#fff; border:none; padding:0.65rem 1.1rem; font-size:0.71rem; letter-spacing:0.1em; text-transform:uppercase; border-radius:3px; font-family:inherit; cursor:pointer; white-space:nowrap; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; transition:background 0.18s; min-height:38px; }
  .btn-solid:hover { background:var(--rd); }
  .whatsapp-btn { background:transparent; color:var(--g); border:0.5px solid rgba(34,197,94,0.4); padding:0.65rem 1rem; font-size:0.71rem; letter-spacing:0.1em; text-transform:uppercase; border-radius:3px; font-family:inherit; cursor:pointer; white-space:nowrap; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; transition:background 0.18s; min-height:38px; }
  .whatsapp-btn:hover { background:rgba(34,197,94,0.08); }

  .disclaimer { font-size:0.69rem; color:var(--muted); line-height:1.7; margin-top:1.25rem; padding-top:1rem; border-top:0.5px solid var(--border); }

  /* ── SEO CONTENT ── */
  .seo { border-top:0.5px solid var(--border); padding-top:3rem; }
  .seo h2 { font-size:1.3rem; font-weight:300; color:#fff; margin:2.5rem 0 0.9rem; letter-spacing:0.03em; }
  .seo h2:first-child { margin-top:0; }
  .seo h3 { font-size:0.97rem; font-weight:500; color:#fff; margin:1.75rem 0 0.55rem; }
  .seo p { font-size:0.875rem; color:var(--text); line-height:1.9; margin-bottom:1rem; }
  .seo ul { margin:0.75rem 0 1rem; padding:0; list-style:none; }
  .seo li { font-size:0.875rem; color:var(--text); line-height:1.8; padding-left:1.2rem; position:relative; margin-bottom:0.3rem; }
  .seo li::before { content:'—'; position:absolute; left:0; color:var(--r); }
  .seo a { color:var(--r); text-decoration:none; }
  .seo a:hover { text-decoration:underline; }
  .last-updated { font-size:0.69rem; color:var(--muted); margin-bottom:2rem; }

  .data-table { width:100%; border-collapse:collapse; margin:1.25rem 0; font-size:0.82rem; }
  .data-table th { font-size:0.62rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted); padding:0.6rem 0.75rem; border-bottom:0.5px solid var(--border); text-align:left; font-weight:400; }
  .data-table td { padding:0.65rem 0.75rem; color:var(--text); border-bottom:0.5px solid rgba(255,255,255,0.04); vertical-align:top; }
  .data-table tr:last-child td { border-bottom:none; }
  .data-table td:first-child { color:#fff; font-weight:500; }

  .faq-list { margin:1.25rem 0; }
  .faq-item { border-bottom:0.5px solid var(--border); }
  .faq-item:first-child { border-top:0.5px solid var(--border); }
  .faq-btn { width:100%; background:none; border:none; color:#fff; cursor:pointer; padding:1rem 0; font-size:0.88rem; font-weight:500; font-family:inherit; display:flex; align-items:center; justify-content:space-between; gap:1rem; text-align:left; line-height:1.45; transition:color 0.15s; }
  .faq-btn:hover { color:var(--r); }
  .faq-btn:focus-visible { outline:2px solid var(--r); outline-offset:3px; }
  .faq-icon { flex-shrink:0; width:22px; height:22px; border:0.5px solid rgba(255,255,255,0.2); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.85rem; color:rgba(255,255,255,0.4); transition:all 0.22s; }
  .faq-btn[aria-expanded="true"] .faq-icon { border-color:var(--r); color:var(--r); transform:rotate(45deg); }
  .faq-answer { overflow:hidden; max-height:0; transition:max-height 0.38s ease, padding 0.2s ease; font-size:0.85rem; color:var(--text); line-height:1.9; }
  .faq-answer.open { max-height:500px; padding-bottom:1rem; }
  .faq-answer p { margin:0; }

  @media(prefers-reduced-motion:reduce){
    .seg, .faq-answer, .faq-icon { transition:none; }
  }
</style>

<div class="tool-page">

  <nav class="crumb-nav" aria-label="Breadcrumb">
    <ol itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1" />
      </li>
      <li class="crumb-sep">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/tools" itemprop="item"><span itemprop="name">Free Tools</span></a>
        <meta itemprop="position" content="2" />
      </li>
      <li class="crumb-sep">/</li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span style="color:#fff;" itemprop="name">Garment Cost Calculator</span>
        <meta itemprop="position" content="3" />
      </li>
    </ol>
  </nav>

  <div class="hero">
    <span class="hero-eyebrow">Free Tool · Live Calculation · No Signup</span>
    <h1>What will this order<br><em>actually</em> cost you?</h1>
    <p class="hero-sub">The FOB price your clothing manufacturer quotes is only part of the number that matters. Add duty and freight and the real landed cost per unit can look very different — sometimes enough to change which country makes sense to source from. Adjust the fields on the left and watch every number update instantly.</p>
    <div class="pill-row">
      <span class="pill">Live FOB + duty + freight</span>
      <span class="pill">Gross margin calculator</span>
      <span class="pill">Bangladesh vs China vs Vietnam</span>
    </div>
  </div>

  <div class="dash">

    <!-- SIDEBAR -->
    <div class="side">

      <div>
        <span class="sec-lbl">Garment type</span>
        <div class="ig" id="fg-garment">
          <select id="garment-type" aria-label="Select garment type">
            <option value="">Select garment…</option>
            <option value="tshirt">T-Shirt / Basic Top</option>
            <option value="polo">Polo Shirt</option>
            <option value="hoodie">Hoodie / Sweatshirt</option>
            <option value="jacket">Jacket / Outerwear</option>
            <option value="pants">Pants / Trousers</option>
            <option value="shorts">Shorts</option>
            <option value="dress">Dress / Skirt</option>
            <option value="activewear">Activewear / Sportswear</option>
            <option value="denim">Denim Jeans</option>
            <option value="swimwear">Swimwear</option>
          </select>
          <span class="ig-error">Please select a garment type.</span>
        </div>
      </div>

      <div>
        <span class="sec-lbl">Fabric type</span>
        <div class="ig" id="fg-fabric">
          <select id="fabric-type" aria-label="Select fabric type">
            <option value="">Select fabric…</option>
            <option value="cotton">100% Cotton</option>
            <option value="organic-cotton">Organic Cotton (GOTS)</option>
            <option value="polyester">100% Polyester</option>
            <option value="poly-cotton">Poly-Cotton Blend</option>
            <option value="fleece">Fleece / French Terry</option>
            <option value="denim">Denim</option>
            <option value="nylon">Nylon / Ripstop</option>
            <option value="recycled">Recycled Fabric (GRS)</option>
          </select>
          <span class="ig-error">This fabric isn't typical for this garment — try another combination.</span>
        </div>
      </div>

      <div class="side-divider"></div>

      <div>
        <span class="sec-lbl">Order quantity</span>
        <div class="ig" id="fg-quantity">
          <select id="quantity" aria-label="Select order quantity">
            <option value="">Select quantity…</option>
            <option value="300">300 pieces (min MOQ)</option>
            <option value="500">500 pieces</option>
            <option value="1000" selected>1,000 pieces</option>
            <option value="2000">2,000 pieces</option>
            <option value="5000">5,000 pieces</option>
            <option value="10000">10,000 pieces</option>
            <option value="25000">25,000+ pieces</option>
          </select>
          <span class="ig-error">Please select an order quantity.</span>
        </div>
      </div>

      <div>
        <span class="sec-lbl">Destination</span>
        <div class="ig" id="fg-destination">
          <select id="destination" aria-label="Select destination country">
            <option value="">Select destination…</option>
            <option value="usa">🇺🇸 United States</option>
            <option value="uk">🇬🇧 United Kingdom</option>
            <option value="eu">🇪🇺 European Union</option>
            <option value="australia">🇦🇺 Australia</option>
            <option value="canada">🇨🇦 Canada</option>
          </select>
          <span class="ig-error">Please select a destination country.</span>
        </div>
      </div>

      <div>
        <span class="sec-lbl">Shipping mode</span>
        <div class="ig">
          <select id="shipping-mode" aria-label="Select shipping mode">
            <option value="sea">Sea freight (standard)</option>
            <option value="air">Air freight (express)</option>
          </select>
        </div>
      </div>

      <div class="side-divider"></div>

      <div>
        <span class="sec-lbl">Target retail price <span style="text-transform:none;letter-spacing:0;color:var(--muted);">(optional)</span></span>
        <div class="ig">
          <input type="number" id="retail-price" placeholder="e.g. 28" min="1" max="500" aria-label="Enter your target retail price in USD" />
        </div>
      </div>

    </div>

    <!-- MAIN PANEL -->
    <div class="main">

      <div class="empty-state" id="empty-state">
        <div class="empty-icon" aria-hidden="true">$</div>
        <p>Select a garment, fabric, quantity, and destination on the left to see your live cost breakdown</p>
      </div>

      <div id="results-panel" style="display:none;" aria-live="polite">

        <div class="metric-row" id="metric-row"></div>

        <div class="section-title" id="result-title-line">Bangladesh vs China vs Vietnam — same specification</div>
        <div class="legend-row">
          <span class="leg"><span class="leg-dot" style="background:var(--fob-c);"></span>FOB</span>
          <span class="leg"><span class="leg-dot" style="background:var(--duty-c);"></span>Duty</span>
          <span class="leg"><span class="leg-dot" style="background:var(--frt-c);"></span>Freight</span>
        </div>

        <div id="stack-rows"></div>

        <div class="margin-card" id="margin-card" style="display:none;"></div>

