<script>
  const FOB_BD = {
    tshirt:     { cotton: 3.8,  'organic-cotton': 5.2,  polyester: 3.2, 'poly-cotton': 3.5, fleece: null, denim: null, nylon: null, recycled: 5.0 },
    polo:       { cotton: 5.5,  'organic-cotton': 7.2,  polyester: 4.8, 'poly-cotton': 5.0, fleece: null, denim: null, nylon: null, recycled: 7.0 },
    hoodie:     { cotton: 9.5,  'organic-cotton': 13.0, polyester: 8.0, 'poly-cotton': 9.0, fleece: 10.0, denim: null, nylon: null, recycled: 12.5 },
    jacket:     { cotton: 14.0, 'organic-cotton': 18.0, polyester: 11.0,'poly-cotton': 13.0,fleece: 15.0, denim: null, nylon: 16.0, recycled: 17.0 },
    pants:      { cotton: 8.0,  'organic-cotton': 11.0, polyester: 6.5, 'poly-cotton': 7.5, fleece: null, denim: 10.0, nylon: null, recycled: 10.5 },
    shorts:     { cotton: 5.5,  'organic-cotton': 7.5,  polyester: 4.5, 'poly-cotton': 5.0, fleece: null, denim: 7.0, nylon: 5.5, recycled: 7.0 },
    dress:      { cotton: 9.0,  'organic-cotton': 12.5, polyester: 7.5, 'poly-cotton': 8.5, fleece: null, denim: null, nylon: null, recycled: 12.0 },
    activewear: { cotton: 7.0,  'organic-cotton': 9.5,  polyester: 5.5, 'poly-cotton': 6.5, fleece: null, denim: null, nylon: 8.0, recycled: 8.5 },
    denim:      { cotton: null, 'organic-cotton': null, polyester: null,'poly-cotton': null,fleece: null, denim: 11.0, nylon: null, recycled: null },
    swimwear:   { cotton: null, 'organic-cotton': null, polyester: 8.5, 'poly-cotton': null, fleece: null, denim: null, nylon: 9.0, recycled: 9.5 }
  };

  const FOB_MULTIPLIER = { china: 1.30, vietnam: 1.15 };
  const QTY_MULTIPLIER = { '300': 1.12, '500': 1.07, '1000': 1.0, '2000': 0.95, '5000': 0.90, '10000': 0.86, '25000': 0.82 };

  const DUTY_RATES = {
    usa: {
      tshirt: [15.5, 32.0, 16.5], polo: [19.7, 28.0, 20.0], hoodie: [17.5, 27.7, 17.5],
      jacket: [27.7, 45.0, 27.7], pants: [16.6, 28.6, 16.6], shorts: [11.5, 27.0, 11.5],
      dress: [12.0, 28.2, 12.0], activewear: [14.9, 27.0, 14.9], denim: [16.6, 28.6, 16.6], swimwear: [4.7, 27.7, 4.7]
    },
    uk: { tshirt:[0,12,12], polo:[0,12,12], hoodie:[0,12,12], jacket:[0,12,12], pants:[0,12,12], shorts:[0,12,12], dress:[0,12,12], activewear:[0,12,12], denim:[0,12,12], swimwear:[0,12,12] },
    eu: { tshirt:[0,12,12], polo:[0,12,12], hoodie:[0,12,12], jacket:[0,12,12], pants:[0,12,12], shorts:[0,12,12], dress:[0,12,12], activewear:[0,12,12], denim:[0,12,12], swimwear:[0,12,12] },
    australia: { tshirt:[0,5,0], polo:[0,5,0], hoodie:[0,5,0], jacket:[0,5,0], pants:[0,5,0], shorts:[0,5,0], dress:[0,5,0], activewear:[0,5,0], denim:[0,5,0], swimwear:[0,5,0] },
    canada: { tshirt:[0,18,18], polo:[0,18,18], hoodie:[0,18,18], jacket:[0,18,18], pants:[0,18,18], shorts:[0,18,18], dress:[0,18,18], activewear:[0,18,18], denim:[0,18,18], swimwear:[0,18,18] }
  };

  const FREIGHT_SEA = { '300': 1.80, '500': 1.40, '1000': 1.10, '2000': 0.85, '5000': 0.65, '10000': 0.55, '25000': 0.45 };
  const FREIGHT_AIR_MULT = 4.2;

  const DEST_LABELS = { usa: 'US', uk: 'UK', eu: 'EU', australia: 'AU', canada: 'CA' };
  const GARMENT_LABELS = { tshirt:'T-Shirts', polo:'Polo Shirts', hoodie:'Hoodies', jacket:'Jackets', pants:'Pants', shorts:'Shorts', dress:'Dresses', activewear:'Activewear', denim:'Denim Jeans', swimwear:'Swimwear' };

  function fmt(n) { return '$' + n.toFixed(2); }
  function fmtPct(n) { return n.toFixed(1) + '%'; }
  function setErr(id, show) { const el = document.getElementById(id); if (el) el.classList.toggle('has-error', show); }
  function v(id) { return document.getElementById(id).value; }

  function calc() {
    const garment  = v('garment-type');
    const fabric   = v('fabric-type');
    const qty      = v('quantity');
    const dest     = v('destination');
    const retail   = parseFloat(v('retail-price')) || 0;
    const shipMode = v('shipping-mode');

    const emptyEl = document.getElementById('empty-state');
    const resEl   = document.getElementById('results-panel');

    if (!garment) { setErr('fg-garment', false); }
    if (!fabric)  { setErr('fg-fabric', false); }
    if (!qty)     { setErr('fg-quantity', false); }
    if (!dest)    { setErr('fg-destination', false); }

    if (!garment || !fabric || !qty || !dest) {
      emptyEl.style.display = 'flex';
      resEl.style.display = 'none';
      return;
    }

    const baseFOBRow = FOB_BD[garment];
    if (!baseFOBRow || baseFOBRow[fabric] === null || baseFOBRow[fabric] === undefined) {
      setErr('fg-fabric', true);
      emptyEl.style.display = 'flex';
      resEl.style.display = 'none';
      const emptyP = emptyEl.querySelector('p');
      emptyP.textContent = 'This fabric isn\u2019t typically used for ' + (GARMENT_LABELS[garment] || 'this garment') + '. Try a different fabric.';
      return;
    }
    setErr('fg-fabric', false);

    const baseFOB = baseFOBRow[fabric] * QTY_MULTIPLIER[qty];
    const freightSea = FREIGHT_SEA[qty];
    const freight = shipMode === 'air' ? freightSea * FREIGHT_AIR_MULT : freightSea;

    const dutyRates = DUTY_RATES[dest][garment];
    const dutyAmtBD = baseFOB * (dutyRates[0] / 100);
    const landedBD = baseFOB + dutyAmtBD + freight;

    const fobCN = baseFOB * FOB_MULTIPLIER.china;
    const dutyAmtCN = fobCN * (dutyRates[1] / 100);
    const landedCN = fobCN + dutyAmtCN + freight;

    const fobVN = baseFOB * FOB_MULTIPLIER.vietnam;
    const dutyAmtVN = fobVN * (dutyRates[2] / 100);
    const landedVN = fobVN + dutyAmtVN + freight;

    /* Live metric cards */
    document.getElementById('metric-row').innerHTML =
      '<div class="metric"><div class="m-lbl">FOB Price</div><div class="m-val">' + fmt(baseFOB) + '</div><div class="m-sub">per unit, ex-factory</div><span class="m-sign">+</span></div>' +
      '<div class="metric"><div class="m-lbl">Import Duty</div><div class="m-val">' + fmt(dutyAmtBD) + '</div><div class="m-sub">' + fmtPct(dutyRates[0]) + ' rate</div><span class="m-sign">+</span></div>' +
      '<div class="metric"><div class="m-lbl">Freight</div><div class="m-val">' + fmt(freight) + '</div><div class="m-sub">' + (shipMode === 'air' ? 'air freight' : 'sea freight') + '</div><span class="m-sign">=</span></div>' +
      '<div class="metric result"><div class="m-lbl">Landed Cost</div><div class="m-val">' + fmt(landedBD) + '</div><div class="m-sub">delivered, per unit</div></div>';

    const qtyLabel = qty === '25000' ? '25,000+' : Number(qty).toLocaleString();
    document.getElementById('result-title-line').textContent =
      qtyLabel + ' ' + (GARMENT_LABELS[garment] || garment) + ' \u2192 ' + (DEST_LABELS[dest] || dest) + ' — Bangladesh vs China vs Vietnam';

    /* Stacked comparison bars */
    const countries = [
      { name: 'Bangladesh', tag: 'SDF', fob: baseFOB, duty: dutyAmtBD, freight: freight, total: landedBD },
      { name: 'China', tag: null, fob: fobCN, duty: dutyAmtCN, freight: freight, total: landedCN },
      { name: 'Vietnam', tag: null, fob: fobVN, duty: dutyAmtVN, freight: freight, total: landedVN }
    ];
    const maxTotal = Math.max(...countries.map(c => c.total));
    const cheapest = countries.reduce((a, b) => a.total < b.total ? a : b);

    const stackEl = document.getElementById('stack-rows');
    stackEl.innerHTML = '';
    countries.forEach(c => {
      const isBest = c.name === cheapest.name;
      const scale = 100 / maxTotal;

      const row = document.createElement('div');
      row.className = 'stack-row' + (isBest ? ' best' : '');

      const top = document.createElement('div');
      top.className = 'stack-top';

      const countryEl = document.createElement('div');
      countryEl.className = 'stack-country';
      countryEl.textContent = c.name;
      if (c.tag) {
        const tagEl = document.createElement('span');
        tagEl.style.fontSize = '0.6rem';
        tagEl.style.color = 'var(--muted)';
        tagEl.textContent = '(' + c.tag + ')';
        countryEl.appendChild(tagEl);
      }
      if (isBest) {
        const bestBadge = document.createElement('span');
        bestBadge.className = 'best-badge';
        bestBadge.textContent = 'Lowest landed cost';
        countryEl.appendChild(bestBadge);
      }

      const totalEl = document.createElement('div');
      totalEl.className = 'stack-total';
      totalEl.textContent = fmt(c.total);

      top.appendChild(countryEl);
      top.appendChild(totalEl);

      const bar = document.createElement('div');
      bar.className = 'stack-bar';

      const segFob = document.createElement('div');
      segFob.className = 'seg seg-fob';
      const segDuty = document.createElement('div');
      segDuty.className = 'seg seg-duty';
      const segFreight = document.createElement('div');
      segFreight.className = 'seg seg-freight';

      bar.appendChild(segFob);
      bar.appendChild(segDuty);
      bar.appendChild(segFreight);

      row.appendChild(top);
      row.appendChild(bar);
      stackEl.appendChild(row);

      requestAnimationFrame(() => {
        segFob.style.width = (c.fob * scale) + '%';
        segDuty.style.width = (c.duty * scale) + '%';
        segFreight.style.width = (c.freight * scale) + '%';
      });
    });

    /* Margin card */
    const marginCard = document.getElementById('margin-card');
    if (retail > 0) {
      marginCard.style.display = 'block';
      const margin = Math.max(0, Math.min(100, ((retail - landedBD) / retail) * 100));
      let tagBg, tagColor, tagText, note;
      if (margin >= 65) {
        tagBg = 'rgba(34,197,94,0.15)'; tagColor = '#22c55e'; tagText = 'Strong';
        note = 'Strong margin — above the typical 65\u201375% DTC benchmark. Worth checking your retail price is still competitive for the category.';
      } else if (margin >= 50) {
        tagBg = 'rgba(250,204,21,0.15)'; tagColor = '#facc15'; tagText = 'Healthy';
        note = 'Healthy margin for a DTC model. There may be room to optimise freight or scale quantity for a better FOB.';
      } else if (margin >= 35) {
        tagBg = 'rgba(245,158,11,0.15)'; tagColor = '#f59e0b'; tagText = 'Tight';
        note = 'Tight once marketing, returns, and platform fees are factored in. Consider raising retail price or increasing order quantity.';
      } else {
        tagBg = 'rgba(239,68,68,0.15)'; tagColor = '#ef4444'; tagText = 'Low';
        note = 'Low margin at this retail price. Revisit pricing, increase quantity to reduce FOB, or consider sea freight if currently using air.';
      }
      marginCard.innerHTML =
        '<div class="sec-lbl" style="margin-bottom:0.6rem;">Gross margin at $' + retail.toFixed(0) + ' retail</div>' +
        '<div class="margin-num-row"><span class="margin-num" style="color:' + tagColor + ';">' + fmtPct(margin) + '</span>' +
        '<span class="margin-tag" style="background:' + tagBg + ';color:' + tagColor + ';">' + tagText + '</span></div>' +
        '<p class="margin-note">' + note + '</p>';
    } else {
      marginCard.style.display = 'none';
    }

    /* Savings strip */
    const savingsEl = document.getElementById('savings-strip');
    if (landedBD < landedCN) {
      const saving = landedCN - landedBD;
      const savingTotal = saving * parseInt(qty, 10);
      savingsEl.style.display = 'flex';
      savingsEl.innerHTML = '<span class="savings-icon" aria-hidden="true">\u2193</span><span>Sourcing from Bangladesh saves <strong>' + fmt(saving) + ' per unit</strong> vs China on this spec — roughly <strong>$' + Math.round(savingTotal).toLocaleString() + '</strong> across this order.</span>';
      document.getElementById('cta-text').textContent = 'Bangladesh saves you ' + fmt(saving) + ' per unit vs China. Get an exact FOB quote from SDF Clothing within 48 hours.';
    } else {
      savingsEl.style.display = 'none';
      document.getElementById('cta-text').textContent = 'Get an exact FOB quote from SDF Clothing within 48 hours — no obligation, no middlemen.';
    }

    emptyEl.style.display = 'none';
    resEl.style.display = 'block';
  }

  ['garment-type', 'fabric-type', 'quantity', 'destination', 'shipping-mode'].forEach(id => {
    document.getElementById(id).addEventListener('change', calc);
  });
  document.getElementById('retail-price').addEventListener('input', calc);

  /* FAQ accordion */
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.nextElementSibling.classList.remove('open');
      });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.classList.add('open');
      }
    });
  });
</script>

