---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Garment Cost Calculator — Real FOB, Duty & Landed Cost | SDF Clothing";
const pageDescription = "Free garment cost calculator for clothing brands. Enter garment type, quantity, and destination — get FOB price, import duty, freight, landed cost per unit, and gross margin instantly. Bangladesh vs China vs Vietnam comparison included.";
const canonicalUrl = "https://sdfltd.com/tools/garment-cost-calculator";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  dateModified={new Date().toISOString().split("T")[0]}
>

<meta property="og:title" content="Garment Cost Calculator — FOB, Duty & Landed Cost" />
<meta property="og:description" content="Free tool for clothing brands. Get FOB price, import duty, freight and landed cost per unit instantly. Compare Bangladesh vs China vs Vietnam." />
<meta property="og:url" content="https://sdfltd.com/tools/garment-cost-calculator" />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Garment Cost Calculator",
  "url": "https://sdfltd.com/tools/garment-cost-calculator",
  "description": "Free garment cost calculator. Calculate FOB price, import duty, freight, and landed cost per unit for clothing brands sourcing from Bangladesh, China, or Vietnam.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "provider": {
    "@type": "Organization",
    "name": "SDF Clothing",
    "url": "https://sdfltd.com"
  }
}
</script>

<style>
.tool-page { max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
.tool-hero { margin-bottom: 3rem; }
.tool-hero h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 300; color: #fff; letter-spacing: 0.04em; line-height: 1.2; margin-bottom: 0.75rem; }
.tool-hero p { font-size: 0.9rem; color: rgba(255,255,255,0.65); max-width: 600px; line-height: 1.8; }

.calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
@media (max-width: 600px) { .calc-grid { grid-template-columns: 1fr; } }

.field-group { display: flex; flex-direction: column; gap: 0.5rem; }
.field-group label { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
.field-group select, .field-group input {
  background: #000; color: #fff; border: 1px solid rgba(255,255,255,0.15);
  padding: 0.75rem 1rem; font-size: 0.88rem; width: 100%;
  transition: border-color 0.2s; outline: none; font-family: inherit;
  appearance: none; -webkit-appearance: none;
}
.field-group select:focus, .field-group input:focus { border-color: #e00; }
.field-group select option { background: #111; }

.calc-btn {
  width: 100%; background: #e00; color: #fff; border: none;
  padding: 1rem; font-size: 0.8rem; letter-spacing: 0.15em;
  text-transform: uppercase; cursor: pointer; transition: background 0.2s;
  font-family: inherit; min-height: 48px; margin-bottom: 2rem;
}
.calc-btn:hover { background: #aa0000; }

/* Results */
.results { display: none; }
.results.visible { display: block; }

.results-header { margin-bottom: 1.5rem; }
.results-header p { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #e00; margin-bottom: 0.4rem; }
.results-header h2 { font-size: 1.3rem; font-weight: 300; color: #fff; }

.cost-breakdown { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.08); margin-bottom: 1.5rem; }
@media (max-width: 600px) { .cost-breakdown { grid-template-columns: 1fr 1fr; } }

.cost-item { background: #000; padding: 1.25rem 1rem; }
.cost-item .ci-label { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 0.4rem; }
.cost-item .ci-value { font-size: 1.4rem; font-weight: 300; color: #fff; }
.cost-item .ci-sub { font-size: 0.72rem; color: rgba(255,255,255,0.4); margin-top: 0.2rem; }
.cost-item.highlight { background: #e00; }
.cost-item.highlight .ci-label { color: rgba(255,255,255,0.7); }
.cost-item.highlight .ci-value { color: #fff; }
.cost-item.highlight .ci-sub { color: rgba(255,255,255,0.7); }

/* Margin bar */
.margin-section { border: 1px solid rgba(255,255,255,0.1); padding: 1.25rem; margin-bottom: 1.5rem; }
.margin-section h3 { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 1rem; }
.margin-bar-wrap { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
.margin-bar-bg { flex: 1; height: 6px; background: rgba(255,255,255,0.08); position: relative; }
.margin-bar-fill { height: 100%; background: #e00; transition: width 0.5s ease; }
.margin-pct { font-size: 1.4rem; font-weight: 300; color: #fff; min-width: 60px; text-align: right; }
.margin-note { font-size: 0.78rem; color: rgba(255,255,255,0.70); }

/* Country comparison */
.comparison-section { margin-bottom: 2rem; }
.comparison-section h3 { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 1rem; }
.comparison-rows { display: flex; flex-direction: column; gap: 1px; background: rgba(255,255,255,0.08); }
.comp-row { background: #000; display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; padding: 0.9rem 1rem; gap: 0.5rem; align-items: center; }
.comp-row.header { background: #0a0a0a; }
.comp-row.active-country { border-left: 2px solid #e00; }
.comp-cell { font-size: 0.82rem; color: #fff; }
.comp-cell.label { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
.comp-cell.best { color: #4ade80; }
.comp-tag { font-size: 0.62rem; background: #e00; color: #fff; padding: 0.15rem 0.4rem; letter-spacing: 0.08em; text-transform: uppercase; margin-left: 0.5rem; }

/* CTA */
.result-cta { background: #000; border: 1px solid #e00; padding: 2rem; text-align: center; }
.result-cta p { font-size: 0.85rem; color: rgba(255,255,255,0.65); margin-bottom: 1.25rem; line-height: 1.7; }
.result-cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

.disclaimer { font-size: 0.72rem; color: rgba(255,255,255,0.3); line-height: 1.6; margin-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 1.25rem; }
</style>

<div class="tool-page">

  <nav aria-label="Breadcrumb" style="margin-bottom:2rem;">
    <ol style="display:flex;gap:0.5rem;list-style:none;font-size:0.72rem;color:rgba(255,255,255,0.35);">
      <li><a href="/" style="color:rgba(255,255,255,0.35);text-decoration:none;" title="Home">Home</a></li>
      <li style="color:rgba(255,255,255,0.2);">/</li>
      <li><a href="/tools" style="color:rgba(255,255,255,0.35);text-decoration:none;" title="Free Tools">Tools</a></li>
      <li style="color:rgba(255,255,255,0.2);">/</li>
      <li style="color:#fff;">Garment Cost Calculator</li>
    </ol>
  </nav>

  <div class="tool-hero">
    <span class="section-label">Free Tool</span>
    <h1>Garment Cost Calculator</h1>
    <p>Enter your garment details and get an instant breakdown — FOB price, import duty, freight, and landed cost per unit. Includes Bangladesh vs China vs Vietnam comparison.</p>
  </div>

  <!-- INPUT FORM -->
  <div class="calc-grid">
    <div class="field-group">
      <label for="garment-type">Garment Type</label>
      <select id="garment-type">
        <option value="">Select garment type</option>
        <option value="tshirt">T-Shirt / Basic Top</option>
        <option value="polo">Polo Shirt</option>
        <option value="hoodie">Hoodie / Sweatshirt</option>
        <option value="jacket">Jacket / Outerwear</option>
        <option value="pants">Pants / Trousers</option>
        <option value="shorts">Shorts</option>
        <option value="dress">Dress / Skirt</option>
        <option value="activewear">Activewear / Sportswear</option>
        <option value="denim">Denim Jeans</option>
        <option value="swimwear">Swimwear</option>
      </select>
    </div>

    <div class="field-group">
      <label for="fabric-type">Fabric Type</label>
      <select id="fabric-type">
        <option value="">Select fabric</option>
        <option value="cotton">100% Cotton</option>
        <option value="organic-cotton">Organic Cotton (GOTS)</option>
        <option value="polyester">100% Polyester</option>
        <option value="poly-cotton">Poly-Cotton Blend</option>
        <option value="fleece">Fleece / French Terry</option>
        <option value="denim">Denim</option>
        <option value="nylon">Nylon / Ripstop</option>
        <option value="recycled">Recycled Fabric (GRS)</option>
      </select>
    </div>

    <div class="field-group">
      <label for="quantity">Order Quantity (pieces)</label>
      <select id="quantity">
        <option value="">Select quantity</option>
        <option value="300">300 pieces (min MOQ)</option>
        <option value="500">500 pieces</option>
        <option value="1000">1,000 pieces</option>
        <option value="2000">2,000 pieces</option>
        <option value="5000">5,000 pieces</option>
        <option value="10000">10,000 pieces</option>
        <option value="25000">25,000+ pieces</option>
      </select>
    </div>

    <div class="field-group">
      <label for="destination">Destination Country</label>
      <select id="destination">
        <option value="">Select destination</option>
        <option value="usa">🇺🇸 United States</option>
        <option value="uk">🇬🇧 United Kingdom</option>
        <option value="eu">🇪🇺 European Union</option>
        <option value="australia">🇦🇺 Australia</option>
        <option value="canada">🇨🇦 Canada</option>
      </select>
    </div>

    <div class="field-group">
      <label for="retail-price">Your Target Retail Price (USD)</label>
      <input type="number" id="retail-price" placeholder="e.g. 45" min="1" max="500" />
    </div>

    <div class="field-group">
      <label for="shipping-mode">Shipping Mode</label>
      <select id="shipping-mode">
        <option value="sea">Sea Freight (standard)</option>
        <option value="air">Air Freight (express)</option>
      </select>
    </div>
  </div>

  <button class="calc-btn" id="calc-button" onclick="calculateCost()">
    Calculate My Costs →
  </button>

  <!-- RESULTS -->
  <div class="results" id="results">

    <div class="results-header">
      <p>Your Cost Breakdown</p>
      <h2 id="result-title">Estimated costs for your order</h2>
    </div>

    <div class="cost-breakdown">
      <div class="cost-item">
        <div class="ci-label">FOB Price</div>
        <div class="ci-value" id="r-fob">—</div>
        <div class="ci-sub">per unit, ex-factory</div>
      </div>
      <div class="cost-item">
        <div class="ci-label">Import Duty</div>
        <div class="ci-value" id="r-duty">—</div>
        <div class="ci-sub" id="r-duty-rate">on FOB value</div>
      </div>
      <div class="cost-item">
        <div class="ci-label">Freight + Handling</div>
        <div class="ci-value" id="r-freight">—</div>
        <div class="ci-sub" id="r-freight-mode">per unit</div>
      </div>
      <div class="cost-item highlight">
        <div class="ci-label">Landed Cost</div>
        <div class="ci-value" id="r-landed">—</div>
        <div class="ci-sub">total per unit, delivered</div>
      </div>
    </div>

    <div class="margin-section" id="margin-section" style="display:none;">
      <h3>Gross Margin at Your Retail Price</h3>
      <div class="margin-bar-wrap">
        <div class="margin-bar-bg">
          <div class="margin-bar-fill" id="margin-bar" style="width:0%"></div>
        </div>
        <div class="margin-pct" id="r-margin">—</div>
      </div>
      <p class="margin-note" id="margin-note"></p>
    </div>

    <div class="comparison-section">
      <h3>Bangladesh vs China vs Vietnam — Your Garment</h3>
      <div class="comparison-rows">
        <div class="comp-row header">
          <div class="comp-cell label">Country</div>
          <div class="comp-cell label">FOB / unit</div>
          <div class="comp-cell label">Duty (to <span id="dest-label">US</span>)</div>
          <div class="comp-cell label">Landed Cost</div>
        </div>
        <div class="comp-row active-country" id="row-bd">
          <div class="comp-cell"><strong>Bangladesh</strong> <span class="comp-tag">SDF</span></div>
          <div class="comp-cell" id="c-bd-fob">—</div>
          <div class="comp-cell" id="c-bd-duty">—</div>
          <div class="comp-cell best" id="c-bd-landed">—</div>
        </div>
        <div class="comp-row" id="row-cn">
          <div class="comp-cell">China</div>
          <div class="comp-cell" id="c-cn-fob">—</div>
          <div class="comp-cell" id="c-cn-duty">—</div>
          <div class="comp-cell" id="c-cn-landed">—</div>
        </div>
        <div class="comp-row" id="row-vn">
          <div class="comp-cell">Vietnam</div>
          <div class="comp-cell" id="c-vn-fob">—</div>
          <div class="comp-cell" id="c-vn-duty">—</div>
          <div class="comp-cell" id="c-vn-landed">—</div>
        </div>
      </div>
    </div>

    <div class="result-cta">
      <p id="cta-text">Get an exact FOB quote from SDF Clothing within 48 hours — no obligation, no middlemen. Factory direct from Dhaka since 1998.</p>
      <div class="result-cta-btns">
        <a href="/contact" class="btn-primary" title="Get a free quote from SDF Clothing">Get Free Quote →</a>
        <a href="https://wa.me/8801911733226?text=Hi%20SDF%2C%20I%20used%20your%20cost%20calculator%20and%20would%20like%20a%20quote." target="_blank" rel="noopener" class="whatsapp-cta" title="WhatsApp SDF Clothing">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
      </div>
    </div>

    <p class="disclaimer">Estimates are based on current Bangladesh market rates for standard production. Actual FOB prices vary by fabric specification, construction complexity, print/embroidery, trim selection, and confirmed order quantity. Duty rates reflect 2025 MFN and GSP tariff schedules; verify with your customs broker before importing. Freight estimates assume standard 40-day sea transit from Chittagong port or 5-day air. All figures in USD.</p>
  </div>

</div>

<script>
// ============================================================
// FOB BASE PRICES (USD per unit) — Bangladesh
// Source: Bangladesh RMG industry averages 2025
// ============================================================
const FOB_BD = {
  tshirt:      { cotton: 3.8,  'organic-cotton': 5.2, polyester: 3.2, 'poly-cotton': 3.5, fleece: null, denim: null, nylon: null, recycled: 5.0 },
  polo:        { cotton: 5.5,  'organic-cotton': 7.2, polyester: 4.8, 'poly-cotton': 5.0, fleece: null, denim: null, nylon: null, recycled: 7.0 },
  hoodie:      { cotton: 9.5,  'organic-cotton': 13.0,'polyester': 8.0,'poly-cotton': 9.0, fleece: 10.0,denim: null, nylon: null, recycled: 12.5 },
  jacket:      { cotton: 14.0, 'organic-cotton': 18.0,'polyester': 11.0,'poly-cotton':13.0,fleece: 15.0,denim: null, nylon: 16.0,recycled: 17.0 },
  pants:       { cotton: 8.0,  'organic-cotton': 11.0,'polyester': 6.5, 'poly-cotton': 7.5,fleece: null, denim: 10.0,nylon: null, recycled: 10.5 },
  shorts:      { cotton: 5.5,  'organic-cotton': 7.5, polyester: 4.5, 'poly-cotton': 5.0, fleece: null, denim: 7.0, nylon: 5.5, recycled: 7.0 },
  dress:       { cotton: 9.0,  'organic-cotton': 12.5,'polyester': 7.5, 'poly-cotton': 8.5,fleece: null, denim: null, nylon: null, recycled: 12.0 },
  activewear:  { cotton: 7.0,  'organic-cotton': 9.5, polyester: 5.5, 'poly-cotton': 6.5, fleece: null, denim: null, nylon: 8.0, recycled: 8.5 },
  denim:       { cotton: null, 'organic-cotton': null, polyester: null,'poly-cotton': null,fleece: null, denim: 11.0,nylon: null, recycled: null },
  swimwear:    { cotton: null, 'organic-cotton': null, polyester: 8.5, 'poly-cotton': null,fleece: null, denim: null, nylon: 9.0, recycled: 9.5 }
};

// China: ~20-35% higher FOB, Vietnam: ~10-20% higher
const FOB_MULTIPLIER = { china: 1.30, vietnam: 1.15 };

// Qty discount multipliers (more pieces = lower FOB)
const QTY_MULTIPLIER = {
  '300': 1.12, '500': 1.07, '1000': 1.0, '2000': 0.95,
  '5000': 0.90, '10000': 0.86, '25000': 0.82
};

// Import duty rates (%) — 2025 MFN + GSP/EBA schedules
// [Bangladesh_rate, China_rate, Vietnam_rate]
const DUTY_RATES = {
  usa: {
    tshirt:    [15.5, 32.0, 16.5], polo:    [19.7, 28.0, 20.0],
    hoodie:    [17.5, 27.7, 17.5], jacket:  [27.7, 45.0, 27.7],
    pants:     [16.6, 28.6, 16.6], shorts:  [11.5, 27.0, 11.5],
    dress:     [12.0, 28.2, 12.0], activewear:[14.9,27.0,14.9],
    denim:     [16.6, 28.6, 16.6], swimwear:[ 4.7, 27.7,  4.7]
  },
  uk: {
    tshirt:    [0, 12.0, 12.0],   polo:    [0, 12.0, 12.0],
    hoodie:    [0, 12.0, 12.0],   jacket:  [0, 12.0, 12.0],
    pants:     [0, 12.0, 12.0],   shorts:  [0, 12.0, 12.0],
    dress:     [0, 12.0, 12.0],   activewear:[0, 12.0, 12.0],
    denim:     [0, 12.0, 12.0],   swimwear:[0, 12.0, 12.0]
  },
  eu: {
    tshirt:    [0, 12.0, 12.0],   polo:    [0, 12.0, 12.0],
    hoodie:    [0, 12.0, 12.0],   jacket:  [0, 12.0, 12.0],
    pants:     [0, 12.0, 12.0],   shorts:  [0, 12.0, 12.0],
    dress:     [0, 12.0, 12.0],   activewear:[0, 12.0, 12.0],
    denim:     [0, 12.0, 12.0],   swimwear:[0, 12.0, 12.0]
  },
  australia: {
    tshirt:    [0, 5.0, 0],      polo:    [0, 5.0, 0],
    hoodie:    [0, 5.0, 0],      jacket:  [0, 5.0, 0],
    pants:     [0, 5.0, 0],      shorts:  [0, 5.0, 0],
    dress:     [0, 5.0, 0],      activewear:[0, 5.0, 0],
    denim:     [0, 5.0, 0],      swimwear:[0, 5.0, 0]
  },
  canada: {
    tshirt:    [0, 18.0, 18.0],  polo:    [0, 18.0, 18.0],
    hoodie:    [0, 18.0, 18.0],  jacket:  [0, 18.0, 18.0],
    pants:     [0, 18.0, 18.0],  shorts:  [0, 18.0, 18.0],
    dress:     [0, 18.0, 18.0],  activewear:[0, 18.0, 18.0],
    denim:     [0, 18.0, 18.0],  swimwear:[0, 18.0, 18.0]
  }
};

// Sea freight per unit (USD) by qty — from Chittagong
const FREIGHT_SEA = {
  '300': 1.80, '500': 1.40, '1000': 1.10, '2000': 0.85,
  '5000': 0.65, '10000': 0.55, '25000': 0.45
};
// Air: ~4-5x sea
const FREIGHT_AIR_MULT = 4.2;

const DEST_LABELS = { usa: 'US', uk: 'UK', eu: 'EU', australia: 'AU', canada: 'CA' };
const GARMENT_LABELS = {
  tshirt: 'T-Shirts', polo: 'Polo Shirts', hoodie: 'Hoodies',
  jacket: 'Jackets', pants: 'Pants', shorts: 'Shorts',
  dress: 'Dresses', activewear: 'Activewear', denim: 'Denim Jeans', swimwear: 'Swimwear'
};

function fmt(n) { return '$' + n.toFixed(2); }
function fmtPct(n) { return n.toFixed(1) + '%'; }

function calculateCost() {
  const garment  = document.getElementById('garment-type').value;
  const fabric   = document.getElementById('fabric-type').value;
  const qty      = document.getElementById('quantity').value;
  const dest     = document.getElementById('destination').value;
  const retail   = parseFloat(document.getElementById('retail-price').value) || 0;
  const shipMode = document.getElementById('shipping-mode').value;

  if (!garment || !fabric || !qty || !dest) {
    alert('Please fill in all required fields (garment type, fabric, quantity, destination).');
    return;
  }

  // Get base FOB
  const baseFOBRow = FOB_BD[garment];
  if (!baseFOBRow || !baseFOBRow[fabric]) {
    alert('This fabric and garment combination is not typically produced. Please select a different combination.');
    return;
  }
  const baseFOB = baseFOBRow[fabric] * QTY_MULTIPLIER[qty];

  // Freight
  const freightSea = FREIGHT_SEA[qty];
  const freight = shipMode === 'air' ? freightSea * FREIGHT_AIR_MULT : freightSea;

  // Duties
  const dutyRates = DUTY_RATES[dest][garment]; // [BD, CN, VN]
  const dutyAmtBD = baseFOB * (dutyRates[0] / 100);

  // Landed cost BD
  const landedBD = baseFOB + dutyAmtBD + freight;

  // China
  const fobCN = baseFOB * FOB_MULTIPLIER.china;
  const dutyAmtCN = fobCN * (dutyRates[1] / 100);
  const landedCN = fobCN + dutyAmtCN + freight;

  // Vietnam
  const fobVN = baseFOB * FOB_MULTIPLIER.vietnam;
  const dutyAmtVN = fobVN * (dutyRates[2] / 100);
  const landedVN = fobVN + dutyAmtVN + freight;

  // Populate results
  document.getElementById('r-fob').textContent = fmt(baseFOB);
  document.getElementById('r-duty').textContent = fmt(dutyAmtBD);
  document.getElementById('r-duty-rate').textContent = fmtPct(dutyRates[0]) + ' duty rate';
  document.getElementById('r-freight').textContent = fmt(freight);
  document.getElementById('r-freight-mode').textContent = shipMode === 'air' ? 'air freight / unit' : 'sea freight / unit';
  document.getElementById('r-landed').textContent = fmt(landedBD);
  document.getElementById('result-title').textContent =
    (qty.replace('25000','25,000+')) + ' ' + (GARMENT_LABELS[garment] || garment) + ' → ' + (DEST_LABELS[dest] || dest);

  // Margin
  if (retail > 0) {
    document.getElementById('margin-section').style.display = 'block';
    const margin = ((retail - landedBD) / retail) * 100;
    document.getElementById('r-margin').textContent = fmtPct(Math.max(0, margin));
    document.getElementById('margin-bar').style.width = Math.min(100, Math.max(0, margin)) + '%';
    let note = '';
    if (margin >= 65) note = 'Excellent margin. Industry benchmark for DTC brands is 65–75%.';
    else if (margin >= 50) note = 'Healthy margin. Consider optimising freight or scaling qty for better FOB.';
    else if (margin >= 35) note = 'Tight margin. Review retail price or increase order quantity to reduce FOB.';
    else note = 'Low margin. Recommend increasing retail price or order quantity, or switching to sea freight.';
    document.getElementById('margin-note').textContent = note;
  }

  // Comparison table
  document.getElementById('dest-label').textContent = DEST_LABELS[dest];
  document.getElementById('c-bd-fob').textContent = fmt(baseFOB);
  document.getElementById('c-bd-duty').textContent = fmtPct(dutyRates[0]);
  document.getElementById('c-bd-landed').textContent = fmt(landedBD);

  document.getElementById('c-cn-fob').textContent = fmt(fobCN);
  document.getElementById('c-cn-duty').textContent = fmtPct(dutyRates[1]);
  document.getElementById('c-cn-landed').textContent = fmt(landedCN);

  document.getElementById('c-vn-fob').textContent = fmt(fobVN);
  document.getElementById('c-vn-duty').textContent = fmtPct(dutyRates[2]);
  document.getElementById('c-vn-landed').textContent = fmt(landedVN);

  // Savings note in CTA
  const saving = landedCN - landedBD;
  const savingTotal = saving * parseInt(qty.replace('25000','25000'));
  if (saving > 0) {
    document.getElementById('cta-text').textContent =
      'Bangladesh saves you ' + fmt(saving) + ' per unit vs China — that\'s ' +
      '$' + Math.round(savingTotal).toLocaleString() + ' on this order alone. Get an exact FOB quote from SDF Clothing within 48 hours.';
  }

  // Show results
  document.getElementById('results').classList.add('visible');
  document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>

</BaseLayout>
