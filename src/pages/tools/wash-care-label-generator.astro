          <p class="wc-tool-link-title">GSM Converter</p>
          <p class="wc-tool-link-desc">Convert fabric weight between GSM, oz/yd², and oz/yd. Essential for buyer spec sheets and fabric sourcing.</p>
        </a>
        <a href="/tools/shrinkage-calculator" class="wc-tool-link">
          <p class="wc-tool-link-label">Tool</p>
          <p class="wc-tool-link-title">Shrinkage Calculator</p>
          <p class="wc-tool-link-desc">Calculate pre-production shrinkage allowances by fabric type and wash method to prevent size grading errors.</p>
        </a>
        <a href="/tools/aql-calculator" class="wc-tool-link">
          <p class="wc-tool-link-label">Tool</p>
          <p class="wc-tool-link-title">AQL Calculator</p>
          <p class="wc-tool-link-desc">Calculate acceptable quality level sample sizes and pass/fail thresholds for garment inspection planning.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="wc-cta" aria-labelledby="cta-heading">
    <div class="wc-wrap">
      <h2 class="wc-cta-title" id="cta-heading">Need Export-Ready Garment Production?</h2>
      <p class="wc-cta-text">SDF Clothing produces garments with correct care labeling, fibre content verification, and full compliance documentation for EU, USA, UK, and Australian markets. MOQ from 300 pieces.</p>
      <a href="/contact" class="wc-cta-btn">Get a Production Quote</a>
    </div>
  </section>

</div>

<script>
  (function () {
    const svgNS = 'http://www.w3.org/2000/svg';

    function makeTub(temp, bars) {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('xmlns', svgNS);
      svg.setAttribute('aria-hidden', 'true');

      const tub = document.createElementNS(svgNS, 'path');
      tub.setAttribute('d', 'M12 18 Q12 14 16 14 L64 14 Q68 14 68 18 L68 60 Q68 64 64 64 L16 64 Q12 64 12 60 Z');
      tub.setAttribute('fill', 'none');
      tub.setAttribute('stroke', 'white');
      tub.setAttribute('stroke-width', '2.5');
      svg.appendChild(tub);

      const wave = document.createElementNS(svgNS, 'path');
      wave.setAttribute('d', 'M12 28 Q20 22 28 28 Q36 34 44 28 Q52 22 60 28 Q65 31 68 28');
      wave.setAttribute('fill', 'none');
      wave.setAttribute('stroke', 'white');
      wave.setAttribute('stroke-width', '1.8');
      svg.appendChild(wave);

      if (temp === 'hand') {
        const hand = document.createElementNS(svgNS, 'path');
        hand.setAttribute('d', 'M28 48 Q28 38 34 34 L40 26 L46 34 Q52 38 52 48');
        hand.setAttribute('fill', 'none');
        hand.setAttribute('stroke', 'white');
        hand.setAttribute('stroke-width', '2');
        svg.appendChild(hand);
      } else {
        const txt = document.createElementNS(svgNS, 'text');
        txt.setAttribute('x', '40');
        txt.setAttribute('y', '54');
        txt.setAttribute('text-anchor', 'middle');
        txt.setAttribute('fill', 'white');
        txt.setAttribute('font-size', '15');
        txt.setAttribute('font-weight', '700');
        txt.setAttribute('font-family', 'sans-serif');
        txt.textContent = temp;
        svg.appendChild(txt);
      }

      for (let i = 0; i < bars; i++) {
        const bar = document.createElementNS(svgNS, 'line');
        bar.setAttribute('x1', '12');
        bar.setAttribute('x2', '68');
        bar.setAttribute('y1', String(68 + i * 5));
        bar.setAttribute('y2', String(68 + i * 5));
        bar.setAttribute('stroke', 'white');
        bar.setAttribute('stroke-width', '2');
        svg.appendChild(bar);
      }
      return svg;
    }

    function makeDoNotWash() {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('aria-hidden', 'true');
      const tub = document.createElementNS(svgNS, 'path');
      tub.setAttribute('d', 'M12 18 Q12 14 16 14 L64 14 Q68 14 68 18 L68 60 Q68 64 64 64 L16 64 Q12 64 12 60 Z');
      tub.setAttribute('fill', 'none'); tub.setAttribute('stroke', 'white'); tub.setAttribute('stroke-width', '2.5');
      svg.appendChild(tub);
      const x = document.createElementNS(svgNS, 'line');
      x.setAttribute('x1', '14'); x.setAttribute('y1', '14'); x.setAttribute('x2', '66'); x.setAttribute('y2', '66');
      x.setAttribute('stroke', 'white'); x.setAttribute('stroke-width', '3');
      svg.appendChild(x);
      return svg;
    }

    function makeTriangle(type) {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('aria-hidden', 'true');
      const tri = document.createElementNS(svgNS, 'polygon');
      tri.setAttribute('points', '40,10 70,70 10,70');
      tri.setAttribute('fill', 'none'); tri.setAttribute('stroke', 'white'); tri.setAttribute('stroke-width', '2.5');
      svg.appendChild(tri);
      if (type === 'non-chlorine') {
        const l1 = document.createElementNS(svgNS, 'line');
        l1.setAttribute('x1', '26'); l1.setAttribute('y1', '50'); l1.setAttribute('x2', '54'); l1.setAttribute('y2', '50');
        l1.setAttribute('stroke', 'white'); l1.setAttribute('stroke-width', '2.5');
        svg.appendChild(l1);
        const l2 = document.createElementNS(svgNS, 'line');
        l2.setAttribute('x1', '26'); l2.setAttribute('y1', '57'); l2.setAttribute('x2', '54'); l2.setAttribute('y2', '57');
        l2.setAttribute('stroke', 'white'); l2.setAttribute('stroke-width', '2.5');
        svg.appendChild(l2);
      } else if (type === 'do-not-bleach') {
        const x = document.createElementNS(svgNS, 'line');
        x.setAttribute('x1', '14'); x.setAttribute('y1', '14'); x.setAttribute('x2', '66'); x.setAttribute('y2', '66');
        x.setAttribute('stroke', 'white'); x.setAttribute('stroke-width', '3');
        svg.appendChild(x);
      }
      return svg;
    }

    function makeSquare(type) {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('aria-hidden', 'true');
      const rect = document.createElementNS(svgNS, 'rect');
      rect.setAttribute('x', '10'); rect.setAttribute('y', '10'); rect.setAttribute('width', '60'); rect.setAttribute('height', '60');
      rect.setAttribute('rx', '1'); rect.setAttribute('fill', 'none'); rect.setAttribute('stroke', 'white'); rect.setAttribute('stroke-width', '2.5');
      svg.appendChild(rect);

      if (type === 'tumble-low') {
        const c = document.createElementNS(svgNS, 'circle');
        c.setAttribute('cx', '40'); c.setAttribute('cy', '40'); c.setAttribute('r', '18');
        c.setAttribute('fill', 'none'); c.setAttribute('stroke', 'white'); c.setAttribute('stroke-width', '2.5');
        svg.appendChild(c);
        const dot = document.createElementNS(svgNS, 'circle');
        dot.setAttribute('cx', '40'); dot.setAttribute('cy', '40'); dot.setAttribute('r', '4'); dot.setAttribute('fill', 'white');
        svg.appendChild(dot);
      } else if (type === 'tumble-normal') {
        const c = document.createElementNS(svgNS, 'circle');
        c.setAttribute('cx', '40'); c.setAttribute('cy', '40'); c.setAttribute('r', '18');
        c.setAttribute('fill', 'none'); c.setAttribute('stroke', 'white'); c.setAttribute('stroke-width', '2.5');
        svg.appendChild(c);
        [33, 47].forEach(cx => {
          const dot = document.createElementNS(svgNS, 'circle');
          dot.setAttribute('cx', String(cx)); dot.setAttribute('cy', '40'); dot.setAttribute('r', '3.5'); dot.setAttribute('fill', 'white');
          svg.appendChild(dot);
        });
      } else if (type === 'line-dry') {
        const hline = document.createElementNS(svgNS, 'line');
        hline.setAttribute('x1', '20'); hline.setAttribute('y1', '26'); hline.setAttribute('x2', '60'); hline.setAttribute('y2', '26');
        hline.setAttribute('stroke', 'white'); hline.setAttribute('stroke-width', '2');
        svg.appendChild(hline);
        [30, 50].forEach(x => {
          const vl = document.createElementNS(svgNS, 'line');
          vl.setAttribute('x1', String(x)); vl.setAttribute('y1', '26'); vl.setAttribute('x2', String(x)); vl.setAttribute('y2', '62');
          vl.setAttribute('stroke', 'white'); vl.setAttribute('stroke-width', '2');
          svg.appendChild(vl);
        });
      } else if (type === 'dry-flat') {
        for (let i = 0; i < 3; i++) {
          const l = document.createElementNS(svgNS, 'line');
          l.setAttribute('x1', '20'); l.setAttribute('x2', '60');
          l.setAttribute('y1', String(30 + i * 10)); l.setAttribute('y2', String(30 + i * 10));
          l.setAttribute('stroke', 'white'); l.setAttribute('stroke-width', '2');
          svg.appendChild(l);
        }
      } else if (type === 'do-not-tumble') {
        const c = document.createElementNS(svgNS, 'circle');
        c.setAttribute('cx', '40'); c.setAttribute('cy', '40'); c.setAttribute('r', '18');
        c.setAttribute('fill', 'none'); c.setAttribute('stroke', 'white'); c.setAttribute('stroke-width', '2.5');
        svg.appendChild(c);
        const x = document.createElementNS(svgNS, 'line');
        x.setAttribute('x1', '14'); x.setAttribute('y1', '14'); x.setAttribute('x2', '66'); x.setAttribute('y2', '66');
        x.setAttribute('stroke', 'white'); x.setAttribute('stroke-width', '3');
        svg.appendChild(x);
      }
      return svg;
    }

    function makeIron(type) {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('aria-hidden', 'true');
      const body = document.createElementNS(svgNS, 'path');
      body.setAttribute('d', 'M14 28 L66 28 Q72 28 72 38 L72 58 L8 58 L8 38 Q8 28 14 28 Z');
      body.setAttribute('fill', 'none'); body.setAttribute('stroke', 'white'); body.setAttribute('stroke-width', '2.5');
      svg.appendChild(body);

      if (type === 'do-not-iron') {
        const x = document.createElementNS(svgNS, 'line');
        x.setAttribute('x1', '10'); x.setAttribute('y1', '26'); x.setAttribute('x2', '70'); x.setAttribute('y2', '62');
        x.setAttribute('stroke', 'white'); x.setAttribute('stroke-width', '3');
        svg.appendChild(x);
      } else {
        const dots = type === 'cool' ? [40] : type === 'warm' ? [33, 47] : [26, 40, 54];
        dots.forEach(cx => {
          const dot = document.createElementNS(svgNS, 'circle');
          dot.setAttribute('cx', String(cx)); dot.setAttribute('cy', '45'); dot.setAttribute('r', '3.5'); dot.setAttribute('fill', 'white');
          svg.appendChild(dot);
        });
      }
      return svg;
    }

    function makeCircle(letter, doNotDry) {
      const svg = document.createElementNS(svgNS, 'svg');
      svg.setAttribute('viewBox', '0 0 80 80');
      svg.setAttribute('aria-hidden', 'true');
      const c = document.createElementNS(svgNS, 'circle');
      c.setAttribute('cx', '40'); c.setAttribute('cy', '40'); c.setAttribute('r', '28');
      c.setAttribute('fill', 'none'); c.setAttribute('stroke', 'white'); c.setAttribute('stroke-width', '2.5');
      svg.appendChild(c);
      const txt = document.createElementNS(svgNS, 'text');
      txt.setAttribute('x', '40'); txt.setAttribute('y', '48'); txt.setAttribute('text-anchor', 'middle');
      txt.setAttribute('fill', 'white'); txt.setAttribute('font-size', '20'); txt.setAttribute('font-weight', '700');
      txt.setAttribute('font-family', 'sans-serif');
      txt.textContent = letter;
      svg.appendChild(txt);
      if (doNotDry) {
        const x = document.createElementNS(svgNS, 'line');
        x.setAttribute('x1', '14'); x.setAttribute('y1', '14'); x.setAttribute('x2', '66'); x.setAttribute('y2', '66');
        x.setAttribute('stroke', 'white'); x.setAttribute('stroke-width', '3');
        svg.appendChild(x);
      }
      return svg;
    }

    const LOGIC = {
      getWashing(fabric, construction, finish) {
        const delicate = ['silk', 'wool', 'viscose'];
        const lowStretch = ['spandex', 'cotton-elastane'];
        if (construction === 'non-woven' || (fabric === 'silk' && finish === 'coating')) {
          return { key: 'hand', name: 'Hand Wash Only', desc: 'Hand wash in cold water. Do not machine wash or wring.', svg: makeTub('hand', 0) };
        }
        if (delicate.includes(fabric) || finish === 'embroidery') {
          const bars = (fabric === 'wool') ? 2 : 1;
          return { key: '30', name: 'Wash at 30°C', desc: 'Machine wash max 30°C, gentle cycle.', svg: makeTub('30', bars) };
        }
        if (lowStretch.includes(fabric) || finish === 'print' || finish === 'stone-wash' || finish === 'enzyme-wash') {
          return { key: '40', name: 'Wash at 40°C', desc: 'Machine wash max 40°C, gentle cycle.', svg: makeTub('40', 1) };
        }
        if (fabric === 'cotton' || fabric === 'linen') {
          return { key: '60', name: 'Wash at 60°C', desc: 'Machine wash max 60°C, normal cycle.', svg: makeTub('60', 0) };
        }
        if (fabric === 'cotton-poly') {
          return { key: '50', name: 'Wash at 40°C', desc: 'Machine wash max 40°C, normal cycle.', svg: makeTub('40', 0) };
        }
        return { key: '40', name: 'Wash at 40°C', desc: 'Machine wash max 40°C, normal cycle.', svg: makeTub('40', 0) };
      },

      getBleaching(dye, finish) {
        if (['acid', 'vat'].includes(dye) || finish === 'print' || finish === 'coating') {
          return { key: 'do-not-bleach', name: 'Do Not Bleach', desc: 'No bleach under any circumstances.', svg: makeTriangle('do-not-bleach') };
        }
        if (dye === 'pigment') {
          return { key: 'non-chlorine', name: 'Non-Chlorine Bleach', desc: 'Only oxygen/non-chlorine bleach when needed.', svg: makeTriangle('non-chlorine') };
        }
        return { key: 'any', name: 'Bleach as Needed', desc: 'Chlorine or non-chlorine bleach allowed.', svg: makeTriangle('any') };
      },

      getDrying(fabric, construction, finish) {
        const flatDry = ['wool', 'silk'];
        if (flatDry.includes(fabric)) {
          return { key: 'dry-flat', name: 'Dry Flat', desc: 'Lay flat to dry. Reshape while damp. Do not tumble dry.', svg: makeSquare('dry-flat') };
        }
        if (construction === 'knit' || fabric === 'viscose' || fabric === 'spandex' || fabric === 'cotton-elastane') {
          return { key: 'dry-flat', name: 'Dry Flat', desc: 'Lay flat to dry to prevent stretching.', svg: makeSquare('dry-flat') };
        }
        if (finish === 'embroidery' || finish === 'print' || finish === 'coating') {
          return { key: 'line-dry', name: 'Line Dry', desc: 'Line dry after washing. Do not tumble dry.', svg: makeSquare('line-dry') };
        }
        if (fabric === 'cotton' || fabric === 'linen') {
          return { key: 'tumble-normal', name: 'Tumble Dry Normal', desc: 'Tumble dry at normal heat.', svg: makeSquare('tumble-normal') };
        }
        return { key: 'tumble-low', name: 'Tumble Dry Low', desc: 'Tumble dry at low heat only.', svg: makeSquare('tumble-low') };
      },

      getIroning(fabric, finish) {
        if (finish === 'coating' || finish === 'print') {
          return { key: 'do-not-iron', name: 'Do Not Iron', desc: 'Do not iron. Coating or print will be damaged.', svg: makeIron('do-not-iron') };
        }
        const cool = ['silk', 'spandex', 'cotton-elastane', 'acrylic'];
        const hot = ['cotton', 'linen'];
        if (cool.includes(fabric)) {
          return { key: 'cool', name: 'Iron at 110°C Max', desc: 'Cool iron, max 110°C. No steam.', svg: makeIron('cool') };
        }
        if (hot.includes(fabric)) {
          return { key: 'hot', name: 'Iron at 200°C Max', desc: 'Hot iron, max 200°C, steam or dry.', svg: makeIron('hot') };
        }
        return { key: 'warm', name: 'Iron at 150°C Max', desc: 'Warm iron, max 150°C, steam or dry.', svg: makeIron('warm') };
      },

      getDryCleaning(fabric, construction, finish) {
        const dcFabrics = ['silk', 'wool', 'viscose'];
        if (dcFabrics.includes(fabric) || construction === 'non-woven' || finish === 'coating') {
          return { key: 'any', name: 'Dry Clean (Any Solvent)', desc: 'Professional dry clean recommended.', svg: makeCircle('P', false) };
        }
        return { key: 'do-not-dryclean', name: 'Do Not Dry Clean', desc: 'Do not dry clean. Machine wash only.', svg: makeCircle('P', true) };
      }
    };

    const CATEGORY_NAMES = {
      washing: 'Washing',
      bleaching: 'Bleaching',
      drying: 'Drying',
      ironing: 'Ironing',
      drycleaning: 'Dry Cleaning'
    };

    function renderResults(symbols) {
      const grid = document.getElementById('symbols-grid');
      const iconsRow = document.getElementById('label-icons-row');
      grid.innerHTML = '';
      iconsRow.innerHTML = '';

      const order = ['washing', 'bleaching', 'drying', 'ironing', 'drycleaning'];

      order.forEach((cat, i) => {
        const s = symbols[cat];

        const card = document.createElement('div');
        card.className = 'wc-symbol-card';

        const iconWrap = document.createElement('div');
        iconWrap.className = 'wc-symbol-icon';
        const cloned = s.svg.cloneNode(true);
        cloned.style.width = '100%';
        cloned.style.height = '100%';
        iconWrap.appendChild(cloned);
        card.appendChild(iconWrap);

        const catP = document.createElement('p');
        catP.className = 'wc-symbol-cat';
        catP.textContent = CATEGORY_NAMES[cat];
        card.appendChild(catP);

        const nameP = document.createElement('p');
        nameP.className = 'wc-symbol-name';
        nameP.textContent = s.name;
        card.appendChild(nameP);

        const descP = document.createElement('p');
        descP.className = 'wc-symbol-desc';
        descP.textContent = s.desc;
        card.appendChild(descP);

        grid.appendChild(card);

        if (i > 0) {
          const bar = document.createElement('div');
          bar.className = 'wc-label-bar';
          iconsRow.appendChild(bar);
        }
        const labelIcon = document.createElement('div');
        labelIcon.className = 'wc-label-icon';
        const cloned2 = s.svg.cloneNode(true);
        cloned2.style.width = '100%';
        cloned2.style.height = '100%';
        labelIcon.appendChild(cloned2);
        iconsRow.appendChild(labelIcon);
      });
    }

    function generateCareSymbols() {
      const fabric = document.getElementById('fabric-type').value;
      const construction = document.getElementById('fabric-construction').value;
      const dye = document.getElementById('dye-type').value;
      const finish = document.getElementById('special-finishes').value;
      const errorMsg = document.getElementById('error-msg');
      const btn = document.getElementById('generate-btn');

      if (!fabric || !construction || !dye || !finish) {
        errorMsg.classList.add('wc-error-msg--visible');
        return;
      }
      errorMsg.classList.remove('wc-error-msg--visible');
      btn.disabled = true;
      btn.textContent = 'Generating…';

      try {
        const symbols = {
          washing: LOGIC.getWashing(fabric, construction, finish),
          bleaching: LOGIC.getBleaching(dye, finish),
          drying: LOGIC.getDrying(fabric, construction, finish),
          ironing: LOGIC.getIroning(fabric, finish),
          drycleaning: LOGIC.getDryCleaning(fabric, construction, finish)
        };
        renderResults(symbols);
        document.getElementById('results-container').classList.add('wc-results--visible');
        document.getElementById('results-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        errorMsg.textContent = 'An error occurred. Please try again.';
        errorMsg.classList.add('wc-error-msg--visible');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Generate Care Symbols';
      }
    }

    function downloadLabelAsPNG() {
      const preview = document.getElementById('label-preview');
      const canvas = document.createElement('canvas');
      const scale = 3;
      const w = preview.offsetWidth || 580;
      const h = preview.offsetHeight || 180;
      canvas.width = w * scale;
      canvas.height = h * scale;
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, w, h);
      ctx.strokeStyle = '#ee0000';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(1, 1, w - 2, h - 2);
      ctx.fillStyle = '#888';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('CARE INSTRUCTIONS', w / 2, 22);

      const svgs = document.querySelectorAll('#label-icons-row svg');
      const iconSize = 44;
      const gap = 18;
      const totalW = svgs.length * iconSize + (svgs.length - 1) * gap;
      let x = (w - totalW) / 2;
      const y = 36;
      let loaded = 0;

      svgs.forEach(function (svg) {
        const serialized = new XMLSerializer().serializeToString(svg);
        const encoded = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(serialized);
        const img = new Image();
        img.onload = function () {
          ctx.drawImage(img, x, y, iconSize, iconSize);
          x += iconSize + gap;
          loaded++;
          if (loaded === svgs.length) {
            setTimeout(function () {
              const link = document.createElement('a');
              link.download = 'care-label-iso3758.png';
              link.href = canvas.toDataURL('image/png');
              link.click();
            }, 80);
          }
        };
        img.src = encoded;
      });
    }

    function initTabs() {
      const tabs = document.querySelectorAll('.wc-ref-tab');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (t) {
            t.classList.remove('wc-ref-tab--active');
            t.setAttribute('aria-selected', 'false');
          });
          document.querySelectorAll('.wc-ref-panel').forEach(function (p) {
            p.classList.remove('wc-ref-panel--active');
          });
          tab.classList.add('wc-ref-tab--active');
          tab.setAttribute('aria-selected', 'true');
          const panel = document.getElementById(tab.getAttribute('aria-controls'));
          if (panel) panel.classList.add('wc-ref-panel--active');
        });
      });
    }

    function initFAQ() {
      document.querySelectorAll('.wc-faq-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const answer = btn.nextElementSibling;
          const icon = btn.querySelector('.wc-faq-icon');
          const isOpen = answer.classList.contains('wc-faq-answer--visible');
          answer.classList.toggle('wc-faq-answer--visible', !isOpen);
          icon.classList.toggle('wc-faq-icon--open', !isOpen);
          icon.textContent = isOpen ? '+' : '×';
          btn.setAttribute('aria-expanded', String(!isOpen));
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      const genBtn = document.getElementById('generate-btn');
      const dlBtn = document.getElementById('download-btn');
      if (genBtn) genBtn.addEventListener('click', generateCareSymbols);
      if (dlBtn) dlBtn.addEventListener('click', downloadLabelAsPNG);
      initTabs();
      initFAQ();
    });
  })();
</script>

</BaseLayout>
