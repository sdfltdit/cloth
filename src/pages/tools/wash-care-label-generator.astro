// Care symbol logic based on fabric specifications
function generateCareSymbols() {
  const fabricType = document.getElementById('fabric-type').value;
  const fabricConstruction = document.getElementById('fabric-construction').value;
  const dyeType = document.getElementById('dye-type').value;
  const specialFinish = document.getElementById('special-finishes').value;

  if (!fabricType || !fabricConstruction || !dyeType || !specialFinish) {
    alert('Please select all fabric specifications');
    return;
  }

  let symbols = {
    washing: null,
    bleaching: null,
    drying: null,
    ironing: null,
    drycleaning: null
  };

  // Washing temperature based on fabric type
  const tempSensitive = ['silk', 'wool', 'viscose'];
  const lowTemp = ['spandex', 'cotton-elastane'];
  
  if (tempSensitive.includes(fabricType) || specialFinish === 'embroidery') {
    symbols.washing = careSymbols.washing['30'];
  } else if (lowTemp.includes(fabricType) || specialFinish === 'print') {
    symbols.washing = careSymbols.washing['40'];
  } else if (fabricType === 'cotton' || fabricType === 'linen' || fabricType === 'cotton-poly') {
    symbols.washing = careSymbols.washing['60'];
  } else {
    symbols.washing = careSymbols.washing['50'];
  }

  // Adjust for special finishes
  if (specialFinish === 'stone-wash' || specialFinish === 'enzyme-wash') {
    symbols.washing = careSymbols.washing['40'];
  }
  if (fabricConstruction === 'non-woven' || (fabricType === 'silk' && specialFinish === 'coating')) {
    symbols.washing = careSymbols.washing['hand'];
  }

  // Bleaching based on dye type
  if (dyeType === 'acid' || dyeType === 'vat') {
    symbols.bleaching = careSymbols.bleaching['do-not-bleach'];
  } else if (dyeType === 'pigment') {
    symbols.bleaching = careSymbols.bleaching['non-chlorine'];
  } else {
    symbols.bleaching = careSymbols.bleaching['any'];
  }

  // Drying based on fabric type and construction
  if (tempSensitive.includes(fabricType) || specialFinish === 'embroidery' || specialFinish === 'print') {
    symbols.drying = careSymbols.drying['do-not-tumble'];
    if (fabricType === 'wool' || fabricType === 'silk') {
      symbols.drying = careSymbols.drying['dry-flat'];
    } else {
      symbols.drying = careSymbols.drying['line-dry'];
    }
  } else if (fabricConstruction === 'knit') {
    symbols.drying = careSymbols.drying['dry-flat'];
  } else if (fabricType === 'cotton' || fabricType === 'linen') {
    symbols.drying = careSymbols.drying['tumble-normal'];
  } else {
    symbols.drying = careSymbols.drying['tumble-low'];
  }

  // Ironing based on fabric type
  if (tempSensitive.includes(fabricType) || fabricType === 'spandex') {
    symbols.ironing = careSymbols.ironing['cool'];
  } else if (fabricType === 'polyester' || fabricType === 'nylon' || fabricType === 'acrylic') {
    symbols.ironing = careSymbols.ironing['warm'];
  } else if (fabricType === 'cotton' || fabricType === 'linen') {
    symbols.ironing = careSymbols.ironing['hot'];
  } else {
    symbols.ironing = careSymbols.ironing['warm'];
  }

  // Adjust for special finishes
  if (specialFinish === 'coating') {
    symbols.ironing = careSymbols.ironing['do-not-iron'];
  }

  // Dry cleaning based on fabric type and construction
  if (fabricConstruction === 'non-woven' || fabricType === 'silk' || specialFinish === 'coating') {
    symbols.drycleaning = careSymbols.drycleaning['any'];
  } else {
    symbols.drycleaning = careSymbols.drycleaning['do-not-dryclean'];
  }

  // Display symbols
  displaySymbols(symbols);
}

function displaySymbols(symbols) {
  const symbolsContainer = document.getElementById('symbols-container');
  const symbolsGrid = document.getElementById('symbols-grid');
  const labelPreviewContainer = document.getElementById('label-preview-container');
  const labelSymbolsRow = document.getElementById('label-symbols-row');

  symbolsContainer.classList.add('symbols-container--visible');
  labelPreviewContainer.classList.add('label-preview-container--visible');
  
  symbolsGrid.innerHTML = '';
  labelSymbolsRow.innerHTML = '';

  const categories = [
    { key: 'washing', label: 'Washing' },
    { key: 'bleaching', label: 'Bleaching' },
    { key: 'drying', label: 'Drying' },
    { key: 'ironing', label: 'Ironing' },
    { key: 'drycleaning', label: 'Dry Cleaning' }
  ];

  categories.forEach(category => {
    const symbol = symbols[category.key];
    if (symbol) {
      // Add to symbols grid
      const card = document.createElement('div');
      card.className = 'symbol-card';
      card.innerHTML = `
        ${symbol.svg.replace('class="symbol-svg"', 'class="symbol-svg" style="stroke: white; fill: none;"')}
        <p class="symbol-name">${symbol.name}</p>
        <p class="symbol-instruction">${symbol.instruction}</p>
      `;
      symbolsGrid.appendChild(card);

      // Add to label preview
      const labelSymbol = document.createElement('div');
      labelSymbol.className = 'label-symbol';
      labelSymbol.innerHTML = symbol.svg.replace('class="symbol-svg"', 'class="label-symbol" style="stroke: white; fill: none;"');
      labelSymbolsRow.appendChild(labelSymbol);
    }
  });
}

function downloadLabelAsPNG() {
  const labelPreview = document.getElementById('label-preview');
  
  // Create a canvas
  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d');
  const scale = 2; // Higher resolution
  
  // Set canvas size
  canvas.width = labelPreview.offsetWidth * scale;
  canvas.height = labelPreview.offsetHeight * scale;
  ctx.scale(scale, scale);
  
  // Draw black background
  ctx.fillStyle = '#000000';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  
  // Draw red border
  ctx.strokeStyle = '#dc2626';
  ctx.lineWidth = 2;
  ctx.strokeRect(1, 1, labelPreview.offsetWidth - 2, labelPreview.offsetHeight - 2);
  
  // Draw title
  ctx.fillStyle = '#ffffff';
  ctx.font = '11px Inter, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('CARE INSTRUCTIONS', labelPreview.offsetWidth / 2, 30);
  
  // Draw symbols
  const symbolsRow = document.getElementById('label-symbols-row');
  const symbols = symbolsRow.querySelectorAll('svg');
  const symbolWidth = 60;
  const symbolHeight = 60;
  const gap = 16;
  let xOffset = (labelPreview.offsetWidth - (symbols.length * symbolWidth + (symbols.length - 1) * gap)) / 2;
  const yOffset = 50;
  
  symbols.forEach((svg, index) => {
    const svgData = new XMLSerializer().serializeToString(svg);
    const img = new Image();
    const svgBlob = new Blob([svgData], {type: 'image/svg+xml;charset=utf-8'});
    const url = URL.createObjectURL(svgBlob);
    
    img.onload = function() {
      ctx.drawImage(img, xOffset + index * (symbolWidth + gap), yOffset, symbolWidth, symbolHeight);
      URL.revokeObjectURL(url);
      
      // Download when all symbols are drawn
      if (index === symbols.length - 1) {
        setTimeout(() => {
          const link = document.createElement('a');
          link.download = 'care-label.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        }, 100);
      }
    };
    img.src = url;
  });
}

// FAQ Toggle
function toggleFAQ(button) {
  const answer = button.nextElementSibling;
  const icon = button.querySelector('.faq-icon');
  
  if (answer.classList.contains('faq-answer--visible')) {
    answer.classList.remove('faq-answer--visible');
    icon.classList.remove('faq-icon--open');
    icon.textContent = '+';
  } else {
    answer.classList.add('faq-answer--visible');
    icon.classList.add('faq-icon--open');
    icon.textContent = '−';
  }
}

// Initialize event listeners
document.addEventListener('DOMContentLoaded', function() {
  const generateBtn = document.getElementById('generate-btn');
  const downloadBtn = document.getElementById('download-btn');

  if (generateBtn) {
    generateBtn.addEventListener('click', generateCareSymbols);
  }

  if (downloadBtn) {
    downloadBtn.addEventListener('click', downloadLabelAsPNG);
  }

  // FAQ accordion event listeners
  document.querySelectorAll('.faq-question').forEach(button => {
    button.addEventListener('click', function() {
      const answer = this.nextElementSibling;
      const icon = this.querySelector('.faq-icon');
      
      if (answer.classList.contains('faq-answer--visible')) {
        answer.classList.remove('faq-answer--visible');
        icon.classList.remove('faq-icon--open');
        icon.textContent = '+';
      } else {
        answer.classList.add('faq-answer--visible');
        icon.classList.add('faq-icon--open');
        icon.textContent = '−';
      }
    });
  });
});
