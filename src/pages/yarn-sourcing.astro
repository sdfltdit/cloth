---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Yarn Sourcing Bangladesh | Cotton, Polyester & Recycled Yarn";
const pageDescription = "Trusted yarn sourcing from Bangladesh. Cotton, polyester, recycled, organic and blended yarns for knitting and weaving. GOTS, GRS and OEKO-TEX certified.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": pageTitle,
    "provider": { "@id": "https://sdfltd.com/#org" },
    "serviceType": "Yarn Sourcing",
    "areaServed": "Worldwide",
    "description": pageDescription,
    "url": "https://sdfltd.com/yarn-sourcing/"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://sdfltd.com/yarn-sourcing/",
    "name": "Yarn Sourcing Service",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Yarn Sourcing Service"
        }
      ]
    }
  }
];

const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>


<meta name="keywords" content="yarn sourcing Bangladesh, yarn supplier Bangladesh, cotton yarn supplier, polyester yarn supplier, recycled yarn supplier, organic cotton yarn, GOTS certified yarn, OEKO-TEX yarn, combed cotton yarn, carded yarn supplier, yarn count supplier, melange yarn Bangladesh" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Yarn Sourcing Service
      </p>
    </nav>
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Yarn Sourcing | Since 1998 | GOTS & GRS Certified</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">
      Yarn Sourcing Service for Knit and Woven Production
    </h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">
      Yarn is the starting point of every textile. The quality of yarn determines fabric quality, drape, durability, and how it feels against skin. Bangladesh has one of the world's largest yarn manufacturing ecosystems, producing yarn for both domestic fabric mills and global yarn buyers. SDF Clothing, a full-service clothing manufacturer, connects fashion brands and fabric mills with verified yarn suppliers across Bangladesh.
    </p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact/" class="cta-button">Get Free Quote</a>
      <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20yarn-sourcing`} target="_blank" rel="noopener noreferrer" class="whatsapp-cta">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Now
      </a>
    </div>
  </div>
</section>

<!-- Quick Stats Section -->
<section style="padding:4rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">430+</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Spinning Mills</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">4B</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">KG Annual Production</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">GOTS</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Organic Certified</div>
      </div>
      <div style="background:#000;padding:2rem;text-align:center;">
        <div style="font-size:2rem;font-weight:200;color:#e00;margin-bottom:0.5rem;">GRS</div>
        <div style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:#FFFFFF;">Recycled Certified</div>
      </div>
    </div>
  </div>
</section>

<!-- Why Source from Bangladesh Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Industry Overview</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Why Source Yarn from Bangladesh?</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Bangladesh produces approximately 4 billion kilograms of yarn annually. The country has over 430 yarn spinning mills, ranging from small specialty producers to large vertically integrated operations. This scale gives buyers access to wide variety, competitive pricing, and reliable supply.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      For fashion brands and fabric mills, sourcing yarn from Bangladesh typically saves 15-30% compared to European or Pakistani suppliers. Lead times are shorter because most spinning mills have inventory of standard yarn counts and can ship within days for stock orders.
    </p>
  </div>
</section>

<!-- Yarn Types Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Yarn Categories</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Types of Yarn We Source</h2>
    </div>
    
    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Cotton Yarn</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      The most widely used yarn for clothing production:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Combed cotton yarn for premium soft-handle fabrics
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Carded cotton yarn for cost-effective production
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Compact yarn with reduced hairiness for premium fabrics
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Slub yarn for textured fashion fabrics
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Mercerized cotton yarn for shine and color depth
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Available in counts from Ne 10 to Ne 80
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Polyester Yarn</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Synthetic yarn for activewear and performance fabrics:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Filament polyester yarn for smooth fabrics
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Spun polyester yarn for cotton-like handle
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Texturized polyester for stretch and bulk
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Recycled polyester yarn from PET bottles (GRS)
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Blended Yarn</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;margin-bottom:2rem;">
      Combinations that provide multiple performance benefits:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cotton-polyester blends (50/50, 65/35, 80/20)
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Cotton-spandex blends for stretch garments
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Polyester-spandex for activewear
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Viscose-polyester for premium drape
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Sustainable and Specialty Yarn</h3>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0 0 2.5rem 0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        GOTS-certified organic cotton yarn
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        GRS-certified recycled polyester yarn
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        BCI Better Cotton yarn
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        TENCEL Lyocell yarn from sustainable wood pulp
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Recycled cotton yarn from pre-consumer waste
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Modal yarn for soft luxurious garments
      </li>
    </ul>

    <h3 style="font-size:1.3rem;font-weight:400;color:#e00;margin-bottom:1.5rem;">Melange and Heather Yarn</h3>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.92rem;">
      Pre-mixed colored yarn for grey and heathered fabrics:
    </p>
    <ul style="color:#FFFFFF;font-size:0.88rem;line-height:1.9;list-style:none;padding:0;margin:0;max-width:800px;">
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Grey melange in various shades
      </li>
      <li style="margin-bottom:0.75rem;padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Color melange in custom shade combinations
      </li>
      <li style="padding-left:1.5rem;position:relative;">
        <span style="color:#e00;position:absolute;left:0;">✓</span>
        Salt and pepper looks
      </li>
    </ul>
  </div>
</section>

<!-- Yarn Counts Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Technical Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Yarn Counts and Specifications Explained</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Yarn count tells you how thick or thin the yarn is. Higher count means finer yarn.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      For knitting: Ne 20-30 for heavy fabrics like fleece, sweaters. Ne 30-40 for medium fabrics like t-shirts. Ne 40-60 for fine fabrics like premium tees and shirts. Ne 60-80 for very fine fabrics for premium positioning.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      For weaving: Ne 20-40 for heavy wovens like canvas, denim. Ne 40-60 for medium wovens like twill, poplin. Ne 60-100 for fine wovens like dress shirts.
    </p>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      When you order yarn, specify both the count and the ply (single, double, multi-ply). A 30/2 yarn means count 30 doubled | twisted from two single yarns.
    </p>
  </div>
</section>

<!-- Yarn Certifications Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Quality Assurance</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Yarn Certifications We Offer</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      GOTS-certified organic yarn | required for GOTS fabric and garment certification. The yarn is the first link in the GOTS supply chain.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      OEKO-TEX Standard 100 certified yarn | confirms the yarn is free from harmful chemicals. Required for chemical safety claims.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      GRS (Global Recycled Standard) certified recycled yarn | required for recycled content claims to retailers and regulators.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      OCS (Organic Content Standard) certified yarn | alternative to GOTS for certifying organic fiber percentage without the full GOTS chain requirements.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      BCI Better Cotton certified yarn | sustainable cotton sourcing without full organic certification.
    </p>
  </div>
</section>

<!-- Yarn Sourcing Process Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">How It Works</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Our Yarn Sourcing Process</h2>
    </div>
    
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#000000;">
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 1</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Brief and specifications</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You tell us yarn type, count, ply, color, certifications, quantity, and required delivery date. We confirm specifications and identify matching mills.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 2</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Quotes from multiple mills</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">We collect quotes from 3-5 verified yarn mills. You receive a comparison sheet showing pricing, MOQ, lead time, and certifications for each option.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 3</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Sample yarn</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">You receive yarn samples (typically 100-500 grams) to evaluate quality, color, and consistency before committing to bulk order.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 4</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Bulk yarn order</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">After approval, the mill produces or releases your yarn from inventory. Stock yarn ships in 5-10 days. Custom-dyed yarn takes 15-25 days.</p>
      </div>
      <div style="background:#000;padding:2rem;">
        <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Step 5</p>
        <h3 style="font-size:1.1rem;font-weight:500;color:#fff;margin-bottom:1rem;">Quality inspection and delivery</h3>
        <p style="color:#FFFFFF;font-size:0.88rem;line-height:1.7;">We inspect yarn before shipment | checking count, twist, evenness, and color consistency. Yarn is delivered to your fabric mill, knitting factory, or weaving facility.</p>
      </div>
    </div>
  </div>
</section>

<!-- Yarn MOQ Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Order Requirements</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Yarn MOQ | Minimum Order Quantities</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Yarn MOQ depends on whether the yarn is in stock or requires custom production.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Stock yarn (standard counts and natural color): 100-500 kg minimum from most mills. Available in 1-2 day shipping for nearby buyers.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Stock-color yarn (mill standard colors like white, ecru, grey): 200-500 kg minimum. Ships in 5-10 days.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Custom-dyed yarn (your specific color): 500-1,000 kg minimum. Lead time 15-25 days for dyeing.
    </p>
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;margin-top:1rem;">
      Custom-blended yarn (specific composition not in stock): 1,000-3,000 kg minimum. Lead time 30-45 days for spinning.
    </p>
  </div>
</section>

<!-- Yarn Pricing Section -->
<section style="padding:5rem 0;border-bottom:1px solid #e00;">
  <div class="container">
    <div class="section-header" style="margin-bottom:3rem;">
      <span class="section-label">Pricing Guide</span>
      <div class="accent-line"></div>
      <h2 style="font-size:clamp(1.6rem,3vw,2.4rem);font-weight:300;color:#fff;margin-bottom:1rem;">Yarn Pricing in Bangladesh</h2>
    </div>
    
    <p style="color:#FFFFFF;max-width:800px;line-height:1.8;font-size:0.95rem;">
      Yarn pricing varies by composition, count, and certification status.
