          <div style="display:grid;grid-template-columns:auto 1fr;gap:0.5rem 1rem;padding:0.6rem 0;border-bottom:1px solid #0d0d0d;font-size:0.82rem;align-items:center;"><span style="color:#e00;">✓</span><span style="color:#FFFFFF;">13 international certifications</span></div>
