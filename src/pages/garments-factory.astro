const pageTitle = "Garments Factory Dhaka Bangladesh | ISO 9001 Certified | SDF Clothing";
const pageDescription = "ISO 9001-certified garments factory in Baridhara DOHS, Dhaka. 50,000+ pcs per month capacity. FOB Chittagong. Serving UK, US, EU buyers since 1998.";
