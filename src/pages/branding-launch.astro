---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Clothing Brand Branding Service from $500 | SDF Clothing";
const pageDescription = "Complete clothing brand branding — logo, labels, hang tags & packaging designed and produced in-house from $500. 300-piece MOQ. Ships worldwide.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const companyAge = getCompanyAgeString();

const faqs = [
	{
		question: "How much does a clothing brand branding service cost?",
		answer: "Our branding launch service starts at $500 for a complete brand identity package — logo design, brand colors and typography, clothing labels, hang tags, packaging design, and a brand guidelines document. When you place a clothing production order with us, the physical label and packaging production is included at no extra charge. You pay once for the design; everything else ships with your garments."
	},
	{
		question: "How long does the branding process take?",
		answer: "The full process takes 5 to 6 weeks from your first call to finished, branded garments. Week 1 covers brand discovery and briefing. Weeks 2 and 3 are for design concepts and refinement. Week 4 moves into physical production of labels, hang tags, and packaging. Weeks 5 and 6 are for integration with your garment production and final dispatch."
	},
	{
		question: "Do I own the designs after the branding service?",
		answer: "Yes, fully. Once the project is complete and payment is settled, all design files — logo in all formats, brand guidelines, label artwork, and packaging files — are yours. We keep no license over your brand identity. You can take the files anywhere."
	},
	{
		question: "Can I get branding service without ordering clothing production?",
		answer: "Yes. We offer standalone branding design as a service. However, the best value comes when branding runs alongside production — that's when physical label and packaging production costs fold into your garment order at no extra charge. If you already have another manufacturer, we can still design your brand identity and deliver the files."
	},
	{
		question: "What is the minimum order quantity for the branding launch service?",
		answer: "The branding design service itself has no minimum order quantity. For clothing production with branded labels and packaging included, our MOQ is 300 pieces per style. This applies to the garments, not the branding service separately."
	},
	{
		question: "Can you match my existing brand colors and style?",
		answer: "Absolutely. If you already have a logo, color palette, or visual direction you want to keep, we work within it. The branding launch service can be a full build from scratch or an extension of what you already have. We clarify this during the brand discovery call before any design work begins."
	},
	{
		question: "What file formats do I receive for my logo and brand assets?",
		answer: "You receive your logo in all standard formats: AI (editable vector), EPS, SVG, PNG (transparent background), and PDF. Your brand guidelines come as a PDF document. Label and packaging files are delivered in print-ready formats suitable for any printer or manufacturer worldwide."
	},
	{
		question: "What is the difference between branding launch service and private label?",
		answer: "Private label means putting your brand name on garments we manufacture. Branding launch service is specifically about creating the visual identity you put on those garments — the logo, labels, hang tags, and packaging design. Most brands need both: the branding service creates the identity, private label production applies it to the clothing."
	},
	{
		question: "Do you ship labels and packaging internationally?",
		answer: "Yes. We ship branded labels, hang tags, and packaging to any country. If you are producing garments with us, branding is applied during production and everything ships together. If you need labels shipped separately to your own manufacturer, we can arrange that with standard international shipping from Bangladesh."
	},
	{
		question: "Can I update or expand my branding later?",
		answer: "Yes. We keep your brand files on record. If you want to introduce a new product line, update your logo, or expand into new categories with matching labels and packaging, we can extend your existing brand system without starting from scratch."
	}
];
---

