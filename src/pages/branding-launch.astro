---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Branding Launch Service | Complete Clothing Brand Setup";
const pageDescription = "Complete branding launch service for clothing brands. We handle logo design, labels, packaging, and brand identity. Launch your fashion brand with professional support. 300-piece MOQ.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const companyAge = getCompanyAgeString();
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl.href}>
	<!-- Robots Meta -->
	<meta name="robots" content="index, follow" />
	
	<!-- Open Graph Tags -->
	<meta property="og:title" content="Branding Launch Service | Complete Clothing Brand Setup" />
	<meta property="og:description" content="Complete branding launch service for clothing brands. We handle logo design, labels, packaging, and brand identity. Launch your fashion brand with professional support. 300-piece MOQ." />
	<meta property="og:image" content="https://sdfclothing.com/og-branding-launch.jpg" />
	<meta property="og:url" content="https://sdfclothing.com/branding-launch" />
	<meta property="og:type" content="website" />
	
	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="Branding Launch Service | Complete Clothing Brand Setup" />
	<meta name="twitter:description" content="Complete branding launch service for clothing brands. We handle logo design, labels, packaging, and brand identity. Launch your fashion brand with professional support. 300-piece MOQ." />
	<meta name="twitter:image" content="https://sdfclothing.com/og-branding-launch.jpg" />

	<!-- Breadcrumb Navigation -->
	<nav aria-label="Breadcrumb" class="py-4 px-4 bg-black/50">
		<div class="container mx-auto max-w-7xl">
			<ol class="flex items-center space-x-2 text-sm">
				<li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
				<li class="text-white/40">/</li>
				<li><span class="text-white">Branding Launch</span></li>
			</ol>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="py-16 px-4 bg-gradient-to-b from-black to-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h1 class="text-3xl md:text-5xl font-bold text-white mb-6">
				Launch Your Clothing Brand with Complete Branding Support
			</h1>
			<p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8">
				From logo design to packaging, we help you build a complete brand identity. Our branding launch service gives your fashion label a professional look from day one.
			</p>
			<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
				Start Your Brand Launch
			</a>
		</div>
	</section>

	<!-- What is Branding Launch -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				What is Branding Launch Service?
			</h2>
			<p class="text-white/80 leading-relaxed mb-6">
				Branding launch means we help you create everything your clothing brand needs to look professional. This includes your logo, brand colors, labels, tags, packaging, and all the visual elements that make your brand unique.
			</p>
			<p class="text-white/80 leading-relaxed mb-6">
				Starting a clothing brand is exciting, but creating a consistent brand identity can be overwhelming. Our service takes care of all the design work so you can focus on your products and customers.
			</p>
			<p class="text-white/80 leading-relaxed">
				We work with you to understand your vision and create a brand that stands out in the market. Whether you're a startup or an established business, we make branding simple and affordable.
			</p>
		</div>
	</section>

	<!-- What We Include -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				What's Included in Our Branding Launch Service
			</h2>
			<p class="text-white/80 leading-relaxed mb-12 text-center">
				We provide everything you need to launch your brand with confidence:
			</p>

			<div class="grid md:grid-cols-2 gap-6">
				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Logo Design</h3>
					<p class="text-white/70 leading-relaxed">
						Professional logo that represents your brand. We create multiple options for you to choose from, then refine the design until you're happy.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Brand Colors & Typography</h3>
					<p class="text-white/70 leading-relaxed">
						We choose the right colors and fonts that match your brand personality. This ensures consistency across all your materials.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Clothing Labels</h3>
					<p class="text-white/70 leading-relaxed">
						Woven labels, care labels, and size labels with your brand name. We design and produce high-quality labels that last.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Hang Tags</h3>
					<p class="text-white/70 leading-relaxed">
						Custom hang tags that showcase your brand. Include your logo, brand story, and product information.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Packaging Design</h3>
					<p class="text-white/70 leading-relaxed">
						Branded packaging that makes a great first impression. Poly bags, boxes, and wrapping with your brand identity.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Brand Guidelines</h3>
					<p class="text-white/70 leading-relaxed">
						A complete guide on how to use your brand elements. Ensures your brand looks consistent everywhere.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- How It Works -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				How Our Branding Launch Process Works
			</h2>

			<div class="space-y-8 mt-8">
				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 1: Brand Discovery Call</h3>
					<p class="text-white/70 leading-relaxed">
						We talk with you to understand your brand vision. We learn about your target customers, your style, and what makes your brand special.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 2: Design Concepts</h3>
					<p class="text-white/70 leading-relaxed">
						Our designers create initial concepts for your logo, labels, and packaging. We present 2-3 options for each element so you have choices.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 3: Feedback & Refinement</h3>
					<p class="text-white/70 leading-relaxed">
						You review the designs and give feedback. We make changes until you're completely satisfied with every element.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 4: Production</h3>
					<p class="text-white/70 leading-relaxed">
						Once designs are approved, we produce your labels, tags, and packaging. We use high-quality materials that look professional and last.
					</p>
				</div>

				<div class="bg-black p-6 rounded-lg border border-neutral-800">
					<h3 class="text-xl font-bold text-white mb-3">Step 5: Integration with Products</h3>
					<p class="text-white/70 leading-relaxed">
						We apply your branding to your clothing during production. Your labels are sewn in, tags are attached, and packaging is ready for shipping.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Why Use Our Branding Launch Service?
			</h2>

			<div class="grid md:grid-cols-2 gap-6 mt-8">
				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Professional Look</h3>
					<p class="text-white/70 leading-relaxed">
						Your brand will look established and trustworthy from day one. Professional branding helps you compete with bigger brands.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Save Time</h3>
					<p class="text-white/70 leading-relaxed">
						No need to hire multiple designers or manage different vendors. We handle everything in one place.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Consistent Identity</h3>
					<p class="text-white/70 leading-relaxed">
						All your brand elements work together perfectly. Consistency builds recognition and trust with customers.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Cost Effective</h3>
					<p class="text-white/70 leading-relaxed">
						Bundle design and production for better pricing. Plus, we include labels and packaging in your clothing order at no extra cost.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Expert Designers</h3>
					<p class="text-white/70 leading-relaxed">
						Our team has years of experience in fashion branding. We know what works in the clothing industry.
					</p>
				</div>

				<div class="bg-neutral-900 p-6 rounded-lg border border-neutral-800">
					<h3 class="text-lg font-bold text-white mb-3">Scalable</h3>
					<p class="text-white/70 leading-relaxed">
						Your brand identity grows with you. We can update and expand your branding as your business grows.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Who Is This For -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6 text-center">
				Who Is Branding Launch For?
			</h2>
			
			<div class="space-y-6 mt-8">
				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">New Fashion Startups</h3>
						<p class="text-white/70 leading-relaxed">
							Entrepreneurs launching their first clothing line who need professional branding to make a strong entrance.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Rebranding Businesses</h3>
						<p class="text-white/70 leading-relaxed">
							Existing brands looking to refresh their identity and stay competitive in the market.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">E-commerce Brands</h3>
						<p class="text-white/70 leading-relaxed">
							Online sellers who need cohesive branding across their website, social media, and physical products.
						</p>
					</div>
				</div>

				<div class="flex items-start gap-4">
					<div class="bg-[#e00] text-white rounded-full w-8 h-8 flex items-center justify-center flex-shrink-0 mt-1">✓</div>
					<div>
						<h3 class="text-lg font-bold text-white mb-2">Boutique Owners</h3>
						<p class="text-white/70 leading-relaxed">
							Small fashion businesses wanting to elevate their brand perception and charge premium prices.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Pricing & Packages
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				Branding launch service starts at <strong class="text-white">$500</strong> for a complete brand identity package. This includes logo, labels, tags, and packaging design.
			</p>
			<p class="text-white/80 leading-relaxed mb-8">
				When you order clothing production with us, we include your branded labels, hang tags, and packaging at no extra cost. You only pay for the design work.
			</p>
			<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
			Get Branding Quote
			</a>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 px-4 bg-neutral-900">
		<div class="container mx-auto max-w-4xl text-center">
			<h2 class="text-2xl md:text-3xl font-bold text-white mb-6">
				Ready to Launch Your Brand?
			</h2>
			<p class="text-white/80 leading-relaxed mb-8">
				Let us create a professional brand identity that helps you stand out. Get in touch today to start your branding journey.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					Start Your Brand
				</a>
				<a href="/full-package-production" class="bg-transparent border border-white text-white px-8 py-4 text-lg font-semibold hover:bg-white hover:text-black transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					View Full Package Production
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
