---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "How to Launch a Clothing Brand — A Factory Guide | SDF Clothing";
const pageDescription = "A practical guide to launching a clothing brand, from product definition to first production run — from 27 years of manufacturing experience. From 300 pieces.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}

  ogType="website"
>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Launch a Clothing Brand — A Factory Guide",
  "description": "A practical guide to launching a clothing brand, written from a manufacturer's perspective. Covers product definition, manufacturing models, sampling, certifications, branding elements, and first-order timelines.",
  "author": {
    "@type": "Person",
    "name": "Chowdhury Remon",
    "jobTitle": "Founder",
    "worksFor": { "@id": "https://sdfltd.com/#org" }
  },
  "publisher": { "@id": "https://sdfltd.com/#org" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://sdfltd.com/branding-launch/" },
  "dateModified": "2026-06-01"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
    { "@type": "ListItem", "position": 2, "name": "How to Launch a Clothing Brand", "item": "https://sdfltd.com/branding-launch/" }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to launch a clothing brand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The minimum realistic budget for a first clothing brand production run depends on your manufacturing model and order quantity. At 300 pieces per style with FOB pricing, a basic knitwear garment (t-shirt or hoodie) typically costs $6–15 per piece FOB, giving a production cost of $1,800–4,500 per style before freight. Add sampling costs ($150–400 per style), label and packaging design (if needed), and freight to your destination. A realistic first-order budget for a small brand with 2–3 styles is $8,000–20,000 landed, depending on garment complexity and destination."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a tech pack to start working with a clothing manufacturer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not to get a quote. A brief covering garment type, approximate quantity, material preferences, and any certification requirements is enough for a preliminary FOB quote. To start sampling, you need either a completed tech pack (with measurements, construction details, and material specs) or a reference garment with clear instructions for what to change. A factory that insists on a perfect tech pack before giving any pricing is adding an unnecessary barrier to your inquiry."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between OEM, private label, white label, and CMT?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "OEM (Original Equipment Manufacturing): You provide a tech pack, the factory sources all materials and produces to your specification under your brand. Private label: Similar to OEM but the factory may develop or adapt the design from your brief. White label: The factory has existing pre-designed styles that you rebrand with your label — faster to market, lower development cost, but the same style may be sold to other buyers. CMT (Cut Make Trim): You supply the fabric, the factory only cuts, sews, and finishes. You retain full control over materials."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to launch a clothing brand from scratch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Working with a direct factory like SDF: quote within 48 hours, proto sample in 7–14 days, revision rounds 7–10 days each (typically 1–3 rounds), bulk production 40–45 days from approved sample. Total from first contact to FOB-ready goods: approximately 60–90 days for a first order. Add ocean freight time to your destination (14–35 days depending on port) and customs clearance. Plan for 90–120 days from first factory contact to goods in your warehouse."
      }
    },
    {
      "@type": "Question",
      "name": "What certifications do I need for my clothing brand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on your market and your product claims. For EU and UK retail: if you want to claim 'organic cotton', your manufacturer needs GOTS certification — not just the fabric supplier. For 'recycled materials' claims: GRS certification. For general chemical safety: OEKO-TEX Standard 100. For social compliance (required by most major retailers): BSCI or SEDEX SMETA audit documentation from your factory. If you are selling direct-to-consumer with no sustainability claims, no certification is legally required — but UK and EU regulations are tightening significantly from 2026."
      }
    },
    {
      "@type": "Question",
      "name": "What file formats does a factory need for labels and branding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For woven labels: your logo in vector format — AI (Adobe Illustrator), EPS, or PDF with embedded fonts. Minimum 300 DPI if raster. PNG files are not accepted by label mills for woven production. For printed labels and hang tags: AI, EPS, or print-ready PDF with bleed (usually 3mm). For embroidery: a digitized embroidery file (.DST or .EMB format) or a clean vector that we can send for digitization. Always supply files with the exact Pantone colour reference — do not expect a factory to match a colour from a JPEG."
      }
    }
  ]
}
</script>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .prose-container { max-width: 780px; }
  .cta-button {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #e00; color: #fff; padding: 0.85rem 1.75rem;
    font-size: 0.82rem; font-weight: 500; letter-spacing: 0.05em;
    text-decoration: none; min-height: 44px; transition: background 0.2s;
  }
  .cta-button:hover { background: #c00; }
  .ghost-button {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: transparent; color: #fff;
    border: 1px solid rgba(255,255,255,0.25);
    padding: 0.85rem 1.75rem; font-size: 0.82rem;
    text-decoration: none; min-height: 44px; transition: border-color 0.2s;
  }
  .ghost-button:hover { border-color: #fff; }
  .grid-1px { display: grid; gap: 1px; background: #1a1a1a; }
  .cell { background: #000; }
  .faq-item { border-bottom: 1px solid #111; padding: 1.75rem 0; }
  .faq-item:first-child { border-top: 1px solid #111; }
  .label { font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase; color: #e00; margin-bottom: 0.9rem; }
  .h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 200; color: #fff; line-height: 1.25; }
  .h3 { font-size: 1rem; font-weight: 500; color: #fff; margin-bottom: 0.75rem; }
  .body-text { font-size: 0.88rem; color: rgba(255,255,255,0.7); line-height: 1.9; }
  .note { font-size: 0.78rem; color: rgba(255,255,255,0.38); line-height: 1.7; }
  a.inline { color: #fff; border-bottom: 0.5px solid #444; text-decoration: none; }
  a.inline:hover { border-color: #fff; }
  .step-number {
    font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: #e00; margin-bottom: 0.5rem;
  }
  .warning-box {
    border-left: 2px solid #e00; padding: 1.25rem 1.5rem;
    background: #0a0a0a; margin: 1.5rem 0;
  }
  .tip-box {
    border-left: 2px solid #4caf50; padding: 1.25rem 1.5rem;
    background: #0a0a0a; margin: 1.5rem 0;
  }
</style>

<!-- ═══ HERO ═══ -->
<section style="padding: 5rem 0 3.5rem; border-bottom: 1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem;">
      <p style="font-size: 0.72rem; color: rgba(255,255,255,0.4);">
        <a href="/" style="color: rgba(255,255,255,0.4); text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        How to Launch a Clothing Brand
      </p>
    </nav>

    <p class="label">Manufacturer's Guide · 27 Years of Production Experience</p>

    <h1 style="font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 200; color: #fff; line-height: 1.15; margin-bottom: 1.5rem; max-width: 820px;">
      How to Launch a Clothing Brand —<br/>A Clothing Manufacturer's Guide
    </h1>

    <p style="font-size: 1rem; color: rgba(255,255,255,0.72); max-width: 660px; line-height: 1.9; margin-bottom: 0.9rem;">
      Most guides on starting a clothing brand are written by business coaches or e-commerce platforms. This one is written from the factory side — by people who have seen hundreds of first-time brands place their first order, and know exactly where things go wrong before a single garment is cut.
    </p>
    <p style="font-size: 0.85rem; color: rgba(255,255,255,0.4); max-width: 620px; line-height: 1.8; margin-bottom: 2.5rem;">
      If you are planning your first clothing brand, or scaling from samples to real production, this guide covers what you need to know before contacting any manufacturer.
    </p>

    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="/contact/" class="cta-button">Talk to Our Team</a>
      <a href="#guide-start" class="ghost-button">Read the Guide ↓</a>
    </div>
  </div>
</section>

<!-- ═══ GUIDE CONTENTS ═══ -->
<section style="padding: 3rem 0; border-bottom: 1px solid #111;" id="guide-start">
  <div class="container">
    <div class="prose-container">
      <p class="label">What This Guide Covers</p>
      <div class="grid-1px" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        {[
          { n:"01", t:"Before you contact a factory" },
          { n:"02", t:"Define your product" },
          { n:"03", t:"Choose your manufacturing model" },
          { n:"04", t:"The sampling process" },
          { n:"05", t:"Branding elements your factory needs" },
          { n:"06", t:"Certifications for your market" },
          { n:"07", t:"Your first order timeline" },
          { n:"08", t:"How to calculate landed cost" },
        ].map(s => (
          <div class="cell" style="padding: 1.25rem;">
            <p class="step-number">{s.n}</p>
            <p style="font-size: 0.83rem; color: rgba(255,255,255,0.7);">{s.t}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION 01 ═══ -->
<section style="padding: 5.5rem 0; border-bottom: 1px solid #111;">
  <div class="container">
    <div class="prose-container">
      <p class="step-number">01</p>
      <h2 class="h2" style="margin-bottom: 1.5rem;">Before you contact a factory — what you need to have ready</h2>

      <p class="body-text" style="margin-bottom: 1.25rem;">
        The most common mistake brands make when launching is contacting a clothing manufacturer before they are ready. They send a vague message — "I want to start a clothing brand, can you make hoodies?" — and wonder why they get slow responses or inaccurate quotes.
      </p>
      <p class="body-text" style="margin-bottom: 1.25rem;">
        A factory receives hundreds of inquiries a week. The ones that get fast, detailed responses are the ones that come with enough information to actually quote against. Here is the minimum a factory needs before they can give you a useful reply:
      </p>

      <div class="grid-1px" style="grid-template-columns: 1fr 1fr; margin-bottom: 2rem;">
        {[
          { item: "Garment category", note: "T-shirt, hoodie, woven shirt, trouser — be specific" },
          { item: "Approximate quantity", note: "Total pieces per style you want to order" },
          { item: "Target price range", note: "Your maximum FOB cost per piece, even approximately" },
          { item: "Fabric preference", note: "Material type, weight (GSM), and any certification requirements" },
          { item: "Destination market", note: "EU, UK, USA, Australia — affects certifications and documentation" },
          { item: "Timeline", note: "When you need goods in your warehouse" },
        ].map(row => (
          <div class="cell" style="padding: 1.25rem;">
            <p style="font-size: 0.83rem; font-weight: 500; color: #fff; margin-bottom: 0.25rem;">{row.item}</p>
            <p class="note">{row.note}</p>
          </div>
        ))}
      </div>

      <div class="warning-box">
        <p style="font-size: 0.8rem; color: #e00; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.4rem;">Common mistake</p>
        <p class="body-text">You do not need a completed tech pack to get a preliminary quote. Any factory that requires a full tech pack before giving any pricing is creating an unnecessary barrier. A one-page brief is enough to start.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION 02 ═══ -->
<section style="padding: 5.5rem 0; border-bottom: 1px solid #111; background: #040404;">
  <div class="container">
    <div class="prose-container">
      <p class="step-number">02</p>
      <h2 class="h2" style="margin-bottom: 1.5rem;">Define your product — the decisions that affect everything else</h2>

      <p class="body-text" style="margin-bottom: 1.25rem;">
        Every production decision downstream — MOQ, pricing, lead time, certifications, sampling — depends on your product definition. Brands that change their mind mid-sampling cost themselves weeks and hundreds in rework fees.
      </p>

      <p class="body-text" style="margin-bottom: 2rem;">
        Before you go further, answer these four questions clearly:
      </p>

      <div style="display: flex; flex-direction: column; gap: 1px; background: #1a1a1a; margin-bottom: 2rem;">
        {[
          {
            q: "What is the garment?",
            a: "Not just 'a hoodie'. A 320 GSM brushed fleece heavyweight hoodie with a kangaroo pocket, flatlock seams, and a structured boxy fit is a different product — different price, different sampling process, different equipment — from a 280 GSM standard fleece pullover. The more specific you are, the more accurate the quote."
          },
          {
            q: "Who is it for?",
            a: "Your target customer affects sizing (US vs EU vs Asian sizing grading), fabric choice (performance fabrics for active wearers, premium cottons for fashion-conscious buyers), and price point. A factory producing for a £60 retail hoodie has different quality expectations than one producing for a £20 retail hoodie."
          },
          {
            q: "Where will it be sold?",
            a: "Destination market determines certifications (GOTS for organic claims, OEKO-TEX for EU safety, BSCI for UK retailer onboarding), labelling requirements (GINETEX care symbols are legally required in the EU), and sizing standards. A garment sold in Germany needs different label content than one sold in Australia."
          },
          {
            q: "What is your target retail price?",
            a: "Work backwards from retail price to understand your maximum FOB cost. A typical fashion brand works on a 4–6x retail markup on cost. If your target retail is £40, your maximum landed cost (FOB + freight + duties) is approximately £7–10. If a factory quotes £12 FOB, the maths does not work before you start."
          },
        ].map(item => (
          <div class="cell" style="padding: 1.75rem;">
            <h3 class="h3" style="color: #e00;">{item.q}</h3>
            <p class="body-text">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION 03 ═══ -->
<section style="padding: 5.5rem 0; border-bottom: 1px solid #111;">
  <div class="container">
    <div class="prose-container">
      <p class="step-number">03</p>
      <h2 class="h2" style="margin-bottom: 1.5rem;">Choose your manufacturing model — OEM, private label, white label, or CMT</h2>

      <p class="body-text" style="margin-bottom: 2rem;">
        Four models exist. Choosing the wrong one for your stage wastes time and money. Here is an honest breakdown of each.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem;">
        <div style="border: 1px solid #1a1a1a; padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 class="h3" style="margin-bottom: 0;">OEM — Original Equipment Manufacturing</h3>
            <span style="font-size: 0.7rem; color: #4caf50; border: 1px solid #4caf50; padding: 0.2rem 0.6rem;">Best for most brands</span>
          </div>
          <p class="body-text" style="margin-bottom: 0.85rem;">You provide a tech pack with exact specifications. The factory sources all materials and produces under your brand. Maximum control over design, materials, and fit. Your design is exclusively yours.</p>
          <p class="body-text"><strong style="color: rgba(255,255,255,0.6);">Requires:</strong> A completed tech pack, or at least a clear reference garment with instructions.</p>
        </div>

        <div style="border: 1px solid #1a1a1a; padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 class="h3" style="margin-bottom: 0;">Private Label / ODM</h3>
            <span style="font-size: 0.7rem; color: #4caf50; border: 1px solid #4caf50; padding: 0.2rem 0.6rem;">Best for brands without design resources</span>
          </div>
          <p class="body-text" style="margin-bottom: 0.85rem;">The factory develops the design from your brief. You approve samples and apply your brand. Less control over construction details, but faster to a proto sample if you do not have a pattern team.</p>
          <p class="body-text"><strong style="color: rgba(255,255,255,0.6);">Requires:</strong> A clear brief — category, style references, material preferences, and target customer description.</p>
        </div>

        <div style="border: 1px solid #1a1a1a; padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 class="h3" style="margin-bottom: 0;">White Label</h3>
            <span style="font-size: 0.7rem; color: #e8a100; border: 1px solid #e8a100; padding: 0.2rem 0.6rem;">Best for market testing only</span>
          </div>
          <p class="body-text" style="margin-bottom: 0.85rem;">The factory has existing pre-designed styles. You add your label and branding. Fastest route to product — no development phase. 20–30 day production timeline.</p>
          <div class="warning-box" style="margin: 0.85rem 0;">
            <p class="body-text"><strong style="color: #e00;">The honest limitation:</strong> The same designs can be sold to other buyers — including your competitors. White label does not give you design exclusivity. It is suitable for market testing before committing to custom development, not for building a differentiated brand long-term.</p>
          </div>
          <p class="body-text"><strong style="color: rgba(255,255,255,0.6);">Requires:</strong> Style selection from factory's existing catalog. Your brand labels and artwork.</p>
        </div>

        <div style="border: 1px solid #1a1a1a; padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <h3 class="h3" style="margin-bottom: 0;">CMT — Cut Make Trim</h3>
            <span style="font-size: 0.7rem; color: rgba(255,255,255,0.4); border: 1px solid #333; padding: 0.2rem 0.6rem;">Best for established brands with their own fabric</span>
          </div>
          <p class="body-text" style="margin-bottom: 0.85rem;">You supply the fabric. The factory cuts, sews, and finishes. You retain full control over raw materials. Lower per-piece cost than full package because you are sourcing fabric independently.</p>
          <p class="body-text"><strong style="color: rgba(255,255,255,0.6);">Requires:</strong> Finished fabric delivered to the factory, plus a pattern and spec sheet. SDF accepts CMT orders from <a href="/cut-and-sew-service/" class="inline">100 pieces per style</a>.</p>
        </div>
      </div>

      <div class="tip-box">
        <p style="font-size: 0.8rem; color: #4caf50; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.4rem;">Recommendation</p>
        <p class="body-text">For a first brand launch, OEM or private label gives you the best combination of design control and manageable complexity. Start with one or two styles. Do not try to launch a full collection on a first order — the sampling and revision process multiplies with every style you add.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION 04 ═══ -->
<section style="padding: 5.5rem 0; border-bottom: 1px solid #111; background: #040404;">
  <div class="container">
    <div class="prose-container">
      <p class="step-number">04</p>
      <h2 class="h2" style="margin-bottom: 1.5rem;">The sampling process — what to expect and how to manage it</h2>

      <p class="body-text" style="margin-bottom: 1.25rem;">
        Sampling is where most first-time brands lose time. Not because factories are slow, but because brands do not know what they are approving for.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1px; background: #1a1a1a; margin-bottom: 2rem;">
        {[
          { stage: "Proto Sample", time: "7–14 days", desc: "First physical interpretation of your spec or brief. Produced in the correct or nearest available fabric, with your intended construction. This is the stage to assess fit, proportion, and construction — not colour or exact fabric. Most brands need 1–3 revision rounds at this stage." },
          { stage: "Fit Sample (if needed)", time: "7–10 days per round", desc: "After proto approval, a fit sample addresses measurement and construction corrections. Not always necessary if the proto was close enough." },
          { stage: "Pre-Production Sample (PP Sample)", time: "7–10 days", desc: "Made in the final production fabric, in the final colour, with all approved trims and branding. This is the sample you sign off on before bulk production begins. Once you approve this, the factory goes into full production." },
          { stage: "Bulk Production", time: "40–45 days knitwear, 45–55 days woven", desc: "Full production run from approved PP sample. AQL 2.5 inspection performed before packing." },
        ].map(s => (
          <div class="cell" style="padding: 1.75rem; display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: start;">
            <div>
              <h3 class="h3">{s.stage}</h3>
              <p class="body-text">{s.desc}</p>
            </div>
            <div style="text-align: right; flex-shrink: 0;">
              <p style="font-size: 0.75rem; color: #e00; white-space: nowrap;">{s.time}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="warning-box">
        <p style="font-size: 0.8rem; color: #e00; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.4rem;">Where brands lose weeks</p>
        <p class="body-text">The most common cause of sampling delays is not the factory — it is slow feedback from the brand. Set yourself a clear review deadline for every sample. If you receive a sample and take two weeks to give feedback, you have added two weeks to your timeline without the factory being responsible.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ SECTION 05 — BRANDING ELEMENTS ═══ -->
<section style="padding: 5.5rem 0; border-bottom: 1px solid #111;">
  <div class="container">
    <div class="prose-container">
      <p class="step-number">05</p>
      <h2 class="h2" style="margin-bottom: 1.5rem;">Branding elements your clothing manufacturer needs from you</h2>

      <p class="body-text" style="margin-bottom: 1.25rem;">
        A common point of confusion: brands assume the factory will handle their logo and brand identity. A clothing manufacturer is not a branding agency. We produce garments and apply your branding — we do not create it from scratch unless you specifically request design development as an add-on service.
      </p>
      <p class="body-text" style="margin-bottom: 2.5rem;">
        Here is exactly what you need to have ready — in the right format — before production starts.
      </p>

      <div class="grid-1px" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 2rem;">
        {[
          {
            element: "Woven Neck & Hem Labels",
            spec: "Logo in vector format (AI, EPS, or PDF with embedded fonts). Do not send a PNG. Woven label mills require vector files. Specify Pantone colour reference for each colour in the logo — not 'red' or '#e00000'. Standard neck label size: 3cm × 5cm. Confirm your brand name font or provide the font file.",
            included: true
          },
          {
            element: "Care Labels",
            spec: "Care labels must include GINETEX care symbols (washing, bleaching, tumble dry, ironing, dry cleaning) — legally required in the EU, UK, and Australia. Plus: fibre content percentage (e.g. 100% organic cotton), country of origin, and your brand's registered address. We can advise on the correct care symbols for your fabric and construction.",
            included: true
          },
          {
            element: "Hang Tags",
            spec: "Artwork file in AI, EPS, or print-ready PDF with 3mm bleed. Standard hang tag size: 55mm × 90mm (portrait) or 90mm × 55mm (landscape). Specify: stock weight (300–400gsm standard), finish (matte or gloss laminate), and string colour. If you include a barcode, provide the barcode file or EAN-13 number.",
            included: true
          },
          {
            element: "Poly Bag Packaging",
            spec: "Specify bag size per garment category. Standard sizes: T-shirt 35×45cm, hoodie 45×55cm, trouser 45×60cm. If branded: logo in vector + Pantone reference. Specify if self-seal or resealable. EU packaging regulations require ventilation holes on bags accessible to children.",
            included: true
          },
          {
            element: "Embroidery",
