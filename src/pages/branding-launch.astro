	<meta property="og:description" content="Complete clothing brand branding — logo, labels, hang tags & packaging designed and produced in-house from $500. 300-piece MOQ. Ships worldwide." />
	<meta property="og:image" content="https://sdfclothing.com/og-branding-launch.jpg" />
