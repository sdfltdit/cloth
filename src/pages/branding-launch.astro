	<!-- Breadcrumb Navigation -->
	<nav aria-label="Breadcrumb" class="py-4 px-4 bg-black/50">
		<div class="container mx-auto max-w-7xl">
			<ol class="flex items-center space-x-2 text-sm">
				<li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
				<li class="text-white/40">/</li>
				<li><span class="text-white">Branding Launch Service</span></li>
			</ol>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="py-16 px-4 bg-black">
		<div class="container mx-auto max-w-4xl text-center">
			<p class="text-sm font-semibold text-[#e00] uppercase tracking-widest mb-4">Clothing Brand Branding Service</p>
			<h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
				Logo, Labels & Packaging — Built Together, Launched Right
			</h1>
			<p class="text-lg md:text-xl text-white/80 leading-relaxed mb-4 max-w-3xl mx-auto">
				Most new clothing brands piece their identity together from three different vendors. The logo comes from one place, labels from another, and packaging from a third — and nothing quite fits together in the end.
			</p>
			<p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8 max-w-3xl mx-auto">
				Our branding launch service keeps everything in one place. One brief, one team, one process — and your brand arrives as a unified identity, not a collection of parts.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
				<a href="/contact" class="bg-[#e00] text-white px-8 py-4 text-lg font-semibold hover:bg-[#aa0000] transition-all transform hover:scale-105 min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					Start Your Brand Launch
				</a>
				<a href="#whats-included" class="border border-white/30 text-white px-8 py-4 text-lg font-semibold hover:border-white transition-all min-h-[44px] min-w-[44px] inline-flex items-center justify-center">
					See What's Included
				</a>
			</div>
			<p class="text-white/50 text-sm">Starting from $500 · 300-piece MOQ for production · Ships worldwide</p>
		</div>
	</section>

	<!-- Trust Bar -->
	<section class="py-6 px-4 bg-black border-y border-[#1a1a1a]">
		<div class="container mx-auto max-w-5xl">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
				<div>
					<div class="text-2xl font-bold text-white">{companyAge}</div>
					<div class="text-white/50 text-sm mt-1">Manufacturing experience</div>
				</div>
				<div>
					<div class="text-2xl font-bold text-white">300+</div>
					<div class="text-white/50 text-sm mt-1">Brands launched</div>
				</div>
				<div>
					<div class="text-2xl font-bold text-white">30+</div>
					<div class="text-white/50 text-sm mt-1">Countries served</div>
				</div>
				<div>
					<div class="text-2xl font-bold text-white">$500</div>
					<div class="text-white/50 text-sm mt-1">Starting price</div>
