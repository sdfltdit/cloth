  function populatePhoneDropdown(selectedCode) {
    const sel = document.getElementById('phone-code-select');
    if (!sel) return;
    sel.innerHTML = '';
    COUNTRIES.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.phone;
      opt.textContent = `${c.flag} ${c.phone}`;
      opt.dataset.code = c.code;
      if (c.code === selectedCode) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  function populateCountryDropdown(selectedCode) {
    const sel = document.getElementById('contact-country');
    if (!sel) return;
    sel.innerHTML = '<option value="">Select country</option>';
    COUNTRIES.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.name;
      opt.textContent = `${c.flag} ${c.name}`;
      if (c.code === selectedCode) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  async function autoDetect() {
    const geo = await getGeo();
    
    if (geo.countryCode && geo.countryCode !== '') {
      populateCountryDropdown(geo.countryCode);
      populatePhoneDropdown(geo.countryCode);
    } else {
      populateCountryDropdown('');
      populatePhoneDropdown('');
      
      const wrapper = document.getElementById('phone-wrapper');
      if (wrapper) {
        const warn = document.createElement('p');
        warn.style.cssText = 'font-size:0.72rem;color:#e00;margin-top:0.3rem;';
        warn.textContent = '⚠ Location not detected. Please select your country and phone code manually.';
        wrapper.parentNode.insertBefore(warn, wrapper.nextSibling);
      }
    }
    
    return geo;
  }

  function combinePhone() {
    const code = document.getElementById('phone-code-select')?.value || '';
    const num = document.getElementById('phone-number-input')?.value.trim() || '';
    const hidden = document.getElementById('whatsapp');
    if (hidden) hidden.value = code + num;
  }

  autoDetect();

  function getDevice() {
    const ua = navigator.userAgent;
    if (/iPhone/.test(ua)) return 'iPhone';
    if (/iPad/.test(ua)) return 'iPad';
    if (/Android/.test(ua)) return 'Android Device';
    if (/Mac/.test(ua)) return 'Mac';
    if (/Windows/.test(ua)) return 'Windows PC';
    return 'Unknown Device';
  }

  function getBrowser() {
    const ua = navigator.userAgent;
    let browser = 'Unknown';
    let version = '';
    
    if (ua.indexOf('Chrome') > -1 && ua.indexOf('Edg') === -1 && ua.indexOf('OPR') === -1) {
      browser = 'Chrome';
      const match = ua.match(/Chrome\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Safari') > -1 && ua.indexOf('Chrome') === -1) {
      browser = 'Safari';
      const match = ua.match(/Version\/(\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Firefox') > -1) {
      browser = 'Firefox';
      const match = ua.match(/Firefox\/(\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Edg') > -1) {
      browser = 'Edge';
      const match = ua.match(/Edg\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('OPR') > -1) {
      browser = 'Opera';
      const match = ua.match(/OPR\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    }
    
    return version ? `${browser} ${version}` : browser;
  }

  async function getGeo() {
    try {
      const r = await fetch('https://ipinfo.io/json');
      const d = await r.json();
      if (d.ip) return {
        ip: d.ip,
        city: d.city||'',
        region: d.region||'',
        country: d.country||'Unknown',
        countryCode: d.country||'',
        isp: d.org||'Unknown'
      };
    } catch {}
    try {
      const r = await fetch('https://ipapi.co/json/');
      const d = await r.json();
      if (d.ip) return {
        ip: d.ip,
        city: d.city||'',
        region: d.region||'',
        country: d.country_name||'Unknown',
        countryCode: d.country_code||'',
        isp: d.org||'Unknown'
      };
    } catch {}
    try {
      const r = await fetch('https://ip-api.com/json/');
      const d = await r.json();
      if (d.query) return {
        ip: d.query,
        city: d.city||'',
        region: d.regionName||'',
        country: d.country||'Unknown',
        countryCode: d.countryCode||'',
        isp: d.isp||'Unknown'
      };
    } catch {}
    try {
      const r = await fetch('https://api.ipify.org?format=json');
      const d = await r.json();
      return {ip:d.ip||'–',city:'',region:'',
              country:'Unknown',countryCode:'',isp:'Unknown'};
    } catch {}
    return {ip:'–',city:'',region:'',country:'Unknown',
            countryCode:'',isp:'Unknown'};
  }

  function generateReferenceId(ip) {
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth()+1).padStart(2,'0');
    const day = String(now.getDate()).padStart(2,'0');
    const hours = String(now.getHours()).padStart(2,'0');
    const minutes = String(now.getMinutes()).padStart(2,'0');
    const seconds = String(now.getSeconds()).padStart(2,'0');
    const hhmm = `${hours}${minutes}`;
    
    // Generate device fingerprint
    const canvas = document.createElement('canvas');
    const gl = canvas.getContext('webgl');
    const debugInfo = gl ? gl.getExtension('WEBGL_debug_renderer_info') : null;
    const gpuHash = debugInfo ? 
      gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL).slice(0,4).replace(/\s/g,'') : 
      Math.random().toString(36).slice(2,6).toUpperCase();
    
    // IP last segment or random
    let ipSuffix = '0000';
    if (ip && ip !== '–' && ip !== 'Unknown') {
      const parts = ip.split('.');
      if (parts.length === 4) {
        ipSuffix = (parts[2].padStart(2,'0') + parts[3].padStart(2,'0')).slice(0,4);
      }
    } else {
      ipSuffix = Math.floor(1000 + Math.random() * 9000).toString();
    }
    
    return `SDF-${year}${month}${day}-${hhmm}${seconds}-${ipSuffix}`;
  }

  function showThanks(geo, device, fillDuration, referenceId, deviceId) {
    const overlay  = document.getElementById('sdf-thankyou');
    const details  = document.getElementById('ty-details');
    const closeBtn = document.getElementById('ty-close');
    if (!overlay || !details) return;

    const now  = new Date();
    const time = now.toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
    const loc  = [geo.city, geo.region, geo.country].filter(Boolean).join(', ');
    const browser = getBrowser();
    const resolution = `${window.screen.width} x ${window.screen.height}`;
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown';
    const referrer = document.referrer || 'Direct';

    details.innerHTML = `
      <span style="color:#FFFFFF;">Reference ID</span><span style="color:#fff;">${referenceId}</span>
      <span style="color:#FFFFFF;">Device ID</span><span style="color:#fff;">${deviceId||'N/A'}</span>
      <span style="color:#FFFFFF;">Device</span><span style="color:#fff;">${device}</span>
      <span style="color:#FFFFFF;">Browser</span><span style="color:#fff;">${browser}</span>
      <span style="color:#FFFFFF;">Resolution</span><span style="color:#fff;">${resolution}</span>
      <span style="color:#FFFFFF;">Timezone</span><span style="color:#fff;">${timezone}</span>
      <span style="color:#FFFFFF;">Location</span><span style="color:#fff;">${loc||'Unknown'}</span>
      <span style="color:#FFFFFF;">ISP</span><span style="color:#fff;">${geo.isp}</span>
      <span style="color:#FFFFFF;">IP</span><span style="color:#fff;">${geo.ip}</span>
      <span style="color:#FFFFFF;">Referrer</span><span style="color:#fff;">${referrer}</span>
      <span style="color:#FFFFFF;">Fill Time</span><span style="color:#fff;">${fillDuration}s</span>
      <span style="color:#FFFFFF;">Time</span><span style="color:#fff;">${time}</span>
    `;

    overlay.style.display = 'flex';
    if (closeBtn) closeBtn.onclick = () => { overlay.style.display = 'none'; };
  }

  function withTimeout(promise, ms) {
    return Promise.race([
      promise,
      new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), ms))
    ]);
  }

  async function submitWeb3Forms(data) {
    try {
      const body = new FormData();
      body.append('access_key', WEB3_ACCESS_KEY);
      Object.entries(data).forEach(([k,v]) => body.append(k,v));
      const r = await withTimeout(fetch('https://api.web3forms.com/submit', { method:'POST', body }), 5000);
      const j = await r.json();
      return j.success === true;
    } catch {
      return false;
    }
  }

  async function submitFormspree(data) {
    try {
      const r = await withTimeout(fetch(FORMSPREE_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify(data)
      }), 5000);
      return r.ok;
    } catch {
      return false;
    }
  }

  async function submitEmailJS(data) {
    try {
      if (typeof emailjs === 'undefined') {
        emailjs.init(EMAILJS_PUBLIC_KEY);
      }
      const templateParams = {
        from_name: data.name || '',
        from_email: data.email || '',
        company: data.company || '',
        whatsapp: data.whatsapp || '',
        country: data.country || '',
        category: data.category || '',
        quantity: data.quantity || '',
        message: data.message || ''
      };
      await withTimeout(emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams), 5000);
      return true;
    } catch {
      return false;
    }
  }

  async function submitBasin(data) {
    try {
      const r = await withTimeout(fetch(BASIN_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(data)
      }), 5000);
      return r.ok;
    } catch {
      return false;
    }
  }

  function setButtonLoading(btn, loading) {
    if (!btn) return;
    btn.disabled = loading;
    if (loading) {
      btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.8s linear infinite;"></span>';
    } else {
      btn.textContent = 'Send Inquiry';
    }
  }

  const form = document.getElementById('contactForm');
  const btn  = document.getElementById('form-submit-btn');
  if (!form) return;

  const ipSubmissionCount = {};

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!btn) return;

    combinePhone();

    const data = {};
    new FormData(form).forEach((v,k) => { data[k]=v; });
    data['_replyto'] = data.email || '';
    data['_subject'] = 'New Inquiry — SDF Clothing';

    const fillDuration = ((Date.now() - pageLoadTime) / 1000).toFixed(1);

    if (data._honey) {
      form.reset();
      const geo = await getGeo();
      const referenceId = generateReferenceId(geo.ip);
      showThanks(geo, getDevice(), fillDuration, referenceId);
      return;
    }

    if (parseFloat(fillDuration) < 3) {
      form.reset();
      const geo = await getGeo();
      const referenceId = generateReferenceId(geo.ip);
      showThanks(geo, getDevice(), fillDuration, referenceId);
      return;
    }

    const phoneNum = document.getElementById('phone-number-input')?.value.trim() || '';
    if (!phoneNum || phoneNum.replace(/[\s\-\(\)]/g,'').length < 5) {
      alert('Please enter your phone number.');
      setButtonLoading(btn, false);
      btn.disabled = false;
      btn.textContent = 'Send Inquiry';
      return;
    }

    setButtonLoading(btn, true);

    const geo = await getGeo();
    const device = getDevice();

    // Collect device fingerprint
    const deviceFingerprint = {
      screen: `${window.screen.width}x${window.screen.height}`,
      colorDepth: window.screen.colorDepth,
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      language: navigator.language,
      platform: navigator.platform,
      cookieEnabled: navigator.cookieEnabled,
      touchPoints: navigator.maxTouchPoints || 0,
      deviceMemory: navigator.deviceMemory || 'unknown',
      hardwareConcurrency: navigator.hardwareConcurrency || 'unknown',
    };

    const deviceId = btoa(JSON.stringify({
      ua: navigator.userAgent.slice(0,50),
      screen: deviceFingerprint.screen,
      tz: deviceFingerprint.timezone,
      lang: deviceFingerprint.language
    })).slice(0,20);

    if (geo.ip && geo.ip !== '–') {
      ipSubmissionCount[geo.ip] = (ipSubmissionCount[geo.ip] || 0) + 1;
      if (ipSubmissionCount[geo.ip] > 3) {
        setButtonLoading(btn, false);
        btn.disabled = false;
        btn.textContent = 'Send Inquiry';
        alert('Too many submissions. Please email us directly at contact@sdfltd.com');
        return;
      }
    }

    const referenceId = generateReferenceId(geo.ip);
    data['_device']       = device;
    data['_location']     = [geo.city, geo.region, geo.country].filter(Boolean).join(', ');
    data['_ip']           = geo.ip;
    data['_reference_id'] = referenceId;
    data['_device_id'] = deviceId;
    data['_device_fingerprint'] = JSON.stringify(deviceFingerprint);
    data['_screen'] = deviceFingerprint.screen;
    data['_timezone'] = deviceFingerprint.timezone;
    data['_language'] = deviceFingerprint.language;

    let success = false;

    try { success = await submitWeb3Forms(data); } catch {}
    if (!success) {
      try { success = await submitFormspree(data); } catch {}
    }
    if (!success) {
      try { success = await submitEmailJS(data); } catch {}
    }
    if (!success) {
      try { success = await submitBasin(data); } catch {}
    }

    setButtonLoading(btn, false);

    if (success) {
      form.reset();
      showThanks(geo, device, fillDuration, referenceId, deviceId);
    } else {
      btn.disabled = false;
      btn.textContent = 'Send Inquiry';
      alert('Something went wrong. Please email us directly at contact@sdfltd.com');
    }
  });
});
</script>

