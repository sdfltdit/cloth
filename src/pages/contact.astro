---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Contact Garment Factory Bangladesh | Free FOB Quote — SDF Clothing";
const pageDescription = "Get a free FOB quote from SDF Clothing — ethical garment manufacturer in Bangladesh since 1998. MOQ 300 pieces, FOB/CIF/DDP shipping. Use our free FOB price estimator, shipment timeline calculator, and sustainability score tool. Response within 48 hours.";
const canonicalUrl = "https://sdfltd.com/contact";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<meta name="robots" content="index, follow" />

<meta property="og:title" content="Contact Garment Factory Bangladesh | Free FOB Quote — SDF Clothing" />
<meta property="og:description" content="Get a free FOB quote from SDF Clothing. Bangladesh garment manufacturer since 1998. MOQ 300 pieces. Free planning tools for buyers." />
<meta property="og:url" content="https://sdfltd.com/contact" />
<meta property="og:type" content="website" />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Contact Garment Factory Bangladesh | Free FOB Quote",
  "description": "Contact SDF Clothing — ethical garment manufacturer in Bangladesh since 1998. Get a free FOB quote. MOQ 300 pieces. FOB, CIF, DDP shipping available.",
  "url": "https://sdfltd.com/contact",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://sdfltd.com/contact" }
    ]
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ClothingStore",
  "name": "SDF Clothing Ltd",
  "description": "Ethical garment manufacturer and exporter in Bangladesh since 1998. OEM, private label, and CMT manufacturing. MOQ 300 pieces. FOB, CIF, DDP shipping worldwide.",
  "url": "https://sdfltd.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "House 125, Road 01, Baridhara DOHS",
    "addressLocality": "Dhaka",
    "postalCode": "1212",
    "addressCountry": "BD"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "23.7937",
    "longitude": "90.4066"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "availableLanguage": ["English"]
  },
  "areaServed": ["US", "GB", "CA", "AU", "DE", "FR", "NL", "SE", "DK", "NO"],
  "priceRange": "$$"
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Free Quote · 24hr Response</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Contact Our Garment Factory<br>in Bangladesh</h1>
    <p style="color:#FFFFFF;max-width:500px;line-height:1.8;font-size:0.92rem;">Get a free FOB quote within 48 hours. MOQ 300 pieces. OEM, private label, and CMT manufacturing since 1998.</p>
  </div>
</section>

<!-- INFO STRIP -->
<section style="padding:2rem 0;">
  <div class="container">
    <div style="text-align:center;margin-bottom:2rem;">
      <span style="font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:#e00;margin-right:0.75rem;">BUSINESS HOURS</span>
      <span style="font-size:0.8rem;color:rgba(255,255,255,0.5);">Monday – Friday, 9:00 AM – 6:00 PM (BST / GMT+6)</span>
    </div>
    <p class="contact-intro-text">
      SDF Clothing is a Bangladesh garment factory supplying OEM and private label apparel to brands in the USA, UK, Canada, Australia, and Europe since 1998. We manufacture T-shirts, hoodies, woven shirts, trousers, jackets, activewear, and more — with FOB shipping from Chittagong Port. MOQ 300 pieces.
    </p>
  </div>
</section>

<!-- MAIN CONTENT -->
<section style="padding:4rem 0 3rem 0;">
  <div class="container" style="max-width:1200px;margin:0 auto;">
    <div class="contact-layout">

      <!-- FORM -->
      <div style="position:sticky;top:2rem;align-self:start;">
        <h2 style="font-size:0.9rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:1rem;">Send Your Inquiry</h2>

        <form id="contactForm" data-contact>
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div style="margin-bottom:0.6rem;">
            <label for="contact-name" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Full Name *</label>
            <input type="text" id="contact-name" name="name" required placeholder="John Smith" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div style="margin-bottom:0.6rem;">
            <label for="contact-company" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Company / Brand Name</label>
            <input type="text" id="contact-company" name="company" placeholder="Your Brand" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div style="margin-bottom:0.6rem;">
            <label for="contact-email" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Email Address *</label>
            <input type="email" id="contact-email" name="email" required placeholder="your@email.com" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div style="margin-bottom:0.6rem;">
            <label for="phone-number-input" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">
              WhatsApp / Phone *
            </label>
            <div style="display:flex;border:1px solid #e00;overflow:visible;">
              <select
                id="phone-code-select"
                name="phoneCode"
                style="background:#000;border:none;border-right:1px solid #333;color:#fff;padding:0.5rem 0.4rem;font-size:0.85rem;outline:none;font-family:inherit;width:130px;flex-shrink:0;cursor:pointer;"
              >
                <option value="">🌍 +??</option>
              </select>
              <input
                type="tel"
                id="phone-number-input"
                name="phoneNumber"
                required
                placeholder="Your number"
                style="background:#000;border:none;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;flex:1;width:calc(100% - 130px);outline:none;font-family:inherit;display:block;"
              />
            </div>
            <input type="hidden" id="whatsapp" name="whatsapp" />
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.6rem;">
            <div>
              <label for="contact-country" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Country</label>
              <select id="contact-country" name="country" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
                <option value="">Select country</option>
              </select>
            </div>
            <div>
              <label for="contact-category" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Product Category</label>
              <select id="contact-category" name="category" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
                <option value="">Select category</option>
                <option>T-Shirts</option>
                <option>Hoodies / Sweatshirts</option>
                <option>Activewear</option>
                <option>Denim</option>
                <option>Womenswear</option>
                <option>Kidswear</option>
                <option>Uniforms</option>
                <option>Accessories</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div style="margin-bottom:0.6rem;">
            <label for="contact-quantity" style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Estimated Quantity</label>
            <input type="text" id="contact-quantity" name="quantity" placeholder="e.g. 500 pieces, 3 styles" style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div style="margin-bottom:0.6rem;">
            <label style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.25rem;">Message / Requirements</label>
            <textarea name="message" rows="4" placeholder="Describe your product, fabric preferences, timeline, target price..." style="background:#000;border:1px solid #e00;color:#fff;padding:0.5rem 0.75rem;font-size:0.85rem;width:100%;outline:none;font-family:inherit;resize:vertical;transition:border-color 0.2s;min-height:80px;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
          </div>

          <button type="submit" id="form-submit-btn" style="background:#e00;color:#fff;border:none;padding:0.65rem 1rem;font-size:0.8rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;font-family:inherit;min-height:44px;transition:background 0.2s;width:100%;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#e00'">
            Send Inquiry
          </button>

          <p style="font-size:0.72rem;color:#FFFFFF;text-align:center;line-height:1.6;">
            By submitting you agree to our <a href="/privacy" style="color:#FFFFFF;text-decoration:none;border-bottom:1px solid #333;">Privacy Policy</a>. We never share your data.
          </p>
        </form>
      </div>

      <!-- RIGHT COLUMN: TOOLS -->
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <h2 style="font-size:0.9rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0;">Free Planning Tools for Garment Buyers</h2>
        <p style="color:rgba(255,255,255,0.5);font-size:0.75rem;margin-bottom:0.5rem;line-height:1.5;">Use these free calculators to estimate your FOB price, plan your Bangladesh shipment timeline, check your order's sustainability score, convert colors between formats, and generate wash care labels before reaching out.</p>

        <!-- TOOL 1: FOB PRICE ESTIMATOR -->
        <div id="tool-1" style="background:#0a0a0a;border:1px solid #1a1a1a;padding:1rem;border-radius:2px;position:relative;">
          <span style="position:absolute;top:1rem;left:1rem;color:#cc0000;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;">01</span>
          <h3 style="color:#fff;font-size:0.9rem;font-weight:600;margin-bottom:0.2rem;margin-left:2rem;">FOB Price Estimator</h3>
          <p style="color:rgba(255,255,255,0.6);font-size:0.75rem;margin-bottom:1rem;margin-left:2rem;">Get an instant ballpark FOB price based on real Bangladesh manufacturing data. For detailed information about our confidentiality practices, download our <a href="/nda/index" style="color:#e00;text-decoration:underline;">NDA</a> before sharing sensitive design files.</p>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;margin-left:2rem;">
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Product Type</label>
              <select id="fob-product" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;">
                <option value="tshirt">T-Shirt / Polo</option>
                <option value="hoodie">Hoodie / Sweatshirt</option>
                <option value="woven">Woven Shirt / Blouse</option>
                <option value="trousers">Trousers / Shorts</option>
                <option value="jacket">Jacket / Outerwear</option>
                <option value="dress">Dress / Skirt</option>
                <option value="knitwear">Knitwear / Sweater</option>
                <option value="activewear">Activewear / Sportswear</option>
                <option value="accessories">Accessories / Others</option>
              </select>
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Fabric Type</label>
              <select id="fob-fabric" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;">
                <option value="cotton">100% Cotton</option>
                <option value="cotton-poly">Cotton Polyester Blend</option>
                <option value="polyester">100% Polyester</option>
                <option value="fleece">Fleece / Terry</option>
                <option value="denim">Denim</option>
                <option value="linen">Linen / Linen Blend</option>
                <option value="technical">Technical / Performance Fabric</option>
                <option value="organic">Organic / Sustainable Fabric</option>
              </select>
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Order Quantity</label>
              <input type="number" id="fob-quantity" placeholder="e.g. 5000" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;" />
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Decoration</label>
              <select id="fob-decoration" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;">
                <option value="none">None / Plain</option>
                <option value="screen">Screen Print (1-3 colors)</option>
                <option value="emb-small">Embroidery (small logo)</option>
                <option value="emb-large">Embroidery (large/complex)</option>
                <option value="aop">All Over Print (AOP)</option>
                <option value="multi">Multiple Techniques</option>
              </select>
            </div>
            <div style="grid-column:span 2;">
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Incoterms</label>
              <select id="fob-incoterms" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;">
                <option value="fob">FOB Chittagong</option>
                <option value="cif">CIF — Cost, Insurance & Freight</option>
                <option value="ddp">DDP — Delivered Duty Paid</option>
              </select>
            </div>
          </div>

          <button id="fob-calculate" style="background:#cc0000;color:#fff;border:none;padding:0.5rem 1.25rem;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;width:auto;display:inline-block;margin-top:0.75rem;margin-left:2rem;float:right;">Calculate FOB Estimate</button>
          <div style="clear:both;"></div>

          <div id="fob-results" style="background:#111;border:1px solid #1a1a1a;padding:1rem;margin-top:1rem;margin-left:2rem;display:none;">
            <p style="color:#0f0;font-size:0.7rem;font-weight:600;margin-bottom:0.75rem;">✓ Your estimate is ready</p>
            <p id="fob-price-range" style="color:#fff;font-size:1rem;font-weight:600;margin-bottom:0.4rem;"></p>
            <p id="fob-total-value" style="color:rgba(255,255,255,0.75);font-size:0.78rem;margin-bottom:0.4rem;"></p>
            <p id="fob-payment" style="color:rgba(255,255,255,0.75);font-size:0.78rem;margin-bottom:1rem;"></p>
            <p style="color:rgba(255,255,255,0.5);font-size:0.72rem;margin-bottom:1rem;line-height:1.4;">Submit your inquiry below to receive your personalised FOB quote within 48 hours.</p>
            <a href="#contactForm" style="background:#cc0000;color:#fff;padding:0.6rem 1rem;display:block;text-align:center;text-decoration:none;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;">GET YOUR EXACT QUOTE →</a>
          </div>
        </div>

        <!-- TOOL 2: SHIPMENT READINESS CALCULATOR -->
        <div id="tool-2" style="background:#0a0a0a;border:1px solid #1a1a1a;padding:1rem;border-radius:2px;position:relative;">
          <span style="position:absolute;top:1rem;left:1rem;color:#cc0000;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;">02</span>
          <h3 style="color:#fff;font-size:0.9rem;font-weight:600;margin-bottom:0.2rem;margin-left:2rem;">Shipment Readiness Calculator</h3>
          <p style="color:rgba(255,255,255,0.6);font-size:0.75rem;margin-bottom:1rem;margin-left:2rem;">Plan your order timeline from Bangladesh.</p>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;margin-left:2rem;">
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Delivery Date</label>
              <input type="date" id="ship-date" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;" />
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Product Type</label>
              <select id="ship-product" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;">
                <option value="tshirt">T-Shirt / Polo</option>
                <option value="hoodie">Hoodie / Sweatshirt</option>
                <option value="woven">Woven Shirt / Blouse</option>
                <option value="trousers">Trousers / Shorts</option>
                <option value="jacket">Jacket / Outerwear</option>
                <option value="dress">Dress / Skirt</option>
                <option value="knitwear">Knitwear / Sweater</option>
                <option value="activewear">Activewear / Sportswear</option>
                <option value="accessories">Accessories / Others</option>
              </select>
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Order Quantity</label>
              <input type="number" id="ship-quantity" placeholder="e.g. 5000" style="background:#111;border:1px solid #2a2a2a;color:#fff;padding:0.4rem 0.6rem;width:100%;border-radius:2px;font-size:0.8rem;" />
            </div>
            <div>
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Sample Required?</label>
              <div style="display:flex;gap:1rem;align-items:center;margin-top:0.25rem;">
                <label style="color:rgba(255,255,255,0.8);font-size:0.78rem;display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                  <input type="radio" name="ship-sample" value="yes" style="accent-color:#cc0000;" /> Yes
                </label>
                <label style="color:rgba(255,255,255,0.8);font-size:0.78rem;display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                  <input type="radio" name="ship-sample" value="no" checked style="accent-color:#cc0000;" /> No
                </label>
              </div>
            </div>
            <div style="grid-column:span 2;">
              <label style="color:#fff;font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.2rem;display:block;">Fabric Source</label>
              <div style="display:flex;gap:0.75rem;align-items:center;margin-top:0.25rem;">
                <label style="color:rgba(255,255,255,0.8);font-size:0.78rem;display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                  <input type="radio" name="ship-fabric" value="sdf" checked style="accent-color:#cc0000;width:16px;height:16px;" /> SDF Sources
                </label>
                <label style="color:rgba(255,255,255,0.8);font-size:0.78rem;display:flex;align-items:center;gap:0.3rem;cursor:pointer;">
                  <input type="radio" name="ship-fabric" value="client" style="accent-color:#cc0000;width:16px;height:16px;" /> Client Supplies
                </label>
              </div>
            </div>
          </div>

          <button id="ship-calculate" style="background:#cc0000;color:#fff;border:none;padding:0.5rem 1.25rem;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;width:auto;display:inline-block;margin-top:0.75rem;margin-left:2rem;float:right;">Calculate Timeline</button>
          <div style="clear:both;"></div>

          <div id="ship-results" style="background:#111;border:1px solid #1a1a1a;padding:1rem;margin-top:1rem;margin-left:2rem;display:none;">
            <div id="ship-timeline" style="display:flex;flex-direction:column;gap:0.5rem;"></div>
            <p id="ship-warning" style="color:#e00;font-size:0.7rem;margin-top:0.75rem;display:none;"></p>
            <a href="#contactForm" style="background:#cc0000;color:#fff;padding:0.6rem 1rem;display:block;text-align:center;text-decoration:none;margin-top:0.75rem;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;">Confirm This Timeline With Our Team →</a>
          </div>
        </div>

        <!-- TOOL 3: SUSTAINABILITY SCORE CALCULATOR -->
        <div id="tool-3" style="background:#0a0a0a;border:1px solid #1a1a1a;padding:1rem;border-radius:2px;position:relative;">
          <span style="position:absolute;top:1rem;left:1rem;color:#cc0000;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;">03</span>
          <h3 style="color:#fff;font-size:0.9rem;font-weight:600;margin-bottom:0.2rem;margin-left:2rem;">Sustainability Score Calculator</h3>
