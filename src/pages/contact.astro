}
function getAIScore(){var text=(document.getElementById('j-whysdf').value||'').trim();var score=0;if(pasteDetected)score+=40;if(avgWpm>130)score+=25;if(backspaceCount<3&&text.length>500)score+=20;var t=fieldFocusTime?Math.round((Date.now()-fieldFocusTime)/1000):999;if(t<30&&text.length>200)score+=15;return Math.min(score,100);}
