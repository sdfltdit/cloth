---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Contact Garment Factories Bangladesh | SDF Clothing Free Quote";
const pageDescription = "Contact SDF Clothing  certified garment factories in Bangladesh. Get a free manufacturing quote within 48 hours. MOQ 300 pieces. WhatsApp or inquiry form.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<!-- Preconnect to form submission origins -->
<link rel="preconnect" href="https://api.web3forms.com" crossorigin>
<link rel="preconnect" href="https://formcarry.com" crossorigin>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact SDF Clothing | Clothing Manufacturers Bangladesh",
  "url": "https://www.sdfltd.com/contact",
  "mainEntity": {
    "@type": "LocalBusiness",
    "@id": "https://www.sdfltd.com/#org",
    "name": "SDF Clothing",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "House 125, Road 01, Baridhara DOHS",
      "addressLocality": "Dhaka",
      "postalCode": "1212",
      "addressCountry": "BD"
    },
    "geo": {"@type":"GeoCoordinates","latitude":"23.8103","longitude":"90.4125"},
    "openingHours": "Mo-Fr 09:00-18:00",
    "sameAs": [
      "https://share.google/x3iXFv3LzlsUj8jYR",
      "https://share.google/mCmuWaJDOKUtSV9rp",
      "https://maps.app.goo.gl/8NjQzUU1HeFWjLWu7"
    ]
  }
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Free Quote · 24hr Response</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Contact Our Clothing<br>Manufacturing Team</h1>
    <p style="color:#FFFFFF;max-width:500px;line-height:1.8;font-size:0.92rem;">Share your requirements and get a detailed FOB quote within 48 hours. MOQ 300 pieces. Obligation-free consultation.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<section style="padding:4rem 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;">

      <!-- FORM -->
      <div>
        <h2 style="font-size:1rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:2rem;">Send Your Inquiry</h2>

        <form id="contactForm" data-contact>
          <!-- Honeypot -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="contact-name" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Full Name *</label>
            <input type="text" id="contact-name" name="name" required placeholder="John Smith" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div>
            <label for="contact-company" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Company / Brand Name</label>
            <input type="text" id="contact-company" name="company" placeholder="Your Brand" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div>
            <label for="contact-email" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Email Address *</label>
            <input type="email" id="contact-email" name="email" required placeholder="john@yourbrand.com" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div style="margin-bottom:1.25rem;">
            <label for="phone-number-input" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">
              WhatsApp / Phone *
            </label>
            <div style="display:flex;border:1px solid #e00;overflow:visible;">
              <select
                id="phone-code-select"
                name="phoneCode"
                style="background:#000;border:none;border-right:1px solid #333;color:#fff;padding:0.75rem 0.4rem;font-size:0.82rem;outline:none;font-family:inherit;width:130px;flex-shrink:0;cursor:pointer;"
              >
                <option value="">🌍 +??</option>
              </select>
              <input
                type="tel"
                id="phone-number-input"
                name="phoneNumber"
                required
                placeholder="Your number"
                style="background:#000;border:none;color:#fff;padding:0.75rem;font-size:0.88rem;flex:1;width:calc(100% - 130px);outline:none;font-family:inherit;display:block;"
              />
            </div>
            <input type="hidden" id="whatsapp" name="whatsapp" />
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div>
              <label for="contact-country" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Country</label>
              <select id="contact-country" name="country" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
                <option value="">Select country</option>
              </select>
            </div>
            <div>
              <label for="contact-category" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Product Category</label>
              <select id="contact-category" name="category" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'">
                <option value="">Select category</option>
                <option>T-Shirts</option>
                <option>Hoodies / Sweatshirts</option>
                <option>Activewear</option>
                <option>Denim</option>
                <option>Womenswear</option>
                <option>Kidswear</option>
                <option>Uniforms</option>
                <option>Accessories</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div>
            <label for="contact-quantity" style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Estimated Quantity</label>
            <input type="text" id="contact-quantity" name="quantity" placeholder="e.g. 500 pieces, 3 styles" style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;display:block;margin-bottom:0.4rem;">Message / Requirements</label>
            <textarea name="message" rows="4" placeholder="Describe your product, fabric preferences, timeline, target price..." style="background:#000;border:1px solid #e00;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;resize:vertical;transition:border-color 0.2s;" onfocus="this.style.borderColor='#e00'" onblur="this.style.borderColor='rgba(255,255,255,0.1)'"></textarea>
          </div>

          <button type="submit" id="form-submit-btn" style="background:#e00;color:#fff;border:none;padding:0.9rem 2rem;font-size:0.78rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;font-family:inherit;min-height:44px;transition:background 0.2s;width:100%;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#e00'">
            Send Inquiry
          </button>

          <p style="font-size:0.72rem;color:#FFFFFF;text-align:center;line-height:1.6;">
            By submitting you agree to our <a href="/privacy" style="color:#FFFFFF;text-decoration:none;border-bottom:1px solid #333;">Privacy Policy</a>. We never share your data.
          </p>
        </form>
      </div>

      <!-- RIGHT SIDE INFO -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- WhatsApp box -->
        <div style="border:1px solid #e00;padding:2rem;">
          <p style="font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">Fastest Response</p>
          <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.5rem;">WhatsApp Our Team</h3>
          <p style="font-size:0.82rem;color:#FFFFFF;line-height:1.7;margin-bottom:1.25rem;">Response within 2 hours during business hours (Mon–Fri, 9am–6pm BST). Share your tech pack or photos directly.</p>
          <a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20manufacturing%20quote" target="_blank" rel="noopener noreferrer" class="whatsapp-cta" style="display:inline-flex;gap:0.5rem;align-items:center;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Open WhatsApp
          </a>
        </div>

        <!-- Info boxes -->
        <div style="border:1px solid #e00;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1rem;">Office Location</p>
          <p style="font-size:0.85rem;color:#fff;line-height:1.8;">House 125, Road 01<br>Baridhara DOHS<br>Dhaka–1212, Bangladesh</p>
        </div>

        <div style="border:1px solid #e00;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1rem;">Business Hours</p>
          <p style="font-size:0.85rem;color:#fff;line-height:1.8;">Monday – Friday<br>9:00 AM – 6:00 PM (BST / GMT+6)</p>
        </div>

        <div style="border:1px solid #e00;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1rem;">What to Include in Your Inquiry</p>
          <ul style="font-size:0.82rem;color:#FFFFFF;line-height:2;list-style:none;">
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Product type & category</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Estimated quantity</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Target FOB price range</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Delivery deadline</li>
            <li>Tech pack or reference images (optional)</li>
          </ul>
        </div>

        <!-- Tools -->
        <div style="border:1px solid #e00;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#FFFFFF;margin-bottom:1rem;">Free Planning Tools</p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <a href="/price-calculator" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid #111;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">Price Calculator <span style="color:#e00;">→</span></a>
            <a href="/lead-time-calculator" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid #111;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">Lead Time Calculator <span style="color:#e00;">→</span></a>
            <a href="/eu-readiness-checker" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='#fff'">EU Compliance Checker <span style="color:#e00;">→</span></a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- THANK YOU OVERLAY (hidden, shown via JS) -->
<div id="sdf-thankyou" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);display:none;align-items:center;justify-content:center;z-index:9999;padding:2rem;">
  <div style="max-width:460px;width:100%;border:1px solid #e00;padding:3rem 2.5rem;text-align:center;">
    <div style="width:48px;height:48px;border:1px solid #e00;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:1.4rem;color:#e00;">✓</div>
    <h2 style="font-size:1.1rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">Message Received</h2>
    <p style="font-size:0.82rem;color:#FFFFFF;margin-bottom:2rem;line-height:1.7;">Our team will respond within 48 hours.</p>
    <div style="border-top:1px solid #e00;padding-top:1.5rem;text-align:left;margin-bottom:1.5rem;">
      <p style="font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:#FFFFFF;margin-bottom:0.75rem;">Session Details</p>
      <div id="ty-details" style="display:grid;grid-template-columns:auto 1fr;gap:0.4rem 1rem;font-size:0.78rem;max-height:300px;overflow-y:auto;padding-right:0.5rem;"></div>
    </div>
    <button id="ty-close" style="background:#e00;color:#fff;border:none;padding:0.75rem 2rem;font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;min-height:44px;font-family:inherit;transition:background 0.2s;width:100%;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#e00'">Close</button>
  </div>
</div>

<!-- EmailJS CDN -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>

