---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Contact Garment Factories Bangladesh | SDF Clothing Free Quote";
const pageDescription = "Contact SDF Clothing  certified garment factories in Bangladesh. Get a free manufacturing quote within 48 hours. MOQ 300 pieces. WhatsApp or inquiry form.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact SDF Clothing  Clothing Manufacturers Bangladesh",
  "url": "https://sdfltd.com/contact",
  "mainEntity": {
    "@type": "LocalBusiness",
    "@id": "https://sdfltd.com/#org",
    "name": "SDF Clothing",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "House 125, Road 01, Baridhara DOHS",
      "addressLocality": "Dhaka",
      "postalCode": "1212",
      "addressCountry": "BD"
    },
    "geo": {"@type":"GeoCoordinates","latitude":"23.8103","longitude":"90.4125"},
    "openingHours": "Mo-Fr 09:00-18:00",
    "sameAs": [
      "https://share.google/x3iXFv3LzlsUj8jYR",
      "https://share.google/mCmuWaJDOKUtSV9rp",
      "https://maps.app.goo.gl/8NjQzUU1HeFWjLWu7"
    ]
  }
}
</script>

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Free Quote · 24hr Response</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Contact Our Clothing<br>Manufacturing Team</h1>
    <p style="color:#888;max-width:500px;line-height:1.8;font-size:0.92rem;">Share your requirements and get a detailed FOB quote within 48 hours. MOQ 300 pieces. No commitment required.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<section style="padding:4rem 0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start;">

      <!-- FORM -->
      <div>
        <h2 style="font-size:1rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:2rem;">Send Your Inquiry</h2>

        <form id="contactForm" data-contact>
          <!-- Honeypot -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Full Name *</label>
            <input type="text" name="name" required placeholder="John Smith" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Company / Brand Name</label>
            <input type="text" name="company" placeholder="Your Brand" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Email Address *</label>
            <input type="email" name="email" required placeholder="john@yourbrand.com" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">WhatsApp / Phone</label>
            <input type="tel" name="whatsapp" placeholder="+1 234 567 8900" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div>
              <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Country</label>
              <select name="country" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
                <option value="">Select country</option>
                <option>European Union</option>
                <option>United Kingdom</option>
                <option>United States</option>
                <option>Australia</option>
                <option>Canada</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Product Category</label>
              <select name="category" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'">
                <option value="">Select category</option>
                <option>T-Shirts</option>
                <option>Hoodies / Sweatshirts</option>
                <option>Activewear</option>
                <option>Denim</option>
                <option>Womenswear</option>
                <option>Kidswear</option>
                <option>Uniforms</option>
                <option>Accessories</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Estimated Quantity</label>
            <input type="text" name="quantity" placeholder="e.g. 500 pieces, 3 styles" style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'" />
          </div>

          <div>
            <label style="font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:#888;display:block;margin-bottom:0.4rem;">Message / Requirements</label>
            <textarea name="message" rows="4" placeholder="Describe your product, fabric preferences, timeline, target price..." style="background:#000;border:1px solid #1a1a1a;color:#fff;padding:0.75rem;font-size:0.88rem;width:100%;outline:none;font-family:inherit;resize:vertical;transition:border-color 0.2s;" onfocus="this.style.borderColor='#cc0000'" onblur="this.style.borderColor='#1a1a1a'"></textarea>
          </div>

          <button type="submit" id="form-submit-btn" style="background:#cc0000;color:#fff;border:none;padding:0.9rem 2rem;font-size:0.78rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;font-family:inherit;min-height:44px;transition:background 0.2s;width:100%;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#cc0000'">
            Send Inquiry
          </button>

          <p style="font-size:0.72rem;color:#555;text-align:center;line-height:1.6;">
            By submitting you agree to our <a href="/privacy" style="color:#888;text-decoration:none;border-bottom:1px solid #333;">Privacy Policy</a>. We never share your data.
          </p>
        </form>
      </div>

      <!-- RIGHT SIDE INFO -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- WhatsApp box -->
        <div style="border:1px solid #cc0000;padding:2rem;">
          <p style="font-size:0.6rem;letter-spacing:0.25em;text-transform:uppercase;color:#cc0000;margin-bottom:0.5rem;">Fastest Response</p>
          <h3 style="font-size:1rem;font-weight:500;color:#fff;margin-bottom:0.5rem;">WhatsApp Our Team</h3>
          <p style="font-size:0.82rem;color:#888;line-height:1.7;margin-bottom:1.25rem;">Response within 2 hours during business hours (Mon–Fri, 9am–6pm BST). Share your tech pack or photos directly.</p>
          <a href="https://wa.me/8801911733226?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20manufacturing%20quote" target="_blank" rel="noopener noreferrer" class="whatsapp-cta" style="display:inline-flex;gap:0.5rem;align-items:center;font-size:0.75rem;letter-spacing:0.12em;text-transform:uppercase;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Open WhatsApp
          </a>
        </div>

        <!-- Info boxes -->
        <div style="border:1px solid #1a1a1a;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1rem;">Office Location</p>
          <p style="font-size:0.85rem;color:#fff;line-height:1.8;">House 125, Road 01<br>Baridhara DOHS<br>Dhaka–1212, Bangladesh</p>
        </div>

        <div style="border:1px solid #1a1a1a;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1rem;">Business Hours</p>
          <p style="font-size:0.85rem;color:#fff;line-height:1.8;">Monday – Friday<br>9:00 AM – 6:00 PM (BST / GMT+6)</p>
        </div>

        <div style="border:1px solid #1a1a1a;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1rem;">What to Include in Your Inquiry</p>
          <ul style="font-size:0.82rem;color:#ccc;line-height:2;list-style:none;">
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Product type & category</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Estimated quantity</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Target FOB price range</li>
            <li style="border-bottom:1px solid #111;padding-bottom:0.4rem;margin-bottom:0.4rem;">Delivery deadline</li>
            <li>Tech pack or reference images (optional)</li>
          </ul>
        </div>

        <!-- Tools -->
        <div style="border:1px solid #1a1a1a;padding:1.5rem;">
          <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#888;margin-bottom:1rem;">Free Planning Tools</p>
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <a href="/price-calculator" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid #111;transition:color 0.2s;" onmouseover="this.style.color='#cc0000'" onmouseout="this.style.color='#fff'">Price Calculator <span style="color:#cc0000;">→</span></a>
            <a href="/lead-time-calculator" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid #111;transition:color 0.2s;" onmouseover="this.style.color='#cc0000'" onmouseout="this.style.color='#fff'">Lead Time Calculator <span style="color:#cc0000;">→</span></a>
            <a href="/eu-readiness-checker" style="font-size:0.8rem;color:#fff;text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;transition:color 0.2s;" onmouseover="this.style.color='#cc0000'" onmouseout="this.style.color='#fff'">EU Compliance Checker <span style="color:#cc0000;">→</span></a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- THANK YOU OVERLAY (hidden, shown via JS) -->
<div id="sdf-thankyou" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.97);display:none;align-items:center;justify-content:center;z-index:9999;padding:2rem;">
  <div style="max-width:460px;width:100%;border:1px solid #cc0000;padding:3rem 2.5rem;text-align:center;">
    <div style="width:48px;height:48px;border:1px solid #cc0000;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:1.4rem;color:#cc0000;">✓</div>
    <h2 style="font-size:1.1rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#fff;margin-bottom:0.5rem;">Message Received</h2>
    <p style="font-size:0.82rem;color:#888;margin-bottom:2rem;line-height:1.7;">Our team will respond within 48 hours.</p>
    <div style="border-top:1px solid #1a1a1a;padding-top:1.5rem;text-align:left;margin-bottom:1.5rem;">
      <p style="font-size:0.65rem;letter-spacing:0.15em;text-transform:uppercase;color:#555;margin-bottom:0.75rem;">Session Details</p>
      <div id="ty-details" style="display:grid;grid-template-columns:auto 1fr;gap:0.4rem 1rem;font-size:0.78rem;max-height:300px;overflow-y:auto;padding-right:0.5rem;"></div>
    </div>
    <button id="ty-close" style="background:#cc0000;color:#fff;border:none;padding:0.75rem 2rem;font-size:0.72rem;letter-spacing:0.15em;text-transform:uppercase;cursor:pointer;min-height:44px;font-family:inherit;transition:background 0.2s;width:100%;" onmouseover="this.style.background='#aa0000'" onmouseout="this.style.background='#cc0000'">Close</button>
  </div>
</div>

<!-- EmailJS CDN -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>

<!-- FORM SCRIPT -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const WEB3_ACCESS_KEY = 'e72c8f4e-012f-488b-8d3c-443737652450';
  const FORMSPREE_URL = 'https://formspree.io/f/xqenpqye';
  const EMAILJS_SERVICE_ID = 'service_se2lev2';
  const EMAILJS_TEMPLATE_ID = 'template_cdxgndg';
  const EMAILJS_PUBLIC_KEY = 'q3YQVGvrkMjBv5_DE';
  const BASIN_URL = 'https://usebasin.com/f/9ecfe65e8aee';

  const pageLoadTime = Date.now();

  function getDevice() {
    const ua = navigator.userAgent;
    if (/iPhone/.test(ua)) return 'iPhone';
    if (/iPad/.test(ua)) return 'iPad';
    if (/Android/.test(ua)) return 'Android Device';
    if (/Mac/.test(ua)) return 'Mac';
    if (/Windows/.test(ua)) return 'Windows PC';
    return 'Unknown Device';
  }

  function getBrowser() {
    const ua = navigator.userAgent;
    let browser = 'Unknown';
    let version = '';
    
    if (ua.indexOf('Chrome') > -1 && ua.indexOf('Edg') === -1 && ua.indexOf('OPR') === -1) {
      browser = 'Chrome';
      const match = ua.match(/Chrome\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Safari') > -1 && ua.indexOf('Chrome') === -1) {
      browser = 'Safari';
      const match = ua.match(/Version\/(\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Firefox') > -1) {
      browser = 'Firefox';
      const match = ua.match(/Firefox\/(\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('Edg') > -1) {
      browser = 'Edge';
      const match = ua.match(/Edg\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    } else if (ua.indexOf('OPR') > -1) {
      browser = 'Opera';
      const match = ua.match(/OPR\/(\d+\.\d+\.\d+\.\d+)/);
      if (match) version = match[1];
    }
    
    return version ? `${browser} ${version}` : browser;
  }

  async function getGeo() {
    try {
      const r = await fetch('https://ipapi.co/json/');
      const d = await r.json();
      return {
        ip: d.ip||'–',
        city: d.city||'',
        region: d.region||'',
        country: d.country_name||'Unknown',
        isp: d.org||'Unknown'
      };
    } catch {
      try {
        const r = await fetch('https://api.ipify.org?format=json');
        const d = await r.json();
        return {
          ip: d.ip||'–',
          city: '',
          region: '',
          country: 'Unknown',
          isp: 'Unknown'
        };
      } catch {
        return {
          ip: '–',
          city: '',
          region: '',
          country: 'Unknown',
          isp: 'Unknown'
        };
      }
    }
  }

  function generateReferenceId(ip) {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const hhmm = `${hours}${minutes}`;
    const year = now.getFullYear();
    const ipClean = ip.replace(/\./g, '');
    const last4 = ipClean.slice(-4) || '0000';
    return `SDF-${hhmm}-${year}-${last4}`;
  }

  function showThanks(geo, device, fillDuration, referenceId) {
    const overlay  = document.getElementById('sdf-thankyou');
    const details  = document.getElementById('ty-details');
    const closeBtn = document.getElementById('ty-close');
    if (!overlay || !details) return;

    const now  = new Date();
    const time = now.toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
    const loc  = [geo.city, geo.region, geo.country].filter(Boolean).join(', ');
    const browser = getBrowser();
    const resolution = `${window.screen.width} x ${window.screen.height}`;
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'Unknown';
    const referrer = document.referrer || 'Direct';

    details.innerHTML = `
      <span style="color:#555;">Reference ID</span><span style="color:#fff;">${referenceId}</span>
      <span style="color:#555;">Device</span><span style="color:#fff;">${device}</span>
      <span style="color:#555;">Browser</span><span style="color:#fff;">${browser}</span>
      <span style="color:#555;">Resolution</span><span style="color:#fff;">${resolution}</span>
      <span style="color:#555;">Timezone</span><span style="color:#fff;">${timezone}</span>
      <span style="color:#555;">Location</span><span style="color:#fff;">${loc||'Unknown'}</span>
      <span style="color:#555;">ISP</span><span style="color:#fff;">${geo.isp}</span>
      <span style="color:#555;">IP</span><span style="color:#fff;">${geo.ip}</span>
      <span style="color:#555;">Referrer</span><span style="color:#fff;">${referrer}</span>
      <span style="color:#555;">Fill Time</span><span style="color:#fff;">${fillDuration}s</span>
      <span style="color:#555;">Time</span><span style="color:#fff;">${time}</span>
    `;

    overlay.style.display = 'flex';
    if (closeBtn) closeBtn.onclick = () => { overlay.style.display = 'none'; };
  }

  function withTimeout(promise, ms) {
    return Promise.race([
      promise,
      new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), ms))
    ]);
  }

  async function submitWeb3Forms(data) {
    try {
      const body = new FormData();
      body.append('access_key', WEB3_ACCESS_KEY);
      Object.entries(data).forEach(([k,v]) => body.append(k,v));
      const r = await withTimeout(fetch('https://api.web3forms.com/submit', { method:'POST', body }), 5000);
      const j = await r.json();
      return j.success === true;
    } catch {
      return false;
    }
  }

  async function submitFormspree(data) {
    try {
      const r = await withTimeout(fetch(FORMSPREE_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify(data)
      }), 5000);
      return r.ok;
    } catch {
      return false;
    }
  }

  async function submitEmailJS(data) {
    try {
      if (typeof emailjs === 'undefined') {
        emailjs.init(EMAILJS_PUBLIC_KEY);
      }
      const templateParams = {
        from_name: data.name || '',
        from_email: data.email || '',
        company: data.company || '',
        whatsapp: data.whatsapp || '',
        country: data.country || '',
        category: data.category || '',
        quantity: data.quantity || '',
        message: data.message || ''
      };
      await withTimeout(emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, templateParams), 5000);
      return true;
    } catch {
      return false;
    }
  }

  async function submitBasin(data) {
    try {
      const r = await withTimeout(fetch(BASIN_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(data)
      }), 5000);
      return r.ok;
    } catch {
      return false;
    }
  }

  function setButtonLoading(btn, loading) {
    if (!btn) return;
    btn.disabled = loading;
    if (loading) {
      btn.innerHTML = '<span style="display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.8s linear infinite;"></span>';
    } else {
      btn.textContent = 'Send Inquiry';
    }
  }

  const form = document.getElementById('contactForm');
  const btn  = document.getElementById('form-submit-btn');
  if (!form) return;

  const ipSubmissionCount = {};

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!btn) return;

    const data = {};
    new FormData(form).forEach((v,k) => { data[k]=v; });

    const fillDuration = ((Date.now() - pageLoadTime) / 1000).toFixed(1);

    if (data._honey) {
      form.reset();
      const geo = await getGeo();
      const referenceId = generateReferenceId(geo.ip);
      showThanks(geo, getDevice(), fillDuration, referenceId);
      return;
    }

    if (parseFloat(fillDuration) < 3) {
      form.reset();
      const geo = await getGeo();
      const referenceId = generateReferenceId(geo.ip);
      showThanks(geo, getDevice(), fillDuration, referenceId);
      return;
    }

    setButtonLoading(btn, true);

    const geo = await getGeo();
    const device = getDevice();

    if (geo.ip && geo.ip !== '–') {
      ipSubmissionCount[geo.ip] = (ipSubmissionCount[geo.ip] || 0) + 1;
      if (ipSubmissionCount[geo.ip] > 3) {
        setButtonLoading(btn, false);
        btn.disabled = false;
        btn.textContent = 'Send Inquiry';
        alert('Too many submissions. Please email us directly at contact@sdfltd.com');
        return;
      }
    }

    const referenceId = generateReferenceId(geo.ip);
    data['_device']       = device;
    data['_location']     = [geo.city, geo.region, geo.country].filter(Boolean).join(', ');
    data['_ip']           = geo.ip;
    data['_reference_id'] = referenceId;

    let success = false;

    try { success = await submitWeb3Forms(data); } catch {}
    if (!success) {
      try { success = await submitFormspree(data); } catch {}
    }
    if (!success) {
      try { success = await submitEmailJS(data); } catch {}
    }
    if (!success) {
      try { success = await submitBasin(data); } catch {}
    }

    setButtonLoading(btn, false);

    if (success) {
      form.reset();
      showThanks(geo, device, fillDuration, referenceId);
    } else {
      btn.disabled = false;
      btn.textContent = 'Send Inquiry';
      alert('Something went wrong. Please email us directly at contact@sdfltd.com');
    }
  });
});
</script>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 768px) {
  section > .container > div[style*="grid-template-columns:1fr 1fr"] {
    grid-template-columns: 1fr !important;
  }
  form > div[style*="grid-template-columns:1fr 1fr"] {
    grid-template-columns: 1fr !important;
  }
}
</style>

</BaseLayout>