  document.getElementById('fob-calculate').addEventListener('click', function() {
    const product    = document.getElementById('fob-product').value;
    const fabric     = document.getElementById('fob-fabric').value;
    const quantity   = parseInt(document.getElementById('fob-quantity').value) || 0;
    const decoration = document.getElementById('fob-decoration').value;
    const incoterms  = document.getElementById('fob-incoterms').value;

    if (quantity < 1) { alert('Please enter a valid order quantity'); return; }

    let factor;
    if (quantity < 500) factor = 1.18;
    else if (quantity < 1000) factor = 1.10;
    else if (quantity < 3000) factor = 1.04;
    else if (quantity < 5000) factor = 1.00;
    else if (quantity < 10000) factor = 0.96;
    else factor = 0.92;

    let incotermsAdd;
    if (incoterms === 'fob') incotermsAdd = 0;
    else if (incoterms === 'cif') incotermsAdd = 0.55;
    else incotermsAdd = 2.20;

    const cmMin = cmRates[product].min;
    const cmMax = cmRates[product].max;
    const fabricMin = fabricCosts[fabric].min;
    const fabricMax = fabricCosts[fabric].max;
    const decorAdd  = decorationAdd[decoration];

    const fobMin = (fabricMin + cmMin + decorAdd) * factor * 1.15 + incotermsAdd;
    const fobMax = (fabricMax + cmMax + decorAdd) * factor * 1.15 + incotermsAdd;

    const totalMin = fobMin * quantity;
    const totalMax = fobMax * quantity;

    let payment;
    if (totalMin < 5000) payment = 'WorldRemit';
    else if (totalMin < 30000) payment = 'TT (Bank Transfer)';
    else payment = 'Letter of Credit (LC)';

    document.getElementById('fob-price-range').textContent = '$' + fobMin.toFixed(2) + ' – $' + fobMax.toFixed(2) + ' per piece';
    document.getElementById('fob-total-value').textContent = 'Total Order Value: $' + totalMin.toLocaleString('en-US', { minimumFractionDigits:0, maximumFractionDigits:0 }) + ' – $' + totalMax.toLocaleString('en-US', { minimumFractionDigits:0, maximumFractionDigits:0 });
    document.getElementById('fob-payment').textContent = 'Recommended Payment: ' + payment;
    document.getElementById('fob-results').style.display = 'block';
  });

  // Tool 2: Shipment Readiness Calculator
  const productionDays = {
    'tshirt':      35,
    'hoodie':      45,
    'woven':       40,
    'trousers':    40,
    'jacket':      60,
    'dress':       45,
    'knitwear':    55,
    'activewear':  40,
