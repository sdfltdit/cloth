  document.getElementById('ship-calculate').addEventListener('click', function() {
    const deliveryDateStr = document.getElementById('ship-date').value;
    const product      = document.getElementById('ship-product').value;
    const quantity     = parseInt(document.getElementById('ship-quantity').value) || 0;
    const sampleRequired = document.querySelector('input[name="ship-sample"]:checked').value === 'yes';
    const fabricSource   = document.querySelector('input[name="ship-fabric"]:checked').value;

    if (!deliveryDateStr) { alert('Please select a required delivery date'); return; }

    const deliveryDate = new Date(deliveryDateStr);

    let production = productionDays[product];
    if (quantity >= 10000) production += 15;
    else if (quantity >= 5000) production += 10;
    else if (quantity >= 1000) production += 5;

    const sampleDays   = sampleRequired ? 21 : 0;
    const fabricDays   = fabricSource === 'client' ? 14 : 10;
    const shippingDays = 28;
    const lcDays       = (quantity * 3) > 30000 ? 7 : 0;
    const bufferDays   = 5;
    const totalLeadTime = production + sampleDays + fabricDays + shippingDays + lcDays + bufferDays;

    const eta = deliveryDate;
    const etd = new Date(deliveryDate);
    etd.setDate(etd.getDate() - shippingDays);

    const exFactory = new Date(etd);
    exFactory.setDate(exFactory.getDate() - bufferDays);

    const productionStart = new Date(exFactory);
    productionStart.setDate(productionStart.getDate() - production);

    const fabricComplete = new Date(productionStart);
    fabricComplete.setDate(fabricComplete.getDate() - fabricDays);

    const sampleApproval = sampleRequired ? new Date(fabricComplete) : null;
    if (sampleApproval) sampleApproval.setDate(sampleApproval.getDate() - sampleDays);

    const orderConfirmation = sampleApproval ? new Date(sampleApproval) : new Date(fabricComplete);
    orderConfirmation.setDate(orderConfirmation.getDate() - 5);

    const today = new Date();
    const formatDate = function(date) {
      return date.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
    };
    const isPast = function(date) { return date < today; };

    const timelineItems = [
      { label: 'Order Confirmation',      date: orderConfirmation },
      { label: 'Sample Approval',         date: sampleApproval,  condition: sampleRequired },
      { label: 'Fabric Sourcing Complete',date: fabricComplete },
      { label: 'Production Start',        date: productionStart },
      { label: 'Ex-Factory',              date: exFactory },
      { label: 'ETD Chittagong Port',     date: etd },
      { label: 'ETA Destination',         date: eta }
    ];

    let timelineHtml = '';
    let hasPassedDates = false;

    timelineItems.forEach(function(item) {
      if (item.condition === false) return;
      if (!item.date) return;
      const datePassed = isPast(item.date);
      if (datePassed) hasPassedDates = true;
      const icon  = datePassed ? '⚠️' : '✅';
      const color = datePassed ? '#e00' : '#fff';
      timelineHtml += '<p style="color:' + color + ';font-size:0.85rem;display:flex;align-items:center;gap:0.5rem;"><span>' + icon + '</span><span>' + item.label + ': <strong>' + formatDate(item.date) + '</strong></span></p>';
    });

    const warningEl = document.getElementById('ship-warning');
    if (totalLeadTime < 45) {
      warningEl.style.display = 'block';
      warningEl.textContent = '⚠️ This timeline is very tight. Please contact us immediately to discuss rush production options.';
    } else {
      warningEl.style.display = 'none';
    }

    if (hasPassedDates) {
      timelineHtml += '<p style="color:#e00;font-size:0.8rem;margin-top:0.5rem;">⚠️ Some dates have already passed — tight timeline</p>';
    } else {
      timelineHtml += '<p style="color:#0f0;font-size:0.8rem;margin-top:0.5rem;">✅ Achievable timeline</p>';
    }

    document.getElementById('ship-timeline').innerHTML = timelineHtml;
    document.getElementById('ship-results').style.display = 'block';
  });

  // Tool 3: Sustainability Score Calculator
  const fabricScores = {
    'organic-cotton':     38,
    'recycled-poly':      35,
    'bamboo':             36,
    'linen':              34,
    'conventional-cotton':22,
    'synthetic-blend':    18,
    'denim':              16,
    'conventional-poly':  14
  };

  const shippingScores = {
    'sea':     24,
    'air':      8,
    'express':  3
  };

  const packagingScores = {
    'fsc':      19,
    'recycled': 18,
    'minimal':  16,
    'polybag':   6
  };

  document.getElementById('sus-calculate').addEventListener('click', function() {
    const fabric   = document.getElementById('sus-fabric').value;
    const quantity = parseInt(document.getElementById('sus-quantity').value) || 0;
    const shipping = document.getElementById('sus-shipping').value;
    const packaging= document.getElementById('sus-packaging').value;

    if (quantity < 1) { alert('Please enter a valid order quantity'); return; }

    const fabricScore   = fabricScores[fabric];
    const shippingScore = shippingScores[shipping];
    const packagingScore= packagingScores[packaging];

    let quantityBonus;
    if (quantity >= 10000) quantityBonus = 15;
    else if (quantity >= 5000) quantityBonus = 12;
    else if (quantity >= 2000) quantityBonus = 9;
    else if (quantity >= 1000) quantityBonus = 6;
    else if (quantity >= 500)  quantityBonus = 4;
    else quantityBonus = 2;

    const totalScore = fabricScore + shippingScore + packagingScore + quantityBonus;

    let label, color;
    if (totalScore < 40) { label = '🔴 Needs Improvement'; color = '#e00'; }
    else if (totalScore < 60) { label = '🟡 Developing'; color = '#ffcc00'; }
    else if (totalScore < 75) { label = '🟢 Good'; color = '#0f0'; }
    else if (totalScore < 90) { label = '🟢 Strong'; color = '#0f0'; }
    else { label = '🟢 Excellent — EU Ready'; color = '#0f0'; }

    document.getElementById('sus-score-number').textContent = totalScore;
    document.getElementById('sus-circle').style.borderColor = color;
    document.getElementById('sus-score-label').textContent = 'Your Score: ' + totalScore + ' / 100 — ' + label;

    const tips = [];
    if (fabric === 'conventional-poly')    tips.push('Switch to rPET fabric to gain +21 points');
    if (fabric === 'conventional-cotton')  tips.push('Switch to organic cotton (GOTS) to gain +16 points');
    if (shipping === 'air' || shipping === 'express') tips.push('Sea freight reduces your carbon footprint by up to 95% vs air');
    if (packaging === 'polybag')           tips.push('Recycled packaging adds +12 points and meets EU packaging directives');
    if (totalScore > 75 && tips.length === 0) tips.push('Your order profile meets the baseline requirements for most EU sustainability audits');
    if (totalScore > 85) tips.push("Your order qualifies for SDF Clothing's Green Production Programme — mention this in your inquiry");

    document.getElementById('sus-tips').innerHTML = tips.map(function(tip) {
      return '<p style="color:rgba(255,255,255,0.8);font-size:0.8rem;margin-bottom:0.5rem;">• ' + tip + '</p>';
    }).join('');

    document.getElementById('sus-results').style.display = 'block';
  });

});
</script>

