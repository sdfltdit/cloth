---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Contact Garment Factory Bangladesh | Free FOB Quote — SDF Clothing";
const pageDescription = "Get a free FOB quote from SDF Clothing — ethical garment manufacturer in Bangladesh since 1998. MOQ 300 pieces, FOB/CIF/DDP.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<meta name="robots" content="index, follow" />

<!-- HERO -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #cc0000;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#cc0000;margin-bottom:0.75rem;">Bangladesh Garment Manufacturer · Est. 1998</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Let's build something<br>together.</h1>
    <p style="color:rgba(255,255,255,0.7);max-width:500px;line-height:1.8;font-size:0.92rem;">FOB quotes within 48 hours. MOQ 300 pieces. OEM, private label and CMT manufacturing from Dhaka.</p>
  </div>
</section>

<!-- CAPABILITY STRIP -->
<section style="border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);">
      <div class="cap-item"><p class="cap-num">12<span>M+</span></p><p class="cap-label">Pcs / year capacity</p></div>
      <div class="cap-item"><p class="cap-num">26<span>+</span></p><p class="cap-label">Years in operation</p></div>
      <div class="cap-item"><p class="cap-num">300<span>pcs</span></p><p class="cap-label">Minimum order qty</p></div>
      <div class="cap-item"><p class="cap-num">FOB<span>/CIF/DDP</span></p><p class="cap-label">Incoterms supported</p></div>
    </div>
  </div>
</section>

<!-- CERT STRIP -->
<section style="border-bottom:1px solid #1a1a1a;">
  <div class="container" style="padding:0.75rem 1.5rem;">
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <span style="font-size:0.58rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.25);">Certifications</span>
      <span class="cert">GOTS</span><span class="cert">OEKO-TEX 100</span><span class="cert">BSCI</span>
      <span class="cert">ISO 9001</span><span class="cert">SA8000</span><span class="cert">Sedex</span>
    </div>
  </div>
</section>

<!-- ROLE SELECTOR -->
<section style="padding:3rem 0 0;" id="roleSection">
  <div class="container">
    <p style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#cc0000;margin-bottom:0.4rem;">Who are you?</p>
    <p style="font-size:0.85rem;font-weight:300;color:#fff;margin-bottom:1.25rem;">Select your role to get started.</p>
    <div class="role-grid" id="roleGrid">
      <div class="role-card" onclick="selectRole('buyer',this)">
        <div class="rc-icon" style="color:#cc0000;">🛍</div>
        <div class="rc-body">
          <p class="rc-title">Buyer / Brand</p>
          <p class="rc-sub">Source garments, request FOB quote, OEM or private label</p>
          <span class="rc-tag" style="border-color:#cc0000;color:#cc0000;">Quote within 48 hrs</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('factory',this)">
        <div class="rc-icon" style="color:#7abf3a;">🏭</div>
        <div class="rc-body">
          <p class="rc-title">Factory / CMT</p>
          <p class="rc-sub">Sub-contract, overflow orders or CMT partnership</p>
          <span class="rc-tag" style="border-color:#2a4a00;color:#7abf3a;">Bangladesh only</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('supplier',this)">
        <div class="rc-icon" style="color:#888;">📦</div>
        <div class="rc-body">
          <p class="rc-title">Supplier / Vendor</p>
          <p class="rc-sub">Offer fabric, trims, packaging or raw materials</p>
          <span class="rc-tag" style="border-color:#333;color:#666;">Procurement reviews</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('shipping',this)">
        <div class="rc-icon" style="color:#4a8abf;">🚢</div>
        <div class="rc-body">
          <p class="rc-title">Shipping Agent / C&amp;F</p>
          <p class="rc-sub">Freight forwarding, customs clearance, C&amp;F services</p>
          <span class="rc-tag" style="border-color:#1a3a5c;color:#4a8abf;">Logistics partnership</span>
        </div>
      </div>
      <div class="role-card" onclick="selectRole('job',this)" style="grid-column:span 2;">
        <div class="rc-icon" style="color:#5a9e5a;">📋</div>
        <div class="rc-body">
          <p class="rc-title">Job Candidate</p>
          <p class="rc-sub">Apply for a position at SDF Clothing Ltd, Dhaka Bangladesh</p>
          <span class="rc-tag" style="border-color:#1e4d1e;color:#5a9e5a;">HR reviews all applications</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAIN LAYOUT -->
<section style="padding:2rem 0 4rem;" id="mainSection" style="display:none;">
  <div class="container">
    <div id="mainLayout" class="main-layout">

      <!-- FORM COL -->
      <div id="formCol">
        <div style="display:flex;align-items:center;gap:0.75rem;padding:0.8rem 1rem;background:#0f0f0f;border:1px solid #1a1a1a;margin-bottom:1.25rem;">
          <div id="formBadge" class="f-badge f-badge-buyer">Buyer / Brand</div>
          <div>
            <p id="formTitle" style="font-size:0.82rem;font-weight:500;color:#fff;">FOB Quote Request</p>
            <p id="formSub" style="font-size:0.67rem;color:rgba(255,255,255,0.5);">Sales team reviews all inquiries</p>
          </div>
          <button onclick="goBack()" class="back-btn">&#8592; Back</button>
        </div>

        <div id="prefillBar" style="display:none;background:#080000;border-left:2px solid #cc0000;padding:0.5rem 0.75rem;margin-bottom:1rem;">
          <p style="font-size:0.68rem;color:#cc0000;">&#10003; Planning tool results pre-filled below.</p>
        </div>

        <div id="factoryBlocked" style="display:none;background:#080000;border:1px solid #cc0000;padding:1.5rem;text-align:center;margin-bottom:1rem;">
          <p style="color:#cc0000;font-size:0.85rem;font-weight:500;margin-bottom:0.5rem;">Access Restricted</p>
          <p style="color:rgba(255,255,255,0.5);font-size:0.75rem;line-height:1.7;" id="factoryBlockMsg">This form is restricted to Bangladesh-based manufacturing partners.</p>
        </div>

        <!-- BUYER FORM -->
        <div id="f-buyer" class="role-form">
          <div class="frow">
            <div class="fl"><label>Full name *</label><input type="text" id="b-name" placeholder="John Smith"/></div>
            <div class="fl"><label>Company / brand</label><input type="text" id="b-company" placeholder="Your Brand Ltd"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Email *</label><input type="email" id="b-email" placeholder="you@brand.com"/></div>
            <div class="fl"><label>WhatsApp / phone *</label><input type="tel" id="b-phone" placeholder="+1 234 567 890"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Country</label><select id="b-country"><option value="">Select country</option></select></div>
            <div class="fl"><label>Product category</label>
              <select id="b-category">
                <option value="">Select</option>
                <option>T-Shirts / Polos</option><option>Hoodies / Sweatshirts</option>
                <option>Activewear</option><option>Denim</option><option>Womenswear</option>
                <option>Kidswear</option><option>Uniforms</option><option>Other</option>
              </select>
            </div>
          </div>
          <div class="frow">
            <div class="fl"><label>Est. quantity (pcs)</label><input type="number" id="b-qty" placeholder="e.g. 5000"/></div>
            <div class="fl"><label>Target FOB price (USD)</label><input type="text" id="b-price" placeholder="e.g. $4.50 / piece"/></div>
          </div>
          <div class="frow full">
            <div class="fl"><label>Message / requirements</label><textarea id="b-msg" placeholder="Fabric, timeline, certifications needed, sample requirements..."></textarea></div>
          </div>
          <div class="frow full"><div class="fl"><label class="gdpr-label"><input type="checkbox" id="b-gdpr" style="accent-color:#cc0000;"/><span>I agree to SDF Clothing's <a href="/privacy" style="color:#cc0000;">Privacy Policy</a> and consent to my data being processed for business communication purposes.</span></label></div></div>
          <button onclick="submitForm(event,'buyer')" class="sbtn buyer-btn">Send inquiry &#8594;</button>
          <p class="form-note">Data never shared with third parties</p>
        </div>

        <!-- SUPPLIER FORM -->
        <div id="f-supplier" class="role-form" style="display:none;">
          <div class="frow">
            <div class="fl"><label>Contact name *</label><input type="text" id="s-name" placeholder="Your name"/></div>
            <div class="fl"><label>Company name *</label><input type="text" id="s-company" placeholder="Supplier Co. Ltd"/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Email *</label><input type="email" id="s-email" placeholder="you@supplier.com"/></div>
            <div class="fl"><label>Phone / WhatsApp *</label><input type="tel" id="s-phone" placeholder="+880 ..."/></div>
          </div>
          <div class="frow">
            <div class="fl"><label>Country *</label><select id="s-country" onchange="toggleBDAgent()"><option value="">Select</option></select></div>
            <div class="fl"><label>Company type</label>
              <select id="s-companytype"><option value="">Select</option><option>Manufacturer</option><option>Trading Company</option><option>Buying House</option><option>Indenting Agent</option></select>
            </div>
          </div>
          <div class="frow full">
            <div class="fl"><label>Supply category *</label>
              <select id="s-category" onchange="showSupplierFields()">
                <option value="">Select category</option>
                <option value="fabric">Fabric / Yarn</option>
                <option value="trims">Trims &amp; Accessories</option>
                <option value="packaging">Packaging</option>
                <option value="dyeing">Dyeing &amp; Washing</option>
                <option value="printing">Printing &amp; Embroidery</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <!-- Dynamic supplier fields -->
          <div id="sf-fabric" class="cat-fields" style="display:none;">
            <div class="frow"><div class="fl"><label>Fabric type</label><select id="s-fabrictype"><option>Knit</option><option>Woven</option><option>Both</option></select></div><div class="fl"><label>Fiber composition</label><input type="text" id="s-fiber" placeholder="e.g. 100% Cotton, 65/35 CVC"/></div></div>
            <div class="frow"><div class="fl"><label>GSM range</label><input type="text" id="s-gsm" placeholder="e.g. 140–280 gsm"/></div><div class="fl"><label>Monthly capacity</label><input type="text" id="s-capacity" placeholder="e.g. 50,000 meters/month"/></div></div>
            <div class="frow"><div class="fl"><label>MOQ per colour</label><input type="text" id="s-moq" placeholder="e.g. 500 kg"/></div><div class="fl"><label>Lab dip dev. time (days)</label><input type="number" id="s-labdip" placeholder="e.g. 7"/></div></div>
            <div class="frow"><div class="fl"><label>Sample dev. charge</label><select id="s-samplecharge" onchange="toggleAmt('s-samplecharge','s-sampleamt')"><option value="no">No charge</option><option value="yes">Yes, charged</option></select></div><div class="fl" id="s-sampleamt" style="display:none;"><label>Amount (USD)</label><input type="text" placeholder="e.g. $50 per colour"/></div></div>
            <div class="frow"><div class="fl"><label>Sample shipping charge</label><select id="s-shipcharge" onchange="toggleAmt('s-shipcharge','s-shipamt')"><option value="no">No charge</option><option value="yes">Yes, charged</option></select></div><div class="fl" id="s-shipamt" style="display:none;"><label>Shipping amount</label><input type="text" placeholder="e.g. $30 courier"/></div></div>
            <div class="frow"><div class="fl"><label>Certifications</label><select id="s-cert"><option value="">None</option><option>GOTS</option><option>OEKO-TEX 100</option><option>BCI</option><option>bluesign</option></select></div><div class="fl"><label>Nominated by which buyers?</label><input type="text" id="s-buyers" placeholder="e.g. H&M, Zara"/></div></div>
            <div class="frow"><div class="fl"><label>Payment terms</label><select id="s-payment"><option>LC</option><option>TT</option><option>DP</option><option>DA</option></select></div><div class="fl"><label>In-house testing lab</label><select id="s-lab"><option value="yes">Yes</option><option value="no">No</option></select></div></div>
          </div>

          <div id="sf-trims" class="cat-fields" style="display:none;">
            <div class="frow full"><div class="fl"><label>Trim types offered</label><div class="check-grid">
              <label class="check-item"><input type="checkbox" name="s-trims" value="Button"/>Button (plastic/metal/snap)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Zipper"/>Zipper (YKK/coil/invisible)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Label"/>Label (woven/printed/heat transfer)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Thread"/>Thread (polyester/cotton/nylon)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Elastic"/>Elastic (woven/knitted/braided)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Interlining"/>Interlining (fusible/sew-in)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Velcro"/>Velcro / Hook &amp; Loop</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Drawstring"/>Drawstring / Cord / Eyelet</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Rivet"/>Rivet / Jean button / Tack button</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Patch"/>Patch (leather/PU/rubber/woven)</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Reflective tape"/>Reflective tape / Piping / Binding</label>
              <label class="check-item"><input type="checkbox" name="s-trims" value="Care label"/>Care label / Compliance label</label>
            </div></div></div>
            <div class="frow"><div class="fl"><label>MOQ</label><input type="text" placeholder="e.g. 1000 pcs per design"/></div><div class="fl"><label>Lead time</label><input type="text" placeholder="e.g. 21 days"/></div></div>
            <div class="frow"><div class="fl"><label>Nominated by which buyers?</label><input type="text" placeholder="e.g. H&M, Primark"/></div><div class="fl"><label>Payment terms</label><select><option>LC</option><option>TT</option><option>DP</option><option>DA</option></select></div></div>
          </div>

          <div id="sf-packaging" class="cat-fields" style="display:none;">
            <div class="frow full"><div class="fl"><label>Packaging types offered</label><div class="check-grid">
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Polybag"/>Polybag (plain/printed/biodegradable)</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Carton"/>Carton (master/inner/display/FSC)</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Hanger"/>Hanger (plastic/wooden/branded)</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Tissue paper"/>Tissue paper / Wrapping paper</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Header card"/>Header card / Price tag / Sticker</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Silica gel"/>Desiccant / Silica gel pack</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Neck board"/>Neck board / Belly band / Collar insert</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Poly mailer"/>Poly mailer bag (e-commerce)</label>
              <label class="check-item"><input type="checkbox" name="s-pkg" value="Pallet"/>Pallet / Pallet wrap</label>
            </div></div></div>
            <div class="frow"><div class="fl"><label>MOQ</label><input type="text" placeholder="e.g. 5000 pcs"/></div><div class="fl"><label>Lead time</label><input type="text" placeholder="e.g. 14 days"/></div></div>
          </div>

          <div id="sf-dyeing" class="cat-fields" style="display:none;">
            <div class="frow full"><div class="fl"><label>Dyeing processes</label><div class="check-grid">
              <label class="check-item"><input type="checkbox" name="s-dye" value="Reactive dyeing"/>Reactive dyeing</label>
              <label class="check-item"><input type="checkbox" name="s-dye" value="Disperse dyeing"/>Disperse dyeing</label>
              <label class="check-item"><input type="checkbox" name="s-dye" value="Pigment dyeing"/>Pigment dyeing</label>
              <label class="check-item"><input type="checkbox" name="s-dye" value="Vat dyeing"/>Vat dyeing</label>
              <label class="check-item"><input type="checkbox" name="s-dye" value="Acid dyeing"/>Acid dyeing</label>
              <label class="check-item"><input type="checkbox" name="s-dye" value="Discharge dyeing"/>Discharge printing/dyeing</label>
            </div></div></div>
            <div class="frow full"><div class="fl"><label>Washing processes</label><div class="check-grid">
              <label class="check-item"><input type="checkbox" name="s-wash" value="Enzyme wash"/>Enzyme wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Stone wash"/>Stone wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Acid wash"/>Acid wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Bleach wash"/>Bleach wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Silicon wash"/>Silicon wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Ozone wash"/>Ozone wash</label>
              <label class="check-item"><input type="checkbox" name="s-wash" value="Laser treatment"/>Laser treatment</label>
            </div></div></div>
            <div class="frow"><div class="fl"><label>Monthly capacity</label><input type="text" placeholder="e.g. 50,000 kg/month"/></div><div class="fl"><label>ETP operational</label><select><option>Yes</option><option>No</option></select></div></div>
            <div class="frow"><div class="fl"><label>ZDHC MRSL compliance</label><select><option>Yes</option><option>No</option><option>In progress</option></select></div><div class="fl"><label>GOTS wet processing</label><select><option>Yes</option><option>No</option></select></div></div>
          </div>

          <div id="sf-printing" class="cat-fields" style="display:none;">
            <div class="frow full"><div class="fl"><label>Services offered</label><div class="check-grid">
              <label class="check-item"><input type="checkbox" name="s-print" value="Screen printing"/>Screen printing</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Digital / DTG"/>Digital / DTG printing</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Sublimation"/>Sublimation printing</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Embroidery"/>Embroidery</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Heat transfer"/>Heat transfer / vinyl</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Foil printing"/>Foil printing</label>
              <label class="check-item"><input type="checkbox" name="s-print" value="Rubber print"/>Rubber / puff print</label>
            </div></div></div>
            <div class="frow"><div class="fl"><label>Monthly capacity</label><input type="text" placeholder="e.g. 100,000 pcs/month"/></div><div class="fl"><label>Nominated by which buyers?</label><input type="text" placeholder="e.g. Nike, Adidas"/></div></div>
          </div>

          <!-- BD Agent (non-BD suppliers only) -->
          <div id="s-agent-block" style="display:none;background:#080000;border-left:2px solid #cc0000;padding:0.75rem 1rem;margin-bottom:0.6rem;">
            <p style="font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:#cc0000;margin-bottom:0.6rem;">Bangladesh Representative / Agent</p>
            <div class="frow"><div class="fl"><label>Agent name</label><input type="text" id="s-agentname" placeholder="Agent name"/></div><div class="fl"><label>Agent company</label><input type="text" id="s-agentcompany" placeholder="Agent company"/></div></div>
            <div class="frow"><div class="fl"><label>Agent email</label><input type="email" id="s-agentemail" placeholder="agent@company.com"/></div><div class="fl"><label>Agent phone</label><input type="tel" id="s-agentphone" placeholder="+880 ..."/></div></div>
          </div>

          <!-- Secondary contact -->
          <p class="sec-label">Secondary Contact</p>
          <div class="frow"><div class="fl"><label>Name</label><input type="text" id="s-c2name" placeholder="Backup contact name"/></div><div class="fl"><label>Email</label><input type="email" id="s-c2email" placeholder="backup@company.com"/></div></div>
          <div class="frow"><div class="fl"><label>Phone</label><input type="tel" id="s-c2phone" placeholder="+880 ..."/></div><div class="fl"><label>Designation</label><input type="text" id="s-c2desig" placeholder="e.g. Sales Manager"/></div></div>

          <div class="frow full"><div class="fl"><label class="gdpr-label"><input type="checkbox" id="s-gdpr" style="accent-color:#cc0000;"/><span>I agree to SDF Clothing's <a href="/privacy" style="color:#cc0000;">Privacy Policy</a> and consent to my data being processed for business communication purposes.</span></label></div></div>
          <button onclick="submitForm(event,'supplier')" class="sbtn supplier-btn">Submit profile &#8594;</button>
          <p class="form-note">Data never shared with third parties</p>
        </div>

        <!-- FACTORY FORM -->
        <div id="f-factory" class="role-form" style="display:none;">
          <div id="factoryIPCheck" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.4);font-size:0.8rem;">Verifying location... <span style="color:#cc0000;">&#9679;</span></div>
          <div id="factoryFormInner" style="display:none;">
            <div class="frow"><div class="fl"><label>Factory name *</label><input type="text" id="fa-factoryname" placeholder="ABC Garments Ltd"/></div><div class="fl"><label>Contact name *</label><input type="text" id="fa-name" placeholder="Your name"/></div></div>
            <div class="frow"><div class="fl"><label>Designation</label><input type="text" id="fa-designation" placeholder="e.g. Managing Director"/></div><div class="fl"><label>Email *</label><input type="email" id="fa-email" placeholder="you@factory.com.bd"/></div></div>
            <div class="frow"><div class="fl"><label>Phone / WhatsApp *</label><input type="tel" id="fa-phone" placeholder="+880 ..."/></div><div class="fl"><label>District</label><select id="fa-district"><option value="">Select</option><option>Dhaka</option><option>Gazipur</option><option>Narayanganj</option><option>Chattogram</option><option>Mymensingh</option><option>Other</option></select></div></div>
            <div class="frow full"><div class="fl"><label>Full factory address</label><input type="text" id="fa-address" placeholder="Full address"/></div></div>
            <div class="frow"><div class="fl"><label>BGMEA / BKMEA reg. no.</label><input type="text" id="fa-reg" placeholder="e.g. BGMEA-2024-04521"/></div><div class="fl"><label>Factory type</label><select id="fa-type"><option value="">Select</option><option>Knit / Jersey</option><option>Woven</option><option>Denim</option><option>Outerwear</option><option>Mixed</option></select></div></div>
            <div class="frow"><div class="fl"><label>Monthly capacity (pcs)</label><input type="text" id="fa-capacity" placeholder="e.g. 80,000"/></div><div class="fl"><label>Available capacity now</label><input type="text" id="fa-available" placeholder="e.g. 25,000 pcs"/></div></div>
            <div class="frow"><div class="fl"><label>Worker count</label><input type="number" id="fa-workers" placeholder="e.g. 520"/></div><div class="fl"><label>Current utilization %</label><input type="number" id="fa-utilization" placeholder="e.g. 70" min="0" max="100"/></div></div>
