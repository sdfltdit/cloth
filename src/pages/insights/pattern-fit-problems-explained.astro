---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Pattern & Fit Problems Explained: Grading & Tolerance";
const pageDescription = "Why a perfect sample doesn't guarantee a perfect bulk fit, what grading and tolerance actually mean, and what each sample type (proto, fit, PP) is really for.";
const dateModified = new Date().toISOString().split("T")[0];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": pageTitle,
    "description": pageDescription,
    "dateModified": dateModified,
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" },
    "url": "https://sdfltd.com/insights/pattern-fit-problems-explained/",
    "mainEntityOfPage": "https://sdfltd.com/insights/pattern-fit-problems-explained/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Why does the same size fit differently across two brands?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because size labels (S, M, L) aren't standardized across the industry — they're set by each brand's own size chart and block pattern. Comparing your spec sheet to your factory's block, rather than assuming a shared universal standard, is the only reliable check."
        }
      },
      {
        "@type": "Question",
        "name": "What's a reasonable number of fit-sample revision rounds?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "One to three rounds is typical for a new style. If it's taking more than that, the issue is usually a spec sheet that isn't precise enough at the measurement points that matter most for that garment's fit."
        }
      },
      {
        "@type": "Question",
        "name": "Should I request a PP sample even for a simple, previously-made style?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes if it's using a new fabric lot, even on a repeat style. Fabric behavior can shift between batches enough to affect final fit, which is exactly what the PP sample stage is designed to catch before bulk cutting begins."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema} dateModified={dateModified}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Pattern &amp; Fit Problems Explained</span>
      </p>
    </nav>

    <article style="max-width: 800px; margin: 0 auto;">

      <header style="max-width: 760px; margin-left: auto; margin-right: auto; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Production Guide · Pattern &amp; Fit</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Pattern &amp; Fit Problems Explained: Grading, Tolerance, and Sample Types
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          A sample is hand-made by your most experienced pattern maker; bulk production scales the same pattern across many operators and machines, which is why small fit deviations can appear at bulk even when the sample was perfect. Grading (scaling the pattern across sizes) and an agreed tolerance (typically ±0.5-1cm per measurement point) are what keep that deviation controlled and predictable.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Why a Perfect-Fitting Sample Doesn't Guarantee a Perfect Bulk Fit</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">A sample is typically cut and sewn by a factory's most experienced pattern maker and sample machinist, by hand, one piece at a time. Bulk production uses the same pattern, but multiplied across many cutters, operators, and machines, at speed — and small, consistent deviations become far more likely to show up at that scale.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">This isn't a sign of a corner being cut. It's simply a different production process, which is exactly why grading and mid-production fit checks exist as a separate, deliberate step rather than an afterthought.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">What Grading Actually Does</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Grading takes the base pattern (usually a middle size like M) and mathematically scales it up and down to produce every other size in your size range, following a grade rule that defines exactly how many centimeters or inches to add or remove at each measurement point per size step.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">A poorly built grade rule is one of the most common causes of a real fit complaint: a brand's small and extra-large sizes fitting noticeably differently in proportion than the middle sizes, even though every size passed the same production process.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Tolerance: The Number Every Buyer Should Ask About</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">No two garments, even from the same pattern and fabric, will measure exactly identical — a small amount of variance is unavoidable in cutting, sewing, and pressing. This acceptable range is called tolerance, usually expressed in centimeters or fractions of an inch per measurement point.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">A typical tolerance for most garment measurements is around ±0.5-1cm, tighter for structured or fitted garments and slightly looser for casual knitwear. Getting this number agreed and written down before production, not discovered during a dispute afterward, is what actually prevents a fit disagreement from becoming a rejected shipment.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Fit Sample vs Proto Sample vs PP Sample — What Each One Is Actually For</h2>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid #333;">
            <th style="text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: #fff; font-weight: 400;">Sample Type</th>
            <th style="text-align: left; padding: 0.75rem 1rem; color: #fff; font-weight: 400;">Purpose</th>
            <th style="text-align: left; padding: 0.75rem 0 0.75rem 1rem; color: #fff; font-weight: 400;">What to Check</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Proto sample</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">First physical version of the design</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Overall silhouette and construction feasibility, not exact fit</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Fit sample</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Dedicated fit-check round, sometimes on a fit model</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Precise measurements at every point against your spec sheet</td>
          </tr>
          <tr>
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">PP (Pre-Production) sample</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Final approval sample using actual bulk fabric and trims</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Confirms fit holds using real production materials, not sample-only fabric</td>
          </tr>
        </tbody>
      </table>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Approving a fit sample made from a different fabric batch than what bulk will actually use is a common, avoidable mistake — fabric behavior can shift between batches, which is precisely why the PP sample stage exists as a final, fabric-accurate check.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Pattern & Fit FAQ</h2>
      <div class="faq-accordion2">
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Why does the same size fit differently across two brands?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Because size labels (S, M, L) aren't standardized across the industry — they're set by each brand's own size chart and block pattern. Comparing your spec sheet to your factory's block, rather than assuming a shared universal standard, is the only reliable check.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            What's a reasonable number of fit-sample revision rounds?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>One to three rounds is typical for a new style. If it's taking more than that, the issue is usually a spec sheet that isn't precise enough at the measurement points that matter most for that garment's fit.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Should I request a PP sample even for a simple, previously-made style?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Yes if it's using a new fabric lot, even on a repeat style. Fabric behavior can shift between batches enough to affect final fit, which is exactly what the PP sample stage is designed to catch before bulk cutting begins.</p>
          </div>
        </div>
      </div>


      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Want your fit checked against a written tolerance at every sample stage, not just approved by eye? SDF Clothing runs fit-sample and PP-sample checks against your exact spec sheet.
        </p>
        <a href="/pattern-making-service" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Fit &amp; Grading ›
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Fit issues often trace back to the fabric itself shifting between batches. See <a href="/insights/shade-variation-explained" style="color: #e00; text-decoration: none;">Shade Variation Explained</a> for a related batch-to-batch consistency issue.
      </p>


    </article>

  </div>


    <style>
      .faq-item2 { border-bottom: 1px solid #1a1a1a; }
      .faq-item2:last-child { border-bottom: none; }
      .faq-question2 { width: 100%; background: none; border: none; color: #fff; text-align: left; cursor: pointer; padding: 1.1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.95rem; font-weight: 400; font-family: inherit; min-height: 44px; transition: color 0.2s; }
      .faq-question2:hover { color: #e00; }
      .faq-icon2 { flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: #e00; transition: transform 0.2s; }
      .faq-icon2--open { transform: rotate(45deg); }
      .faq-answer2 { display: none; padding-bottom: 1.1rem; }
      .faq-answer2--visible { display: block; }
      .faq-answer2 p { color: #aaa; line-height: 1.8; font-size: 0.92rem; margin: 0; }
    </style>
    <script is:inline>
      document.querySelectorAll('.faq-question2').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon2');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isExpanded));
          answer.classList.toggle('faq-answer2--visible');
          icon.classList.toggle('faq-icon2--open');
        });
      });
    </script>

</BaseLayout>
