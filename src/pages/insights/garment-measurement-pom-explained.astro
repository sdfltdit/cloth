---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Garment Measurement (POM) Explained: Points, Tolerance, and Disputes";
const pageDescription = "What points of measure (POM) actually are, typical tolerance ranges by measurement point, and why two garments from the same order rarely measure identical.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": pageTitle,
    "description": pageDescription,
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" },
    "url": "https://sdfltd.com/insights/garment-measurement-pom-explained/",
    "mainEntityOfPage": "https://sdfltd.com/insights/garment-measurement-pom-explained/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who decides what tolerance is acceptable?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It should be agreed between buyer and factory before production and written into the tech pack, not left to interpretation after goods are made. Most factories have a default tolerance standard, but a specific brand can request tighter tolerance on critical POMs."
        }
      },
      {
        "@type": "Question",
        "name": "Is a garment outside tolerance always rejected?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not automatically — a single POM slightly outside tolerance on a small percentage of pieces might be accepted case by case, but multiple POMs consistently outside tolerance across many pieces usually signals a real fit or grading problem worth addressing."
        }
      },
      {
        "@type": "Question",
        "name": "How many POMs should a spec sheet include?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Enough to cover every dimension that matters to how the garment fits and looks — typically 10-20 points for a basic garment like a t-shirt, more for structured or multi-panel styles like jackets."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Garment Measurement (POM) Explained</span>
      </p>
    </nav>

    <article>

      <header style="max-width: 760px; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Production Guide · Measurement</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Garment Measurement (POM) Explained: Points, Tolerance, and Disputes
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          POM (points of measure) are the specific, named spots on a garment where measurement is checked against a target number and an allowed tolerance, typically ±0.5-1cm per point. Small variance between pieces from the same order is normal production reality, not a quality failure, as long as every point stays within the agreed tolerance written into the tech pack.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">What POM Actually Means</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">POM stands for points of measure — the specific, named spots on a garment where measurement is taken and checked, such as chest width, sleeve length, or hem width. A spec sheet lists a target number and an allowed tolerance for each POM, and that combination is what a QC inspector actually checks against, not a general impression of fit.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Without clearly defined POMs, "the fit is off" becomes a subjective argument. With them, it becomes a specific, measurable, resolvable question: which point, by how much, against what allowed tolerance.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Why Two Garments From the Same Order Measure Slightly Differently</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Fabric relaxes and stretches differently across a roll, cutting has small unavoidable variance, and sewing introduces its own minor shifts. None of this means quality has failed — it means production hasn't been measured against a written tolerance yet.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Tolerance is the agreed acceptable range around the target number for each POM, typically ±0.5-1cm for most measurement points on casual garments, tighter for structured or fitted styles. A garment measuring within tolerance at every POM passes, even if no single piece is mathematically identical to another.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Common POMs and Typical Tolerance</h2>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid #333;">
            <th style="text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: #fff; font-weight: 400;">Point of Measure</th>
            <th style="text-align: left; padding: 0.75rem 1rem; color: #fff; font-weight: 400;">What It Checks</th>
            <th style="text-align: left; padding: 0.75rem 0 0.75rem 1rem; color: #fff; font-weight: 400;">Typical Tolerance</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Chest width (1" below armhole)</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Overall body fit across the widest point</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">±0.5-1cm</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Body length (HPS to hem)</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Overall garment length</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">±1cm</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Sleeve length</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Arm coverage and proportion</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">±0.5cm</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Neck opening / collar width</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Fit around the neck, critical for comfort</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">±0.3-0.5cm</td>
          </tr>
          <tr>
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Hem width</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">How the garment sits at the bottom edge</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">±1cm</td>
          </tr>
        </tbody>
      </table>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">These are working ranges, not universal rules — tighter tolerance is normal for fitted or tailored garments, and looser tolerance is normal for oversized or casual streetwear styles where a small variance genuinely doesn't affect how the garment looks or feels.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">The Measurement Mistake That Causes Most Disputes</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Measuring a garment flat, unstretched, on a table with a ruler that isn't perfectly straight, or measuring at a slightly different point than the spec sheet defines, produces numbers that look like a defect but are actually a measurement-technique inconsistency between buyer and factory.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">The fix is agreeing on measurement method up front — flat measurement, unstretched, using the exact POM diagram in the tech pack — so both sides are measuring the same thing, the same way, before any dispute happens.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Garment Measurement FAQ</h2>
      <div class="faq-accordion2">
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Who decides what tolerance is acceptable?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>It should be agreed between buyer and factory before production and written into the tech pack, not left to interpretation after goods are made. Most factories have a default tolerance standard, but a specific brand can request tighter tolerance on critical POMs.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Is a garment outside tolerance always rejected?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Not automatically — a single POM slightly outside tolerance on a small percentage of pieces might be accepted case by case, but multiple POMs consistently outside tolerance across many pieces usually signals a real fit or grading problem worth addressing.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            How many POMs should a spec sheet include?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Enough to cover every dimension that matters to how the garment fits and looks — typically 10-20 points for a basic garment like a t-shirt, more for structured or multi-panel styles like jackets.</p>
          </div>
        </div>
      </div>


      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Want every POM measured against a written tolerance, not just eyeballed for fit? SDF Clothing grades and measures every size against your exact spec sheet.
        </p>
        <a href="/grading-service" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Grading &amp; Measurement ›
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Grading determines how these measurements scale across sizes. <a href="/insights/pattern-fit-problems-explained" style="color: #e00; text-decoration: none;">Read Pattern &amp; Fit Problems Explained</a> for the full picture.
      </p>


    </article>

  </div>


    <style>
      .faq-item2 { border-bottom: 1px solid #1a1a1a; }
      .faq-item2:last-child { border-bottom: none; }
      .faq-question2 { width: 100%; background: none; border: none; color: #fff; text-align: left; cursor: pointer; padding: 1.1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.95rem; font-weight: 400; font-family: inherit; min-height: 44px; transition: color 0.2s; }
      .faq-question2:hover { color: #e00; }
      .faq-icon2 { flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: #e00; transition: transform 0.2s; }
      .faq-icon2--open { transform: rotate(45deg); }
      .faq-answer2 { display: none; padding-bottom: 1.1rem; }
      .faq-answer2--visible { display: block; }
      .faq-answer2 p { color: #aaa; line-height: 1.8; font-size: 0.92rem; margin: 0; }
    </style>
    <script is:inline>
      document.querySelectorAll('.faq-question2').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon2');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isExpanded));
          answer.classList.toggle('faq-answer2--visible');
          icon.classList.toggle('faq-icon2--open');
        });
      });
    </script>

</BaseLayout>
