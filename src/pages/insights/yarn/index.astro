---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Yarn Guide: Types, Count, Testing & Sourcing";
const pageDescription = "Complete yarn guide for fashion brands and fabric buyers — fiber types, spinning methods, count systems, quality testing, and sustainable sourcing.";

const clusterPages = [
  {
    slug: "/insights/yarn/types-and-spinning-methods/",
    title: "Types of Yarn & Spinning Methods",
    description: "Natural, man-made, and blended fibers; staple vs filament yarn; and how Ring, Rotor, Air-jet, and Vortex spinning each shape the final yarn.",
  },
  {
    slug: "/insights/yarn/count-twist-and-structure/",
    title: "Yarn Count, Twist & Structure",
    description: "Ne, Nm, Tex, and Denier numbering systems explained, plus twist direction, twist level, and single vs plied vs cabled construction.",
  },
  {
    slug: "/insights/yarn/quality-testing-and-defects/",
    title: "Yarn Quality Testing & Defects",
    description: "Evenness, imperfection index, hairiness, and tenacity testing with Uster benchmarks, plus the most common yarn defects and their causes.",
  },
  {
    slug: "/insights/yarn/sustainability-and-certification/",
    title: "Sustainable Yarn & Certification",
    description: "Organic cotton (GOTS), recycled fiber (GRS/RCS), and BCI cotton compared — what each certification actually verifies.",
  },
  {
    slug: "/insights/yarn/buyer-guidelines/",
    title: "Yarn Buyer Guidelines",
    description: "How to write a yarn spec sheet, what MOQ and lead times to expect, and how the yarn dip approval process works before bulk production.",
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://sdfltd.com/insights/" },
          { "@type": "ListItem", "position": 3, "name": "Yarn Guide", "item": Astro.url.href }
        ]
      }
    },
    {
      "@type": "ItemList",
      "name": "Yarn Guide — Topic Cluster",
      "itemListElement": clusterPages.map((page, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": new URL(page.slug, Astro.site).toString(),
        "name": page.title
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is yarn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yarn is a continuous strand of fiber, either staple (short, twisted together) or filament (long, continuous), produced by spinning or extrusion and used to knit or weave fabric. It sits between raw fiber and finished fabric in the textile production chain, and nearly every physical property of a fabric — strength, softness, drape, durability — traces back to a decision made at the yarn stage."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between staple yarn and filament yarn?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Staple yarn is spun from short fibers, like raw cotton or wool, that are twisted together to form a continuous strand — the twist is what holds it together. Filament yarn is made from one or more continuous strands, as produced naturally by silk or synthetically by extruding polyester or nylon, and does not require the same twisting to hold together, though filament yarns are often twisted or textured for specific effects."
          }
        },
        {
          "@type": "Question",
          "name": "Why does yarn quality matter to a fabric buyer who never touches spinning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every downstream fabric property is inherited from the yarn: an uneven yarn produces visible streaks or bars in finished fabric, a low-tenacity yarn causes yarn breaks during knitting or weaving that show up as production delays, and hairiness affects pilling resistance. A fabric buyer who can read a yarn spec sheet can catch quality risks before they become a finished-garment defect."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/insights/">Insights</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Yarn Guide</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Yarn Guide • Complete Reference</div>
      <h1 class="hero__title">Yarn: The Complete Guide for Fashion Brands and Fabric Buyers</h1>
      <p class="hero__description">
        Everything from fiber to finished spool — yarn types, spinning methods, count systems, quality testing, and sustainable sourcing — explained for buyers who need to specify yarn correctly without becoming a spinning engineer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Overview</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What Is Yarn, and Why It's the Root of Every Fabric Decision</h2>
      </div>
      <div class="section__text">
        <p>Yarn is a continuous strand of fiber — either staple fiber (short lengths, like raw cotton, twisted together to hold their shape) or filament fiber (long, continuous strands, like silk or extruded polyester) — spun or processed into a form that can be knitted or woven into fabric. It sits at the middle of the textile chain: fiber becomes yarn, yarn becomes fabric, fabric becomes garment.</p>

        <p>Most fabric problems a brand encounters — pilling, uneven dye uptake, unexpected stiffness, a fabric that doesn't drape the way a sample did — trace back to a yarn-level decision, not a fabric-level one. The fiber blend, the spinning method, the yarn count, and the twist level are all fixed before the fabric is ever knitted or woven. This makes yarn the highest-leverage, least-visible decision in a garment's supply chain: brands rarely specify it directly, but everything downstream depends on it.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Decision Framework</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How to Think About a Yarn Spec</h2>
      </div>
      <div class="section__text">
        <p>A complete yarn specification answers four questions, roughly in this order of impact.</p>
      </div>
      <div class="decision-steps">
        <div class="decision-step">
          <span class="decision-step__number">1</span>
          <div class="decision-step__content">
            <h3 class="decision-step__title">What fiber, and what spinning method?</h3>
            <p class="decision-step__text">Fiber choice (cotton, polyester, a blend) sets the baseline hand-feel and performance. Spinning method (Ring, Rotor, Air-jet, Vortex) then determines how that fiber becomes yarn — and changes strength, softness, and cost independent of the fiber itself. See the <a href="/insights/yarn/types-and-spinning-methods/">Types & Spinning Methods guide</a>.</p>
          </div>
        </div>
        <div class="decision-step">
          <span class="decision-step__number">2</span>
          <div class="decision-step__content">
            <h3 class="decision-step__title">What count, and what twist?</h3>
            <p class="decision-step__text">Count determines yarn fineness — directly controlling fabric weight and drape. Twist level determines yarn strength and surface texture. Get these wrong and the fabric that comes off the knitting machine won't match the sample, even with the identical fiber and spinning method. See the <a href="/insights/yarn/count-twist-and-structure/">Count, Twist & Structure guide</a>.</p>
          </div>
        </div>
        <div class="decision-step">
          <span class="decision-step__number">3</span>
          <div class="decision-step__content">
            <h3 class="decision-step__title">What quality tier does the end use require?</h3>
            <p class="decision-step__text">A fine-gauge jersey knit needs tighter evenness and imperfection tolerances than a heavy canvas. Quality requirements should be set by end use, not by default to "the best available" — over-specifying quality raises cost without improving the finished product. See the <a href="/insights/yarn/quality-testing-and-defects/">Quality Testing & Defects guide</a>.</p>
          </div>
        </div>
        <div class="decision-step">
          <span class="decision-step__number">4</span>
          <div class="decision-step__content">
            <h3 class="decision-step__title">Does the yarn need a sustainability credential?</h3>
            <p class="decision-step__text">Organic, recycled, and BCI cotton all carry different certification chains, cost premiums, and verification requirements. This is a sourcing decision layered on top of the first three, not a replacement for them. See the <a href="/insights/yarn/sustainability-and-certification/">Sustainability & Certification guide</a>.</p>
          </div>
        </div>
      </div>
      <div class="section__text" style="margin-top: 2rem;">
        <p>Once these four are decided, the practical next step is writing them into a spec sheet and requesting a yarn dip for approval — see the <a href="/insights/yarn/buyer-guidelines/">Buyer Guidelines guide</a> for that process.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Explore the Cluster</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Everything You Need to Know About Yarn</h2>
      </div>
      <div class="cluster-grid">
        {clusterPages.map((page) => (
          <a href={page.slug} class="cluster-card">
            <h3 class="cluster-card__title">{page.title}</h3>
            <p class="cluster-card__text">{page.description}</p>
            <span class="cluster-card__link">Read the guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Sourcing Yarn for Your Next Order?</h2>
      <p class="section__text">SDF Clothing sources yarn through our own mill relationships — cotton, polyester, recycled, and blended, spec'd to your fabric's intended hand feel rather than defaulting to whatever's in stock. See our dedicated <a href="/yarn-sourcing">Yarn Sourcing page</a> for MOQ, pricing, and certifications.</p>
      <div class="section__ctas">
        <a href="/contact/" class="section__cta section__cta--primary">Get a Free Yarn Consultation</a>
        <a href="/yarn-sourcing" class="section__cta section__cta--secondary">See Yarn Sourcing & Pricing →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    text-align: center;
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    max-width: 900px;
  }

  .section__text a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .section__text a:hover {
    text-decoration: underline;
  }

  .section--cta .section__text {
    margin: 0 auto var(--spacing-md);
  }

  .decision-steps {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .decision-step {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-start;
  }

  .decision-step__number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: 1.125rem;
  }

  .decision-step__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .decision-step__text {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .decision-step__text a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .decision-step__text a:hover {
    text-decoration: underline;
  }

  .cluster-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .cluster-card {
    display: block;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-md);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .cluster-card:hover,
  .cluster-card:focus-visible {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .cluster-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .cluster-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .cluster-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--spacing-sm);
  }

  .cluster-card__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .cluster-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
