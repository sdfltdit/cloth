---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Yarn FAQs: Common Questions Answered";
const pageDescription = "Answers to the most common yarn questions — count systems, spinning methods, quality testing, and certification — from a Bangladesh apparel manufacturer.";

const faqGroups = [
  {
    category: "Types & Spinning Methods",
    sourceLink: "/insights/yarn/types-and-spinning-methods/",
    sourceLabel: "Types & Spinning Methods guide",
    items: [
      { q: "What is the difference between staple and filament yarn?", a: "Staple yarn is spun from short fiber lengths twisted together, like cotton or wool. Filament yarn uses one or more continuous strands, like silk or extruded polyester, and doesn't rely on twist to stay intact." },
      { q: "What spinning method is used for denim yarn?", a: "Over 95% of denim yarn is rotor (open-end) spun. Denim's characteristic bulky texture actually benefits from rotor spinning's less uniform structure, and its speed and cost suit denim's typical order volumes." },
      { q: "Why can't air-jet spinning be used for 100% cotton yarn?", a: "Air-jet spinning binds yarn using high-velocity air rather than mechanical twisting, which needs strong fiber-to-fiber cohesion. Cotton's relatively short, low-cohesion fibers struggle under this method, so air-jet is more common for polyester and blends." },
      { q: "Is ring-spun yarn always better than rotor-spun yarn?", a: "Not for every application. Ring-spun is the quality benchmark for fine, soft yarns, but rotor-spun's bulkier texture is a desired trait for denim, not a defect — the right method depends on end use." },
      { q: "Why do brands use blended yarn instead of 100% one fiber?", a: "Blending combines properties neither fiber has alone — a 95/5 cotton-elastane blend adds stretch without losing cotton's hand feel. Even small ratio shifts, like 95/5 vs 90/10, meaningfully change stretch recovery and shape retention." },
    ],
  },
  {
    category: "Count, Twist & Structure",
    sourceLink: "/insights/yarn/count-twist-and-structure/",
    sourceLabel: "Count, Twist & Structure guide",
    items: [
      { q: "What does 'Ne 30/1' mean on a yarn spec?", a: "Ne 30/1 means English cotton count 30 (fine), single-ply. A '30/2' is the same fineness but two strands twisted together, roughly doubling thickness and adding strength." },
      { q: "Is a higher yarn count always better?", a: "No — count should match the intended fabric weight, not be maximized. Specifying an unnecessarily fine count for a heavier fabric adds cost and can reduce durability." },
      { q: "What is the difference between S-twist and Z-twist yarn?", a: "They describe the direction fiber spirals during twisting. Direction alone doesn't change strength, but combining directions in warp/weft or plied yarns controls fabric stability and texture." },
      { q: "How does yarn count affect fabric GSM?", a: "Finer yarn produces lighter fabric at a given stitch density; a fine Ne 30/1 jersey knit runs roughly 140-160 GSM versus 180-200+ GSM for a coarser Ne 20/1 in the same structure. GSM targets should specify the intended count and density, not be left open-ended." },
    ],
  },
  {
    category: "Quality & Testing",
    sourceLink: "/insights/yarn/quality-testing-and-defects/",
    sourceLabel: "Quality Testing & Defects guide",
    items: [
      { q: "What is Uster Statistics?", a: "A globally referenced benchmarking database ranking yarn test results into percentile tiers for a given fiber, count, and spinning method. Uster 5% means top-tier quality; Uster 50% is the statistical average." },
      { q: "What causes barré in knitted fabric?", a: "Barré is caused by knitting from yarn lots with slightly different count, twist, or dye affinity despite matching the same nominal spec, producing visible streaks — a lot-management issue as much as a spinning one." },
      { q: "What is a yarn imperfection index?", a: "It counts thin places, thick places, and neps per kilometer of yarn. Thin places are weak points prone to breaking; thick places and neps tend to show up as visible dots in finished fabric." },
      { q: "How much yarn count variation is acceptable?", a: "A commonly used threshold is ±3% deviation from the ordered count. Beyond that range, fabric weight, dye uptake, and machine tension behavior start to shift noticeably during knitting or weaving." },
    ],
  },
  {
    category: "Sustainability & Certification",
    sourceLink: "/insights/yarn/sustainability-and-certification/",
    sourceLabel: "Sustainability & Certification guide",
    items: [
      { q: "What is the difference between GOTS and GRS for yarn?", a: "GOTS certifies organic fiber content and audits the full supply chain's chemical, water, and labor practices. GRS certifies recycled fiber content with chain-of-custody tracking. A yarn can carry either, both, or neither." },
      { q: "What changed with Better Cotton certification in 2026?", a: "Better Cotton moved to genuine third-party certification (ISO 17065 audited) starting January 2025. As of May 2026, only Physical Better Cotton — actually traceable through the supply chain — qualifies for the on-product label; Mass Balance-sourced cotton no longer does." },
      { q: "Can a recycled polyester yarn be GOTS certified?", a: "No. GOTS applies to organic natural fibers only. A recycled polyester yarn would instead be certified under GRS or RCS, the appropriate standards for recycled content." },
      { q: "Is recycled cotton yarn as strong as virgin cotton yarn?", a: "No, not at high recycled content — mechanically recycled cotton has shorter fibers, and tenacity typically drops 7-9% per 10% increase in recycled content. Recycled polyester, being chemically reprocessed rather than shredded, holds strength much closer to virgin material." },
    ],
  },
  {
    category: "Buyer Process",
    sourceLink: "/insights/yarn/buyer-guidelines/",
    sourceLabel: "Buyer Guidelines guide",
    items: [
      { q: "What should be included in a yarn spec sheet?", a: "Exact fiber content, yarn count with the numbering system stated explicitly, spinning method, twist level and direction, a physical color standard, a quality tier reference, and any certification requirements." },
      { q: "How long does yarn dip approval take?", a: "A yarn dip needs a minimum of two weeks to prepare, longer than a standard fabric lab dip. The full cycle from first submission through approval commonly takes a minimum of 30 days." },
      { q: "What is a yarn dip and how is it graded?", a: "A yarn dip is a dyed yarn sample submitted for color approval before bulk dyeing, graded A through D against the color standard — only an A or B grade typically clears for bulk production." },
      { q: "Why do yarn orders get rejected most often?", a: "Ambiguous count notation — a number without stating Ne, Nm, Tex, or Denier — is the most common cause. Count drift beyond the typical ±3% tolerance is the next most common, especially on reorders assumed without re-verification." },
    ],
  },
];

const allFaqSchemaItems = faqGroups.flatMap((group) =>
  group.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://sdfltd.com/insights/" },
          { "@type": "ListItem", "position": 3, "name": "Yarn Guide", "item": "https://sdfltd.com/insights/yarn/" },
          { "@type": "ListItem", "position": 4, "name": "FAQ", "item": Astro.url.href }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": allFaqSchemaItems
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/insights/">Insights</a></li>
        <li class="breadcrumb__item"><a href="/insights/yarn/">Yarn Guide</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">FAQ</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Yarn Guide • FAQ</div>
      <h1 class="hero__title">Yarn FAQs</h1>
      <p class="hero__description">
        Quick answers to the questions brands and fabric buyers ask most often about yarn. Each answer links to a full guide with more detail.
      </p>
    </div>
  </section>

  {faqGroups.map((group, groupIndex) => (
    <section class={`section ${groupIndex % 2 === 1 ? "section--alt" : ""}`}>
      <div class="section__container">
        <div class="section__header">
          <span class="section__label">{group.category}</span>
          <div class="accent-line"></div>
          <h2 class="section__title">{group.category} FAQs</h2>
        </div>
        <div class="faq">
          {group.items.map((item) => (
            <div class="faq__item">
              <h3 class="faq__question">{item.q}</h3>
              <p class="faq__answer">{item.a}</p>
            </div>
          ))}
        </div>
        <a href={group.sourceLink} class="section__more-link">Read the full {group.sourceLabel} →</a>
      </div>
    </section>
  ))}

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Still Have Questions About Yarn for Your Product?</h2>
      <p class="section__text">Our technical team can review your target fabric and tell you exactly what yarn spec you need.</p>
      <div class="section__ctas">
        <a href="/contact/" class="section__cta section__cta--primary">Ask Our Team</a>
        <a href="/insights/yarn/" class="section__cta section__cta--secondary">Back to Yarn Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-lg) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    padding: var(--spacing-xl) 0;
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .faq {
    margin-top: var(--spacing-sm);
  }

  .faq__item {
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .faq__question {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .faq__answer {
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: 1rem;
  }

  .section__more-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .section__more-link:hover {
    text-decoration: underline;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
