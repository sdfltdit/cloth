---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Yarn Buyer Guidelines & Spec Sheet Guide";
const pageDescription = "How to write a yarn spec sheet, what MOQ and lead times to expect, and how the yarn dip approval process works before bulk production.";

const specFields = [
  { field: "Fiber content", text: "Exact fiber type and blend ratio (e.g., '60% cotton, 40% polyester'), since even a small blend shift changes hand feel, dye uptake, and durability." },
  { field: "Yarn count & system", text: "The count number and which system it's in — Ne, Nm, Tex, or Denier — plus ply (e.g., 'Ne 30/1'). State the system explicitly; don't assume the mill will interpret an unlabeled number correctly." },
  { field: "Spinning method", text: "Ring, rotor, air-jet, or vortex. If unspecified, the mill will default to whatever is standard for that count and fiber at their facility, which may not match your fabric's intended hand feel." },
  { field: "Twist level & direction", text: "Turns per inch or meter, and S or Z direction if it matters for your fabric structure. Leave this open only if hand feel is not a priority for the product." },
  { field: "Color standard", text: "A physical Pantone swatch or approved lab dip — never a screen color alone. This kicks off the yarn dip approval process covered below." },
  { field: "Quality tier", text: "Reference an Uster percentile tier (e.g., Uster 25%) if quality consistency matters for your price point, rather than leaving quality unspecified and hoping for the best." },
  { field: "Certification requirements", text: "GOTS, GRS, RCS, Better Cotton, or OEKO-TEX, if the yarn needs to support a sustainability or safety claim on the finished garment. Request certificate copies at this stage, not after bulk order." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Insights", "item": "https://sdfltd.com/insights/" },
          { "@type": "ListItem", "position": 3, "name": "Yarn Guide", "item": "https://sdfltd.com/insights/yarn/" },
          { "@type": "ListItem", "position": 4, "name": "Buyer Guidelines", "item": Astro.url.href }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should be included in a yarn spec sheet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A complete yarn spec sheet includes exact fiber content and blend ratio, yarn count with the numbering system stated explicitly (Ne, Nm, Tex, or Denier), spinning method, twist level and direction, a physical color standard rather than a screen color, a quality tier reference such as an Uster percentile, and any certification requirements like GOTS or GRS."
          }
        },
        {
          "@type": "Question",
          "name": "How long does yarn dip approval take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A yarn dip typically requires a minimum of two weeks to prepare, longer than the roughly one week needed for a standard fabric lab dip, because yarn dyeing is a lengthier process to execute repeatedly. Counting from first submission through approval, including likely revision rounds, the full yarn dip approval cycle commonly takes a minimum of 30 days."
          }
        },
        {
          "@type": "Question",
          "name": "What is a yarn dip and how is it graded?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A yarn dip is a dyed yarn sample submitted for color approval before bulk dyeing, similar to a fabric lab dip but done specifically in yarn form for yarn-dyed fabric. Submissions are typically graded on an A, B, C, D scale reflecting how closely the dip matches the approved color standard, with only a passing grade cleared for bulk dyeing."
          }
        },
        {
          "@type": "Question",
          "name": "Why do yarn orders get rejected most often?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The most common cause is ambiguous count notation — a bare number without stating whether it's Ne, Nm, Tex, or Denier — which can lead a mill to produce yarn at the wrong fineness entirely. Count drift beyond the typical ±3% buyer QC tolerance is the next most common technical rejection, especially on reorders where a mill assumes the spec without re-verifying it."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/insights/">Insights</a></li>
        <li class="breadcrumb__item"><a href="/insights/yarn/">Yarn Guide</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Buyer Guidelines</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Yarn Guide • Buyer Guidelines</div>
      <h1 class="hero__title">Yarn Buyer Guidelines and Spec Sheet Guide</h1>
      <p class="hero__description">
        A complete yarn spec sheet at the start avoids the most common cause of delay in yarn sourcing: back-and-forth clarification after a mill has already started work on an ambiguous spec.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Spec Sheet</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What to Include in Your Yarn Spec Sheet</h2>
      </div>
      <div class="spec-grid">
        {specFields.map((spec) => (
          <div class="spec-card">
            <h3 class="spec-card__title">{spec.field}</h3>
            <p class="spec-card__text">{spec.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Common Rejections</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Why Yarn Orders Get Sent Back</h2>
      </div>
      <div class="section__text">
        <p>A handful of issues cause most first-round yarn rejections, and knowing them in advance saves a full order cycle. Ambiguous count notation — a number without the system stated (Ne, Nm, Tex, or Denier) — is the most common, since a mill defaulting to the wrong system produces yarn at a completely different fineness than intended. Count drift beyond the roughly ±3% tolerance most buyer QC protocols use is the second most common technical rejection, particularly on reorders where a mill assumes "same as last time" without re-verifying against the original spec.</p>

        <p>For yarn-dyed fabric, submitting a screen color instead of a physical Pantone standard for yarn dip approval is a frequent cause of delay rather than outright rejection — it typically doesn't fail a test, but it extends the dip approval cycle through extra correction rounds since the mill has nothing precise to match against. Building an explicit numbering system, a stated tolerance, and a physical color standard into the spec sheet from the start — rather than discovering the gap at yarn dip review — is what separates a one-round approval from a three-round one. See the <a href="/insights/yarn/quality-testing-and-defects/">Quality Testing & Defects guide</a> for how count and other specs are actually verified.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Yarn Dip Process</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How Yarn Dip Color Approval Works</h2>
      </div>
      <div class="section__text">
        <p>If your fabric is yarn-dyed (the yarn is dyed before knitting or weaving, as opposed to piece-dyed fabric), color approval happens through a yarn dip rather than the more familiar fabric lab dip. The process: the mill matches your color standard — ideally a physical Pantone swatch or an approved reference sample — in a light box under a defined light source, submits a first recipe attempt, and the buyer reviews it under the same light source and either approves or requests a correction.</p>

        <p>Submissions are typically graded A through D against the color standard. Only an A or B grade is generally cleared for bulk dyeing; anything lower goes back for another recipe correction. Because yarn dyeing takes longer to execute and re-execute than fabric dyeing, budget more time for this step than fabric color approval: a yarn dip typically needs a minimum of two weeks to prepare, and the full cycle from first submission through final approval — including at least one likely revision round — commonly runs a minimum of 30 days. Brands that treat yarn dip approval as a quick formality, on the same timeline as a fabric lab dip, are the ones most likely to see it become the critical-path bottleneck in their production schedule.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">MOQ & Lead Time</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What to Expect for MOQ and Lead Time</h2>
      </div>
      <div class="section__text">
        <p>Yarn MOQ and lead time vary widely by how customized the yarn is. A standard, off-the-shelf count and fiber blend a mill already produces regularly can often be sourced at lower MOQ and shorter lead time than a fully custom construction. Fully custom yarn — a unique blend ratio, a specific count not in standard production, or an exclusive dye formulation — typically requires a longer development runway, since the mill has to set up and validate a process it doesn't already run, on top of the yarn dip approval cycle covered above.</p>

        <p>Confirm both MOQ per color and total order MOQ separately when sourcing — these are frequently different numbers, and a mill quoting "500kg MOQ" without specifying per-color or total can lead to a costly misunderstanding once multiple colorways are involved.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Common Mistakes</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Common Yarn Sourcing Mistakes</h2>
      </div>
      <div class="section__text">
        <p>Leaving the numbering system unstated is the most common yarn spec error — a bare number like "30" is meaningless without knowing whether it's Ne, Nm, or Tex, and each interpretation produces a dramatically different yarn. Submitting a screen color instead of a physical standard for yarn dip approval is the second most common, since monitor calibration makes on-screen color unreliable for a dyeing recipe. Underbudgeting time for yarn dip approval specifically — treating it like the faster fabric lab dip process — is the third, and the one most likely to blow a production timeline if a revision round is needed.</p>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Source Yarn for Your Next Order?</h2>
      <p class="section__text">Send us your target fabric spec and our technical team will help you build a complete yarn spec sheet before requesting your first yarn dip.</p>
      <div class="section__ctas">
        <a href="/contact/" class="section__cta section__cta--primary">Get a Free Yarn Consultation</a>
        <a href="/insights/yarn/faq/" class="section__cta section__cta--secondary">See Yarn FAQs →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .spec-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-md);
  }

  .spec-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .spec-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .spec-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
