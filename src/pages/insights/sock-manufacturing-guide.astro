          }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Sock Manufacturing Guide",
            "item": canonicalUrl.href
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "Sock Manufacturing Process",
      "description": "Complete guide to manufacturing socks from yarn to finished product",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Yarn Selection and Preparation",
          "text": "Select appropriate yarn materials (cotton, bamboo, merino, synthetic) and prepare for knitting"
        },
        {
          "@type": "HowToStep",
          "name": "Knitting",
          "text": "Knit sock shape on circular knitting machines with cuff, leg, heel, and toe formation"
        },
        {
          "@type": "HowToStep",
          "name": "Linking",
          "text": "Close toe seam using linking machines for seamless finish"
        },
        {
          "@type": "HowToStep",
          "name": "Washing and Finishing",
          "text": "Wash socks to remove knitting oils and achieve final hand feel"
        },
        {
          "@type": "HowToStep",
