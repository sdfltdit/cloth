---
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../../data/schema';
export const prerender = true;

const pageTitle = "Sock Manufacturing Guide | Complete Process & Materials";
const pageDescription = "Complete guide to sock manufacturing: process, materials, production steps, quality control, and sourcing. Learn how socks are made from yarn.";
