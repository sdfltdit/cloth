---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Garment Finishing Explained: Compacting, Softening, and Shrinkage";
const pageDescription = "What finishing treatments actually do to fabric, how compacting controls shrinkage before it reaches the customer, and why handfeel is hard to specify in writing.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": pageTitle,
    "description": pageDescription,
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" },
    "url": "https://sdfltd.com/insights/garment-finishing-explained/",
    "mainEntityOfPage": "https://sdfltd.com/insights/garment-finishing-explained/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does finishing affect fabric color?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It can, subtly — some finishing chemicals and heat treatments slightly shift how dyed color appears. This is one reason color approval should happen on finished fabric, not on unfinished, undyed, or unprocessed swatches."
        }
      },
      {
        "@type": "Question",
        "name": "Why does a garment feel different after the first wash than in the store?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Home washing and drying continues some of the same processes finishing started — further relaxing fabric structure and softening handfeel. A well-finished garment changes only slightly after the first wash; a poorly finished one can change dramatically."
        }
      },
      {
        "@type": "Question",
        "name": "Is peach-skin finish the same as brushing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "They're related but distinct processes — brushing raises fine fibers to create a soft texture, and peach-skin finish typically goes further with an additional treatment for an even softer, suede-like surface. Ask your factory specifically which one they mean when either term comes up."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Garment Finishing Explained</span>
      </p>
    </nav>

    <article>

      <header style="max-width: 760px; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Production Guide · Finishing</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Garment Finishing Explained: Compacting, Softening, and Shrinkage
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          Finishing is the treatment applied to fabric after knitting and before shipping — softening, compacting, brushing — and it's why fabric off the machine feels different from the finished garment in your hands. Compacting specifically pre-shrinks fabric in the factory, typically reducing post-wash shrinkage from 5-8% down to 1-3%, and is worth confirming as standard on any order.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">What Finishing Actually Does to a Garment</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Finishing is the set of treatments applied to fabric or a finished garment after knitting or weaving and before it ships — softening, compacting, brushing, or chemical treatment — and it's the reason fabric off the knitting machine feels noticeably different from the same fabric in your hands as a finished product.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">This is also why a fabric swatch approved early in development can feel slightly different once it comes back as a finished garment. The swatch may not have gone through the same finishing process as the bulk fabric, especially if it was cut from an unfinished roll for a quick approval.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Compacting and Why It Controls Shrinkage</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Compacting is a mechanical process that pre-shrinks knit fabric before cutting, physically compressing the fabric structure so most of the shrinkage that would otherwise happen in the customer's washing machine happens in the factory instead, under control.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">A properly compacted cotton jersey typically shrinks only 1-3% after washing, compared to 5-8%+ for fabric that skipped compacting entirely. This is one of the highest-value, lowest-cost finishing steps available, and it's worth confirming directly whether your factory includes it as standard.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Softener and Handfeel</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Softener treatment is what gives finished fabric its handfeel — the difference between a stiff, papery feel straight off the loom and the soft drape customers expect from a t-shirt or hoodie. Different softener chemistries produce different results, from a natural cotton-like hand to a peached, brushed texture.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Handfeel is genuinely difficult to specify precisely in a written tech pack. The most reliable way to lock it in is approving a physical finished fabric swatch, then keeping that swatch as the reference standard for bulk approval, rather than relying on a written description alone.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Finishing FAQ</h2>
      <div class="faq-accordion2">
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Does finishing affect fabric color?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>It can, subtly — some finishing chemicals and heat treatments slightly shift how dyed color appears. This is one reason color approval should happen on finished fabric, not on unfinished, undyed, or unprocessed swatches.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Why does a garment feel different after the first wash than in the store?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Home washing and drying continues some of the same processes finishing started — further relaxing fabric structure and softening handfeel. A well-finished garment changes only slightly after the first wash; a poorly finished one can change dramatically.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Is peach-skin finish the same as brushing?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>They're related but distinct processes — brushing raises fine fibers to create a soft texture, and peach-skin finish typically goes further with an additional treatment for an even softer, suede-like surface. Ask your factory specifically which one they mean when either term comes up.</p>
          </div>
        </div>
      </div>


      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Want shrinkage controlled before your fabric ever reaches cutting? SDF Clothing compacts and finishes fabric to a documented standard before production.
        </p>
        <a href="/finishing-service" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Finishing Standards ›
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Washing is the next stage after finishing in many production plans. <a href="/insights/garment-washing-explained" style="color: #e00; text-decoration: none;">Read Garment Washing Explained</a>.
      </p>


    </article>

  </div>


    <style>
      .faq-item2 { border-bottom: 1px solid #1a1a1a; }
      .faq-item2:last-child { border-bottom: none; }
      .faq-question2 { width: 100%; background: none; border: none; color: #fff; text-align: left; cursor: pointer; padding: 1.1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.95rem; font-weight: 400; font-family: inherit; min-height: 44px; transition: color 0.2s; }
      .faq-question2:hover { color: #e00; }
      .faq-icon2 { flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: #e00; transition: transform 0.2s; }
      .faq-icon2--open { transform: rotate(45deg); }
      .faq-answer2 { display: none; padding-bottom: 1.1rem; }
      .faq-answer2--visible { display: block; }
      .faq-answer2 p { color: #aaa; line-height: 1.8; font-size: 0.92rem; margin: 0; }
    </style>
    <script is:inline>
      document.querySelectorAll('.faq-question2').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon2');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isExpanded));
          answer.classList.toggle('faq-answer2--visible');
          icon.classList.toggle('faq-icon2--open');
        });
      });
    </script>

</BaseLayout>
