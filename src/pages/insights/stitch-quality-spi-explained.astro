---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Stitch Quality (SPI) Explained: What Actually Makes a Seam Strong";
const pageDescription = "What stitches per inch (SPI) means, typical SPI ranges by fabric and seam type, and the most common sewing defects buyers actually encounter.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": pageTitle,
    "description": pageDescription,
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" },
    "url": "https://sdfltd.com/insights/stitch-quality-spi-explained/",
    "mainEntityOfPage": "https://sdfltd.com/insights/stitch-quality-spi-explained/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does higher SPI always mean better quality?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not automatically. Too high an SPI on lightweight or stretch fabric can weaken the seam by over-perforating it. The right SPI is matched to the specific fabric and seam type, not simply maximized."
        }
      },
      {
        "@type": "Question",
        "name": "How is SPI actually checked on the factory floor?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "By counting stitches within a measured one-inch section of seam, usually with a ruler or a dedicated stitch-counting gauge, spot-checked during production rather than only at the very end."
        }
      },
      {
        "@type": "Question",
        "name": "Can a customer notice a stitch quality problem before it fails?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sometimes — visible puckering or uneven stitching is a visual warning sign. Skip stitches and marginal SPI are harder to spot without close inspection, which is exactly why factory-side quality checks matter more than relying on the finished look alone."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Stitch Quality (SPI) Explained</span>
      </p>
    </nav>

    <article style="max-width: 800px; margin: 0 auto;">

      <header style="max-width: 760px; margin-left: auto; margin-right: auto; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Production Guide · Sewing</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Stitch Quality (SPI) Explained: What Actually Makes a Seam Strong
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          SPI (stitches per inch) is the measurable count of stitches placed in one inch of seam, and it's the clearest indicator of seam strength. Higher isn't always better — too high an SPI on stretch or lightweight fabric can weaken the seam by over-perforating it. The right SPI depends on fabric weight, thread weight, and seam type, typically 8-12 for most garment seams.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">What SPI Actually Measures</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">SPI stands for stitches per inch — literally how many individual stitches a sewing machine places in one inch of seam. It's the single most reliable, measurable indicator of stitch quality, because it can be counted and verified, unlike a subjective judgment of whether a seam "looks strong."</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Higher SPI generally means a stronger, more secure seam, but not endlessly — too high an SPI on lightweight or stretch fabric can perforate the fabric with too many needle holes, weakening it rather than strengthening it.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Typical SPI Ranges by Seam Type</h2>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid #333;">
            <th style="text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: #fff; font-weight: 400;">Seam Type</th>
            <th style="text-align: left; padding: 0.75rem 1rem; color: #fff; font-weight: 400;">Typical SPI</th>
            <th style="text-align: left; padding: 0.75rem 0 0.75rem 1rem; color: #fff; font-weight: 400;">Why</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Knit garment main seams (t-shirts, hoodies)</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">8-10</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Enough strength without over-perforating stretch fabric</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Woven garment main seams (shirts, trousers)</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">10-12</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Wovens don't stretch, so tighter stitching adds durability without weakening the fabric</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Denim / heavy-duty seams</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">8-10 with heavier thread</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Strength comes more from thread weight than stitch count on heavy fabric</td>
          </tr>
          <tr>
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Topstitching / decorative</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">8-10</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Balances visible neatness with fabric integrity</td>
          </tr>
        </tbody>
      </table>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">These are working ranges, not rigid rules — the right SPI also depends on thread weight and fabric weight, and a good factory adjusts based on the specific combination rather than applying one number to every order.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">The Most Common Sewing Defects and What They Actually Mean</h2>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid #333;">
            <th style="text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: #fff; font-weight: 400;">Defect</th>
            <th style="text-align: left; padding: 0.75rem 1rem; color: #fff; font-weight: 400;">What It Looks Like</th>
            <th style="text-align: left; padding: 0.75rem 0 0.75rem 1rem; color: #fff; font-weight: 400;">Usually Caused By</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Skip stitch</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">A gap where a stitch is missing entirely</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Needle-thread timing issue or a damaged/wrong needle for the fabric</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Open seam</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Stitching has come apart, leaving a gap</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Insufficient SPI, wrong thread tension, or thread breakage during sewing</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Puckering</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Fabric bunches or ripples along the seam line</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Thread tension too tight relative to fabric weight and stretch</td>
          </tr>
          <tr>
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Uneven stitch length</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Stitches visibly vary in size along one seam</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Inconsistent fabric feed, often from operator speed changes or fabric slipping</td>
          </tr>
        </tbody>
      </table>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Open seams and skip stitches are the two defects most likely to actually fail in a customer's hands, which is why both are treated as critical or major defects in a standard AQL inspection, not minor cosmetic issues.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">What to Ask Your Factory</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Ask what SPI standard they sew to for your specific fabric and seam type, and whether it's checked as part of in-line quality control — meaning checked continuously during sewing, not just at final inspection after the whole garment is already assembled.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">If a sample comes back with visible puckering or uneven stitching, don't approve it assuming bulk will naturally be better. Puckering traces back to a tension setting that needs to be corrected on the machine, and an uncorrected setting will repeat across the entire bulk run.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Stitch Quality FAQ</h2>
      <div class="faq-accordion2">
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Does higher SPI always mean better quality?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Not automatically. Too high an SPI on lightweight or stretch fabric can weaken the seam by over-perforating it. The right SPI is matched to the specific fabric and seam type, not simply maximized.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            How is SPI actually checked on the factory floor?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>By counting stitches within a measured one-inch section of seam, usually with a ruler or a dedicated stitch-counting gauge, spot-checked during production rather than only at the very end.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Can a customer notice a stitch quality problem before it fails?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Sometimes — visible puckering or uneven stitching is a visual warning sign. Skip stitches and marginal SPI are harder to spot without close inspection, which is exactly why factory-side quality checks matter more than relying on the finished look alone.</p>
          </div>
        </div>
      </div>


      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Want consistent stitch quality checked in-line, not just at final inspection? SDF Clothing verifies SPI and seam integrity throughout production, not only at the end.
        </p>
        <a href="/cut-and-sew-service" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Sewing Quality Control ›
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Cutting comes before sewing in the production sequence. <a href="/insights/fabric-cutting-explained" style="color: #e00; text-decoration: none;">Read Fabric Cutting Explained</a> to see what happens at the previous stage.
      </p>


    </article>

  </div>


    <style>
      .faq-item2 { border-bottom: 1px solid #1a1a1a; }
      .faq-item2:last-child { border-bottom: none; }
      .faq-question2 { width: 100%; background: none; border: none; color: #fff; text-align: left; cursor: pointer; padding: 1.1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.95rem; font-weight: 400; font-family: inherit; min-height: 44px; transition: color 0.2s; }
      .faq-question2:hover { color: #e00; }
      .faq-icon2 { flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: #e00; transition: transform 0.2s; }
      .faq-icon2--open { transform: rotate(45deg); }
      .faq-answer2 { display: none; padding-bottom: 1.1rem; }
      .faq-answer2--visible { display: block; }
      .faq-answer2 p { color: #aaa; line-height: 1.8; font-size: 0.92rem; margin: 0; }
    </style>
    <script is:inline>
      document.querySelectorAll('.faq-question2').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon2');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isExpanded));
          answer.classList.toggle('faq-answer2--visible');
          icon.classList.toggle('faq-icon2--open');
        });
      });
    </script>

</BaseLayout>
