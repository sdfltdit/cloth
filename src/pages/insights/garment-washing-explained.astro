---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Garment Washing Explained: Wash Types and Shrinkage Control";
const pageDescription = "Why garments are washed as part of production, the difference between enzyme, stone, silicone, and garment-dye washes, and how much shrinkage should remain for home washing.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": pageTitle,
    "description": pageDescription,
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" },
    "url": "https://sdfltd.com/insights/garment-washing-explained/",
    "mainEntityOfPage": "https://sdfltd.com/insights/garment-washing-explained/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does washing weaken the fabric?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some wash types, particularly stone washing, do add mechanical stress that can slightly reduce fabric strength, which is why a wash-tested pre-production sample should also be checked for strength, not just appearance."
        }
      },
      {
        "@type": "Question",
        "name": "Can garment washing fix a color mismatch from dyeing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No — washing can soften color slightly or add an intentional worn look, but it can't correct a genuine dye-lot mismatch. That has to be caught and corrected at the lab dip and bulk dyeing stage instead."
        }
      },
      {
        "@type": "Question",
        "name": "Why does the same wash recipe sometimes look different between batches?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Water quality, machine load, and timing can vary slightly between wash runs, similar to how dye lots vary between dyeing runs. This is why a wash-approval swatch or reference garment should be kept and compared against each production batch."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Garment Washing Explained</span>
      </p>
    </nav>

    <article>

      <header style="max-width: 760px; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Production Guide · Washing</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Garment Washing Explained: Wash Types and Shrinkage Control
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          Garment washing during production is a deliberate treatment for look, feel, or shrinkage control, not simple cleaning. Enzyme, stone, silicone, and garment-dye washes each affect fabric differently, and the wash step should handle most shrinkage in the factory, leaving well-processed cotton with under 3% additional shrinkage at home.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Why Garments Are Washed as Part of Production, Not Just at Home</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Garment washing during production isn't cleaning in the everyday sense — it's a deliberate treatment applied to finished garments to achieve a specific look, feel, or performance before they ever reach a customer, most commonly seen in denim but used across many fabric types.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Skipping an intended wash step doesn't just change appearance — it can leave shrinkage uncontrolled, since much of a garment's remaining shrinkage is designed to happen during this factory wash rather than the customer's first wash at home.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Common Garment Wash Types</h2>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid #333;">
            <th style="text-align: left; padding: 0.75rem 1rem 0.75rem 0; color: #fff; font-weight: 400;">Wash Type</th>
            <th style="text-align: left; padding: 0.75rem 1rem; color: #fff; font-weight: 400;">What It Does</th>
            <th style="text-align: left; padding: 0.75rem 0 0.75rem 1rem; color: #fff; font-weight: 400;">Typical Use</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Enzyme wash</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Uses enzymes to soften fabric and slightly fade color</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Cotton garments needing a soft, slightly worn handfeel</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Stone wash</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Mechanical abrasion (traditionally with pumice stones) for a faded, worn look</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Denim, achieving a vintage or distressed appearance</td>
          </tr>
          <tr style="border-bottom: 1px solid #1a1a1a;">
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Silicone wash</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Coats fibers with silicone for an extra-soft, smooth finish</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Fleece and premium knitwear wanting a luxury handfeel</td>
          </tr>
          <tr>
            <td style="padding: 0.75rem 1rem 0.75rem 0; color: #aaa;">Garment dye wash</td>
            <td style="padding: 0.75rem 1rem; color: #aaa;">Dyes and softens in the same process, after the garment is fully sewn</td>
            <td style="padding: 0.75rem 0 0.75rem 1rem; color: #aaa;">Achieving color and soft handfeel together in one step</td>
          </tr>
        </tbody>
      </table>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Each wash type has a different impact on shrinkage, color, and fabric strength — which is exactly why the wash type should be locked into the tech pack and tested on a pre-production sample, not decided informally during bulk production.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">The Shrinkage Question Every Buyer Should Ask</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Ask specifically what percentage of total shrinkage happens during the factory wash step versus what remains for the customer's first home wash. A garment that's fully pre-shrunk in the factory should show minimal additional shrinkage at home — typically under 3%, sometimes close to 1% for well-processed cotton.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">If this number isn't tracked or known, that's worth flagging directly, because it means shrinkage control is happening informally rather than as a measured, repeatable process.</p>
      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Garment Washing FAQ</h2>
      <div class="faq-accordion2">
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Does washing weaken the fabric?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Some wash types, particularly stone washing, do add mechanical stress that can slightly reduce fabric strength, which is why a wash-tested pre-production sample should also be checked for strength, not just appearance.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Can garment washing fix a color mismatch from dyeing?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>No — washing can soften color slightly or add an intentional worn look, but it can't correct a genuine dye-lot mismatch. That has to be caught and corrected at the lab dip and bulk dyeing stage instead.</p>
          </div>
        </div>
        <div class="faq-item2">
          <button type="button" class="faq-question2" aria-expanded="false">
            Why does the same wash recipe sometimes look different between batches?
            <span class="faq-icon2" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer2">
            <p>Water quality, machine load, and timing can vary slightly between wash runs, similar to how dye lots vary between dyeing runs. This is why a wash-approval swatch or reference garment should be kept and compared against each production batch.</p>
          </div>
        </div>
      </div>


      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Want a wash process tested and locked in before bulk production? SDF Clothing tests wash recipes on pre-production samples and tracks shrinkage before approving a run.
        </p>
        <a href="/washing-service" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Wash Requirements ›
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Finishing happens before washing in most production plans. <a href="/insights/garment-finishing-explained" style="color: #e00; text-decoration: none;">Read Garment Finishing Explained</a>.
      </p>


    </article>

  </div>


    <style>
      .faq-item2 { border-bottom: 1px solid #1a1a1a; }
      .faq-item2:last-child { border-bottom: none; }
      .faq-question2 { width: 100%; background: none; border: none; color: #fff; text-align: left; cursor: pointer; padding: 1.1rem 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.95rem; font-weight: 400; font-family: inherit; min-height: 44px; transition: color 0.2s; }
      .faq-question2:hover { color: #e00; }
      .faq-icon2 { flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: #e00; transition: transform 0.2s; }
      .faq-icon2--open { transform: rotate(45deg); }
      .faq-answer2 { display: none; padding-bottom: 1.1rem; }
      .faq-answer2--visible { display: block; }
      .faq-answer2 p { color: #aaa; line-height: 1.8; font-size: 0.92rem; margin: 0; }
    </style>
    <script is:inline>
      document.querySelectorAll('.faq-question2').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon2');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!isExpanded));
          answer.classList.toggle('faq-answer2--visible');
          icon.classList.toggle('faq-icon2--open');
        });
      });
    </script>

</BaseLayout>
