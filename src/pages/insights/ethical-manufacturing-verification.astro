export const prerender = true;

const pageTitle = "Ethical Manufacturing Verification Guide";
const pageDescription = "Ethical manufacturing verification guide for clothing brands. Learn BSCI, WRAP, Fair Trade, and SA8000 certifications plus social compliance audit processes.";
const companyAge = getCompanyAgeString();

