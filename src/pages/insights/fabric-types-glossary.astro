---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Fabric Types Glossary | Knit & Woven Fabric Guide | SDF Clothing";
const pageDescription = "A-Z glossary of clothing fabric types — single jersey, interlock, pique, fleece, twill, poplin, denim and more. GSM range, feel, and which garments use each fabric.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "name": "Fabric Types Glossary",
    "description": pageDescription,
    "url": "https://sdfltd.com/insights/fabric-types-glossary/",
    "author": { "@id": "https://sdfltd.com/#org" },
    "publisher": { "@id": "https://sdfltd.com/#org" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between knit and woven fabric?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Knit fabric is made by interlocking loops of yarn, which gives it natural stretch — used for t-shirts, hoodies, and activewear. Woven fabric is made by crossing two sets of yarns at right angles, which gives it structure and less stretch — used for shirts, trousers, and jackets."
        }
      },
      {
        "@type": "Question",
        "name": "Which fabric is best for t-shirts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Single jersey is the standard fabric for t-shirts, typically 140-220 GSM in 100% cotton or cotton blends. It is lightweight, breathable, and cost-effective for high-volume production."
        }
      },
      {
        "@type": "Question",
        "name": "What fabric is used for polo shirts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pique (also spelled piqué) is the standard fabric for polo shirts. Its raised, textured knit structure holds shape better than single jersey and is typically 180-240 GSM."
        }
      }
    ]
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">

    <nav aria-label="Breadcrumb" style="margin-bottom: 2.5rem;">
      <p style="font-size: 0.72rem; color: #FFFFFF; letter-spacing: 0.1em; text-transform: uppercase;">
        <a href="/" style="color: #e00; text-decoration: none;">Home</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <a href="/insights" style="color: #aaa; text-decoration: none;">Insights</a>
        <span style="margin: 0 0.5rem; color: #333;">›</span>
        <span style="color: #FFFFFF;">Fabric Types Glossary</span>
      </p>
    </nav>

    <article>

      <header style="max-width: 760px; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1a1a1a;">
        <span style="font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: #e00; display: block; margin-bottom: 1rem;">Fabric Guide</span>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 200; color: #fff; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.01em;">
          Fabric Types Glossary — Every Fabric Used in Clothing Manufacturing
        </h1>
        <p style="font-size: 1rem; color: #aaa; line-height: 1.9; margin: 0;">
          A reference guide to the knit and woven fabrics used in garment manufacturing. Each entry covers what the fabric is, its typical GSM range, how it feels, and which garments commonly use it.
        </p>
      </header>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Knit Fabrics</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Knit fabrics are made by interlocking loops of yarn. This construction gives them natural stretch and recovery, making them the standard choice for t-shirts, activewear, and underwear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Single Jersey</strong> — The most common knit fabric, made with one set of needles on a single knit machine. Lightweight and stretchy with a smooth face and slightly textured back. Typical range: 140-220 GSM. Used for <a href="/t-shirt-manufacturer" style="color: #e00; text-decoration: none;">t-shirts</a>, casual tops, and dresses.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Interlock</strong> — A double-knit fabric made by interlocking two single jersey layers, giving it a smooth, identical finish on both sides. Heavier and more stable than single jersey with less curling at cut edges. Typical range: 180-260 GSM. Used for premium t-shirts, baby clothing, and lightweight dresses.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Pique (Piqué)</strong> — A textured knit with a raised, waffle-like or honeycomb surface pattern, created by a specific knitting stitch. Holds its shape better than single jersey and is more breathable due to the surface texture. Typical range: 180-240 GSM. The standard fabric for <a href="/polo-shirt-manufacturer" style="color: #e00; text-decoration: none;">polo shirts</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Rib Knit</strong> — Made with alternating knit and purl stitches, creating vertical ridges with significant stretch in the width direction. Typical range: 200-300 GSM. Used for collars, cuffs, waistbands, and fitted garments like <a href="/tank-top-manufacturer" style="color: #e00; text-decoration: none;">tank tops</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Fleece</strong> — A brushed knit fabric with a soft, napped surface on one or both sides for warmth and insulation. Typical range: 240-450 GSM. The standard fabric for <a href="/hoodie-manufacturer" style="color: #e00; text-decoration: none;">hoodies</a> and <a href="/sweatshirt-manufacturer" style="color: #e00; text-decoration: none;">sweatshirts</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>French Terry</strong> — A knit fabric with uncut loops on the inside face, giving it a textured, absorbent feel without the brushed pile of fleece. Lighter and more breathable than fleece. Typical range: 220-320 GSM. Used for lightweight <a href="/sweatshirt-manufacturer" style="color: #e00; text-decoration: none;">sweatshirts</a> and joggers.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Waffle Knit</strong> — A textured knit with a distinctive raised grid pattern that traps air for insulation. Typical range: 180-260 GSM. Used for thermal wear and casual layering pieces.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Jacquard Knit</strong> — A knit fabric produced on a jacquard machine that creates patterns directly in the knit structure rather than printing them on. Typical range: 180-280 GSM. Used for patterned sweaters and fashion knitwear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;"><strong>Ponte / Ponte di Roma</strong> — A double-knit fabric, usually a poly-viscose-elastane blend, that is firm, stable, and holds its shape like a woven fabric while retaining stretch. Typical range: 280-350 GSM. Used for structured dresses, leggings, and tailored knitwear.</p>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Woven Fabrics</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Woven fabrics are made by crossing two sets of yarns — warp and weft — at right angles on a loom. They have little to no natural stretch (unless elastane is added) and hold structure better than knits.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Poplin</strong> — A tightly woven, plain-weave fabric with a fine crosswise rib, giving it a crisp, smooth finish. Typical range: 100-150 GSM. The standard fabric for dress <a href="/shirt-manufacturer" style="color: #e00; text-decoration: none;">shirts</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Twill</strong> — A weave with a diagonal rib pattern, created by passing the weft thread over one or more warp threads then under two or more. More durable and wrinkle-resistant than plain weave. Typical range: 150-300 GSM. Used for chinos, workwear, and casual <a href="/shirt-manufacturer" style="color: #e00; text-decoration: none;">shirts</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Denim</strong> — A sturdy twill weave, traditionally cotton, woven with a colored warp yarn (usually indigo) and white weft yarn, creating its characteristic diagonal ribbing and color fade. Typical range: 200-450 GSM depending on wash and construction. Used for <a href="/denim-manufacturer" style="color: #e00; text-decoration: none;">jeans</a> and <a href="/denim-jacket-manufacturer" style="color: #e00; text-decoration: none;">denim jackets</a>.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Canvas</strong> — A very heavy, plain or basket-weave fabric known for durability and abrasion resistance. Typical range: 300-600 GSM. Used for workwear, bags, and heavy outerwear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Oxford</strong> — A basket-weave fabric with a slightly rough, textured surface, more casual and durable than poplin. Typical range: 120-180 GSM. Used for casual button-down shirts.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Chambray</strong> — A plain-weave fabric that resembles denim but is lighter, made with a colored warp and white weft yarn. Typical range: 100-160 GSM. Used for casual shirts and lightweight summer wear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Taffeta</strong> — A crisp, smooth plain-weave fabric with a slight sheen, made from silk or synthetic fibers. Typical range: 50-100 GSM. Used for linings, formal wear, and structured evening wear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Satin</strong> — A weave (not a fiber) characterized by long floats of yarn on the fabric surface, giving it a glossy, smooth finish. Typical range: 60-150 GSM. Used for linings, blouses, and eveningwear.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;"><strong>Ripstop</strong> — A woven fabric with reinforcing threads woven in a crosshatch pattern at intervals, stopping small tears from spreading. Typical range: 60-120 GSM. Used for outdoor gear, packable jackets, and technical outerwear.</p>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Fiber-Based Terms</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Unlike weave/knit structure terms above, these describe the raw material the yarn is made from — any of these fibers can be knit or woven into most of the structures above.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Cotton</strong> — A natural fiber from the cotton plant, breathable and soft, the most widely used fiber in apparel. See our <a href="/organic-cotton-clothing-manufacturer" style="color: #e00; text-decoration: none;">organic cotton</a> and <a href="/cotton-clothing-manufacturer" style="color: #e00; text-decoration: none;">cotton clothing</a> pages.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Polyester</strong> — A synthetic fiber known for durability, wrinkle resistance, and quick-dry properties. See our <a href="/polyester-clothing-manufacturer" style="color: #e00; text-decoration: none;">polyester clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Modal</strong> — A semi-synthetic fiber made from beech tree cellulose, softer and more breathable than cotton with better drape. See our <a href="/modal-clothing-manufacturer" style="color: #e00; text-decoration: none;">modal clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Tencel (Lyocell)</strong> — A semi-synthetic fiber made from wood pulp using a closed-loop, low-waste production process. See our <a href="/tencel-clothing-manufacturer" style="color: #e00; text-decoration: none;">Tencel clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Bamboo</strong> — A semi-synthetic fiber processed from bamboo pulp, naturally antibacterial and moisture-wicking. See our <a href="/bamboo-clothing-manufacturer" style="color: #e00; text-decoration: none;">bamboo clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Hemp</strong> — A natural bast fiber, durable and low-impact to grow, often blended with cotton for softness. See our <a href="/hemp-clothing-manufacturer" style="color: #e00; text-decoration: none;">hemp clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Linen</strong> — A natural bast fiber from the flax plant, highly breathable with a distinctive textured drape, prone to wrinkling. See our <a href="/linen-clothing-manufacturer" style="color: #e00; text-decoration: none;">linen clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Wool</strong> — A natural protein fiber from sheep, warm, elastic, and naturally moisture-wicking. See our <a href="/wool-clothing-manufacturer" style="color: #e00; text-decoration: none;">wool clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Cashmere</strong> — A luxury natural fiber from cashmere goats, exceptionally soft and warm relative to its weight. See our <a href="/cashmere-clothing-manufacturer" style="color: #e00; text-decoration: none;">cashmere clothing</a> page.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Silk</strong> — A natural protein fiber produced by silkworms, prized for its sheen, drape, and temperature-regulating properties.</p>

      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;"><strong>Recycled Polyester (rPET)</strong> — Polyester fiber made from recycled plastic bottles or textile waste, functionally identical to virgin polyester. See our <a href="/recycled-clothing-manufacturer" style="color: #e00; text-decoration: none;">recycled clothing</a> page.</p>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Knit vs Woven — Which to Choose</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">Choose knit fabrics when your garment needs stretch and ease of movement — t-shirts, activewear, underwear, and fitted garments all rely on knit construction for comfort and flexibility.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;">Choose woven fabrics when your garment needs structure and a tailored silhouette — shirts, trousers, jackets, and formal wear rely on woven construction to hold shape and drape predictably.</p>

      <h2 style="font-size: 0.78rem; font-weight: 400; margin: 0 0 1.25rem; color: #fff; letter-spacing: 0.05em; text-transform: uppercase;">Fabric Glossary FAQ</h2>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>What is the difference between knit and woven fabric?</strong> Knit fabric is made by interlocking loops of yarn, which gives it natural stretch — used for t-shirts, hoodies, and activewear. Woven fabric is made by crossing two sets of yarns at right angles, which gives it structure and less stretch — used for shirts, trousers, and jackets.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Which fabric is best for t-shirts?</strong> Single jersey is the standard fabric for t-shirts, typically 140-220 GSM in 100% cotton or cotton blends. It is lightweight, breathable, and cost-effective for high-volume production.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>What fabric is used for polo shirts?</strong> Pique is the standard fabric for polo shirts. Its raised, textured knit structure holds shape better than single jersey and is typically 180-240 GSM.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;"><strong>Is fleece a knit or woven fabric?</strong> Fleece is a knit fabric. It is brushed on one or both sides after knitting to create its characteristic soft, napped surface.</p>
      <p style="color: #aaa; line-height: 1.8; font-size: 0.95rem; margin-bottom: 3rem;"><strong>What is the strongest fabric for workwear?</strong> Canvas and heavy twill weaves (above 300 GSM) offer the best abrasion resistance and durability for workwear and heavy-use garments.</p>

      <div style="text-align: center; padding: 2.5rem; border: 1px solid #1a1a1a; border-top: 0.6px solid #e00; background: #050505; margin-top: 3rem;">
        <p style="color: #fff; font-size: 1rem; margin-bottom: 1.5rem; font-weight: 300;">
          Not sure which fabric fits your design? SDF Clothing sources and tests fabric options for every garment type, and provides swatches before bulk production.
        </p>
        <a href="/contact" style="display: inline-block; background: #e00; color: #fff; padding: 0.9rem 2.5rem; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; transition: background 0.2s;">
          Discuss Fabric Options
        </a>
      </div>

      <p style="font-size: 0.85rem; color: #aaa; margin-top: 1.5rem; line-height: 1.8;">
        Want to understand fabric weight specifically? Read our <a href="/insights/fabric-gsm-explained" style="color: #e00; text-decoration: none;">Fabric GSM Explained</a> guide, or explore <a href="/fabric-sourcing" style="color: #e00; text-decoration: none;">fabric sourcing</a> for how we select and source fabric for your order.
      </p>

    </article>

  </div>

</BaseLayout>
