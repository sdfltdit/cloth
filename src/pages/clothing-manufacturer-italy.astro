---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Clothing Manufacturer for Italian Brands | EU GSP Bangladesh | SDF Clothing";
const pageDescription = "EU GSP duty-free clothing manufacturer for Italian fashion brands. EU EPR 2026 compliant, GOTS & OEKO-TEX certified. Full Italian customs documentation. MOQ 300 pieces.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Clothing Manufacturer for Italian Brands | EU GSP Bangladesh | SDF Clothing",
  "provider": {"@id": "https://www.sdfltd.com/#org"},
  "areaServed": "Italy",
  "serviceType": "Clothing Manufacturing",
  "url": "https://www.sdfltd.com/clothing-manufacturer-italy"
}
</script>

<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Italian Market · EU GSP Duty-Free · Since 1998</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1rem;line-height:1.2;">Clothing Manufacturer for Italian Brands</h1>
    <p style="color:#FFFFFF;max-width:640px;line-height:1.8;font-size:0.92rem;">SDF Clothing supplies Italian fashion brands with EU GSP duty-free, EU EPR 2026-compliant Bangladesh garment manufacturing. We provide complete Italian customs documentation, DPP preparation, and REACH compliance for seamless imports to Italy.</p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;">
      <a href="/contact" class="cta-button">Get Free Quote</a>
    </div>
  </div>
</section>

<style>@media(max-width:768px){section>.container>div[style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important;}section>.container>div[style*="grid-template-columns:repeat(3"]{grid-template-columns:1fr!important;}section>.container>div[style*="grid-template-columns:repeat(4"]{grid-template-columns:1fr 1fr!important;}}</style>
</BaseLayout>
