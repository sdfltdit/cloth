---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Clothing Manufacturer for Italian Brands | Bangladesh Factory | SDF Clothing";
const pageDescription = "Bangladesh garment factory for Italian fashion brands — 0% EU GSP import duty, GOTS & OEKO-TEX certified, EU EPR 2026 & Digital Product Passport ready. MOQ 300 pieces. Full Italian customs documentation. Since 1998.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://sdfltd.com/clothing-manufacturer-italy/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "All Services", "item": "https://sdfltd.com/all-services" },
        { "@type": "ListItem", "position": 3, "name": "Clothing Manufacturer for Italian Brands", "item": "https://sdfltd.com/clothing-manufacturer-italy/" }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://sdfltd.com/clothing-manufacturer-italy/#service",
      "name": "Clothing Manufacturer for Italian Brands",
      "alternateName": [
        "Clothing Manufacturers Italy",
        "Bangladesh Clothing Manufacturer Italy",
        "Garment Manufacturer for Italy",
        "Apparel Factory for Italian Brands",
        "Low MOQ Clothing Manufacturer Italy",
        "Organic Clothing Manufacturer Italy",
        "Private Label Manufacturer Italy"
      ],
      "description": "SDF Clothing is a Bangladesh garment factory producing EU GSP duty-free apparel for Italian fashion brands since 1998. GOTS certified organic, OEKO-TEX Standard 100, EU EPR 2026 compliant, Digital Product Passport ready. MOQ 300 pieces per style. Full Italian customs documentation with every order.",
      "provider": {
        "@type": "Organization",
        "@id": "https://sdfltd.com/#org",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com",
        "logo": "https://sdfltd.com/logo-small.svg",
        "foundingDate": "1998",
        "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 200 },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "House 125, Road 01, Baridhara DOHS",
          "addressLocality": "Dhaka",
          "postalCode": "1212",
          "addressCountry": "BD"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "Sales",
          "url": "https://sdfltd.com/contact",
          "areaServed": "IT",
          "availableLanguage": ["English", "Italian"]
        },
        "hasCredential": [
          { "@type": "EducationalOccupationalCredential", "name": "GOTS Certified — Global Organic Textile Standard" },
          { "@type": "EducationalOccupationalCredential", "name": "OEKO-TEX Standard 100" },
          { "@type": "EducationalOccupationalCredential", "name": "BSCI Social Compliance" },
          { "@type": "EducationalOccupationalCredential", "name": "GRS — Global Recycled Standard" },
          { "@type": "EducationalOccupationalCredential", "name": "ISO 9001 Quality Management" }
        ]
      },
      "areaServed": { "@type": "Country", "name": "Italy", "sameAs": "https://www.wikidata.org/wiki/Q38" },
      "serviceType": "Clothing Manufacturing",
      "url": "https://sdfltd.com/clothing-manufacturer-italy/",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "eligibleMinimumOrderQuantity": { "@type": "QuantitativeValue", "value": 300, "unitCode": "C62" },
        "seller": { "@id": "https://sdfltd.com/#org" }
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Garment Manufacturing Services for Italian Brands",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "OEM Clothing Manufacturing for Italy" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Private Label Apparel Production" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CMT Cut Make Trim Services" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ODM Apparel Design & Production" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "GOTS Organic Clothing Manufacturing" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "EU EPR 2026 Compliant Production" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Digital Product Passport Preparation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Low MOQ Apparel from 300 Pieces" } }
        ]
      }
    },
    {
      "@type": "Person",
      "@id": "https://sdfltd.com/#founder",
      "name": "Chowdhury Remon",
      "jobTitle": "Founder & CEO",
      "worksFor": { "@id": "https://sdfltd.com/#org" },
      "description": "Garment manufacturing expert since 1998 specialising in EU market supply chains, GSP compliance, and sustainable apparel production for European fashion brands.",
      "url": "https://sdfltd.com/about"
    },
    {
      "@type": "FAQPage",
      "@id": "https://sdfltd.com/clothing-manufacturer-italy/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can an Italian fashion brand import clothing from Bangladesh at 0% duty?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Bangladesh holds EU GSP EBA (Everything But Arms) status — the highest tier of EU trade preferences. Apparel under HS chapters 61 and 62 enters Italy and all 27 EU member states at 0% customs duty. The standard EU MFN duty on most clothing is 12% of CIF value. We provide EUR.1 Movement Certificates with every shipment for Italian customs clearance." }
        },
        {
          "@type": "Question",
          "name": "What is the minimum order quantity (MOQ) for Italian brands?",
          "acceptedAnswer": { "@type": "Answer", "text": "300 pieces per style. This applies across OEM, private label, ODM, and CMT production. Flexible size distribution within the 300-piece minimum. No minimum across styles on the same order." }
        },
        {
          "@type": "Question",
          "name": "Is this factory EU EPR 2026 and Digital Product Passport compliant?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We generate Digital Product Passport data files (JSON/XML), material composition declarations per EN ISO 1833, REACH Annex XVII chemical compliance certificates, and full supply chain traceability documentation as standard. Italian brands sourcing from us satisfy DPP requirements from day one." }
        },
        {
          "@type": "Question",
          "name": "How long does shipping from Bangladesh to Italy take?",
          "acceptedAnswer": { "@type": "Answer", "text": "Ocean freight from Chittagong Port to Genoa or La Spezia takes 22–28 transit days. Air freight to Milan Malpensa or Rome Fiumicino takes 4–5 days for urgent orders. We provide complete shipping documentation with every consignment." }
        },
        {
          "@type": "Question",
          "name": "What certifications does this garment factory hold for EU compliance?",
          "acceptedAnswer": { "@type": "Answer", "text": "GOTS (Global Organic Textile Standard) covering full production chain, OEKO-TEX Standard 100, GRS (Global Recycled Standard), BSCI Social Compliance, SEDEX SMETA 4-pillar audit, ISO 9001 Quality Management, and REACH chemical compliance — all current and available as physical copies with every shipment to Italy." }
        },
        {
          "@type": "Question",
          "name": "Does this factory produce GOTS certified organic garments for Italian retailers?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. GOTS certification covers the full production chain — from raw organic cotton sourcing through spinning, dyeing, cutting, sewing, and finishing. Garments carry organic status under EU textile regulations and are ready for Italian retailers requiring verified organic supply chain proof." }
        },
        {
          "@type": "Question",
          "name": "What Italian labelling regulation applies to imported garments?",
          "acceptedAnswer": { "@type": "Answer", "text": "D.Lgs 194/2011, which implements EU Regulation 1007/2011, requires accurate fibre composition labelling on all textile products sold in Italy. We provide a fibre composition certificate per EN ISO 1833 testing standards with every order, and verify Italian care labels against the regulation's fibre naming requirements before bulk production begins." }
        },
        {
          "@type": "Question",
          "name": "How does EU GSP save money for Italian importers sourcing from Bangladesh?",
          "acceptedAnswer": { "@type": "Answer", "text": "Standard EU MFN duty on clothing is 12% of CIF value. Bangladesh's GSP EBA status means 0% duty on most apparel. On a €100,000 order, that is €12,000 saved in import duties — compared to sourcing from China, India, or other non-GSP countries. The EUR.1 certificate of origin is prepared by our compliance team and submitted with every shipment." }
        },
        {
          "@type": "Question",
          "name": "What is the typical production lead time for Italian brands ordering from Bangladesh?",
          "acceptedAnswer": { "@type": "Answer", "text": "Proto sample: 14 days from confirmed brief. Pre-production sample: 10 days after proto approval. Bulk production: 30–45 days from PP sample sign-off depending on order volume and complexity. Total time from first contact to goods on vessel: typically 55–65 days for a first order." }
        },
        {
          "@type": "Question",
          "name": "Will Bangladesh lose EU duty-free access after LDC graduation in 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "Bangladesh is scheduled to graduate from LDC status in November 2026. EU GSP EBA access continues for a 3-year transition period through approximately 2029 under current EU rules. Bangladesh is actively negotiating GSP+ status and a bilateral EU-Bangladesh trade framework. All current orders are unaffected. We advise clients proactively on any trade policy changes." }
        }
      ]
    }
  ]
}
</script>

<style>
  /* ================================================================
     DESIGN SYSTEM — clothing-manufacturer-italy.astro
     Palette  : ink #0b0b10 · red #c82020 · cream #f4ede0 ·
                white #ffffff · olive-gold #9a8050 · green #1fa85a
     Type     : system-ui (zero load penalty)
     Approach : editorial B2B — confident, direct, no fluff
  ================================================================ */

  .p-italy { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; color: #d8d8e4; background: #0b0b10; }

  /* Container */
  .c { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
  .c-narrow { max-width: 780px; margin: 0 auto; padding: 0 1.25rem; }

  /* Typography scale */
  .eyebrow { font-size: 0.6rem; letter-spacing: 0.38em; text-transform: uppercase; color: #c82020; font-weight: 700; margin-bottom: 0.75rem; display: block; }
  .h1 { font-size: clamp(1.9rem, 4.8vw, 3.2rem); font-weight: 200; color: #fff; line-height: 1.15; margin-bottom: 1.1rem; letter-spacing: -0.015em; }
  .h1 em { font-style: normal; color: #c82020; font-weight: 700; }
  .h2 { font-size: clamp(1.3rem, 2.8vw, 1.9rem); font-weight: 300; color: #fff; line-height: 1.22; margin-bottom: 0.55rem; }
  .h3 { font-size: 0.97rem; font-weight: 600; color: #fff; margin-bottom: 0.45rem; line-height: 1.3; }
  .lead { font-size: 1rem; color: #bbbbc8; line-height: 1.8; margin-bottom: 1.6rem; max-width: 700px; }
  .body { font-size: 0.9rem; color: #9898a8; line-height: 1.75; margin-bottom: 0.9rem; }
  .body a { color: #c86060; text-decoration: none; border-bottom: 1px solid rgba(200,32,32,0.3); }
  .body a:hover { color: #e08080; border-color: #e08080; }
  .small { font-size: 0.78rem; color: #606070; line-height: 1.5; }

  /* Sections */
  .section { padding: 3.75rem 0; border-bottom: 1px solid #16161f; }
  .section:last-of-type { border-bottom: none; }

  /* Breadcrumb */
  .breadcrumb { padding: 0.8rem 0; font-size: 0.76rem; color: #505060; border-bottom: 1px solid #16161f; }
  .breadcrumb a { color: #707080; text-decoration: none; }
  .breadcrumb a:hover { color: #c82020; }
  .breadcrumb span { margin: 0 0.38rem; }

  /* Hero */
  .hero { padding: 4.5rem 0 3.5rem; background: linear-gradient(150deg, #0e0a0a 0%, #0b0b10 60%, #0a0d10 100%); border-bottom: 2px solid #c82020; position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; right: -100px; top: -80px; width: 500px; height: 500px; background: radial-gradient(ellipse at center, rgba(200,32,32,0.06) 0%, transparent 65%); pointer-events: none; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.5rem 0 2rem; }
  .badge { font-size: 0.67rem; letter-spacing: 0.07em; padding: 0.28rem 0.65rem; border: 1px solid rgba(200,32,32,0.4); color: #c09090; border-radius: 2px; white-space: nowrap; }
  .badge.g { border-color: rgba(31,168,90,0.45); color: #70c890; }
  .cta-row { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .btn-r { display: inline-block; background: #c82020; color: #fff; padding: 0.72rem 1.55rem; font-size: 0.83rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 2px; transition: background 0.18s; white-space: nowrap; }
  .btn-r:hover { background: #a01818; }
  .btn-g { display: inline-block; border: 1px solid rgba(255,255,255,0.2); color: #bbb; padding: 0.72rem 1.35rem; font-size: 0.83rem; text-decoration: none; border-radius: 2px; transition: border-color 0.18s, color 0.18s; letter-spacing: 0.03em; white-space: nowrap; }
  .btn-g:hover { border-color: #c82020; color: #fff; }

  /* Grid */
  .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }

  /* Cards */
  .card { background: #101018; border: 1px solid #1c1c28; border-radius: 3px; padding: 1.45rem; }
  .card-icon { font-size: 1.5rem; margin-bottom: 0.65rem; line-height: 1; }
  .stat-num { font-size: 2.4rem; font-weight: 800; line-height: 1; color: #c82020; margin-bottom: 0.15rem; }
  .stat-num.g { color: #1fa85a; }
  .stat-label { font-size: 0.8rem; font-weight: 600; color: #ddd; margin-bottom: 0.2rem; }
  .stat-sub { font-size: 0.74rem; color: #666; }

  /* Duty visual */
  .duty-visual { background: #0e0e16; border: 1px solid #1c1c28; border-radius: 3px; padding: 2rem 1.5rem; margin: 1.75rem 0 1rem; }
  .duty-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; }
  .duty-col { text-align: center; }
  .duty-country { font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: #555; margin-bottom: 0.45rem; }
  .duty-pct { font-size: 3.2rem; font-weight: 900; line-height: 1; margin-bottom: 0.2rem; }
  .duty-pct.r { color: #c82020; }
  .duty-pct.g { color: #1fa85a; }
  .duty-note { font-size: 0.7rem; color: #666; }
  .duty-saving { background: rgba(31,168,90,0.08); border: 1px solid rgba(31,168,90,0.2); border-radius: 3px; padding: 1.1rem 1.5rem; margin-top: 1.5rem; text-align: center; }
  .duty-saving-fig { font-size: 2rem; font-weight: 800; color: #1fa85a; line-height: 1; }
  .duty-saving-note { font-size: 0.76rem; color: #70a888; margin-top: 0.25rem; }

  /* Table */
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.84rem; margin-top: 1.1rem; }
  .tbl th { text-align: left; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: #505060; padding: 0.55rem 0.75rem; border-bottom: 1px solid #1c1c28; font-weight: 600; }
  .tbl td { padding: 0.72rem 0.75rem; border-bottom: 1px solid #131320; color: #9898a8; vertical-align: top; line-height: 1.55; }
  .tbl tr:last-child td { border-bottom: none; }
  .tbl td:first-child { color: #d0d0dc; font-weight: 500; }
  .tbl tr:hover td { background: rgba(255,255,255,0.015); }
  .yes { color: #1fa85a; font-weight: 700; }
  .no { color: #c82020; }

  /* Process steps */
  .steps { display: flex; flex-direction: column; }
  .step { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1.2rem; padding: 1.2rem 0; border-bottom: 1px solid #131320; align-items: start; }
  .step:last-child { border-bottom: none; }
  .step-n { width: 2.25rem; height: 2.25rem; border: 1px solid #c82020; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; color: #c82020; border-radius: 2px; flex-shrink: 0; margin-top: 0.1rem; }
  .step-title { font-size: 0.94rem; font-weight: 600; color: #fff; margin-bottom: 0.3rem; }
  .step-body { font-size: 0.84rem; color: #888898; line-height: 1.68; }

  /* Quote */
  .quote { border-left: 3px solid #c82020; padding: 1.2rem 1.5rem; background: #0e0e16; margin: 1.75rem 0; border-radius: 0 3px 3px 0; }
  .quote-text { font-size: 0.95rem; color: #b8b8c8; line-height: 1.72; font-style: italic; margin-bottom: 0.55rem; }
  .quote-attr { font-size: 0.7rem; color: #555; letter-spacing: 0.04em; }

  /* FAQ */
  .faq-item { border-bottom: 1px solid #161620; padding: 1.2rem 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-q { font-size: 0.94rem; font-weight: 600; color: #e8e8f0; margin-bottom: 0.45rem; }
  .faq-a { font-size: 0.86rem; color: #888898; line-height: 1.72; }
  .faq-a strong { color: #c0c0cc; font-weight: 600; }

  /* Inline checklist */
  .checklist { list-style: none; padding: 0; margin: 0.85rem 0; }
  .checklist li { font-size: 0.86rem; color: #9898a8; padding: 0.38rem 0; border-bottom: 1px solid #131320; display: flex; gap: 0.6rem; align-items: flex-start; line-height: 1.5; }
  .checklist li:last-child { border-bottom: none; }
  .checklist li::before { content: "✓"; color: #1fa85a; font-weight: 700; flex-shrink: 0; margin-top: 0.05rem; }

  /* Author bar */
  .author-bar { background: #0e0e16; border: 1px solid #1c1c28; border-radius: 3px; padding: 1.1rem 1.4rem; display: flex; gap: 1rem; align-items: center; margin-bottom: 1.5rem; }
  .author-dot { width: 2.5rem; height: 2.5rem; background: #c82020; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 800; color: #fff; flex-shrink: 0; }
  .author-name { font-size: 0.82rem; font-weight: 600; color: #ddd; }
  .author-title { font-size: 0.73rem; color: #666; margin-top: 0.1rem; }

  /* Internal links cluster */
  .link-cluster { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; }
  .link-cluster a { font-size: 0.76rem; padding: 0.28rem 0.65rem; border: 1px solid #1c1c28; color: #707080; text-decoration: none; border-radius: 2px; transition: border-color 0.14s, color 0.14s; }
  .link-cluster a:hover { border-color: #c82020; color: #ddd; }

  /* CTA footer section */
  .cta-section { padding: 4.5rem 0; background: linear-gradient(150deg, #0f0808 0%, #0b0b10 100%); border-top: 2px solid #c82020; text-align: center; }

  /* Responsive */
  @media (max-width: 768px) {
    .g2, .g3, .g4 { grid-template-columns: 1fr !important; }
    .duty-grid { grid-template-columns: 1fr; text-align: center; }
    .step { grid-template-columns: 2rem 1fr; gap: 0.9rem; }
    .author-bar { flex-direction: column; text-align: center; }
  }
  @media (max-width: 520px) {
    .h1 { font-size: 1.7rem; }
    .cta-row { flex-direction: column; }
    .btn-r, .btn-g { text-align: center; }
  }
</style>

<div class="p-italy">

  <!-- BREADCRUMB -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="c">
      <a href="/">Home</a><span aria-hidden="true">›</span>
      <a href="/all-services">Services</a><span aria-hidden="true">›</span>
      <span aria-current="page">Clothing Manufacturer for Italy</span>
    </div>
  </nav>

  <!-- ====================================================
    HERO
  ==================================================== -->
  <section class="hero" aria-labelledby="hero-h1">
    <div class="c">
      <span class="eyebrow">Italian Market · Bangladesh Garment Factory · EU GSP · Since 1998</span>
      <h1 class="h1" id="hero-h1">
        Clothing Manufacturer<br>
        for <em>Italian Brands</em>
      </h1>
      <p class="lead" style="margin-bottom:0;">
        A Bangladesh <a href="/clothing-manufacturers" style="color:#c86060;text-decoration:none;border-bottom:1px solid rgba(200,100,100,0.3);">garment factory</a> built for fashion brands that sell into Italy. We handle the full production process — fabric sourcing, sampling, bulk manufacturing, and shipping — while you stay focused on design and sales. Every order arrives in Italy duty-free under EU GSP, with GOTS and OEKO-TEX certification, complete Italian customs paperwork, and Digital Product Passport files ready for 2026 compliance. You get factory prices. Not agent prices.
      </p>
      <div class="hero-badges" role="list" aria-label="Key facts">
        <span class="badge g" role="listitem">0% EU Import Duty — GSP EBA</span>
        <span class="badge g" role="listitem">GOTS Organic Certified</span>
        <span class="badge g" role="listitem">OEKO-TEX Standard 100</span>
        <span class="badge" role="listitem">EU EPR 2026 Ready</span>
        <span class="badge" role="listitem">DPP Compliant</span>
        <span class="badge" role="listitem">MOQ 300 Pieces</span>
        <span class="badge" role="listitem">Since 1998</span>
        <span class="badge" role="listitem">No Outsourcing</span>
      </div>
      <div class="cta-row">
        <a href="/contact" class="btn-r">Get Free Quote for Italy</a>
        <a href="https://wa.me/8801819172080?text=Hi%20SDF%2C%20I%20am%20an%20Italian%20fashion%20brand%20looking%20for%20a%20clothing%20manufacturer" class="btn-g">💬 WhatsApp Us</a>
      </div>
    </div>
  </section>

  <!-- ====================================================
    AUTHOR / E-E-A-T BAR
  ==================================================== -->
  <div class="section" style="padding:1.5rem 0;border-bottom:1px solid #16161f;">
    <div class="c">
      <div class="author-bar">
        <div class="author-dot" aria-hidden="true">CR</div>
        <div>
          <div class="author-name">Written by Chowdhury Remon — Founder &amp; CEO, SDF Clothing</div>
          <div class="author-title">Garment manufacturing expert since 1998 · Specialist in EU market supply chains, GSP compliance, and sustainable apparel production · Serving 200+ international fashion brands across 36 countries · Last updated June 2026</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ====================================================
    SECTION 1 — THE NUMBERS ITALIAN BUYERS WANT FIRST
  ==================================================== -->
  <section class="section" aria-labelledby="numbers-h2">
    <div class="c">
      <span class="eyebrow">At a Glance</span>
      <h2 class="h2" id="numbers-h2">What Italian Fashion Brands Need to Know Upfront</h2>
      <p class="lead">Before anything else — pricing, certifications, process — here are the numbers Italian buyers ask in the first email.</p>

      <div class="g4">
        <div class="card" style="text-align:center;">
          <div class="stat-num g">0%</div>
          <div class="stat-label">EU Import Duty</div>
          <div class="stat-sub">Bangladesh GSP EBA status — HS chapters 61 &amp; 62 apparel into Italy</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-num">300</div>
          <div class="stat-label">Pieces MOQ</div>
          <div class="stat-sub">Per style, flexible size run — OEM, private label, CMT, ODM</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-num">14</div>
          <div class="stat-label">Day Proto Sample</div>
