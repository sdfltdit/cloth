---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Children's Clothing Manufacturer | Kids Wear | SDF";
const pageDescription = "Partner with a trusted children's clothing manufacturer for custom kids wear production. Get school uniforms, casual wear from 300 pieces with safety certification.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Children's Clothing Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What age range do you cover for children's clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture children's clothing for ages 2-14 years, covering toddler through early teen sizes. Our size ranges accommodate growing children with proportional grading and consistent fit across the age spectrum. Size charts available for brand customization."
          }
        },
        {
          "@type": "Question",
          "name": "What safety standards do you follow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We follow EN 14682 for European markets, CPSIA for US markets, and OEKO-TEX Class 1 for children's products. All children's clothing undergoes rigorous testing for chemical safety, flammability, drawcord safety, and small parts to ensure complete compliance."
          }
        },
        {
          "@type": "Question",
          "name": "What children's products do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture school uniforms with institutional branding, casual wear including t-shirts and jeans, sportswear for active children, outerwear for weather protection, and swimwear for water activities. All products available from 300 pieces minimum with safety-compliant construction."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics do you use for children's clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use GOTS cotton for organic options, recycled polyester for sustainability, bamboo for natural softness, and soft denim for durability. All fabrics tested for skin sensitivity and durability to withstand active wear and frequent washing."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for children's clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our children's clothing minimum is 300 pieces per style. This applies to all product types, fabric choices, and age ranges. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer school uniform manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We manufacture school uniforms including polo shirts, dress shirts, skirts, pants, sweaters, and blazers with institutional customization. School uniforms feature durable construction, color consistency, and branding options including embroidery and emblems."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Children's Clothing Manufacturing Service",
      "description": "Custom children's clothing manufacturing from 300 pieces for ages 2-14 years including school uniforms, casual wear, sportswear with GOTS cotton, CPSIA compliant, OEKO-TEX Class 1",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Children's Clothing Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Children's Clothing Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "5",
              "maxPrice": "20"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Children's Clothing from SDF Clothing",
      "description": "Step-by-step process for ordering custom children's clothing from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your children's clothing design, age range specifications, fabric requirements, size chart, target quantity, and safety requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, safety testing, production, customization, and shipping for your children's clothing order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review children's clothing samples for fit, fabric quality, safety compliance, and construction within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for children's clothing including safety testing"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check including safety verification and testing before shipment with tracking documentation for your children's clothing order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Children's Clothing Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Children's Clothing Manufacturer • Since 1998 • Youth Apparel Specialists</div>
        <h1 class="hero__title">Children's Clothing Manufacturer • Kids Wear and Youth Apparel for Ages 2-14 from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a children's clothing manufacturer in Bangladesh producing kids wear and youth apparel for ages 2-14 years from 300 pieces minimum. School uniforms, casual wear, sportswear, outerwear, swimwear with GOTS cotton, recycled polyester, bamboo, soft denim fabrics. CPSIA compliant, OEKO-TEX Class 1 certified. Explore our <a href="/clothing-manufacturers/" style="color:#e00;text-decoration:none;">clothing manufacturers</a> and <a href="/kids-clothing-manufacturer/" style="color:#e00;text-decoration:none;">kids clothing manufacturer</a>.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20childrens-clothing-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">2-14</span>
          <span class="hero__stat-label">Years Age Range</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>CPSIA Compliant</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>OEKO-TEX Class 1</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>EN 14682 Safety</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">✓</span>
          <span>GOTS Organic</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Age Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Age Range and Sizing</h2>
      </div>
      <div class="section__text">
        <p>We manufacture children's clothing covering the complete developmental range from ages 2-14 years, encompassing toddler through early teen stages. This comprehensive age range requires specialized sizing that accommodates rapid growth patterns while maintaining consistent fit and proportions. Our size charts are developed with anthropometric data specific to each age group, ensuring proper fit across the entire range.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Age Group</th>
              <th>Age Range</th>
              <th>Size Range</th>
              <th>Key Considerations</th>
              <th>Popular Products</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Toddler</td>
              <td>2-4 years</td>
              <td>2T-4T</td>
              <td>Diaper accommodation, easy dressing</td>
              <td>Rompers, elastic waistbands</td>
            </tr>
            <tr>
              <td>Preschool</td>
              <td>4-6 years</td>
              <td>XS-S</td>
              <td>Active play, durability</td>
              <td>T-shirts, play pants</td>
            </tr>
            <tr>
              <td>Early Elementary</td>
              <td>6-9 years</td>
              <td>S-M</td>
              <td>School wear, self-dressing</td>
              <td>Uniforms, jeans</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Late Elementary</td>
              <td>9-12 years</td>
              <td>M-L</td>
              <td>Style awareness, peer influence</td>
              <td>Trendy casual wear</td>
            </tr>
            <tr>
              <td>Early Teen</td>
              <td>12-14 years</td>
              <td>L-XL</td>
              <td>Adult styling, body changes</td>
              <td>Youth fashion, sportswear</td>
            </tr>
          </tbody>
          <caption>Size charts customizable per brand requirements. Proportional grading maintains consistency across ranges.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Safety Standards</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Safety Compliance</h2>
      </div>
      <div class="section__text">
        <p>Safety compliance is critical in children's clothing manufacturing due to vulnerable age groups and strict regulatory requirements. We maintain comprehensive safety certification and testing protocols covering all major markets and regulatory frameworks. Our safety program exceeds minimum requirements to ensure complete child protection.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Standard</th>
              <th>Region</th>
              <th>Scope</th>
              <th>Key Requirements</th>
              <th>Testing</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>CPSIA</td>
              <td>United States</td>
              <td>Children's products</td>
              <td>Lead, phthalates, flammability</td>
              <td>CPSC-accepted lab per lot</td>
            </tr>
            <tr>
              <td>EN 14682</td>
              <td>European Union</td>
              <td>Drawcord safety</td>
              <td>Cord length, positioning</td>
              <td>Third-party lab per lot</td>
            </tr>
            <tr>
              <td>OEKO-TEX Class 1</td>
              <td>Global</td>
              <td>Baby/child products</td>
              <td>Chemical safety, skin sensitivity</td>
              <td>Annual certification</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>GOTS</td>
              <td>Global</td>
              <td>Organic textiles</td>
              <td>Organic content, processing</td>
              <td>Annual inspection</td>
            </tr>
          </tbody>
          <caption>All standards maintained with full documentation and certification available for brand verification.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Product Categories</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Product Categories</h2>
      </div>
      <div class="section__text">
        <p>We manufacture five primary children's clothing categories, each serving different needs and occasions. School uniforms provide institutional attire with consistent quality and branding options. Casual wear encompasses everyday clothing including t-shirts, jeans, and comfortable garments for daily activities. Sportswear focuses on active wear for sports and physical activities with performance features. Outerwear includes jackets and vests for weather protection across seasons. Swimwear offers water-safe garments for swimming and beach activities. All categories maintain our safety standards and are available from 300 pieces minimum.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Category</th>
              <th>Products</th>
              <th>Key Features</th>
              <th>Safety Focus</th>
              <th>Price Tier</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>School Uniforms</td>
              <td>Polo shirts, dress shirts, skirts, pants, sweaters, blazers</td>
              <td>Durable, color consistent, branded</td>
              <td>Safe closures, flame resistant</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Casual Wear</td>
              <td>T-shirts, jeans, hoodies, dresses</td>
              <td>Comfortable, stylish, durable</td>
              <td>Safe construction, no small parts</td>
              <td>$</td>
            </tr>
            <tr>
              <td>Sportswear</td>
              <td>Jerseys, shorts, tracksuits, athletic wear</td>
              <td>Moisture-wicking, stretch, breathable</td>
              <td>Safe closures, reflective elements</td>
              <td>$$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Outerwear</td>
              <td>Jackets, vests, coats, rainwear</td>
              <td>Weather protection, insulated</td>
              <td>Safe closures, no detachable parts</td>
              <td>$$$</td>
            </tr>
            <tr>
              <td>Swimwear</td>
              <td>Swimsuits, board shorts, rash guards</td>
              <td>Quick-dry, UV protection</td>
              <td>Safe fit, UPF rated</td>
              <td>$$</td>
            </tr>
          </tbody>
          <caption>All categories available from 300 pieces minimum. Custom combinations possible with higher minimums.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Options</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Fabric Selection</h2>
      </div>
      <div class="section__text">
        <p>Fabric selection for children's clothing balances comfort, durability, safety, and washability. We offer multiple fabric options optimized for active children's lifestyles and frequent washing requirements. All fabrics are tested for skin sensitivity and durability to withstand active play and repeated laundering.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>Properties</th>
              <th>Durability</th>
              <th>Safety</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>GOTS Cotton</td>
              <td>Soft, breathable, natural</td>
              <td>Good</td>
              <td>OEKO-TEX Class 1</td>
              <td>Everyday wear, sensitive skin</td>
            </tr>
            <tr>
              <td>Recycled Polyester</td>
              <td>Durable, quick-dry, sustainable</td>
              <td>Excellent</td>
              <td>OEKO-TEX Class 1</td>
              <td>Sportswear, outerwear</td>
            </tr>
            <tr>
              <td>Bamboo</td>
              <td>Soft, antimicrobial, breathable</td>
              <td>Good</td>
              <td>OEKO-TEX Class 1</td>
              <td>Underwear, sleepwear</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Soft Denim</td>
              <td>Durable, structured, classic</td>
              <td>Excellent</td>
              <td>OEKO-TEX Class 1</td>
              <td>Jeans, jackets</td>
            </tr>
          </tbody>
          <caption>All fabrics tested for skin sensitivity and chemical safety. Organic options certified to GOTS standard.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">School Uniforms</span>
        <div class="accent-line"></div>
        <h2 class="section__title">School Uniform Manufacturing</h2>
      </div>
      <div class="section__text">
        <p>School uniform manufacturing requires attention to durability, color consistency, and institutional branding. We produce comprehensive school uniform programs including polo shirts with school logos, dress shirts with institutional colors, skirts and pants in uniform specifications, sweaters and cardigans for cooler weather, and blazers for formal occasions. School uniforms feature reinforced construction at stress points to withstand daily wear and frequent washing throughout the school year.</p>
        
        <p>Color consistency is critical in school uniform manufacturing to ensure that replacement garments match existing uniforms. We maintain strict color matching protocols with spectrophotometric color measurement and batch-to-batch consistency testing. This ensures that uniforms ordered in different production runs maintain identical color appearance, important for institutions with ongoing uniform programs and replacement needs.</p>
        
        <p>Branding options for school uniforms include embroidery for school logos and emblems, woven labels for identification, and color customization to match institutional colors. We offer embroidery services with precise logo reproduction and durable thread selection that withstands repeated washing. School crest embroidery can be placed on chest, sleeve, or back positions according to institutional requirements. All branding methods comply with safety standards for children's clothing.</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Price Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Price Range by Category</h2>
      </div>
      <div class="section__text">
        <p>Pricing varies by fabric type, construction complexity, safety testing requirements, and order quantity. FOB Bangladesh pricing for standard production runs. Organic fabrics, specialized safety features, and premium finishes are additional. Volume discounts available for orders exceeding 1,000 pieces.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Category</th>
              <th>300-500 pcs</th>
              <th>500-1000 pcs</th>
              <th>1000-2000 pcs</th>
              <th>2000+ pcs</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Casual T-Shirts (Cotton)</td>
              <td>$5-9</td>
              <td>$4-7</td>
              <td>$3-6</td>
              <td>$3-5</td>
            </tr>
            <tr>
              <td>Jeans (Denim)</td>
              <td>$10-16</td>
              <td>$9-14</td>
              <td>$8-12</td>
              <td>$7-11</td>
            </tr>
            <tr>
              <td>School Uniform Polo Shirts</td>
              <td>$8-14</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-9</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Sportswear Sets</td>
              <td>$12-20</td>
              <td>$11-18</td>
              <td>$10-16</td>
              <td>$9-14</td>
            </tr>
            <tr>
              <td>Outerwear Jackets</td>
              <td>$15-25</td>
              <td>$14-22</td>
              <td>$12-20</td>
              <td>$11-18</td>
            </tr>
            <tr>
              <td>Organic Cotton (Any)</td>
              <td>+$2-4</td>
              <td>+$2-3</td>
              <td>+$1-3</td>
              <td>+$1-2</td>
            </tr>
          </tbody>
          <caption>FOB Bangladesh pricing. Includes fabric, cut, sew, basic branding, safety testing. Organic premium additional.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Children's Clothing Manufacturer FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What age range do you cover for children's clothing?</h3>
          <p class="faq__answer">We manufacture children's clothing for ages 2-14 years, covering toddler through early teen sizes. Our size ranges accommodate growing children with proportional grading and consistent fit across the age spectrum. Size charts available for brand customization.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What safety standards do you follow?</h3>
          <p class="faq__answer">We follow EN 14682 for European markets, CPSIA for US markets, and OEKO-TEX Class 1 for children's products. All children's clothing undergoes rigorous testing for chemical safety, flammability, drawcord safety, and small parts to ensure complete compliance.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What children's products do you manufacture?</h3>
          <p class="faq__answer">We manufacture school uniforms with institutional branding, casual wear including t-shirts and jeans, sportswear for active children, outerwear for weather protection, and swimwear for water activities. All products available from 300 pieces minimum with safety-compliant construction.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabrics do you use for children's clothing?</h3>
          <p class="faq__answer">We use GOTS cotton for organic options, recycled polyester for sustainability, bamboo for natural softness, and soft denim for durability. All fabrics tested for skin sensitivity and durability to withstand active wear and frequent washing.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What is your minimum order for children's clothing?</h3>
          <p class="faq__answer">Our children's clothing minimum is 300 pieces per style. This applies to all product types, fabric choices, and age ranges. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">Do you offer school uniform manufacturing?</h3>
          <p class="faq__answer">Yes. We manufacture school uniforms including polo shirts, dress shirts, skirts, pants, sweaters, and blazers with institutional customization. School uniforms feature durable construction, color consistency, and branding options including embroidery and emblems.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Order Custom Children's Clothing?</h2>
      <p class="section__text">
        Contact SDF Clothing for custom children's clothing manufacturing. We provide detailed quotes, production timelines, and sample development. Kids wear and youth apparel for ages 2-14 years available from 300 pieces minimum. School uniforms, casual wear, sportswear, outerwear, swimwear with GOTS cotton, CPSIA compliant, OEKO-TEX Class 1.
      </p>
