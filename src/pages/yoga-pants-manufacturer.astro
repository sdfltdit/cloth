---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Yoga Pants Manufacturer | Custom & Low MOQ | SDF Clothing";
const pageDescription = "Custom yoga pants manufacturer in Bangladesh. 4-way stretch, moisture-wicking fabrics from 300 pieces. High-waist, flare, capri styles. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Yoga Pants Manufacturer",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for yoga pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our minimum order quantity for custom yoga pants is 300 pieces per style. This allows you to test the market with manageable inventory while accessing factory-direct pricing. The 300-piece minimum can be split across sizes within a single colorway, giving you flexibility in size distribution. Lower quantities are available for sampling and prototype development at higher per-piece costs."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric options do you offer for yoga pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer nylon/spandex blends (80/20 or 82/18) for premium performance with superior stretch recovery, polyester/spandex blends for durability and cost efficiency, cotton/spandex blends for natural feel with stretch, and recycled polyester/spandex for sustainable options. Fabric GSM ranges from 180-280 depending on compression requirements and season. All fabrics feature 4-way stretch and moisture-wicking properties."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take for custom yoga pants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline is 30-40 days from fabric receipt for basic yoga pants. Custom fabric development adds 15-20 days. Sampling takes 15-20 days before bulk production approval. Rush production is available at 20-30% premium for urgent deadlines. We recommend planning 60-75 days total from initial inquiry to delivery for first-time orders including sampling and production."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer eco-friendly yoga pants options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer recycled polyester-spandex fabrics made from post-consumer plastic bottles, certified by GRS (Global Recycled Standard). We also offer organic cotton-spandex blends certified by GOTS for natural fiber preferences. All eco-friendly options maintain the same performance standards as conventional fabrics, including 4-way stretch and moisture-wicking capabilities."
          }
        },
        {
          "@type": "Question",
          "name": "What yoga pants styles can you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture high-waist yoga pants for coverage and support, flare yoga pants for fashion styling, capri-length yoga pants for warmer climates, full-length yoga pants for standard practice, and yoga pants with pocket options for functionality. All styles are customizable with waistband height, inseam length, and compression level variations to match your brand positioning."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for yoga pants production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold OEKO-TEX Standard 100 for chemical safety in activewear fabrics, GRS for recycled material content, BSCI for social compliance, and ISO 9001 for quality management. Our Bangladesh manufacturing facility undergoes regular audits to maintain these certifications, ensuring your yoga pants meet international standards for quality and ethical production."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Yoga Pants Manufacturing Service",
      "description": "Custom yoga pants manufacturing from 300 pieces including high-waist, flare, capri styles with 4-way stretch fabrics and moisture-wicking properties",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Yoga Pants Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Yoga Pants Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "9",
              "maxPrice": "22"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Yoga Pants from SDF Clothing",
      "description": "Step-by-step process for ordering custom yoga pants from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your yoga pants design, fabric specifications (GSM preference, stretch requirements), size chart, target quantity, and style details via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your yoga pants order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review yoga pants samples for fit, stretch recovery, compression, and construction quality within 15-20 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard yoga pants items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your yoga pants order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
