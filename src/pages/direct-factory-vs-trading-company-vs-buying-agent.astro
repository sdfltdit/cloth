---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
export const prerender = true;

const pageTitle = "Direct Factory vs Trading Company vs Buying Agent for Clothing Manufacturing";
const pageDescription = "Which sourcing model actually fits your order — a direct factory, a trading company, or a buying agent? Honest comparison of MOQ, pricing, risk, and certifications, including where SDF falls short.";
const companyAge = getCompanyAgeString();

const sourcingFaqs = [
  {
    question: "Is a trading company safe for clothing manufacturing?",
    answer: "It can work fine, but you're adding a layer between yourself and the actual factory. Most of the time you won't know which factory is producing your order, the certifications you're shown belong to that factory rather than the trading company, and there's a markup baked into the price. If you're going this route, just ask directly which factory will make your order, then verify that factory's certifications yourself."
  },
  {
    question: "What is the difference between a buying agent and a trading company?",
    answer: "A buying agent works for you — usually for a fee or commission — sourcing and vetting factories on your behalf, without owning any inventory. A trading company buys from a factory and sells to you at a markup, more like a reseller. In practice, agents tend to be upfront about which factory they're using; trading companies are hit or miss on that."
  },
  {
    question: "How do I verify a clothing manufacturer is a real direct factory?",
    answer: "Ask for the business registration number and check it against the public registry (RJSC and BGMEA, if it's a Bangladesh factory). Then ask to book a visit or an audit. A real factory won't hesitate on either — a trading company or agent can't really offer this, since there's no factory of their own to show you."
  },
  {
    question: "How much markup does a trading company add to clothing manufacturing?",
    answer: "There's no fixed number — it varies by supplier — but it's an added cost sitting on top of whatever the actual factory charges, since the trading company is reselling access rather than producing anything itself. Cut that layer out and the same budget usually stretches further, whether that goes toward better fabric, faster turnaround, or just a lower price."
  },
  {
    question: "What are the risks of using a buying agent for clothing manufacturing?",
    answer: "Mainly that the agent doesn't own a factory, so you're trusting their judgment and their network — and the factory making your bulk order isn't guaranteed to be the one that made your sample. A good agent offsets some of this by arranging independent inspection, which is worth asking for. Just confirm upfront whether the sample factory and the bulk factory will be the same one."
  },
  {
    question: "Should a startup brand work directly with a factory or use an agent?",
    answer: "Depends where you are in the process. If you're new to this, an agent can help you avoid early mistakes. Once you know your specs and what you're looking for, going direct usually makes more sense — no agent fee, and you're talking straight to the people making your garments, which also means fewer delays when something needs fixing."
  }
];
const lastReviewed = "July 22, 2026";
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="website">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sourcingFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
}
</script>

<script type="application/ld+json">
{
