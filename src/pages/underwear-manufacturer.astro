---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, schemaPerson, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "Underwear Manufacturer | Premium Private Label Since 1998";
const pageDescription = "Leading underwear manufacturer since 1998. 300 piece MOQ, GOTS certified, 13 certifications. Get free FOB quote for your fashion brand collections now.";

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20underwear%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-20",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": Astro.url.href
          }
        ]
      },
      "publisher": { "@id": SITE + "/#organization" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for underwear manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most underwear manufacturers have MOQs ranging from 300 to 1,000 pieces per style. At SDF Clothing, we offer 300 piece minimums per style with flexible size and color combinations, making us ideal for startup brands and boutique labels."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose a specialized underwear manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Underwear requires specialized expertise in intimate apparel construction, comfortable fabrics, and precise sizing. Specialized manufacturers understand elastic application, seam placement for comfort, and fabric selection for sensitive skin. We focus exclusively on intimate apparel quality."
          }
        },
        {
          "@type": "Question",
          "name": "How long does underwear production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard lead time for bulk production is 30-40 days from fabric sourcing to shipment. Sample development takes 7-14 days. We provide clear timeline commitments and track production closely to ensure on-time delivery for your fashion brand."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics are best for underwear manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Popular underwear fabrics include combed cotton for softness, modal for smoothness, bamboo for sustainability, and performance blends for athletic underwear. We offer GOTS-certified organic cotton and OEKO-TEX certified materials. Each fabric has specific benefits for comfort and performance."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications should I look for in an underwear manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Key certifications include GOTS (organic cotton), OEKO-TEX (chemical safety for skin contact), BSCI (social compliance), WRAP (ethical manufacturing), ISO 9001 (quality management), and Oeko-Tex Standard 100 for textiles. SDF Clothing holds 13 international certifications."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce custom underwear designs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer full OEM and private label underwear manufacturing. We can produce custom designs based on your tech pack or help develop designs from concepts. Our capabilities include various styles including briefs, boxers, panties, bralettes, and loungewear."
          }
        },
        {
          "@type": "Question",
          "name": "What services do underwear manufacturers offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Full-service underwear manufacturers offer OEM (original equipment manufacturing), private label production, CMT (cut-make-trim), fabric sourcing, tech pack development, sampling, quality control, and packaging. SDF provides end-to-end solutions from design to delivery."
          }
        },
        {
          "@type": "Question",
          "name": "How do I find a reliable underwear manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Look for manufacturers with intimate apparel experience, verify certifications with issuing bodies, request fabric samples, check client references, and start with sample orders. Reliable manufacturers understand intimate apparel construction requirements. Contact us for samples and consultation."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Underwear Manufacturing",
      "provider": { "@id": SITE + "/#organization" },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "IT", "ES"],
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "USD",
          "price": "300",
          "description": "Starting MOQ | 300 pieces per style"
        }
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Work with an Underwear Manufacturer",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Prepare Your Tech Pack",
          "text": "Create detailed technical specifications including measurements, materials, colors, and construction details. Specify elastic types, lining requirements, and comfort features. Well-prepared tech packs reduce sampling time."
        },
        {
          "@type": "HowToStep",
          "name": "Request Quote and MOQ Confirmation",
          "text": "Submit your requirements for pricing. Confirm MOQ requirements, lead times, and payment terms. Get a written quote with all costs including fabric, production, and shipping."
        },
        {
          "@type": "HowToStep",
          "name": "Develop Samples",
          "text": "Produce pre-production samples for approval. This step typically takes 7-14 days. Test samples for fit, comfort, and fabric quality. Approve samples before bulk production."
        },
        {
          "@type": "HowToStep",
          "name": "Place Bulk Order",
          "text": "Pay deposit (typically 30%) to start production. Monitor production through regular updates and quality checks. Production time is usually 30-40 days."
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection and Shipment",
          "text": "Final inspection before shipping. Pay balance (70%) before shipment. Arrange shipping (FOB, CIF, or DDP terms). Receive goods and provide feedback for future orders."
        }
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb__item breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">Underwear Manufacturer</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<main id="main-content">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <p class="hero__label">Established 1998 | Intimate Apparel Specialists</p>
        <h1 class="hero__title">Underwear Manufacturer</h1>
        <p class="hero__description">
          SDF Clothing is a leading underwear manufacturer serving global fashion brands since 1998. We specialize in private label and OEM underwear production with 300 piece minimum orders, GOTS certified organic cotton, and 13 international quality standards. From startup brands to established labels, we deliver premium intimate apparel with comfortable fits and superior quality.
        </p>
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">300+</span>
            <span class="hero__stat-label">Pieces MOQ</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">25+</span>
            <span class="hero__stat-label">Years Experience</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">13</span>
            <span class="hero__stat-label">Certifications</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">98%</span>
            <span class="hero__stat-label">On-Time Delivery</span>
          </div>
        </div>
        <div class="hero__ctas">
          <a href={whatsappQuoteUrl} class="hero__cta hero__cta--primary" target="_blank" rel="noopener noreferrer">
            Get a Free Factory Quote
          </a>
          <a href="/contact" class="hero__cta hero__cta--secondary">
            Request Fabric Samples
          </a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/factory.jpg" alt="SDF Clothing underwear manufacturing facility" width="600" height="400" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">GOTS Certified Organic</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">BSCI Social Compliance</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">WRAP Ethical Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">C-TPAT Supply Chain Security</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">ISO 9001 Quality Management</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Overview -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">What is an Underwear Manufacturer?</h2>
      <p class="section__text">
        An underwear manufacturer specializes in producing intimate apparel including briefs, boxers, panties, bralettes, and loungewear. This category requires specialized expertise different from general garment manufacturing. Underwear demands precise construction techniques, comfortable fabric selection, elastic application expertise, and understanding of intimate fit requirements. The global underwear market exceeds $80 billion annually, with growing demand for comfortable, sustainable, and performance-oriented intimate apparel.
      </p>
      <p class="section__text">
        Underwear manufacturers offer various production models including OEM (original equipment manufacturing) where brands provide designs, private label where manufacturers offer ready-made designs with brand customization, and CMT (cut-make-trim) for brands supplying their own fabric. Specialized underwear manufacturers understand the nuances of intimate apparel - seam placement to prevent irritation, elastic width and stretch ratios for comfort, fabric selection for breathability and skin sensitivity, and sizing accuracy for proper fit.
      </p>
      <p class="section__text">
        SDF Clothing has been manufacturing underwear since 1998, serving over 500 brands across 40+ countries. We produce men's underwear (briefs, boxers, boxer briefs), women's underwear (panties, thongs, boyshorts, bralettes), and unisex styles. Our intimate apparel expertise ensures comfortable fits, durable construction, and premium quality. For brands seeking <a href="/low-moq-clothing-manufacturers">low MOQ clothing manufacturers</a> or <a href="/clothing-manufacturers-for-startups">clothing manufacturers for startups</a>, we offer 300 piece minimums with flexible sizing.
      </p>
    </div>
  </section>

  <!-- Section 2: Why Specialized Manufacturing -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Why Choose a Specialized Underwear Manufacturer?</h2>
      <p class="section__text">
        Underwear requires specialized manufacturing expertise that general garment factories may lack. Intimate apparel has unique requirements for comfort, fit, and material safety. Choosing a specialized underwear manufacturer ensures your products meet these specific requirements.
      </p>
      
      <h3 class="section__subtitle">Intimate Apparel Expertise</h3>
      <p class="section__text">
        Underwear manufacturers specialize in intimate apparel construction. We understand flat-lock seams for comfort, elastic application techniques that prevent digging, seam placement away from sensitive areas, and gusset construction for women's underwear. This expertise translates to comfortable, well-fitting garments that customers love. General manufacturers may not understand these nuances.
      </p>
      
      <h3 class="section__subtitle">Fabric Knowledge</h3>
      <p class="section__text">
        Underwear requires specific fabric characteristics: breathability, moisture-wicking, softness against skin, and durability through washing. Specialized manufacturers have deep knowledge of underwear fabrics - combed cotton for softness, modal for smoothness, bamboo for sustainability, performance blends for athletic wear. We can recommend optimal fabrics for your target market and price point.
      </p>
      
      <h3 class="section__subtitle">Elastic and Component Sourcing</h3>
      <p class="section__text">
        Underwear relies heavily on elastic, labels, and packaging. Specialized manufacturers have established supply chains for quality elastic that maintains stretch over time, soft labels that don't irritate, and premium packaging. We source elastic from certified suppliers and can provide various elastic widths, colors, and stretch ratios. Component quality significantly impacts underwear comfort and durability.
      </p>
      
      <h3 class="section__subtitle">Skin Safety Standards</h3>
      <p class="section__text">
        Underwear is in direct contact with skin, making material safety critical. Specialized manufacturers prioritize OEKO-TEX Standard 100 certification, which ensures textiles are free from harmful substances. We use certified fabrics and can provide documentation for skin safety. This is particularly important for organic and natural underwear brands targeting health-conscious consumers.
      </p>
      
      <h3 class="section__subtitle">Sizing Accuracy</h3>
      <p class="section__text">
        Underwear requires precise sizing - too loose and it doesn't stay in place, too tight and it's uncomfortable. Specialized manufacturers develop accurate size charts based on extensive fit testing. We can develop custom sizing for your brand or adapt to standard sizing systems. Proper sizing is crucial for customer satisfaction and returns reduction.
      </p>
      
      <h3 class="section__subtitle">Low MOQ Flexibility</h3>
      <p class="section__text">
        Many underwear manufacturers require large minimums, making it difficult for startup brands. SDF offers 300 piece minimums per style with flexible size and color combinations. This allows you to test designs, launch multiple styles, or scale gradually. Our low MOQ expertise makes us ideal for emerging underwear brands.
      </p>
    </div>
  </section>

  <!-- Section 3: SDF's Approach -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">How SDF Clothing Handles Underwear Manufacturing</h2>
      <p class="section__text">
        SDF Clothing approaches underwear manufacturing with intimate apparel expertise developed over 25 years. We understand that underwear is personal - customers expect comfort, quality, and fit. Our manufacturing process prioritizes these factors while offering competitive pricing and low minimums for startup brands.
      </p>
      
      <h3 class="section__subtitle">Comfort-Focused Construction</h3>
      <p class="section__text">
        We use flat-lock seams that lay flat against skin, preventing irritation. Elastic is carefully selected and applied with optimal tension - stretchy enough for comfort but secure enough to stay in place. Seams are placed away from sensitive areas. For women's underwear, we use gusset construction for comfort and hygiene. Every construction decision prioritizes wearer comfort.
      </p>
      
      <h3 class="section__subtitle">Premium Fabric Selection</h3>
      <p class="section__text">
        We offer GOTS-certified organic cotton for natural underwear brands. Combed cotton provides exceptional softness. Modal offers silky smoothness. Bamboo provides sustainable options. Performance blends with moisture-wicking are available for athletic underwear. We can source specific fabrics based on your requirements or recommend optimal options for your market.
      </p>
      
      <h3 class="section__subtitle">Certified Quality</h3>
      <p class="section__text">
        We hold 13 international certifications including GOTS (organic cotton), OEKO-TEX Standard 100 (chemical safety for skin contact), BSCI (social compliance), WRAP (ethical manufacturing), ISO 9001 (quality management), and C-TPAT (supply chain security). Each certification is verified by third-party auditors. Learn more about our <a href="/certifications">complete certification portfolio</a>. If you need help with designs, our <a href="/tech-pack-service">tech pack service</a> can assist.
      </p>
      
      <h3 class="section__subtitle">Low MOQ Specialization</h3>
      <p class="section__text">
        Our 300 piece minimum per style makes us accessible to brands testing new designs, launching multiple styles, or scaling gradually. We understand that underwear brands often need to test various styles and sizes before committing to large orders. This flexibility has made us a preferred partner for over 500 startup brands since 1998.
      </p>
      
      <h3 class="section__subtitle">Private Label Services</h3>
      <p class="section__text">
        We offer complete private label services including branded labels, custom packaging, and hang tags. For brands without designs, we offer ready-made underwear styles that can be customized with your branding. Our private label process is streamlined - we handle everything from fabric sourcing to finished, packaged goods ready for retail. Our <a href="/fit-engineering-service">fit engineering service</a> ensures proper sizing, and our <a href="/grading-service">grading service</a> provides accurate size ranges. Our <a href="/quality-inspection-service">quality inspection service</a> guarantees every garment meets standards before shipment.
      </p>
      
      <h3 class="section__subtitle">Dedicated Support</h3>
      <p class="section__text">
        Each client works with a dedicated account manager who understands intimate apparel requirements. We provide regular production updates, photos of samples, and proactively communicate about any potential delays. Our 98% on-time delivery rate reflects our commitment to reliability. Whether you need <a href="/private-label-manufacturer">private label manufacturing</a> or full OEM production, we adapt to your brand's needs.
      </p>
    </div>
  </section>

  <!-- Section 4: Fabric Options -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Underwear Fabric Options</h2>
      <p class="section__text">
        Fabric choice significantly impacts underwear comfort, performance, and positioning. Understanding different fabric options helps you select the right materials for your brand and target market.
      </p>
      
      <h3 class="section__subtitle">Combed Cotton</h3>
      <p class="section__text">
        Combed cotton is processed to remove short fibers and impurities, resulting in smoother, stronger yarn. It's softer and more durable than regular cotton, making it ideal for everyday underwear. Combed cotton is breathable, hypoallergenic, and becomes softer with each wash. We offer GOTS-certified organic combed cotton for brands prioritizing sustainability.
      </p>
      
      <h3 class="section__subtitle">Modal</h3>
      <p class="section__text">
        Modal is a semi-synthetic fabric made from beech tree pulp. It's incredibly soft, smoother than cotton, and resists pilling. Modal is 50% more absorbent than cotton, making it excellent for moisture management. It's lightweight, breathable, and maintains its shape through washing. Modal is ideal for premium underwear positioning.
      </p>
      
      <h3 class="section__subtitle">Bamboo</h3>
      <p class="section__text">
        Bamboo fabric is made from bamboo pulp and offers natural antibacterial properties, moisture-wicking, and breathability. It's incredibly soft, often described as feeling like cashmere. Bamboo is sustainable - bamboo grows quickly without pesticides. For eco-conscious underwear brands, bamboo is an excellent natural fiber option.
      </p>
      
      <h3 class="section__subtitle">Performance Blends</h3>
      <p class="section__text">
        Performance blends combine cotton or synthetic fibers with elastane (spandex) for stretch and recovery. These fabrics are ideal for athletic underwear, providing moisture-wicking, quick-dry, and shape retention. Performance blends maintain fit during activity and resist stretching out over time. We offer various performance fabric options for activewear underwear.
      </p>
      
      <h3 class="section__subtitle">Synthetic Options</h3>
      <p class="section__text">
        Synthetic fabrics like polyester and nylon offer durability, moisture-wicking, and quick-dry properties. They're less breathable than natural fibers but excel in performance applications. Synthetic underwear is ideal for athletic wear, swimwear, and situations where quick drying is important. We offer OEKO-TEX certified synthetic options.
      </p>
      
      <h3 class="section__subtitle">Fabric Certification</h3>
      <p class="section__text">
        For underwear, material safety is crucial. We prioritize OEKO-TEX Standard 100 certification, which ensures textiles are free from harmful substances. For organic claims, we provide GOTS certification with transaction certificates. Our fabric sourcing prioritizes skin safety and environmental responsibility.
      </p>
    </div>
  </section>

  <!-- Section 5: Production Process -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Underwear Production Process</h2>
      <p class="section__text">
        Understanding the underwear production process helps you manage expectations and ensure smooth collaboration with your manufacturer. Here's our complete workflow from design to delivery.
      </p>
      
      <div class="process">
        <div class="process__step">
          <div class="process__number">1</div>
          <h3 class="process__title">Design and Tech Pack</h3>
          <p class="process__text">
            Provide detailed technical specifications including measurements, materials, colors, and construction details. Specify elastic type and width, lining requirements, label placement, and packaging. For intimate apparel, specify comfort features like seam types and elastic stretch requirements. Well-prepared tech packs reduce sampling time and ensure accurate production. If you need design assistance, we can help develop concepts.
          </p>
        </div>
        
        <div class="process__step">
          <div class="process__number">2</div>
          <h3 class="process__title">Fabric Sourcing</h3>
          <p class="process__text">
            We source fabrics based on your specifications - combed cotton, modal, bamboo, or performance blends. We can provide fabric swatches for your approval before bulk production. For organic claims, we source GOTS-certified fabrics with complete documentation. Fabric sourcing typically takes 3-5 days for stock fabrics or 10-14 days for custom developments.
          </p>
        </div>
        
        <div class="process__step">
          <div class="process__number">3</div>
          <h3 class="process__title">Sample Development</h3>
          <p class="process__text">
            We develop pre-production samples for your approval, typically taking 7-14 days. You'll receive photos first, then physical samples via courier. Test samples thoroughly for fit, comfort, fabric quality, and construction. Pay special attention to elastic comfort, seam placement, and overall fit. Approve samples in writing before bulk production. Sample costs are credited against bulk orders.
          </p>
        </div>
        
        <div class="process__step">
          <div class="process__number">4</div>
          <h3 class="process__title">Bulk Production</h3>
          <p class="process__text">
            Once samples are approved, pay the deposit (typically 30%) to start production. We provide a production schedule with key milestones: cutting, sewing, elastic application, finishing, quality inspection, and packaging. Production time is usually 30-40 days from deposit to shipment. We send regular updates including production photos. Underwear production requires attention to elastic application and seam quality.
          </p>
        </div>
        
        <div class="process__step">
          <div class="process__number">5</div>
          <h3 class="process__title">Quality Inspection and Shipment</h3>
          <p class="process__text">
            Before shipment, we conduct AQL 2.5 quality inspection checking elastic application, seam strength, fabric quality, and sizing accuracy. You can request third-party inspection. Once inspection passes, pay the balance (70%) and we release shipment. We handle export documentation, customs clearance, and coordinate with your freight forwarder. Shipping time varies by destination.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Fabric Comparison Table -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Underwear Fabric Comparison</h2>
      <p class="section__text">
        Different fabrics offer unique benefits for underwear. Understanding these differences helps you select the optimal material for your brand and target market.
      </p>
      
      <div class="comparison-wrapper">
        <table class="comparison" role="table" aria-label="Comparison of underwear fabrics">
          <caption>Underwear Fabric Comparison Table</caption>
          <thead>
            <tr>
              <th>Fabric</th>
              <th>Softness</th>
              <th>Breathability</th>
              <th>Durability</th>
              <th>Cost</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Combed Cotton</strong></td>
              <td>High</td>
              <td>Very High</td>
              <td>High</td>
              <td>Low-Medium</td>
              <td>Everyday wear</td>
            </tr>
            <tr>
              <td><strong>Modal</strong></td>
              <td>Very High</td>
              <td>High</td>
              <td>Medium</td>
              <td>Medium</td>
              <td>Premium positioning</td>
            </tr>
            <tr>
              <td><strong>Bamboo</strong></td>
              <td>Very High</td>
              <td>Very High</td>
              <td>Medium</td>
              <td>Medium-High</td>
              <td>Eco-conscious brands</td>
            </tr>
            <tr>
              <td><strong>Performance Blend</strong></td>
              <td>Medium</td>
              <td>High</td>
              <td>Very High</td>
              <td>Medium</td>
              <td>Athletic underwear</td>
            </tr>
            <tr>
              <td><strong>Synthetic</strong></td>
              <td>Low-Medium</td>
              <td>Medium</td>
              <td>Very High</td>
              <td>Low</td>
              <td>Cost-effective options</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 7: Case Study -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">Success Story: US Brand Launches Premium Underwear Line</h2>
      <p class="section__text">
        A US-based premium casual wear brand approached SDF Clothing in 2023 to launch a luxury underwear collection. The brand had designed premium modal underwear with specific elastic requirements but struggled to find a manufacturer offering both modal quality and competitive pricing for their US market.
      </p>
      
      <h3 class="section__subtitle">The Challenge</h3>
      <p class="section__text">
        The brand required premium modal fabric with specific weight and hand-feel, custom elastic width, and precise seam construction. Their target market was luxury-conscious consumers seeking everyday luxury. US manufacturers quoted prices 2x above their target with 10-12 week lead times. The brand needed to launch within 4 months for the holiday season while maintaining premium positioning.
      </p>
      
      <h3 class="section__subtitle">The Solution</h3>
      <p class="section__text">
        SDF Clothing provided FOB pricing 35% below US quotes with a 5-week lead time. We sourced premium modal fabric with exact specifications, developed samples in 10 days, and accommodated their 400-piece MOQ across 3 styles with 5 sizes each. Our team provided complete fabric documentation and technical specifications. Modal quality and elastic application met premium standards.
      </p>
      
