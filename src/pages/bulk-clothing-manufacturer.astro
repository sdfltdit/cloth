---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Bulk Clothing Manufacturer for Wholesalers and Retailers";
const pageDescription = "Bulk clothing manufacturer from Bangladesh. Large quantity production, wholesale pricing, volume discounts. Container shipping for retailers. From 1000 pieces."
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": "en-GB",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com",
        "name": "SDF Clothing"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdfltd.com/#org",
      "name": "SDF Clothing",
      "url": "https://sdfltd.com",
      "description": "Bulk clothing manufacturer from Bangladesh providing large quantity production, wholesale pricing, and volume discounts to wholesalers and retailers worldwide since 1998."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order for bulk production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1000 pieces per style minimum for bulk production. Higher quantities (5000+ pieces) qualify for volume discounts. This applies per design and colorway. Size ranges included in bulk orders."
          }
        },
        {
          "@type": "Question",
          "name": "What wholesale pricing do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wholesale pricing is 20-30% lower than standard production due to economies of scale. Volume discounts available for 5000+ pieces. FOB Bangladesh pricing from $5-15 per piece depending on garment type and quantity."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer volume discounts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Volume discounts available for orders of 5000+ pieces per style. Tiered pricing: 1000-4999 pieces standard wholesale, 5000-9999 pieces 10% discount, 10000+ pieces 15% discount. Larger orders negotiable."
          }
        },
        {
          "@type": "Question",
          "name": "How does container shipping work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Container shipping for bulk orders: 20ft container holds 5000-8000 pieces depending on garment type, 40ft container holds 10000-15000 pieces. We handle export documentation, customs clearance, and freight forwarding. Door-to-door delivery available."
          }
        },
        {
          "@type": "Question",
          "name": "What large quantity production capacity do you have?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Production capacity: 50000-100000 pieces per month for bulk orders. Dedicated production lines for large volume. Quality control systems for consistent output. Flexible production scheduling for seasonal requirements."
          }
        },
        {
          "@type": "Question",
          "name": "How long does bulk production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bulk production timeline: 45-60 days from order confirmation. Fabric sourcing: 10-15 days. Production: 30-40 days. Quality inspection: 2-3 days. Packing and shipping: 3-5 days. Total: 55-65 days."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sdfltd.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Bulk Clothing Manufacturer",
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SDF Clothing accepts orders from 300 pieces per style. This low MOQ makes us ideal for startup brands and small businesses testing new designs."
          }
        },
        {
          "@type": "Question",
          "name": "How long does production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production takes 30-45 days after sample approval. Rush orders may be possible depending on factory capacity. Total lead time including shipping is typically 10-16 weeks."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>

<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<meta name="keywords" content="bulk clothing manufacturer, wholesale clothing manufacturer, volume discounts, large quantity production, container shipping, clothing wholesaler" />

<!-- Hero Section -->
<section style="padding:5rem 0 3rem;border-bottom:1px solid #e00;">
  <div class="container">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
        Bulk Clothing Manufacturer
