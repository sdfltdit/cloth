              <th>GSM Range</th>
              <th>Key Properties</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Single Jersey</td>
              <td>T-shirts, tanks, basic tops</td>
              <td>120-180 GSM</td>
              <td>Lightweight, breathable, good drape</td>
              <td>Everyday basics, summer wear</td>
            </tr>
            <tr>
              <td>Double Jersey</td>
              <td>Premium t-shirts, dresses</td>
              <td>160-220 GSM</td>
              <td>Stable, less curling, better recovery</td>
              <td>Premium basics, structured garments</td>
            </tr>
            <tr>
              <td>French Terry</td>
              <td>Hoodies, sweatshirts</td>
              <td>260-320 GSM</td>
              <td>Loop-back texture, medium weight</td>
              <td>Athleisure, casual wear</td>
            </tr>
            <tr class="comparison__row--highlight">
