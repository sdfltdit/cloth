---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Knitwear Factory | Stretch Fabric Production";
const pageDescription = "Manufacture knitwear with SDF's stretch fabric production. We specialize in knit manufacturing for global fashion brands.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Knitwear Factory",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is Bangladesh the world's largest knitwear exporter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bangladesh is the world's largest knitwear exporter due to 70% of $47B garment exports being knitwear, integrated supply chain with knitting-dyeing-finishing under one roof, competitive labor costs, duty-free access to EU and other markets, and decades of specialization in knitwear production. SDF is part of this ecosystem with direct factory access."
          }
        },
        {
          "@type": "Question",
          "name": "What knitwear structures can you produce?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We produce single jersey, double jersey, French terry, fleece, interlock, rib, pique, and waffle structures. Each structure serves different product categories: single jersey for t-shirts, French terry for hoodies, interlock for premium tops, rib for cuffs and collars. All structures available at direct factory pricing."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for knitwear production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our direct factory minimum is 300 pieces per style for all knitwear products. This applies to t-shirts, hoodies, sweaters, and activewear. For established buyers with annual commitments, we can negotiate lower minimums based on total volume across knitwear categories."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide knitting services or only finished garments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide both knitting services and finished garments. As a vertically integrated knitwear factory, we offer fabric knitting, dyeing, cutting, sewing, and finishing. Buyers can source fabric only, finished garments only, or full package production. Knitting capacity is 50,000 kg/month with 50 circular knitting machines."
          }
        },
        {
          "@type": "Question",
          "name": "What GSM range do you offer for knitwear?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer knitwear fabrics from 120 GSM lightweight to 380 GSM heavyweight. Common ranges: 140-160 GSM for lightweight t-shirts, 180-220 GSM for standard t-shirts, 260-300 GSM for hoodies and sweatshirts, 320-380 GSM for heavyweight winter wear. GSM tolerance guaranteed within ?5%."
          }
        },
        {
          "@type": "Question",
          "name": "How do you ensure knitwear quality consistency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Quality consistency through standardized knitting parameters, retained fabric samples for every order, inline quality checks at knitting, dyeing, and sewing stages, and AQL inspection before shipment. Fabric testing reports included with every shipment documenting GSM, shrinkage, and color fastness."
          }
        },
        {
          "@type": "Question",
          "name": "Can you handle complex knitwear constructions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We handle complex knitwear including jacquard patterns, striped fabrics, melange effects, and blended constructions. Our 50 circular knitting machines include various gauges (18-28 gauge) for different fabric weights and complexities. Technical knitwear for activewear with performance yarns also available."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for knitwear production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold GOTS for organic cotton knitwear, OEKO-TEX Standard 100 for chemical safety, ISO 9001 for quality management, BSCI for social compliance, GRS for recycled materials, and additional certifications. Full certification documentation provided with every shipment."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
    }
]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Knitwear Factory</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Direct Factory Access | Since 1998 | Bangladesh Knitwear</div>
        <h1 class="hero__title">Knitwear Factory | Direct Access to Bangladesh's Premier Knitwear Production Facility</h1>
        <p class="hero__description">
          SDF Clothing is a direct-access knitwear factory in Bangladesh, the world's largest knitwear exporting country. T-shirts, hoodies, sweaters, and activewear from 300 pieces with vertical integration from knitting to finishing. No agents, no markup. Direct factory access to Bangladesh's #1 knitwear hub with 50 circular knitting machines and 200,000 pieces monthly capacity.
        </p>
        <div class="hero__ctas">
          <a href="/contact" class="hero__cta hero__cta--primary">Request Factory Access</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20knitwear%20factory%20access`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">50</span>
          <span class="hero__stat-label">Knitting Machines</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Factory</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">200K</span>
          <span class="hero__stat-label">Monthly Capacity</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GOTS Organic Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Knitwear Hub</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Bangladesh | World's Largest Knitwear Exporter</h2>
      </div>
      <div class="section__text">
        <p>Bangladesh is the world's largest knitwear exporter, accounting for approximately 70% of the country's $47 billion annual garment exports. As a leading <a href="/knitwear-exporter">knitwear exporter</a>, Bangladesh offers competitive advantages for brands seeking quality knitwear production. This dominance results from decades of specialization in knitwear production, integrated supply chains with knitting-dyeing-finishing under one roof, competitive labor costs, and duty-free access to EU and other major markets through trade agreements. Bangladesh knitwear exports to USA, UK, Australia, Canada, and EU markets represent the backbone of the country's manufacturing sector.</p>
        
        <p>The knitwear sector's success is built on specialization. While many countries produce both woven and knit garments, Bangladesh focused on knitwear as its competitive advantage, developing expertise, infrastructure, and labor skills specifically for knitwear production. This specialization means Bangladesh knitwear factories like SDF achieve higher efficiency, better quality consistency, and more competitive pricing than generalist factories. The ecosystem includes fabric mills, dye houses, accessory suppliers, and skilled labor all concentrated in industrial zones, reducing logistics costs and lead times.</p>
        
        <p>SDF is part of this knitwear ecosystem, operating as a vertically integrated knitwear factory with knitting, dyeing, cutting, sewing, and finishing all under one roof. This integration reduces total production time to 25-35 days from fabric to finished goods, faster than factories that outsource fabric production. Our location in Bangladesh's knitwear hub provides access to specialized suppliers, skilled labor, and infrastructure that supports efficient knitwear production.</p>
      </div>
    </div>
  </section>

