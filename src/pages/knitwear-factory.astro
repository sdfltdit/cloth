              <td>Premium tops, activewear</td>
              <td>180-240 GSM</td>
              <td>Smooth both sides, stable, stretch</td>
              <td>Premium activewear, fitted garments</td>
            </tr>
            <tr>
              <td>Rib</td>
              <td>Cuffs, collars, waistbands</td>
              <td>180-240 GSM</td>
              <td>High stretch, recovery, textured</td>
              <td>Trims, fitted cuffs</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Pique</td>
              <td>Polo shirts, textured tops</td>
              <td>180-220 GSM</td>
              <td>Textured surface, breathable</td>
              <td>Polos, textured casual wear</td>
            </tr>
            <tr>
