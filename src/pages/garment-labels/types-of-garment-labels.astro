---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "10 Types of Garment Labels Every Brand Should Know";
const pageDescription = "Main, size, care, fiber content, RFID and 6 more garment label types explained — what each one does, its typical material, and where it's placed.";

const labelTypes = [
  {
    id: "main-brand-label",
    name: "Main / Brand Label",
    definition: "The main label, also called the brand label, is the primary label carrying the brand name or logo, usually placed at the center back neck.",
    function: "Identifies the brand and functions as the first physical brand touchpoint a customer sees after purchase.",
    material: "Woven damask, satin, or printed cotton, depending on the brand's positioning and budget.",
    placement: "Center back neck, most commonly. Some brands move it to the side seam or waistband for a cleaner neckline.",
    note: "This is almost always the highest-visibility label on the garment, so material and print quality directly affect perceived product quality.",
  },
  {
    id: "size-label",
    name: "Size Label",
    definition: "The size label states the garment's size using a letter (S, M, L), a number, or both, following the sizing system of the target market.",
    function: "Helps the customer and retailer identify the correct fit quickly, especially important for online returns processing.",
    material: "Printed satin or cotton tape, sometimes combined with the main or care label to reduce the number of separate labels.",
    placement: "Side seam or inside the main label, positioned for quick visual scanning.",
    note: "Size labels must match the sizing standard the brand publishes elsewhere — a mismatch between the label and the size chart is a common source of return disputes.",
  },
  {
    id: "care-label",
    name: "Care Label",
    definition: "The care label displays washing, drying, ironing, bleaching, and dry-cleaning instructions using standardized care symbols.",
    function: "Tells the wearer how to maintain the garment without damaging fabric, print, or structure.",
    material: "Printed satin or nylon tape, chosen for softness against the skin since it usually sits directly on the neckline.",
    placement: "Center back neck, either as a separate label below the main label or combined with it.",
    note: "Care symbols follow the ISO 3758 standard internationally, while the US uses text-based instructions under the FTC Care Labeling Rule instead of symbols alone.",
  },
  {
    id: "fiber-content-label",
    name: "Fiber Content Label",
    definition: "The fiber content label lists the exact fiber composition of the garment by percentage, such as '95% Cotton, 5% Elastane.'",
    function: "Legally required disclosure in most major markets, and a key input for how the customer expects the garment to feel, stretch, and wear.",
    material: "Printed satin, cotton, or woven tape — must remain legible for the life of the garment in most jurisdictions.",
    placement: "Center back neck, usually combined with the care label into a single tag.",
    note: "Fiber names must match the official regulatory generic names — only fiber names permitted under the applicable regulation may be used, not marketing terms.",
  },
  {
    id: "country-of-origin-label",
    name: "Country of Origin Label",
    definition: "The country of origin label states where the garment was manufactured, typically as 'Made in [Country].'",
    function: "Legally mandated customs and consumer-disclosure requirement in the US, EU, and most import markets.",
    material: "Printed satin or cotton tape, usually combined with the fiber content and care label.",
    placement: "Center back neck, grouped with fiber content and care information.",
    note: "Country of origin is determined by where the garment underwent its last 'substantial transformation,' not simply where fabric was sourced — this matters for multi-country supply chains.",
  },
  {
    id: "warning-label",
    name: "Warning Label",
    definition: "The warning label communicates safety hazards, most commonly flammability risk, choking hazards from small parts, or drawstring safety notices for children's wear.",
    function: "Reduces liability and protects the wearer, particularly critical for children's sleepwear and infant garments.",
    material: "Printed satin or heat transfer, chosen for high-contrast readability.",
    placement: "Center back neck for general warnings; hangtag or hem for point-of-sale flammability notices.",
    note: "Children's sleepwear in the US falls under CPSC flammability standards (16 CFR Part 1615/1616), which carry specific warning label language requirements distinct from general apparel.",
  },
  {
    id: "heat-transfer-label",
    name: "Heat Transfer Label",
    definition: "A heat transfer label is applied directly to the fabric surface using heat and pressure rather than sewn on, leaving no stitched edge.",
    function: "Delivers a soft, tag-free feel — popular for activewear, underwear, and children's wear where a stitched label could cause skin irritation.",
    material: "Vinyl, PU, or silicone-based transfer film.",
    placement: "Inside back neck or waistband, applied flat against the fabric.",
    note: "Heat transfer labels avoid the itch factor of a woven label but are generally less durable under high-heat industrial laundering than a sewn label.",
  },
  {
    id: "flag-label",
    name: "Flag Label",
    definition: "A flag label is a small folded label sewn into a side seam so that one end protrudes visibly from the garment, often carrying a size or brand mark.",
    function: "Adds a distinctive branding detail visible even when the garment is folded or displayed on a hanger.",
    material: "Woven or printed satin, folded and sewn along a seam.",
    placement: "Side seam, typically at the hem or underarm.",
    note: "Flag labels are a design accent more than a compliance label — brands use them for shelf differentiation rather than required disclosure.",
  },
  {
    id: "loop-label",
    name: "Loop Label",
    definition: "A loop label is a folded label sewn into a seam to form a small hanging loop, historically used for hanging the garment without a hanger.",
    function: "Functional hanging point on some garment categories, and a recognizable branding element on others.",
    material: "Woven or twill tape.",
    placement: "Center back neck or side seam, folded into a loop shape.",
    note: "Loop labels have become more of a heritage branding signal than a functional necessity, since most garments today are displayed on hangers rather than hooks.",
  },
  {
    id: "rfid-smart-label",
    name: "RFID / Smart Label",
    definition: "An RFID or smart label embeds a radio-frequency identification chip into the label substrate, allowing the garment to be scanned electronically for inventory, authentication, or supply chain tracking.",
    function: "Enables retail inventory automation, loss prevention, and — increasingly — digital product passport compliance for EU-bound apparel.",
    material: "Woven or printed label with an embedded RFID inlay, or a separate adhesive RFID tag.",
    placement: "Center back neck or a dedicated hangtag, depending on whether it needs to survive laundering.",
    note: "The EU's Digital Product Passport requirement, phasing in for textiles from 2027 under the Ecodesign for Sustainable Products Regulation, is accelerating RFID and QR-based smart label adoption ahead of the mandate.",
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Garment Labels", "item": "https://sdfltd.com/garment-labels/" },
          { "@type": "ListItem", "position": 3, "name": "Types of Garment Labels", "item": Astro.url.href }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between a main label and a care label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A main label identifies the brand name or logo and is primarily a branding tool. A care label instructs the wearer on washing, drying, and ironing using standardized care symbols, and in most markets is a required disclosure rather than an optional branding element. The two are often physically joined into a single folded tag but serve different purposes."
          }
        },
        {
          "@type": "Question",
          "name": "What is a flag label on clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A flag label is a small folded label sewn into a garment's side seam so that one end protrudes and remains visible from the outside, often displaying a size mark or brand symbol. It is primarily a branding and shelf-differentiation detail rather than a required compliance label."
          }
        },
        {
          "@type": "Question",
          "name": "Do all garments need a country of origin label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most major import markets, including the United States and the European Union, require a country of origin disclosure on apparel. The origin is determined by where the garment underwent its last substantial transformation during manufacturing, which is not always the same country where the fabric itself was produced."
          }
        },
        {
          "@type": "Question",
          "name": "What is an RFID smart label used for in clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An RFID smart label embeds a radio-frequency chip into the garment label, allowing retailers to scan items electronically for inventory counts, loss prevention, and authentication. Adoption is accelerating ahead of the EU's Digital Product Passport requirement for textiles, which begins phasing in from 2027."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/garment-labels/">Garment Labels</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Types of Garment Labels</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Garment Labels • Types</div>
        <h1 class="hero__title">Types of Garment Labels: A Complete Breakdown</h1>
        <p class="hero__description">
          A single garment usually carries three or more label types working together — branding, care, compliance, and sometimes technology. Here is what each of the ten core garment label types does, what it is made from, and where it belongs.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Quick Reference</span>
        <div class="accent-line"></div>
        <h2 class="section__title">The 10 Garment Label Types at a Glance</h2>
      </div>
      <div class="table-wrapper">
        <table class="reference-table">
          <thead>
            <tr>
              <th>Label Type</th>
              <th>Primary Purpose</th>
              <th>Typical Placement</th>
            </tr>
          </thead>
          <tbody>
            {labelTypes.map((label) => (
              <tr>
                <td><a href={`#${label.id}`}>{label.name}</a></td>
                <td>{label.function}</td>
                <td>{label.placement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {labelTypes.map((label, index) => (
    <section class={`section ${index % 2 === 1 ? "section--alt" : ""}`} id={label.id}>
      <div class="section__container">
        <div class="section__header">
          <span class="section__label">Label Type {index + 1} of 10</span>
          <div class="accent-line"></div>
          <h2 class="section__title">{label.name}</h2>
        </div>
        <div class="section__text">
          <p>{label.definition}</p>
        </div>
        <div class="detail-grid">
          <div class="detail-card">
            <h3 class="detail-card__title">Function</h3>
            <p class="detail-card__text">{label.function}</p>
          </div>
          <div class="detail-card">
            <h3 class="detail-card__title">Typical Material</h3>
            <p class="detail-card__text">{label.material}</p>
          </div>
          <div class="detail-card">
            <h3 class="detail-card__title">Placement</h3>
            <p class="detail-card__text">{label.placement}</p>
          </div>
        </div>
        <p class="section__text section__text--note">{label.note}</p>
      </div>
    </section>
  ))}

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Not Sure Which Label Types Your Product Needs?</h2>
      <p class="section__text">SDF Clothing's technical team reviews your product category and target markets, then recommends the exact label set required for compliance and branding — before your first sample is cut.</p>
      <div class="section__ctas">
        <a href="/#contact" class="section__cta section__cta--primary">Get a Free Label & Trim Consultation</a>
        <a href="/garment-labels/materials-and-manufacturing/" class="section__cta section__cta--secondary">See Label Materials →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-xl) 0;
    scroll-margin-top: 2rem;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .section__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .section__text--note {
    padding-left: var(--spacing-sm);
    border-left: 3px solid var(--color-primary);
    font-size: 0.9375rem;
    margin-top: var(--spacing-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin-top: var(--spacing-md);
  }

  .reference-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .reference-table th,
  .reference-table td {
    padding: var(--spacing-sm);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .reference-table th {
    background: var(--color-bg-alt);
    font-weight: 600;
    color: var(--color-text);
  }

  .reference-table td a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .reference-table td a:hover {
    text-decoration: underline;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    margin: var(--spacing-md) 0;
  }

  .detail-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-sm);
  }

  .detail-card__title {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
    font-weight: 600;
  }

  .detail-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }

    .reference-table {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
