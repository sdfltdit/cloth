---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Garment Label Placement & Required Information";
const pageDescription = "Where garment labels go — neck, side seam, waistband, hem — and what information, from RN numbers to barcodes, each placement zone legally needs.";

const placementZones = [
  { zone: "Neck", garments: "T-shirts, shirts, dresses, sweaters", labels: "Main/brand label, care label, fiber content, country of origin" },
  { zone: "Side Seam", garments: "T-shirts, activewear, dresses", labels: "Size label, flag label, RN/CA number" },
  { zone: "Waistband", garments: "Trousers, shorts, skirts, underwear", labels: "Main label, size label, RFID tag" },
  { zone: "Hem", garments: "T-shirts, jackets, trousers", labels: "Care label (as an alternative to neck placement), warning label" },
  { zone: "Pocket", garments: "Jeans, trousers, jackets", labels: "Leather patch, brand flag label" },
  { zone: "Sleeve", garments: "Jackets, sweatshirts", labels: "Brand flag label, size label on some technical wear" },
];

const infoFields = [
  { field: "Brand", text: "The brand name or registered trademark. Not legally mandated in most markets, but effectively required for any commercial product." },
  { field: "Size", text: "The size designation using the sizing standard of the target market — US, UK, EU, and Asian size systems all differ, and a garment sold in multiple markets sometimes needs multiple size references." },
  { field: "Care Symbols", text: "Standardized icons for washing, bleaching, drying, ironing, and professional cleaning, governed internationally by ISO 3758. The United States uses the FTC Care Labeling Rule (16 CFR Part 423), which permits either symbols or written instructions." },
  { field: "Fiber Composition", text: "The percentage breakdown of fibers in the garment, using only the generic fiber names permitted under the applicable regulation — the US Textile Fiber Products Identification Act in America, or Regulation (EU) No 1007/2011 in the European Union." },
  { field: "Country of Origin", text: "Where the garment underwent its last substantial transformation during manufacturing. Required for customs clearance in the US, EU, and most import markets, independent of where the raw fabric originated." },
  { field: "Style No.", text: "An internal reference number the brand or factory uses to identify the specific style, color, and sometimes production batch — mainly an operational tool for reordering and quality tracking rather than a compliance requirement." },
  { field: "Barcode/QR", text: "A scannable code linking to retail SKU data, or increasingly, to a digital product passport carrying supply chain and material information — a category the EU is moving toward mandating for textiles from 2027 under the Ecodesign for Sustainable Products Regulation." },
  { field: "RN/CA Number", text: "A Registered Identification Number (RN) issued by the US Federal Trade Commission, or a Canadian Attorney (CA) number issued by the Competition Bureau of Canada, identifying the business responsible for the product. An RN is optional under US law but common practice, since it lets a company use a number instead of its full legal name on the label; once issued, one RN covers all of a company's products." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Garment Labels", "item": "https://sdfltd.com/garment-labels/" },
          { "@type": "ListItem", "position": 3, "name": "Placement & Required Information" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where should a size label go on clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Size labels are most commonly placed at the side seam, roughly at underarm or waist height depending on garment type, where they can be located quickly by a customer or retail associate without unfolding the garment. Some brands combine the size label with the main neck label instead, particularly on simpler garments like basic t-shirts."
          }
        },
        {
          "@type": "Question",
          "name": "What information must legally appear on a clothing label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the United States, fiber content and country of origin are legally required on nearly all apparel, and care instructions are required under the FTC Care Labeling Rule. In the European Union, fiber content labeling is mandatory under Regulation 1007/2011, while care and origin labeling are recommended rather than strictly mandated by that specific regulation, though many EU member states and retailers require them in practice."
          }
        },
        {
          "@type": "Question",
          "name": "What is an RN number on a clothing label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An RN, or Registered Identification Number, is issued by the US Federal Trade Commission and identifies the business responsible for a textile, wool, or fur product. It is optional — a company may use its full legal name instead — but registering for an RN lets a brand display a number rather than its complete legal business name on labels, and one RN covers all products from that company."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/garment-labels/">Garment Labels</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Placement & Required Information</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Garment Labels • Placement & Information</div>
      <h1 class="hero__title">Garment Label Placement and Required Information</h1>
      <p class="hero__description">
        Where a label goes is a comfort and manufacturing decision. What it says is, in most cases, a legal one. Here is how the two work together across the common placement zones.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Placement Zones</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Standard Garment Label Placement Zones</h2>
      </div>
      <div class="section__text">
        <p>Placement is driven by two factors: which garment category it is, and which labels need to be visible or scannable without unfolding the item.</p>
      </div>
      <div class="table-wrapper">
        <table class="reference-table">
          <thead>
            <tr>
              <th>Placement Zone</th>
              <th>Common Garment Types</th>
              <th>Labels Typically Placed Here</th>
            </tr>
          </thead>
          <tbody>
            {placementZones.map((zone) => (
              <tr>
                <td>{zone.zone}</td>
                <td>{zone.garments}</td>
                <td>{zone.labels}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Required Fields</span>
        <div class="accent-line"></div>
        <h2 class="section__title">What Information Must Appear on a Label</h2>
      </div>
      <div class="section__text">
        <p>Eight fields cover almost every piece of information a garment label carries. Not all eight are legally mandatory in every market — see the <a href="/garment-labels/compliance-and-certification/">Compliance & Certification guide</a> for the specific legal requirements by country.</p>
      </div>
      <div class="info-list">
        {infoFields.map((info) => (
          <div class="info-item">
            <h3 class="info-item__title">{info.field}</h3>
            <p class="info-item__text">{info.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Practical Impact</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How Placement Affects Comfort and Compliance</h2>
      </div>
      <div class="section__text">
        <p>Neck placement is the default for information-dense labels — care, fiber, and origin — because it is the one spot a customer reliably checks. But it is also the highest-friction skin contact zone on the garment, which is exactly why heat transfer and tag-free label options concentrated on activewear and children's wear over the past decade.</p>

        <p>Side seam and waistband placement solve the comfort problem but introduce a visibility tradeoff: a size label at the side seam is easy to check on a hanger, but a customer trying the garment on will not see it as readily as a neck label. Brands producing multi-market SKUs often split information across two zones deliberately — brand and legally required disclosures at the neck, size and internal reference numbers at the side seam — rather than cramming every field into one location.</p>

        <p>Getting placement wrong is a common source of first-run sample rejections. A size label sewn too close to a side seam allowance can pucker the fabric after the first wash; a neck label using a stiff woven material on a lightweight jersey tee can distort the neckline. These are the kinds of issues a factory catches at the pre-production sample stage — see the <a href="/garment-labels/buyer-guidelines/">Buyer Guidelines & Approval Process guide</a> for how that review typically works.</p>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Building Your Label Spec Sheet?</h2>
      <p class="section__text">Use SDF Clothing's free wash care label generator to build compliant care symbol sets, or talk to our team about placement standards for your specific product category.</p>
      <div class="section__ctas">
        <a href="/tools/wash-care-label-generator" class="section__cta section__cta--primary">Try the Wash Care Label Generator</a>
        <a href="/garment-labels/compliance-and-certification/" class="section__cta section__cta--secondary">See Compliance Requirements →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .section__text a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .section__text a:hover {
    text-decoration: underline;
  }

  .table-wrapper {
    overflow-x: auto;
    margin-top: var(--spacing-md);
  }

  .reference-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .reference-table th,
  .reference-table td {
    padding: var(--spacing-sm);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .reference-table th {
    background: var(--color-bg-alt);
    font-weight: 600;
    color: var(--color-text);
  }

  .info-list {
    margin-top: var(--spacing-md);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .info-item {
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .info-item__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .info-item__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .info-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }

    .reference-table {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
