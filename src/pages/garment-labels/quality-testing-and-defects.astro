---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Garment Label Quality Testing & Common Defects";
const pageDescription = "Color fastness, wash durability, and attachment strength testing for garment labels — plus the 6 most common label defects and how factories prevent them.";

const qualityTests = [
  { name: "Color Fastness", text: "Tests whether label colors resist bleeding, fading, or transferring onto the garment fabric during washing, rubbing, and exposure to light. A failed color fastness test on a label can stain the surrounding fabric — a defect that ruins the entire garment, not just the label." },
  { name: "Wash Durability", text: "Simulates the number of industrial or home wash cycles a label survives before text becomes illegible, edges fray, or the print begins to lift. Care labels are held to the highest wash durability standard since they need to remain legible for the functional life of the garment." },
  { name: "Print Quality", text: "Checks registration accuracy, text sharpness, and consistency of ink density across a production run. Print quality issues often only surface at scale — a design that looks correct on a first proof can drift out of register once a press runs thousands of repeats." },
  { name: "Attachment Strength", text: "Measures the force required to pull a label loose from the garment, whether sewn, heat-applied, or adhesive-bonded. A pull test below the required threshold signals a stitching or bonding process that will fail in a customer's hands, not just in the lab." },
];

const defects = [
  { name: "Misprint", text: "Incorrect text, a garbled barcode, or a design that has drifted out of registration during printing. Caught through in-line visual inspection and periodic barcode scan verification during the production run, not just a final spot check." },
  { name: "Wrong Size", text: "A size label that does not match the garment's actual measurements, usually caused by a mix-up between similar SKUs on the cutting or sewing line. Prevented through batch-level label reconciliation against the cutting ticket before labels reach the sewing station." },
  { name: "Wrong Information", text: "Fiber content, care instructions, or country of origin that does not match the actual garment construction — often the result of a fabric substitution made after labels were already ordered. This is a compliance risk, not just a cosmetic one, and requires a documented change-control process whenever fabric or trim specifications change mid-order." },
  { name: "Color Variation", text: "Noticeable shade difference between labels within the same order, typically from dye lot inconsistency in woven labels or ink batch variation in printed ones. Managed by testing against an approved color standard (a physical swatch or Pantone reference) at the start of each production run, not just visually matching to memory." },
  { name: "Fraying", text: "Unraveling at a label's cut edge, most common on woven labels with an unsealed or improperly heat-cut edge. Laser cutting or proper heat-sealing at the fold eliminates most fraying before it reaches a customer." },
  { name: "Poor Adhesion", text: "A heat-transfer or adhesive label that lifts or peels after washing, usually from incorrect application temperature, pressure, or dwell time during the heat press cycle. Requires calibrated press settings that are tested against the specific fabric-label combination, since the same settings do not work identically across different fabric weights." },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Garment Labels", "item": "https://sdfltd.com/garment-labels/" },
          { "@type": "ListItem", "position": 3, "name": "Quality Testing & Defects", "item": Astro.url.href }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is color fastness testing on a garment label?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Color fastness testing checks whether a label's colors resist bleeding, fading, or transferring onto the surrounding garment fabric during washing, rubbing, and light exposure. A label that fails color fastness testing can stain the fabric it is attached to, which ruins the entire garment rather than just the label."
          }
        },
        {
          "@type": "Question",
          "name": "What causes poor adhesion on heat transfer labels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Poor adhesion is usually caused by incorrect temperature, pressure, or dwell time during the heat press application cycle. The correct settings vary by fabric weight and composition, so a press setting calibrated for one fabric will not necessarily bond correctly to a different one — testing the specific fabric-label combination before a production run is the standard way to prevent it."
          }
        },
        {
          "@type": "Question",
          "name": "How do factories prevent wrong information on garment labels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wrong information on a label — such as fiber content that does not match the actual fabric used — is typically prevented through a documented change-control process that flags any fabric or trim substitution and requires label content to be re-verified before production continues, rather than relying on the original label order staying correct by default."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/garment-labels/">Garment Labels</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Quality Testing & Defects</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Garment Labels • Quality & Defects</div>
      <h1 class="hero__title">Garment Label Quality Testing and Common Defects</h1>
      <p class="hero__description">
        A label defect rarely stays contained to the label — it becomes a garment defect, a compliance issue, or a customer complaint. Here is how quality is tested, and where labels most often go wrong.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Quality Tests</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Core Label Quality Tests</h2>
      </div>
      <div class="test-grid">
        {qualityTests.map((test) => (
          <div class="test-card">
            <h3 class="test-card__title">{test.name}</h3>
            <p class="test-card__text">{test.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Defect Prevention</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Common Garment Label Defects</h2>
      </div>
      <div class="section__text">
        <p>Six defects account for most label-related quality issues in production. Each has a specific, preventable cause — labels rarely fail randomly.</p>
      </div>
      <div class="defect-list">
        {defects.map((defect) => (
          <div class="defect-item">
            <h3 class="defect-item__title">{defect.name}</h3>
            <p class="defect-item__text">{defect.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Our Process</span>
        <div class="accent-line"></div>
        <h2 class="section__title">How SDF Prevents Label Defects</h2>
      </div>
      <div class="section__text">
        <p>Because SDF Clothing produces labels in-house alongside the garments they attach to, label quality control is built into the same pre-production and in-line inspection process used for the garment itself, rather than treated as a separate trim-vendor handoff. Pre-production samples include the final label construction — not a placeholder — so color, placement, and attachment strength are verified before bulk cutting begins.</p>

        <p>During bulk production, labels are checked against the approved color standard at defined intervals, and attachment strength is spot-tested on a sampling basis consistent with the order's AQL requirement. For a broader look at how AQL-based inspection works across an entire order, see the <a href="/insights/AQL-inspection-explained">AQL Inspection Explained guide</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Ready to Move From Sample to Bulk Approval?</h2>
      <p class="section__text">See how label specifications move through SDF's approval process — from spec sheet to pre-production sample to bulk sign-off.</p>
      <div class="section__ctas">
        <a href="/garment-labels/buyer-guidelines/" class="section__cta section__cta--primary">See the Approval Process</a>
        <a href="/contact/" class="section__cta section__cta--secondary">Talk to Our QC Team</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-xl) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .section__text a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .section__text a:hover {
    text-decoration: underline;
  }

  .test-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .test-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--spacing-md);
  }

  .test-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .test-card__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .defect-list {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .defect-item {
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .defect-item:last-child {
    border-bottom: none;
  }

  .defect-item__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .defect-item__text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .test-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
