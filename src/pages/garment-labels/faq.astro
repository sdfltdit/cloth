---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;

const pageTitle = "Garment Label FAQs: Common Questions Answered";
const pageDescription = "Answers to the most common garment label questions — legal requirements, materials, costs, and placement — from a Bangladesh apparel manufacturer.";

const faqGroups = [
  {
    category: "Types & Definitions",
    sourceLink: "/garment-labels/types-of-garment-labels/",
    sourceLabel: "Types of Garment Labels guide",
    items: [
      { q: "What is a garment label?", a: "A garment label is a piece of fabric, printed material, or synthetic substrate attached to a clothing item that carries information such as brand, size, fiber content, care instructions, and country of origin." },
      { q: "What is the difference between a main label and a care label?", a: "A main label identifies the brand and is primarily a branding tool. A care label instructs the wearer on washing and maintenance using standardized care symbols, and in most markets is a required disclosure rather than an optional branding element." },
      { q: "What is a flag label on clothing?", a: "A flag label is a small folded label sewn into a side seam so one end protrudes and stays visible, often showing a size mark or brand symbol — mainly a branding detail rather than a compliance requirement." },
      { q: "What is an RFID smart label used for?", a: "An RFID smart label embeds a radio-frequency chip into the label, enabling electronic inventory scanning, loss prevention, and authentication — adoption is accelerating ahead of the EU's 2027 Digital Product Passport requirement for textiles." },
    ],
  },
  {
    category: "Materials & Manufacturing",
    sourceLink: "/garment-labels/materials-and-manufacturing/",
    sourceLabel: "Materials & Manufacturing guide",
    items: [
      { q: "Are woven labels more expensive than printed labels?", a: "Yes at low volumes — woven labels need a physical loom setup, making printed labels typically 15-30% cheaper at equivalent size and small quantity. The cost gap narrows significantly at higher volumes as setup cost amortizes." },
      { q: "Which label material works best for activewear?", a: "TPU and silicone are the most common choices because they are flexible, moisture-resistant, and can be heat-applied for a tag-free feel that will not chafe skin during movement." },
      { q: "What is the difference between embossing and debossing?", a: "Embossing raises a design above the material surface; debossing presses it below. Both use heat and pressure and are most commonly applied to leather or PU patches." },
    ],
  },
  {
    category: "Placement & Required Information",
    sourceLink: "/garment-labels/placement-and-required-information/",
    sourceLabel: "Placement & Required Information guide",
    items: [
      { q: "Where should a size label go on clothing?", a: "Most commonly at the side seam, at underarm or waist height, where it can be checked without unfolding the garment. Some brands combine it with the main neck label instead." },
      { q: "What is an RN number on a clothing label?", a: "A Registered Identification Number issued free by the US Federal Trade Commission, identifying the business responsible for the product. It's optional — a full legal name can be used instead — but one RN covers all of a company's products." },
    ],
  },
  {
    category: "Compliance & Certification",
    sourceLink: "/garment-labels/compliance-and-certification/",
    sourceLabel: "Compliance & Certification guide",
    items: [
      { q: "Is a care label legally required in the US?", a: "Yes. The FTC Care Labeling Rule (16 CFR Part 423) requires most apparel sold in the US to carry permanent care instructions covering washing, bleaching, drying, ironing, and dry cleaning." },
      { q: "Is fiber content labeling mandatory in the EU?", a: "Yes, under Regulation (EU) No 1007/2011, which also requires using only the approved generic fiber names. Care and origin labeling are recommended under this regulation but not mandated by it directly, though many member states and retailers require them in practice." },
      { q: "What is the difference between GOTS, GRS, and OEKO-TEX?", a: "GOTS certifies organic fiber content across the supply chain (minimum 70%). GRS certifies recycled fiber content with chain-of-custody tracking. OEKO-TEX Standard 100 tests the finished product for harmful chemicals but does not certify organic or recycled content." },
    ],
  },
  {
    category: "Quality & Defects",
    sourceLink: "/garment-labels/quality-testing-and-defects/",
    sourceLabel: "Quality Testing & Defects guide",
    items: [
      { q: "What is color fastness testing on a garment label?", a: "It checks whether a label's colors resist bleeding, fading, or transferring onto the surrounding fabric during washing and light exposure. A failed test can stain the garment fabric itself." },
      { q: "What causes poor adhesion on heat transfer labels?", a: "Usually incorrect temperature, pressure, or dwell time during the heat press cycle — the correct settings vary by fabric weight, so testing the specific fabric-label combination beforehand is standard practice." },
    ],
  },
  {
    category: "Buyer Process",
    sourceLink: "/garment-labels/buyer-guidelines/",
    sourceLabel: "Buyer Guidelines guide",
    items: [
      { q: "What should be included in a label spec sheet?", a: "Label type and quantity, material and construction method, exact dimensions with tolerance, a physical color reference such as a Pantone code, precise compliance text content, and placement shown on a tech pack sketch." },
      { q: "What is a PP sample in the label approval process?", a: "A pre-production sample is a garment made from actual production fabric with the approved label attached — the checkpoint where placement, comfort, and compliance content are reviewed together before bulk production begins." },
    ],
  },
];

const allFaqSchemaItems = faqGroups.flatMap((group) =>
  group.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
          { "@type": "ListItem", "position": 2, "name": "Garment Labels", "item": "https://sdfltd.com/garment-labels/" },
          { "@type": "ListItem", "position": 3, "name": "FAQ" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": allFaqSchemaItems
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item"><a href="/garment-labels/">Garment Labels</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">FAQ</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__label">Garment Labels • FAQ</div>
      <h1 class="hero__title">Garment Label FAQs</h1>
      <p class="hero__description">
        Quick answers to the questions fashion brands ask most often about garment labels. Each answer links to a full guide with more detail.
      </p>
    </div>
  </section>

  {faqGroups.map((group, groupIndex) => (
    <section class={`section ${groupIndex % 2 === 1 ? "section--alt" : ""}`}>
      <div class="section__container">
        <div class="section__header">
          <span class="section__label">{group.category}</span>
          <div class="accent-line"></div>
        </div>
        <div class="faq">
          {group.items.map((item) => (
            <div class="faq__item">
              <h2 class="faq__question">{item.q}</h2>
              <p class="faq__answer">{item.a}</p>
            </div>
          ))}
        </div>
        <a href={group.sourceLink} class="section__more-link">Read the full {group.sourceLabel} →</a>
      </div>
    </section>
  ))}

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">Still Have Questions About Labels for Your Product?</h2>
      <p class="section__text">Our technical team can review your specific product category, materials, and target markets and tell you exactly what your labels need.</p>
      <div class="section__ctas">
        <a href="/#contact" class="section__cta section__cta--primary">Ask Our Team</a>
        <a href="/garment-labels/" class="section__cta section__cta--secondary">Back to Garment Labels Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --color-primary: #e00;
    --color-primary-dark: #b00;
    --color-text: #fff;
    --color-text-muted: #ccc;
    --color-bg: #0a0a0a;
    --color-bg-alt: #111;
    --color-border: #333;
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .breadcrumb {
    padding: var(--spacing-sm) 0;
  }

  .breadcrumb__list {
    display: flex;
    list-style: none;
    gap: var(--spacing-xs);
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .breadcrumb__item:not(:last-child)::after {
    content: "/";
    margin-left: var(--spacing-xs);
    color: var(--color-border);
  }

  .breadcrumb__item a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb__item a:hover {
    color: var(--color-primary);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
  }

  .hero {
    padding: var(--spacing-lg) 0;
  }

  .hero__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .hero__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.2;
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .section {
    padding: var(--spacing-lg) 0;
  }

  .section--alt {
    background: var(--color-bg-alt);
  }

  .section--cta {
    padding: var(--spacing-xl) 0;
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    text-align: center;
  }

  .section__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section--cta .section__container {
    max-width: 700px;
  }

  .section__header {
    margin-bottom: var(--spacing-md);
  }

  .section__label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
  }

  .accent-line {
    width: 60px;
    height: 3px;
    background: var(--color-primary);
  }

  .section__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.3;
  }

  .section__text {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
  }

  .faq {
    margin-top: var(--spacing-sm);
  }

  .faq__item {
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .faq__question {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .faq__answer {
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: 1rem;
  }

  .section__more-link {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .section__more-link:hover {
    text-decoration: underline;
  }

  .section__ctas {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    flex-wrap: wrap;
  }

  .section__cta {
    display: inline-block;
    padding: 1rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .section__cta--primary {
    background: var(--color-primary);
    color: white;
  }

  .section__cta--primary:hover {
    background: var(--color-primary-dark);
  }

  .section__cta--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .section__cta--secondary:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--spacing-lg) 0;
    }

    .section__ctas {
      flex-direction: column;
    }
  }

  @media (prefers-color-scheme: light) {
    :root {
      --color-text: #1a1a1a;
      --color-text-muted: #666;
      --color-bg: #fff;
      --color-bg-alt: #f5f5f5;
      --color-border: #e0e0e0;
    }
  }
</style>
