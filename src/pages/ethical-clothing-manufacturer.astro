---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "Ethical Clothing Manufacturer | Fair Trade & BSCI | SDF";
const pageDescription = "Ethical clothing manufacturer with BSCI, WRAP, Fair Trade certifications. Fair wages, safe conditions, no forced labor. EU/UK/US compliant since 1998.";

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20ethical%20clothing%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": Astro.url.href
          }
        ]
      },
      "publisher": { "@id": SITE + "/#org" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What makes a clothing manufacturer ethical?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ethical clothing manufacturing ensures fair wages, safe working conditions, no forced or child labor, freedom of association, and environmental responsibility. Key certifications include BSCI for social compliance, WRAP for ethical manufacturing, Fair Trade for fair wages and trade practices, and SMETA for ethical trade audits. Genuine ethical manufacturers undergo regular third-party audits and publish audit reports demonstrating compliance with international labor standards."
          }
        },
        {
          "@type": "Question",
          "name": "Is BSCI or WRAP certification better for ethical manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BSCI and WRAP serve complementary purposes. BSCI (Business Social Compliance Initiative) focuses on social compliance across 13 performance areas including workers' rights, fair remuneration, and occupational health and safety. WRAP (Worldwide Responsible Accredited Production) certifies ethical manufacturing with zero tolerance for forced labor, child labor, and discrimination. Many ethical manufacturers hold both certifications - BSCI for comprehensive social compliance and WRAP for ethical manufacturing verification. Both are recognized by major retailers in EU, UK, and US markets."
          }
        },
        {
          "@type": "Question",
          "name": "How do I verify a manufacturer's ethical claims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verify ethical claims through certification databases: BSCI at amfori.org, WRAP at wrapcompliance.org, Fair Trade at fairtrade.net. Request current audit reports and check certificate validity dates. Look for specific compliance data rather than vague statements. Ask for evidence of fair wages, working hours, and safety records. Genuine ethical manufacturers provide audit reports, verification links, and welcome third-party inspections. Be skeptical of manufacturers who refuse to share certification documentation."
          }
        },
        {
          "@type": "Question",
          "name": "What is Fair Trade certification in clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fair Trade certification ensures workers receive fair wages, work in safe conditions, and have community development funds. Fair Trade certified factories pay the Fair Trade Minimum Price or Fair Trade Premium, which workers democratically invest in community projects. Certification requires adherence to strict labor standards, no forced or child labor, and environmental criteria. Fair Trade appeals to brands targeting premium segments with strong ethical positioning and consumers willing to pay for verified fair labor practices."
          }
        },
        {
          "@type": "Question",
          "name": "Do ethical clothing manufacturers cost more?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ethical manufacturing typically costs 5-10% more than conventional production due to fair wage premiums, safety investments, and certification costs. However, ethical certification enables 15-30% retail price premiums as consumers pay more for verified ethical products. The cost difference is often offset by premium positioning, brand loyalty, and reduced reputational risk. For brands targeting conscious consumers, ethical manufacturing is both a moral imperative and a profitable business strategy."
          }
        },
        {
          "@type": "Question",
          "name": "What are the signs of an unethical clothing manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Red flags include refusal to share audit reports or certificates, vague ethical claims without verification, prices significantly below market rates (suggesting labor cutting), no transparency about working conditions, excessive overtime hours, below-minimum wages, and no worker representation systems. Unethical manufacturers often claim to be 'ethical' without third-party certification. Be particularly skeptical of factories in countries with weak labor laws that make unsubstantiated ethical claims."
          }
        },
        {
          "@type": "Question",
          "name": "Can small brands work with ethical clothing manufacturers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, many ethical manufacturers work with small brands. SDF Clothing offers 300 piece minimums for ethical production. While per-unit costs are higher than conventional manufacturing, the retail premium for ethical products can offset this. Small brands can start with capsule collections using certified ethical manufacturers and scale as volume increases. The key is finding manufacturers with appropriate MOQs and building long-term relationships that benefit both parties."
          }
        },
        {
          "@type": "Question",
          "name": "Is Bangladesh ethical for clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bangladesh has made significant ethical improvements since 2013, with many factories now BSCI, WRAP, and Fair Trade certified. The country faces challenges with labor rights enforcement, but certified factories demonstrate strong ethical practices through regular audits. Bangladesh offers competitive ethical manufacturing costs, making it accessible for brands of all sizes. When sourcing from Bangladesh, verify individual factory certifications rather than assuming country-wide ethical standards. SDF Clothing's Bangladesh operations hold comprehensive ethical certifications."
          }
        }
      ]
    },
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDescription,
      "author": { "@id": SITE + "/#org" },
      "publisher": { "@id": SITE + "/#org" },
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23"
    },
    {
      "@type": "Service",
      "name": "Ethical Clothing Manufacturing",
      "description": pageDescription,
      "provider": { "@id": SITE + "/#org" },
      "areaServed": ["EU", "UK", "US"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Ethical Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "BSCI Certified Manufacturing"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "WRAP Certified Manufacturing"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Fair Trade Manufacturing"
            }
          }
        ]
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb__item breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">Ethical Clothing Manufacturer</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<main id="main-content">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <p class="hero__label">BSCI, WRAP & Fair Trade Certified | Since 1998</p>
        <h1 class="hero__title">Ethical Clothing Manufacturer | Fair Trade, BSCI and WRAP Certified Since 1998</h1>
        <p class="hero__description">
          SDF Clothing is an ethical clothing manufacturer providing fair wage production, safe working conditions, and verified labor rights compliance. Our BSCI, WRAP, and Fair Trade certifications ensure your garments are produced ethically. We serve EU, UK, and US brands with transparent, audited manufacturing since 1998. Get certified ethical production with full audit documentation.
        </p>
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">1998</span>
            <span class="hero__stat-label">Founded</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">BSCI</span>
            <span class="hero__stat-label">Certified</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">WRAP</span>
            <span class="hero__stat-label">Certified</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">Fair</span>
            <span class="hero__stat-label">Trade</span>
          </div>
        </div>
        <div class="hero__ctas">
          <a href={whatsappQuoteUrl} class="hero__cta hero__cta--primary" target="_blank" rel="noopener noreferrer">
            Get Ethical Manufacturing Quote
          </a>
          <a href="/certifications" class="hero__cta hero__cta--secondary">
            View Our Certifications
          </a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/factory.jpg" alt="SDF Clothing ethical manufacturing facility with BSCI and WRAP certifications, fair wage production" width="600" height="400" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">BSCI Social Compliance</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">WRAP Ethical Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Fair Trade Certified</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">No Forced Labor</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Fair Wages</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Safe Working Conditions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: What is Ethical Manufacturing -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">What Makes a Clothing Manufacturer Ethical?</h2>
      <p class="section__text">
        "Ethical" has become a marketing buzzword in fashion, but genuine ethical manufacturing requires specific, verifiable practices. True ethical manufacturing ensures workers receive fair wages, work in safe conditions, have freedom of association, and are free from forced labor, child labor, and discrimination. These principles are not voluntary niceties - they are fundamental human rights protected by international labor standards and enforced through third-party certification programs.
      </p>
      <p class="section__text">
        Ethical manufacturing addresses multiple dimensions of worker welfare. Fair wages mean workers earn enough to support themselves and their families with dignity, often exceeding local minimum wage requirements. Safe working conditions include proper ventilation, fire safety, ergonomic workstations, and protective equipment. No forced labor means workers can leave employment freely without coercion. No child labor means no workers under the legal employment age. Freedom of association allows workers to form or join unions and bargain collectively. Discrimination prohibition ensures equal treatment regardless of gender, religion, ethnicity, or other protected characteristics.
      </p>
      <p class="section__text">
        Verification is critical because ethical claims are easily made but difficult to prove. Third-party certifications like BSCI, WRAP, and Fair Trade require annual audits by independent auditors who verify compliance with specific standards. These certifications provide audit reports that brands can review to verify ethical claims. Without third-party verification, "ethical" claims are just marketing statements with no substance. Genuine ethical manufacturers welcome scrutiny and provide full documentation to demonstrate compliance.
      </p>

      <h3 class="section__subtitle">Ethical Manufacturing Requirements</h3>
      <p class="section__text">
        This table outlines the core requirements for ethical clothing manufacturing, the certifications that verify each requirement, and warning signs that indicate potential ethical violations. Use this framework to evaluate manufacturers and identify genuine ethical production.
      </p>

      <div style="margin-top: 2rem;">
        <table style="width:100%;max-width:900px;border-collapse:collapse;background:#0a0a0a;">
          <thead>
            <tr style="background:#e00;">
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Requirement</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">What It Means</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Certification</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Red Flags</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Fair Wages</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Living wage or above minimum</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">BSCI, WRAP, Fair Trade</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Below minimum wage, piece-rate exploitation</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Safe Conditions</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Fire safety, ventilation, PPE</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">BSCI, WRAP, SMETA</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Blocked exits, no safety equipment</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">No Forced Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Free to leave employment</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">WRAP, Fair Trade</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Passport confiscation, debt bondage</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">No Child Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">No workers under legal age</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">BSCI, WRAP, Fair Trade</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Underage workers, no age verification</td>
            </tr>
            <tr>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Freedom of Association</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Right to unionize</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">BSCI, Fair Trade</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Anti-union policies, worker suppression</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <p class="section__text" style="margin-top: 2rem;">
        <em>Table: Ethical manufacturing requirements, verification certifications, and warning signs. Source: International Labour Organization conventions, BSCI code of conduct, WRAP principles.</em>
      </p>
    </div>
  </section>

  <!-- Section 2: BSCI Certification -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">BSCI Certification | Social Compliance for Fashion Manufacturing</h2>
      <p class="section__text">
        BSCI (Business Social Compliance Initiative), now part of amfori, is one of the most widely recognized social compliance certifications in the fashion industry. Founded in 2003 by the Foreign Trade Association, BSCI harmonizes social compliance requirements across global supply chains. BSCI certification demonstrates a manufacturer's commitment to workers' rights, fair remuneration, occupational health and safety, and environmental protection. For brands sourcing from multiple countries, BSCI provides a consistent framework for evaluating social compliance.
      </p>
      <p class="section__text">
        BSCI covers 13 performance areas: fair remuneration, decent working hours, occupational health and safety, no child labor, no forced labor, no discrimination, freedom of association, disciplinary practices, regular employment, protection of the environment, ethical business behavior, management systems, and information and internal communication. This comprehensive coverage ensures all aspects of worker welfare are addressed. BSCI audits are conducted by independent auditors who assess factory compliance against these performance areas, producing detailed reports that brands can review.
      </p>
      <p class="section__text">
        BSCI certification is particularly important for EU market access. Many European retailers require BSCI certification from their suppliers as a baseline requirement for social compliance. The certification is recognized across the EU and increasingly in UK and US markets. BSCI's audit methodology aligns with International Labour Organization conventions and UN Guiding Principles on Business and Human Rights, providing brands with defensible evidence of social compliance. For brands selling to multiple markets, BSCI certification provides a single, widely-recognized standard that satisfies many retailer requirements.
      </p>

      <h3 class="section__subtitle">BSCI Performance Areas Explained</h3>
      <p class="section__text">
        BSCI's 13 performance areas provide a comprehensive framework for social compliance. This table explains each area, what auditors look for, and why it matters for ethical manufacturing.
      </p>

      <div style="margin-top: 2rem;">
        <table style="width:100%;max-width:1000px;border-collapse:collapse;background:#0a0a0a;">
          <thead>
            <tr style="background:#e00;">
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Performance Area</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">What Auditors Check</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Why It Matters</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Fair Remuneration</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Wages meet legal minimum, paid on time</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Workers can support families with dignity</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Decent Working Hours</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Overtime not excessive, rest days provided</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Prevents worker exploitation and fatigue</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Occupational Health & Safety</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Fire safety, first aid, protective equipment</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Protects workers from injury and death</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">No Child Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Age verification, no underage workers</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Protects children's rights and education</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">No Forced Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Free to leave, no coercion or debt bondage</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Fundamental human right, prevents exploitation</td>
            </tr>
            <tr>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Freedom of Association</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Right to form unions, collective bargaining</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Workers can advocate for their rights</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <p class="section__text" style="margin-top: 2rem;">
        <em>Table: BSCI performance areas with audit criteria and importance. BSCI certification requires compliance across all 13 areas. Source: amfori BSCI code of conduct.</em>
      </p>

      <p class="section__text">
        SDF Clothing maintains current BSCI certification with regular audits demonstrating compliance across all performance areas. We provide audit reports to clients upon request, enabling brands to verify our social compliance credentials. Our <a href="/clothing-manufacturer-bangladesh">Bangladesh operations</a> and <a href="/clothing-manufacturer-vietnam">Vietnam operations</a> both hold BSCI certification, providing consistent social compliance across our manufacturing locations.
      </p>
    </div>
  </section>

  <!-- Section 3: WRAP Certification -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">WRAP Certification | Ethical Manufacturing with Zero Tolerance</h2>
      <p class="section__text">
        WRAP (Worldwide Responsible Accredited Production) is a globally recognized certification for ethical manufacturing with zero tolerance for forced labor, child labor, and discrimination. Founded in 2000, WRAP certifies manufacturing facilities worldwide against 12 principles covering labor rights, workplace safety, and environmental management. WRAP certification is particularly important for UK and US markets, where major retailers recognize WRAP as evidence of ethical manufacturing compliance.
      </p>
      <p class="section__text">
        WRAP's 12 principles include compliance with laws and workplace regulations, prohibition of forced labor, prohibition of child labor, prohibition of harassment or abuse, compensation and benefits, hours of work, prohibition of discrimination, health and safety, freedom of association and collective bargaining, environment, customs compliance, and security. WRAP audits are conducted by independent monitors who assess factory compliance through document review, worker interviews, and facility inspections. Certification requires annual audits and corrective action plans for any non-compliance issues.
      </p>
      <p class="section__text">
        WRAP certification is distinguished by its zero tolerance policy for forced labor and child labor. Unlike some certification programs that allow corrective action periods for serious violations, WRAP requires immediate termination of any non-compliance with these fundamental principles. This zero tolerance approach provides brands with confidence that WRAP-certified facilities have never engaged in forced or child labor. For brands targeting UK markets, WRAP certification is often a requirement for department store and ethical retailer partnerships.
      </p>

      <h3 class="section__subtitle">WRAP 12 Principles</h3>
      <p class="section__text">
        WRAP's 12 principles provide comprehensive ethical manufacturing coverage. This table lists each principle, audit requirements, and relevance for brands sourcing ethical clothing.
      </p>

      <div style="margin-top: 2rem;">
        <table style="width:100%;max-width:1000px;border-collapse:collapse;background:#0a0a0a;">
          <thead>
            <tr style="background:#e00;">
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Principle</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Audit Requirement</th>
              <th style="padding:1rem;text-align:left;color:#fff;font-size:0.85rem;font-weight:500;border-bottom:1px solid #333;">Brand Relevance</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Compliance with Laws</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">All local labor laws followed</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Legal risk mitigation</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Prohibition of Forced Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Zero tolerance, immediate termination</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Fundamental human right</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Prohibition of Child Labor</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Zero tolerance, age verification</td>
              <td style="padding:1rem;color:#fff;font-size:0.82rem;">Child protection</td>
            </tr>
            <tr style="border-bottom:1px solid #1a1a1a;">
              <td style="padding:1rem;color:#fff;font-size:0.82rem;font-weight:600;">Prohibition of Harassment</td>
