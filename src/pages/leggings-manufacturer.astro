---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Leggings Manufacturer — Custom & Activewear | SDF Clothing";
const pageDescription = "Custom leggings manufacturer in Bangladesh. Activewear leggings, yoga pants and fashion styles from 300 pieces. 4-way stretch, OEKO-TEX. Get a free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#org",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Leggings Manufacturer"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What leggings types do you manufacture?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We manufacture activewear leggings for fitness and sports, fashion leggings for casual wear, compression leggings for athletic performance, and maternity leggings with expandable waistbands. All types available from 300 pieces minimum with 4-way stretch fabric."
          }
        },
        {
          "@type": "Question",
          "name": "What fabric blends do you use for leggings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use nylon-spandex blends (80/20 or 82/18) for premium performance, polyester-spandex blends for durability and cost efficiency, cotton-spandex blends for natural feel with stretch, and recycled polyester-spandex for sustainable options. All fabrics feature 4-way stretch and moisture-wicking."
          }
        },
        {
          "@type": "Question",
          "name": "What waistband types do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Waistband options include high-rise waistbands for coverage and support, mid-rise waistbands for balanced fit, low-rise waistbands for fashion styling, compression waistbands for athletic performance, and fold-over waistbands for versatile styling. All waistbands feature elastic construction for secure fit."
          }
        },
        {
          "@type": "Question",
          "name": "What is your minimum order for leggings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our leggings minimum is 300 pieces per style. This applies to activewear, fashion, compression, and maternity leggings. Minimum can be split across sizes within a single colorway. Lower quantities available at higher per-piece cost for sampling and prototype development."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer plus size leggings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer plus size leggings from 1X to 4X with extended size charts and graded patterns. Plus size leggings feature reinforced construction, wider waistbands for comfort, and proportional sizing that maintains style consistency across size range. Minimum 300 pieces applies to plus size production."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications do you hold for leggings production?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We hold OEKO-TEX Standard 100 for chemical safety in activewear fabrics, GRS for recycled polyester content, and ISO 9001 for quality management. All leggings produced to international safety standards for skin contact and athletic wear."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce seamless leggings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We produce seamless leggings using circular knitting technology for smooth, chafe-free construction. Seamless leggings feature graduated compression, strategic ventilation zones, and no side seams for comfort. Minimum 500 pieces for seamless production due to specialized equipment requirements."
          }
        },
        {
          "@type": "Question",
          "name": "How long does leggings production take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard production timeline: 30-40 days from fabric receipt for basic leggings. 35-50 days for custom fabric development or seamless production. 7-14 days for sampling before bulk. Rush production available at 20-30% premium for urgent deadlines."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Leggings Manufacturing Service",
      "description": "Custom leggings manufacturing from 300 pieces including activewear, yoga pants, fashion leggings with 4-way stretch fabrics",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Leggings Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom Leggings Production"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "8",
              "maxPrice": "20"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Leggings from SDF Clothing",
      "description": "Step-by-step process for ordering custom leggings from our Bangladesh manufacturing facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your leggings design, fabric specifications (4-way stretch preferences), size chart, target quantity, and waistband requirements via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your leggings order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review leggings samples for fit, fabric stretch recovery, compression level, and construction quality within 10-14 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard leggings items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your leggings order"
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 

  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href="/">Home</a></li>
        <li class="breadcrumb__item breadcrumb__item--current">Leggings Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Leggings Manufacturer | Since 1998 | Activewear Specialists</div>
        <h1 class="hero__title">Leggings Manufacturer | Custom Activewear Leggings and Yoga Pants from 300 Pieces</h1>
        <p class="hero__description">
          SDF Clothing is a custom leggings manufacturer and full-service clothing manufacturer in Bangladesh producing activewear leggings, yoga pants, fashion leggings, compression leggings, and maternity leggings from 300 pieces minimum. 4-way stretch fabrics, OEKO-TEX certified, with waistband customization and plus size options available.
        </p>
        <div class="hero__ctas">
          <a href="/contact/" class="hero__cta hero__cta--primary">Get Free Quote</a>
          <a href={`${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%20need%20a%20quote%20for%20leggings-manufacturer`} target="_blank" rel="noopener noreferrer" class="hero__cta hero__cta--secondary">WhatsApp Now</a>
        </div>
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">300</span>
          <span class="hero__stat-label">Pieces Minimum</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">4-Way</span>
          <span class="hero__stat-label">Stretch Fabric</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{companyAge}</span>
          <span class="hero__stat-label">Years Experience</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">30-40</span>
          <span class="hero__stat-label">Days Production</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>OEKO-TEX Standard 100</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>GRS Recycled</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>ISO 9001 Quality</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span>BSCI Social Compliance</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Legging Types</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Leggings Types We Manufacture</h2>
      </div>
      <div class="section__text">
        <p>We manufacture four primary leggings categories, each serving different market segments and functional requirements. Activewear leggings focus on performance features for fitness and sports applications. Fashion leggings prioritize aesthetic design for casual wear. Compression leggings provide graduated compression for athletic performance and recovery. Maternity leggings feature expandable construction for pregnancy comfort. All types maintain our quality standards and are available from 300 pieces minimum.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Type</th>
              <th>Primary Use</th>
              <th>Key Features</th>
              <th>Fabric Focus</th>
              <th>Price Tier</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Activewear Leggings</td>
              <td>Fitness, sports, gym</td>
              <td>Moisture-wicking, 4-way stretch, flatlock seams</td>
              <td>Performance nylon-spandex</td>
              <td>$$</td>
            </tr>
            <tr>
              <td>Fashion Leggings</td>
              <td>Casual wear, styling</td>
              <td>Design prints, varied waist heights, fashion details</td>
              <td>Polyester-spandex, cotton-spandex</td>
              <td>$</td>
            </tr>
            <tr>
              <td>Compression Leggings</td>
              <td>Athletic performance, recovery</td>
              <td>Graduated compression, muscle support, recovery focus</td>
              <td>High-performance nylon-spandex</td>
              <td>$$$</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Maternity Leggings</td>
              <td>Pregnancy comfort</td>
              <td>Expandable waistband, belly support, postpartum use</td>
              <td>Soft cotton-spandex blends</td>
              <td>$$</td>
            </tr>
          </tbody>
          <caption>All types available from 300 pieces minimum. Custom combinations possible with higher minimums.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Fabric Blends</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Legging Fabric Blends | Performance and Comfort Options</h2>
      </div>
      <div class="section__text">
        <p>Fabric selection determines leggings performance, comfort, and market positioning. We offer multiple fabric blends optimized for different applications. All fabrics feature 4-way stretch for unrestricted movement and recovery. Fabric selection depends on intended use, price point, and brand positioning requirements.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Fabric</th>
              <th>Composition</th>
              <th>Stretch</th>
              <th>Key Properties</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Nylon-Spandex</td>
              <td>80/20 or 82/18</td>
              <td>4-way stretch</td>
              <td>Soft hand, moisture-wicking, quick-drying</td>
              <td>Activewear, premium leggings</td>
            </tr>
            <tr>
              <td>Polyester-Spandex</td>
              <td>85/15 or 88/12</td>
              <td>4-way stretch</td>
              <td>Durable, color-fast, cost-efficient</td>
              <td>Fashion leggings, value positioning</td>
            </tr>
            <tr>
              <td>Cotton-Spandex</td>
              <td>92/8 or 95/5</td>
              <td>4-way stretch</td>
              <td>Natural feel, breathable, soft</td>
              <td>Maternity, casual wear</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Recycled Polyester-Spandex</td>
              <td>85/15 (GRS certified)</td>
              <td>4-way stretch</td>
              <td>Sustainable, durable, eco-friendly</td>
              <td>Sustainable brands, eco-conscious</td>
            </tr>
          </tbody>
          <caption>All fabrics tested for 4-way stretch recovery. Moisture-wicking available on performance blends.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Waistband Types</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Leggings Waistband Types Comparison</h2>
      </div>
      <div class="section__text">
        <td>Waistband design significantly affects leggings fit, comfort, and performance. We offer multiple waistband configurations to serve different body types, activities, and style preferences. All waistbands feature elastic construction for secure fit and recovery through wear.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Waistband Type</th>
              <th>Rise Height</th>
              <th>Features</th>
              <th>Best For</th>
              <th>Comfort Level</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>High-Rise Waistband</td>
              <td>Above navel</td>
              <td>Full coverage, tummy control, secure fit</td>
              <td>Yoga, pilates, postpartum</td>
              <td>High</td>
            </tr>
            <tr>
              <td>Mid-Rise Waistband</td>
              <td>At navel</td>
              <td>Balanced fit, natural waistline, versatile</td>
              <td>General fitness, casual wear</td>
              <td>Medium-High</td>
            </tr>
            <tr>
              <td>Low-Rise Waistband</td>
              <td>Below navel</td>
              <td>Fashion styling, elongated torso, trendy</td>
              <td>Fashion leggings, streetwear</td>
              <td>Medium</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Compression Waistband</td>
              <td>Variable</td>
              <td>Graduated compression, muscle support</td>
              <td>Running, performance sports</td>
              <td>High (firm)</td>
            </tr>
            <tr>
              <td>Fold-Over Waistband</td>
              <td>Adjustable</td>
              <td>Versatile styling, adjustable rise, doubled fabric</td>
              <td>Yoga, transition wear</td>
              <td>High</td>
            </tr>
          </tbody>
          <caption>All waistbands feature 1.5-2 inch elastic for secure fit. Custom waistband heights available.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Size Chart</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Leggings Size Chart XS-4XL</h2>
      </div>
      <div class="section__text">
        <p>Our size chart provides measurements for consistent fit across production runs. All measurements are taken from finished garments. We recommend ordering samples to verify fit before bulk production. Plus size measurements graded proportionally to maintain style consistency.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Size</th>
              <th>Waist (in)</th>
              <th>Hips (in)</th>
              <th>Inseam (in)</th>
              <th>Rise (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>XS</td>
              <td>24-25</td>
              <td>34-35</td>
              <td>28-29</td>
              <td>8-9</td>
            </tr>
            <tr>
              <td>S</td>
              <td>26-27</td>
              <td>36-37</td>
              <td>28-29</td>
              <td>8.5-9.5</td>
            </tr>
            <tr>
              <td>M</td>
              <td>28-29</td>
              <td>38-39</td>
              <td>29-30</td>
              <td>9-10</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>L</td>
              <td>30-31</td>
              <td>40-41</td>
              <td>29-30</td>
              <td>9.5-10.5</td>
            </tr>
            <tr>
              <td>XL</td>
              <td>32-33</td>
              <td>42-43</td>
              <td>30-31</td>
              <td>10-11</td>
            </tr>
            <tr>
              <td>2XL</td>
              <td>34-35</td>
              <td>44-45</td>
              <td>30-31</td>
              <td>10.5-11.5</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>3XL</td>
              <td>36-37</td>
              <td>46-47</td>
              <td>31-32</td>
              <td>11-12</td>
            </tr>
            <tr>
              <td>4XL</td>
              <td>38-39</td>
              <td>48-49</td>
              <td>31-32</td>
              <td>11.5-12.5</td>
            </tr>
          </tbody>
          <caption>Measurements are approximate. Custom sizing available with tech pack development. Tolerance ?0.5 inches.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Price Range</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Leggings Price Range by Type</h2>
      </div>
      <div class="section__text">
        <td>Pricing varies by fabric type, construction complexity, and order quantity. FOB Bangladesh pricing for standard production runs. Custom prints, compression construction, and premium finishes are additional. Volume discounts available for orders exceeding 1,000 pieces.</p>
      </div>
      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Type</th>
              <th>300-500 pcs</th>
              <th>500-1000 pcs</th>
              <th>1000-2000 pcs</th>
              <th>2000+ pcs</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comparison__row--highlight">
              <td>Fashion Leggings (Poly-Spandex)</td>
              <td>$6-10</td>
              <td>$5-8</td>
              <td>$4-7</td>
              <td>$3-6</td>
            </tr>
            <tr>
              <td>Activewear Leggings (Nylon-Spandex)</td>
              <td>$8-14</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-9</td>
            </tr>
            <tr>
              <td>Compression Leggings (High-Performance)</td>
              <td>$12-20</td>
              <td>$11-18</td>
              <td>$10-16</td>
              <td>$9-14</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td>Maternity Leggings (Cotton-Spandex)</td>
              <td>$8-14</td>
              <td>$7-12</td>
              <td>$6-10</td>
              <td>$5-9</td>
            </tr>
            <tr>
              <td>Seamless Leggings</td>
              <td>$12-22</td>
              <td>$11-20</td>
              <td>$10-18</td>
              <td>$9-16</td>
            </tr>
            <tr>
              <td>Recycled Leggings (GRS Certified)</td>
              <td>$10-18</td>
              <td>$9-16</td>
              <td>$8-14</td>
              <td>$7-12</td>
            </tr>
          </tbody>
          <caption>FOB Bangladesh pricing. Includes fabric, cut, sew, basic branding. Customization additional.</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Plus Size Leggings</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Plus Size Leggings Manufacturing</h2>
      </div>
      <div class="section__text">
        <p>Plus size leggings from 1X to 4X require specialized pattern grading and construction to ensure proper fit and comfort across extended size ranges. Our plus size leggings feature reinforced stitching at stress points, wider waistbands for even pressure distribution, and proportional grading that maintains design integrity from XS to 4X. We understand that plus size consumers demand the same quality, style, and performance as standard sizes, and our production reflects this commitment.</p>
        
        <p>Plus size leggings construction includes additional considerations: wider elastic in waistbands for secure fit without digging, reinforced crotch construction for durability, and strategic panel placement that accommodates different body shapes while maintaining aesthetic appeal. Our pattern grading follows plus size standards to ensure consistent sizing across the extended range, reducing returns and improving customer satisfaction.</p>
        
        <p>Minimum order for plus size leggings is 300 pieces per style, with the ability to distribute quantities across the plus size range according to brand requirements. We can produce full size runs from XS to 4X, or focus production on specific plus size segments based on target market. Plus size production maintains the same quality standards, fabric options, and customization capabilities as standard size production.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <div class="section__header">
        <span class="section__label">Frequently Asked Questions</span>
        <div class="accent-line"></div>
        <h2 class="section__title">Leggings Manufacturer FAQ</h2>
      </div>
      <div class="faq">
        <div class="faq__item">
          <h3 class="faq__question">What leggings types do you manufacture?</h3>
          <p class="faq__answer">We manufacture activewear leggings for fitness and sports, fashion leggings for casual wear, compression leggings for athletic performance, and maternity leggings with expandable waistbands. All types available from 300 pieces minimum with 4-way stretch fabric and OEKO-TEX certification.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What fabric blends do you use for leggings?</h3>
          <p class="faq__answer">We use nylon-spandex blends (80/20 or 82/18) for premium performance, polyester-spandex blends for durability and cost efficiency, cotton-spandex blends for natural feel with stretch, and recycled polyester-spandex for sustainable options. All fabrics feature 4-way stretch and moisture-wicking capabilities.</p>
        </div>
        
        <div class="faq__item">
          <h3 class="faq__question">What waistband types do you offer?</h3>
          <p class="faq__answer">Waistband options include high-rise waistbands for coverage and support, mid-rise waistbands for balanced fit, low-rise waistbands for fashion styling, compression waistbands for athletic performance, and fold-over waistbands for versatile styling. All waistbands feature elastic construction for secure fit and recovery.</p>
        </div>
        
        <div class="faq__item">
