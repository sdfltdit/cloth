---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "GOTS Certified Clothing Manufacturer | Organic Cotton | SDF";
const pageDescription = "GOTS certified clothing manufacturer for organic cotton apparel. Full supply chain certification, transaction certificates, EU/UK/US compliant since 1998.";

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20GOTS%20certified%20organic%20clothing%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle
          }
        ]
      },
      "publisher": { "@id": SITE + "/#org" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is GOTS certification for clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GOTS (Global Organic Textile Standard) is the worldwide leading textile processing standard for organic fibers, including ecological and social criteria. GOTS certification covers the entire textile supply chain from harvesting of raw materials through environmentally and socially responsible manufacturing to labeling. GOTS ensures organic status of textiles from harvesting of raw materials through environmentally and socially responsible manufacturing to labeling, providing credible assurance to the consumer."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between GOTS and organic cotton?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Organic cotton refers to cotton grown without synthetic pesticides or fertilizers, while GOTS is a certification covering the entire supply chain from fiber to finished garment. Organic cotton alone doesn't guarantee ethical processing or chemical safety. GOTS certification requires organic cotton plus restrictions on toxic chemicals, wastewater treatment, fair labor practices, and third-party verification. GOTS is the most comprehensive organic textile certification available."
          }
        },
        {
          "@type": "Question",
          "name": "How do I verify GOTS certification?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verify GOTS certification through the official GOTS database at global-standard.org. Request the GOTS certificate number and check validity dates. GOTS certified manufacturers must provide transaction certificates (TCs) for each production batch, proving the organic status of materials. Always verify certificates directly through the GOTS database and request current TCs for your specific production. Genuine GOTS manufacturers provide full documentation willingly."
          }
        },
        {
          "@type": "Question",
          "name": "What are the GOTS label grades?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GOTS has two label grades: 'organic' requires minimum 95% certified organic fibers, while 'made with organic' requires minimum 70% certified organic fibers. Both grades prohibit toxic chemicals, require wastewater treatment, mandate fair labor practices, and require third-party certification. The 'organic' label allows only 5% non-organic fibers for specific technical reasons, while 'made with organic' allows up to 30% non-organic fibers. Both grades provide credible organic certification."
          }
        },
        {
          "@type": "Question",
          "name": "Does GOTS certification include fair labor requirements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, GOTS certification includes comprehensive social criteria covering fair wages, working conditions, no forced or child labor, freedom of association, and discrimination prohibition. GOTS social criteria are based on International Labour Organization conventions. GOTS certified factories must comply with social standards alongside environmental standards, making GOTS a holistic certification covering both organic production and ethical manufacturing."
          }
        },
        {
          "@type": "Question",
          "name": "Can GOTS certification be faked?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, GOTS certificates can be forged, which is why verification through the official database is essential. Always check certificate numbers at global-standard.org and request transaction certificates for your specific production. Be skeptical of manufacturers who refuse to provide certificate numbers or TCs. Genuine GOTS certified manufacturers provide full documentation and welcome verification through official channels."
          }
        },
        {
          "@type": "Question",
          "name": "What is a GOTS transaction certificate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A GOTS transaction certificate (TC) is a document proving the organic status of materials at each stage of the supply chain. TCs trace organic materials from fiber to finished garment, ensuring no conventional cotton is mixed in. Each production batch requires a TC, and brands receive TCs for their orders. TCs are essential for substantiating organic claims and are required by many retailers and regulators. GOTS certified manufacturers must provide TCs for every production batch."
          }
        },
        {
          "@type": "Question",
          "name": "Is GOTS certification required for organic clothing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GOTS certification is not legally required for organic clothing, but it is the most credible standard for organic textile claims. Without GOTS certification, 'organic' claims on clothing are difficult to substantiate and may violate consumer protection laws in EU and US markets. Major retailers require GOTS certification for organic clothing products. GOTS provides the verification needed to make credible organic claims and access premium organic markets."
          }
        }
      ]
    },
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDescription,
      "author": { "@id": SITE + "/#org" },
      "publisher": { "@id": SITE + "/#org" },
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23"
    },
    {
      "@type": "Service",
      "name": "GOTS Certified Clothing Manufacturing",
      "description": pageDescription,
      "provider": { "@id": SITE + "/#org" },
      "areaServed": ["EU", "UK", "US"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "GOTS Certified Manufacturing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "GOTS Organic Cotton Manufacturing"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "GOTS Transaction Certificate Provision"
            }
          }
        ]
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb__item breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">GOTS Certified Clothing Manufacturer</span>
      <meta itemprop="position" content="2" />
    </li>
