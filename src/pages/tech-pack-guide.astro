---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "Tech Pack Guide for Clothing Brands 2026 | SDF Clothing";
const pageDescription = "Complete tech pack guide for clothing brands. What a tech pack includes, how to create one, costs and common mistakes before you approach a manufacturer.";

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20tech%20pack%20creation`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": Astro.url.href
          }
        ]
      },
      "publisher": { "@id": SITE + "/#org" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need a tech pack to work with a clothing manufacturer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you need a tech pack to work with most clothing manufacturers. Without a tech pack, manufacturers must guess your specifications, which leads to incorrect sizing, wrong fabric choices, and costly sample revisions. A tech pack provides the technical blueprint needed for accurate production. Some manufacturers offer tech pack creation services if you don't have one."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if I don't have a tech pack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Without a tech pack, manufacturers will either refuse the project or charge significantly more to create one for you. Production delays are common as factories must clarify ambiguous specifications. Sample costs increase as multiple iterations are needed to get the product right. The final product may not match your vision, leading to costly rework or unsellable inventory."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to create a tech pack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tech pack costs vary by method: DIY with software costs $0 (if you own Adobe Illustrator) but takes 5-10 hours per style with a steep learning curve. Freelance designers charge $200-500 per style for simple garments and $500-1,500 for complex styles. Tech pack agencies charge $300-800 per style. SDF Clothing includes tech pack creation in our full package quote for clients who don't have one."
          }
        },
        {
          "@type": "Question",
          "name": "Can SDF create a tech pack from my design sketches?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, SDF Clothing can create a tech pack from your design sketches. Our design team converts creative sketches into technical manufacturing documents. We review your sketches, clarify specifications, and produce complete tech packs ready for production. This service is included in our full package quote or available as a standalone service for brands who need tech pack creation."
          }
        },
        {
          "@type": "Question",
          "name": "What software do designers use to create tech packs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Professional designers use Adobe Illustrator for tech pack creation due to its precision and industry-standard vector capabilities. Dedicated platforms like Techpacker.com offer collaborative features for tech pack management. Canva can be used for basic tech packs but lacks technical precision. Excel with manual drawings is possible but inefficient. Most fashion brands hire freelance designers with Illustrator expertise rather than learning the software themselves."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to create a tech pack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tech pack creation time varies by experience and complexity. Experienced designers take 2-4 hours for simple garments like t-shirts and 4-8 hours for complex garments like jackets. Beginners may take 10-20 hours per style due to the learning curve. Freelance designers typically deliver within 3-5 business days. SDF Clothing delivers tech packs within 5-7 business days as part of our development process."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a tech pack and a spec sheet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tech pack is a comprehensive document including sketches, measurements, fabric specifications, color callouts, trim details, construction notes, and quality standards. A spec sheet is typically a subset focusing only on measurements and basic specifications. Tech packs are more detailed and used for full production, while spec sheets may be used for simple sampling or quick costing. Professional manufacturing requires full tech packs for accuracy."
          }
        },
        {
          "@type": "Question",
          "name": "Can I update a tech pack after production starts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can update a tech pack after production starts, but changes incur costs and delays. Minor changes like adjusting measurements within tolerance may be possible without significant impact. Major changes like fabric substitution or style modification require re-sampling and may incur additional charges. It's best to finalize your tech pack before bulk production to avoid costly revisions. SDF Clothing reviews tech packs before production to catch issues early."
          }
        }
      ]
    },
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDescription,
      "author": { "@id": SITE + "/#org" },
      "publisher": { "@id": SITE + "/#org" },
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23"
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

<a href="#main-content" class="skip-link">Skip to main content</a>

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1" />
    </li>
    <li class="breadcrumb__item breadcrumb__item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">Tech Pack Guide</span>
      <meta itemprop="position" content="2" />
    </li>
  </ol>
</nav>

<main id="main-content">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <p class="hero__label">Tech Pack Guide 2026 | Before You Approach a Manufacturer</p>
        <h1 class="hero__title">Tech Pack Guide | What Every Clothing Brand Needs to Know Before Approaching a Manufacturer</h1>
        <p class="hero__description">
          A tech pack is your garment's blueprint. Without one, manufacturers guess - and guessing costs money. Learn what a tech pack includes, how to create one, costs, and common mistakes that delay production. Get your tech pack right before you approach a manufacturer. Explore our <a href="/how-to-start-a-clothing-brand/" style="color:#e00;text-decoration:none;">how to start a clothing brand</a> and <a href="/how-to-find-clothing-manufacturer/" style="color:#e00;text-decoration:none;">how to find a clothing manufacturer</a>.
        </p>
        <div class="hero__stats">
          <div class="hero__stat">
            <span class="hero__stat-value">8</span>
            <span class="hero__stat-label">Essential Components</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">$0</span>
            <span class="hero__stat-label">DIY Option</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">48hr</span>
            <span class="hero__stat-label">Review Time</span>
          </div>
          <div class="hero__stat">
            <span class="hero__stat-value">8+</span>
            <span class="hero__stat-label">Common Mistakes</span>
          </div>
        </div>
        <div class="hero__ctas">
          <a href={whatsappQuoteUrl} class="hero__cta hero__cta--primary" target="_blank" rel="noopener noreferrer">
            Get Tech Pack Quote
          </a>
          <a href="/tech-pack-service" class="hero__cta hero__cta--secondary">
            Tech Pack Service
          </a>
        </div>
      </div>
      <div class="hero__image">
        <img src="/factory.webp" alt="SDF Clothing tech pack development and garment manufacturing facility" width="600" height="400" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="trust">
    <div class="trust__container">
      <div class="trust__items">
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Tech Pack Creation Included</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">48-Hour Review</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">300 Piece MOQ</span>
        </div>
        <div class="trust__item">
          <span class="trust__icon">?</span>
          <span class="trust__text">Since 1998</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: What Is a Tech Pack -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">What Is a Tech Pack?</h2>
      <p class="section__text">
        A tech pack is a technical document that tells a manufacturer exactly how to build your garment. Think of it as a blueprint for clothing. Just as an architect needs detailed blueprints to build a house, manufacturers need tech packs to produce garments accurately. Without a tech pack, manufacturers must guess your specifications - fit, fabric, construction details - and guessing inevitably leads to errors, costly revisions, and products that don't match your vision.
      </p>
      <p class="section__text">
        Tech packs contain all the technical specifications needed for production: technical flat sketches showing front, back, and detail views; precise measurements for each size; fabric specifications including composition and weight; color specifications using Pantone numbers or hex codes; trim and hardware details like zippers, buttons, and labels; construction notes specifying stitch types and seam allowances; label and packaging specifications; and quality standards including AQL levels and inspection criteria. Every element that affects how your garment looks, fits, and performs must be documented.
      </p>
      <p class="section__text">
        Many fashion founders confuse tech packs with design sketches. A design sketch is your creative vision - what you want the garment to look like. A tech pack is the technical translation of that vision into manufacturing instructions. Design sketches are mood boards, pencil drawings, or Canva concepts. Tech packs are precise documents with measurements, specifications, and construction details. Manufacturers cannot produce from design sketches alone - they need the technical precision of a tech pack to execute your vision accurately.
      </p>
      <p class="section__text">
        Tech packs serve multiple critical functions beyond production. They enable accurate costing by providing all specifications needed for fabric sourcing and labor estimation. They facilitate communication between your brand and the factory, reducing misunderstandings. They provide a reference for quality control during production and inspection. They protect your brand by documenting specifications that can be referenced if disputes arise. Most importantly, they demonstrate professionalism to manufacturers - brands with complete tech packs get better pricing, faster turnaround, and more attention than brands without them.
      </p>
      <p class="section__text">
        SDF Clothing provides tech pack creation services for brands that don't have one. Our design team converts your design sketches into complete technical manufacturing documents. We include tech pack creation in our full package quote or offer it as a standalone service. Visit our <a href="/tech-pack-service">tech pack service page</a> to learn more about how we can help you prepare for manufacturing. For brands who already have tech packs, we review them within 48 hours and provide feedback before production begins.
      </p>
    </div>
  </section>

  <!-- Section 2: Tech Pack Components -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">What Every Tech Pack Must Include | 8 Essential Components</h2>
      <p class="section__text">
        A complete tech pack contains eight essential components. Missing any of these components leads to production delays, incorrect specifications, and costly revisions. Manufacturers need complete information to produce your garment accurately. This section details each component, what it contains, why it matters, and who typically creates it. Use this as your checklist when creating or reviewing your tech pack.
      </p>
      <p class="section__text">
        Technical flat sketches show your garment from multiple views - front, back, and critical detail views. Unlike design sketches which are artistic representations, flat sketches are proportionally accurate technical drawings showing seam lines, stitching details, and component placement. Measurements and grading specify exact dimensions for each size in your range, including point of measure definitions and tolerance allowances. Fabric specifications detail composition, weight in GSM, finish type, and any certification requirements like organic or OEKO-TEX.
      </p>
      <p class="section__text">
        Color specifications use Pantone numbers or hex codes for accurate color matching. Pantone is the industry standard for textiles, ensuring consistent color across production runs. Trim and hardware details specify every zipper, button, label, patch, and drawstring with part numbers, sizes, and attachment methods. Construction notes specify stitch types, seam allowances, and special construction techniques for complex areas. Label and packaging specifications define label placement, size, content, and packaging requirements. Quality standards specify AQL levels, inspection criteria, and defect classifications.
      </p>

      <h3 class="section__subtitle">Tech Pack Components Breakdown</h3>
      <p class="section__text">
        This table outlines the eight essential tech pack components, what each contains, why it matters for production, and who typically creates each element.
      </p>

      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Component</th>
              <th>What It Contains</th>
              <th>Why It Matters</th>
              <th>Who Creates It</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Flat sketches</strong></td>
              <td>Front, back, detail views with seam lines</td>
              <td>Visual reference for construction</td>
              <td>Designer / Illustrator</td>
            </tr>
            <tr>
              <td><strong>Measurements</strong></td>
              <td>Size chart, POMs, tolerance, grade rules</td>
              <td>Ensures correct fit across sizes</td>
              <td>Pattern maker / Grading expert</td>
            </tr>
            <tr>
              <td><strong>Fabric spec</strong></td>
              <td>Composition, GSM, finish, certification</td>
              <td>Determines cost and hand feel</td>
              <td>Designer / Fabric sourcer</td>
            </tr>
            <tr>
              <td><strong>Colour callouts</strong></td>
              <td>Pantone numbers, hex codes, placement</td>
              <td>Ensures accurate color matching</td>
              <td>Designer / Color specialist</td>
            </tr>
            <tr>
              <td><strong>Trims</strong></td>
              <td>Zippers, buttons, labels, hardware details</td>
              <td>Completes garment functionality</td>
              <td>Designer / Sourcing</td>
            </tr>
            <tr>
              <td><strong>Construction notes</strong></td>
              <td>Stitch type, seam allowance, special techniques</td>
              <td>Guides manufacturing process</td>
              <td>Technical designer</td>
            </tr>
            <tr>
              <td><strong>Labels</strong></td>
              <td>Placement, size, content, legal requirements</td>
              <td>Branding and regulatory compliance</td>
              <td>Designer / Legal team</td>
            </tr>
            <tr>
              <td><strong>Quality standards</strong></td>
              <td>AQL level, inspection criteria, defects</td>
              <td>Ensures production quality</td>
              <td>QC team / Factory</td>
            </tr>
          </tbody>
        </table>
        <caption>Table: Eight essential tech pack components with descriptions and creation responsibility. Complete tech packs include all elements for accurate production.</caption>
      </div>

      <p class="section__text" style="margin-top: 2rem;">
        SDF Clothing provides tech pack creation services covering all eight components. Our team includes technical designers, pattern makers, and sourcing specialists who create complete production-ready tech packs. We also offer <a href="/pattern-making-service">pattern making</a> and <a href="/grading-service">grading services</a> for brands who need technical development support. Our <a href="/fit-engineering-service">fit engineering service</a> ensures your measurements translate correctly to production samples.
      </p>
    </div>
  </section>

  <!-- Section 3: Tech Pack vs Design Sketch -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Tech Pack vs Design Sketch | What Is the Difference?</h2>
      <p class="section__text">
        Many fashion founders confuse tech packs with design sketches, but they serve fundamentally different purposes. A design sketch is your creative vision - what you want the garment to look like. A tech pack is the technical translation of that vision into manufacturing instructions. Design sketches are artistic representations: mood boards, pencil drawings, or Canva concepts that communicate style, silhouette, and aesthetic. Tech packs are precise documents with measurements, specifications, and construction details that communicate how to build the garment.
      </p>
      <p class="section__text">
        Design sketches focus on aesthetics: color, proportion, silhouette, and visual appeal. They might show a garment worn by a model with artistic shading and creative styling. They are valuable for marketing presentations, investor pitches, and communicating your brand vision. However, manufacturers cannot produce from design sketches alone because sketches lack the technical specifications needed for production. A sketch shows what the garment should look like, but not how to construct it, what measurements to use, or what materials to source.
      </p>
      <p class="section__text">
        Tech packs focus on technical precision: exact measurements for each size, fabric specifications with composition and weight, color specifications using Pantone numbers, trim details with part numbers, construction notes specifying stitch types and seam allowances, and quality standards for inspection. Tech packs include technical flat sketches - proportionally accurate line drawings showing seam lines and construction details rather than artistic representations. These flats serve as the visual reference for production, not the artistic sketch you might use for marketing.
      </p>
      <p class="section__text">
        The distinction matters because approaching a manufacturer with only design sketches leads to problems. The manufacturer must guess specifications: what fabric weight to use, what measurements to follow, how to construct complex details. Guessing leads to samples that don't match your vision, requiring multiple costly revisions. Manufacturers often charge additional fees to convert sketches into tech packs, or they may refuse the project entirely if specifications are unclear. Brands with complete tech packs get faster response, more accurate costing, and better manufacturer attention.
      </p>
      <p class="section__text">
        You can turn a design sketch into a tech pack by adding technical specifications. Start by creating technical flat sketches from your design sketch - remove artistic elements and add seam lines, stitch details, and component placement. Add a complete measurement spec with point of measure definitions for each size. Specify fabric composition, weight, and finish. Add color specifications using Pantone numbers or hex codes. Document all trims with part numbers and attachment methods. Write construction notes specifying stitch types and seam allowances. Add label placement and packaging specifications. If this process sounds overwhelming, <a href="/tech-pack-service">SDF Clothing can convert your sketches into complete tech packs</a> as part of our development services.
      </p>
    </div>
  </section>

  <!-- Section 4: How to Create a Tech Pack -->
  <section class="section section--alt">
    <div class="section__container">
      <h2 class="section__title">How to Create a Tech Pack | Step by Step</h2>
      <p class="section__text">
        Creating a tech pack requires attention to detail and technical precision. Follow these six steps to create a complete tech pack that manufacturers can work with accurately. Each step builds on the previous one, so complete them in order. The tools you use depend on your budget and technical skills - Adobe Illustrator is the professional standard, Techpacker.com offers collaborative features, Canva works for basic tech packs, and hiring a freelancer is an option if you lack technical skills.
      </p>

      <div class="process">
        <div class="process__step">
          <div class="process__number">1</div>
          <div class="process__content">
            <h3 class="process__title">Create Technical Flat Sketches</h3>
            <p class="process__text">
              Draw proportionally accurate flat sketches showing front, back, and critical detail views. Remove artistic elements and add seam lines, stitch details, and component placement. Technical flats serve as the visual reference for production, not artistic representations for marketing. Use Adobe Illustrator or hire a technical designer if you lack drawing skills.
            </p>
          </div>
        </div>

        <div class="process__step">
          <div class="process__number">2</div>
          <div class="process__content">
            <h3 class="process__title">Develop Size Chart for Target Markets</h3>
            <p class="process__text">
              Create a measurement spec with point of measure definitions for each size in your range. Include grade rules specifying how measurements change between sizes. Add tolerance allowances for acceptable variation. Ensure your size chart matches your target market standards - US, UK, and EU sizing differ significantly. Our <a href="/grading-service">grading service</a> can help create accurate size charts.
            </p>
          </div>
        </div>

        <div class="process__step">
          <div class="process__number">3</div>
          <div class="process__content">
            <h3 class="process__title">Specify All Fabrics with Composition and GSM</h3>
            <p class="process__text">
              Document fabric composition (e.g., 100% organic cotton, 95% cotton 5% elastane), weight in GSM (grams per square meter), finish type (e.g., enzyme washed, stone washed), and any certification requirements (GOTS, OEKO-TEX). Fabric specifications determine cost, hand feel, and drape - critical for production accuracy.
            </p>
          </div>
        </div>

        <div class="process__step">
          <div class="process__number">4</div>
          <div class="process__content">
            <h3 class="process__title">Add Colour Callouts with Pantone Numbers</h3>
            <p class="process__text">
              Use Pantone numbers for accurate color matching - Pantone TPX is the textile industry standard. Specify color placement on sketches with callouts. If you don't have Pantone numbers, provide hex codes as an alternative but note that Pantone matching is more accurate for production. Include color cards for visual reference.
            </p>
          </div>
        </div>

        <div class="process__step">
          <div class="process__number">5</div>
          <div class="process__content">
            <h3 class="process__title">Document All Trims, Labels, and Hardware</h3>
            <p class="process__text">
              Specify every zipper, button, label, patch, and drawstring with part numbers, sizes, and attachment methods. Avoid vague descriptions like "silver button" | specify "20mm silver shank button, style SB-201, 2-hole attachment." Include label placement, size, and content. Document packaging requirements.
            </p>
          </div>
        </div>

        <div class="process__step">
          <div class="process__number">6</div>
          <div class="process__content">
            <h3 class="process__title">Write Construction Notes and Quality Standards</h3>
            <p class="process__text">
              Specify stitch types (e.g., overlock, coverstitch), seam allowance (typically 1cm), and special construction techniques for complex areas. Define quality standards including AQL level (typically 2.5 for garments), inspection criteria, and defect classifications. Our <a href="/quality-inspection-service">quality inspection service</a> provides AQL guidance.
            </p>
          </div>
        </div>
      </div>

      <p class="section__text" style="margin-top: 2rem;">
        Tools for tech pack creation include Adobe Illustrator (professional, $20-50/month subscription, steep learning curve), Techpacker.com (dedicated platform, $50-100/month, collaborative features), Canva (basic, free-$15/month, limited technical precision), and hiring a freelancer ($200-500 per style). SDF Clothing includes tech pack creation in our <a href="/full-package-production">full package production</a> service for clients who need technical development support. Our <a href="/garment-development-service">garment development service</a> handles the entire technical process from sketch to production-ready tech pack.
      </p>
    </div>
  </section>

  <!-- Section 5: Tech Pack Cost -->
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Tech Pack Cost | DIY vs Hiring a Professional</h2>
      <p class="section__text">
        Tech pack costs vary significantly based on the approach you choose. DIY with software costs nothing if you already own Adobe Illustrator, but takes 5-10 hours per style with a steep learning curve if you're unfamiliar with technical drawing. Freelance designers charge $200-500 per style for simple garments like t-shirts and $500-1,500 for complex styles like jackets with multiple components. Tech pack service agencies charge $300-800 per style depending on complexity. SDF Clothing includes tech pack creation in our full package quote, making it cost-effective for brands who need both development and production.
      </p>
      <p class="section__text">
        DIY with Illustrator costs $0 in software fees if you own a subscription, but the time investment is significant | 5-10 hours per style for experienced users, 10-20 hours for beginners. The learning curve for Illustrator is steep, requiring weeks or months to master technical drawing skills. DIY with Canva costs $0-15/month for the free or pro plan, but Canva lacks technical precision for accurate measurements and specifications. Canva works for basic tech packs but may require revisions by the manufacturer to add missing technical details.
      </p>
      <p class="section__text">
        Freelance designers on Fiverr and Upwork charge $200-500 per style for simple garments like basic t-shirts, hoodies, and leggings. Complex garments like jackets, coats, and structured dresses cost $500-1,500 per style due to additional components and construction details. Freelancer quality varies significantly - review portfolios and ask for tech pack samples before hiring. Turnaround time is typically 3-5 business days. Tech pack service agencies charge $300-800 per style with more consistent quality and faster turnaround, but at higher cost than freelancers.
      </p>
      <p class="section__text">
        SDF Clothing includes tech pack creation in our full package quote for clients who don't have one. Our design team converts your design sketches into complete technical manufacturing documents as part of our development process. This eliminates separate tech pack costs and ensures the tech pack aligns with our production capabilities. For brands who only need tech pack creation without production, we offer standalone tech pack services at competitive rates. Visit our <a href="/tech-pack-service">tech pack service page</a> for pricing details.
      </p>

      <h3 class="section__subtitle">Tech Pack Cost Comparison</h3>
      <p class="section__text">
        This table compares tech pack creation options with costs, time investment, and best use cases. Choose the option that matches your budget, timeline, and technical skills.
      </p>

      <div class="comparison-wrapper">
        <table class="comparison">
          <thead>
            <tr>
              <th>Option</th>
              <th>Cost</th>
              <th>Time</th>
              <th>Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>DIY (Illustrator)</strong></td>
              <td>$0 (if you own software)</td>
              <td>5-10 hours per style</td>
              <td>Brands with technical skills and time</td>
            </tr>
            <tr>
              <td><strong>DIY (Canva)</strong></td>
              <td>$0-15/month</td>
              <td>3-6 hours per style</td>
              <td>Basic tech packs, simple garments</td>
            </tr>
            <tr class="comparison__row--highlight">
              <td><strong>Freelance designer</strong></td>
              <td>$200-1,500 per style</td>
              <td>3-5 business days</td>
              <td>Brands without technical skills</td>
            </tr>
            <tr>
              <td><strong>Tech pack agency</strong></td>
              <td>$300-800 per style</td>
              <td>2-4 business days</td>
              <td>Brands needing quality and speed</td>
            </tr>
