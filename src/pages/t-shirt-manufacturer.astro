        <div style="font-size:0.75rem;color:#FFFFFF;">View page →</div>
      </a>
      <a href="/sweatshirt-manufacturer/" style="background:#000;padding:2rem;text-decoration:none;display:block;transition:background 0.2s;" onmouseover="this.style.background='#0a0a0a'" onmouseout="this.style.background='#000'">
        <div style="font-size:0.6rem;letter-spacing:0.2em;text-transform:uppercase;color:#e00;margin-bottom:0.5rem;">Related</div>
