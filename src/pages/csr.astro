---
import { getYearsExperiencePlus, getYearsExperience } from '../data/company';
import BaseLayout from '../layouts/BaseLayout.astro';

const csrSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Ethical Clothing Manufacturer Bangladesh CSR & Ethics | SDF",
    "description": "SDF Clothing's CSR initiatives as an ethical clothing manufacturer in Bangladesh — worker welfare, community development, education, and environmental programs.",
    "url": "https://sdfltd.com/csr",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdfltd.com/" },
        { "@type": "ListItem", "position": 2, "name": "Community" }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SDF Clothing",
    "url": "https://sdfltd.com",
    "description": `Ethical clothing manufacturer Bangladesh with ${getYearsExperiencePlus()} years of socially responsible garment manufacturing.`,
    "foundingDate": "1998",
    "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 100, "maxValue": 1000 },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "House 125, Road 01, Baridhara DOHS",
      "addressLocality": "Dhaka",
      "postalCode": "1212",
      "addressCountry": "BD"
    }
  }
];
---

<BaseLayout
  title="Clothing Manufacturers Bangladesh CSR & Ethics | SDF"
  description="SDF Clothing's CSR initiatives as an ethical clothing manufacturer in Bangladesh — worker welfare, community development, education, and environmental programs."

  schema={csrSchema}
>

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" style="padding:0.75rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
    <div class="container" style="display:flex;align-items:center;gap:0.5rem;font-size:0.72rem;color:rgba(255,255,255,0.5);letter-spacing:0.05em;">
      <a href="/" style="color:rgba(255,255,255,0.65);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#e00'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Home</a>
      <span>/</span>
      <span style="color:#fff;">Community</span>
    </div>
  </nav>

  <div class="page-content">

    <!-- ===== HERO ===== -->
    <section style="padding:5rem 0 3.5rem;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="max-width:820px;">
          <span class="section-label">Community &amp; Social Responsibility</span>
          <div class="accent-line"></div>
          <h1 style="font-size:clamp(2rem,4vw,3.2rem);font-weight:200;line-height:1.2;margin-bottom:1.5rem;">
            Ethical Clothing Manufacturer Bangladesh Community &amp; Social Responsibility
          </h1>
          <p style="font-size:0.95rem;color:rgba(255,255,255,0.8);line-height:1.9;max-width:760px;">
            As an <strong>ethical clothing manufacturer Bangladesh</strong>, SDF Clothing has been a socially responsible garment factory for over {getYearsExperience()} years.
            As <a href="/clothing-manufacturers/" style="color:#e00;">clothing manufacturers</a> and <a href="/clothing-manufacturers/" style="color:#e00;">fashion manufacturers</a>,
            we believe that true success extends beyond business achievements to the lives we touch and the communities we serve through responsible fashion production.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== WHY ETHICAL MANUFACTURING ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="max-width:820px;">
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;margin-bottom:1.25rem;">
            Why Ethical Manufacturing Matters to Global Buyers
          </h2>
          <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;">
            As an <strong>ethical apparel manufacturer</strong> and <a href="/clothing-manufacturers/" style="color:#e00;">garments manufacturers</a>,
            we understand that UK and EU buyers prioritize supply chain transparency. A socially responsible garment factory protects your brand
            from reputational risks, ensures compliance with Modern Slavery Act requirements, and appeals to conscious consumers who demand
            <strong>responsible fashion production</strong>. Learn more about our <a href="/certifications" style="color:#e00;">certifications</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== OUR COMMITMENT ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="max-width:820px;margin-bottom:3rem;">
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;margin-bottom:1.25rem;">
            Our Commitment as an Ethical Clothing Manufacturer in Bangladesh
          </h2>
          <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;">
            As a <strong>fair wage clothing manufacturer</strong> and <a href="/clothing-manufacturers/" style="color:#e00;">apparel manufacturers</a>,
            we are committed to creating positive change through <strong>community development Bangladesh</strong> initiatives.
            Our <strong>sustainable clothing manufacturer</strong> approach integrates social responsibility into every aspect of operations,
            from our worker welfare garment factory to our environmental stewardship programs.
            Explore our <a href="/about/" style="color:#e00;">company history</a> and <a href="/products" style="color:#e00;">product catalog</a>.
          </p>
        </div>

        <!-- Stats -->
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;max-width:700px;">
          <div class="stat-card" style="padding:2rem 1.5rem;text-align:center;">
            <div style="font-size:2.2rem;font-weight:200;color:#e00;letter-spacing:0.05em;margin-bottom:0.5rem;">27+</div>
            <div style="font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.7);">Years of Ethical Manufacturing</div>
          </div>
          <div class="stat-card" style="padding:2rem 1.5rem;text-align:center;">
            <div style="font-size:2.2rem;font-weight:200;color:#e00;letter-spacing:0.05em;margin-bottom:0.5rem;">5000+</div>
            <div style="font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.7);">Lives Impacted</div>
          </div>
          <div class="stat-card" style="padding:2rem 1.5rem;text-align:center;">
            <div style="font-size:2.2rem;font-weight:200;color:#e00;letter-spacing:0.05em;margin-bottom:0.5rem;">$1M+</div>
            <div style="font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.7);">Community Investment</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WORKER WELFARE ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:2rem;">
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;margin-bottom:1rem;">
            Worker Welfare at the Heart of Our Manufacturing
          </h2>
          <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;max-width:760px;">
            As an <strong>ethical clothing manufacturer Bangladesh</strong>, we place worker welfare at the core of our operations.
            Our socially responsible garment factory ensures fair wages, safe conditions, and growth opportunities for all employees.
            As <a href="/clothing-manufacturers/" style="color:#e00;">clothing manufacturers</a> committed to ethical practices, we exceed industry standards.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== EDUCATION EMPOWERMENT ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:3rem;">
          <span class="section-label">Education</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;">Education Empowerment</h2>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
          <div class="feature-card" style="padding:2rem;">
            <h3 style="font-size:1rem;font-weight:500;margin-bottom:1rem;letter-spacing:0.05em;">School Support Program</h3>
            <p style="font-size:0.88rem;color:rgba(255,255,255,0.8);line-height:1.85;margin-bottom:1.25rem;">
              We partner with local schools in Dhaka to provide educational resources,
              school supplies, and infrastructure improvements for underprivileged children.
            </p>
            <ul style="list-style:none;font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:2;">
              <li>• Annual school supply drives</li>
              <li>• Infrastructure development projects</li>
              <li>• Teacher training programs</li>
              <li>• Scholarship opportunities</li>
            </ul>
          </div>
          <div class="feature-card" style="padding:2rem;">
            <h3 style="font-size:1rem;font-weight:500;margin-bottom:1rem;letter-spacing:0.05em;">Skills Development Center</h3>
            <p style="font-size:0.88rem;color:rgba(255,255,255,0.8);line-height:1.85;margin-bottom:1.25rem;">
              Our vocational training center provides free sewing and garment manufacturing
              training to community members, creating employment opportunities.
            </p>
            <ul style="list-style:none;font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:2;">
              <li>• Free technical training programs</li>
              <li>• Job placement assistance</li>
              <li>• Entrepreneurship support</li>
              <li>• Women empowerment initiatives</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== ENVIRONMENTAL RESPONSIBILITY ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="max-width:820px;margin-bottom:2rem;">
          <span class="section-label">Environment</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;margin-bottom:1rem;">
            Environmental Responsibility in Our Factory Operations
          </h2>
          <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;">
            Our <strong>green garment factory Bangladesh</strong> implements comprehensive environmental practices.
            As a <strong>sustainable clothing manufacturer</strong>, we follow international standards including ISO 14001 and ZDHC guidelines
            to minimize our ecological footprint.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== HEALTHCARE INITIATIVES ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:3rem;">
          <span class="section-label">Healthcare</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;">Healthcare Initiatives</h2>
        </div>
        <div class="feature-card" style="padding:2.5rem;max-width:760px;">
          <h3 style="font-size:1rem;font-weight:500;margin-bottom:1rem;letter-spacing:0.05em;">Community Health Camps</h3>
          <p style="font-size:0.88rem;color:rgba(255,255,255,0.8);line-height:1.9;margin-bottom:1.5rem;">
            We organize regular health check-up camps in partnership with local healthcare providers,
            offering free medical consultations and basic healthcare services to factory workers
            and their families. Explore our <a href="/all-services" style="color:#e00;">all services</a> to learn more about our comprehensive manufacturing capabilities.
          </p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:1.5rem;">
            <div style="font-size:0.85rem;color:rgba(255,255,255,0.8);">✓ Quarterly health check-up camps</div>
            <div style="font-size:0.85rem;color:rgba(255,255,255,0.8);">✓ Medical consultation services</div>
            <div style="font-size:0.85rem;color:rgba(255,255,255,0.8);">✓ Health awareness programs</div>
            <div style="font-size:0.85rem;color:rgba(255,255,255,0.8);">✓ Emergency medical assistance</div>
          </div>
          <div style="display:flex;align-items:center;gap:0.75rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,0.1);">
            <span style="font-size:1.5rem;">🏥</span>
            <span style="font-size:0.85rem;color:rgba(255,255,255,0.7);">500+ families served annually</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== COMMUNITY DEVELOPMENT ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="max-width:820px;margin-bottom:2rem;">
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;margin-bottom:1rem;">
            Community Development Through Ethical Apparel Manufacturing
          </h2>
          <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;">
            As an <strong>ethical apparel manufacturer</strong>, we believe in <strong>community development Bangladesh</strong> through sustainable practices.
            Our <strong>socially responsible garment factory</strong> invests in education, healthcare, and environmental initiatives to create lasting positive impact.
            As <a href="/clothing-manufacturers/" style="color:#e00;">fashion manufacturers</a> and <a href="/clothing-manufacturers/" style="color:#e00;">garments manufacturers</a>, we lead by example.
          </p>
        </div>
      </div>
    </section>

    <!-- ===== ENVIRONMENTAL STEWARDSHIP ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:3rem;">
          <span class="section-label">Stewardship</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;">Environmental Stewardship</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;">
          <div class="feature-card" style="padding:2rem;text-align:center;">
            <div style="font-size:2rem;margin-bottom:1rem;">🌱</div>
            <h3 style="font-size:0.9rem;font-weight:500;margin-bottom:0.75rem;letter-spacing:0.05em;">Tree Planting</h3>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:1.7;">10,000+ trees planted in local communities</p>
          </div>
          <div class="feature-card" style="padding:2rem;text-align:center;">
            <div style="font-size:2rem;margin-bottom:1rem;">♻️</div>
            <h3 style="font-size:0.9rem;font-weight:500;margin-bottom:0.75rem;letter-spacing:0.05em;">Waste Reduction</h3>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:1.7;">Community recycling and waste management programs</p>
          </div>
          <div class="feature-card" style="padding:2rem;text-align:center;">
            <div style="font-size:2rem;margin-bottom:1rem;">💧</div>
            <h3 style="font-size:0.9rem;font-weight:500;margin-bottom:0.75rem;letter-spacing:0.05em;">Water Conservation</h3>
            <p style="font-size:0.85rem;color:rgba(255,255,255,0.75);line-height:1.7;">Clean water access initiatives in rural areas</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WORKER WELFARE PROGRAMS ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:3rem;">
          <span class="section-label">Worker Welfare</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;">Worker Welfare Programs</h2>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;">
          <div class="feature-card" style="padding:2rem;">
            <h3 style="font-size:1rem;font-weight:500;margin-bottom:1rem;letter-spacing:0.05em;">Fair Labor Practices</h3>
            <p style="font-size:0.88rem;color:rgba(255,255,255,0.8);line-height:1.85;">
              As a <strong>fair wage clothing manufacturer</strong> and <a href="/clothing-manufacturers/" style="color:#e00;">apparel manufacturers</a>,
              we are committed to providing fair wages, safe working conditions, and growth opportunities for all our employees and their families.
              Our socially responsible garment factory complies with BSCI and SA8000 standards.
            </p>
          </div>
          <div class="feature-card" style="padding:2rem;">
            <h3 style="font-size:1rem;font-weight:500;margin-bottom:1rem;letter-spacing:0.05em;">Family Support</h3>
            <p style="font-size:0.88rem;color:rgba(255,255,255,0.8);line-height:1.85;">
              Extended healthcare coverage, educational support for children, and housing assistance programs for our workers.
              This <strong>responsible fashion production</strong> approach ensures our team thrives both professionally and personally.
              View our <a href="/certifications" style="color:#e00;">certifications</a> and <a href="/about/" style="color:#e00;">company history</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section style="padding:4rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
      <div class="container">
        <div class="section-header" style="margin-bottom:3rem;">
          <span class="section-label">FAQ</span>
          <div class="accent-line"></div>
          <h2 style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:400;">Frequently Asked Questions About Our CSR</h2>
        </div>
        <div style="max-width:820px;" id="faq-container">

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>What makes an ethical clothing manufacturer in Bangladesh different?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              An ethical clothing manufacturer in Bangladesh prioritizes worker welfare, fair wages, and environmental sustainability.
              Our socially responsible garment factory holds 13 international certifications including GOTS, BSCI, and SA8000,
              ensuring compliance with EU and UK standards for responsible fashion production.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>How does your sustainable clothing manufacturer approach community development?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              As a sustainable clothing manufacturer, we invest in community development Bangladesh through education programs,
              healthcare initiatives, and skills training. Our worker welfare garment factory has impacted over 5000 lives with
              $1M+ in community investment, supporting fair wage clothing manufacturer practices.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>What certifications does your ethical apparel manufacturer hold?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              Our ethical apparel manufacturer holds 13 international certifications including GOTS for organic textiles,
              OEKO-TEX for chemical safety, BSCI and SEDEX for social compliance, ISO 9001 for quality, and SA8000 for
              social accountability. This green garment factory Bangladesh certification ensures responsible fashion production
              for EU and UK buyers.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>How do you ensure worker welfare at your garment factory?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              Our worker welfare garment factory provides living wages compliant with BSCI and SA8000 standards, safe working
              conditions, free healthcare, childcare facilities, and skills development. As a fair wage clothing manufacturer,
              we maintain zero tolerance for child labor and ensure voluntary overtime participation.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>What environmental practices does your green garment factory Bangladesh implement?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              Our green garment factory Bangladesh implements ISO 14001 certified environmental management, wastewater treatment,
              solar energy integration, water recycling reducing consumption by 40%, and eco-friendly dyes. As a sustainable
              clothing manufacturer, we follow ZDHC chemical guidelines and have planted 10,000+ trees.
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>Why choose a socially responsible garment factory for your brand?</span>
              <span class="faq-icon" aria-hidden="true" style="font-size:1.2rem;line-height:1;">+</span>
            </button>
            <div class="faq-answer">
              Choosing a socially responsible garment factory protects your brand from supply chain risks, ensures compliance with
              EU Modern Slavery Act and UK regulations, and appeals to conscious consumers. Our ethical apparel manufacturer
              provides transparent sourcing, verified certifications, and documented impact reports for responsible fashion production.
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section style="padding:5rem 0;">
      <div class="container">
        <div style="max-width:680px;">
          <div class="section-header" style="margin-bottom:2.5rem;">
            <h2 style="font-size:clamp(1.5rem,3vw,2.2rem);font-weight:200;margin-bottom:1rem;">Source Ethically With Us</h2>
            <p style="font-size:0.92rem;color:rgba(255,255,255,0.8);line-height:1.9;">
              Partner with our <strong>ethical clothing manufacturer Bangladesh</strong> to create positive change in the fashion industry and our communities.
              Together, we can build a more sustainable and equitable future through <strong>responsible fashion production</strong>.
              <a href="/contact/" style="color:#e00;">Contact us</a> to discuss your ethical sourcing requirements.
            </p>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:1rem;">
            <a href="/contact/" class="btn-primary">Source Ethically With Us</a>
            <a href="/certifications" class="btn-secondary">View Our Sustainability Standards</a>
          </div>
          <p style="margin-top:2rem;font-size:0.82rem;color:rgba(255,255,255,0.5);line-height:1.8;">
            Learn more about international labor standards from <a href="https://ilo.org" target="_blank" rel="noopener noreferrer" style="color:#e00;">ILO</a> and
            UN Global Compact principles for <a href="https://unglobalcompact.org" target="_blank" rel="noopener noreferrer" style="color:#e00;">responsible business</a>.
            Explore our <a href="/about/" style="color:#e00;">company history</a>, <a href="/certifications" style="color:#e00;">certifications</a>,
            <a href="/products" style="color:#e00;">product catalog</a>, and <a href="/faq/" style="color:#e00;">FAQ page</a>.
          </p>
        </div>
      </div>
    </section>

  </div>

  <!-- FAQ Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.faq-question').forEach(btn => {
        btn.addEventListener('click', () => {
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          // Close all
          document.querySelectorAll('.faq-question').forEach(b => {
            b.setAttribute('aria-expanded', 'false');
            b.nextElementSibling?.classList.remove('open');
          });
          // Open clicked if it was closed
          if (!isOpen) {
            btn.setAttribute('aria-expanded', 'true');
            btn.nextElementSibling?.classList.add('open');
          }
        });
      });
    });
  </script>

  <!-- Section header scroll animation -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.section-header').forEach(el => observer.observe(el));
    });
  </script>

  <!-- Mobile responsive styles -->
