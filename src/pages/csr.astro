---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAge, getCompanyAgeString } from '../utils/companyAge';

export const prerender = true;

const pageTitle = "Ethical Clothing Manufacturer Bangladesh CSR & Community";
const pageDescription = "As an ethical clothing manufacturer Bangladesh, we drive community impact and worker welfare. Source responsibly with our socially responsible garment factory.";
const companyAge = getCompanyAge();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl.href}>
	<!-- Robots Meta -->
	<meta name="robots" content="index, follow" />
	
	<!-- Open Graph Tags -->
	<meta property="og:title" content="Ethical Clothing Manufacturer Bangladesh CSR & Community" />
	<meta property="og:description" content="As an ethical clothing manufacturer Bangladesh, we drive community impact and worker welfare. Source responsibly with our socially responsible garment factory." />
	<meta property="og:image" content="https://sdfltd.com/hero.webp" />
	<meta property="og:url" content={canonicalUrl.href} />
	<meta property="og:type" content="website" />
	
	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="Ethical Clothing Manufacturer Bangladesh CSR & Community" />
	<meta name="twitter:description" content="As an ethical clothing manufacturer Bangladesh, we drive community impact and worker welfare. Source responsibly with our socially responsible garment factory." />
	<meta name="twitter:image" content="https://sdfltd.com/hero.webp" />
	<!-- JSON-LD Schema -->
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "WebPage",
				"@id": canonicalUrl.href,
				"url": canonicalUrl.href,
				"name": pageTitle,
				"description": pageDescription,
				"inLanguage": "en-GB",
				"isPartOf": {
					"@type": "WebSite",
					"@id": "https://sdfltd.com/#website",
					"url": "https://sdfltd.com",
					"name": "SDF Clothing"
				}
			},
			{
				"@type": "Organization",
				"@id": "https://sdfltd.com/#org",
				"name": "SDF Clothing",
				"url": "https://sdfltd.com",
				"description": "Ethical clothing manufacturer Bangladesh committed to CSR, community development, and worker welfare since 1998. A socially responsible garment factory providing sustainable clothing manufacturing services.",
				"foundingDate": "1998-08-22",
				"foundingLocation": "Dhaka, Bangladesh",
				"areaServed": ["European Union", "United Kingdom", "United States", "Australia", "Canada"],
				"sameAs": [
					"https://linkedin.com/company/sdfclothing",
					"https://twitter.com/sdfclothing"
				]
			},
			{
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What makes an ethical clothing manufacturer in Bangladesh different?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "An ethical clothing manufacturer in Bangladesh prioritizes worker welfare, fair wages, and environmental sustainability. Our socially responsible garment factory holds 13 international certifications including GOTS, BSCI, and SA8000, ensuring compliance with EU and UK standards for responsible fashion production."
						}
					},
					{
						"@type": "Question",
						"name": "How does your sustainable clothing manufacturer approach community development?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "As a sustainable clothing manufacturer, we invest in community development Bangladesh through education programs, healthcare initiatives, and skills training. Our worker welfare garment factory has impacted over 5000 lives with $1M+ in community investment, supporting fair wage clothing manufacturer practices."
						}
					},
					{
						"@type": "Question",
						"name": "What certifications does your ethical apparel manufacturer hold?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Our ethical apparel manufacturer holds 13 international certifications including GOTS for organic textiles, OEKO-TEX for chemical safety, BSCI and SEDEX for social compliance, ISO 9001 for quality, and SA8000 for social accountability. This green garment factory Bangladesh certification ensures responsible fashion production for EU and UK buyers."
						}
					},
					{
						"@type": "Question",
						"name": "How do you ensure worker welfare at your garment factory?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Our worker welfare garment factory provides living wages compliant with BSCI and SA8000 standards, safe working conditions, free healthcare, childcare facilities, and skills development. As a fair wage clothing manufacturer, we maintain zero tolerance for child labor and ensure voluntary overtime participation."
						}
					},
					{
						"@type": "Question",
						"name": "What environmental practices does your green garment factory Bangladesh implement?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Our green garment factory Bangladesh implements ISO 14001 certified environmental management, wastewater treatment, solar energy integration, water recycling reducing consumption by 40%, and eco-friendly dyes. As a sustainable clothing manufacturer, we follow ZDHC chemical guidelines and have planted 10,000+ trees."
						}
					},
					{
						"@type": "Question",
						"name": "Why choose a socially responsible garment factory for your brand?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Choosing a socially responsible garment factory protects your brand from supply chain risks, ensures compliance with EU Modern Slavery Act and UK regulations, and appeals to conscious consumers. Our ethical apparel manufacturer provides transparent sourcing, verified certifications, and documented impact reports for responsible fashion production."
						}
					}
				]
			},
			{
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"name": "Home",
						"item": "https://sdfltd.com"
					},
					{
						"@type": "ListItem",
						"position": 2,
						"name": "Community",
						"item": canonicalUrl.href
					}
				]
			}
		]
	}
	</script>

	<section class="py-20 px-4">
		<div class="container mx-auto max-w-6xl">
			<!-- Breadcrumb Navigation -->
			<nav aria-label="Breadcrumb" class="mb-8">
				<div class="container mx-auto max-w-4xl">
					<ol class="flex items-center justify-center space-x-2 text-sm">
						<li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
						<li class="text-white/40">/</li>
						<li><span class="text-white">Community</span></li>
					</ol>
				</div>
			</nav>
			<!-- Header Section -->
			<div class="text-center mb-16">
				<h1 class="text-3xl md:text-4xl font-bold text-white mb-6">
					Ethical Clothing Manufacturer Bangladesh Community & Social Responsibility
				</h1>
				<p class="text-white/80 text-lg max-w-3xl mx-auto">
					As an <strong>ethical clothing manufacturer Bangladesh</strong>, SDF Clothing has been a socially responsible garment factory for over {companyAge} years. We believe that true success extends beyond business achievements to the lives we touch and the communities we serve through responsible fashion production.
				</p>
			</div>

			<!-- H2: Why Ethical Manufacturing Matters -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Why Ethical Manufacturing Matters to Global Buyers</h2>
				<p class="text-white/80 text-center max-w-3xl mx-auto mb-8">
					As an <strong>ethical apparel manufacturer</strong>, we understand that UK and EU buyers prioritize supply chain transparency. A socially responsible garment factory protects your brand from reputational risks, ensures compliance with Modern Slavery Act requirements, and appeals to conscious consumers who demand <strong>responsible fashion production</strong>.
				</p>
			</div>

			<!-- H2: Our Commitment -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Our Commitment as an Ethical Clothing Manufacturer in Bangladesh</h2>
				<p class="text-white/80 text-center max-w-3xl mx-auto mb-8">
					As a <strong>fair wage clothing manufacturer</strong>, we are committed to creating positive change through <strong>community development Bangladesh</strong> initiatives. Our <strong>sustainable clothing manufacturer</strong> approach integrates social responsibility into every aspect of operations, from our worker welfare garment factory to our environmental stewardship programs.
				</p>
			</div>

			<!-- Impact Stats -->
			<div class="grid md:grid-cols-3 gap-8 mb-16">
				<div class="snake-card p-8 text-center">
					<div class="text-4xl font-bold text-[#cc0000] mb-2">{companyAge}+</div>
					<div class="text-white font-semibold">Years of Ethical Manufacturing</div>
				</div>
				<div class="snake-card p-8 text-center">
					<div class="text-4xl font-bold text-[#cc0000] mb-2">5000+</div>
					<div class="text-white font-semibold">Lives Impacted</div>
				</div>
				<div class="snake-card p-8 text-center">
					<div class="text-4xl font-bold text-[#cc0000] mb-2">$1M+</div>
					<div class="text-white font-semibold">Community Investment</div>
				</div>
			</div>

			<!-- H2: Worker Welfare -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Worker Welfare at the Heart of Our Manufacturing</h2>
				<p class="text-white/80 text-center max-w-3xl mx-auto mb-8">
					As an <strong>ethical clothing manufacturer Bangladesh</strong>, we place worker welfare at the core of our operations. Our socially responsible garment factory ensures fair wages, safe conditions, and growth opportunities for all employees.
				</p>
			</div>

			<!-- Education Initiatives -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Education Empowerment</h2>
				<div class="grid md:grid-cols-2 gap-8">
					<div class="snake-card p-8">
						<h3 class="text-xl font-bold text-white mb-4">School Support Program</h3>
						<p class="text-white/80 mb-4">
							We partner with local schools in Dhaka to provide educational resources, 
							school supplies, and infrastructure improvements for underprivileged children.
						</p>
						<ul class="text-white/70 space-y-2">
							<li>• Annual school supply drives</li>
							<li>• Infrastructure development projects</li>
							<li>• Teacher training programs</li>
							<li>• Scholarship opportunities</li>
						</ul>
					</div>
					<div class="snake-card p-8">
						<h3 class="text-xl font-bold text-white mb-4">Skills Development Center</h3>
						<p class="text-white/80 mb-4">
							Our vocational training center provides free sewing and garment manufacturing 
							training to community members, creating employment opportunities.
						</p>
						<ul class="text-white/70 space-y-2">
							<li>• Free technical training programs</li>
							<li>• Job placement assistance</li>
							<li>• Entrepreneurship support</li>
							<li>• Women empowerment initiatives</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- H2: Environmental Responsibility -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Environmental Responsibility in Our Factory Operations</h2>
				<p class="text-white/80 text-center max-w-3xl mx-auto mb-8">
					Our <strong>green garment factory Bangladesh</strong> implements comprehensive environmental practices. As a <strong>sustainable clothing manufacturer</strong>, we follow international standards including ISO 14001 and ZDHC guidelines to minimize our ecological footprint.
				</p>
			</div>

			<!-- Healthcare Support -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Healthcare Initiatives</h2>
				<div class="snake-card p-8">
					<div class="grid md:grid-cols-2 gap-8 items-center">
						<div>
							<h3 class="text-xl font-bold text-white mb-4">Community Health Camps</h3>
							<p class="text-white/80 mb-4">
								We organize regular health check-up camps in partnership with local healthcare providers, 
								offering free medical consultations and basic healthcare services to factory workers 
								and their families.
							</p>
							<div class="space-y-3">
								<div class="flex items-center text-white/80">
									<span class="text-[#cc0000] mr-3">✓</span>
									Quarterly health check-up camps
								</div>
								<div class="flex items-center text-white/80">
									<span class="text-[#cc0000] mr-3">✓</span>
									Medical consultation services
								</div>
								<div class="flex items-center text-white/80">
									<span class="text-[#cc0000] mr-3">✓</span>
									Health awareness programs
								</div>
								<div class="flex items-center text-white/80">
									<span class="text-[#cc0000] mr-3">✓</span>
									Emergency medical assistance
								</div>
							</div>
						</div>
						<div class="text-center">
							<div class="text-6xl mb-4">🏥</div>
							<p class="text-white/70">500+ families served annually</p>
						</div>
					</div>
				</div>
			</div>

			<!-- H2: Community Development -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Community Development Through Ethical Apparel Manufacturing</h2>
				<p class="text-white/80 text-center max-w-3xl mx-auto mb-8">
					As an <strong>ethical apparel manufacturer</strong>, we believe in <strong>community development Bangladesh</strong> through sustainable practices. Our <strong>socially responsible garment factory</strong> invests in education, healthcare, and environmental initiatives to create lasting positive impact.
				</p>
			</div>

			<!-- Environmental Stewardship -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Environmental Stewardship</h2>
				<div class="grid md:grid-cols-3 gap-8">
					<div class="snake-card p-6 text-center">
						<div class="text-4xl mb-3">🌱</div>
						<h3 class="text-lg font-bold text-white mb-2">Tree Planting</h3>
						<p class="text-white/70 text-sm">10,000+ trees planted in local communities</p>
					</div>
					<div class="snake-card p-6 text-center">
						<div class="text-4xl mb-3">♻️</div>
						<h3 class="text-lg font-bold text-white mb-2">Waste Reduction</h3>
						<p class="text-white/70 text-sm">Community recycling and waste management programs</p>
					</div>
					<div class="snake-card p-6 text-center">
						<div class="text-4xl mb-3">💧</div>
						<h3 class="text-lg font-bold text-white mb-2">Water Conservation</h3>
						<p class="text-white/70 text-sm">Clean water access initiatives in rural areas</p>
					</div>
				</div>
			</div>

			<!-- Worker Welfare -->
			<div class="mb-16">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Worker Welfare Programs</h2>
				<div class="snake-card p-8">
					<div class="grid md:grid-cols-2 gap-8">
						<div>
							<h3 class="text-xl font-bold text-white mb-4">Fair Labor Practices</h3>
							<p class="text-white/80 mb-4">
								As a <strong>fair wage clothing manufacturer</strong>, we are committed to providing fair wages, safe working conditions, and growth opportunities for all our employees and their families. Our socially responsible garment factory complies with BSCI and SA8000 standards.
							</p>
						</div>
						<div>
							<h3 class="text-xl font-bold text-white mb-4">Family Support</h3>
							<p class="text-white/80 mb-4">
								Extended healthcare coverage, educational support for children, and housing assistance programs for our workers. This <strong>responsible fashion production</strong> approach ensures our team thrives both professionally and personally.
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Call to Action -->
			<div class="text-center">
				<div class="snake-card p-8 max-w-2xl mx-auto">
					<h3 class="text-2xl font-bold text-white mb-4">Source Ethically With Us</h3>
					<p class="text-white/80 mb-6">
						Partner with our <strong>ethical clothing manufacturer Bangladesh</strong> to create positive change in the fashion industry and our communities. 
						Together, we can build a more sustainable and equitable future through <strong>responsible fashion production</strong>.
					</p>
					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a href="/contact" style="background:transparent; border: 0.6px solid #666; color: #fff; padding: 0.85rem 2rem; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s, color 0.2s; font-family: inherit; display:inline-block; text-align:center;" onmouseover="this.style.background='#666';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#fff'">Source Ethically With Us</a>
						<a href="/certifications" style="background:transparent; border: 0.6px solid #666; color: #fff; padding: 0.85rem 2rem; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s, color 0.2s; font-family: inherit; display:inline-block; text-align:center;" onmouseover="this.style.background='#666';this.style.color='#fff'" onmouseout="this.style.background='transparent';this.style.color='#fff'">View Our Sustainability Standards</a>
					</div>
					<p class="text-white/60 text-sm mt-6">
						Learn more about international labor standards from <a href="https://ilo.org" target="blank" rel="noopener noreferrer" class="text-[#cc0000] hover:underline">ILO</a> and UN Global Compact principles for <a href="https://unglobalcompact.org" target="blank" rel="noopener noreferrer" class="text-[#cc0000] hover:underline">responsible business</a>. Explore our <a href="/about" class="text-[#cc0000] hover:underline">company history</a> and <a href="/certifications" class="text-[#cc0000] hover:underline">certifications</a>.
					</p>
				</div>
			</div>
		</div>
	</section>

</BaseLayout>