        {
          "@type": "HowToStep",
          "name": "Submit Design Requirements",
          "text": "Send your tank top design, fabric preferences (cotton, bamboo, modal), style type (basic, racerback, muscle), size chart, and target quantity via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including fabric costs, production, customization, and shipping for your tank top order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Samples",
          "text": "Review tank top samples for fit, fabric hand feel, construction quality, and finish details within 15-20 days before bulk production"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Production begins after sample approval with 30-40 day turnaround for standard tank top items"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Shipping",
          "text": "Final quality check before shipment with tracking documentation for your tank top order"
        }
      ]
    }
  ]
};
