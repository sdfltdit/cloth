---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { schemaOrganization, SITE_URL as SITE } from '../data/schema';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';

export const prerender = true;

const companyAge = getCompanyAgeString();

const pageTitle = "Sustainable Fashion Manufacturing Guide 2026 | Complete Process";
const pageDescription = "Step-by-step guide to sustainable fashion manufacturing. Learn GOTS 7.0, OEKO-TEX, ethical sourcing, EU ESPR compliance, and build green collections.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const whatsappQuoteUrl = `${WHATSAPP_URL}?text=Hi%20SDF%20Clothing%2C%20I%27d%20like%20a%20quote%20for%20sustainable%20clothing%20manufacturing`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23",
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": SITE + "/#website",
        "url": SITE,
        "name": "SDF Clothing"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": SITE
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": pageTitle,
            "item": Astro.url.href
          }
        ]
      },
      "publisher": { "@id": SITE + "/#organization" }
    },
    schemaOrganization,
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What certifications make a clothing manufacturer truly sustainable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Key certifications include GOTS for organic fiber processing, OEKO-TEX Standard 100 for chemical safety, OEKO-TEX MADE IN GREEN for product and facility verification, BSCI for social compliance, WRAP for ethical manufacturing, GRS for recycled content, and Fair Trade for fair wages. Multiple certifications across environmental, social, and quality standards indicate genuine sustainability commitment."
          }
        },
        {
          "@type": "Question",
          "name": "Is GOTS or OEKO-TEX more important for sustainable fashion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They serve different purposes. GOTS covers organic fiber from farm to finished product, including environmental and social criteria throughout the supply chain. OEKO-TEX Standard 100 focuses on chemical safety in the final product. For organic cotton clothing, GOTS is essential. For chemical safety verification regardless of fiber type, OEKO-TEX is critical. Many sustainable brands pursue both certifications."
          }
        },
        {
          "@type": "Question",
          "name": "How much more does sustainable clothing manufacturing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sustainable manufacturing typically costs 15-25% more overall. GOTS certified organic cotton adds 8-12% to production cost, OEKO-TEX processing adds 3-5%, BSCI/WRAP compliance adds 2-4%, and recycled polyester adds 10-20% to fabric cost. However, these costs enable 30-60% retail price premiums, making sustainability profitable for brands positioned in premium segments."
          }
        },
        {
          "@type": "Question",
          "name": "What does the EU Green Claims Directive mean for fashion brands?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EU Green Claims Directive, effective from 2026, requires all environmental claims to be verified by independent third parties. Vague terms like 'eco-friendly' without specific evidence are now illegal in the EU market. Brands must provide scientific evidence, methodology, and data for sustainability claims. This regulation targets greenwashing and requires substantiated, transparent communication."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Digital Product Passport for textiles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Digital Product Passport (DPP) is an EU regulation requiring from 2027 that textile products carry digital information about fiber origin, manufacturer, recycled content, chemical use, and end-of-life instructions. Brands must track and disclose supply chain data through QR codes or similar technology. This enables transparency, supports circular economy goals, and helps consumers make informed choices."
          }
        },
        {
          "@type": "Question",
          "name": "How do I verify a manufacturer's sustainability claims?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verify certifications through official databases: GOTS at gots.net/certify, OEKO-TEX at oeko-tex.com, WRAP at wrapcompliance.org. Request audit reports and check certificate validity dates. Look for specific claims backed by data rather than vague statements. Ask for transaction certificates for organic materials. Genuine manufacturers provide verification links and documentation readily."
          }
        },
        {
          "@type": "Question",
          "name": "What fabrics are most sustainable for clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top sustainable fabrics include organic cotton (GOTS certified) with low environmental impact, hemp with very low water needs, TENCEL/Lyocell with closed-loop production, recycled polyester (rPET) reducing plastic waste, and bamboo processed with OEKO-TEX certification. Conventional cotton and virgin polyester have higher environmental footprints. Fabric choice depends on product requirements and certification needs."
          }
        },
        {
          "@type": "Question",
          "name": "Can small brands afford sustainable manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, small brands can access sustainable manufacturing by choosing manufacturers with lower MOQs. SDF Clothing offers 300 piece minimums for sustainable production. While per-unit costs are higher, the retail price premium for sustainable products can offset this. Many sustainable brands start with capsule collections using certified materials and scale as volume increases."
          }
        },
        {
          "@type": "Question",
          "name": "What is CBAM and how does it affect fashion brands importing to the EU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The EU Carbon Border Adjustment Mechanism (CBAM), effective January 2026, imposes carbon costs on energy-intensive imports including textiles. Manufacturing powered by coal electricity (common in some regions) will face higher costs than gas or renewable-powered factories. Bangladesh's coal dependency may increase costs versus countries with cleaner energy. CBAM encourages low-carbon production and affects sourcing decisions."
          }
        },
        {
          "@type": "Question",
          "name": "Is Bangladesh sustainable for clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bangladesh has made significant sustainability progress since 2013, with many factories now GOTS, OEKO-TEX, BSCI, and WRAP certified. The country faces challenges with coal-based electricity affecting CBAM compliance, but certified factories implement water recycling, energy efficiency, and waste reduction. Bangladesh offers competitive sustainable manufacturing costs, though brands should verify individual factory certifications and environmental practices."
          }
        }
      ]
    },
    {
      "@type": "Article",
      "headline": pageTitle,
      "description": pageDescription,
      "author": { "@id": SITE + "/#organization" },
      "publisher": { "@id": SITE + "/#organization" },
      "datePublished": "2025-01-15",
      "dateModified": "2026-05-23"
    },
    {
      "@type": "HowTo",
      "name": "How to Build a Sustainable Clothing Collection",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Choose sustainable materials with actual certification",
          "text": "Select fabrics backed by verifiable certifications such as GOTS for organic cotton, GRS for recycled materials, or OEKO-TEX for chemical safety. Avoid vague 'eco-friendly' claims without certification backing."
        },
        {
          "@type": "HowToStep",
          "name": "Select a manufacturer with verified certifications",
          "text": "Partner with factories holding relevant certifications for your materials and market requirements. Verify certifications through official databases and request current audit reports."
        },
        {
          "@type": "HowToStep",
          "name": "Develop tech pack with sustainability specifications",
          "text": "Include material certifications, chemical restrictions, and environmental requirements in your technical specifications. Specify sustainable construction methods and finishing processes."
        },
        {
          "@type": "HowToStep",
          "name": "Request certified fabric samples and lab dip approval",
          "text": "Obtain samples with transaction certificates verifying material origin and certification status. Approve lab dips confirming color meets environmental standards."
        },
        {
          "@type": "HowToStep",
          "name": "Conduct pre-production audit for social and environmental compliance",
          "text": "Verify factory compliance with labor standards, environmental regulations, and certification requirements before bulk production begins."
        },
        {
          "@type": "HowToStep",
          "name": "Communicate sustainability credentials clearly on product and marketing",
          "text": "Provide accurate information about certifications, materials, and sustainable practices. Avoid greenwashing by ensuring all claims are substantiated with documentation."
        }
      ]
    }
  ]
};
---

