---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const pageTitle = "Editorial Policy — SDF Clothing";
const pageDescription = "Our editorial policy outlines how we create, verify, and maintain content accuracy. Learn about our content standards, review process, and correction policy.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": "https://sdfltd.com/editorial-policy/",
    "isPartOf": { "@id": "https://sdfltd.com/#website" }
  }
];

---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>

<section style="padding:5rem 0;">
  <div class="container" style="max-width:800px;margin:0 auto;padding:0 1rem;">
    <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem;">
      <p style="font-size:0.72rem;color:#FFFFFF;">
        <a href="/" style="color:#FFFFFF;text-decoration:none;">Home</a>
        <span style="margin:0 0.5rem;color:#333;">›</span>
        Editorial Policy
      </p>
    </nav>
    
    <p style="font-size:0.65rem;letter-spacing:0.3em;text-transform:uppercase;color:#e00;margin-bottom:0.75rem;">Trust & Transparency</p>
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:200;color:#fff;margin-bottom:1.5rem;line-height:1.2;">Editorial Policy</h1>
    <p style="color:#FFFFFF;line-height:1.8;font-size:0.95rem;margin-bottom:3rem;">Last reviewed: May 2026</p>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Who Creates Our Content</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-bottom:1rem;">All content on the SDF Clothing website is created and reviewed by Chowdhury Remon, Founder & CEO, together with the SDF Clothing team. Our team brings 25+ years of direct garment industry experience in Bangladesh's Ready-Made Garment (RMG) sector.</p>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;">Our content reflects hands-on manufacturing expertise, technical knowledge of production processes, and deep understanding of international buyer requirements across EU, UK, USA, Canada, and Australia markets.</p>
    </div>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Content Verification</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-bottom:1rem;">All information on our website is drawn from:</p>
      <ul style="list-style:none;padding:0;margin:0;color:#FFFFFF;line-height:1.8;font-size:0.92rem;">
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Direct factory knowledge and production data from our manufacturing facility</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Official certification bodies (GOTS, OEKO-TEX, ISO, BSCI, SEDEX, WRAP, SA8000)</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Bangladesh Garment Manufacturers and Exporters Association (BGMEA) standards</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> International trade regulations and customs documentation requirements</li>
        <li style="padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Industry best practices and technical specifications</li>
      </ul>
    </div>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Update Policy</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-bottom:1rem;">We maintain a regular review schedule to ensure content accuracy:</p>
      <ul style="list-style:none;padding:0;margin:0;color:#FFFFFF;line-height:1.8;font-size:0.92rem;">
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> General content and guides: reviewed quarterly minimum</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Pricing calculators and tool data: reviewed monthly</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Certification information: updated immediately upon renewal or change</li>
        <li style="padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> Regulatory compliance content: updated when regulations change</li>
      </ul>
    </div>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Corrections Policy</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-bottom:1rem;">If you identify any factual errors, outdated information, or inaccuracies on our website, please contact us:</p>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;">Please <a href="/contact" style="color:#fff;border-bottom:1px solid #e00;text-decoration:none;">contact us</a> with subject line "Correction Request"</p>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-top:1rem;">We review all correction requests within 5 business days and will update content promptly when errors are verified.</p>
    </div>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">No Paid Placements</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;">SDF Clothing maintains editorial independence:</p>
      <ul style="list-style:none;padding:0;margin:0;color:#FFFFFF;line-height:1.8;font-size:0.92rem;">
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> No sponsored content or paid articles</li>
        <li style="margin-bottom:0.75rem;padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> No paid rankings or featured placements</li>
        <li style="padding-left:1rem;position:relative;"><span style="position:absolute;left:0;color:#e00;">•</span> All tool recommendations are based on our own assessment and industry standards</li>
      </ul>
    </div>

    <div style="border:1px solid #e00;padding:3rem;margin-bottom:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Tool Accuracy Disclaimer</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;">Our online calculators and tools (Price Calculator, MOQ Calculator, Shipping Estimator, etc.) provide estimates based on standard industry parameters. These tools are for planning and estimation purposes only.</p>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;margin-top:1rem;">Final pricing, lead times, and costs must be confirmed directly with SDF Clothing through our formal quote process. Actual production costs may vary based on specific garment specifications, fabric selection, order quantity, and current market conditions.</p>
    </div>

    <div style="border:1px solid #e00;padding:3rem;">
      <h2 style="font-size:1.4rem;font-weight:300;color:#fff;margin-bottom:1.5rem;">Contact Us</h2>
      <p style="color:#FFFFFF;line-height:1.8;font-size:0.92rem;">For questions about our editorial policy or to request content updates, please <a href="/contact" style="color:#fff;border-bottom:1px solid #e00;text-decoration:none;">contact us</a></p>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
  }
</style>

</BaseLayout>
