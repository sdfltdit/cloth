  .faq-q {
    font-size: 0.9rem; font-weight: 500; color: #fff;
    margin-bottom: 0.75rem; line-height: 1.5;
  }
  .faq-a { font-size: 0.85rem; color: rgba(255,255,255,0.7); line-height: 1.8; }
</style>

