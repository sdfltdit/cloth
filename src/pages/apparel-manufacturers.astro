    --color-bg: #000;
    --color-text: #fff;
    --color-accent: #e00;
    --color-subtle: rgba(255,255,255,0.65);
  }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .cta-button {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #e00; color: #fff; border: none;
    padding: 0.85rem 1.75rem; font-size: 0.82rem;
    font-weight: 500; letter-spacing: 0.05em;
    text-decoration: none; cursor: pointer;
    transition: background 0.2s; min-height: 44px;
  }
  .cta-button:hover { background: #c00; }
  .whatsapp-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: transparent; color: #fff;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.85rem 1.75rem; font-size: 0.82rem;
    font-weight: 500; letter-spacing: 0.05em;
    text-decoration: none; transition: border-color 0.2s;
    min-height: 44px;
  }
  .whatsapp-cta:hover { border-color: #fff; }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px; background: #1a1a1a;
  }
  .feature-card {
    background: #000; padding: 2rem;
    border-top: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .feature-card:hover { border-color: #e00; }
  .cert-grid {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .cert-badge {
    border: 1px solid #333; color: rgba(255,255,255,0.8);
    padding: 0.3rem 0.7rem; font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .faq-item { border-bottom: 1px solid #1a1a1a; padding: 1.5rem 0; }
