</section>

<!-- CERTIFICATIONS -->
<section style="padding:5rem 0; border-bottom:1px solid #1a1a1a;">
  <div class="container">
    <p style="font-size:0.65rem; letter-spacing:0.25em; text-transform:uppercase; color:#e00; margin-bottom:1rem;">Compliance & Certification</p>
    <h2 style="font-size:clamp(1.4rem,2.5vw,2rem); font-weight:200; color:#fff; margin-bottom:1rem; max-width:540px;">
      13 active international certifications — audit-ready at all times
    </h2>
    <p style="font-size:0.88rem; color:rgba(255,255,255,0.65); max-width:600px; line-height:1.8; margin-bottom:0.5rem;">
      We maintain continuous certification across quality, environmental, social compliance, and product safety standards. All certificates are publicly verifiable. Certificate numbers and issuing body details are listed on our <a href="/certifications" style="color:#fff; border-bottom:0.5px solid #444;">certifications page</a>.
    </p>
    <div class="cert-grid">
      {["GOTS 7.0","OEKO-TEX Std 100","ISO 9001:2015","ISO 14001","BSCI","SEDEX SMETA","WRAP","SA8000","C-TPAT","GRS","OCS","RCS","BCI"].map(c => (
