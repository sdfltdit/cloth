        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Garment Washing Service",
            "item": Astro.url.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the minimum order quantity for garment washing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our minimum order quantity for garment washing service is 500 pieces per style and colorway. This minimum ensures efficient batch processing while providing cost-effective pricing for brands. The 500-piece minimum applies to each wash type and color combination. Lower quantities are available for sampling and prototype development at higher per-piece costs for brands requiring smaller batches for testing or initial collections."
          }
        },
        {
          "@type": "Question",
          "name": "What washing services do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer enzyme wash for softening and bio-polishing, stone wash for vintage denim appearance, bleach wash for color lightening and whitening, acid wash for contrast effects, silicon wash for soft hand feel, and pigment wash for color effects. Each wash type produces distinct aesthetic and hand feel characteristics. We can combine multiple wash techniques for complex effects. Our washing services apply to denim, cotton, and blended fabrics."
          }
        },
        {
          "@type": "Question",
          "name": "What garment types can you wash?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We wash denim jeans and jackets, t-shirts and casual wear, shirts and blouses, trousers and pants, dresses and skirts, and workwear and uniforms. Our facility handles both heavy-weight denim items requiring intensive washing and lightweight garments requiring gentle processing. Each garment type requires specific washing parameters to achieve desired effects while maintaining garment integrity."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer eco-friendly washing options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We offer enzyme wash using biodegradable enzymes that break down naturally, laser finishing as an alternative to chemical treatments, and eco-friendly softeners that are biodegradable and non-toxic. These eco-friendly options reduce environmental impact compared to traditional chemical washing methods. Eco-friendly washing may cost 10-15% more than conventional methods but provides sustainability credentials appealing to environmentally conscious brands and consumers."
          }
        },
        {
          "@type": "Question",
          "name": "How long does garment washing take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard washing timeline is 7-10 days from garment receipt for basic washes like enzyme wash. Complex washes such as stone wash or bleach wash typically require 10-15 days. Custom wash development adds 5-7 days. Sampling takes 5-7 days before bulk processing. Multi-step wash processes combining multiple techniques may require 15-20 days total processing time. We provide detailed timelines with each quotation based on your specific wash requirements."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide quality assurance for washed garments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We conduct quality inspection before and after washing to ensure consistent results. Pre-wash inspection verifies garment condition and identifies any pre-existing issues. Post-wash inspection verifies that wash effects meet specifications, checks for color consistency across the batch, and ensures dimensional stability. We provide detailed inspection reports with photos documenting wash results. Any garments not meeting specifications are reprocessed or replaced before shipment."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Garment Washing Service",
      "description": "Professional garment washing and finishing service from 500 pieces including enzyme wash, stone wash, bleach wash for denim and apparel",
      "provider": {
        "@id": "https://sdfltd.com/#org"
      },
      "areaServed": ["United States", "United Kingdom", "European Union", "Canada", "Australia"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Garment Washing Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Garment Washing and Finishing"
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "priceCurrency": "USD",
              "minPrice": "1",
              "maxPrice": "5"
            }
          }
        ]
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Use Our Garment Washing Service",
      "description": "Step-by-step process for garment washing service from our Bangladesh facility",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Washing Requirements",
          "text": "Send your garment details, wash type preference, desired effect, quantity, and target timeline via contact form"
        },
        {
          "@type": "HowToStep",
          "name": "Receive Detailed Quote",
          "text": "Get pricing within 24-48 hours including wash costs, processing, and quality assurance for your washing order"
        },
        {
          "@type": "HowToStep",
          "name": "Approve Wash Samples",
          "text": "Review washed samples for effect, hand feel, color, and quality within 5-7 days before bulk processing"
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Washing Process",
          "text": "Processing begins after sample approval with 7-10 day turnaround for standard washing types"
        },
        {
          "@type": "HowToStep",
          "name": "Quality Inspection & Delivery",
          "text": "Final quality check before delivery with inspection report for your washed garments"
        }
      ]
    }
  ]
};
---

<BaseLayout 
