---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Garment Washing Service | Denim Finishing SDF";
const pageDescription = "Garment washing service in Bangladesh. Enzyme wash, stone wash, bleach wash for denim and apparel. Professional finishing from 500 pieces. Free quote.";
const companyAge = getCompanyAgeString();

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": Astro.url.href,
      "url": Astro.url.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
          "@id": "https://sdfltd.com/#website",
          "url": "https://sdfltd.com/",
          "name": "SDF Clothing",
          "publisher": {
            "@type": "Organization",
            "@id": "https://sdfltd.com/#org",
            "name": "SDF Clothing",
            "url": "https://sdfltd.com/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://sdfltd.com/logo.png"
            },
            "sameAs": [
              "https://www.facebook.com/sdfltd",
