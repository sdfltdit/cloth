  var dueFields = ['s-due','b-due'];
  for (var e = 0; e < dueFields.length; e++) {
    var el2 = document.getElementById(dueFields[e]);
    if (el2) { el2.value = dueStr; }
  }

  renderSItems();
  renderSample();
  renderCorrHist();
  renderCItems();
  renderCorr();
  renderBItems();
  renderBSpecs();
  renderBulk();
});

