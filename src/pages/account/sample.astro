        <div class="f" style="margin-bottom:6px"><label>Extra charge ($)</label><input type="number" value="${r.extra||0}" min="0" step="0.01" oninput="corrHistory[${i}].extra=parseFloat(this.value)||0"></div>
      </div>
      <div class="f" style="margin-bottom:0"><label>Remarks</label><input value="${r.remarks}" placeholder="What was corrected..." oninput="corrHistory[${i}].remarks=this.value"></div>
    </div>`).join('');
}

// ── BULK ITEMS ──
let bItems = [
  {desc:'Cropped Trench Bomber', code:'6211.43.00', qty:500, rate:45},
