<script>
const LOGO = '/images/sdf-logo.jpg';
const CC = ['c1','c2','c3','c4','c5'];

const WALLETS = [
  {
    id: 'bkash',
    name: 'bKash',
    method: 'WorldRemit → Mobile Wallet (bKash)',
    fields: [
      {k:'Sending to', v:'Bangladesh'},
      {k:'Delivery method', v:'Mobile wallet (bKash)'},
      {k:'bKash wallet number', v:'+880 1711 160511'},
      {k:'Receiver first name', v:'MU Chowdhury'},
      {k:'Receiver last name', v:'Remon'},
      {k:'City', v:'Dhaka-1212'},
      {k:'Address', v:'House 125, Road 01, Baridhara DOSH'},
      {k:'Phone', v:'+880 1911 733226'},
    ]
  },
  {
    id: 'nagad',
    name: 'Nagad',
    method: 'WorldRemit → Mobile Wallet (Nagad)',
    fields: [
      {k:'Sending to', v:'Bangladesh'},
      {k:'Delivery method', v:'Mobile wallet (Nagad)'},
      {k:'Nagad wallet number', v:'[Your Nagad Number]'},
      {k:'Receiver name', v:'SDF Clothing'},
    ]
  },
  {
    id: 'rocket',
    name: 'Rocket',
    method: 'WorldRemit → Mobile Wallet (Rocket)',
    fields: [
      {k:'Sending to', v:'Bangladesh'},
      {k:'Delivery method', v:'Mobile wallet (Rocket)'},
      {k:'Rocket wallet number', v:'[Your Rocket Number]'},
      {k:'Receiver name', v:'SDF Clothing'},
    ]
  },
  {
    id: 'tt',
    name: 'TT / Wire',
    method: 'TT / Wire Transfer',
    fields: [
      {k:'Bank name', v:'[YOUR BANK NAME]'},
      {k:'Branch', v:'[BRANCH NAME]'},
      {k:'Account name', v:'SDF Clothing'},
      {k:'Account number', v:'[ACCOUNT NUMBER]'},
      {k:'SWIFT / BIC', v:'[SWIFT CODE]'},
      {k:'Routing number', v:'[ROUTING NUMBER]'},
    ]
  },
];

let selectedWallets = {sample: 'bkash', correction: 'bkash'};

function buildWalletUI(prefix, containerId, infoId) {
  const container = document.getElementById(containerId);
  const info = document.getElementById(infoId);
  const type = prefix === 's' ? 'sample' : 'correction';

  container.innerHTML = WALLETS.map(w => `
    <button class="wallet-btn${selectedWallets[type] === w.id ? ' active' : ''}"
      onclick="selectWallet('${prefix}','${w.id}','${containerId}','${infoId}')">${w.name}</button>
  `).join('');

  updateWalletInfo(type, info);
}

function selectWallet(prefix, id, containerId, infoId) {
  const type = prefix === 's' ? 'sample' : 'correction';
  selectedWallets[type] = id;
  buildWalletUI(prefix, containerId, infoId);
}

function updateWalletInfo(type, el) {
  const w = WALLETS.find(x => x.id === selectedWallets[type]);
  if (!w) return;
  el.innerHTML = w.fields.map(f => `<div><strong>${f.k}:</strong> ${f.v}</div>`).join('');
}

function getWalletPayHtml(type) {
  const w = WALLETS.find(x => x.id === selectedWallets[type]);
  if (!w) return '';
  const rows = w.fields.map(f => `<tr><td class="bl">${f.k}</td><td class="bv">${f.v}</td></tr>`).join('');
  return `<div class="ipinner"><div class="ipname">${w.method}</div><table class="ipdt">${rows}</table></div>`;
}

function addWD(ds, days) {
  const d = new Date(ds + 'T00:00:00');
  let a = 0;
  while (a < days) { d.setDate(d.getDate() + 1); const w = d.getDay(); if (w !== 5 && w !== 6) a++; }
  return d;
}

function fmtD(ds) {
  if (!ds) return '—';
  return new Date(ds + 'T00:00:00').toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'});
}

function autodue(dateId, dueId, days) {
  const dt = document.getElementById(dateId).value;
  if (!dt) return;
  const d = new Date(dt + 'T00:00:00');
  d.setDate(d.getDate() + days);
  document.getElementById(dueId).value = d.toISOString().split('T')[0];
}

function sAutodue() { autodue('s-date','s-due',3); }
function cAutodue() { autodue('c-date','c-due',3); }
function bAutodue() { autodue('b-date','b-due',7); }

function gv(id) { return document.getElementById(id)?.value || ''; }
function getTier(t) { return t > 5000 ? 'tt' : 'any'; }

function updateSNotice() {
  const sub = sItems.reduce((s, it) => s + (it.qty * it.rate), 0);
  const tier = getTier(sub);
  const nb = document.getElementById('s-notice');
  nb.className = 'notice ' + (tier === 'tt' ? 'n-tt' : 'n-any');
  nb.innerHTML = tier === 'tt'
    ? '<strong>TT required:</strong> Order above $5,000 — Wire Transfer only.'
    : 'Payment accepted via WorldRemit, bKash, Nagad, Rocket, or TT.';
}

function updateCNotice() {
  const rnd = parseInt(gv('c-round')) || 1;
  const extra = parseFloat(gv('c-extra')) || 0;
  const nb = document.getElementById('c-notice');
  nb.className = 'notice ' + (rnd === 1 ? 'n-any' : 'n-tt');
  nb.innerHTML = rnd === 1
    ? 'Round 1 is included — no extra charge applies.'
    : `<strong>Round ${rnd}:</strong> Extra charges may apply.${ extra > 0 ? ' Extra: $' + extra.toFixed(2) : ''}`;
}

function switchTab(t) {
  document.querySelectorAll('.tab').forEach((b,i) => b.classList.toggle('active', ['sample','correction','bulk'][i] === t));
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + t).classList.add('active');
  window.scrollTo(0, 0);
}

function backToForm(t) {
  document.getElementById(t[0] + '-form').style.display = '';
  document.getElementById(t[0] + '-pdf').classList.remove('visible');
  window.scrollTo(0, 0);
}

// ── SAMPLE ITEMS ──
let sItems = [
  {desc:'Cropped Trench Bomber', code:'F-2026-CTB01', qty:25, rate:45},
  {desc:'Safari Suture Jacket', code:'FRG-SAF-002', qty:25, rate:60}
];

function renderSItems() {
  document.getElementById('s-items-list').innerHTML = sItems.map((it, i) => `
    <div class="item-row">
      <button class="item-del" onclick="removeSItem(${i})">×</button>
      <div class="item-row-head">
        <input value="${it.desc}" placeholder="Item description" oninput="sItems[${i}].desc=this.value;renderSTotals()">
        <input class="item-code-input" value="${it.code}" placeholder="Item code" oninput="sItems[${i}].code=this.value">
      </div>
      <div class="item-nums">
        <div class="f" style="margin:0"><label>Qty</label><input type="number" value="${it.qty}" min="1" oninput="sItems[${i}].qty=parseFloat(this.value)||0;renderSTotals()" style="text-align:center"></div>
        <div class="f" style="margin:0"><label>Rate (USD)</label><input type="number" value="${it.rate}" min="0" step="0.01" oninput="sItems[${i}].rate=parseFloat(this.value)||0;renderSTotals()" style="text-align:right"></div>
      </div>
      <div class="item-total">$${(it.qty * it.rate).toFixed(2)}</div>
    </div>`).join('');
  renderSTotals();
}

function renderSTotals() {
  const sub = sItems.reduce((s, it) => s + (it.qty * it.rate), 0);
  const adv = sub * 0.30, bal = sub - adv;
  document.getElementById('s-totals').innerHTML = `
    <div class="total-row"><span class="tl">Subtotal</span><span>$${sub.toFixed(2)}</span></div>
    <div class="total-row adv"><span class="tl">30% Advance required</span><span class="tr">$${adv.toFixed(2)}</span></div>
    <div class="total-row"><span class="tl">Balance due (70%)</span><span>$${bal.toFixed(2)}</span></div>`;
  updateSNotice();
}

function addSItem() { sItems.push({desc:'',code:'',qty:1,rate:0}); renderSItems(); }
function removeSItem(i) { sItems.splice(i,1); renderSItems(); }

// ── CORRECTION ITEMS ──
let cItems = [{desc:'Cropped Trench Bomber', code:'F-2026-CTB01', qty:2, rate:45}];
let corrHistory = [];

function renderCItems() {
