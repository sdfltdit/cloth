function addSItem() { sItems.push({ desc: '', code: '', qty: 1, rate: 0 }); renderSItems(); }
function removeSItem(i) { sItems.splice(i, 1); renderSItems(); }

function calcS() {
  const sub = sItems.reduce((s, it) => s + it.qty * it.rate, 0);
  const adv = sub * 0.30, bal = sub - adv;
  document.getElementById('s-totals').innerHTML = `
    <div class="tot-row"><span class="tk">Subtotal</span><span>$${sub.toFixed(2)}</span></div>
    <div class="tot-row red-val"><span class="tk">30% Advance Required</span><span class="tv">$${adv.toFixed(2)}</span></div>
    <div class="tot-row"><span class="tk">Balance Due (70%)</span><span>$${bal.toFixed(2)}</span></div>`;
  const nb = document.getElementById('s-pay-notice');
  if (sub > 5000) {
    nb.className = 'notice n-red';
    nb.innerHTML = '<strong>TT / Wire Transfer Required:</strong> Orders exceeding USD 5,000 must be settled via Telegraphic Transfer (TT). Please select TT as the payment method below.';
  } else {
    nb.className = 'notice n-green';
    nb.innerHTML = 'Payment accepted via WorldRemit mobile wallets (bKash, Nagad, Rocket, Upay) or Telegraphic Transfer (TT).';
  }
}

