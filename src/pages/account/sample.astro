function generateCorr() {
  const pi = gv('c-pi'), orig = gv('c-orig'), dt = gv('c-date'), rnd = gv('c-round'), ad = gv('c-adv');
  const cn = gv('c-cn') || 'Client Name', cc = gv('c-cc'), cp = gv('c-cp'), ce = gv('c-ce');
  const remarks = gv('c-remarks'), extra = parseFloat(gv('c-extra')) || 0;
  const extraR = gv('c-extrareason') || 'Additional correction round fee';
  const rndNum = parseInt(rnd) || 1;
  const sub = cItems.reduce((s, it) => s + (it.qty * it.rate), 0) + extra;
  const delHtml = ad
    ? `<strong>Estimated delivery:</strong> Within <strong>14 working days</strong> from confirmation — on or before <strong>${addWD(ad,14).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</strong>. Fridays, Saturdays & public holidays excluded.`
    : `<strong>Delivery:</strong> Within 14 working days from correction confirmation. Fridays, Saturdays & public holidays not counted.`;
  const histRows = corrHistory.map(r => `
    <div class="icorr-row">
      <span class="icorr-rnd">${r.round}</span>
      <span style="color:var(--ink2);font-size:11px">${r.date ? fmtD(r.date) : '—'}</span>
      <span style="color:var(--ink2);font-size:10.5px">${r.remarks||'—'}</span>
      <span>${r.extra>0?'<span class="sbadge sb-due">+$'+r.extra.toFixed(2)+'</span>':'<span class="sbadge" style="background:#EAF3DE;color:var(--green)">Included</span>'}</span>
    </div>`).join('');
  const rows = cItems.map((it, i) => `
    <div class="irow">
      <div><div class="icode ${CC[i%5]}">${it.code||'—'}</div><div class="idname">${it.desc||'—'}</div></div>
      <span>${it.qty}</span><span>$${parseFloat(it.rate).toFixed(2)}</span><span>$${(it.qty*it.rate).toFixed(2)}</span>
    </div>`).join('');

  document.getElementById('c-inv').innerHTML = `
<div class="ih">
  <div class="ilw"><img src="${LOGO}" alt="SDF Clothing logo"><div><div class="icn">SDF Clothing</div><div class="ica">House 125, Road 01, Baridhara DOSH<br>Dhaka-1212, Bangladesh · +880 1711 160511</div></div></div>
  <div class="itb"><div class="ititle">INVOICE</div><div class="ipi">${pi}</div><span class="ibadge" style="background:#E6F1FB;color:var(--blue);border-color:#BDC8DC">CORRECTION — ROUND ${rndNum}</span></div>
</div>
<div class="ibar"></div>
<div class="imeta">
  <div><div class="iml">Bill To</div><div class="iclient">${cn}</div><div class="icinfo">${cc?'Country: '+cc+'<br>':''}${cp?cp+'<br>':''}${ce}</div></div>
  <div>
    <table class="idt">
      <tr><td class="dl">Date</td><td class="dv">${fmtD(dt)}</td></tr>
      <tr><td class="dl">Original PI ref</td><td class="dv">${orig||'—'}</td></tr>
      <tr><td class="dl">Correction round</td><td class="dv">Round ${rndNum}</td></tr>
      <tr><td class="dl">Total rounds to date</td><td class="dv">${corrHistory.length + 1}</td></tr>
    </table>
    <div class="ibal"><span class="ibl">${sub > 0 ? 'Amount Due' : 'No Charge'}</span><span class="iba">${sub > 0 ? '$'+sub.toFixed(2) : '$0.00'}</span></div>
  </div>
</div>
<div class="icorr-track">
  <div class="icorr-head">Correction History — All Rounds</div>
  ${histRows}
  <div class="icorr-row current">
    <span class="icorr-rnd">Round ${rndNum} ★</span>
    <span style="color:var(--ink2);font-size:11px">Current</span>
    <span style="color:var(--ink2);font-size:10.5px">${remarks||'Pending delivery'}</span>
    <span>${extra>0?'<span class="sbadge sb-due">+$'+extra.toFixed(2)+'</span>':'<span class="sbadge" style="background:#EAF3DE;color:var(--green)">Included</span>'}</span>
  </div>
</div>
<div class="iitems">
  <div class="iih"><span>Item & Description</span><span>Qty</span><span>Rate</span><span>Amount</span></div>
  ${rows}
</div>
${extra > 0 ? `<div class="ipay-stages"><div class="ips-head">Charges</div><div class="ips-row due"><span class="ips-label">${extraR}</span><span class="ips-pct"></span><span class="ips-amt">$${extra.toFixed(2)}<span class="sbadge sb-due">DUE</span></span></div></div>` : ''}
<div class="idel">${delHtml}</div>
<div class="ipayinfo">
  <div class="ipt">Payment Information</div>
  ${getWalletPayHtml('correction')}
