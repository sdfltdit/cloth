    `<div class="ips-row${stage===1?' due':''}"><span class="ips-label">Stage 1 — 30% Deposit (production start)</span><span class="ips-pct">30%</span><span class="ips-amt">$${s1.toFixed(2)}<span class="sbadge ${stage===1?'sb-due':stage>1?'" style="background:#EAF3DE;color:var(--green)"':'sb-upcoming'}">${stage===1?'DUE NOW':stage>1?'PAID':'—'}</span></span></div>`,
