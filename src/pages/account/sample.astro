  html += '<div class="ipay-stages"><div class="ips-head">Payment schedule</div>';
  html += '<div class="ips-row due"><span class="ips-label">30% Advance \u2014 due now to start production</span><span class="ips-pct">30%</span><span class="ips-amt">$' + adv.toFixed(2) + ' <span class="ips-badge b-due">DUE</span></span></div>';
  html += '<div class="ips-row"><span class="ips-label">70% Balance \u2014 due before shipment</span><span class="ips-pct">70%</span><span class="ips-amt">$' + bal.toFixed(2) + ' <span class="ips-badge b-upcoming">ON SHIPMENT</span></span></div>';
