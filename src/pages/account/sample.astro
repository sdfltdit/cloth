];

function addSItem() {
  sItems.push({desc:'', code:'', qty:1, rate:0});
  renderSItems();
  renderSample();
}

function removeSItem(i) {
  sItems.splice(i, 1);
  renderSItems();
  renderSample();
}

function updateSItem(i, f, v) {
  if (f === 'qty' || f === 'rate') { sItems[i][f] = parseFloat(v) || 0; }
  else { sItems[i][f] = v; }
  renderSample();
}

window.addSItem    = addSItem;
window.removeSItem = removeSItem;
window.updateSItem = updateSItem;

function renderSItems() {
  var html = '';
  for (var i = 0; i < sItems.length; i++) {
    var it = sItems[i];
    var amt = (it.qty * it.rate).toFixed(2);
