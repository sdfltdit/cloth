// src/pages/account/sample.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>SDF Clothing — Invoice Generator</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#C0272D;--red-dk:#8B1A1E;--red-lt:#fdf0f0;
  --ink:#1a1a1a;--ink2:#555;--muted:#888;
  --line:#e0ddd8;--bg:#f0ede7;--paper:#fffffe;--field:#f7f5f2;
  --green:#27500A;--blue:#0C447C;
  --radius:8px;--radius-sm:5px;
}

body{font-family:"DM Sans",sans-serif;background:var(--bg);color:var(--ink);font-size:14px;min-height:100vh}

/* ── TOP BAR ── */
.topbar{background:var(--ink);padding:0 20px;display:flex;align-items:center;justify-content:space-between;height:52px;position:sticky;top:0;z-index:200}
.topbar-brand{display:flex;align-items:center;gap:10px}
.topbar-brand img{width:32px;height:32px;object-fit:contain;border-radius:4px}
.topbar-brand-text{font-family:"EB Garamond",serif;font-size:16px;font-weight:600;color:#fff;line-height:1.2}
.topbar-brand-text span{display:block;font-family:"DM Sans",sans-serif;font-size:10px;font-weight:400;color:#aaa;letter-spacing:.08em;text-transform:uppercase}
.tab-group{display:flex;gap:0}
.tab{padding:0 16px;height:52px;font-size:12px;font-weight:500;letter-spacing:.04em;color:#aaa;cursor:pointer;border:none;border-bottom:3px solid transparent;background:none;font-family:"DM Sans",sans-serif;transition:all .15s;white-space:nowrap}
.tab.active{color:#fff;border-bottom-color:var(--red)}
.tab:hover:not(.active){color:#ddd}

/* ── PAGES ── */
.page{display:none;min-height:calc(100vh - 52px)}
.page.active{display:block}

/* ── FORM VIEW ── */
.form-view{max-width:680px;margin:0 auto;padding:24px 16px 40px}
.form-title{font-family:"EB Garamond",serif;font-size:22px;font-weight:600;color:var(--ink);margin-bottom:4px}
.form-sub{font-size:12px;color:var(--muted);margin-bottom:24px}

.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:16px}
.card-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--red-lt)}

.f{margin-bottom:12px}
.f label{display:block;font-size:11.5px;font-weight:500;color:var(--ink2);margin-bottom:4px}
.f input,.f select,.f textarea{width:100%;background:var(--field);border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;font-size:13px;font-family:"DM Sans",sans-serif;color:var(--ink);outline:none;transition:border-color .15s;-webkit-appearance:none;appearance:none}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--red);background:var(--paper)}
.f textarea{resize:vertical;min-height:72px;line-height:1.5}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.f3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* wallet card */
.wallet-selector{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:12px}
.wallet-btn{border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:10px 8px;font-size:12px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;text-align:center;background:var(--field);color:var(--ink2);transition:all .15s;line-height:1.3}
.wallet-btn.active{border-color:var(--red);background:var(--red-lt);color:var(--red-dk)}
.wallet-info{background:var(--field);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px 14px;font-size:12px;color:var(--ink2);line-height:1.8}
.wallet-info strong{color:var(--ink)}

/* items */
.items-list{margin-bottom:8px}
.item-row{background:var(--field);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px;margin-bottom:8px;position:relative}
.item-row-head{display:flex;gap:8px;margin-bottom:8px}
.item-row-head input{flex:1}
.item-code-input{width:140px!important;flex:none!important}
.item-nums{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.item-total{font-size:12px;font-weight:600;color:var(--red-dk);margin-top:6px;text-align:right}
.item-del{position:absolute;top:10px;right:10px;background:none;border:none;cursor:pointer;color:#ccc;font-size:18px;line-height:1;padding:2px;transition:color .15s}
.item-del:hover{color:var(--red)}
.add-item-btn{width:100%;background:none;border:1.5px dashed var(--line);border-radius:var(--radius-sm);color:var(--muted);font-size:12px;font-family:"DM Sans",sans-serif;cursor:pointer;padding:10px;transition:all .15s;margin-bottom:4px}
.add-item-btn:hover{border-color:var(--red);color:var(--red)}

/* totals preview in form */
.totals-preview{background:var(--field);border-radius:var(--radius-sm);padding:12px 14px}
.total-row{display:flex;justify-content:space-between;font-size:13px;padding:4px 0;border-bottom:1px solid var(--line)}
.total-row:last-child{border-bottom:none;font-weight:600;font-size:14px;padding-top:8px}
.total-row .tl{color:var(--muted)}
.total-row.adv .tr{color:var(--red-dk)}

/* notice */
.notice{border-radius:var(--radius-sm);padding:10px 12px;font-size:12px;line-height:1.6;margin-top:10px}
.n-any{background:#FFF3CD;border:.5px solid #ffc107;color:#856404}
.n-tt{background:#FEF3E2;border:.5px solid #F59E0B;color:#92400E}

/* generate button */
.gen-btn{width:100%;background:var(--red);color:#fff;border:none;border-radius:var(--radius);padding:14px;font-size:15px;font-family:"DM Sans",sans-serif;font-weight:600;cursor:pointer;margin-top:8px;letter-spacing:.02em;transition:background .15s}
.gen-btn:hover{background:var(--red-dk)}
.gen-btn:active{transform:scale(.99)}

/* ── PDF VIEW ── */
.pdf-view{display:none;min-height:calc(100vh - 52px);background:var(--bg)}
.pdf-view.visible{display:block}

.pdf-toolbar{background:var(--paper);border-bottom:1px solid var(--line);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:52px;z-index:100}
.pdf-toolbar-left{display:flex;align-items:center;gap:10px}
.back-btn{background:none;border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:8px 14px;font-size:12px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;color:var(--ink2);transition:all .15s;display:flex;align-items:center;gap:6px}
.back-btn:hover{border-color:var(--red);color:var(--red)}
.pdf-title{font-size:13px;font-weight:500;color:var(--ink)}
.print-btn{background:var(--red);color:#fff;border:none;border-radius:var(--radius-sm);padding:9px 20px;font-size:13px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;transition:background .15s;display:flex;align-items:center;gap:6px}
.print-btn:hover{background:var(--red-dk)}

.pdf-canvas{padding:24px 16px;display:flex;justify-content:center}

/* ── INVOICE PAPER ── */
.inv{width:100%;max-width:720px;background:var(--paper);box-shadow:0 4px 40px rgba(0,0,0,.10);padding:44px 48px;font-family:"DM Sans",sans-serif;font-size:12.5px;color:var(--ink)}

.ih{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:16px}
.ilw{display:flex;align-items:center;gap:12px}
.ilw img{width:70px;height:70px;object-fit:contain}
.icn{font-family:"EB Garamond",serif;font-size:19px;font-weight:600;line-height:1.2;margin-bottom:2px}
.ica{font-size:11px;color:var(--muted);line-height:1.7}
.itb{text-align:right;flex-shrink:0}
.ititle{font-family:"EB Garamond",serif;font-size:36px;font-weight:400;color:var(--red);line-height:1}
.ipi{font-size:11.5px;color:var(--muted);margin-top:3px}
.ibadge{display:inline-block;margin-top:7px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:500;letter-spacing:.06em;background:#FFF3CD;color:#856404;border:.5px solid #ffc107}

.ibar{height:2.5px;background:linear-gradient(90deg,var(--red),var(--red-dk));border-radius:2px;margin-bottom:20px}

.imeta{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.iml{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:5px}
.iclient{font-size:14px;font-weight:600;margin-bottom:2px}
.icinfo{font-size:11.5px;color:var(--ink2);line-height:1.75}

.idt{width:100%;font-size:11.5px;border-collapse:collapse}
.idt td{padding:3px 0;vertical-align:top}
.idt .dl{color:var(--muted);text-align:right;padding-right:10px;width:52%}
.idt .dv{font-weight:500}
.ibal{background:var(--red);color:#fff;border-radius:7px;padding:9px 12px;margin-top:9px;display:flex;justify-content:space-between;align-items:center}
.ibl{font-size:10px;font-weight:500;letter-spacing:.06em;text-transform:uppercase}
.iba{font-family:"EB Garamond",serif;font-size:20px;font-weight:600}

.iitems{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:16px}
.iih{display:grid;grid-template-columns:1fr 60px 74px 82px;background:var(--ink);color:#fff;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;gap:7px}
.iih span:not(:first-child){text-align:right}
.irow{display:grid;grid-template-columns:1fr 60px 74px 82px;padding:11px 13px;gap:7px;align-items:start;border-bottom:.5px solid var(--line)}
.irow:last-child{border-bottom:none}
.irow>span{text-align:right;font-size:12.5px;padding-top:2px}
.irow>span:last-child{font-weight:500}
.icode{display:inline-block;font-size:9.5px;font-weight:500;padding:2px 7px;border-radius:4px;letter-spacing:.04em;margin-bottom:3px}
.c1{background:#E1F5EE;color:#085041}.c2{background:var(--red-lt);color:var(--red-dk)}.c3{background:#E6F1FB;color:var(--blue)}.c4{background:#FAEEDA;color:#633806}.c5{background:#FBEAF0;color:#72243E}
.idname{font-weight:500;font-size:12.5px;margin-bottom:1px}

.ipay-stages{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:14px}
.ips-head{background:var(--ink);color:#fff;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.ips-row{display:grid;grid-template-columns:1fr auto auto;gap:12px;padding:9px 13px;border-bottom:.5px solid var(--line);font-size:12px;align-items:center}
.ips-row:last-child{border-bottom:none}
.ips-row.due{background:var(--red-lt)}
.ips-label{color:var(--ink2)}
.ips-pct{font-size:10px;color:var(--muted)}
.ips-amt{font-weight:600;text-align:right}
.ips-row.due .ips-amt{color:var(--red-dk)}
.sbadge{font-size:9px;padding:1px 7px;border-radius:10px;font-weight:500;margin-left:4px}
.sb-due{background:var(--red-lt);color:var(--red-dk)}
.sb-upcoming{background:#f5f5f5;color:var(--muted)}

.idel{border-left:3px solid var(--red);padding:8px 13px;background:#FBF8F8;border-radius:0 6px 6px 0;margin-bottom:13px;font-size:11.5px;color:var(--ink2);line-height:1.7}
.idel strong{color:var(--ink)}

.ipayinfo{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px}
.ipt{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:9px}
.ipinner{background:var(--field);border-radius:7px;padding:12px 14px;margin-bottom:9px}
.ipname{font-weight:500;font-size:12.5px;margin-bottom:7px}
.ipdt{width:100%;font-size:11.5px;border-collapse:collapse}
.ipdt td{padding:2.5px 0;vertical-align:top}
.ipdt .bl{color:var(--muted);width:44%}.ipdt .bv{font-weight:500}
.ipdiv{border:none;border-top:.5px solid var(--line);margin:5px 0}
.ipemails{font-size:11.5px;color:var(--ink2);line-height:1.8}
.ipemails strong{color:var(--ink)}
.ipnote{margin-top:9px;background:#FFF3CD;border-radius:5px;padding:8px 11px;font-size:10.5px;color:#856404;line-height:1.6;border:.5px solid #ffc107}

.iterms{margin-bottom:14px}
.iterm-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.iterms ol{padding-left:15px}
.iterms ol li{font-size:10.5px;color:var(--ink2);line-height:1.8;margin-bottom:1px}
.iterms ol li strong{color:var(--ink)}

.ifooter{border-top:.5px solid var(--line);padding-top:12px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px}
.ifl{font-size:10.5px;color:var(--muted);line-height:1.75}
.ifl strong{color:var(--ink)}
.ifr{font-size:10.5px;color:var(--muted);text-align:right;max-width:260px;line-height:1.6}

/* correction specific */
.icorr-track{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:13px}
.icorr-head{background:var(--ink);color:#fff;padding:8px 13px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.icorr-row{display:grid;grid-template-columns:64px 100px 1fr auto;gap:10px;padding:9px 13px;border-bottom:.5px solid var(--line);font-size:11.5px;align-items:center}
.icorr-row:last-child{border-bottom:none}
.icorr-row.current{background:var(--red-lt)}
.icorr-rnd{font-weight:600;color:var(--red-dk)}

/* bulk specific */
.iship{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px}
.iship-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.iship-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px}
.iship-item .sk{color:var(--muted);font-size:10.5px;margin-bottom:1px}
.iship-item .sv{font-weight:500;font-size:12px}
.imark{border:.5px solid var(--line);border-radius:7px;padding:13px 15px;margin-bottom:13px;background:var(--field)}
.imark-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.imark-box{border:1.5px solid var(--ink);border-radius:4px;padding:10px 14px;font-size:11px;line-height:2;font-family:monospace;color:var(--ink);display:inline-block;min-width:200px}
.idspec{font-size:10.5px;color:var(--muted);line-height:1.55}

/* ── RESPONSIVE ── */
@media(max-width:600px){
  .tab{padding:0 10px;font-size:11px}
  .topbar-brand-text span{display:none}
  .form-view{padding:16px 12px 40px}
  .inv{padding:28px 20px}
  .ih{flex-direction:column;gap:12px}
  .itb{text-align:left}
  .imeta{grid-template-columns:1fr}
  .iih{grid-template-columns:1fr 50px 64px 70px;font-size:9px}
  .irow{grid-template-columns:1fr 50px 64px 70px}
  .f2{grid-template-columns:1fr}
  .f3{grid-template-columns:1fr 1fr}
  .wallet-selector{grid-template-columns:repeat(2,1fr)}
  .pdf-toolbar{flex-wrap:wrap;gap:8px}
  .icorr-row{grid-template-columns:50px 80px 1fr auto;font-size:10.5px}
  .ips-row{grid-template-columns:1fr auto;gap:6px}
  .ips-pct{display:none}
  .iship-grid{grid-template-columns:1fr}
}

@media print{
  .topbar,.pdf-toolbar{display:none}
  .pdf-view{display:block!important}
  .pdf-canvas{padding:0}
  .inv{box-shadow:none;max-width:100%;padding:28px 32px}
  @page{margin:0;size:A4}
}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand">
    <img src="/images/sdf-logo.jpg" alt="SDF Clothing">
    <div class="topbar-brand-text">SDF Clothing<span>Invoice Generator</span></div>
  </div>
  <div class="tab-group">
    <button class="tab active" onclick="switchTab('sample')">Sample</button>
    <button class="tab" onclick="switchTab('correction')">Correction</button>
    <button class="tab" onclick="switchTab('bulk')">Bulk</button>
  </div>
</div>

<!-- ═══════════════ SAMPLE ═══════════════ -->
<div class="page active" id="page-sample">
  <div class="form-view" id="s-form">
    <div class="form-title">Sample Invoice</div>
    <div class="form-sub">Fill in the details below, then click Generate Invoice</div>

    <div class="card">
      <div class="card-title">Invoice Details</div>
      <div class="f2">
        <div class="f"><label>PI Number</label><input id="s-pi" value="SDF001/06/KW" oninput="updateSNotice()"></div>
        <div class="f"><label>PO Number</label><input id="s-po" placeholder="Buyer ref"></div>
      </div>
      <div class="f2">
        <div class="f"><label>Invoice Date</label><input type="date" id="s-date" oninput="sAutodue()"></div>
        <div class="f"><label>Due Date</label><input type="date" id="s-due"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Client</div>
      <div class="f"><label>Full Name / Company</label><input id="s-cn" placeholder="Dr. Maram Alibrahim"></div>
      <div class="f"><label>Address</label><textarea id="s-ca" placeholder="Block 12, Street 8, House 69, Salwa R/A"></textarea></div>
      <div class="f2">
        <div class="f"><label>Country</label><input id="s-cc" placeholder="Kuwait"></div>
        <div class="f"><label>Phone</label><input id="s-cp" placeholder="+965 55626666"></div>
      </div>
      <div class="f"><label>Email</label><input type="email" id="s-ce" placeholder="client@email.com"></div>
    </div>

    <div class="card">
      <div class="card-title">Advance Payment Date</div>
      <div class="f"><label>Date Advance Received (auto-calculates delivery deadline)</label><input type="date" id="s-adv"></div>
    </div>

    <div class="card">
      <div class="card-title">Payment Method</div>
      <div class="wallet-selector" id="s-wallets"></div>
      <div class="wallet-info" id="s-wallet-info"></div>
      <div id="s-notice" class="notice n-any" style="margin-top:10px"></div>
    </div>

    <div class="card">
      <div class="card-title">Line Items</div>
      <div class="items-list" id="s-items-list"></div>
      <button class="add-item-btn" onclick="addSItem()">+ Add Line Item</button>
      <div class="totals-preview" id="s-totals"></div>
    </div>

    <button class="gen-btn" onclick="generateSample()">Generate Invoice →</button>
  </div>

  <div class="pdf-view" id="s-pdf">
    <div class="pdf-toolbar">
      <div class="pdf-toolbar-left">
        <button class="back-btn" onclick="backToForm('sample')">← Edit</button>
        <span class="pdf-title" id="s-pdf-title">Sample Invoice</span>
      </div>
      <button class="print-btn" onclick="window.print()">⬇ Download PDF</button>
    </div>
    <div class="pdf-canvas"><div class="inv" id="s-inv"></div></div>
  </div>
</div>

<!-- ═══════════════ CORRECTION ═══════════════ -->
<div class="page" id="page-correction">
  <div class="form-view" id="c-form">
    <div class="form-title">Correction Sample Invoice</div>
    <div class="form-sub">Record correction round details, then generate invoice</div>

    <div class="card">
      <div class="card-title">Invoice Details</div>
      <div class="f2">
        <div class="f"><label>PI Number</label><input id="c-pi" value="SDF001/06/KW-C1" oninput="updateCNotice()"></div>
        <div class="f"><label>Original PI Ref</label><input id="c-orig" placeholder="SDF001/06/KW"></div>
      </div>
      <div class="f2">
        <div class="f"><label>Invoice Date</label><input type="date" id="c-date" oninput="cAutodue()"></div>
        <div class="f"><label>Correction Round</label>
          <select id="c-round" onchange="updateCNotice()">
            <option value="1">Round 1 (Included)</option>
            <option value="2">Round 2</option>
            <option value="3">Round 3</option>
            <option value="4">Round 4+</option>
          </select>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Client</div>
      <div class="f"><label>Full Name / Company</label><input id="c-cn" placeholder="Dr. Maram Alibrahim"></div>
      <div class="f2">
        <div class="f"><label>Country</label><input id="c-cc" placeholder="Kuwait"></div>
        <div class="f"><label>Phone</label><input id="c-cp" placeholder="+965 55626666"></div>
      </div>
      <div class="f"><label>Email</label><input type="email" id="c-ce" placeholder="client@email.com"></div>
    </div>

    <div class="card">
      <div class="card-title">Correction History (Previous Rounds)</div>
      <div id="c-hist-wrap"></div>
      <button class="add-item-btn" onclick="addCorrRound()">+ Add Previous Round</button>
    </div>

    <div class="card">
      <div class="card-title">This Correction — Items</div>
      <div class="items-list" id="c-items-list"></div>
      <button class="add-item-btn" onclick="addCItem()">+ Add Item</button>
    </div>

    <div class="card">
      <div class="card-title">Correction Remarks</div>
      <div class="f"><label>What needs to be corrected</label><textarea id="c-remarks" placeholder="e.g. Collar width reduced by 2cm, sleeve length adjusted..." rows="3"></textarea></div>
      <div class="f2">
