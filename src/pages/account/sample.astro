  <div class="ifr">Electronically generated invoice. No physical signature required. PI <strong>${pi}</strong> is the unique order reference for all communications and payment confirmations.</div>
</div>`;

  document.getElementById('b-pdf-title').textContent = `Invoice ${pi}`;
  document.getElementById('b-form').style.display = 'none';
  document.getElementById('b-pdf').classList.add('visible');
  window.scrollTo(0, 0);
}

document.addEventListener('DOMContentLoaded', () => {
  const today = new Date().toISOString().split('T')[0];
  ['s-date','c-date','b-date'].forEach(id => { const el = document.getElementById(id); if (el) el.value = today; });

  // auto due dates on load
  sAutodue(); bAutodue();
  const cDueEl = document.getElementById('c-due');
  if (cDueEl) { const d = new Date(); d.setDate(d.getDate()+3); cDueEl.value = d.toISOString().split('T')[0]; }

  buildWalletUI('s', 's-wallets', 's-wallet-info');
  buildWalletUI('c', 'c-wallets', 'c-wallet-info');
  renderSItems();
  updateSNotice();
  renderCItems();
  updateCNotice();
  renderBItems();
  renderBSpecs();
});
</script>
