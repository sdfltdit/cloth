      </div>
      <span>${it.qty} pcs</span><span>$${parseFloat(it.rate).toFixed(2)}</span><span>$${(it.qty*it.rate).toFixed(2)}</span>
    </div>`).join('');

  document.getElementById('b-inv').innerHTML = `
<div class="ih">
  <div class="ilw"><img src="${LOGO}" alt="SDF Clothing logo"><div><div class="icn">SDF Clothing</div><div class="ica">House 125, Road 01, Baridhara DOSH<br>Dhaka-1212, Bangladesh · +880 1711 160511<br>ERC: ${erc}</div></div></div>
