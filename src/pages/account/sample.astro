      <tr><td class="dl">Port of discharge</td><td class="dv">${pod}</td></tr>
      <tr><td class="dl">Shipment mode</td><td class="dv">${mode}</td></tr>
      <tr><td class="dl">Est. shipment date</td><td class="dv">${fmtD(shipDate)}</td></tr>
      <tr><td class="dl">Country of origin</td><td class="dv">Made in Bangladesh</td></tr>
      <tr><td class="dl">Currency</td><td class="dv">USD — fixed at invoice date</td></tr>
    </table>
    <div class="ibal"><span class="ibl">Due Now (Stage ${stage})</span><span class="iba">$${stageDue[stage].toFixed(2)}</span></div>
