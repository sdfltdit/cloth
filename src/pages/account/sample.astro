  html += '<div class="iclient">' + escHtml(cn) + '</div>';
  html += '<div class="icinfo">' + caHtml + (cc ? 'Country: ' + escHtml(cc) + '<br>' : '') + (cp ? escHtml(cp) + '<br>' : '') + escHtml(ce) + '</div></div>';
  html += '<div><table class="idt">';
  html += '<tr><td class="dl">Date</td><td class="dv">' + fmtD(dt) + '</td></tr>';
  html += '<tr><td class="dl">PO Number</td><td class="dv">' + escHtml(po || '\u2014') + '</td></tr>';
  html += '<tr><td class="dl">Due date</td><td class="dv">' + fmtD(dd) + '</td></tr>';
