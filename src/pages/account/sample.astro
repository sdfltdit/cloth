    html += '<td class="cd"><input value="' + escHtml(it.desc) + '" placeholder="Item description" oninput="updateSItem(' + i + ',\'desc\',this.value)"></td>';
    html += '<td class="cc"><input value="' + escHtml(it.code) + '" placeholder="Code" oninput="updateSItem(' + i + ',\'code\',this.value)"></td>';
    html += '<td class="cq"><input type="number" value="' + it.qty + '" min="1" oninput="updateSItem(' + i + ',\'qty\',this.value)" style="text-align:center"></td>';
    html += '<td class="cr"><input type="number" value="' + it.rate + '" min="0" step="0.01" oninput="updateSItem(' + i + ',\'rate\',this.value)" style="text-align:right"></td>';
    html += '<td class="ca">$' + amt + '</td>';
    html += '<td class="cx"><button class="del-btn" onclick="removeSItem(' + i + ')">\xd7</button></td>';
    html += '</tr>';
  }
  document.getElementById('s-items').innerHTML = html;
}

function renderSample() {
