        <div class="f" style="margin:0"><label>Rate (USD)</label><input type="number" value="${it.rate}" min="0" step="0.01" oninput="sItems[${i}].rate=parseFloat(this.value)||0;calcS()" style="text-align:right"></div>
      </div>
      <div class="item-amt">$${(it.qty * it.rate).toFixed(2)}</div>
