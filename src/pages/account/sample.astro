  const pol = gv('b-pol') || 'Chittagong, Bangladesh', pod = gv('b-pod') || '—';
  const inco = gv('b-inco') || 'FOB Chittagong', mode = gv('b-mode') || 'Sea Freight';
  const shipDate = gv('b-ship'), erc = gv('b-erc') || '[ERC NUMBER]';
  const mark1 = gv('b-mark1') || 'SDF / [BUYER NAME]', mark2 = gv('b-mark2') || '[DESTINATION]';
