var bItems = [
  {desc:'Cropped Trench Bomber', code:'6211.43.00', qty:500, rate:45},
  {desc:'Safari Suture Jacket',  code:'6201.93.00', qty:500, rate:60}
];
var bSpecs = [
  {name:'Cropped Trench Bomber', color:'Pantone 4975 C', fabric:'65% Polyester 35% Cotton', gsm:'280', yarn:'Ring spun',     label:'Woven label',    accessories:'YKK zipper, Matte black buttons'},
  {name:'Safari Suture Jacket',  color:'Pantone 7502 C', fabric:'100% Cotton ripstop',       gsm:'220', yarn:'Combed cotton', label:'Heat transfer', accessories:'Metal D-ring, Horn buttons'}
];

function addBItem() {
  bItems.push({desc:'', code:'', qty:1, rate:0});
  bSpecs.push({name:'', color:'', fabric:'', gsm:'', yarn:'', label:'', accessories:''});
  renderBItems();
  renderBSpecs();
  renderBulk();
}

function removeBItem(i) {
  bItems.splice(i, 1);
  bSpecs.splice(i, 1);
  renderBItems();
  renderBSpecs();
  renderBulk();
}

function updateBItem(i, f, v) {
  if (f === 'qty' || f === 'rate') { bItems[i][f] = parseFloat(v) || 0; }
  else { bItems[i][f] = v; }
  if (f === 'desc') { bSpecs[i].name = v; }
  renderBulk();
}

function updateBSpec(i, f, v) {
  bSpecs[i][f] = v;
  renderBulk();
}

window.addBItem    = addBItem;
window.removeBItem = removeBItem;
window.updateBItem = updateBItem;
window.updateBSpec = updateBSpec;

function renderBItems() {
  var html = '';
  for (var i = 0; i < bItems.length; i++) {
    var it = bItems[i];
    var amt = (it.qty * it.rate).toFixed(2);
    html += '<tr>';
    html += '<td class="cd"><input value="' + escHtml(it.desc) + '" placeholder="Product name" oninput="updateBItem(' + i + ',\'desc\',this.value)"></td>';
    html += '<td class="cc"><input value="' + escHtml(it.code) + '" placeholder="HS Code" oninput="updateBItem(' + i + ',\'code\',this.value)"></td>';
    html += '<td class="cq"><input type="number" value="' + it.qty + '" min="1" oninput="updateBItem(' + i + ',\'qty\',this.value)" style="text-align:center"></td>';
    html += '<td class="cr"><input type="number" value="' + it.rate + '" min="0" step="0.01" oninput="updateBItem(' + i + ',\'rate\',this.value)" style="text-align:right"></td>';
    html += '<td class="ca">$' + amt + '</td>';
    html += '<td class="cx"><button class="del-btn" onclick="removeBItem(' + i + ')">\xd7</button></td>';
    html += '</tr>';
  }
  document.getElementById('b-items').innerHTML = html;
}

function renderBSpecs() {
  var html = '';
  for (var i = 0; i < bSpecs.length; i++) {
    var sp = bSpecs[i];
    html += '<div style="background:var(--field);border:1px solid var(--line);border-radius:6px;padding:9px 11px;margin-bottom:7px">';
    html += '<div style="font-size:10px;font-weight:600;color:var(--red-dk);letter-spacing:.05em;margin-bottom:7px">ITEM ' + (i + 1) + ': ' + escHtml(sp.name || '\u2014') + '</div>';
    html += '<div class="f2" style="gap:5px">';
    html += '<div class="f" style="margin-bottom:5px"><label>Color code (Pantone)</label><input value="' + escHtml(sp.color) + '" placeholder="Pantone 4975 C" oninput="updateBSpec(' + i + ',\'color\',this.value)"></div>';
    html += '<div class="f" style="margin-bottom:5px"><label>Fabric type &amp; composition</label><input value="' + escHtml(sp.fabric) + '" placeholder="65% Polyester 35% Cotton" oninput="updateBSpec(' + i + ',\'fabric\',this.value)"></div>';
    html += '</div>';
    html += '<div class="f3" style="gap:5px">';
    html += '<div class="f" style="margin-bottom:5px"><label>GSM</label><input value="' + escHtml(sp.gsm) + '" placeholder="280" oninput="updateBSpec(' + i + ',\'gsm\',this.value)"></div>';
    html += '<div class="f" style="margin-bottom:5px"><label>Yarn type</label><input value="' + escHtml(sp.yarn) + '" placeholder="Ring spun" oninput="updateBSpec(' + i + ',\'yarn\',this.value)"></div>';
    html += '<div class="f" style="margin-bottom:5px"><label>Label type</label><input value="' + escHtml(sp.label) + '" placeholder="Woven label" oninput="updateBSpec(' + i + ',\'label\',this.value)"></div>';
    html += '</div>';
    html += '<div class="f" style="margin-bottom:0"><label>Accessories</label><input value="' + escHtml(sp.accessories) + '" placeholder="YKK zipper, buttons..." oninput="updateBSpec(' + i + ',\'accessories\',this.value)"></div>';
    html += '</div>';
  }
  document.getElementById('b-specs-wrap').innerHTML = html;
}

function renderBulk() {
