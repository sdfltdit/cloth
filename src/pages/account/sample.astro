  } else {
    payHtml = '<div class="ipinner"><div class="ipname">WorldRemit \u2014 Mobile Wallet (bKash)</div><table class="ipdt"><tr><td class="bl">Sending to</td><td class="bv">Bangladesh</td></tr><tr><td class="bl">Delivery method</td><td class="bv">Mobile wallet (bKash)</td></tr><tr><td class="bl">bKash wallet number</td><td class="bv">+880 1711 160511</td></tr><tr><td colspan="2"><hr class="ipdiv"></td></tr><tr><td class="bl">Receiver first name</td><td class="bv">MU Chowdhury</td></tr><tr><td class="bl">Receiver last name</td><td class="bv">Remon</td></tr><tr><td class="bl">City</td><td class="bv">Dhaka-1212</td></tr><tr><td class="bl">Address</td><td class="bv">House 125, Road 01, Baridhara DOSH</td></tr><tr><td class="bl">Phone</td><td class="bv">+880 1911 733226</td></tr></table></div>';
  }

