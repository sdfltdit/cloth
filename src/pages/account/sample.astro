// ── GENERATE FUNCTIONS ──

function generateSample() {
  const pi = gv('s-pi'), po = gv('s-po'), dt = gv('s-date'), dd = gv('s-due'), ad = gv('s-adv');
  const cn = gv('s-cn') || 'Client Name', ca = gv('s-ca'), cc = gv('s-cc'), cp = gv('s-cp'), ce = gv('s-ce');
  const sub = sItems.reduce((s, it) => s + (it.qty * it.rate), 0);
  const adv = sub * 0.30, bal = sub - adv;
  const tier = getTier(sub);
  const delHtml = ad
    ? `<strong>Estimated delivery:</strong> Within <strong>14 working days</strong> from advance payment — on or before <strong>${addWD(ad,14).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</strong>. Fridays, Saturdays & public holidays excluded.`
    : `<strong>Delivery:</strong> Within <strong>14 working days</strong> from confirmed advance payment. Fridays, Saturdays & public holidays not counted.`;
  const payHtml = tier === 'tt'
    ? `<div class="ipinner"><div class="ipname">TT / Wire Transfer</div><div style="font-size:11.5px;color:var(--ink2);line-height:1.7">Required for orders above $5,000. Contact <strong>account@sdfltd.com</strong> for bank details.</div></div>`
    : getWalletPayHtml('sample');
  const rows = sItems.map((it, i) => `
    <div class="irow">
      <div><div class="icode ${CC[i%5]}">${it.code||'—'}</div><div class="idname">${it.desc||'—'}</div></div>
      <span>${it.qty}</span><span>$${parseFloat(it.rate).toFixed(2)}</span><span>$${(it.qty*it.rate).toFixed(2)}</span>
    </div>`).join('');
  const pt = tier === 'tt'
    ? '30% advance before production; 70% before shipment. Orders above $5,000 require TT/Wire Transfer.'
    : '30% advance required before production. Remaining 70% due before shipment. Accepted: WorldRemit wallets or TT.';

  document.getElementById('s-inv').innerHTML = `
<div class="ih">
  <div class="ilw"><img src="${LOGO}" alt="SDF Clothing logo"><div><div class="icn">SDF Clothing</div><div class="ica">House 125, Road 01, Baridhara DOSH<br>Dhaka-1212, Bangladesh · +880 1711 160511</div></div></div>
  <div class="itb"><div class="ititle">INVOICE</div><div class="ipi">${pi}</div><span class="ibadge">PAYMENT PENDING</span></div>
</div>
<div class="ibar"></div>
<div class="imeta">
  <div><div class="iml">Bill To</div><div class="iclient">${cn}</div><div class="icinfo">${ca?ca.replace(/\n/g,'<br>')+'<br>':''}${cc?'Country: '+cc+'<br>':''}${cp?cp+'<br>':''}${ce}</div></div>
  <div>
    <table class="idt">
      <tr><td class="dl">Date</td><td class="dv">${fmtD(dt)}</td></tr>
      <tr><td class="dl">PO Number</td><td class="dv">${po||'—'}</td></tr>
      <tr><td class="dl">Due Date</td><td class="dv">${fmtD(dd)}</td></tr>
      <tr><td class="dl">Incoterm</td><td class="dv">FOB Dhaka</td></tr>
