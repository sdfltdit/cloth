    <div class="item-row">
      <button class="item-del" onclick="removeCItem(${i})">×</button>
      <div class="item-row-head">
        <input value="${it.desc}" placeholder="Item description" oninput="cItems[${i}].desc=this.value">
        <input class="item-code-input" value="${it.code}" placeholder="Item code" oninput="cItems[${i}].code=this.value">
      </div>
      <div class="item-nums">
        <div class="f" style="margin:0"><label>Qty</label><input type="number" value="${it.qty}" min="1" oninput="cItems[${i}].qty=parseFloat(this.value)||0" style="text-align:center"></div>
        <div class="f" style="margin:0"><label>Rate (USD)</label><input type="number" value="${it.rate}" min="0" step="0.01" oninput="cItems[${i}].rate=parseFloat(this.value)||0" style="text-align:right"></div>
      </div>
      <div class="item-total">$${(it.qty * it.rate).toFixed(2)}</div>
    </div>`).join('');
}

function addCItem() { cItems.push({desc:'',code:'',qty:1,rate:0}); renderCItems(); }
function removeCItem(i) { cItems.splice(i,1); renderCItems(); }

function addCorrRound() {
  corrHistory.push({round:'Round '+(corrHistory.length+1), date:'', remarks:'', extra:0});
  renderCorrHist();
}

function renderCorrHist() {
  document.getElementById('c-hist-wrap').innerHTML = corrHistory.map((r, i) => `
