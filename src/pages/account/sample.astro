<script>
(function() {

var LOGO = '/images/sdf-logo.jpg';
var CC = ['c1','c2','c3','c4','c5'];

function addWorkingDays(dateStr, days) {
  var d = new Date(dateStr + 'T00:00:00');
  var added = 0;
  while (added < days) {
    d.setDate(d.getDate() + 1);
    var w = d.getDay();
    if (w !== 5 && w !== 6) { added++; }
  }
  return d;
}

function fmtD(dateStr) {
  if (!dateStr) { return '\u2014'; }
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {month:'long',day:'numeric',year:'numeric'});
}

function getTier(total) {
  return total > 5000 ? 'tt' : 'any';
}

function gv(id) {
  var el = document.getElementById(id);
  return el ? el.value : '';
}

function escHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function addrToHtml(str) {
  return escHtml(str).replace(/\n/g, '<br>');
}

function switchTab(t) {
  var tabs = document.querySelectorAll('.tab');
  var names = ['sample','correction','bulk'];
  for (var i = 0; i < tabs.length; i++) {
    if (names[i] === t) { tabs[i].classList.add('active'); }
    else { tabs[i].classList.remove('active'); }
  }
  var pages = document.querySelectorAll('.page');
  for (var j = 0; j < pages.length; j++) {
    pages[j].classList.remove('active');
  }
  document.getElementById('page-' + t).classList.add('active');
}

/* ─── SAMPLE TAB ─── */

var sItems = [
  {desc:'Cropped Trench Bomber', code:'F-2026-CTB01', qty:25, rate:45},
