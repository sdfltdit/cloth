// src/pages/account/sample.astro
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>SDF Clothing — Invoice Generator</title>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#C0272D;--red-dk:#8B1A1E;--red-lt:#fdf0f0;
  --ink:#1a1a1a;--ink2:#555;--muted:#888;
  --line:#e0ddd8;--bg:#f0ede7;--paper:#fffffe;--field:#f7f5f2;
  --green:#27500A;--blue:#0C447C;
  --radius:8px;--radius-sm:5px;
}
body{font-family:"DM Sans",sans-serif;background:var(--bg);color:var(--ink);font-size:14px;min-height:100vh}

/* TOPBAR */
.topbar{background:var(--ink);padding:0 20px;display:flex;align-items:center;justify-content:space-between;height:52px;position:sticky;top:0;z-index:200}
.topbar-brand{display:flex;align-items:center;gap:10px}
.topbar-brand img{width:32px;height:32px;object-fit:contain;border-radius:4px}
.topbar-brand-text{font-family:"EB Garamond",serif;font-size:16px;font-weight:600;color:#fff}
.topbar-brand-text span{display:block;font-family:"DM Sans",sans-serif;font-size:10px;font-weight:400;color:#aaa;letter-spacing:.08em;text-transform:uppercase}
.tab-group{display:flex}
.tab{padding:0 16px;height:52px;font-size:12px;font-weight:500;letter-spacing:.04em;color:#aaa;cursor:pointer;border:none;border-bottom:3px solid transparent;background:none;font-family:"DM Sans",sans-serif;transition:all .15s;white-space:nowrap}
.tab.active{color:#fff;border-bottom-color:var(--red)}
.tab:hover:not(.active){color:#ddd}

/* PAGES */
.page{display:none;min-height:calc(100vh - 52px)}
.page.active{display:block}

/* FORM VIEW */
.form-view{max-width:700px;margin:0 auto;padding:24px 16px 48px}
.form-title{font-family:"EB Garamond",serif;font-size:22px;font-weight:600;color:var(--ink);margin-bottom:4px}
.form-sub{font-size:12px;color:var(--muted);margin-bottom:24px}

.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:14px}
.card-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--red-lt)}

.f{margin-bottom:12px}
.f:last-child{margin-bottom:0}
.f label{display:block;font-size:11.5px;font-weight:500;color:var(--ink2);margin-bottom:4px}
.f input,.f select,.f textarea{width:100%;background:var(--field);border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;font-size:13px;font-family:"DM Sans",sans-serif;color:var(--ink);outline:none;transition:border-color .15s;-webkit-appearance:none;appearance:none}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--red);background:var(--paper)}
.f textarea{resize:vertical;min-height:72px;line-height:1.5}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.f3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}

/* PAYMENT METHOD */
.pay-method-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:14px}
.pmt-btn{border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:9px 6px;font-size:12px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;text-align:center;background:var(--field);color:var(--ink2);transition:all .15s;line-height:1.3}
.pmt-btn.active{border-color:var(--red);background:var(--red-lt);color:var(--red-dk)}
.pay-fields{display:none}
.pay-fields.visible{display:block}
.pay-info-box{background:var(--field);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px 14px;font-size:12px;color:var(--ink2);line-height:1.9}
.pay-info-box strong{color:var(--ink)}
.pay-info-box .pib-row{display:flex;gap:8px}
.pay-info-box .pib-k{color:var(--muted);min-width:150px;flex-shrink:0}

/* NOTICE */
.notice{border-radius:var(--radius-sm);padding:10px 12px;font-size:12px;line-height:1.6;margin-top:10px}
.n-green{background:#EAF3DE;border:.5px solid #9DC888;color:var(--green)}
.n-amber{background:#FFF3CD;border:.5px solid #ffc107;color:#856404}
.n-red{background:var(--red-lt);border:.5px solid #f0c0c0;color:var(--red-dk)}

/* ITEMS */
.items-list{margin-bottom:8px}
.item-row{background:var(--field);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px;margin-bottom:8px;position:relative}
.item-row-top{display:flex;gap:8px;margin-bottom:8px}
.item-row-top input:first-child{flex:1}
.item-code{width:130px;flex-shrink:0}
.item-nums{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.item-amt{font-size:12px;font-weight:600;color:var(--red-dk);margin-top:6px;text-align:right}
.item-del{position:absolute;top:10px;right:10px;background:none;border:none;cursor:pointer;color:#ccc;font-size:18px;line-height:1;padding:2px;transition:color .15s}
.item-del:hover{color:var(--red)}
.add-row-btn{width:100%;background:none;border:1.5px dashed var(--line);border-radius:var(--radius-sm);color:var(--muted);font-size:12px;font-family:"DM Sans",sans-serif;cursor:pointer;padding:10px;transition:all .15s;margin-bottom:8px}
.add-row-btn:hover{border-color:var(--red);color:var(--red)}

/* TOTALS PREVIEW */
.totals-box{background:var(--field);border-radius:var(--radius-sm);padding:12px 14px}
.tot-row{display:flex;justify-content:space-between;font-size:13px;padding:4px 0;border-bottom:1px solid var(--line)}
.tot-row:last-child{border-bottom:none;font-weight:600;font-size:14px;padding-top:8px}
.tot-row .tk{color:var(--muted)}
.tot-row.red-val .tv{color:var(--red-dk);font-weight:600}
.tot-row.green-val .tv{color:var(--green);font-weight:600}

/* GENERATE BUTTON */
.gen-btn{width:100%;background:var(--red);color:#fff;border:none;border-radius:var(--radius);padding:14px;font-size:15px;font-family:"DM Sans",sans-serif;font-weight:600;cursor:pointer;margin-top:8px;letter-spacing:.02em;transition:background .15s}
.gen-btn:hover{background:var(--red-dk)}
.gen-btn:active{transform:scale(.99)}

/* PDF VIEW */
.pdf-view{display:none;min-height:calc(100vh - 52px)}
.pdf-view.show{display:block}
.pdf-toolbar{background:var(--paper);border-bottom:1px solid var(--line);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:52px;z-index:100}
.pdf-toolbar-l{display:flex;align-items:center;gap:10px}
.back-btn{background:none;border:1.5px solid var(--line);border-radius:var(--radius-sm);padding:8px 14px;font-size:12px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;color:var(--ink2);transition:all .15s}
.back-btn:hover{border-color:var(--red);color:var(--red)}
.pdf-label{font-size:13px;font-weight:500;color:var(--ink)}
.print-btn{background:var(--red);color:#fff;border:none;border-radius:var(--radius-sm);padding:9px 20px;font-size:13px;font-weight:500;font-family:"DM Sans",sans-serif;cursor:pointer;transition:background .15s}
.print-btn:hover{background:var(--red-dk)}
.pdf-wrap{padding:24px 16px;display:flex;justify-content:center}

/* INVOICE */
.inv{width:100%;max-width:740px;background:var(--paper);box-shadow:0 4px 40px rgba(0,0,0,.10);padding:46px 52px;font-family:"DM Sans",sans-serif;font-size:12.5px;color:var(--ink)}
.inv-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:16px}
.inv-logo-wrap{display:flex;align-items:center;gap:12px}
.inv-logo-wrap img{width:72px;height:72px;object-fit:contain}
.inv-co-name{font-family:"EB Garamond",serif;font-size:19px;font-weight:600;line-height:1.2;margin-bottom:2px}
.inv-co-addr{font-size:11px;color:var(--muted);line-height:1.75}
.inv-title-block{text-align:right;flex-shrink:0}
.inv-title{font-family:"EB Garamond",serif;font-size:36px;font-weight:400;color:var(--red);line-height:1}
.inv-pi{font-size:11.5px;color:var(--muted);margin-top:3px}
.inv-badge{display:inline-block;margin-top:7px;padding:3px 11px;border-radius:20px;font-size:10px;font-weight:600;letter-spacing:.06em}
.badge-pending{background:#FFF3CD;color:#856404;border:.5px solid #ffc107}
.badge-corr{background:#E6F1FB;color:var(--blue);border:.5px solid #BDC8DC}
.badge-bulk{background:#EAF3DE;color:var(--green);border:.5px solid #9DC888}
.inv-bar{height:2.5px;background:linear-gradient(90deg,var(--red),var(--red-dk));border-radius:2px;margin-bottom:20px}
.inv-meta{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.inv-meta-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:5px}
.inv-client-name{font-size:14px;font-weight:600;margin-bottom:2px}
.inv-client-info{font-size:11.5px;color:var(--ink2);line-height:1.75}
.inv-dt{width:100%;font-size:11.5px;border-collapse:collapse}
.inv-dt td{padding:3px 0;vertical-align:top}
.inv-dt .dl{color:var(--muted);text-align:right;padding-right:10px;width:52%}
.inv-dt .dv{font-weight:500}
.inv-balance-box{background:var(--red);color:#fff;border-radius:7px;padding:10px 13px;margin-top:10px;display:flex;justify-content:space-between;align-items:center}
.inv-bal-label{font-size:10px;font-weight:500;letter-spacing:.06em;text-transform:uppercase}
.inv-bal-amt{font-family:"EB Garamond",serif;font-size:21px;font-weight:600}
.inv-items-wrap{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:16px}
.inv-items-head{display:grid;grid-template-columns:1fr 60px 76px 84px;background:var(--ink);color:#fff;padding:9px 14px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase;gap:7px}
.inv-items-head span:not(:first-child){text-align:right}
.inv-item-row{display:grid;grid-template-columns:1fr 60px 76px 84px;padding:11px 14px;gap:7px;align-items:start;border-bottom:.5px solid var(--line)}
.inv-item-row:last-child{border-bottom:none}
.inv-item-row>span{text-align:right;font-size:12.5px;padding-top:2px}
.inv-item-row>span:last-child{font-weight:500}
.icode{display:inline-block;font-size:9.5px;font-weight:500;padding:2px 7px;border-radius:4px;letter-spacing:.04em;margin-bottom:3px}
.c1{background:#E1F5EE;color:#085041}.c2{background:var(--red-lt);color:var(--red-dk)}.c3{background:#E6F1FB;color:var(--blue)}.c4{background:#FAEEDA;color:#633806}.c5{background:#FBEAF0;color:#72243E}
.idname{font-weight:500;font-size:12.5px;margin-bottom:1px}
.idspec{font-size:10.5px;color:var(--muted);line-height:1.55}
.pay-stages-wrap{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:14px}
.ps-head{background:var(--ink);color:#fff;padding:8px 14px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.ps-row{display:grid;grid-template-columns:1fr auto auto;gap:10px;padding:9px 14px;border-bottom:.5px solid var(--line);font-size:12px;align-items:center}
.ps-row:last-child{border-bottom:none}
.ps-row.now{background:var(--red-lt)}
.ps-label{color:var(--ink2);font-size:11.5px}
.ps-pct{font-size:10px;color:var(--muted)}
.ps-amt{font-weight:600;text-align:right;font-size:12px}
.ps-row.now .ps-amt{color:var(--red-dk)}
.ps-tag{font-size:9px;padding:1px 7px;border-radius:10px;font-weight:600;margin-left:4px}
.tag-due{background:var(--red-lt);color:var(--red-dk)}
.tag-paid{background:#EAF3DE;color:var(--green)}
.tag-upcoming{background:#f0f0f0;color:var(--muted)}
.del-box{border-left:3px solid var(--red);padding:9px 14px;background:#FBF8F8;border-radius:0 6px 6px 0;margin-bottom:13px;font-size:11.5px;color:var(--ink2);line-height:1.7}
.del-box strong{color:var(--ink)}
.pay-info-section{border:.5px solid var(--line);border-radius:7px;padding:14px 16px;margin-bottom:13px}
.pay-info-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.pay-inner-box{background:var(--field);border-radius:7px;padding:12px 14px;margin-bottom:10px}
.pay-inner-name{font-weight:500;font-size:12.5px;margin-bottom:8px}
.pay-inner-tbl{width:100%;font-size:11.5px;border-collapse:collapse}
.pay-inner-tbl td{padding:2.5px 0;vertical-align:top}
.pay-inner-tbl .pk{color:var(--muted);width:44%}
.pay-inner-tbl .pv{font-weight:500}
.pay-divider{border:none;border-top:.5px solid var(--line);margin:5px 0}
.pay-emails{font-size:11.5px;color:var(--ink2);line-height:1.8}
.pay-emails strong{color:var(--ink)}
.pay-note{margin-top:9px;background:#FFF3CD;border-radius:5px;padding:9px 12px;font-size:10.5px;color:#856404;line-height:1.65;border:.5px solid #ffc107}
.terms-wrap{margin-bottom:14px}
.terms-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.terms-wrap ol{padding-left:16px}
.terms-wrap ol li{font-size:10.5px;color:var(--ink2);line-height:1.85;margin-bottom:2px}
.terms-wrap ol li strong{color:var(--ink)}
.inv-footer{border-top:.5px solid var(--line);padding-top:13px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
.inv-footer-l{font-size:10.5px;color:var(--muted);line-height:1.75}
.inv-footer-l strong{color:var(--ink)}
.inv-footer-r{font-size:10.5px;color:var(--muted);text-align:right;max-width:260px;line-height:1.6}
.corr-history-wrap{border:.5px solid var(--line);border-radius:7px;overflow:hidden;margin-bottom:14px}
.corr-hist-head{background:var(--ink);color:#fff;padding:8px 14px;font-size:10px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
.corr-hist-row{display:grid;grid-template-columns:70px 110px 1fr auto;gap:8px;padding:9px 14px;border-bottom:.5px solid var(--line);font-size:11.5px;align-items:center}
.corr-hist-row:last-child{border-bottom:none}
.corr-hist-row.curr{background:var(--red-lt)}
.corr-rnd{font-weight:700;color:var(--red-dk)}
.ship-details{border:.5px solid var(--line);border-radius:7px;padding:14px 16px;margin-bottom:13px}
.ship-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.ship-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 24px}
.ship-item .sk{font-size:10.5px;color:var(--muted);margin-bottom:1px}
.ship-item .sv{font-weight:500;font-size:12px}
.mark-box-wrap{border:.5px solid var(--line);border-radius:7px;padding:14px 16px;margin-bottom:13px;background:var(--field)}
.mark-box-title{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.mark-box{border:1.5px solid var(--ink);border-radius:4px;padding:10px 14px;font-size:11px;line-height:2.1;font-family:monospace;color:var(--ink);display:inline-block;min-width:210px}

@media(max-width:640px){
  .tab{padding:0 10px;font-size:11px}
  .topbar-brand-text span{display:none}
  .form-view{padding:14px 12px 40px}
  .inv{padding:28px 20px}
  .inv-head{flex-direction:column;gap:10px}
  .inv-title-block{text-align:left}
  .inv-meta{grid-template-columns:1fr}
  .inv-items-head{grid-template-columns:1fr 50px 64px 72px;font-size:9px}
  .inv-item-row{grid-template-columns:1fr 50px 64px 72px}
  .f2{grid-template-columns:1fr}
  .f3{grid-template-columns:1fr 1fr}
  .pay-method-tabs{grid-template-columns:repeat(3,1fr)}
  .pdf-toolbar{flex-wrap:wrap;gap:8px}
  .corr-hist-row{grid-template-columns:60px 90px 1fr;font-size:10.5px}
  .corr-hist-row>span:last-child{display:none}
  .ps-row{grid-template-columns:1fr auto}
  .ps-pct{display:none}
  .ship-grid{grid-template-columns:1fr}
}

@media print{
  .topbar,.pdf-toolbar{display:none!important}
  .page{display:block!important}
  .form-view{display:none!important}
  .pdf-view{display:block!important}
  .pdf-wrap{padding:0}
  .inv{box-shadow:none;max-width:100%;padding:28px 34px}
  @page{margin:0;size:A4}
}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand">
    <img src="https://sdfltd.com/sdf.jpg" alt="SDF Clothing">
    <div class="topbar-brand-text">SDF Clothing <span>Invoice Generator</span></div>
  </div>
  <div class="tab-group">
    <button class="tab active" onclick="switchTab('sample')">Sample</button>
    <button class="tab" onclick="switchTab('correction')">Correction</button>
    <button class="tab" onclick="switchTab('bulk')">Bulk</button>
  </div>
</div>

<!-- ═══════ SAMPLE PAGE ═══════ -->
<div class="page active" id="page-sample">

  <div class="form-view" id="s-form">
    <div class="form-title">Sample Invoice</div>
    <div class="form-sub">Complete all fields then tap Generate Invoice to preview and download</div>

    <div class="card">
      <div class="card-title">Invoice Details</div>
      <div class="f2">
        <div class="f"><label>PI Number</label><input id="s-pi" value="SDF001/06/KW" oninput="calcS()"></div>
        <div class="f"><label>PO Number</label><input id="s-po" placeholder="Buyer reference"></div>
      </div>
      <div class="f2">
        <div class="f"><label>Invoice Date</label><input type="date" id="s-date" oninput="sSetDue()"></div>
        <div class="f"><label>Due Date <span style="color:var(--muted);font-weight:400">(auto +3 days)</span></label><input type="date" id="s-due"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Client Information</div>
      <div class="f"><label>Full Name / Company</label><input id="s-cn" placeholder="Dr. Maram Alibrahim"></div>
      <div class="f"><label>Address</label><textarea id="s-ca" placeholder="Block 12, Street 8, House 69, Salwa R/A"></textarea></div>
      <div class="f2">
        <div class="f"><label>Country</label><input id="s-cc" placeholder="Kuwait"></div>
        <div class="f"><label>Phone Number</label><input id="s-cp" placeholder="+965 55626666"></div>
      </div>
      <div class="f"><label>Email Address</label><input type="email" id="s-ce" placeholder="client@email.com"></div>
    </div>

    <div class="card">
      <div class="card-title">Advance Payment Date</div>
      <div class="f"><label>Date Advance Received — used to calculate delivery deadline automatically</label><input type="date" id="s-adv"></div>
    </div>

    <div class="card">
      <div class="card-title">Line Items</div>
      <div class="items-list" id="s-items-list"></div>
      <button class="add-row-btn" onclick="addSItem()">+ Add Line Item</button>
      <div class="totals-box" id="s-totals"></div>
      <div id="s-pay-notice" class="notice n-green" style="margin-top:12px"></div>
    </div>

    <div class="card">
      <div class="card-title">Payment Method</div>
      <div class="pay-method-tabs" id="s-pay-tabs"></div>
      <div id="s-pay-fields"></div>
    </div>

    <button class="gen-btn" onclick="generateSample()">Generate Invoice →</button>
  </div>

  <div class="pdf-view" id="s-pdf">
    <div class="pdf-toolbar">
      <div class="pdf-toolbar-l">
        <button class="back-btn" onclick="backToForm('s')">← Edit</button>
        <span class="pdf-label" id="s-pdf-label">Sample Invoice</span>
      </div>
      <button class="print-btn" onclick="window.print()">⬇ Download PDF</button>
    </div>
    <div class="pdf-wrap"><div class="inv" id="s-inv"></div></div>
  </div>
</div>

<!-- ═══════ CORRECTION PAGE ═══════ -->
<div class="page" id="page-correction">

  <div class="form-view" id="c-form">
    <div class="form-title">Correction Sample Invoice</div>
    <div class="form-sub">Record each correction round with full history for audit trail</div>

    <div class="card">
      <div class="card-title">Invoice Details</div>
      <div class="f2">
        <div class="f"><label>PI Number</label><input id="c-pi" value="SDF001/06/KW-C1"></div>
        <div class="f"><label>Original PI Reference</label><input id="c-orig" placeholder="SDF001/06/KW"></div>
      </div>
      <div class="f2">
        <div class="f"><label>Invoice Date</label><input type="date" id="c-date" oninput="cSetDue()"></div>
        <div class="f"><label>Correction Round</label>
          <select id="c-round" onchange="updateCNotice()">
            <option value="1">Round 1 — Included, No Extra Charge</option>
            <option value="2">Round 2</option>
            <option value="3">Round 3</option>
            <option value="4">Round 4+</option>
          </select>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Client Information</div>
      <div class="f"><label>Full Name / Company</label><input id="c-cn" placeholder="Dr. Maram Alibrahim"></div>
      <div class="f2">
