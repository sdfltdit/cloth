  fieldsEl.innerHTML = `<div class="pay-info-box">${m.rows.map(r => `<div class="pib-row"><span class="pib-k">${r[0]}</span><strong>${r[1]}</strong></div>`).join('')}</div>`;
}

function selectMethod(type, id) {
  selMethod[type] = id;
  buildPayTabs(type);
}

function getPayInvoiceHtml(type) {
  const m = METHODS.find(x => x.id === selMethod[type]);
  if (!m) return '';
  const rows = m.rows.map(r => `<tr><td class="pk">${r[0]}</td><td class="pv">${r[1]}</td></tr>`).join('');
  return `<div class="pay-inner-box"><div class="pay-inner-name">${m.name}</div><table class="pay-inner-tbl">${rows}</table></div>`;
}

/* ══ UTILS ══ */
function gv(id) { return document.getElementById(id)?.value || ''; }
function fmtDate(ds) { if (!ds) return '—'; return new Date(ds + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }); }
function addDays(ds, n) { const d = new Date(ds + 'T00:00:00'); d.setDate(d.getDate() + n); return d.toISOString().split('T')[0]; }
function addWorkingDays(ds, n) {
  const d = new Date(ds + 'T00:00:00');
  let a = 0;
  while (a < n) { d.setDate(d.getDate() + 1); const w = d.getDay(); if (w !== 5 && w !== 6) a++; }
  return d;
}

function switchTab(t) {
  document.querySelectorAll('.tab').forEach((b, i) => b.classList.toggle('active', ['sample','correction','bulk'][i] === t));
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + t).classList.add('active');
  window.scrollTo(0, 0);
}

function backToForm(p) {
  document.getElementById(p + '-form').style.display = '';
  document.getElementById(p + '-pdf').classList.remove('show');
  window.scrollTo(0, 0);
}

