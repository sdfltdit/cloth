    `<div class="ips-row" style="background:var(--field)"><span class="ips-label" style="font-weight:600">Total Order Value</span><span class="ips-pct">100%</span><span class="ips-amt" style="color:var(--ink)">$${sub.toFixed(2)}</span></div>`
  ].join('');
  const rows = bItems.map((it, i) => `
    <div class="irow" style="grid-template-columns:1fr 80px 70px 82px">
      <div>
        <div class="icode ${CC[i%5]}">${it.code||'—'}</div>
        <div class="idname">${it.desc||'—'}</div>
