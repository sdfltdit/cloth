---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyAgeString } from '../utils/companyAge';
import { PHONE, WHATSAPP_NUMBER, EMAIL, WHATSAPP_URL } from '../data/schema';
export const prerender = true;

const pageTitle = "Clothing Manufacturing Cost Guide 2026 — Pricing | SDF";
const pageDescription = "Complete clothing manufacturing cost guide for 2026. Covers cost per unit by product, what affects pricing, total landed cost, payment terms and timelines.";
const companyAge = getCompanyAgeString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl.href,
      "url": canonicalUrl.href,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://sdfltd.com/#website",
        "url": "https://sdfltd.com/",
        "name": "SDF Clothing",
        "publisher": {
          "@type": "Organization",
          "@id": "https://sdfltd.com/#organization",
          "name": "SDF Clothing",
          "url": "https://sdfltd.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://sdfltd.com/logo.png"
          },
          "sameAs": [
            "https://www.facebook.com/sdfltd",
            "https://www.linkedin.com/company/sdf-clothing"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "PHONE",
            "contactType": "sales",
            "areaServed": ["US", "UK", "AU", "CA", "DE", "FR", "NL", "SE"],
            "availableLanguage": "English"
          }
        }
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sdfltd.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Clothing Manufacturing Cost Guide",
            "item": canonicalUrl.href
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the average cost to manufacture a t-shirt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Average t-shirt manufacturing cost ranges from $3-8 FOB for 300 pieces, $2-6 for 500 pieces, and $1-5 for 1000 pieces. Basic cotton t-shirts fall at the lower end, while premium organic cotton or custom prints increase cost. Bangladesh offers competitive pricing with 300-piece minimums."
          }
        },
        {
          "@type": "Question",
          "name": "How does MOQ affect manufacturing cost per unit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Higher MOQ reduces cost per unit through production efficiency and fabric purchasing power. 1000-piece orders typically cost 30-50% less per unit than 300-piece orders. However, higher MOQ increases inventory risk. Brands must balance per-unit savings against cash flow and storage costs."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between FOB and landed cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "FOB (Free On Board) is the factory price including production and delivery to the port. Landed cost includes FOB plus freight, insurance, customs duty, and any other charges to get goods to your warehouse. Landed cost is typically 20-40% higher than FOB depending on destination and shipping method."
          }
        },
        {
          "@type": "Question",
          "name": "What are standard payment terms for clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard payment terms are 30% deposit upon order confirmation, 70% balance before shipment. Letter of Credit offers security for larger orders. Western Union or PayPal may be accepted for small orders but carry higher fees. Always verify payment security before transferring funds."
          }
        },
        {
          "@type": "Question",
          "name": "How long does clothing manufacturing take from order to delivery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Production timeline typically 30-45 days from fabric receipt. Sampling 7-14 days before bulk. Ocean freight to US/Europe 25-35 days. Air freight 5-7 days but significantly more expensive. Total order-to-delivery timeline 60-90 days for ocean freight, 40-55 days for air freight."
          }
        },
        {
          "@type": "Question",
          "name": "What hidden costs should I budget for in clothing manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hidden costs include sample fees ($50-200 per style), shipping samples, tech pack development ($200-1000), quality inspection ($200-500), bank fees for international transfers, customs broker fees, warehousing costs, and potential duty on imports. Budget 10-15% above quoted FOB for these items."
          }
        },
        {
          "@type": "Question",
          "name": "Which country offers the lowest clothing manufacturing costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bangladesh offers the lowest costs for basic garments (t-shirts, hoodies, pants) with 300-1000 piece MOQs. Vietnam offers competitive pricing for technical garments. China offers speed and flexibility but at higher costs. Bangladesh combines low cost, duty advantages (GSP for EU), and established textile infrastructure."
          }
        },
        {
          "@type": "Question",
          "name": "How do I get an accurate manufacturing quote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Provide detailed tech pack with measurements, fabric specifications, quantities per size/color, and delivery timeline. Specify any special requirements (certifications, labels, packaging). Request quotes from multiple manufacturers and compare not just price but communication, sample quality, and terms. Always request samples before bulk."
          }
        },
        {
          "@type": "Question",
          "name": "What certifications increase manufacturing costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GOTS organic certification adds 15-25% to fabric costs. OEKO-TEX Standard 100 adds 5-10%. BSCI social compliance adds minimal cost but required for many retailers. ISO 9001 quality certification indicates process control. Certifications enable access to premium markets and justify higher retail pricing."
          }
        },
        {
          "@type": "Question",
          "name": "How does fabric choice affect manufacturing cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fabric is typically 50-70% of garment cost. Basic cotton polyester blends are most cost-effective. Organic cotton costs 20-30% more. Recycled polyester adds 15-20%. Technical fabrics (Gore-Tex, specialized performance) can double costs. Fabric selection is the primary lever for controlling manufacturing costs."
          }
        }
      ]
    },
    {
      "@type": "Service",
      "serviceType": "Clothing Manufacturing",
      "provider": {
        "@type": "Organization",
        "name": "SDF Clothing",
        "url": "https://sdfltd.com"
      },
      "areaServed": ["US", "GB", "AU", "CA", "DE", "FR", "NL"],
      "description": "Custom clothing manufacturing from Bangladesh with low MOQ from 300 pieces."
    },
    {
      "@type": "HowTo",
      "name": "How to Order Custom Clothing from SDF Clothing",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Submit Your Brief",
          "text": "Share your design, quantity, fabric requirements and timeline."
        },
        {
          "@type": "HowToStep",
          "name": "Receive Quote",
          "text": "Get a detailed FOB quote within 48 hours."
        },
        {
          "@type": "HowToStep",
          "name": "Approve Sample",
          "text": "Review and approve a pre-production sample."
        },
        {
          "@type": "HowToStep",
          "name": "Bulk Production",
          "text": "Full production with inline quality checks."
        },
        {
          "@type": "HowToStep",
          "name": "Shipment",
          "text": "FOB Dhaka shipment with full export documentation."
        }
      ]
