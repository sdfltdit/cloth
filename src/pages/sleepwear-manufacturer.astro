        <li class="breadcrumb__item breadcrumb__item--current">Sleepwear Manufacturer</li>
      </ol>
    </nav>
  </div>

  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__label">Sleepwear Manufacturer | Since 1998 | Comfort Specialists</div>
        <h1 class="hero__title">Sleepwear Manufacturer | Modal, Bamboo & Cotton Pyjamas from 300 Pieces</h1>
